<%- include('partials/head', { pageTitle: 'Administration', active: 'admin' }) %>

<div class="tabs">
  <a href="/admin/general"><%= t('General') %></a>
  <a href="/admin/users"><%= t('Users') %></a>
  <a href="/admin/roles"><%= t('Access Roles') %></a>
  <a href="/admin/backup"><%= t('Backups') %></a>
  <a href="/admin/notifications"><%= t('Notifications') %></a>
  <a href="/admin/security"><%= t('Security') %></a>
  <a class="active" href="/admin/modules"><%= t('Modules') %></a>
  <a href="/admin/languages"><%= t('Languages') %></a>
  <% if (moduleOn('ai')) { %><a href="/admin/ai"><%= t('AI Assistant') %></a><% } %>
</div>

<% const labelOf = {}; groups.forEach(g => g.modules.forEach(m => { labelOf[m.key] = m.label; })); %>
<% if (changed.length) { %>
  <p class="hint" style="color: var(--success);"><%= t('Saved') %>: <%= changed.map(c => { const [k, v] = c.split(':'); return t(labelOf[k] || k) + ' ' + (v === '1' ? t('on') : t('off')); }).join(', ') %>.</p>
<% } %>

<% if (error) { %><p class="error"><%= error %></p><% } %>
<% if (wiped) { %><p class="hint" style="color: var(--success);"><%= t('Wiped') %> &mdash; <%= wiped %>.</p><% } %>

<p class="hint"><%= t('Switch parts of LoxSuite on or off for this installation. A module that is off disappears from the menu and its background work stops; its data is kept, so switching it on again brings everything back. A module that needs another one switches that one on too; switching a module off also switches off what depends on it.') %></p>

<div class="card">
  <h2 style="margin-top:0;"><%= t('Core') %> <span class="hint" style="font-size:0.8rem; font-weight:400;"><%= t('always on') %></span></h2>
  <p class="hint" style="margin:0;"><%= t('Dashboard, Miniservers, Live Data (Loxone), Hardware, users and roles, settings, system log, notification centre and channels, backup and restore, languages, App & push, Help.') %></p>
</div>

<% groups.forEach(g => { %>
  <h2 style="margin:1.4rem 0 0.6rem;"><%= t(g.label) %></h2>
  <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr)); gap:1rem;">
    <% g.modules.forEach(m => { %>
      <div class="card" id="mod-<%= m.key %>" style="margin:0; <%= m.enabled ? 'border-color: var(--accent);' : '' %>">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:0.6rem;">
          <h3 style="margin:0;"><%= t(m.label) %></h3>
          <form method="post" action="/admin/modules/<%= m.key %>" style="margin:0;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="enabled" value="<%= m.enabled ? '0' : '1' %>">
            <button type="submit" class="<%= m.enabled ? 'btn-soft' : 'btn-edit' %>"
              <% if (m.enabled && m.neededBy.length) { %>onclick="return confirm(<%= JSON.stringify(t('Switching off {module} also switches off: {list}. Continue?', { module: t(m.label), list: m.neededBy.map(x => t(x)).join(', ') })) %>);"<% } %>><%= m.enabled ? t('Switch off') : t('Switch on') %></button>
          </form>
        </div>
        <p class="hint" style="margin:0.4rem 0;"><span class="badge"><%= m.enabled ? t('on') : t('off') %></span> <%= t(m.description) %></p>
        <ul class="hint" style="margin:0.3rem 0 0; padding-left:1.1rem; font-size:0.85rem;">
          <% m.parts.forEach(p => { %><li><%= t(p) %></li><% }) %>
        </ul>
        <% if (m.requires.length || m.neededBy.length) { %>
          <p class="hint" style="margin:0.5rem 0 0; font-size:0.8rem;">
            <% if (m.requires.length) { %><%= t('Needs') %>: <%= m.requires.map(x => t(x)).join(', ') %>. <% } %>
            <% if (m.neededBy.length) { %><%= t('Used by') %>: <%= m.neededBy.map(x => t(x)).join(', ') %>.<% } %>
          </p>
        <% } %>
        <% const justOn = changed.includes(m.key + ':1'); %>
        <details class="mod-status" data-key="<%= m.key %>" style="margin-top:0.6rem;" <%= justOn ? 'open' : '' %>>
          <summary class="hint" style="cursor:pointer;"><strong><%= t('Status & getting started') %></strong> <span class="mod-progress"></span></summary>
          <div class="mod-status-body hint" style="margin-top:0.4rem;"><%= t('Loading…') %></div>
          <div class="btn-row" style="margin-top:0.5rem; flex-wrap:wrap; gap:0.4rem;">
            <a class="btn-soft" href="/admin/modules/<%= m.key %>/export"><%- icon('download') %> <%= t('Export data (zip)') %></a>
          </div>
          <% if (!m.enabled) { %>
          <form method="post" action="/admin/modules/<%= m.key %>/wipe" style="margin-top:0.6rem; display:flex; gap:0.4rem; align-items:flex-end; flex-wrap:wrap;"
                onsubmit="return confirm(<%= JSON.stringify(t('Permanently delete the data of {module}? Export it first if you may want it back.', { module: t(m.label) })) %>);">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div><label style="font-size:0.8rem;"><%- t('Type {key} to wipe its data', { key: '<code>' + m.key + '</code>' }) %></label><input type="text" name="confirm" autocomplete="off" style="width:11rem;"></div>
            <button type="submit" class="btn-soft"><%- icon('trash') %> <%= t('Wipe data') %></button>
          </form>
          <% } else { %>
          <p class="hint" style="margin:0.5rem 0 0; font-size:0.8rem;"><%= t('Wiping its data is possible once the module is switched off.') %></p>
          <% } %>
        </details>
      </div>
    <% }) %>
  </div>
<% }) %>

<script>
(function () {
  var T = <%- JSON.stringify({ ready: t('ready'), of: t('{done} of {total} done'), optional: t('optional'), kept: t('kept when wiping'), none: t('No data.'), fail: t('Could not load the status.') }) %>;
  var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
  function load(d) {
    var key = d.getAttribute('data-key');
    fetch('/admin/modules/' + encodeURIComponent(key) + '/status.json', { headers: { accept: 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (s) {
        var prog = d.querySelector('.mod-progress');
        if (s.total) prog.textContent = '— ' + (s.ready ? T.ready : T.of.replace('{done}', s.done).replace('{total}', s.total));
        var html = '';
        if (s.checklist && s.checklist.length) {
          html += '<ul style="list-style:none; padding:0; margin:0 0 0.5rem;">' + s.checklist.map(function (c) {
            return '<li style="margin:0.15rem 0;">' + (c.done ? '✅' : (c.optional ? '◻️' : '⬜')) + ' <a href="' + esc(c.href) + '">' + esc(c.label) + '</a>' + (c.optional ? ' <span style="opacity:0.7;">(' + esc(T.optional) + ')</span>' : '') + '</li>';
          }).join('') + '</ul>';
        }
        if (s.tables && s.tables.length) {
          html += '<table class="table" style="font-size:0.8rem;"><tbody>' + s.tables.map(function (t) {
            return '<tr><td>' + esc(t.label) + (t.wipe ? '' : ' <span style="opacity:0.7;">(' + esc(T.kept) + ')</span>') + '</td><td style="text-align:right;">' + Number(t.rows).toLocaleString('nl-NL') + '</td></tr>';
          }).join('') + '</tbody></table>';
        }
        d.querySelector('.mod-status-body').innerHTML = html || esc(T.none);
      })
      .catch(function () { d.querySelector('.mod-status-body').textContent = T.fail; });
  }
  Array.prototype.forEach.call(document.querySelectorAll('.mod-status'), function (d) {
    if (d.open) load(d);
    else { var done = false; d.addEventListener('toggle', function () { if (d.open && !done) { done = true; load(d); } }); }
    // Progress in the summary right away, for modules that are on.
    if (!d.open && d.closest('.card').style.borderColor) load(d);
  });
})();
</script>
<%- include('partials/foot') %>
