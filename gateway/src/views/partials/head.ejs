<!doctype html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="display-timezone" content="<%= displayTimezone %>">
  <title><%= t(pageTitle) %> · LoxSuite</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <meta name="theme-color" content="#5CA83F">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="LoxSuite">
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
  <% if (typeof lang !== 'undefined' && lang !== 'en') { %>
  <script src="/i18n/<%= lang %>.js?v=<%= typeof i18nVersion !== 'undefined' ? i18nVersion : assetVersion %>"></script>
  <script src="/i18n.js?v=<%= assetVersion %>"></script>
  <% } %>
  <script src="/monitor-picks.js?v=<%= assetVersion %>"></script>
  <script src="/show-if.js?v=<%= assetVersion %>" defer></script>
  <script src="/mini-map.js?v=<%= assetVersion %>"></script>
  <script>
    // Dates and numbers in the browser follow the user's language (nl -> nl-NL) and the clock setting
    // (Administration > Languages, 24 h by default) instead of the browser's own locale: every
    // toLocale*String call without an explicit locale gets it, and times get the hour cycle.
    (function () {
      var L = <%- JSON.stringify(typeof uiLocale !== 'undefined' ? uiLocale : 'en-GB') %>, H12 = <%- JSON.stringify(typeof clock12 !== 'undefined' && !!clock12) %>;
      window.LS_LOCALE = L; window.LS_CLOCK12 = H12;
      var fix = function (l) { return l === undefined || l === null || (Array.isArray(l) && !l.length) ? L : l; };
      var hc = function (o) { o = Object.assign({}, o || {}); if (o.hour12 === undefined && o.hourCycle === undefined) o.hourCycle = H12 ? 'h12' : 'h23'; return o; };
      var D = Date.prototype, ts = D.toLocaleTimeString, s = D.toLocaleString, ds = D.toLocaleDateString, n = Number.prototype.toLocaleString;
      D.toLocaleTimeString = function (l, o) { return ts.call(this, fix(l), hc(o)); };
      D.toLocaleString = function (l, o) { return s.call(this, fix(l), hc(o)); };
      D.toLocaleDateString = function (l, o) { return ds.call(this, fix(l), o); };
      Number.prototype.toLocaleString = function (l, o) { return n.call(this, fix(l), o); };
      var DTF = Intl.DateTimeFormat;
      var W = function (l, o) { o = Object.assign({}, o || {}); if (o.hour !== undefined && o.hour12 === undefined && o.hourCycle === undefined) o.hourCycle = H12 ? 'h12' : 'h23'; return new DTF(fix(l), o); };
      W.prototype = DTF.prototype; W.supportedLocalesOf = DTF.supportedLocalesOf;
      Intl.DateTimeFormat = W;
    })();
    // Applied before first paint to avoid a flash of the wrong theme.
    (function () {
      var saved = localStorage.getItem('theme');
      if (saved === 'light' || saved === 'dark') document.documentElement.setAttribute('data-theme', saved);
    })();
    // Charts are drawn at the width of their container (1 SVG unit = 1 px, so text stays its size)
    // and redrawn when the window width changes. lsChartW(el, fallback) -> width to draw at;
    // lsOnResize(fn) -> fn runs after a (debounced) width change.
    window.lsChartW = function (el, fallback) { var w = el && el.clientWidth; return Math.max(260, Math.round(w || fallback || 600)); };
    window.lsOnResize = function (fn) {
      var last = window.innerWidth, t = null;
      window.addEventListener('resize', function () {
        clearTimeout(t);
        t = setTimeout(function () { if (Math.abs(window.innerWidth - last) >= 16) { last = window.innerWidth; fn(); } }, 180);
      });
    };
  </script>
</head>
<body data-refresh="<%= typeof refresh !== 'undefined' ? refresh : '' %>" data-live-swap="<%= typeof liveSwap !== 'undefined' && liveSwap ? 'true' : 'false' %>" data-page-size="<%= tablePageSize %>">
<div class="app-shell">
  <%
    // Hidden on desktop entirely via CSS (display:none outside the mobile breakpoint) — always
    // rendered, same "control visibility in CSS/JS, not server-side UA-sniffing" approach every
    // other conditionally-shown element in this app already uses. Toggle script is in foot.ejs,
    // right alongside the Help drawer's own open/close handlers (same backdrop-click/Escape idiom).
  %>
  <div id="sidebar-backdrop" class="sidebar-backdrop"></div>
  <aside class="sidebar">
    <div class="brand">
      <span class="brand-icon"><%- icon('logo', { size: 18 }) %></span>
      <span><%= t('LoxSuite') %></span>
    </div>
    <% if (currentUser && currentUser.isAdmin && getSqliteImportStatus().available) { %>
      <a href="/setup/import" style="display:flex; align-items:center; gap:0.4rem; margin:0 0 0.75rem; padding:0.5rem 0.7rem; border-radius:var(--radius); background:var(--surface-alt); border:1px solid var(--danger); color:var(--danger); font-size:0.8rem; font-weight:500; text-decoration:none;">
        <%- icon('refresh', { size: 13 }) %> <%= t('Existing SQLite data found — import it') %>
      </a>
    <% } %>
    <%
      // canView/canEdit come from res.locals (see middleware/loadUserContext.js) — hiding a nav
      // item or button a role can't use is UX only, requirePermission on the server is the actual
      // boundary (middleware/requirePermission.js).

      // Pages that used to each get their own sidebar link now live together behind one link, with
      // tabs at the top of the page itself doing the switching (see partials/tabs-*.ejs) — these
      // work out which of a group's areas the current user can actually reach, and land them on
      // the first one, rather than a fixed href that might 403 for their role.
      const mappingAreas = [
        { key: 'mqtt_to_loxone', href: '/mappings/mqtt-to-loxone' },
        { key: 'loxone_to_mqtt', href: '/mappings/loxone-to-mqtt' },
        { key: 'commands', href: '/mappings/commands' },
        { key: 'transformations', href: '/transformations' },
      ];
      const mappingsHref = (mappingAreas.find((a) => canView(a.key)) || {}).href;
      const mappingsActive = ['mqtt-to-loxone', 'loxone-to-mqtt', 'commands', 'transformations'].includes(active);

      // Same order as the tab strip itself (partials/tabs-mqtt-broker.ejs) — landing on the first
      // one a role can actually see is the point of this whole indirection, so this list has to
      // match that tab order or the sidebar link would land on some other, later tab instead.
      const brokerAreas = [
        { key: 'settings', href: '/settings/broker' },
        { key: 'mqtt_users', href: '/mqtt-users' },
        { key: 'mqtt_roles', href: '/mqtt-roles' },
      ];
      const brokerHref = (brokerAreas.find((a) => canView(a.key)) || {}).href;
      const brokerActive = ['mqtt-users', 'mqtt-roles', 'broker-settings'].includes(active);

      const loxoneSectionVisible = canView('miniservers') || canView('live_data') || canView('hardware') || !!mappingsHref;
      const mqttSectionVisible = canView('incoming') || !!brokerHref;

      // A section stays expanded regardless of the user's saved preference while they're actually
      // on one of its pages — otherwise the active link would be invisible inside its own collapsed
      // section, which reads as broken navigation rather than a deliberate collapse.
      const isCollapsed = (key, forceExpanded) => !forceExpanded && collapsedSections.includes(key);
    %>
    <nav>
      <% const mod = typeof moduleOn === 'function' ? moduleOn : () => true; %>
      <% if (canView('dashboard')) { %><a href="/" class="<%= active === 'dashboard' ? 'active' : '' %>"><%= t('Dashboard') %></a><% } %>

      <% if (mod('monitor')) { %>
      <% const monitorExpanded = active === 'monitor' || active === 'dashboards'; %>
      <button type="button" class="nav-section-label" data-nav-section="monitor" aria-expanded="<%= isCollapsed('monitor', monitorExpanded) ? 'false' : 'true' %>">
        <span><%= t('Monitor') %></span><%- icon('chevron') %>
      </button>
      <div class="nav-group" <%= isCollapsed('monitor', monitorExpanded) ? 'hidden' : '' %>>
        <% if (canView('monitor')) { %><a href="/monitor" class="<%= active === 'monitor' ? 'active' : '' %>"><%= t('Monitor') %></a><% } %>
        <a href="/dashboards" class="<%= active === 'dashboards' ? 'active' : '' %>"><%= t('My Dashboards') %></a>
        <% if (favoriteDashboards.length > 0) { %>
          <%
            // Starred from a dashboard's own "Add to sidebar" button (dashboards.ejs,
            // dashboard-detail.ejs) — favoriteDashboards itself already only ever holds ones this
            // user can still actually reach (see loadFavoriteDashboards in loadUserContext.js).
            // dashboardId isn't set by every page (only dashboard.ejs/dashboard-detail.ejs pass
            // it) — typeof-guarded the same way refresh/liveSwap are on <body> above, rather than
            // requiring every other page's own include('partials/head', {...}) call to know about
            // a local it has no use for.
            const currentDashboardId = typeof dashboardId !== 'undefined' ? dashboardId : null;
            const favoritesExpanded = active === 'dashboards' || active === 'dashboard';
          %>
          <button type="button" class="nav-section-label" data-nav-section="favorite-dashboards" aria-expanded="<%= isCollapsed('favorite-dashboards', favoritesExpanded) ? 'false' : 'true' %>">
            <span><%= t('Favorite Dashboards') %></span><%- icon('chevron') %>
          </button>
          <div class="nav-group" <%= isCollapsed('favorite-dashboards', favoritesExpanded) ? 'hidden' : '' %>>
            <% favoriteDashboards.forEach(d => { %>
              <a href="/dashboards/<%= d.id %>" class="<%= currentDashboardId != null && d.id === currentDashboardId ? 'active' : '' %>"><%= d.name %></a>
            <% }) %>
          </div>
        <% } %>
      </div>
      <% } %>

      <% if (loxoneSectionVisible) { %>
        <% const loxoneExpanded = active === 'miniservers' || active === 'live-data' || active === 'hardware' || mappingsActive; %>
        <button type="button" class="nav-section-label" data-nav-section="loxone-mappings" aria-expanded="<%= isCollapsed('loxone-mappings', loxoneExpanded) ? 'false' : 'true' %>">
          <span><%= t('Loxone') %></span><%- icon('chevron') %>
        </button>
        <div class="nav-group" <%= isCollapsed('loxone-mappings', loxoneExpanded) ? 'hidden' : '' %>>
          <% if (canView('miniservers')) { %><a href="/miniservers" class="<%= active === 'miniservers' ? 'active' : '' %>"><%= t('Miniservers') %></a><% } %>
          <% if (canView('live_data')) { %><a href="/live-data" class="<%= active === 'live-data' ? 'active' : '' %>"><%= t('Live Data') %></a><% } %>
          <% if (canView('hardware')) { %><a href="/hardware" class="<%= active === 'hardware' ? 'active' : '' %>"><%= t('Hardware') %></a><% } %>
          <% if (mappingsHref && mod('mqtt')) { %><a href="<%= mappingsHref %>" class="<%= mappingsActive ? 'active' : '' %>"><%= t('Mappings') %></a><% } %>
        </div>
      <% } %>

      <% const em = (k) => mod(k) && canView(k); const energyAny = em('charging') || em('vehicles') || em('energy') || em('energy_manager') || em('ocpp'); %>
      <% if (energyAny) { %>
        <% const wallboxExpanded = ['planner', 'energymanager', 'agenda', 'vehicles', 'driving', 'energy', 'learned', 'ocpp'].includes(active); %>
        <button type="button" class="nav-section-label" data-nav-section="wallbox" aria-expanded="<%= isCollapsed('wallbox', wallboxExpanded) ? 'false' : 'true' %>">
          <span><%= t('Energy & charging') %></span><%- icon('chevron') %>
        </button>
        <div class="nav-group" <%= isCollapsed('wallbox', wallboxExpanded) ? 'hidden' : '' %>>
          <% if (em('charging')) { %>
            <a href="/planner" class="<%= active === 'planner' ? 'active' : '' %>"><%= t('Smart charging') %></a>
            <a href="/agenda" class="<%= active === 'agenda' ? 'active' : '' %>"><%= t('Agenda') %></a>
            <a href="/learned" class="<%= active === 'learned' ? 'active' : '' %>"><%= t('Learned') %></a>
          <% } %>
          <% if (em('vehicles')) { %>
            <a href="/vehicles" class="<%= active === 'vehicles' ? 'active' : '' %>"><%= t('Vehicles') %></a>
            <a href="/driving" class="<%= active === 'driving' ? 'active' : '' %>"><%= t('Driving & costs') %></a>
          <% } %>
          <% if (em('energy')) { %><a href="/energy" class="<%= active === 'energy' ? 'active' : '' %>"><%= t('Meters') %></a><% } %>
          <% if (em('energy_manager')) { %><a href="/energy-manager" class="<%= active === 'energymanager' ? 'active' : '' %>"><%= t('Energy manager') %></a><% } %>
          <% if (em('ocpp')) { %><a href="/ocpp" class="<%= active === 'ocpp' ? 'active' : '' %>"><%= t('OCPP (charging costs)') %></a><% } %>
        </div>
      <% } %>

      <% if (mqttSectionVisible && mod('mqtt')) { %>
        <% const brokerExpanded = active === 'incoming' || active === 'incoming-clients' || brokerActive; %>
        <button type="button" class="nav-section-label" data-nav-section="mqtt-broker" aria-expanded="<%= isCollapsed('mqtt-broker', brokerExpanded) ? 'false' : 'true' %>">
          <span><%= t('MQTT') %></span><%- icon('chevron') %>
        </button>
        <div class="nav-group" <%= isCollapsed('mqtt-broker', brokerExpanded) ? 'hidden' : '' %>>
          <% if (brokerHref) { %><a href="<%= brokerHref %>" class="<%= brokerActive ? 'active' : '' %>"><%= t('Broker') %></a><% } %>
          <% if (canView('incoming')) { %><a href="/incoming/messages" class="<%= active === 'incoming' ? 'active' : '' %>"><%= t('Live Data') %></a><% } %>
          <% if (canView('incoming')) { %><a href="/incoming/clients" class="<%= active === 'incoming-clients' ? 'active' : '' %>"><%= t('Client Activity') %></a><% } %>
        </div>
      <% } %>

      <%
        const logActiveKeys = ['logs-system', 'logs-notifications', 'logs-loxone', 'logs-loxone-commands', 'logs-mqtt', 'chargelog'];
        const logsSectionVisible = canView('logs_system') || canView('logs_notifications') || canView('logs_loxone') || canView('logs_loxone_commands') || canView('logs_mqtt') || em('charging');
      %>
      <% if (logsSectionVisible) { %>
        <% const logsExpanded = logActiveKeys.includes(active); %>
        <button type="button" class="nav-section-label" data-nav-section="logs" aria-expanded="<%= isCollapsed('logs', logsExpanded) ? 'false' : 'true' %>">
          <span><%= t('Logs') %></span><%- icon('chevron') %>
        </button>
        <div class="nav-group" <%= isCollapsed('logs', logsExpanded) ? 'hidden' : '' %>>
          <% if (canView('logs_system')) { %><a href="/logs/system" class="<%= active === 'logs-system' ? 'active' : '' %>"><%= t('System') %></a><% } %>
          <% if (canView('logs_notifications')) { %><a href="/logs/notifications" class="<%= active === 'logs-notifications' ? 'active' : '' %>"><%= t('Notifications') %></a><% } %>
          <% if (canView('logs_loxone') && mod('loxone_logs')) { %><a href="/logs/loxone" class="<%= active === 'logs-loxone' ? 'active' : '' %>"><%= t('Loxone Miniservers') %></a><% } %>
          <% if (canView('logs_loxone_commands') && mod('mqtt')) { %><a href="/logs/loxone-commands" class="<%= active === 'logs-loxone-commands' ? 'active' : '' %>"><%= t('Loxone Commands') %></a><% } %>
          <% if (canView('logs_mqtt') && mod('mqtt')) { %><a href="/logs/mqtt" class="<%= active === 'logs-mqtt' ? 'active' : '' %>"><%= t('MQTT Broker') %></a><% } %>
          <% if (em('charging')) { %><a href="/planner/log" class="<%= active === 'chargelog' ? 'active' : '' %>"><%= t('Charge log') %></a><% } %>
        </div>
      <% } %>
      <% if (canView('translations') && typeof multiLang !== 'undefined' && multiLang) { %><a href="/translations" class="<%= active === 'translations' ? 'active' : '' %>"><%= t('Translations') %></a><% } %>
    </nav>
    <button type="button" id="theme-toggle" class="theme-toggle"><%- icon('theme') %> <%= t('Toggle theme') %></button>
    <%
      // getVersionStatus() (see versionCheck.js) is a plain in-memory read, cheap enough to call
      // on every page render — the actual GitHub check itself only ever runs on its own timer
      // (once at boot, then daily), never per-request.
      const versionStatus = getVersionStatus();
    %>
    <div class="sidebar-version">
      <a href="https://github.com/DaveRutten/LoxSuite/releases" target="_blank" rel="noopener" class="sidebar-version-current" title="<%= t('View releases on GitHub') %>">v<%= versionStatus.currentVersion %></a>
      <% if (versionStatus.updateAvailable) { %>
        <a href="https://github.com/DaveRutten/LoxSuite/releases" target="_blank" rel="noopener"
           class="sidebar-version-update" title="Running v<%= versionStatus.currentVersion %> — v<%= versionStatus.latestVersion %> is available on GitHub">
          <%- icon('refresh') %> v<%= versionStatus.latestVersion %> <%= t('available') %>
        </a>
      <% } %>
    </div>
  </aside>
  <div class="content">
    <header class="topbar">
      <button type="button" id="mobile-nav-toggle" class="icon-btn mobile-nav-toggle" title="<%= t('Menu') %>"><%- icon('menu') %></button>
      <div class="topbar-title">
        <h1 id="page-title"><%= t(pageTitle) %></h1>
        <% if (typeof dashboardId !== 'undefined' && typeof canEditPanels !== 'undefined' && canEditPanels) { %>
        <button type="button" id="dashboard-rename-trigger" class="icon-btn" title="<%= t('Rename dashboard') %>" aria-label="<%= t('Rename dashboard') %>"><%- icon('edit') %></button>
        <form method="post" action="/dashboards/<%= dashboardId %>/rename" id="dashboard-rename-form" class="dashboard-rename-form" hidden>
          <input type="hidden" name="redirect_to" value="/dashboards/<%= dashboardId %>">
          <input type="text" name="name" value="<%= pageTitle %>" required>
          <button type="submit" class="btn-edit"><%- icon('edit') %> <%= t('Save') %></button>
          <button type="button" id="dashboard-rename-cancel" class="btn-soft"><%= t('Cancel') %></button>
        </form>
        <script>
          // Standalone, not the shared [data-toggle-row] mechanism (tables.js) — that one only
          // ever targets a <tr class="expand-row"> inside a table, since it needs a <td> to fold
          // content into; the topbar h1 here isn't a table row at all.
          (function () {
            var trigger = document.getElementById('dashboard-rename-trigger');
            var form = document.getElementById('dashboard-rename-form');
            var title = document.getElementById('page-title');
            var cancelBtn = document.getElementById('dashboard-rename-cancel');
            trigger.addEventListener('click', function () {
              title.hidden = true;
              trigger.hidden = true;
              form.hidden = false;
              form.querySelector('input[name="name"]').focus();
            });
            cancelBtn.addEventListener('click', function () {
              form.hidden = true;
              title.hidden = false;
              trigger.hidden = false;
            });
          })();
        </script>
        <% } %>
      </div>
      <%
        const helpAnchors = {
          dashboard: 'dashboard', monitor: 'monitor', dashboards: 'dashboards', miniservers: 'miniservers', hardware: 'hardware', 'live-data': 'live-data', 'mqtt-to-loxone': 'mqtt-to-loxone',
          'loxone-to-mqtt': 'loxone-to-mqtt', commands: 'commands', transformations: 'transformations',
          incoming: 'incoming', 'incoming-clients': 'incoming', 'logs-mqtt': 'logs', 'logs-loxone': 'logs', 'logs-loxone-commands': 'logs', 'logs-system': 'logs', 'mqtt-users': 'mqtt-users', 'mqtt-roles': 'mqtt-roles', 'broker-settings': 'settings',
          admin: 'admin', profile: 'profile', settings: 'settings-general',
        };
        const helpAnchor = helpAnchors[active];
      %>
      <div class="topbar-right">
        <% if (typeof topbarRange !== 'undefined' && topbarRange) { %>
        <%
          // A page-wide time filter next to the auto-refresh control — opted into by My Dashboards
          // (NOT the shared Home dashboard, which has no use for it) and every Logs tab. Drives a
          // plain ?range= query param via a real navigation (shareable/bookmarkable, and rides
          // along for free on every live-refresh cycle — foot.ejs's own tick() re-fetches
          // location.pathname+location.search on every tick) rather than a fetch-and-swap.
          //
          // This is a SEPARATE <form> from whatever other filters the page has (Logs' own
          // Contains/Level/Apply form) — each carries the OTHER's current value forward as a
          // hidden field (topbarRangeExtra here; Logs' own inline form does the same for `range`,
          // see e.g. logs-system.ejs), so submitting either one doesn't silently drop what the
          // other had set.
          const topbarRangeExtraParams = typeof topbarRangeExtra !== 'undefined' && topbarRangeExtra ? topbarRangeExtra : {};
        %>
        <form method="get" action="<%= typeof topbarRangeAction !== 'undefined' ? topbarRangeAction : '' %>" class="range-picker-form">
          <%- rangeField(typeof topbarRangeValue !== 'undefined' ? topbarRangeValue : '', { autoSubmit: true, blankLabel: typeof topbarRangeBlankLabel !== 'undefined' ? topbarRangeBlankLabel : undefined }) %>
          <% Object.keys(topbarRangeExtraParams).forEach(function (key) { %>
            <% if (topbarRangeExtraParams[key]) { %><input type="hidden" name="<%= key %>" value="<%= topbarRangeExtraParams[key] %>"><% } %>
          <% }) %>
          <button type="submit" class="btn-soft range-go-btn"><%= t('Go') %></button>
        </form>
        <% } %>
        <%
          // Was scattered as its own little "hide help text" button above nearly every settings-
          // style form (Settings, Miniservers add/edit, ...) — one shared copy here instead, right
          // next to Help/Notifications, toggles the exact same sitewide `panel-hints-hidden` body
          // class every page's own .hint text already responds to (see foot.ejs). Deliberately left
          // ALONE on the Add-panel form (panel-grid.ejs) and Monitor detail's own chart-settings
          // form (monitor-detail.ejs) — those stay as their own dedicated buttons right there, since
          // that's a drawer/inline form a user is actively filling in, not a quick sitewide toggle.
        %>
        <button type="button" id="topbar-hints-toggle" class="icon-btn icon-btn-neutral hints-toggle-btn" title="<%= t('Show/hide help text under form fields sitewide') %>" aria-label="<%= t('Show or hide help text under form fields') %>"><%- icon('lightbulb') %></button>
        <% if (helpAnchor) { %>
          <a class="topbar-help" href="/help#help-<%= helpAnchor %>" data-help-open data-help-anchor="help-<%= helpAnchor %>" title="<%= t('Explain this page') %>" aria-label="<%= t('Help') %>">
            <%- icon('help') %>
          </a>
        <% } %>
        <span class="support-trigger">
          <span class="support-ping" aria-hidden="true"></span>
          <span class="support-sparkle-precess support-sparkle-precess-1" aria-hidden="true"><span class="support-sparkle-ellipse"><span class="support-sparkle-orbit support-sparkle-orbit-1"><span class="support-sparkle support-sparkle-pink"></span></span></span></span>
          <span class="support-sparkle-precess support-sparkle-precess-2" aria-hidden="true"><span class="support-sparkle-ellipse"><span class="support-sparkle-orbit support-sparkle-orbit-2"><span class="support-sparkle support-sparkle-2 support-sparkle-purple"></span></span></span></span>
          <span class="support-sparkle support-sparkle-3 support-sparkle-blue" aria-hidden="true"></span>
          <button type="button" id="support-open-btn" class="topbar-help topbar-support-btn" title="<%= t('Support this project') %>" aria-label="<%= t('Support this project') %>">
            <%- icon('heart') %>
          </button>
        </span>
        <dialog id="support-dialog" class="update-changelog-dialog support-dialog">
          <h2><%= t('Support LoxSuite') %></h2>
          <p class="hint"><%= t('LoxSuite is built and maintained by a solo developer. If it\'s made managing your Loxone/MQTT setup easier, here\'s how you can help keep it going.') %></p>
          <div class="support-dialog-links">
            <a href="https://github.com/DaveRutten/LoxSuite" target="_blank" rel="noopener" class="support-dialog-link">
              <%- icon('star') %>
              <span>
                <strong><%= t('Star on GitHub') %></strong>
                <small><%= t('Helps new people find LoxSuite and keeps me motivated.') %></small>
              </span>
            </a>
            <a href="https://paypal.me/LoxSuite" target="_blank" rel="noopener" class="support-dialog-link">
              <%- icon('heart') %>
              <span>
                <strong><%= t('Donate via PayPal') %></strong>
                <small><%= t('A one-time tip to fuel late-night coding sessions.') %></small>
              </span>
            </a>
          </div>
          <div style="display:flex; justify-content:flex-end; margin-top:0.9rem;">
            <button type="button" class="btn-soft" id="support-dialog-close"><%= t('Close') %></button>
          </div>
        </dialog>
        <script>
          (function () {
            var dialog = document.getElementById('support-dialog');
            var openBtn = document.getElementById('support-open-btn');
            var closeBtn = document.getElementById('support-dialog-close');
            if (!dialog || !openBtn) return;
            openBtn.addEventListener('click', function () { dialog.showModal(); });
            if (closeBtn) closeBtn.addEventListener('click', function () { dialog.close(); });
          })();
        </script>
        <% if (currentUser) { %>
          <div class="notification-center">
            <button type="button" id="notification-center-btn" class="notification-center-btn" title="<%= t('Notifications') %>" aria-label="<%= t('Notifications') %>">
              <%- icon('bell') %>
              <% if (unreadNotificationCount > 0) { %>
                <span id="notification-center-badge" class="notification-center-badge"><%= unreadNotificationCount > 99 ? '99+' : unreadNotificationCount %></span>
              <% } %>
            </button>
            <div id="notification-center-panel" class="account-menu-panel notification-center-panel" hidden>
              <div id="notification-center-list"><%- include('notification-center-items', { recentNotifications }) %></div>
              <div class="account-menu-divider"></div>
              <div class="notification-center-footer">
                <button type="button" id="notification-center-dismiss-all" class="btn-soft" <%= recentNotifications.length === 0 ? 'disabled' : '' %>><%= t('Mark all read') %></button>
                <% if (canView('logs_notifications')) { %>
                  <a href="/logs/notifications" id="notification-center-view-all"><%= t('View all') %></a>
                <% } %>
              </div>
            </div>
          </div>
          <div class="account-menu">
            <button type="button" id="account-menu-btn" class="account-menu-btn">
              <% if (currentUser.avatarUrl) { %>
                <img src="/avatar/<%= currentUser.id %>" alt="" class="account-menu-avatar">
              <% } else { %>
                <span class="account-menu-avatar account-menu-avatar-fallback"><%= (currentUser.displayName || currentUser.username).charAt(0).toUpperCase() %></span>
              <% } %>
              <span class="account-menu-name"><%= currentUser.displayName || currentUser.username %></span>
            </button>
            <div id="account-menu-panel" class="account-menu-panel" hidden>
              <a href="/profile" class="<%= active === 'profile' ? 'active' : '' %>"><%= t('Profile') %></a>
              <a href="/app" class="<%= active === 'app' ? 'active' : '' %>"><%= t('App & push') %></a>
              <% /* Settings has no meaningful read-only view — every field on it is an edit
                     control, nothing to look at without also being able to change it — so this
                     (and the page's own content, see settings-general.ejs) gates on edit, not
                     view. A "View" grant on the Settings row in Access Roles is otherwise a dead
                     end: canView(true) but a blank page once there, since nothing on it renders
                     for anyone who can't also canEdit. */ %>
              <% if (canEdit('settings')) { %>
                <a href="/settings" class="<%= active === 'settings' ? 'active' : '' %>"><%= t('Settings') %></a>
              <% } else if ((typeof moduleOn !== 'function' || moduleOn('charging')) && canView('charging')) { %>
                <a href="/settings/energy" class="<%= active === 'settings' ? 'active' : '' %>"><%= t('Settings') %></a>
              <% } %>
              <% if (currentUser.isAdmin) { %>
                <a href="/admin/general" class="<%= active === 'admin' ? 'active' : '' %>"><%= t('Administration') %></a>
              <% } %>
              <div class="account-menu-divider"></div>
              <form method="post" action="/logout">
                <button type="submit"><%- icon('logout') %> <%= t('Log out') %></button>
              </form>
            </div>
          </div>
        <% } %>
      </div>
    </header>
    <main>
