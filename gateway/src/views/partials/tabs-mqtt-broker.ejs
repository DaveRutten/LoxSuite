<%
  // Shared by the three "MQTT broker" admin pages (see the sidebar's consolidated "Broker" link in
  // partials/head.ejs) — locals: active. canView comes from res.locals, always in scope.
%>
<div class="tabs">
  <% /* canEdit, not canView — same reasoning as the sidebar's own Settings link (see head.ejs):
        nothing on this tab renders for a view-only grant, it's all edit controls. */ %>
  <% if (canEdit('settings')) { %><a href="/settings/broker" class="<%= active === 'broker-settings' ? 'active' : '' %>">Broker connection</a><% } %>
  <% if (canView('mqtt_users')) { %><a href="/mqtt-users" class="<%= active === 'mqtt-users' ? 'active' : '' %>">Users</a><% } %>
  <% if (canView('mqtt_roles')) { %><a href="/mqtt-roles" class="<%= active === 'mqtt-roles' ? 'active' : '' %>">Roles</a><% } %>
</div>
