<%
  // Administration detail pages: a compact bar instead of 13 tabs. The breadcrumb above the title goes
  // back to the Administration home; here the other parts of the same group as chips, and "All" for
  // the rest. Who sees which part: src/adminHub.js (the same rules as the old tabs). locals: active.
  const adminNavGroups = adminGroups(locals);
  const adminNavHere = adminNavGroups.find((g) => g.tiles.some((x) => x.key === active));
%>
<nav class="admin-nav" aria-label="<%= t('Administration') %>">
  <% if (adminNavHere) { %>
    <span class="admin-nav-group"><span aria-hidden="true"><%= adminNavHere.icon %></span> <%= adminNavHere.label %></span>
    <% if (adminNavHere.tiles.length > 1) { %>
      <div class="admin-nav-chips">
        <% adminNavHere.tiles.forEach((x) => { %><a href="<%= x.href %>" class="<%= x.key === active ? 'active' : '' %>"<%- x.key === active ? ' aria-current="page"' : '' %>><%= x.label %></a><% }) %>
      </div>
    <% } %>
  <% } %>
  <details class="admin-nav-all">
    <summary><%= t('All parts') %></summary>
    <div class="admin-nav-menu">
      <a href="/admin" class="admin-nav-home"><%= t('Administration home') %></a>
      <% adminNavGroups.forEach((g) => { %>
        <div class="admin-nav-menu-group">
          <span><span aria-hidden="true"><%= g.icon %></span> <%= g.label %></span>
          <% g.tiles.forEach((x) => { %><a href="<%= x.href %>" class="<%= x.key === active ? 'active' : '' %>"><%= x.label %></a><% }) %>
        </div>
      <% }) %>
    </div>
  </details>
</nav>
<script>
  // On a phone the chips scroll sideways: the current one in view. "All parts" closes on a click or tap outside it, and on Escape.
  (function () { var c = document.querySelector('.admin-nav-chips'), a = c && c.querySelector('a.active'); if (a && c.scrollWidth > c.clientWidth) c.scrollLeft = a.offsetLeft - c.offsetLeft - 16; })();
  document.addEventListener('click', function (e) { document.querySelectorAll('.admin-nav-all[open]').forEach(function (d) { if (!d.contains(e.target)) d.open = false; }); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') document.querySelectorAll('.admin-nav-all[open]').forEach(function (d) { d.open = false; }); });
</script>
