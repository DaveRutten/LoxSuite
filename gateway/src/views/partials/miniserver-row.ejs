<%
  // One Miniserver's own row + its diagnostics expand-row — shared between a top-level row and a
  // Client row (rendered as a real sibling <tr> in the SAME table, not a separate nested table, so
  // its columns can never drift out of alignment with everyone else's). A Client row additionally
  // gets .ms-client-row (hidden by default, shown as a group when its Gateway's own toggle button
  // is clicked — see the dedicated script for that near the bottom of miniservers.ejs) and
  // data-gateway-id so that toggle knows which rows belong to it.
  //
  // Nesting a SECOND independent expand-row/toggle system inside a Gateway's own expand-row was
  // tried first and reverted: the shared `tr.expand-row.open td > *` collapse rule matches via ANY
  // ancestor tr.expand-row.open, not just the closest one, so a Client's own (still-closed)
  // diagnostics row rendered permanently "open" the moment its Gateway's wrapper row opened —
  // impossible to fix without either duplicating that whole rule under a differently-named class
  // (more CSS to keep in sync forever) or, simplest, not nesting expand-rows inside each other at
  // all. Real sibling rows sidestep the whole problem.
  const isClientRow = !!ms.gateway_client_of;
  const rowClass = isClientRow ? ' class="ms-client-row"' : '';
  const gatewayAttr = isClientRow ? ` data-gateway-id="${ms.gateway_client_of}"` : '';
%>
<tr data-ms-id="<%= ms.id %>"<%- rowClass %><%- gatewayAttr %>>
  <% if (canEdit('miniservers')) { %>
  <td class="ms-drag-handle" style="cursor:grab; text-align:center; color:var(--text-muted);" title="Drag to reorder — this order is used everywhere Miniservers are listed"><%- icon('gripVertical') %></td>
  <% } %>
  <%
    // Two fixed slots (not flex+center) so a row's OWN diagnostics chevron and a Gateway's own
    // "show its Clients" share button always land in the same two x-positions everywhere — a
    // Client row's chevron deliberately sits in slot 2 (leaving slot 1 empty), directly under
    // where its own Gateway's share button sits right above it, reading as an indent in the
    // button area itself rather than needing a separate visual cue.
  %>
  <td>
    <div style="display:grid; grid-template-columns: 2.5rem 2.5rem; gap:0.3rem; justify-items:start;">
      <% if (isClientRow) { %>
        <span></span>
        <button type="button" class="icon-btn icon-btn-neutral" data-toggle-row="ms-diag-<%= ms.id %>" title="Show diagnostics"><%- icon('chevron') %></button>
      <% } else { %>
        <button type="button" class="icon-btn icon-btn-neutral" data-toggle-row="ms-diag-<%= ms.id %>" title="Show diagnostics"><%- icon('chevron') %></button>
        <% if (ms.gatewayClientCount > 0) { %>
          <button type="button" class="icon-btn icon-btn-neutral" data-toggle-clients="<%= ms.id %>" title="Show its <%= ms.gatewayClientCount %> Client Miniserver<%= ms.gatewayClientCount === 1 ? '' : 's' %>"><%- icon('sitemap') %></button>
        <% } %>
      <% } %>
    </div>
  </td>
  <td data-ms-status-id="<%= ms.id %>">
    <% const badgeClass = ms.status === 'online' ? 'badge-ok' : ms.status === 'offline' ? 'badge-off' : 'badge-neutral'; %>
    <% const badgeText = ms.status === 'online' ? 'Online' : ms.status === 'offline' ? 'Offline' : 'Unknown'; %>
    <span class="badge badge-live <%= badgeClass %>"><%= badgeText %></span>
  </td>
  <td>
    <span class="truncate" style="max-width:220px;" title="<%= ms.name %>"><%= ms.name %></span>
  </td>
  <td>
    <% if (ms.gatewayClientCount > 0) { %>
      <span class="badge badge-purple" title="Manages <%= ms.gatewayClientCount %> Client Miniserver<%= ms.gatewayClientCount === 1 ? '' : 's' %> that share its merged Loxone Config project — see the share icon at the start of this row">Gateway &middot; <%= ms.gatewayClientCount %> client<%= ms.gatewayClientCount === 1 ? '' : 's' %></span>
    <% } else if (ms.gatewayClientOfName) { %>
      <span class="badge badge-purple" title="Shares <%= ms.gatewayClientOfName %>'s own merged Loxone Config project rather than running a separate one of its own — see loxone.com/enen/kb/gateway-client">Client &ndash; <%= ms.gatewayClientOfName %></span>
    <% } else { %>
      <span class="badge badge-neutral" title="Not part of a Gateway Client group — runs its own separate Loxone Config project">Standalone</span>
    <% } %>
  </td>
  <td><%= ms.host %></td>
  <td><%= ms.http_port %></td>
  <td><%= ms.use_https ? 'yes' : 'no' %></td>
  <td><%= ms.udp_port || '-' %></td>
  <td><% if (ms.external_url) { %><span class="truncate" style="max-width:260px;" title="<%= ms.external_url %>"><%= ms.external_url %></span><% } else { %>-<% } %></td>
  <td><%= ms.username %></td>
  <td><%= ms.last_checked_at ? formatDateTime(ms.last_checked_at) : '-' %></td>
  <td>
    <% if (canEdit('miniservers')) { %>
    <div class="row-actions">
      <%
        // "Test now" (+ its own result breakdown) used to live here — removed in favor of the
        // complete Test already on this Miniserver's own Edit page (see miniserver-edit.ejs),
        // rather than keeping two separate Test implementations in sync.
      %>
      <a class="inline" href="/miniservers/<%= ms.id %>/edit"><button type="button" class="btn-edit"><%- icon('edit') %> Edit</button></a>
      <form class="inline" method="post" action="/miniservers/<%= ms.id %>/delete" data-confirm="Delete this Miniserver?">
        <button type="submit" class="danger"><%- icon('trash') %> Delete</button>
      </form>
    </div>
    <% } %>
  </td>
</tr>
<tr class="expand-row<%= isClientRow ? ' ms-client-row' : '' %>" id="ms-diag-<%= ms.id %>"<%- gatewayAttr %>>
  <td colspan="11"><%- include('miniserver-diagnostics', { ms, PLC_STATE_LABELS }) %></td>
</tr>
