    </main>
  </div>
</div>

<%
  // Always rendered (even on /help itself, harmlessly redundant there — the topbar-help trigger
  // never appears on that page anyway since it's not in head.ejs's helpAnchors map) so every page
  // can open it without a fetch: it's the exact same content as partials/help-content.ejs, already
  // in the DOM, just hidden until toggled.
%>
<div id="help-backdrop" class="help-backdrop"></div>
<aside id="help-drawer" class="help-drawer">
  <div class="help-drawer-head">
    <h2 style="margin:0;">Help</h2>
    <button type="button" id="help-drawer-close" class="icon-btn" title="Close">&times;</button>
  </div>
  <div class="help-drawer-body">
    <%- include('help-content') %>
  </div>
</aside>
<span class="help-drawer-resize-handle" title="Drag to resize"></span>

<script src="/tables.js?v=<%= assetVersion %>" defer></script>
<script src="/range-picker.js?v=<%= assetVersion %>" defer></script>
<script src="/auto-submit-select.js?v=<%= assetVersion %>" defer></script>
<script>
  // Stamps the CSRF token (see middleware/csrf.js) onto every plain-HTML form on the page,
  // instead of hand-adding a hidden field to each of the ~40 view files that have one. Exposed on
  // window rather than a one-shot IIFE because the live-refresh script below (liveSwap) can
  // replace a table's tbody — Live Messages' per-row "Map"/"Widget" forms included — with freshly
  // fetched, unstamped markup; without re-running this after each swap those rows would 403 on
  // the very first submit after a refresh. JSON-bodied fetch() calls elsewhere in this file are
  // exempt on the server side (see csrf.js) and don't need this.
  window.stampCsrfTokens = function () {
    var token = document.querySelector('meta[name="csrf-token"]').content;
    document.querySelectorAll('form').forEach(function (form) {
      if (form.querySelector('input[name="_csrf"]')) return;
      var input = document.createElement('input');
      input.type = 'hidden';
      input.name = '_csrf';
      input.value = token;
      form.appendChild(input);
    });
  };
  window.stampCsrfTokens();
</script>
<script>
  // navigator.clipboard is only defined in a "secure context" — https, or http on localhost —
  // so every copy-to-clipboard button silently did nothing at all when this is reached over plain
  // http on a LAN address (e.g. http://192.168.x.x:5582), which is exactly how this self-hosted
  // app is commonly reached. Falls back to the older execCommand('copy') via a throwaway textarea,
  // which still works in that case. Returns a Promise either way so callers don't need to branch.
  window.copyToClipboard = function (text) {
    if (navigator.clipboard && window.isSecureContext) {
      return navigator.clipboard.writeText(text);
    }
    return new Promise(function (resolve, reject) {
      var textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.focus();
      textarea.select();
      try {
        document.execCommand('copy') ? resolve() : reject(new Error('execCommand copy failed'));
      } catch (err) {
        reject(err);
      } finally {
        document.body.removeChild(textarea);
      }
    });
  };
</script>
<script>
  // A plain <meta refresh> would reload mid-interaction — e.g. closing the
  // Columns menu the moment you opened it, or losing your place in a table.
  // Refresh on the same interval instead, but postpone while a Columns menu
  // is open, and prefer a content-only swap over a full navigation wherever
  // the page opts in (data-live-swap) so scroll position and open panels
  // survive. The interval itself and an outright pause are both a personal
  // display preference, not app data — kept in localStorage, same convention
  // already used for the panel/help drawers' own remembered widths — keyed
  // by path so every auto-refreshing page (Live Data, Client Activity, Logs
  // x4, ...) remembers its own choice independently of the others.
  (function () {
    var defaultSeconds = Number(document.body.dataset.refresh);
    if (!defaultSeconds) return;
    var liveSwap = document.body.dataset.liveSwap === 'true';

    var PRESETS = [5, 10, 30, 60];
    var INTERVAL_KEY = 'refreshInterval:' + location.pathname;
    var PAUSED_KEY = 'refreshPaused:' + location.pathname;

    function loadSeconds() {
      var saved = Number(localStorage.getItem(INTERVAL_KEY));
      return saved > 0 ? saved : defaultSeconds;
    }
    function isPaused() {
      return localStorage.getItem(PAUSED_KEY) === '1';
    }

    function menuOpen() {
      return Array.prototype.some.call(
        document.querySelectorAll('.columns-menu-panel'),
        function (panel) { return !panel.hidden; }
      );
    }

    // tables.js's collapseRowActions() builds a row's "more actions" popover as a sibling of
    // <body>, not a descendant of the row's own <tr> (see its own comment on why — position:fixed
    // to escape .table-wrap's overflow-x:auto clipping) — and MOVES that row's action buttons
    // into it rather than cloning them. A tbody swap below replaces the row (and whatever's left of
    // its now-emptied .row-actions) with fresh markup, but has no way to reach — let alone close —
    // this detached popover, so it would just sit there open, showing stale pre-refresh content,
    // while refreshTables() (called after every swap) builds a SECOND, hidden popover for the same
    // row on top of it. Postponing here, the same way menuOpen()/selectionActive() already do for
    // an open Columns menu or an active Logs selection, avoids all of that by simply not swapping
    // until whatever's open gets closed.
    function rowActionsOpen() {
      return !!document.querySelector('.row-actions-popover:not([hidden])');
    }

    function swapFrom(doc) {
      // Swapping a tbody's innerHTML shouldn't move anything, but a row count/height change can
      // still leave a scrolled-down table (or the whole page, if it's the one thing keeping the
      // page tall enough to be scrolled) looking like it "jumped" — restored explicitly rather
      // than assumed, since that's cheap insurance regardless of the actual cause.
      var scrollY = window.scrollY;
      var wrapScrolls = Array.prototype.map.call(document.querySelectorAll('.table-wrap'), function (wrap) {
        return { wrap: wrap, left: wrap.scrollLeft };
      });

      document.querySelectorAll('[data-live-id]').forEach(function (el) {
        var fresh = doc.querySelector('[data-live-id="' + el.dataset.liveId + '"]');
        if (fresh) el.innerHTML = fresh.innerHTML;
      });

      var freshTables = doc.querySelectorAll('.table-wrap table');
      document.querySelectorAll('.table-wrap table').forEach(function (table, i) {
        var freshBody = freshTables[i] && freshTables[i].querySelector('tbody');
        var body = table.querySelector('tbody');
        if (freshBody && body) body.innerHTML = freshBody.innerHTML;
      });

      // Small standalone tables (e.g. a dashboard panel) that intentionally opt out of
      // the .table-wrap column-menu/drag machinery still get the same tbody-only swap.
      var freshPanelTables = doc.querySelectorAll('.panel-table');
      document.querySelectorAll('.panel-table').forEach(function (table, i) {
        var freshBody = freshPanelTables[i] && freshPanelTables[i].querySelector('tbody');
        var body = table.querySelector('tbody');
        if (freshBody && body) body.innerHTML = freshBody.innerHTML;
      });

      window.stampCsrfTokens();
      if (window.refreshTables) window.refreshTables();

      window.scrollTo(window.scrollX, scrollY);
      wrapScrolls.forEach(function (entry) { entry.wrap.scrollLeft = entry.left; });
    }

    function selectionActive() {
      // Optional hook, only defined on pages that load log-select.js — postpones the same way
      // menuOpen() does, so a mid-selection swap doesn't wipe out a Logs page's checked rows.
      return !!(window.hasActiveLogSelection && window.hasActiveLogSelection());
    }

    function tick() {
      setTimeout(function () {
        if (isPaused() || menuOpen() || selectionActive() || rowActionsOpen()) { tick(); return; }
        if (!liveSwap) { location.reload(); return; }
        fetch(location.pathname + location.search)
          .then(function (res) { return res.text(); })
          .then(function (html) {
            swapFrom(new DOMParser().parseFromString(html, 'text/html'));
            tick();
          })
          .catch(function () { tick(); });
      }, loadSeconds() * 1000); // re-read every tick so a change made mid-visit takes effect on the very next cycle, not just after a reload
    }
    tick();

    // Interval select + pause toggle, injected into the topbar rather than hand-added to each of
    // the ~8 auto-refreshing pages' own markup — this one shared script already knows which pages
    // those are (data-refresh is only ever set on them, see partials/head.ejs), so building the
    // control here covers all of them, present and future, for free. One bordered pill (matching
    // .topbar-help right next to it) rather than two loose floating controls, with the same
    // preset-dropdown-plus-"Custom…"-fallback shape already used for panel unit fields
    // (see unitField() in panel-grid.ejs) for entering an arbitrary interval.
    var topbarRight = document.querySelector('.topbar-right');
    if (topbarRight) {
      var wrap = document.createElement('div');
      wrap.className = 'refresh-control';

      var select = document.createElement('select');
      select.title = 'Auto-refresh interval';
      PRESETS.forEach(function (s) {
        var opt = document.createElement('option');
        opt.value = s;
        opt.textContent = s + 's';
        select.appendChild(opt);
      });
      var customOpt = document.createElement('option');
      customOpt.value = '__custom__';
      customOpt.textContent = 'Custom…';
      select.appendChild(customOpt);

      // A bare number ("90"), or one suffixed with a unit ("5m", "90s", "2 min") — text rather
      // than type="number" specifically so a trailing letter is even possible to type at all.
      function parseCustomSeconds(raw) {
        var match = String(raw).trim().match(/^(\d+(?:\.\d+)?)\s*(m|min|mins|minutes|s|sec|secs|seconds)?$/i);
        if (!match) return null;
        var amount = Number(match[1]);
        var isMinutes = (match[2] || 's').charAt(0).toLowerCase() === 'm';
        var seconds = Math.round(isMinutes ? amount * 60 : amount);
        return seconds > 0 ? seconds : null;
      }

      var customInput = document.createElement('input');
      customInput.type = 'text';
      customInput.inputMode = 'numeric';
      customInput.placeholder = 'e.g. 90s or 5m';
      customInput.className = 'refresh-custom-input';
      customInput.title = 'Custom interval — a plain number of seconds, or e.g. "5m" for minutes';

      var savedSeconds = loadSeconds();
      var isCustom = PRESETS.indexOf(savedSeconds) === -1;
      select.value = isCustom ? '__custom__' : savedSeconds;
      customInput.value = savedSeconds;
      customInput.hidden = !isCustom;

      select.addEventListener('change', function () {
        if (select.value === '__custom__') {
          customInput.hidden = false;
          customInput.focus();
          return;
        }
        customInput.hidden = true;
        localStorage.setItem(INTERVAL_KEY, select.value);
      });
      customInput.addEventListener('change', function () {
        var seconds = parseCustomSeconds(customInput.value);
        if (seconds) localStorage.setItem(INTERVAL_KEY, seconds);
      });

      var toggleBtn = document.createElement('button');
      toggleBtn.type = 'button';
      toggleBtn.className = 'icon-btn refresh-toggle-btn';
      // Inlined rather than using the server-side icon() helper — this is a plain static asset
      // with no access to that (same reasoning as tables.js's own inlined Columns-button icon).
      var PAUSE_SVG = '<svg class="icon" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg>';
      var PLAY_SVG = '<svg class="icon" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="6 4 20 12 6 20 6 4"/></svg>';
      function renderToggle() {
        var paused = isPaused();
        toggleBtn.innerHTML = paused ? PLAY_SVG : PAUSE_SVG;
        toggleBtn.title = paused ? 'Resume auto-refresh' : 'Pause auto-refresh';
        toggleBtn.setAttribute('aria-label', toggleBtn.title);
        toggleBtn.classList.toggle('refresh-paused', paused);
      }
      toggleBtn.addEventListener('click', function () {
        localStorage.setItem(PAUSED_KEY, isPaused() ? '0' : '1');
        renderToggle();
      });
      renderToggle();

      wrap.appendChild(select);
      wrap.appendChild(customInput);
      wrap.appendChild(toggleBtn);
      topbarRight.insertBefore(wrap, topbarRight.firstChild);
    }

  })();
</script>
<!-- The dashboard-wide time filter used to be built entirely here via document.createElement — now
     server-rendered directly in partials/head.ejs's topbar-right (the same shared rangeField()
     widget as Monitor detail/Logs/the dashboard panel Range field), synced by the sitewide
     public/range-picker.js. -->
<script>
  // Collapsible sections, keyed by an arbitrary data-nav-section string persisted server-side
  // (routes/navPrefs.js) so it follows the user across devices/browsers, same as their table
  // column preferences. Started out sidebar-only (partials/head.ejs's .nav-section-label) but the
  // same toggle-and-remember behavior applies to any [data-nav-section] button regardless of its
  // own styling — the dashboard home page's .section-toggle headers reuse it as-is.
  (function () {
    document.querySelectorAll('[data-nav-section]').forEach(function (btn) {
      var group = btn.nextElementSibling;
      if (!group) return;
      btn.addEventListener('click', function () {
        var collapsed = !group.hidden;
        group.hidden = collapsed;
        btn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
        fetch('/api/nav-prefs/' + encodeURIComponent(btn.dataset.navSection), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ collapsed: collapsed }),
        });
      });
    });
  })();
</script>
<script>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var current = document.documentElement.getAttribute('data-theme')
        || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      var next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    });
  })();
</script>
<script>
  // The "?" button next to a panel/chart settings drawer's own star (save-as-default) icon
  // (monitor-detail.ejs, panel-grid.ejs) — hides every .hint paragraph inside a settings drawer,
  // a display preference (not app data, hence localStorage not a DB setting) that applies to every
  // drawer on every page at once, same as the theme toggle above. A brand-new user benefits from
  // the hints; someone who's configured a hundred panels already knows what Stepped line does and
  // would rather the form read shorter.
  (function () {
    var STORAGE_KEY = 'loxsuite-panel-hints-hidden';
    // One shared state, every button on the page reflects it — a dashboard can have many panels,
    // each with its own drawer and its own "?" button; toggling one toggles them all, including
    // ones added later (a new panel's own button gets this class the next time applyState runs,
    // e.g. right after the click that added it re-renders the toolbar).
    function applyState(hidden) {
      document.body.classList.toggle('panel-hints-hidden', hidden);
      document.querySelectorAll('.hints-toggle-btn').forEach(function (btn) {
        // Green/"active" means "help text is currently ON" (same convention as the Hardware page's
        // own Alert buttons — green = the thing is currently doing something) — NOT "hiding is
        // active", which read backwards (green right after hiding them, the default state).
        btn.classList.toggle('active', !hidden);
        btn.title = hidden ? 'Show the help text under each field' : 'Hide the help text under each field';
      });
    }
    // Hidden by default (no stored preference yet) — an unset key reads back as null, not '0', so
    // this has to check for the explicit "shown" value rather than the more obvious-looking
    // `=== '1'` (which would default to shown).
    applyState(localStorage.getItem(STORAGE_KEY) !== '0');

    // The topbar's own copy (see partials/head.ejs) is rendered unconditionally on every page —
    // unlike a page's own dedicated "?" button, which only ever exists on a page that actually has
    // a hint-bearing form to go with it. Pages with neither (Live Data, Logs, Hardware, ...) had a
    // button that visibly did nothing when clicked, which read as broken rather than "there's just
    // nothing to toggle here". Hidden whenever none of the scoped selectors the CSS rule above
    // actually targets (see .panel-hints-hidden in style.css) are present on the page at all.
    // Also hidden on any page with .dash-panel (Home/My Dashboards) even though those DO have
    // .panel-settings-form on them — every one of those forms (Add-panel included) already carries
    // its own dedicated hints-toggle button in its own header, so the global topbar copy would just
    // be a second, redundant way to do the exact same thing right next to the one that's actually
    // scoped to the form you're looking at.
    var topbarToggle = document.getElementById('topbar-hints-toggle');
    if (topbarToggle && (document.querySelector('.dash-panel') || !document.querySelector('.panel-settings-form, #add-ms-form, #edit-ms-form, #mqtt-broker-card, #settings-form, #device-templates-hint'))) {
      topbarToggle.hidden = true;
    }

    document.addEventListener('click', function (e) {
      if (e.target.closest('.hints-toggle-btn')) {
        var hidden = !document.body.classList.contains('panel-hints-hidden');
        applyState(hidden);
        localStorage.setItem(STORAGE_KEY, hidden ? '1' : '0');
        return;
      }
      // Opening a DIFFERENT drawer (a dashboard has one settings-form + one "?" button per panel,
      // all already in the DOM, just individually toggled — see [data-toggle-row] elsewhere in
      // this file) doesn't run this IIFE again, so that button's own .active class would otherwise
      // only ever get set by the one-time call above, before this specific button existed to find —
      // re-applying the CURRENT (unchanged) state on every click is cheap and catches it regardless.
      if (e.target.closest('[data-toggle-row]')) {
        applyState(document.body.classList.contains('panel-hints-hidden'));
      }
    });
  })();
</script>
<script>
  // Off-canvas sidebar for narrow (phone-width) viewports — the sidebar itself is always in the
  // DOM (see partials/head.ejs), CSS just slides it off-screen below the mobile breakpoint and
  // this toggles it back on/off. Same backdrop-click/Escape-to-close idiom as the Help drawer
  // right below, deliberately not shared code with it — different element, no state in common.
  (function () {
    var toggle = document.getElementById('mobile-nav-toggle');
    var sidebar = document.querySelector('.sidebar');
    var backdrop = document.getElementById('sidebar-backdrop');
    if (!toggle || !sidebar || !backdrop) return;

    function closeSidebar() {
      sidebar.classList.remove('open');
      backdrop.classList.remove('open');
      document.body.classList.remove('no-scroll');
    }

    toggle.addEventListener('click', function () {
      sidebar.classList.add('open');
      backdrop.classList.add('open');
      // Without this, a touch-drag over the backdrop (or the sidebar's own now-scrollable nav
      // list, see .sidebar's overflow-y in style.css) scrolls the PAGE underneath instead of —
      // or as well as — whatever's on top, since nothing stops the body from still being
      // scrollable while this off-canvas panel covers it.
      document.body.classList.add('no-scroll');
    });
    backdrop.addEventListener('click', closeSidebar);
    // A nav link tap navigates immediately (full page load), so there's no visible close
    // animation to wait for — this just avoids the sidebar still being marked "open" for an
    // instant on whatever page loads next, before its own script re-runs this same setup fresh.
    sidebar.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', closeSidebar); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeSidebar(); });
  })();
</script>
<script>
  // The in-page Help drawer — opened from the topbar's per-page "Help" button
  // (marked [data-help-open], see partials/head.ejs), instead of navigating to
  // /help. Content is already in the DOM (partials/help-content.ejs, included
  // above), so opening it is just a class toggle, no fetch involved.
  (function () {
    var drawer = document.getElementById('help-drawer');
    var backdrop = document.getElementById('help-backdrop');
    var closeBtn = document.getElementById('help-drawer-close');
    if (!drawer || !backdrop) return;

    function openDrawer(anchor) {
      drawer.classList.add('open');
      backdrop.classList.add('open');

      if (!anchor) return;
      var target = drawer.querySelector('#' + anchor);
      if (!target || target.tagName !== 'DETAILS') return;
      target.open = true;
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      target.classList.add('help-highlight');
      setTimeout(function () { target.classList.remove('help-highlight'); }, 2200);
    }

    function closeDrawer() {
      drawer.classList.remove('open');
      backdrop.classList.remove('open');
    }

    // These stay real <a href="/help..."> links (not buttons) so a no-JS visit or a
    // middle-click/"open in new tab" still gets the standalone page — JS just
    // intercepts the plain click to open the drawer instead of navigating.
    document.querySelectorAll('[data-help-open]').forEach(function (link) {
      link.addEventListener('click', function (e) {
        e.preventDefault();
        openDrawer(link.dataset.helpAnchor);
      });
    });
    closeBtn.addEventListener('click', closeDrawer);
    backdrop.addEventListener('click', closeDrawer);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeDrawer();
    });
  })();
</script>
<script>
  // Drag-to-resize for the Help drawer's width — same handle-and-CSS-variable mechanic as the
  // dash-panel edit drawer's own .panel-drawer-resize-handle (see panel-grid.ejs), just a separate
  // width/localStorage key since the two drawers hold very different content and there's no reason
  // a preferred width for one should carry over to the other.
  (function () {
    var handle = document.querySelector('.help-drawer-resize-handle');
    if (!handle) return;
    var STORAGE_KEY = 'helpDrawerWidth';
    var MIN_WIDTH = 320;

    function maxWidth() { return Math.min(900, window.innerWidth * 0.92); }

    var saved = localStorage.getItem(STORAGE_KEY);
    if (saved) document.documentElement.style.setProperty('--help-drawer-width', Math.min(Number(saved), maxWidth()) + 'px');

    handle.addEventListener('mousedown', function (e) {
      e.preventDefault();
      var startX = e.clientX;
      var startWidth = document.getElementById('help-drawer').getBoundingClientRect().width;
      handle.classList.add('dragging');
      // The handle's own CSS cursor:ew-resize (see style.css) only shows while the mouse is
      // hovering its thin 6px strip — which a real drag moves off of immediately. Forced on
      // <body> for the drag's duration instead, so the resize cursor keeps showing wherever the
      // mouse actually passes over while dragging.
      document.body.style.cursor = 'ew-resize';
      document.body.style.userSelect = 'none';

      function onMove(e) {
        // Dragging left (clientX decreases) should widen the drawer — its right edge is pinned to
        // the viewport edge, so the left edge (and this handle) are what actually move.
        var width = Math.max(MIN_WIDTH, Math.min(maxWidth(), startWidth + (startX - e.clientX)));
        document.documentElement.style.setProperty('--help-drawer-width', width + 'px');
      }
      function onUp() {
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseup', onUp);
        handle.classList.remove('dragging');
        document.body.style.cursor = '';
        document.body.style.userSelect = '';
        localStorage.setItem(STORAGE_KEY, getComputedStyle(document.documentElement).getPropertyValue('--help-drawer-width').trim().replace('px', ''));
      }
      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', onUp);
    });
  })();
</script>
<script>
  // Topbar account menu (avatar + name -> Profile/Administration/Log out popover).
  (function () {
    var btn = document.getElementById('account-menu-btn');
    var panel = document.getElementById('account-menu-panel');
    if (!btn || !panel) return;

    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      panel.hidden = !panel.hidden;
    });
    document.addEventListener('click', function () { panel.hidden = true; });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') panel.hidden = true;
    });
  })();
</script>
<script>
  // Topbar Notification Center bell — same show/hide-popover mechanics as the account menu just
  // above (independent element ids, so both can coexist without interfering). Two things it adds
  // on top: its own periodic poll for the badge count, since this is topbar chrome present on
  // every page, unlike the existing data-refresh mechanism (see the live-refresh script above),
  // which is opt-in per page and refreshes page content, not chrome — unsuitable here regardless
  // of page; and explicit mark-read triggers. Deliberately NOT on every popover open — just
  // glancing at the list isn't the same as having dealt with it, so the badge only clears via
  // "Mark all read", "View all" (both explicit acknowledgements), or naturally once nothing's left
  // unread.
  (function () {
    var btn = document.getElementById('notification-center-btn');
    var panel = document.getElementById('notification-center-panel');
    if (!btn || !panel) return;

    function markRead() {
      var badge = document.getElementById('notification-center-badge');
      if (badge) badge.remove();
      // Content-Type: application/json is what lets this skip the CSRF token entirely (see
      // middleware/csrf.js) — the route reads no request body, same trick the dashboard panel's
      // own save-as-default/reset-to-default fetch() calls already use (see panel-grid.ejs).
      fetch('/notifications/mark-read', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' }).catch(function () {});
    }

    function applyBadgeCount(count) {
      var badge = document.getElementById('notification-center-badge');
      if (!count) { if (badge) badge.remove(); return; }
      var text = count > 99 ? '99+' : String(count);
      if (badge) {
        badge.textContent = text;
      } else {
        badge = document.createElement('span');
        badge.id = 'notification-center-badge';
        badge.className = 'notification-center-badge';
        badge.textContent = text;
        btn.appendChild(badge);
      }
    }

    // Dismissing one item (see the list click handler below) advances the read watermark past it
    // server-side (routes/notificationCenter.js's own /:id/dismiss), so the badge can genuinely
    // have changed — but that always happens WHILE the popover is open, unlike poll()'s own
    // periodic badge refresh a little further down (which deliberately skips updating while open,
    // so it never overwrites something the user is mid-way through acting on). Unconditional here
    // for exactly that reason: this one only ever runs because of an action the user just took.
    function refreshBadgeCount() {
      fetch('/notifications/unread-count').then(function (res) { return res.json(); }).then(function (data) {
        applyBadgeCount(data.count);
      }).catch(function () {});
    }

    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      panel.hidden = !panel.hidden;
    });
    document.addEventListener('click', function () { panel.hidden = true; });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') panel.hidden = true;
    });

    // "View all" navigates away to the full Logs > Notifications history — treated the same as
    // "Mark all read" (see below) rather than left to clear on its own the next time the badge
    // happens to get polled after that page load.
    var viewAllLink = document.getElementById('notification-center-view-all');
    if (viewAllLink) viewAllLink.addEventListener('click', function () { markRead(); });

    // "x" per item and the footer's "Mark all read" both live inside the popover — stopPropagation
    // keeps the document-level closer above from snapping the whole thing shut on every click, the
    // same reason the bell button itself needs it.
    var list = document.getElementById('notification-center-list');
    var dismissAllBtn = document.getElementById('notification-center-dismiss-all');

    function showEmptyState() {
      if (!list || list.querySelector('.notification-center-empty')) return;
      list.innerHTML = '<p class="hint notification-center-empty" style="margin:0.6rem 0.9rem;">No notifications yet.</p>';
      if (dismissAllBtn) dismissAllBtn.disabled = true;
    }

    if (list) {
      list.addEventListener('click', function (e) {
        e.stopPropagation();
        var dismissBtn = e.target.closest('[data-dismiss-notification]');
        if (dismissBtn) {
          var item = dismissBtn.closest('.notification-center-item');
          var id = dismissBtn.dataset.dismissNotification;
          fetch('/notifications/' + id + '/dismiss', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' })
            .then(function () { refreshBadgeCount(); })
            .catch(function () {});
          if (item) item.remove();
          if (!list.querySelector('.notification-center-item')) showEmptyState();
          return;
        }
        // Clicking through to a notification's own source page (see notification-center-items.ejs's
        // notificationSourceLink()) is treated as having dealt with it — keepalive so the request
        // still lands even though the very same click also starts navigating the page away.
        var sourceLink = e.target.closest('.notification-center-item-link');
        if (sourceLink) {
          var linkedItem = sourceLink.closest('.notification-center-item');
          var linkedId = linkedItem && linkedItem.dataset.notificationId;
          if (linkedId) {
            fetch('/notifications/' + linkedId + '/mark-read', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}', keepalive: true }).catch(function () {});
          }
        }
      });
    }

    if (dismissAllBtn) {
      dismissAllBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        if (dismissAllBtn.disabled) return;
        fetch('/notifications/dismiss-all', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' }).catch(function () {});
        markRead();
        showEmptyState();
      });
    }

    var POLL_MS = 60000; // matches healthcheck_interval_seconds's own default cadence
    function poll() {
      fetch('/notifications/unread-count').then(function (res) { return res.json(); }).then(function (data) {
        // Popover open — don't overwrite what the user is currently looking at with a fetch that
        // started before they opened it. (Dismissing/clicking through an item while it's open
        // updates the badge its own way — see refreshBadgeCount/applyBadgeCount above — this guard
        // is specifically about this periodic background poll, not those direct user actions.)
        if (!panel.hidden) return;
        applyBadgeCount(data.count);
      }).catch(function () {});

      // The badge count above and this list are two separate fetches/endpoints, but both were
      // going stale for the same underlying reason: only the badge used to poll live, so a new
      // notification could bump the count to "1" while the popover's own content — baked into the
      // page at its last full load — still didn't include that item at all until an actual
      // navigation or F5. Same "don't overwrite what's currently open" guard as above.
      if (list && !panel.hidden) return;
      if (list) {
        fetch('/notifications/recent').then(function (res) { return res.text(); }).then(function (html) {
          list.innerHTML = html;
          if (dismissAllBtn) dismissAllBtn.disabled = !list.querySelector('.notification-center-item');
        }).catch(function () {});
      }
    }
    setInterval(poll, POLL_MS);
  })();
</script>
<script>
  // A row-action button with data-toggle-row="<id>" (Rename/Test/Reset password/Edit panel/...)
  // reveals a collapsed sibling with that id instead of opening a floating popover — it expands
  // in place (full table width for a <tr>, full card width for a dash-panel's form), so it can
  // never overflow or get clipped the way a floated box would. Toggled via a .open class (not the
  // hidden attribute) specifically so CSS can transition it open/closed instead of an abrupt snap
  // — see tr.expand-row and .panel-settings-form in style.css.
  // Any .truncate cell (a long topic/value/URL cut short with an ellipsis) already has the full
  // text in its title attribute for a hover tooltip — click does the same thing more reliably,
  // since native tooltips are slow and don't exist at all on touch devices. Toggles the text
  // in place (wrapping within its cell) rather than popping up anything separate.
  (function () {
    document.addEventListener('click', function (e) {
      var el = e.target.closest('.truncate');
      if (!el) return;
      el.classList.toggle('truncate-expanded');
    });
  })();
</script>
<script>
  // Delegated on document (rather than bound to each [data-toggle-row] at load time) so this also
  // covers a button tables.js creates dynamically after this script has already run (see its
  // collapseRowActions) — a direct per-element bind at parse time would simply never see those.
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-toggle-row]');
    if (!btn) return;
    var row = document.getElementById(btn.dataset.toggleRow);
    if (!row) return;
    var opening = !row.classList.contains('open');
    row.classList.toggle('open');
    // Harmless on any button (only .icon-btn actually renders it — see style.css), toggled here
    // regardless of button type so a page-specific icon-only trigger (Miniservers' own diagnostics
    // chevron, a table's collapsed-actions kebab, ...) always reads as "currently open" without
    // each one needing its own copy of this same one-liner.
    btn.classList.toggle('active', opening);
    if (opening) {
      var firstInput = row.querySelector('input, select, textarea');
      // preventScroll: a wide table (e.g. Mappings) scrolls horizontally, and this input usually
      // sits at the LEFT of its own row while the toggle button that revealed it lives at the
      // FAR RIGHT (the Actions column) — an ordinary .focus() call's browser-native "scroll the
      // focused element into view" would yank the table's scroll position back toward the left to
      // show this input, dragging whatever the user was just looking at (e.g. another expanded
      // row's right-aligned action buttons) off-screen in the process.
      if (firstInput) firstInput.focus({ preventScroll: true });
    }
  });
</script>
<script>
  // Any form[data-confirm="message"] gets a native-confirm()-free "are you sure?" — clicking its
  // submit button hides that button and slides out a full-width bar (message + Yes/Cancel, Yes
  // matching the trigger's own color) right below the whole row-actions group instead of inline
  // next to the other buttons, where it fragmented across multiple wrapped lines in the cramped
  // remaining space. Placed after .row-actions when there is one, else after the form itself.
  //
  // Deferred to DOMContentLoaded (rather than running immediately, inline, at parse time) so it
  // runs AFTER tables.js's own deferred collapseRowActions() — that one relocates a row's whole
  // .row-actions bar (buttons and all) into a newly-built kebab expand-row once there's more than
  // one action, and anchoring here needs to land AFTER that final location, not the original
  // (about to be emptied out) one. Getting this backwards left the confirm bar orphaned in the
  // now-narrow original Actions cell instead of sitting next to the relocated buttons, where a
  // real <td> won't clip its overflow — it visually bled into whichever column happened to sit
  // next to that cell instead of appearing where the buttons actually ended up.
  // Bulk-unchecks every checkbox inside the element named by data-uncheck-target — e.g. the Roles
  // page's "None — hide all logs" button, so an admin doesn't have to click each of the 4 log
  // toggles individually to lock a role out of every log. Client-side only, same as any other
  // checkbox edit here — nothing is saved until the form's own Save button is submitted.
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-uncheck-target]');
    if (!btn) return;
    var target = document.getElementById(btn.getAttribute('data-uncheck-target'));
    if (!target) return;
    target.querySelectorAll('input[type="checkbox"]').forEach(function (cb) { cb.checked = false; });
  });

  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('form[data-confirm]').forEach(function (form) {
      var submitBtn = form.querySelector('button[type="submit"]');
      if (!submitBtn) return;

      var bar = document.createElement('div');
      bar.className = 'confirm-bar';
      var inner = document.createElement('div');
      inner.className = 'confirm-bar-inner';
      var text = document.createElement('span');
      text.className = 'confirm-bar-text';
      text.textContent = form.dataset.confirm;
      var yesBtn = document.createElement('button');
      yesBtn.type = 'button';
      yesBtn.className = submitBtn.className;
      // Plain "Yes" (not a copy of the trigger's own "Delete"/label+icon) — shared by every
      // data-confirm bar sitewide, so this one change is enough everywhere it appears. Keeps the
      // trigger's own color class (className below) so a destructive action still reads red.
      yesBtn.textContent = 'Yes';
      var noBtn = document.createElement('button');
      noBtn.type = 'button';
      noBtn.className = 'btn-soft';
      noBtn.textContent = 'Cancel';
      inner.appendChild(text);
      inner.appendChild(yesBtn);
      inner.appendChild(noBtn);
      bar.appendChild(inner);
      // .dash-panel-head is checked before .row-actions: a panel's Delete/Duplicate live in a
      // .row-actions that's itself a flex item inside .dash-panel-head's own (row) flex layout —
      // anchoring to .row-actions there would just squeeze the bar in sideways next to the title
      // instead of below it. Anchoring to the whole head instead lands it as a sibling in
      // .dash-panel's flex *column*, where a new full-width block correctly stacks underneath.
      // In practice this branch no longer fires for a panel's own Delete: tables.js's
      // collapseRowActions() now also collapses .dash-panel-head's row-actions into a kebab menu
      // (see that function's own comment), so by click time the form already lives inside a
      // .row-actions-popover and falls into the rowActionsPopover branch below instead. Left as a
      // fallback rather than removed — harmless if that collapse were ever skipped.
      var anchor = form.closest('.dash-panel-head') || form.closest('.row-actions') || form;
      anchor.insertAdjacentElement('afterend', bar);

      // A .table-toolbar's own flex-wrap means this bar's usual "full-width block below the
      // buttons" treatment (flex-basis:100% once .open, see .confirm-bar in style.css) shoves
      // every toolbar child placed AFTER it (e.g. the Columns button, appended by tables.js) down
      // onto a new line the moment it opens — there's no "after" for it to push things into once
      // it's the toolbar's own child, unlike row-actions/dash-panel-head where nothing else follows
      // it anyway. Fixed-position popover anchored under the triggering button instead, same
      // "escape the .filterable-table-card's own overflow:hidden via position:fixed +
      // getBoundingClientRect()" trick buildColumnsMenu's own dropdown already relies on — so
      // opening it can't move anything else in the toolbar at all.
      var toolbar = form.closest('.table-toolbar');
      // Already living inside tables.js's own floating .row-actions-popover (a kebab-collapsed
      // Actions column) — that's already a fixed-position popover of its own, so this bar stays a
      // plain in-flow block INSIDE it (see growRowActionsPopover below) instead of becoming a
      // second, independently-floating popover stacked underneath it.
      var rowActionsPopover = form.closest('.row-actions-popover');
      // A plain table row's own .row-actions (Edit/Delete, etc. — Miniservers/Users/Roles/... when
      // NOT kebab-collapsed) gets the same popover treatment: a full-width block there is squeezed
      // into that one <td>'s own narrow width, wrapping the message/buttons across several cramped
      // lines instead of a clean floating card. The `!form.closest('.dash-panel-head')` guard is
      // now effectively dead for a panel's own Delete — that row-actions is always kebab-collapsed
      // (see collapseRowActions() in tables.js), so `rowActionsPopover` above already catches it
      // first. Kept anyway as a harmless fallback rather than reworked into an assumption that the
      // collapse always ran.
      var tableRowActions = !toolbar && !rowActionsPopover && !form.closest('.dash-panel-head') ? form.closest('.row-actions') : null;
      var usePopover = !!(toolbar || tableRowActions);
      if (usePopover) bar.classList.add('confirm-bar-popover');

      // Grows the row-actions-popover itself to fit this bar once it opens (rather than relying
      // purely on its own overflow-y:auto scroll) — same "make the first one bigger if needed"
      // request the popover conversion itself came from. Shrinks back once cancelled/closed so a
      // later, shorter interaction doesn't inherit a stale taller box.
      function growRowActionsPopover(open) {
        if (!rowActionsPopover) return;
        if (open) {
          if (!rowActionsPopover.dataset.baseMaxHeight) rowActionsPopover.dataset.baseMaxHeight = rowActionsPopover.style.maxHeight || '';
          var needed = rowActionsPopover.scrollHeight + bar.scrollHeight + 8;
          var current = parseFloat(rowActionsPopover.style.maxHeight) || 0;
          if (needed > current) rowActionsPopover.style.maxHeight = Math.min(needed, window.innerHeight * 0.8) + 'px';
        } else if (rowActionsPopover.dataset.baseMaxHeight != null) {
          rowActionsPopover.style.maxHeight = rowActionsPopover.dataset.baseMaxHeight;
        }
      }

      // Only one sub-panel open at a time inside a row-actions-popover — Test's own merged content
      // (see collapseRowActions in tables.js) fires this same 'subpanelopen' event when IT opens,
      // so this bar closes itself in response instead of both stacking up together.
      if (rowActionsPopover) {
        rowActionsPopover.addEventListener('subpanelopen', function (e) {
          if (e.detail !== bar && bar.classList.contains('open')) {
            bar.classList.remove('open');
            growRowActionsPopover(false);
            submitBtn.hidden = false;
          }
        });
      }

      submitBtn.addEventListener('click', function (e) {
        e.preventDefault();
        if (usePopover) {
          var rect = submitBtn.getBoundingClientRect();
          bar.style.top = (rect.bottom + 6) + 'px';
          bar.style.right = (window.innerWidth - rect.right) + 'px';
        }
        if (rowActionsPopover) rowActionsPopover.dispatchEvent(new CustomEvent('subpanelopen', { detail: bar }));
        submitBtn.hidden = true;
        bar.classList.add('open');
        growRowActionsPopover(true);
      });
      // data-ajax-delete (e.g. Monitor's own per-row Delete, see monitor.ejs): a plain form.submit()
      // navigates away and blocks on the FULL response — fine for a normal delete, but this
      // specific route deliberately responds fast and keeps purging that monitor's history in the
      // background (see routes/monitor.js), so waiting for it here would defeat the whole point.
      // Fires a fetch instead (result intentionally ignored — the route always responds once its
      // own fast/cheap part is done, regardless of how the background purge later turns out) and
      // dispatches a generic event with the form for whichever page-specific script (monitor.ejs's
      // own listener) actually knows how to remove that one row from ITS OWN markup — this file
      // has no business knowing a monitor row's DOM shape, only that "something to clean up
      // client-side" just happened.
      yesBtn.addEventListener('click', function () {
        if (!form.hasAttribute('data-ajax-delete')) { form.submit(); return; }
        var params = new URLSearchParams();
        new FormData(form).forEach(function (value, key) { params.append(key, value); });
        fetch(form.action, { method: 'POST', body: params }).catch(function () {});
        document.dispatchEvent(new CustomEvent('lox:ajax-delete', { detail: { form: form } }));
      });
      noBtn.addEventListener('click', function () {
        bar.classList.remove('open');
        growRowActionsPopover(false);
        setTimeout(function () { submitBtn.hidden = false; }, 200);
      });
    });
  });
</script>
<script>
  // Every unit field (Chart/Gauge/Stat/Threshold, in both a dashboard panel's Add/Edit form and
  // the Monitor detail page's own chart settings — see chartFieldHelpers.js's unitField) is a
  // <select class="unit-select"> of common presets plus "Custom...", paired with a hidden text
  // input that appears when "Custom..." is picked. Only one of the two ever carries the real field
  // name at a time, so exactly one value — never both, never neither — submits. Lives here (not in
  // panel-grid.ejs, its original home) since foot.ejs is the one partial every page that uses
  // unitField() actually includes — a page-specific script would silently no-op wherever unitField
  // renders without its matching sync logic loaded alongside it.
  (function () {
    document.querySelectorAll('.unit-select').forEach(function (select) {
      var input = select.nextElementSibling;
      var name = select.dataset.unitName;

      function sync() {
        if (select.value === '__custom__') {
          select.removeAttribute('name');
          input.name = name;
          input.style.display = '';
        } else {
          select.name = name;
          input.removeAttribute('name');
          input.style.display = 'none';
        }
      }
      select.addEventListener('change', function () {
        sync();
        if (select.value === '__custom__') input.focus();
      });
      sync();
    });
  })();
</script>
<script>
  // Same select-or-custom-input submit shape as .unit-select above, for a preset scale multiplier
  // (see chartFieldHelpers.js's scaleField) — currently only the Monitor detail page's own chart
  // settings, since a dashboard chart panel's per-series scale picker is built dynamically in
  // JS (panel-grid.ejs's buildScalePicker) with its own local wiring already, not this static field.
  (function () {
    document.querySelectorAll('.scale-select').forEach(function (select) {
      var input = select.nextElementSibling;
      var name = select.dataset.scaleName;

      function sync() {
        if (select.value === '__custom__') {
          select.removeAttribute('name');
          input.name = name;
          input.style.display = '';
        } else {
          select.name = name;
          input.removeAttribute('name');
          input.style.display = 'none';
        }
      }
      select.addEventListener('change', function () {
        sync();
        if (select.value === '__custom__') input.focus();
      });
      sync();
    });
  })();
</script>
<script>
  // Drives every .value-mapping-builder (see chartFieldHelpers.js's valueMappingField) — same idea
  // as the threshold builder (threshold-annotation-builder.js), a dynamic add/remove-row UI over a
  // hidden textarea, kept in the "<value>=<label>[=<color>]" format dashboards.js's own
  // parseValueMappings already handles. The color segment is optional per row (a value can just be
  // renamed, with no color of its own). Lives here (not panel-grid.ejs, its original home) since
  // foot.ejs is the one partial every page that uses valueMappingField() actually includes.
  (function () {
    function serializeRows(builder) {
      var lines = [];
      builder.querySelectorAll('.value-mapping-row').forEach(function (row) {
        var value = row.querySelector('.value-mapping-row-value').value.trim();
        var name = row.querySelector('.value-mapping-row-name').value.trim();
        var color = row.querySelector('.value-mapping-row-color').value;
        if (value !== '' && name !== '') lines.push(value + '=' + name + '=' + color);
      });
      builder.querySelector('.value-mapping-hidden').value = lines.join('\n');
    }

    // Every row always carries a color — starting from the next palette slot not already used by
    // a sibling row (see nextAvailableColor in color-picker.js) rather than gated behind its own
    // "give this value a color" checkbox, which was one more click for what's the common case
    // anyway and, on top of that, rendered as a plain unthemed white box in dark mode.
    function addRow(builder, value, name, color) {
      var row = document.createElement('div');
      row.className = 'value-mapping-row';
      var usedColors = Array.prototype.map.call(builder.querySelectorAll('.value-mapping-row-color'), function (el) { return el.value; });
      row.innerHTML =
        '<input type="text" class="value-mapping-row-value" placeholder="Value">' +
        '<input type="text" class="value-mapping-row-name" placeholder="Name to show">' +
        LoxColorPicker.buildPickerHtml(color || LoxColorPicker.nextAvailableColor(usedColors), 'value-mapping-row-color') +
        '<button type="button" class="icon-btn icon-btn-danger value-mapping-row-remove" title="Remove" aria-label="Remove">&times;</button>';
      row.querySelector('.value-mapping-row-value').value = value == null ? '' : value;
      row.querySelector('.value-mapping-row-name').value = name == null ? '' : name;
      var rowsContainer = builder.querySelector('.value-mapping-rows');
      rowsContainer.appendChild(row);
      LoxRowReorder.attachRow(row, rowsContainer, function () { serializeRows(builder); });

      row.querySelector('.value-mapping-row-value').addEventListener('input', function () { serializeRows(builder); });
      row.querySelector('.value-mapping-row-name').addEventListener('input', function () { serializeRows(builder); });
      row.querySelector('.value-mapping-row-color').addEventListener('change', function () { serializeRows(builder); });
      row.querySelector('.value-mapping-row-remove').addEventListener('click', function () {
        LoxRowReorder.removeRow(row);
        serializeRows(builder);
      });
    }

    // Split out so a .value-mapping-builder created entirely client-side (a per-monitor state-bar
    // value/color override — see panel-grid.ejs's state-bar-series row builder) can be wired up on
    // demand, the same way threshold-annotation-builder.js's own initThresholdBuilder now is,
    // instead of only ever running once against whatever existed at this script's own load time.
    function initValueMappingBuilder(builder) {
      var hidden = builder.querySelector('.value-mapping-hidden');
      hidden.value.split('\n').map(function (l) { return l.trim(); }).filter(Boolean).forEach(function (line) {
        var parts = line.split('=');
        if (parts.length < 2) return;
        var color = parts.length > 2 ? parts.slice(2).join('=').trim() : '';
        addRow(builder, parts[0], parts[1], color);
      });
      builder.querySelector('.value-mapping-add-row').addEventListener('click', function () {
        addRow(builder, '', '', '');
        serializeRows(builder);
      });
    }

    document.querySelectorAll('.value-mapping-builder').forEach(initValueMappingBuilder);
    window.LoxValueMappingBuilder = { init: initValueMappingBuilder };
  })();
</script>
<script>
  // A State bar panel's per-monitor value-name/color override (panel-grid.ejs's
  // .state-bar-series-settings) — same checked-monitor-driven row builder shape as that file's own
  // gauge-series one, with a nested .value-mapping-builder instead of a threshold-builder: a state
  // bar's mapping is always discrete raw-value -> name/color, never a continuous threshold. Lives
  // HERE rather than alongside gauge-series in panel-grid.ejs specifically because it needs
  // LoxValueMappingBuilder, defined just above in THIS file — panel-grid.ejs's own <script> tags
  // render earlier in the page than foot.ejs's, so calling LoxValueMappingBuilder.init() from
  // there hit it before that assignment had even run yet (a live ReferenceError, caught testing
  // this exact feature). The nested markup below has to match exactly what valueMappingField()
  // (chartFieldHelpers.js) renders server-side, same reasoning as gauge's own nested
  // threshold-builder.
  (function () {
    function buildStateBarSeriesRow(monitorId, monitorLabel, override) {
      var row = document.createElement('div');
      row.className = 'state-bar-series-row';
      row.dataset.monitorId = monitorId;
      var label = document.createElement('div');
      label.className = 'chart-series-row-label';
      // Overrides the shared rule's own max-width:7rem/nowrap/ellipsis — those exist so a long
      // label doesn't crowd the value/unit/scale fields sitting right next to it on a chart/value/
      // gauge row, but this row has nothing beside the label at all (the value-mapping-builder sits
      // on its own line below), so there's no cramped neighbor to protect here.
      label.style.cssText = 'max-width: none; white-space: normal; overflow: visible; text-overflow: initial;';
      label.textContent = monitorLabel;
      label.title = monitorLabel;
      row.appendChild(label);

      var builder = document.createElement('div');
      builder.className = 'value-mapping-builder';
      builder.style.marginTop = '0.3rem';
      // Same inline SVG chartFieldHelpers.js's icon('plus') renders server-side — see
      // panel-grid.ejs's buildGaugeSeriesRow's own identical comment for why this is hardcoded.
      builder.innerHTML =
        '<div class="value-mapping-rows"></div>' +
        '<button type="button" class="btn-soft value-mapping-add-row"><svg class="icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg> Add value</button>' +
        '<textarea class="value-mapping-hidden" hidden></textarea>';
      builder.querySelector('.value-mapping-hidden').value = (override && override.valueLabelsRaw) || '';
      row.appendChild(builder);
      window.LoxValueMappingBuilder.init(builder);

      return row;
    }

    document.querySelectorAll('.state-bar-series-settings').forEach(function (container) {
      var form = container.closest('form');
      var checklist = form.querySelector(container.dataset.checklistSelector);
      if (!checklist) return;
      var hidden = container.querySelector('.state-bar-series-hidden');
      var rowsEl = container.querySelector('.state-bar-series-rows');
      var cache = {};
      try { cache = JSON.parse(hidden.value || '{}'); } catch (e) { /* malformed — start empty */ }

      function serialize() {
        var out = {};
        rowsEl.querySelectorAll('.state-bar-series-row').forEach(function (row) {
          var id = row.dataset.monitorId;
          var valueLabelsRaw = row.querySelector('.value-mapping-hidden').value;
          var entry = { valueLabelsRaw: valueLabelsRaw || null };
          cache[id] = entry;
          if (valueLabelsRaw) out[id] = entry;
        });
        hidden.value = JSON.stringify(out);
        // Defined in panel-grid.ejs, whose own <script> tags render earlier in the page than
        // this file's — same "defined-before-use" ordering LoxValueMappingBuilder/LoxThresholdBuilder
        // above already rely on, just in the opposite direction (this file consuming panel-grid.ejs's
        // global instead of the other way around).
        window.updateSharedOverrideVisibility(form, checklist, cache, { valueLabels: function (e) { return !!(e && e.valueLabelsRaw); } });
      }

      function rebuildRows() {
        var checked = Array.prototype.slice.call(checklist.querySelectorAll('input[type="checkbox"]:checked'));
        rowsEl.innerHTML = '';
        checked.forEach(function (checkbox) {
          var id = checkbox.value;
          var labelEl = checkbox.closest('label');
          var monitorLabel = labelEl ? labelEl.textContent.trim().replace(/\s*\([a-z_]+\)\s*$/i, '') : id;
          rowsEl.appendChild(buildStateBarSeriesRow(id, monitorLabel, cache[id]));
        });
        serialize();
      }

      // Same delegated-listener reasoning as panel-grid.ejs's own gauge-series builder — the
      // value/name inputs ('input'), the color swatch ('change'), and the Add/Remove buttons
      // ('click') all bubble up through here regardless of which row's nested
      // value-mapping-builder they belong to.
      ['input', 'change', 'click'].forEach(function (evtName) { rowsEl.addEventListener(evtName, serialize); });

      checklist.addEventListener('change', function (e) {
        if (e.target.matches('input[type="checkbox"]')) rebuildRows();
      });
      rebuildRows();
    });
  })();
</script>
<script>
  // Instant, no-reload filter for every Logs page's own table — same column-index-based approach
  // Monitor/Miniservers already use (see monitor.ejs's own #monitor-filter-field), generalized into
  // one shared implementation since 5 different log pages needed the identical behavior. Column
  // indices are read from data-filter-key on each table's own <th> at runtime rather than hardcoded,
  // since one of them (Logs > Loxone) conditionally adds a Miniserver column that would otherwise
  // shift every index after it.
  (function () {
    document.querySelectorAll('.log-search-combo').forEach(function (combo) {
      var fieldSelect = combo.querySelector('.log-search-field');
      var queryInput = combo.querySelector('.log-search-query');
      var clearBtn = combo.querySelector('.log-search-clear');
      var card = combo.closest('.filterable-table-card');
      var table = card && card.querySelector('.table-wrap table');
      if (!fieldSelect || !queryInput || !table) return;

      function columnIndexFor(key) {
        var ths = table.querySelectorAll('thead th');
        for (var i = 0; i < ths.length; i++) {
          if (ths[i].dataset.filterKey === key) return i;
        }
        return -1;
      }

      function applyFilter() {
        var colIndex = columnIndexFor(fieldSelect.value);
        var q = queryInput.value.trim().toLowerCase();
        if (clearBtn) clearBtn.hidden = !q;
        table.querySelectorAll('tbody tr').forEach(function (row) {
          if (!q || colIndex === -1) { row.style.display = ''; return; }
          var cell = row.children[colIndex];
          var text = cell ? cell.textContent.toLowerCase() : '';
          row.style.display = text.indexOf(q) !== -1 ? '' : 'none';
        });
      }

      fieldSelect.addEventListener('change', applyFilter);
      // Debounced same as Live Data's own search — a log table can be a few hundred rows, no reason
      // to re-scan the whole tbody on every single keystroke of a fast typist.
      var debounceTimer = null;
      queryInput.addEventListener('input', function () {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(applyFilter, 200);
      });
      if (clearBtn) {
        clearBtn.addEventListener('click', function () {
          queryInput.value = '';
          applyFilter();
          queryInput.focus();
        });
      }
    });
  })();
</script>
</body>
</html>
