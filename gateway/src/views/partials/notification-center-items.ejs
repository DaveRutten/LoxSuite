<%
  // The bell popover's own list content — its own partial (not inlined in head.ejs) since
  // routes/notificationCenter.js's own /recent endpoint re-renders exactly this on every poll (see
  // foot.ejs), so the list can catch up to a new notification without needing a full page reload.
  // Before this existed, only the unread BADGE COUNT polled live — the list itself was whatever was
  // baked into the page at its last full load, which could sit stale (missing anything that
  // arrived since) until the next navigation or an actual F5.
%>
<% if (recentNotifications.length === 0) { %>
  <p class="hint notification-center-empty" style="margin:0.6rem 0.9rem;">No notifications yet.</p>
<% } else { %>
  <% recentNotifications.forEach(n => { %>
    <div class="notification-center-item notification-center-item-<%= n.severity %>" data-notification-id="<%= n.id %>">
      <button type="button" class="icon-btn notification-center-dismiss" data-dismiss-notification="<%= n.id %>" title="Dismiss" aria-label="Dismiss">&times;</button>
      <div class="notification-center-item-title"><%= n.title %></div>
      <div class="notification-center-item-message"><%= n.message %></div>
      <div class="notification-center-item-time"><%= formatDateTime(n.created_at) %></div>
    </div>
  <% }) %>
<% } %>
