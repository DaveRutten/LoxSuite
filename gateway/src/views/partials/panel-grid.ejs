<%
  // Shared by both dashboard.ejs (the one shared/home dashboard) and dashboard-detail.ejs (a
  // personal My Dashboards board) — locals: dashboardId, panels, monitors, canEditPanels.
  // canEditPanels is computed by the caller: personal dashboards are always editable by their
  // owner (no Access Role check), the shared one is gated by canEdit('dashboard').

  // A <datalist> suggestion list is easy to miss — nothing marks the field as "has a dropdown"
  // the way a <select> does, and whether clicking (rather than typing first) reveals every
  // suggestion varies by browser. A real <select> is unambiguous: pick one of these, or the
  // explicit "Custom..." option reveals a free-text field (wired up in the script below).
  const UNIT_PRESETS = ['°C', '°F', '%', 'W', 'kW', 'kWh', 'V', 'A', 'Hz', 'hPa', 'lux', 'ppm', 'bar', 'm³', 'dB'];
  function escAttr(s) {
    return String(s).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
  }
  function unitField(fieldName, currentValue) {
    const isCustom = !!currentValue && !UNIT_PRESETS.includes(currentValue);
    let html = `<select class="unit-select" data-unit-name="${fieldName}"><option value="">(none)</option>`;
    UNIT_PRESETS.forEach((u) => {
      html += `<option value="${escAttr(u)}" ${currentValue === u ? 'selected' : ''}>${u}</option>`;
    });
    html += `<option value="__custom__" ${isCustom ? 'selected' : ''}>Custom&hellip;</option></select>`;
    html += `<input type="text" class="unit-custom-input" placeholder="Custom unit"
      value="${isCustom ? escAttr(currentValue) : ''}" style="margin-top:0.3rem; width:100%; ${isCustom ? '' : 'display:none;'}">`;
    return html;
  }

  // Grafana-style threshold ladder (see dashboards.js's parseThresholdLadder/colorForThresholdLadder)
  // — a dynamic add/remove-row builder (value + native color picker per row), not a hand-typed
  // "value=color" textarea; that hidden textarea still exists underneath and is what actually
  // submits (kept in the exact same format buildConfig() already parses), just filled in by the
  // client-side script below instead of typed directly. Collapsed by default unless there's
  // already at least one threshold configured, so an unused feature doesn't take up space.
  function thresholdField(fieldName, ladder) {
    return `<details class="threshold-builder-details" style="grid-column:1/-1;" ${ladder && ladder.length > 0 ? 'open' : ''}>
      <summary>Threshold colors (optional)</summary>
      <div class="threshold-builder" data-name="${fieldName}">
        <div class="threshold-builder-rows"></div>
        <button type="button" class="btn-soft threshold-add-row">${icon('plus')} Add threshold</button>
        <textarea name="${fieldName}" class="threshold-builder-hidden" hidden>${escAttr(serializeThresholdLadder(ladder))}</textarea>
        <p class="hint" style="margin:0.4rem 0 0;">A reading is colored using the highest threshold it meets or exceeds.</p>
      </div>
    </details>`;
  }

  // Same shape as thresholdField() above (a collapsible, dynamic add/remove-row builder over a
  // hidden textarea in the exact format dashboards.js already parses) but for an EXACT value
  // match rather than a >= ladder — each row is a value, the name to show instead of it, and an
  // optional color of its own (its own color wins over the threshold ladder for that one value,
  // since it's the more specific rule — see loadPanelsWithMonitors).
  function valueMappingField(fieldName, mappings) {
    return `<details class="threshold-builder-details" style="grid-column:1/-1;" ${mappings && mappings.length > 0 ? 'open' : ''}>
      <summary>Value names &amp; colors (optional)</summary>
      <div class="value-mapping-builder" data-name="${fieldName}">
        <div class="value-mapping-rows"></div>
        <button type="button" class="btn-soft value-mapping-add-row">${icon('plus')} Add value</button>
        <textarea name="${fieldName}" class="value-mapping-hidden" hidden>${escAttr(serializeValueMappings(mappings))}</textarea>
        <p class="hint" style="margin:0.4rem 0 0;">Shows the name instead of a matching reading's raw value — give it a color too, or leave that blank to just rename it.</p>
      </div>
    </details>`;
  }

  const RANGE_PRESETS = [
    ['1h', 'Last hour'], ['24h', 'Last 24 hours'], ['7d', 'Last 7 days'], ['30d', 'Last 30 days'], ['all', 'All'],
  ];
  const ABS_RANGE_RE = /^abs_(\d+)_(\d+)$/;
  function rangeField(currentValue) {
    const presetValues = RANGE_PRESETS.map((p) => p[0]);
    const absMatch = typeof currentValue === 'string' ? currentValue.match(ABS_RANGE_RE) : null;
    const isCustom = !!currentValue && !presetValues.includes(currentValue) && !absMatch;
    let html = '<select class="range-select" data-range-name="range">';
    RANGE_PRESETS.forEach(([value, label]) => {
      html += `<option value="${value}" ${currentValue === value ? 'selected' : ''}>${label}</option>`;
    });
    html += `<option value="__custom__" ${isCustom ? 'selected' : ''}>Custom&hellip;</option>`;
    html += `<option value="__absolute__" ${absMatch ? 'selected' : ''}>Absolute range&hellip;</option></select>`;
    html += `<input type="text" class="range-custom-input" placeholder="e.g. 3h, 10m, 45s"
      value="${isCustom ? escAttr(currentValue) : ''}" style="margin-top:0.3rem; width:100%; ${isCustom ? '' : 'display:none;'}">`;
    // Raw epoch ms (not a pre-formatted date string) — the actual datetime-local values are filled
    // in by client-side JS from these, specifically so they render in the BROWSER's own local
    // timezone. Formatting them here instead would use the server process's timezone (the Docker
    // container, always UTC — see dateFormat.js), silently showing the wrong moment to anyone not
    // in UTC themselves, the exact bug an earlier fix this session (Monitor's "Last updated") was
    // for, just for a different field.
    html += `<div class="range-absolute-wrap" data-start-ms="${absMatch ? absMatch[1] : ''}" data-end-ms="${absMatch ? absMatch[2] : ''}"
      style="margin-top:0.3rem; display:flex; flex-direction:column; gap:0.3rem; ${absMatch ? '' : 'display:none;'}">
      <div><label style="font-size:0.7rem; margin-bottom:0.15rem;">From</label><input type="datetime-local" class="range-absolute-start"></div>
      <div><label style="font-size:0.7rem; margin-bottom:0.15rem;">To</label><input type="datetime-local" class="range-absolute-end"></div>
      <input type="hidden" class="range-absolute-hidden">
    </div>`;
    return html;
  }
%>
<% if (canEditPanels) { %>
<div id="panel-edit-backdrop" class="panel-edit-backdrop"></div>
<details class="add-panel">
  <summary>Add panel</summary>
  <div class="add-panel-body">
    <form method="post" action="/dashboards/<%= dashboardId %>/panels">
      <div class="form-grid">
        <div>
          <label>Panel type</label>
          <select name="panel_type" id="panel-type-select">
            <option value="chart">Chart</option>
            <option value="table">Table</option>
            <option value="value">Current value</option>
            <option value="gauge">Gauge</option>
            <option value="stat_delta">Stat with change</option>
            <option value="threshold">Threshold indicator</option>
          </select>
        </div>
        <div><label>Title (optional)</label><input type="text" name="title" placeholder="Leave blank to auto-generate one"></div>
        <div id="panel-range-field">
          <label>Range</label>
          <%- rangeField('24h') %>
        </div>
      </div>

      <div class="form-grid" id="chart-fields" style="margin-top:0.85rem; display:none;">
        <div>
          <label>Legend</label>
          <select name="legend_position">
            <option value="auto" selected>Auto (only when &gt;1 monitor)</option>
            <option value="top">Top</option>
            <option value="bottom">Bottom</option>
            <option value="left">Left</option>
            <option value="right">Right</option>
            <option value="off">Off</option>
          </select>
        </div>
        <div><label>Y-axis unit (optional)</label><%- unitField('unit_chart', '') %></div>
        <div><label>Decimals</label><input type="number" name="decimals" value="2" min="0" max="6" step="1"></div>
        <%- thresholdField('chart_thresholds', []) %>
      </div>

      <div class="form-grid" id="value-layout-field" style="margin-top:0.85rem; display:none;">
        <div>
          <label>Layout</label>
          <select name="value_layout">
            <option value="stacked">Stacked (one per line)</option>
            <option value="row">Row (side by side)</option>
          </select>
        </div>
        <div><label>Unit (optional)</label><%- unitField('unit_value', '') %></div>
        <div>
          <label>Decimals</label>
          <input type="number" name="decimals_value" placeholder="Default (<%= defaultPanelDecimals %>)" min="0" max="6" step="1">
        </div>
        <%- valueMappingField('value_labels', []) %>
        <%- thresholdField('value_thresholds', []) %>
        <div style="grid-column:1/-1;">
          <label>Rename in this panel (optional)</label>
          <textarea name="monitor_names" rows="2" placeholder="Badkamer / tempActual=Bathroom temperature" style="width:100%; font-family:monospace; font-size:0.82rem;"></textarea>
          <p class="hint" style="margin:0.3rem 0 0;">One per line, <code>&lt;monitor's current label&gt;=&lt;name to show here&gt;</code> — only changes how it's displayed in this panel, not the Monitor's own name.</p>
        </div>
      </div>

      <div class="form-grid" id="table-fields" style="margin-top:0.85rem; display:none;">
        <%- thresholdField('table_thresholds', []) %>
      </div>

      <div class="form-grid" id="gauge-fields" style="margin-top:0.85rem; display:none;">
        <div><label>Minimum</label><input type="number" name="gauge_min" value="0" step="any"></div>
        <div><label>Maximum</label><input type="number" name="gauge_max" value="100" step="any"></div>
        <div><label>Unit (optional)</label><%- unitField('unit_gauge', '') %></div>
        <%- thresholdField('gauge_thresholds', []) %>
      </div>

      <div class="form-grid" id="stat-delta-fields" style="margin-top:0.85rem; display:none;">
        <div><label>Unit (optional)</label><%- unitField('unit_stat_delta', '') %></div>
        <div>
          <label>Color the change when</label>
          <select name="direction">
            <option value="neutral">Neutral (no color)</option>
            <option value="up_good">Higher is better</option>
            <option value="down_good">Lower is better</option>
          </select>
        </div>
        <%- thresholdField('stat_delta_thresholds', []) %>
      </div>

      <div class="form-grid" id="threshold-fields" style="margin-top:0.85rem; display:none;">
        <div>
          <label>Alert when value is</label>
          <select name="threshold_operator">
            <option value="gt">Above</option>
            <option value="gte">Above or equal to</option>
            <option value="lt">Below</option>
            <option value="lte">Below or equal to</option>
          </select>
        </div>
        <div><label>Threshold</label><input type="number" name="threshold_value" value="0" step="any"></div>
        <div><label>Unit (optional)</label><%- unitField('unit_threshold', '') %></div>
        <div><label>Label when normal</label><input type="text" name="label_ok" placeholder="Normal"></div>
        <div><label>Label when alert</label><input type="text" name="label_alert" placeholder="Alert"></div>
      </div>

      <p class="hint" style="margin-top:0.6rem;">New panels start at a default size &mdash; drag a panel's bottom-right corner afterwards to resize it.</p>

      <div style="margin-top:0.85rem;">
        <label style="display:block; font-size:0.78rem; font-weight:500; margin-bottom:0.3rem; color:var(--text-muted);">
          Monitors
        </label>
        <p class="hint" id="table-monitor-hint" style="display:none; margin:0 0 0.5rem;">
          This panel type shows one monitor &mdash; if you check more than one, only the first is used.
        </p>
        <input type="text" id="monitor-filter" placeholder="Filter monitors&hellip;" style="max-width:20rem; margin-bottom:0.6rem; padding:0.5rem 0.6rem; border:1px solid var(--border); border-radius:7px; background:var(--surface); color:var(--text);">
        <div id="monitor-checklist" style="display:flex; flex-direction:column; gap:0.35rem; max-height:220px; overflow-y:auto; padding:0.6rem; border:1px solid var(--border); border-radius:8px;">
          <% monitors.forEach(m => { %>
            <label class="monitor-check-row" data-label="<%= m.label.toLowerCase() %>" style="display:flex; align-items:center; gap:0.5rem; font-size:0.87rem;">
              <input type="checkbox" name="monitor_ids" value="<%= m.id %>">
              <%= m.label %> <span class="hint" style="margin:0;">(<%= m.source_type %>)</span>
            </label>
          <% }) %>
          <% if (monitors.length === 0) { %>
            <p class="hint" style="margin:0;">No monitors yet &mdash; add one on the <a href="/monitor">Monitor</a> page first.</p>
          <% } %>
        </div>
      </div>

      <div id="chart-series-settings" class="chart-series-settings" data-checklist-selector="#monitor-checklist" style="margin-top:0.85rem; display:none;">
        <label style="display:block; font-size:0.78rem; font-weight:500; margin-bottom:0.3rem; color:var(--text-muted);">
          Series settings (optional)
        </label>
        <div class="chart-series-rows"></div>
        <textarea class="chart-series-hidden" name="chart_series" hidden>{}</textarea>
        <p class="hint" style="margin:0.4rem 0 0;">Appears once you've checked a monitor above — rename a series, give it its own unit, or move it to the right-hand axis.</p>
      </div>

      <div style="margin-top:0.9rem;">
        <button type="submit" class="primary"><%- icon('plus') %> Add panel</button>
      </div>
    </form>
  </div>
</details>
<% } %>

<div class="dash-grid" id="dash-grid">
  <% panels.forEach(p => { %>
    <div class="dash-panel" data-id="<%= p.id %>" data-col-span="<%= p.col_span %>" data-row-span="<%= p.row_span %>" draggable="<%= canEditPanels ? 'true' : 'false' %>" style="grid-column: span <%= p.col_span %>; grid-row: span <%= p.row_span %>;">
      <% if (canEditPanels) { %><span class="widget-drag-handle" title="Drag to reorder">&#8942;&#8942;</span><% } %>
      <div class="dash-panel-head">
        <div class="dash-panel-title"><%= p.title || (p.panel_type.charAt(0).toUpperCase() + p.panel_type.slice(1)) %></div>
        <% if (canEditPanels) { %>
        <div class="row-actions">
          <button type="button" class="icon-btn icon-btn-edit" title="Edit panel" data-toggle-row="panel-edit-<%= p.id %>"><%- icon('edit') %></button>
          <form method="post" action="/dashboards/<%= dashboardId %>/panels/<%= p.id %>/duplicate">
            <button type="submit" class="icon-btn icon-btn-add" title="Duplicate panel"><%- icon('copy') %></button>
          </form>
          <form method="post" action="/dashboards/<%= dashboardId %>/panels/<%= p.id %>/delete" data-confirm="Remove this panel?">
            <button type="submit" class="icon-btn icon-btn-danger" title="Delete panel"><%- icon('trash') %></button>
          </form>
        </div>
        <% } %>
      </div>

      <% if (canEditPanels) { %>
      <form id="panel-edit-<%= p.id %>" method="post" action="/dashboards/<%= dashboardId %>/panels/<%= p.id %>/settings" class="form-grid panel-settings-form">
        <div class="panel-settings-form-head" style="grid-column:1/-1; display:flex; align-items:center; justify-content:space-between; margin-bottom:0.3rem;">
          <strong>Edit panel</strong>
          <button type="button" class="icon-btn" data-toggle-row="panel-edit-<%= p.id %>" title="Close" aria-label="Close">&times;</button>
        </div>
        <div>
          <label>Panel type</label>
          <select name="panel_type" class="panel-type-select">
            <option value="chart" <%= p.panel_type === 'chart' ? 'selected' : '' %>>Chart</option>
            <option value="table" <%= p.panel_type === 'table' ? 'selected' : '' %>>Table</option>
            <option value="value" <%= p.panel_type === 'value' ? 'selected' : '' %>>Current value</option>
            <option value="gauge" <%= p.panel_type === 'gauge' ? 'selected' : '' %>>Gauge</option>
            <option value="stat_delta" <%= p.panel_type === 'stat_delta' ? 'selected' : '' %>>Stat with change</option>
            <option value="threshold" <%= p.panel_type === 'threshold' ? 'selected' : '' %>>Threshold indicator</option>
          </select>
        </div>
        <div><label>Title</label><input type="text" name="title" value="<%= p.title || '' %>" placeholder="Title"></div>
        <div data-fields-for="chart,table,stat_delta">
          <label>Range</label>
          <%- rangeField(p.range) %>
        </div>
        <div data-fields-for="chart">
          <label>Legend</label>
          <select name="legend_position">
            <% var legendPos = p.panel_type === 'chart' ? (p.config.legendPosition || 'auto') : 'auto'; %>
            <option value="auto" <%= legendPos === 'auto' ? 'selected' : '' %>>Auto (only when &gt;1 monitor)</option>
            <option value="top" <%= legendPos === 'top' ? 'selected' : '' %>>Top</option>
            <option value="left" <%= legendPos === 'left' ? 'selected' : '' %>>Left</option>
            <option value="right" <%= legendPos === 'right' ? 'selected' : '' %>>Right</option>
            <option value="off" <%= legendPos === 'off' ? 'selected' : '' %>>Off</option>
          </select>
        </div>
        <div data-fields-for="chart"><label>Y-axis unit</label><%- unitField('unit_chart', p.panel_type === 'chart' ? (p.config.unit || '') : '') %></div>
        <div data-fields-for="chart"><label>Decimals</label><input type="number" name="decimals" value="<%= p.panel_type === 'chart' && p.config.decimals != null ? p.config.decimals : 2 %>" min="0" max="6" step="1"></div>
        <div data-fields-for="chart" style="grid-column:1/-1;">
          <%- thresholdField('chart_thresholds', p.panel_type === 'chart' ? p.config.thresholds : []) %>
        </div>
        <div data-fields-for="value">
          <label>Layout</label>
          <select name="value_layout">
            <option value="stacked" <%= !(p.panel_type === 'value' && p.config.layout === 'row') ? 'selected' : '' %>>Stacked (one per line)</option>
            <option value="row" <%= p.panel_type === 'value' && p.config.layout === 'row' ? 'selected' : '' %>>Row (side by side)</option>
          </select>
        </div>
        <div data-fields-for="value"><label>Unit</label><%- unitField('unit_value', p.panel_type === 'value' ? (p.config.unit || '') : '') %></div>
        <div data-fields-for="value">
          <label>Decimals</label>
          <input type="number" name="decimals_value" value="<%= p.panel_type === 'value' && p.config.decimals != null ? p.config.decimals : '' %>" placeholder="Default (<%= defaultPanelDecimals %>)" min="0" max="6" step="1">
        </div>
        <div data-fields-for="value" style="grid-column:1/-1;">
          <%- valueMappingField('value_labels', p.panel_type === 'value' ? p.config.valueLabels : []) %>
        </div>
        <div data-fields-for="value" style="grid-column:1/-1;">
          <%- thresholdField('value_thresholds', p.panel_type === 'value' ? p.config.thresholds : []) %>
        </div>
        <div data-fields-for="value" style="grid-column:1/-1;">
          <label>Rename in this panel</label>
          <textarea name="monitor_names" rows="2" placeholder="Badkamer / tempActual=Bathroom temperature" style="width:100%; font-family:monospace; font-size:0.82rem;"><%= p.panel_type === 'value' ? serializeKeyValueLines(p.config.monitorNames) : '' %></textarea>
          <p class="hint" style="margin:0.3rem 0 0;">One per line, <code>&lt;monitor's current label&gt;=&lt;name to show here&gt;</code> — display only, doesn't rename the Monitor itself.</p>
        </div>
        <div data-fields-for="table" style="grid-column:1/-1;">
          <%- thresholdField('table_thresholds', p.panel_type === 'table' ? p.config.thresholds : []) %>
        </div>
        <div data-fields-for="gauge"><label>Minimum</label><input type="number" name="gauge_min" value="<%= p.panel_type === 'gauge' ? p.config.min : 0 %>" step="any"></div>
        <div data-fields-for="gauge"><label>Maximum</label><input type="number" name="gauge_max" value="<%= p.panel_type === 'gauge' ? p.config.max : 100 %>" step="any"></div>
        <div data-fields-for="gauge"><label>Unit</label><%- unitField('unit_gauge', p.panel_type === 'gauge' ? (p.config.unit || '') : '') %></div>
        <div data-fields-for="gauge" style="grid-column:1/-1;">
          <%- thresholdField('gauge_thresholds', p.panel_type === 'gauge' ? p.config.thresholds : []) %>
        </div>
        <div data-fields-for="stat_delta"><label>Unit</label><%- unitField('unit_stat_delta', p.panel_type === 'stat_delta' ? (p.config.unit || '') : '') %></div>
        <div data-fields-for="stat_delta">
          <label>Color the change when</label>
          <select name="direction">
            <option value="neutral" <%= !(p.panel_type === 'stat_delta' && p.config.direction !== 'neutral') ? 'selected' : '' %>>Neutral (no color)</option>
            <option value="up_good" <%= p.panel_type === 'stat_delta' && p.config.direction === 'up_good' ? 'selected' : '' %>>Higher is better</option>
            <option value="down_good" <%= p.panel_type === 'stat_delta' && p.config.direction === 'down_good' ? 'selected' : '' %>>Lower is better</option>
          </select>
        </div>
        <div data-fields-for="stat_delta" style="grid-column:1/-1;">
          <%- thresholdField('stat_delta_thresholds', p.panel_type === 'stat_delta' ? p.config.thresholds : []) %>
        </div>
        <div data-fields-for="threshold">
          <label>Alert when value is</label>
          <select name="threshold_operator">
            <option value="gt" <%= !(p.panel_type === 'threshold') || p.config.operator === 'gt' ? 'selected' : '' %>>Above</option>
            <option value="gte" <%= p.panel_type === 'threshold' && p.config.operator === 'gte' ? 'selected' : '' %>>Above or equal to</option>
            <option value="lt" <%= p.panel_type === 'threshold' && p.config.operator === 'lt' ? 'selected' : '' %>>Below</option>
            <option value="lte" <%= p.panel_type === 'threshold' && p.config.operator === 'lte' ? 'selected' : '' %>>Below or equal to</option>
          </select>
        </div>
        <div data-fields-for="threshold"><label>Threshold</label><input type="number" name="threshold_value" value="<%= p.panel_type === 'threshold' ? p.config.value : 0 %>" step="any"></div>
        <div data-fields-for="threshold"><label>Unit</label><%- unitField('unit_threshold', p.panel_type === 'threshold' ? (p.config.unit || '') : '') %></div>
        <div data-fields-for="threshold"><label>Label when normal</label><input type="text" name="label_ok" value="<%= p.panel_type === 'threshold' ? p.config.labelOk : 'Normal' %>"></div>
        <div data-fields-for="threshold"><label>Label when alert</label><input type="text" name="label_alert" value="<%= p.panel_type === 'threshold' ? p.config.labelAlert : 'Alert' %>"></div>
        <div>
          <label style="display:block; font-size:0.72rem; margin-bottom:0.1rem; color:var(--text-muted);">Monitors</label>
          <p class="hint panel-single-monitor-hint" data-fields-for="table,gauge,stat_delta,threshold" style="display:none; margin:0 0 0.25rem; font-size:0.7rem;">
            This panel type only uses the first checked monitor.
          </p>
          <input type="text" class="panel-monitor-filter" placeholder="Filter monitors&hellip;" style="margin-bottom:0.25rem; width:100%;">
          <div class="panel-monitor-checklist" style="display:flex; flex-direction:column; max-height:100px; overflow-y:auto; overflow-x:hidden; padding:0.2rem; border:1px solid var(--border); border-radius:6px;">
            <% monitors.forEach(m => { %>
              <label class="panel-monitor-check-row" data-label="<%= m.label.toLowerCase() %>" style="display:flex; align-items:center; gap:0.3rem; font-size:0.75rem; min-width:0; padding:0.05rem 0;">
                <input type="checkbox" name="monitor_ids" value="<%= m.id %>" style="flex-shrink:0;" <%= p.monitors.some(pm => pm.id === m.id) ? 'checked' : '' %>>
                <span style="flex:1; min-width:0; overflow-wrap:anywhere; line-height:1.2;"><%= m.label %></span>
              </label>
            <% }) %>
            <% if (monitors.length === 0) { %>
              <p class="hint" style="margin:0;">No monitors yet.</p>
            <% } %>
          </div>
        </div>
        <div data-fields-for="chart" class="chart-series-settings" data-checklist-selector=".panel-monitor-checklist" style="grid-column:1/-1;">
          <label style="display:block; font-size:0.72rem; margin-bottom:0.1rem; color:var(--text-muted);">Series settings</label>
          <div class="chart-series-rows"></div>
          <textarea class="chart-series-hidden" name="chart_series" hidden><%= p.panel_type === 'chart' ? JSON.stringify(p.config.series || {}) : '{}' %></textarea>
          <p class="hint" style="margin:0.3rem 0 0;">Rename a series, give it its own unit, or move it to the right-hand axis.</p>
        </div>
        <%
          // No Save button — every field change auto-saves (see the script near the bottom of
          // this file), so a button implying "nothing's saved until you click this" would just
          // contradict what's actually happening. This status text is the only save affordance.
        %>
        <span class="hint panel-save-status" style="grid-column:1/-1; margin:0;">Saved</span>
      </form>
      <span class="panel-drawer-resize-handle" title="Drag to resize"></span>
      <% } %>

      <% if (p.monitors.length === 0) { %>
        <p class="hint">No monitors left in this panel &mdash; they may have been deleted from the Monitor page. Remove this panel or add a new one.</p>
      <% } else if (p.panel_type === 'chart') { %>
        <div class="chart-wrap">
          <canvas data-monitor-ids="<%= p.monitors.map(m => m.id).join(',') %>" data-range="<%= p.range %>" data-legend="<%= p.config.legendPosition || 'auto' %>" data-unit="<%= p.config.unit || '' %>" data-decimals="<%= p.config.decimals != null ? p.config.decimals : 2 %>" data-thresholds="<%= JSON.stringify(p.config.thresholds || []) %>" data-series="<%= JSON.stringify(p.config.series || {}) %>"></canvas>
        </div>
      <% } else if (p.panel_type === 'table') { %>
        <div class="panel-table-scroll">
          <table class="panel-table">
            <thead><tr><th>Timestamp</th><th>Value</th></tr></thead>
            <tbody>
              <% p.rows.forEach(r => { %>
                <tr><td><%= formatDateTime(r.recordedAt) %></td><td><span class="truncate" title="<%= r.value %>" <% if (r.thresholdColor) { %>style="color: <%= r.thresholdColor %>; font-weight: 600;"<% } %>><%= r.value %></span></td></tr>
              <% }) %>
              <% if (p.rows.length === 0) { %>
                <tr><td colspan="2" class="empty">No readings in this range yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      <% } else if (p.panel_type === 'gauge') { %>
        <div class="gauge-wrap" data-live-id="panel-<%= p.id %>-body">
          <div class="gauge-track"><div class="gauge-fill" style="width: <%= p.percent === null ? 0 : p.percent %>%; <% if (p.thresholdColor) { %>background: <%= p.thresholdColor %>;<% } %>"></div></div>
          <div class="gauge-value" <% if (p.thresholdColor) { %>style="color: <%= p.thresholdColor %>;"<% } %>><%= p.current ? p.current.value : '-' %><%= p.config.unit ? ' ' + p.config.unit : '' %></div>
          <div class="hint" style="margin:0;"><%= p.config.min %>&ndash;<%= p.config.max %><%= p.config.unit ? ' ' + p.config.unit : '' %></div>
        </div>
      <% } else if (p.panel_type === 'stat_delta') { %>
        <% const RANGE_LABELS = { '1h': '1 hour', '24h': '24 hours', '7d': '7 days', '30d': '30 days', all: 'the start' };
           let deltaClass = 'neutral';
           if (p.delta !== null && p.delta !== 0 && p.config.direction !== 'neutral') {
             const isUp = p.delta > 0;
             const good = (p.config.direction === 'up_good' && isUp) || (p.config.direction === 'down_good' && !isUp);
             deltaClass = good ? 'good' : 'bad';
           }
        %>
        <div class="stat-delta" data-live-id="panel-<%= p.id %>-body">
          <div class="stat-delta-value" <% if (p.thresholdColor) { %>style="color: <%= p.thresholdColor %>;"<% } %>><%= p.current ? p.current.value : '-' %><%= p.config.unit ? ' ' + p.config.unit : '' %></div>
          <% if (p.delta === null) { %>
            <p class="hint" style="margin:0;">No comparison reading yet.</p>
          <% } else { %>
            <div class="stat-delta-change <%= deltaClass %>">
              <%- p.delta > 0 ? '&#9650;' : (p.delta < 0 ? '&#9660;' : '&#8212;') %> <%= Math.abs(p.delta).toFixed(2) %><%= p.config.unit ? ' ' + p.config.unit : '' %>
            </div>
            <p class="hint" style="margin:0;">vs <%= RANGE_LABELS[p.range] || p.range %> ago</p>
          <% } %>
        </div>
      <% } else if (p.panel_type === 'threshold') { %>
        <div class="threshold-wrap" data-live-id="panel-<%= p.id %>-body">
          <div class="gauge-value"><%= p.current ? p.current.value : '-' %><%= p.config.unit ? ' ' + p.config.unit : '' %></div>
          <span class="badge <%= p.isAlert ? 'badge-off' : 'badge-ok' %>"><%= p.isAlert ? p.config.labelAlert : p.config.labelOk %></span>
        </div>
      <% } else { %>
        <div class="panel-value-list" data-layout="<%= p.config.layout === 'row' ? 'row' : 'stacked' %>" data-live-id="panel-<%= p.id %>-body">
          <% p.monitors.forEach(m => { %>
            <div class="panel-value-row">
              <div class="label">
                <%= m.displayLabel %>
                <% if (m.miniserver_name) { %><span class="hint" style="margin:0;">(<%= m.miniserver_name %>)</span><% } %>
              </div>
              <div class="value" <% if (m.current && m.current.thresholdColor) { %>style="color: <%= m.current.thresholdColor %>;"<% } %>>
                <%= m.current ? m.current.displayValue : '-' %><% if (m.current && !m.current.isLabel && p.config.unit) { %> <%= p.config.unit %><% } %>
                <span class="hint" style="margin:0; display:block; font-size:0.72rem;">
                  <%= m.current ? formatDateTime(m.current.recordedAt) : '' %>
                </span>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (canEditPanels) { %><span class="dash-panel-resize-handle" title="Drag to resize"></span><% } %>
    </div>
  <% }) %>
  <% if (panels.length === 0) { %>
    <p class="hint">No panels yet<% if (canEditPanels) { %> &mdash; add one above<% } %>.</p>
  <% } %>
</div>

<script>
  (function () {
    var panelTypeSelect = document.getElementById('panel-type-select');
    if (!panelTypeSelect) return; // add-panel form isn't rendered for view-only users

    var rangeField = document.getElementById('panel-range-field');
    var tableHint = document.getElementById('table-monitor-hint');
    var chartFields = document.getElementById('chart-fields');
    var valueLayoutField = document.getElementById('value-layout-field');
    var tableFields = document.getElementById('table-fields');
    var gaugeFields = document.getElementById('gauge-fields');
    var statDeltaFields = document.getElementById('stat-delta-fields');
    var thresholdFields = document.getElementById('threshold-fields');
    var chartSeriesSettings = document.getElementById('chart-series-settings');
    var SINGLE_MONITOR_TYPES = ['table', 'gauge', 'stat_delta', 'threshold'];
    var NO_RANGE_TYPES = ['value', 'gauge', 'threshold'];

    function syncPanelType() {
      var type = panelTypeSelect.value;
      rangeField.style.display = NO_RANGE_TYPES.indexOf(type) !== -1 ? 'none' : '';
      tableHint.style.display = SINGLE_MONITOR_TYPES.indexOf(type) !== -1 ? '' : 'none';
      chartFields.style.display = type === 'chart' ? '' : 'none';
      valueLayoutField.style.display = type === 'value' ? '' : 'none';
      tableFields.style.display = type === 'table' ? '' : 'none';
      gaugeFields.style.display = type === 'gauge' ? '' : 'none';
      statDeltaFields.style.display = type === 'stat_delta' ? '' : 'none';
      thresholdFields.style.display = type === 'threshold' ? '' : 'none';
      chartSeriesSettings.style.display = type === 'chart' ? '' : 'none';
    }
    panelTypeSelect.addEventListener('change', syncPanelType);
    syncPanelType();

    var filterInput = document.getElementById('monitor-filter');
    filterInput.addEventListener('input', function () {
      var q = filterInput.value.toLowerCase();
      document.querySelectorAll('.monitor-check-row').forEach(function (row) {
        row.style.display = row.dataset.label.indexOf(q) !== -1 ? '' : 'none';
      });
    });
  })();
</script>

<script>
  // Per-panel "Edit panel" popovers (see .panel-settings-form above) — one of these exists per
  // panel on the page, so unlike the single Add-panel form above, fields are toggled by walking
  // up to the closest form rather than by a page-wide element id.
  (function () {
    document.querySelectorAll('.panel-settings-form .panel-type-select').forEach(function (select) {
      var form = select.closest('form');

      function sync() {
        var type = select.value;
        form.querySelectorAll('[data-fields-for]').forEach(function (el) {
          var types = el.getAttribute('data-fields-for').split(',');
          el.style.display = types.indexOf(type) !== -1 ? '' : 'none';
        });
      }
      select.addEventListener('change', sync);
      sync();
    });

    document.querySelectorAll('.panel-monitor-filter').forEach(function (filterInput) {
      var form = filterInput.closest('form');
      filterInput.addEventListener('input', function () {
        var q = filterInput.value.toLowerCase();
        form.querySelectorAll('.panel-monitor-check-row').forEach(function (row) {
          row.style.display = row.dataset.label.indexOf(q) !== -1 ? '' : 'none';
        });
      });
    });
  })();
</script>

<script>
  // Every unit field (Chart/Gauge/Stat/Threshold, in both the Add-panel form and each panel's own
  // Edit form) is a <select class="unit-select"> of common presets plus "Custom...", paired with
  // a hidden text input that appears when "Custom..." is picked. Only one of the two ever carries
  // the real field name at a time, so exactly one value — never both, never neither — submits.
  (function () {
    document.querySelectorAll('.unit-select').forEach(function (select) {
      var input = select.nextElementSibling;
      var name = select.dataset.unitName;

      function sync() {
        if (select.value === '__custom__') {
          select.removeAttribute('name');
          input.name = name;
          input.style.display = '';
        } else {
          select.name = name;
          input.removeAttribute('name');
          input.style.display = 'none';
        }
      }
      select.addEventListener('change', function () {
        sync();
        if (select.value === '__custom__') input.focus();
      });
      sync();
    });
  })();
</script>

<script>
  // Same "select of presets + hidden custom text input" pattern as .unit-select above, for the
  // panel Range field — a duration like "3h" stands in for a preset, and (a third state) a fixed
  // From/To pair stands in for both — only ONE of the select/custom-input/absolute-hidden-input
  // ever has a `name` at a time, so the field submits exactly one "range" value regardless of
  // which mode is active.
  (function () {
    document.querySelectorAll('.range-select').forEach(function (select) {
      var customInput = select.nextElementSibling;
      var absWrap = customInput.nextElementSibling;
      var startInput = absWrap.querySelector('.range-absolute-start');
      var endInput = absWrap.querySelector('.range-absolute-end');
      var hiddenInput = absWrap.querySelector('.range-absolute-hidden');
      var name = select.dataset.rangeName;

      function pad(n) { return String(n).padStart(2, '0'); }
      function toLocalInputValue(ms) {
        var d = new Date(ms);
        return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
      }
      // Pre-fills once from the server-supplied raw epoch ms (see rangeField() in this same file)
      // — done here in the browser specifically so these show in ITS local timezone, not whatever
      // timezone the Node process happens to be running in.
      if (absWrap.dataset.startMs) startInput.value = toLocalInputValue(Number(absWrap.dataset.startMs));
      if (absWrap.dataset.endMs) endInput.value = toLocalInputValue(Number(absWrap.dataset.endMs));

      function updateHidden() {
        if (!startInput.value || !endInput.value) return;
        hiddenInput.value = 'abs_' + new Date(startInput.value).getTime() + '_' + new Date(endInput.value).getTime();
      }
      updateHidden();

      function sync() {
        var mode = select.value;
        select.removeAttribute('name');
        customInput.removeAttribute('name');
        hiddenInput.removeAttribute('name');
        customInput.style.display = 'none';
        absWrap.style.display = 'none';
        if (mode === '__custom__') {
          customInput.name = name;
          customInput.style.display = '';
        } else if (mode === '__absolute__') {
          hiddenInput.name = name;
          absWrap.style.display = 'flex';
          updateHidden();
        } else {
          select.name = name;
        }
      }
      select.addEventListener('change', function () {
        sync();
        if (select.value === '__custom__') customInput.focus();
      });
      startInput.addEventListener('change', updateHidden);
      endInput.addEventListener('change', updateHidden);
      sync();
    });
  })();
</script>

<script>
  // Drives every .threshold-builder (see thresholdField() above) — a dynamic add/remove-row UI
  // (value + native color picker per row) that keeps a hidden textarea in sync in the exact
  // "<value>=<color>" format the server already parses (dashboards.js's parseThresholdLadder), so
  // nothing on the server side needed to change for this to stop being a hand-typed textarea.
  (function () {
    // A native <input type="color"> only accepts a strict 7-char hex value — an existing config
    // saved as a CSS name (e.g. "orange", from before this builder existed, or hand-edited) has to
    // be resolved to its hex equivalent before it can be shown as that row's starting color.
    function toHexColor(color) {
      var probe = document.createElement('div');
      probe.style.color = color;
      document.body.appendChild(probe);
      var computed = getComputedStyle(probe).color;
      document.body.removeChild(probe);
      var m = computed.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
      if (!m) return '#e34948';
      function hex(n) { return Number(n).toString(16).padStart(2, '0'); }
      return '#' + hex(m[1]) + hex(m[2]) + hex(m[3]);
    }

    function serializeRows(builder) {
      var lines = [];
      builder.querySelectorAll('.threshold-builder-row').forEach(function (row) {
        var value = row.querySelector('.threshold-row-value').value.trim();
        var color = row.querySelector('.threshold-row-color').value;
        if (value !== '' && color) lines.push(value + '=' + color);
      });
      builder.querySelector('.threshold-builder-hidden').value = lines.join('\n');
    }

    function addRow(builder, value, color) {
      var row = document.createElement('div');
      row.className = 'threshold-builder-row';
      row.innerHTML =
        '<input type="number" class="threshold-row-value" placeholder="Value" step="any">' +
        '<input type="color" class="threshold-row-color">' +
        '<button type="button" class="icon-btn icon-btn-danger threshold-row-remove" title="Remove" aria-label="Remove">&times;</button>';
      row.querySelector('.threshold-row-value').value = value == null ? '' : value;
      row.querySelector('.threshold-row-color').value = toHexColor(color || '#e34948');
      builder.querySelector('.threshold-builder-rows').appendChild(row);

      row.querySelector('.threshold-row-value').addEventListener('input', function () { serializeRows(builder); });
      row.querySelector('.threshold-row-color').addEventListener('input', function () { serializeRows(builder); });
      row.querySelector('.threshold-row-remove').addEventListener('click', function () {
        row.remove();
        serializeRows(builder);
      });
    }

    document.querySelectorAll('.threshold-builder').forEach(function (builder) {
      var hidden = builder.querySelector('.threshold-builder-hidden');
      hidden.value.split('\n').map(function (l) { return l.trim(); }).filter(Boolean).forEach(function (line) {
        var idx = line.indexOf('=');
        if (idx === -1) return;
        addRow(builder, line.slice(0, idx), line.slice(idx + 1));
      });
      builder.querySelector('.threshold-add-row').addEventListener('click', function () {
        addRow(builder, '', '#e34948');
        serializeRows(builder);
      });
    });
  })();
</script>

<script>
  // Drives every .value-mapping-builder (see valueMappingField() above) — same idea as the
  // threshold builder just above, a dynamic add/remove-row UI over a hidden textarea, kept in the
  // "<value>=<label>[=<color>]" format dashboards.js's parseValueMappings already handles. The
  // color segment is optional per row (a value can just be renamed, with no color of its own).
  (function () {
    function toHexColor(color) {
      var probe = document.createElement('div');
      probe.style.color = color;
      document.body.appendChild(probe);
      var computed = getComputedStyle(probe).color;
      document.body.removeChild(probe);
      var m = computed.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
      if (!m) return '#e34948';
      function hex(n) { return Number(n).toString(16).padStart(2, '0'); }
      return '#' + hex(m[1]) + hex(m[2]) + hex(m[3]);
    }

    function serializeRows(builder) {
      var lines = [];
      builder.querySelectorAll('.value-mapping-row').forEach(function (row) {
        var value = row.querySelector('.value-mapping-row-value').value.trim();
        var name = row.querySelector('.value-mapping-row-name').value.trim();
        var hasColor = row.querySelector('.value-mapping-row-color-enabled').checked;
        var color = hasColor ? row.querySelector('.value-mapping-row-color').value : '';
        if (value !== '' && name !== '') lines.push(value + '=' + name + (color ? '=' + color : ''));
      });
      builder.querySelector('.value-mapping-hidden').value = lines.join('\n');
    }

    function addRow(builder, value, name, color) {
      var row = document.createElement('div');
      row.className = 'value-mapping-row';
      row.innerHTML =
        '<input type="text" class="value-mapping-row-value" placeholder="Value">' +
        '<input type="text" class="value-mapping-row-name" placeholder="Name to show">' +
        '<input type="checkbox" class="value-mapping-row-color-enabled" title="Give this value its own color">' +
        '<input type="color" class="value-mapping-row-color">' +
        '<button type="button" class="icon-btn icon-btn-danger value-mapping-row-remove" title="Remove" aria-label="Remove">&times;</button>';
      row.querySelector('.value-mapping-row-value').value = value == null ? '' : value;
      row.querySelector('.value-mapping-row-name').value = name == null ? '' : name;
      var colorEnabled = !!color;
      row.querySelector('.value-mapping-row-color-enabled').checked = colorEnabled;
      row.querySelector('.value-mapping-row-color').value = toHexColor(color || '#e34948');
      row.querySelector('.value-mapping-row-color').style.visibility = colorEnabled ? '' : 'hidden';
      builder.querySelector('.value-mapping-rows').appendChild(row);

      row.querySelector('.value-mapping-row-value').addEventListener('input', function () { serializeRows(builder); });
      row.querySelector('.value-mapping-row-name').addEventListener('input', function () { serializeRows(builder); });
      row.querySelector('.value-mapping-row-color').addEventListener('input', function () { serializeRows(builder); });
      row.querySelector('.value-mapping-row-color-enabled').addEventListener('change', function (e) {
        row.querySelector('.value-mapping-row-color').style.visibility = e.target.checked ? '' : 'hidden';
        serializeRows(builder);
      });
      row.querySelector('.value-mapping-row-remove').addEventListener('click', function () {
        row.remove();
        serializeRows(builder);
      });
    }

    document.querySelectorAll('.value-mapping-builder').forEach(function (builder) {
      var hidden = builder.querySelector('.value-mapping-hidden');
      hidden.value.split('\n').map(function (l) { return l.trim(); }).filter(Boolean).forEach(function (line) {
        var parts = line.split('=');
        if (parts.length < 2) return;
        var color = parts.length > 2 ? parts.slice(2).join('=').trim() : '';
        addRow(builder, parts[0], parts[1], color);
      });
      builder.querySelector('.value-mapping-add-row').addEventListener('click', function () {
        addRow(builder, '', '', '');
        serializeRows(builder);
      });
    });
  })();
</script>

<script>
  // Drives every .chart-series-settings (Add-panel's and each panel's own Edit form both have
  // one) — builds one row per currently-checked monitor in that SAME form's monitor checklist
  // (found via the container's own data-checklist-selector, since the two forms use different
  // checklist markup), keeping a hidden JSON textarea (dashboards.js's parseSeriesConfig format)
  // in sync as rows are added, removed (by unchecking that monitor), or edited.
  (function () {
    // Same preset list as the panel-wide unit fields (see UNIT_PRESETS/unitField() above) — kept
    // as its own small copy here rather than sharing that server-side const, since these rows are
    // built entirely client-side (one per checked monitor, added/removed as checkboxes toggle).
    var UNIT_PRESETS = ['°C', '°F', '%', 'W', 'kW', 'kWh', 'V', 'A', 'Hz', 'hPa', 'lux', 'ppm', 'bar', 'm³', 'dB'];

    // Same hex-normalization helper as the threshold/value-mapping builders above — a native
    // <input type="color"> only accepts a strict 7-char hex value, so a color already stored as a
    // CSS name has to be resolved before it can seed that row's swatch.
    function toHexColor(color) {
      var probe = document.createElement('div');
      probe.style.color = color;
      document.body.appendChild(probe);
      var computed = getComputedStyle(probe).color;
      document.body.removeChild(probe);
      var m = computed.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
      if (!m) return '#e34948';
      function hex(n) { return Number(n).toString(16).padStart(2, '0'); }
      return '#' + hex(m[1]) + hex(m[2]) + hex(m[3]);
    }

    function buildUnitPicker(currentValue) {
      var wrap = document.createElement('span');
      wrap.className = 'chart-series-row-unit-wrap';
      var isCustom = !!currentValue && UNIT_PRESETS.indexOf(currentValue) === -1;
      var select = document.createElement('select');
      select.className = 'chart-series-row-unit-select';
      var noneOpt = document.createElement('option');
      noneOpt.value = '';
      noneOpt.textContent = '(none)';
      select.appendChild(noneOpt);
      UNIT_PRESETS.forEach(function (u) {
        var opt = document.createElement('option');
        opt.value = u;
        opt.textContent = u;
        if (currentValue === u) opt.selected = true;
        select.appendChild(opt);
      });
      var customOpt = document.createElement('option');
      customOpt.value = '__custom__';
      customOpt.textContent = 'Custom…';
      if (isCustom) customOpt.selected = true;
      select.appendChild(customOpt);

      var input = document.createElement('input');
      input.type = 'text';
      input.className = 'chart-series-row-unit-custom';
      input.placeholder = 'Unit';
      input.value = isCustom ? currentValue : '';
      input.style.display = isCustom ? '' : 'none';

      select.addEventListener('change', function () {
        input.style.display = select.value === '__custom__' ? '' : 'none';
        if (select.value === '__custom__') input.focus();
      });

      wrap.appendChild(select);
      wrap.appendChild(input);
      return wrap;
    }

    // The effective unit value is whichever of select/input currently "owns" it — mirrors
    // .unit-select's own select-or-custom-input convention above, just read directly instead of
    // toggling a shared `name` attribute (these rows submit as one JSON blob, not individual
    // fields, so there's no name-collision to avoid here).
    function unitPickerValue(wrap) {
      var select = wrap.querySelector('.chart-series-row-unit-select');
      var input = wrap.querySelector('.chart-series-row-unit-custom');
      return select.value === '__custom__' ? input.value.trim() : select.value;
    }

    function buildRow(monitorId, monitorLabel, override) {
      var row = document.createElement('div');
      row.className = 'chart-series-row';
      row.dataset.monitorId = monitorId;
      row.innerHTML =
        '<span class="chart-series-row-label"></span>' +
        '<input type="text" class="chart-series-row-name" placeholder="Name">' +
        '<span class="chart-series-row-unit-slot"></span>' +
        '<select class="chart-series-row-axis"><option value="left">Left axis</option><option value="right">Right axis</option></select>' +
        '<input type="checkbox" class="chart-series-row-color-enabled" title="Give this series its own color">' +
        '<input type="color" class="chart-series-row-color">';
      row.querySelector('.chart-series-row-label').textContent = monitorLabel;
      row.querySelector('.chart-series-row-label').title = monitorLabel;
      row.querySelector('.chart-series-row-name').value = (override && override.name) || '';
      row.querySelector('.chart-series-row-axis').value = (override && override.axis === 'right') ? 'right' : 'left';

      var unitPicker = buildUnitPicker((override && override.unit) || '');
      row.querySelector('.chart-series-row-unit-slot').replaceWith(unitPicker);

      var colorValue = override && override.color;
      var colorEnabled = !!colorValue;
      row.querySelector('.chart-series-row-color-enabled').checked = colorEnabled;
      row.querySelector('.chart-series-row-color').value = toHexColor(colorValue || '#e34948');
      row.querySelector('.chart-series-row-color').style.visibility = colorEnabled ? '' : 'hidden';
      row.querySelector('.chart-series-row-color-enabled').addEventListener('change', function (e) {
        row.querySelector('.chart-series-row-color').style.visibility = e.target.checked ? '' : 'hidden';
      });

      return row;
    }

    document.querySelectorAll('.chart-series-settings').forEach(function (container) {
      var form = container.closest('form');
      var checklist = form.querySelector(container.dataset.checklistSelector);
      if (!checklist) return;
      var hidden = container.querySelector('.chart-series-hidden');
      var rowsEl = container.querySelector('.chart-series-rows');
      var cache = {};
      try { cache = JSON.parse(hidden.value || '{}'); } catch (e) { /* malformed — start empty */ }

      function serialize() {
        var out = {};
        rowsEl.querySelectorAll('.chart-series-row').forEach(function (row) {
          var id = row.dataset.monitorId;
          var name = row.querySelector('.chart-series-row-name').value.trim();
          var unit = unitPickerValue(row.querySelector('.chart-series-row-unit-wrap'));
          var axis = row.querySelector('.chart-series-row-axis').value;
          var hasColor = row.querySelector('.chart-series-row-color-enabled').checked;
          var color = hasColor ? row.querySelector('.chart-series-row-color').value : null;
          var entry = { name: name || null, unit: unit || null, axis: axis, color: color };
          // Kept in the in-memory cache (not just `out`) even when blank, so unchecking a monitor
          // and re-checking it later in the same session still shows whatever was last entered —
          // only what actually has a real value ends up in the submitted `out`.
          cache[id] = entry;
          if (name || unit || axis === 'right' || color) out[id] = entry;
        });
        hidden.value = JSON.stringify(out);
      }

      function rebuildRows() {
        var checked = Array.prototype.slice.call(checklist.querySelectorAll('input[type="checkbox"]:checked'));
        rowsEl.innerHTML = '';
        checked.forEach(function (checkbox) {
          var id = checkbox.value;
          var labelEl = checkbox.closest('label');
          // Strips a trailing " (mqtt)"/" (loxone)" source-type suffix (see the Add-panel
          // checklist's own markup above) — the Edit form's compact checklist has no such suffix
          // to begin with, so this simply doesn't match anything there.
          var monitorLabel = labelEl ? labelEl.textContent.trim().replace(/\s*\([a-z_]+\)\s*$/i, '') : id;
          var row = buildRow(id, monitorLabel, cache[id]);
          Array.prototype.forEach.call(row.querySelectorAll('input, select'), function (el) {
            el.addEventListener('input', serialize);
            el.addEventListener('change', serialize);
          });
          rowsEl.appendChild(row);
        });
        serialize();
      }

      checklist.addEventListener('change', function (e) {
        if (e.target.matches('input[type="checkbox"]')) rebuildRows();
      });
      rebuildRows();
    });
  })();
</script>

<script>
  // The panel edit form now opens as a fixed side drawer (see .dash-panel > .panel-settings-form
  // in style.css) instead of expanding inline, so unlike before it no longer needs the card itself
  // to grow to fit it — this just handles the backdrop (shown behind whichever drawer is open,
  // click or Escape to close) since the shared [data-toggle-row] handler (foot.ejs) only knows how
  // to toggle .open on the form itself, not coordinate a backdrop across all of them.
  (function () {
    var backdrop = document.getElementById('panel-edit-backdrop');
    if (!backdrop) return;

    function syncBackdrop() {
      var anyOpen = document.querySelector('.dash-panel > .panel-settings-form.open');
      backdrop.classList.toggle('open', !!anyOpen);
    }
    function closeAll() {
      document.querySelectorAll('.dash-panel > .panel-settings-form.open').forEach(function (f) { f.classList.remove('open'); });
      backdrop.classList.remove('open');
    }

    // Deferred a tick so this runs after foot.ejs's own [data-toggle-row] click handler has
    // already flipped .open — both are plain document click listeners, and this script runs
    // (and so registers its listener) before that one simply because it appears earlier in the
    // page, which would otherwise see the pre-toggle state.
    document.addEventListener('click', function (e) {
      if (e.target.closest('[data-toggle-row^="panel-edit-"]')) setTimeout(syncBackdrop, 0);
    });
    backdrop.addEventListener('click', closeAll);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeAll(); });
  })();
</script>

<script>
  // Drag-to-resize for the panel edit drawer's width — one shared handle per panel, but only the
  // currently-open one is ever visible (see .panel-drawer-resize-handle in style.css). The width
  // itself lives in a CSS custom property on the root element, so every panel's drawer (whichever
  // one is open next) picks up the same value — this is a personal UI preference, not dashboard
  // data, so localStorage is enough; no server round-trip needed.
  (function () {
    var STORAGE_KEY = 'panelDrawerWidth';
    var MIN_WIDTH = 340;

    function maxWidth() { return Math.min(1000, window.innerWidth * 0.92); }

    var saved = localStorage.getItem(STORAGE_KEY);
    if (saved) document.documentElement.style.setProperty('--panel-drawer-width', Math.min(Number(saved), maxWidth()) + 'px');

    document.querySelectorAll('.panel-drawer-resize-handle').forEach(function (handle) {
      handle.addEventListener('mousedown', function (e) {
        e.preventDefault();
        var drawer = handle.previousElementSibling;
        var startX = e.clientX;
        var startWidth = drawer.getBoundingClientRect().width;
        handle.classList.add('dragging');

        function onMove(e) {
          // Dragging left (clientX decreases) should widen the drawer — its right edge is pinned
          // to the viewport edge, so the left edge (and this handle) are what actually move.
          var width = Math.max(MIN_WIDTH, Math.min(maxWidth(), startWidth + (startX - e.clientX)));
          document.documentElement.style.setProperty('--panel-drawer-width', width + 'px');
        }
        function onUp() {
          document.removeEventListener('mousemove', onMove);
          document.removeEventListener('mouseup', onUp);
          handle.classList.remove('dragging');
          localStorage.setItem(STORAGE_KEY, getComputedStyle(document.documentElement).getPropertyValue('--panel-drawer-width').trim().replace('px', ''));
        }
        document.addEventListener('mousemove', onMove);
        document.addEventListener('mouseup', onUp);
      });
    });
  })();
</script>

<script>
  // Auto-saves every .panel-settings-form on any field change instead of requiring the explicit
  // Save button — the button still works (it's now just an immediate flush of the debounce below)
  // but no longer navigates away, so the drawer stays open and the change is visible right away.
  (function () {
    var pending = new WeakMap(); // form -> setTimeout id, so rapid edits collapse into one save
    var SAVE_DELAY_MS = 700;

    function setStatus(form, text) {
      var status = form.querySelector('.panel-save-status');
      if (status) status.textContent = text;
    }

    // The one panel-type-specific element that follows the settings form in a card — a chart's
    // .chart-wrap, a table's .panel-table-scroll, a gauge's .gauge-wrap, the "no monitors" hint,
    // etc. Found generically, since after a type change it's not the same element it was before.
    // Must also skip .confirm-bar — foot.ejs's data-confirm handling inserts one as a direct
    // child of .dash-panel too (right after .dash-panel-head, for the Delete-panel button), and
    // it's only ever present on the live DOM, never in a freshly-fetched, script-free HTML parse.
    function getContentEl(card) {
      return card.querySelector(':scope > *:not(.widget-drag-handle):not(.dash-panel-head):not(.confirm-bar):not(.panel-settings-form):not(.dash-panel-resize-handle)');
    }

    function applyPatch(card, freshCard) {
      var title = card.querySelector('.dash-panel-title');
      var freshTitle = freshCard.querySelector('.dash-panel-title');
      if (title && freshTitle) title.textContent = freshTitle.textContent;

      var content = getContentEl(card);
      var freshContent = getContentEl(freshCard);
      if (content && freshContent) {
        content.replaceWith(freshContent);
        // A chart's <canvas> needs its own refresh loop restarted — the generic content swap
        // above only ever gives it a fresh, un-initialized element.
        var canvas = freshContent.querySelector('canvas[data-monitor-ids]');
        if (canvas && window.initChartCanvas) window.initChartCanvas(canvas);
      }
      window.stampCsrfTokens();
    }

    function doSave(form) {
      clearTimeout(pending.get(form));
      pending.delete(form);
      var card = form.closest('.dash-panel');
      setStatus(form, 'Saving…');
      // A FormData body would send multipart/form-data, which nothing here parses (the app only
      // wires up express.urlencoded()) — every field would arrive as undefined. URLSearchParams
      // sends the same x-www-form-urlencoded body a normal form submit would.
      var params = new URLSearchParams();
      new FormData(form).forEach(function (value, key) { params.append(key, value); });
      fetch(form.action, { method: 'POST', body: params })
        .then(function (res) {
          if (!res.ok) throw new Error('save failed');
          return res.text();
        })
        .then(function (html) {
          var freshDoc = new DOMParser().parseFromString(html, 'text/html');
          var freshCard = freshDoc.querySelector('.dash-panel[data-id="' + card.dataset.id + '"]');
          if (card && freshCard) applyPatch(card, freshCard);
          setStatus(form, 'Saved');
          setTimeout(function () { setStatus(form, ''); }, 1500);
        })
        .catch(function () { setStatus(form, 'Save failed'); });
    }

    function scheduleSave(form) {
      setStatus(form, 'Editing…');
      clearTimeout(pending.get(form));
      pending.set(form, setTimeout(function () { doSave(form); }, SAVE_DELAY_MS));
    }

    function flushPending(form) {
      if (pending.has(form)) doSave(form);
    }

    document.querySelectorAll('.panel-settings-form').forEach(function (form) {
      form.addEventListener('submit', function (e) { e.preventDefault(); doSave(form); });
      ['input', 'change'].forEach(function (evtName) {
        form.addEventListener(evtName, function (e) {
          if (e.target.classList.contains('panel-monitor-filter')) return; // client-side-only, not a real field
          scheduleSave(form);
        });
      });
    });

    // Row-remove buttons (threshold/value-mapping builders) only ever fire a click, never an
    // input/change on the (now-detached) row itself, so they need their own trigger.
    document.addEventListener('click', function (e) {
      var removeBtn = e.target.closest('.threshold-row-remove, .value-mapping-row-remove');
      var form = removeBtn && removeBtn.closest('.panel-settings-form');
      if (form) { scheduleSave(form); return; }

      // Closing a drawer (backdrop or its own × — both use this same [data-toggle-row] trigger),
      // or opening a different panel's drawer, must not silently drop a still-debounced change.
      if (e.target.closest('#panel-edit-backdrop') || e.target.closest('[data-toggle-row^="panel-edit-"]')) {
        document.querySelectorAll('.panel-settings-form').forEach(flushPending);
      }
    });
  })();
</script>

<script>
  // Drag-reorder for dashboard panels — distance-based: find the nearest card by
  // straight-line distance, then decide before/after by which side of its center
  // the pointer is on (a simple Y-only check can't tell cards in the same row apart
  // once the grid wraps into multiple columns).
  (function () {
    var grid = document.getElementById('dash-grid');
    if (!grid) return;
    var dragEl = null;

    function getDragAfterElement(x, y) {
      var cards = Array.prototype.slice.call(grid.querySelectorAll('.dash-panel:not(.dragging)'));
      var closestCard = null;
      var closestCenterX = 0;
      var closestDistance = Infinity;

      cards.forEach(function (card) {
        var box = card.getBoundingClientRect();
        var centerX = box.left + box.width / 2;
        var centerY = box.top + box.height / 2;
        var distance = Math.hypot(x - centerX, y - centerY);
        if (distance < closestDistance) {
          closestDistance = distance;
          closestCard = card;
          closestCenterX = centerX;
        }
      });

      if (!closestCard) return null;
      return x < closestCenterX ? closestCard : closestCard.nextElementSibling;
    }

    function saveOrder() {
      var order = Array.prototype.map.call(grid.querySelectorAll('.dash-panel'), function (c) {
        return Number(c.dataset.id);
      });
      fetch('/dashboards/<%= dashboardId %>/panels/reorder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ order: order }),
      }).catch(function () { /* best-effort */ });
    }

    grid.querySelectorAll('.dash-panel').forEach(function (card) {
      card.addEventListener('dragstart', function (e) {
        // A resize-drag on the corner handle must never also start a reorder-drag.
        if (e.target.closest('.dash-panel-resize-handle')) { e.preventDefault(); return; }
        dragEl = card;
        card.classList.add('dragging');
      });
      card.addEventListener('dragend', function () {
        card.classList.remove('dragging');
        saveOrder();
      });
      card.addEventListener('dragover', function (e) {
        e.preventDefault();
        var after = getDragAfterElement(e.clientX, e.clientY);
        if (!dragEl) return;
        if (after == null) grid.appendChild(dragEl);
        else grid.insertBefore(dragEl, after);
      });
    });
  })();
</script>

<script>
  // Drag-to-resize from each panel's bottom-right corner handle — separate from the
  // whole-card HTML5 reorder-drag above (that one is cancelled when it starts on this
  // handle, see the dragstart listener). Pointer-based (mousedown/move/up), converts
  // the live pixel delta into whole grid-column/row units against the grid's actual
  // measured column width and the fixed row-unit height set in style.css, so a resize
  // means the same thing regardless of viewport width.
  (function () {
    var grid = document.getElementById('dash-grid');
    if (!grid) return;
    var ROW_UNIT_PX = 70; // must match .dash-grid's grid-auto-rows in style.css
    var COLUMNS = 12;
    var MIN_COL_SPAN = 2, MAX_COL_SPAN = 12, MIN_ROW_SPAN = 2, MAX_ROW_SPAN = 200;

    function clamp(v, min, max) { return Math.min(max, Math.max(min, v)); }

    grid.querySelectorAll('.dash-panel-resize-handle').forEach(function (handle) {
      handle.addEventListener('mousedown', function (e) {
        e.preventDefault();
        e.stopPropagation();

        var card = handle.closest('.dash-panel');
        var gapPx = parseFloat(getComputedStyle(grid).columnGap) || 0;
        var colStep = (grid.getBoundingClientRect().width + gapPx) / COLUMNS;
        var rowStep = ROW_UNIT_PX + gapPx;

        var startX = e.clientX, startY = e.clientY;
        var startColSpan = Number(card.dataset.colSpan) || 4;
        var startRowSpan = Number(card.dataset.rowSpan) || 3;
        var colSpan = startColSpan, rowSpan = startRowSpan;

        function onMove(e) {
          colSpan = clamp(startColSpan + Math.round((e.clientX - startX) / colStep), MIN_COL_SPAN, MAX_COL_SPAN);
          rowSpan = clamp(startRowSpan + Math.round((e.clientY - startY) / rowStep), MIN_ROW_SPAN, MAX_ROW_SPAN);
          card.style.gridColumn = 'span ' + colSpan;
          card.style.gridRow = 'span ' + rowSpan;
        }

        function onUp() {
          document.removeEventListener('mousemove', onMove);
          document.removeEventListener('mouseup', onUp);
          card.dataset.colSpan = colSpan;
          card.dataset.rowSpan = rowSpan;
          fetch('/dashboards/<%= dashboardId %>/panels/' + card.dataset.id + '/resize', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ colSpan: colSpan, rowSpan: rowSpan }),
          }).catch(function () { /* best-effort */ });
        }

        document.addEventListener('mousemove', onMove);
        document.addEventListener('mouseup', onUp);
      });
    });
  })();
</script>

