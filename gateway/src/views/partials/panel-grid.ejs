<%
  // Shared by both dashboard.ejs (the one shared/home dashboard) and dashboard-detail.ejs (a
  // personal My Dashboards board) — locals: dashboardId, panels, monitors, canEditPanels.
  // canEditPanels is computed by the caller: personal dashboards are always editable by their
  // owner (no Access Role check), the shared one is gated by canEdit('dashboard').

  // escAttr/unitField/thresholdField/annotationField moved to chartFieldHelpers.js (registered as
  // global EJS helpers in server.js, alongside toggleSwitch/icon/serializeThresholdLadder etc.)
  // once the Monitor detail page's own chart settings became a second consumer of them.

  // valueMappingField moved to chartFieldHelpers.js (registered as a global EJS helper) once the
  // Monitor detail page's own chart settings became a second consumer — same reasoning as
  // escAttr/unitField/thresholdField/annotationField above.

  // rangeField() itself moved to chartFieldHelpers.js (registered as a global EJS helper) once
  // Monitor detail/Home/Logs became consumers too — every call site in this file now passes
  // { includeDashboardDefault: true } for the "Dashboard default" inherit option only this page
  // (a dashboard panel's own Range field) actually has any use for.
%>
<%
  // Not deferred, and loaded here rather than down with chart.umd.min.js/monitor-chart.js at the
  // bottom of this file — every builder below (threshold/value-mapping/annotation/chart-series)
  // calls LoxColorPicker.buildPickerHtml() synchronously, as soon as the parser reaches each
  // <script> block, so the module has to already be defined before the FIRST of those runs, not
  // just before the page finishes loading.
%>
<script src="/color-picker.js"></script>
<%
  // GridStack.js (vendored MIT-licensed build, see /vendor/gridstack-all.min.js's own header) —
  // one instance per "zone" powers the whole panel grid below, replacing the old hand-rolled
  // skyline auto-packer + pointer-based drag/resize entirely (see the grid-init script and the
  // render loop's own comment further down). Loaded here rather than in partials/head.ejs/foot.ejs
  // since this grid is the only consumer, same reasoning as color-picker.js just above.
%>
<link rel="stylesheet" href="/vendor/gridstack.min.css">
<script src="/vendor/gridstack-all.min.js"></script>
<%
  // Favorite lives in the same row-actions bar as Add panel/Add group whenever both are present,
  // but neither gates the other — favoriting is a personal action available to a view-only
  // visitor of a shared dashboard (who has no Add panel/Add group at all, hence its own row here),
  // same as it always was before it lived in the page's own header instead of this shared partial.
%>
<% if (typeof isFavorited !== 'undefined' || canEditPanels) { %>
<div class="row-actions" style="margin-bottom:0.75rem;">
  <% if (typeof isFavorited !== 'undefined') { %>
  <form method="post" action="/dashboards/<%= dashboardId %>/<%= isFavorited ? 'unfavorite' : 'favorite' %>" class="inline">
    <input type="hidden" name="redirect_to" value="/dashboards/<%= dashboardId %>">
    <button type="submit" class="btn-soft favorite-toggle-btn <%= isFavorited ? 'is-favorited' : '' %>" title="<%= isFavorited ? 'Remove from favorite (Monitor → Favorite Dashboards)' : 'Add to favorite (Monitor → Favorite Dashboards)' %>">
      <%- icon('star') %> <%= isFavorited ? 'Remove from favorite' : 'Add to favorite' %>
    </button>
  </form>
  <% } %>
  <% if (canEditPanels) { %>
  <button type="button" id="dash-add-panel-btn" class="btn-soft"><%- icon('plus') %> Add panel</button>
  <form method="post" action="/dashboards/<%= dashboardId %>/panels" class="inline">
    <input type="hidden" name="panel_type" value="group_header">
    <input type="hidden" name="title" value="New group">
    <button type="submit" class="btn-soft" title="Adds a full-width divider bar — every panel added afterwards lands in this group (its own separate mini-grid) until the next header, if there is one. The chevron on the header then collapses/expands everything currently in that group.">
      <%- icon('plus') %> Add group
    </button>
  </form>
  <% if (panels.length > 1) { %>
  <button type="button" id="dash-auto-order-btn" class="btn-soft" style="margin-left:auto;" title="Pack every group's panels tightly, closing up any gaps">
    <%- icon('grid') %> Auto order
  </button>
  <% } %>
  <% } %>
</div>
<% } %>
<% if (canEditPanels) { %>
<div id="panel-edit-backdrop" class="panel-edit-backdrop"></div>
<div id="dash-add-panel-card" class="dash-add-panel-card" hidden>
  <div class="add-panel-body">
    <form method="post" action="/dashboards/<%= dashboardId %>/panels">
      <div class="form-grid">
        <div>
          <label>Panel type</label>
          <select name="panel_type" id="panel-type-select">
            <option value="chart">Chart</option>
            <option value="table">Table</option>
            <option value="value">Current value</option>
            <option value="gauge">Gauge</option>
            <option value="stat_delta">Stat with change</option>
            <option value="threshold">Threshold indicator</option>
            <option value="state_bar">State bar</option>
          </select>
        </div>
        <div><label>Title (optional)</label><input type="text" name="title" placeholder="Leave blank to auto-generate one"></div>
        <div id="panel-range-field">
          <label>Range</label>
          <%- rangeField('dashboard', { includeDashboardDefault: true }) %>
        </div>
      </div>

      <div class="form-grid" id="chart-fields" style="margin-top:0.85rem; display:none;">
        <div>
          <label>Chart type</label>
          <select name="chart_type" id="chart-type-select" class="chart-type-select">
            <option value="line">Line</option>
            <option value="bar_compare">Bar (compare)</option>
            <option value="doughnut">Doughnut</option>
            <option value="pie">Pie</option>
            <option value="polar_area">Polar Area</option>
            <option value="radar">Radar</option>
          </select>
        </div>
        <div class="threshold-builder-details-wrap" style="grid-column:1/-1;">
          <details class="threshold-builder-details" open>
            <summary>Legend</summary>
            <div class="form-grid">
              <div>
                <label>Legend</label>
                <select name="legend_position" id="legend-position-select" class="legend-position-select">
                  <option value="auto" selected>Auto (only when &gt;1 monitor)</option>
                  <option value="top">Top</option>
                  <option value="bottom">Bottom</option>
                  <option value="left">Left</option>
                  <option value="right">Right</option>
                  <option value="off">Off</option>
                </select>
              </div>
              <div data-chart-type-for="line" data-legend-for="on"><label>Legend alignment</label>
                <select name="legend_align">
                  <option value="start" selected>Left</option>
                  <option value="center">Center</option>
                  <option value="end">Right</option>
                </select>
              </div>
              <div data-chart-type-for="line" data-legend-for="on"><label>Show min in legend</label><%- toggleSwitch('legend_show_min', false) %></div>
              <div data-chart-type-for="line" data-legend-for="on"><label>Show max in legend</label><%- toggleSwitch('legend_show_max', false) %></div>
              <div data-chart-type-for="line" data-legend-for="on"><label>Show average in legend</label><%- toggleSwitch('legend_show_avg', false) %></div>
              <div data-chart-type-for="line" data-legend-for="on"><label>Show current value in legend</label><%- toggleSwitch('legend_show_current', false) %></div>
            </div>
          </details>
        </div>
        <div data-chart-type-for="line"><label>Y-axis unit (optional)</label><%- unitField('unit_chart', '') %></div>
        <div data-chart-type-for="line"><label>Stepped line</label>
          <select name="stepped_line">
            <option value="">Off</option>
            <option value="before">Before</option>
            <option value="after">After</option>
            <option value="middle">Middle</option>
          </select>
        </div>
        <div data-chart-type-for="line"><label>Curve</label>
          <select name="curve_tension">
            <option value="0">Straight</option>
            <option value="0.15" selected>Slight curve</option>
            <option value="0.4">Smooth</option>
          </select>
        </div>
        <div data-chart-type-for="line"><label>Show points on line</label><%- toggleSwitch('show_points', false) %></div>
        <div data-chart-type-for="line"><label>Fill area under line</label><%- toggleSwitch('fill_area', false) %></div>
        <div><label>Animate on load</label><%- toggleSwitch('enable_animation', false) %></div>
        <div data-chart-type-for="line"><label>Y-axis scale</label>
          <select name="y_scale_type">
            <option value="linear">Linear</option>
            <option value="logarithmic">Logarithmic</option>
          </select>
        </div>
        <div data-chart-type-for="line"><label>Y-axis min (optional)</label><input type="number" name="y_min" step="any" placeholder="Auto"></div>
        <div data-chart-type-for="line"><label>Y-axis max (optional)</label><input type="number" name="y_max" step="any" placeholder="Auto"></div>
        <div data-chart-type-for="line"><label>Zoom &amp; pan</label><%- toggleSwitch('enable_zoom', false) %></div>
        <div data-chart-type-for="line" style="grid-column:1/-1;"><%- thresholdField('chart_thresholds', []) %></div>
        <div data-chart-type-for="line" style="grid-column:1/-1;"><%- annotationField('chart_annotations', []) %></div>
      </div>

      <div class="form-grid" id="value-layout-field" style="margin-top:0.85rem; display:none;">
        <div>
          <label>Layout</label>
          <select name="value_layout">
            <option value="stacked">Stacked (one per line)</option>
            <option value="row">Row (side by side)</option>
          </select>
        </div>
        <div><label>Unit (optional)</label><%- unitField('unit_value', '') %></div>
        <%- valueMappingField('value_labels', []) %>
        <%- thresholdField('value_thresholds', []) %>
      </div>

      <div class="form-grid" id="table-fields" style="margin-top:0.85rem; display:none;">
        <div><label>Value scale (optional)</label><%- scaleField('scale_table', 1) %></div>
        <div><label>Decimals (optional)</label><input type="number" name="decimals_table" min="0" max="6" placeholder="Default"></div>
        <%- thresholdField('table_thresholds', []) %>
      </div>

      <div class="form-grid" id="gauge-fields" style="margin-top:0.85rem; display:none;">
        <div><label>Style</label>
          <select name="gauge_style" id="gauge-style-select">
            <option value="bar">Bar</option>
            <option value="radial">Round</option>
          </select>
        </div>
        <div data-gauge-style-for="radial"><label>Shape</label>
          <select name="gauge_shape">
            <option value="arc" selected>Arc</option>
            <option value="circle">Full circle</option>
          </select>
        </div>
        <div><label>Minimum</label><input type="number" name="gauge_min" value="0" step="any"></div>
        <div><label>Maximum</label><input type="number" name="gauge_max" value="100" step="any"></div>
        <div><label>Unit (optional)</label><%- unitField('unit_gauge', '') %></div>
        <div><label>Value scale (optional)</label><%- scaleField('scale_gauge', 1) %></div>
        <div><label>Decimals (optional)</label><input type="number" name="decimals_gauge" min="0" max="6" placeholder="Default"></div>
        <div><label>Threshold sections</label><%- toggleSwitch('gauge_sections', false) %></div>
        <div data-gauge-sections-for="on"><label>Gradient sections</label><%- toggleSwitch('gauge_sections_gradient', false) %></div>
        <div data-gauge-style-for="radial"><label>Needle</label><%- toggleSwitch('gauge_needle', false) %></div>
        <div data-gauge-style-for="radial"><label>Trend line under value</label><%- toggleSwitch('gauge_sparkline', false) %></div>
        <div data-gauge-style-for="radial" data-gauge-sparkline-for="on"><label>Neutral trend line color</label><%- toggleSwitch('gauge_sparkline_neutral', false) %></div>
        <%- thresholdField('gauge_thresholds', []) %>
        <p class="hint" style="grid-column:1/-1; margin:0;">Check more than one monitor above to show several gauges side by side in this panel, all sharing this same range/unit/thresholds.</p>
      </div>

      <div class="form-grid" id="stat-delta-fields" style="margin-top:0.85rem; display:none;">
        <div><label>Unit (optional)</label><%- unitField('unit_stat_delta', '') %></div>
        <div>
          <label>Color the change when</label>
          <select name="direction">
            <option value="neutral">Neutral (no color)</option>
            <option value="up_good">Higher is better</option>
            <option value="down_good">Lower is better</option>
          </select>
        </div>
        <div><label>Value scale (optional)</label><%- scaleField('scale_stat_delta', 1) %></div>
        <div><label>Decimals (optional)</label><input type="number" name="decimals_stat_delta" min="0" max="6" placeholder="Default"></div>
        <%- thresholdField('stat_delta_thresholds', []) %>
      </div>

      <div class="form-grid" id="threshold-fields" style="margin-top:0.85rem; display:none;">
        <div>
          <label>Alert when value is</label>
          <select name="threshold_operator">
            <option value="gt">Above</option>
            <option value="gte">Above or equal to</option>
            <option value="lt">Below</option>
            <option value="lte">Below or equal to</option>
          </select>
        </div>
        <div><label>Threshold</label><input type="number" name="threshold_value" value="0" step="any"></div>
        <div><label>Unit (optional)</label><%- unitField('unit_threshold', '') %></div>
        <div><label>Value scale (optional)</label><%- scaleField('scale_threshold', 1) %></div>
        <div><label>Decimals (optional)</label><input type="number" name="decimals_threshold" min="0" max="6" placeholder="Default"></div>
        <p class="hint" style="grid-column:1/-1; margin:0;">The threshold above is compared against the value <em>after</em> scaling.</p>
        <div><label>Label when normal</label><input type="text" name="label_ok" placeholder="Normal"></div>
        <div><label>Label when alert</label><input type="text" name="label_alert" placeholder="Alert"></div>
      </div>

      <div class="form-grid" id="state-bar-fields" style="margin-top:0.85rem; display:none;">
        <div><label>Default color (unmapped values)</label><input type="color" class="single-color-input" name="state_bar_default_color" value="#8a93a6"></div>
        <%- valueMappingField('state_bar_value_labels', []) %>
        <p class="hint" style="grid-column:1/-1; margin:0;">Check more than one monitor above to stack several state bars in this one panel, one row per monitor.</p>
      </div>

      <p class="hint" style="margin-top:0.6rem;">New panels start at a default size &mdash; drag a panel's bottom-right corner afterwards to resize it.</p>

      <details id="chart-series-settings" class="chart-series-settings threshold-builder-details" data-checklist-selector="#monitor-checklist" style="margin-top:0.85rem; display:none;">
        <summary>Series settings (optional)</summary>
        <div class="chart-series-rows"></div>
        <textarea class="chart-series-hidden" name="chart_series" hidden>{}</textarea>
        <p class="hint" style="margin:0.4rem 0 0;">Appears once you've checked a monitor below — rename a series, give it its own unit/scale/decimals, or move it to the right-hand axis.</p>
      </details>

      <details id="value-series-settings" class="value-series-settings threshold-builder-details" data-checklist-selector="#monitor-checklist" style="margin-top:0.85rem; display:none;">
        <summary>Per-value name, unit, scale &amp; decimals (optional)</summary>
        <div class="value-series-rows"></div>
        <textarea class="value-series-hidden" name="value_series" hidden>{}</textarea>
        <p class="hint" style="margin:0.4rem 0 0;">Appears once you've checked a monitor below — rename a value, give it its own unit, or scale/round it independently from the others.</p>
      </details>

      <div style="margin-top:0.85rem;" id="monitors-section">
        <label style="display:block; font-size:0.78rem; font-weight:500; margin-bottom:0.3rem; color:var(--text-muted);">
          Monitors
        </label>
        <p class="hint" id="table-monitor-hint" style="display:none; margin:0 0 0.5rem;">
          This panel type shows one monitor &mdash; if you check more than one, only the first is used.
        </p>
        <input type="text" id="monitor-filter" placeholder="Filter monitors&hellip;" style="max-width:20rem; margin-bottom:0.6rem; padding:0.5rem 0.6rem; border:1px solid var(--border); border-radius:7px; background:var(--surface); color:var(--text);">
        <div id="monitor-checklist" style="display:flex; flex-direction:column; gap:0.35rem; max-height:220px; overflow-y:auto; padding:0.6rem; border:1px solid var(--border); border-radius:8px;">
          <% monitors.forEach(m => { %>
            <label class="monitor-check-row" data-label="<%= m.label.toLowerCase() %>" style="display:flex; align-items:center; gap:0.5rem; font-size:0.87rem;">
              <input type="checkbox" name="monitor_ids" value="<%= m.id %>">
              <%= m.label %> <span class="hint" style="margin:0;">(<%= m.source_type %>)</span>
            </label>
          <% }) %>
          <% if (monitors.length === 0) { %>
            <p class="hint" style="margin:0;">No monitors yet &mdash; add one on the <a href="/monitor">Monitor</a> page first.</p>
          <% } %>
        </div>
      </div>

      <div style="margin-top:0.9rem;">
        <button type="submit" class="primary"><%- icon('plus') %> Add panel</button>
      </div>
    </form>
  </div>
</div>
<% } %>

<div class="dash-grid-wrap" id="dash-grid">
  <%
    // One GridStack instance per "zone", not one grid for the whole dashboard — zone 0 is every
    // panel before the first group_header, rendered inside its own <div class="grid-stack">
    // opened right below; each group_header then closes whatever zone preceded it and immediately
    // opens a brand-new one (even if it turns out to have zero members, so the collapse-toggle
    // script below always has a same-sized sibling to show/hide) for the panels that follow IT, up
    // to the next header or the end of the list. Every group (header + its own zone-grid) also
    // sits inside a shared .dash-groups-sort-list — a plain block container, NOT a second GridStack
    // instance (see the group-reorder script further down, which reuses LoxRowReorder's hand-
    // rolled pointer-drag instead) — nesting a second INTERACTIVE GridStack grid inside one of the
    // panel zones' own draggable items was tried and reverted, it broke hit-testing for both drags
    // it was ever supposed to coexist with. Zone 0 (ungrouped panels) stays outside it entirely —
    // it's not a group, and always renders first regardless of how the groups below it reorder.
    let dashZoneIndex = 0;
    let hasOpenGroupUnit = false;
  %>
  <div class="grid-stack" id="dash-grid-zone-0">
  <% panels.forEach(p => { %>
    <% const isGroupHeader = p.panel_type === 'group_header'; %>
    <% if (isGroupHeader) { %>
      </div>
      <% if (hasOpenGroupUnit) { %></div><% } %>
      <% if (!hasOpenGroupUnit) { %><div class="dash-groups-sort-list" id="dash-groups-sort-list"><% } %>
      <div class="dash-group-unit" data-group-panel-id="<%= p.id %>">
      <% hasOpenGroupUnit = true; %>
    <% } %>
    <% if (!isGroupHeader) { %>
      <%
        // NULL grid_x/grid_y (see db.js's migrateDashboardPanelGridPosition) means this panel has
        // never been explicitly positioned by GridStack — omitting gs-x/gs-y entirely (rather than
        // e.g. defaulting to 0,0) is what tells GridStack to auto-place it instead, in its existing
        // position order, alongside whatever else in this same zone already has (or lacks) one.
        // data-needs-position flags it for the grid-init script further down, which persists
        // GridStack's own computed x/y right after auto-placing it so the NEXT load has a real
        // saved spot instead of re-auto-placing every time.
        const hasGridPos = p.grid_x !== null && p.grid_x !== undefined && p.grid_y !== null && p.grid_y !== undefined;
      %>
    <div class="grid-stack-item" gs-w="<%= p.col_span %>" gs-h="<%= p.row_span %>" gs-min-w="2" gs-min-h="2" gs-id="<%= p.id %>"<% if (hasGridPos) { %> gs-x="<%= p.grid_x %>" gs-y="<%= p.grid_y %>"<% } else { %> data-needs-position="1"<% } %>>
      <div class="grid-stack-item-content">
    <% } %>
    <div class="dash-panel<%= isGroupHeader ? ' dash-panel-group-header' : '' %>" data-id="<%= p.id %>" data-panel-type="<%= p.panel_type %>">
      <% if (canEditPanels && !isGroupHeader) { %><span class="widget-drag-handle" title="Drag to reorder">&#8942;&#8942;</span><% } %>
      <% if (canEditPanels && isGroupHeader) { %><span class="group-drag-handle" title="Drag to reorder this group">&#8942;&#8942;</span><% } %>
      <div class="dash-panel-head">
        <% if (isGroupHeader) { %>
          <button type="button" class="icon-btn icon-btn-neutral group-header-toggle" title="Collapse/expand this group" aria-label="Collapse/expand this group">
            <span class="group-header-chevron"><%- icon('chevron') %></span>
          </button>
        <% } %>
        <div class="dash-panel-title">
          <%= p.title || (p.panel_type.charAt(0).toUpperCase() + p.panel_type.slice(1)) %>
          <% if (isGroupHeader && p.config.description) { %>
            <span class="dash-panel-group-description"> - <%= p.config.description %></span>
          <% } %>
        </div>
        <% if (canEditPanels) { %>
        <div class="row-actions">
          <button type="button" class="icon-btn icon-btn-edit" title="Edit panel" data-toggle-row="panel-edit-<%= p.id %>"><%- icon('edit') %></button>
          <form method="post" action="/dashboards/<%= dashboardId %>/panels/<%= p.id %>/duplicate">
            <button type="submit" class="icon-btn icon-btn-add" title="Duplicate panel"><%- icon('copy') %></button>
          </form>
          <form method="post" action="/dashboards/<%= dashboardId %>/panels/<%= p.id %>/delete" data-confirm="Remove this panel?">
            <button type="submit" class="icon-btn icon-btn-danger" title="Delete panel"><%- icon('trash') %></button>
          </form>
        </div>
        <% } %>
      </div>

      <% if (canEditPanels) { %>
      <form id="panel-edit-<%= p.id %>" method="post" action="/dashboards/<%= dashboardId %>/panels/<%= p.id %>/settings" class="form-grid panel-settings-form">
        <div class="panel-settings-form-head" style="grid-column:1/-1; display:flex; align-items:center; justify-content:space-between; margin-bottom:0.3rem;">
          <strong>Edit panel</strong>
          <div class="row-actions">
            <%
              // The star's color is a "just saved" flag, not "does a default exist" — it starts
              // unlit on every page load regardless of saved state, lights up the moment Save is
              // clicked, and dims again the moment Reset is clicked (see the dedicated script
              // block below). Reset's own visibility is still gated on a real saved default
              // actually existing for this (dashboard, panel_type) pair — nothing to reset to
              // otherwise — that part IS server truth, just not tied to the star's color.
            %>
            <%
              // Chart panels fold their own chartType into the lookup key ('chart:line',
              // 'chart:polar_area', ...) — see defaultsKey() in panelTypeDefaults.js for why a
              // Line house style and a Polar Area one can't share one 'chart' key.
              const panelDefaultsKey = p.panel_type === 'chart' ? 'chart:' + (p.config.chartType || 'line') : p.panel_type;
            %>
            <button type="button" class="icon-btn icon-btn-neutral" data-panel-default-kind="save" data-panel-default-url="/dashboards/<%= dashboardId %>/panels/<%= p.id %>/save-as-default" title="Save this panel's appearance as the default for every &quot;<%= p.panel_type %>&quot; panel on THIS dashboard"><%- icon('star') %></button>
            <button type="button" class="icon-btn icon-btn-neutral hints-toggle-btn" title="Show/hide the help text under each field"><%- icon('lightbulb') %></button>
            <% if (panelTypeDefaultsExist[panelDefaultsKey]) { %>
            <button type="button" class="icon-btn icon-btn-neutral" data-panel-default-kind="reset" data-panel-default-url="/dashboards/<%= dashboardId %>/panels/<%= p.id %>/reset-to-default" title="Apply the saved &quot;<%= p.panel_type %>&quot; default (this dashboard) to THIS panel"><%- icon('refresh') %></button>
            <% } %>
            <button type="button" class="icon-btn icon-btn-danger" data-toggle-row="panel-edit-<%= p.id %>" title="Close" aria-label="Close"><%- icon('x') %></button>
          </div>
        </div>
        <div>
          <label>Panel type</label>
          <select name="panel_type" class="panel-type-select">
            <option value="chart" <%= p.panel_type === 'chart' ? 'selected' : '' %>>Chart</option>
            <option value="table" <%= p.panel_type === 'table' ? 'selected' : '' %>>Table</option>
            <option value="value" <%= p.panel_type === 'value' ? 'selected' : '' %>>Current value</option>
            <option value="gauge" <%= p.panel_type === 'gauge' ? 'selected' : '' %>>Gauge</option>
            <option value="stat_delta" <%= p.panel_type === 'stat_delta' ? 'selected' : '' %>>Stat with change</option>
            <option value="threshold" <%= p.panel_type === 'threshold' ? 'selected' : '' %>>Threshold indicator</option>
            <option value="state_bar" <%= p.panel_type === 'state_bar' ? 'selected' : '' %>>State bar</option>
            <option value="group_header" <%= p.panel_type === 'group_header' ? 'selected' : '' %>>Group header</option>
          </select>
        </div>
        <div><label>Title</label><input type="text" name="title" value="<%= p.title || '' %>" placeholder="Title"></div>
        <div data-fields-for="group_header">
          <label>Description (optional)</label>
          <input type="text" name="description" value="<%= p.panel_type === 'group_header' ? (p.config.description || '') : '' %>" placeholder="Shown after the title as &quot;Title - description&quot;">
        </div>
        <div data-fields-for="chart,table,stat_delta,state_bar">
          <label>Range</label>
          <%- rangeField(p.range, { includeDashboardDefault: true }) %>
        </div>

        <%
          // Chart-only appearance/axis/interaction settings — grouped under a shared, always-shown
          // (display:contents, see .panel-section in style.css) wrapper carrying ONE data-fields-for
          // instead of repeating it on every field div: same toggle mechanism (the script below still
          // just queries every [data-fields-for] and shows/hides by type), fewer places to keep in
          // sync when a field moves between sections.
          var legendPos = p.panel_type === 'chart' ? (p.config.legendPosition || 'auto') : 'auto';
          var yScaleType = p.panel_type === 'chart' ? (p.config.yScaleType || 'linear') : 'linear';
          // config.stepped predates the before/after/middle granularity and was a bare boolean —
          // true is normalized to 'before' here (the granularity that reproduced the old rendering)
          // so a panel saved before this upgrade doesn't show "Off" the first time its Edit form
          // opens despite still actually being stepped. See routes/dashboards.js's buildConfig for
          // the same normalization on the canvas data-attr / new-submission side.
          var steppedVal = p.panel_type === 'chart' ? (p.config.stepped === true ? 'before' : (p.config.stepped || '')) : '';
          var curveTension = p.panel_type === 'chart' && p.config.curveTension != null ? p.config.curveTension : 0.15;
          var chartType = p.panel_type === 'chart' ? (p.config.chartType || 'line') : 'line';
        %>
        <div class="panel-section" data-fields-for="chart">
          <div class="panel-section-title">Appearance</div>
          <div>
            <label>Chart type</label>
            <select name="chart_type" class="chart-type-select">
              <option value="line" <%= chartType === 'line' ? 'selected' : '' %>>Line</option>
              <option value="bar_compare" <%= chartType === 'bar_compare' ? 'selected' : '' %>>Bar (compare)</option>
              <option value="doughnut" <%= chartType === 'doughnut' ? 'selected' : '' %>>Doughnut</option>
              <option value="pie" <%= chartType === 'pie' ? 'selected' : '' %>>Pie</option>
              <option value="polar_area" <%= chartType === 'polar_area' ? 'selected' : '' %>>Polar Area</option>
              <option value="radar" <%= chartType === 'radar' ? 'selected' : '' %>>Radar</option>
            </select>
          </div>
          <% var legendAlign = p.panel_type === 'chart' ? (p.config.legendAlign || 'start') : 'start'; %>
          <div class="threshold-builder-details-wrap" style="grid-column:1/-1;">
            <details class="threshold-builder-details" open>
              <summary>Legend</summary>
              <div class="form-grid">
                <div>
                  <label>Legend</label>
                  <select name="legend_position" class="legend-position-select">
                    <option value="auto" <%= legendPos === 'auto' ? 'selected' : '' %>>Auto (only when &gt;1 monitor)</option>
                    <option value="top" <%= legendPos === 'top' ? 'selected' : '' %>>Top</option>
                    <option value="bottom" <%= legendPos === 'bottom' ? 'selected' : '' %>>Bottom</option>
                    <option value="left" <%= legendPos === 'left' ? 'selected' : '' %>>Left</option>
                    <option value="right" <%= legendPos === 'right' ? 'selected' : '' %>>Right</option>
                    <option value="off" <%= legendPos === 'off' ? 'selected' : '' %>>Off</option>
                  </select>
                </div>
                <div data-chart-type-for="line" data-legend-for="on"><label>Legend alignment</label>
                  <select name="legend_align">
                    <option value="start" <%= legendAlign === 'start' ? 'selected' : '' %>>Left</option>
                    <option value="center" <%= legendAlign === 'center' ? 'selected' : '' %>>Center</option>
                    <option value="end" <%= legendAlign === 'end' ? 'selected' : '' %>>Right</option>
                  </select>
                </div>
                <div data-chart-type-for="line" data-legend-for="on"><label>Show min in legend</label><%- toggleSwitch('legend_show_min', p.panel_type === 'chart' && !!p.config.legendShowMin) %></div>
                <div data-chart-type-for="line" data-legend-for="on"><label>Show max in legend</label><%- toggleSwitch('legend_show_max', p.panel_type === 'chart' && !!p.config.legendShowMax) %></div>
                <div data-chart-type-for="line" data-legend-for="on"><label>Show average in legend</label><%- toggleSwitch('legend_show_avg', p.panel_type === 'chart' && !!p.config.legendShowAvg) %></div>
                <div data-chart-type-for="line" data-legend-for="on"><label>Show current value in legend</label><%- toggleSwitch('legend_show_current', p.panel_type === 'chart' && !!p.config.legendShowCurrent) %></div>
              </div>
            </details>
          </div>
          <div data-chart-type-for="line"><label>Y-axis unit</label><%- unitField('unit_chart', p.panel_type === 'chart' ? (p.config.unit || '') : '') %></div>
          <div data-chart-type-for="line"><label>Stepped line</label>
            <select name="stepped_line">
              <option value="" <%= steppedVal === '' ? 'selected' : '' %>>Off</option>
              <option value="before" <%= steppedVal === 'before' ? 'selected' : '' %>>Before</option>
              <option value="after" <%= steppedVal === 'after' ? 'selected' : '' %>>After</option>
              <option value="middle" <%= steppedVal === 'middle' ? 'selected' : '' %>>Middle</option>
            </select>
          </div>
          <div data-chart-type-for="line"><label>Curve</label>
            <select name="curve_tension">
              <option value="0" <%= curveTension == 0 ? 'selected' : '' %>>Straight</option>
              <option value="0.15" <%= curveTension == 0.15 ? 'selected' : '' %>>Slight curve</option>
              <option value="0.4" <%= curveTension == 0.4 ? 'selected' : '' %>>Smooth</option>
            </select>
          </div>
          <div data-chart-type-for="line"><label>Show points on line</label><%- toggleSwitch('show_points', p.panel_type === 'chart' && !!p.config.points) %></div>
          <div data-chart-type-for="line"><label>Fill area under line</label><%- toggleSwitch('fill_area', p.panel_type === 'chart' && !!p.config.fill) %></div>
          <div><label>Animate on load</label><%- toggleSwitch('enable_animation', p.panel_type === 'chart' && !!p.config.animation) %></div>
        </div>
        <div class="panel-section" data-fields-for="chart" data-chart-type-for="line">
          <div class="panel-section-title">Y-axis</div>
          <div>
            <label>Scale</label>
            <select name="y_scale_type">
              <option value="linear" <%= yScaleType === 'linear' ? 'selected' : '' %>>Linear</option>
              <option value="logarithmic" <%= yScaleType === 'logarithmic' ? 'selected' : '' %>>Logarithmic</option>
            </select>
          </div>
          <div><label>Minimum (optional)</label><input type="number" name="y_min" step="any" placeholder="Auto" value="<%= p.panel_type === 'chart' && p.config.yMin != null ? p.config.yMin : '' %>"></div>
          <div><label>Maximum (optional)</label><input type="number" name="y_max" step="any" placeholder="Auto" value="<%= p.panel_type === 'chart' && p.config.yMax != null ? p.config.yMax : '' %>"></div>
        </div>
        <div class="panel-section" data-fields-for="chart" data-chart-type-for="line">
          <div class="panel-section-title">Interaction</div>
          <div><label>Zoom &amp; pan (scroll to zoom, drag to pan)</label><%- toggleSwitch('enable_zoom', p.panel_type === 'chart' && !!p.config.zoom) %></div>
        </div>
        <div data-fields-for="chart" data-chart-type-for="line" style="grid-column:1/-1;">
          <%- thresholdField('chart_thresholds', p.panel_type === 'chart' ? p.config.thresholds : []) %>
        </div>
        <div data-fields-for="chart" data-chart-type-for="line" style="grid-column:1/-1;">
          <%- annotationField('chart_annotations', p.panel_type === 'chart' ? p.config.annotations : []) %>
        </div>

        <div class="panel-section" data-fields-for="value">
          <div class="panel-section-title">Appearance</div>
          <div>
            <label>Layout</label>
            <select name="value_layout">
              <option value="stacked" <%= !(p.panel_type === 'value' && p.config.layout === 'row') ? 'selected' : '' %>>Stacked (one per line)</option>
              <option value="row" <%= p.panel_type === 'value' && p.config.layout === 'row' ? 'selected' : '' %>>Row (side by side)</option>
            </select>
          </div>
          <div><label>Unit</label><%- unitField('unit_value', p.panel_type === 'value' ? (p.config.unit || '') : '') %></div>
        </div>
        <div data-fields-for="value" style="grid-column:1/-1;">
          <%- valueMappingField('value_labels', p.panel_type === 'value' ? p.config.valueLabels : []) %>
        </div>
        <div data-fields-for="value" style="grid-column:1/-1;">
          <%- thresholdField('value_thresholds', p.panel_type === 'value' ? p.config.thresholds : []) %>
        </div>
        <details data-fields-for="value" class="value-series-settings threshold-builder-details" data-checklist-selector=".panel-monitor-checklist" style="grid-column:1/-1;" <%= p.panel_type === 'value' && Object.keys(p.config.series || {}).length > 0 ? 'open' : '' %>>
          <summary>Per-value name, unit, scale &amp; decimals</summary>
          <div class="value-series-rows"></div>
          <textarea class="value-series-hidden" name="value_series" hidden><%= p.panel_type === 'value' ? JSON.stringify(p.config.series || {}) : '{}' %></textarea>
          <p class="hint" style="margin:0.3rem 0 0;">Rename a value, give it its own unit, or scale/round it independently from the others &mdash; display only, doesn't rename the Monitor itself.</p>
        </details>
        <details data-fields-for="chart" class="chart-series-settings threshold-builder-details" data-checklist-selector=".panel-monitor-checklist" style="grid-column:1/-1;" <%= p.panel_type === 'chart' && Object.keys(p.config.series || {}).length > 0 ? 'open' : '' %>>
          <summary>Series settings</summary>
          <div class="chart-series-rows"></div>
          <textarea class="chart-series-hidden" name="chart_series" hidden><%= p.panel_type === 'chart' ? JSON.stringify(p.config.series || {}) : '{}' %></textarea>
          <p class="hint" style="margin:0.3rem 0 0;">Rename a series, give it its own unit/scale/decimals/line style, or move it to the right-hand axis.</p>
        </details>

        <div class="panel-section" data-fields-for="table">
          <div class="panel-section-title">Appearance</div>
          <div><label>Value scale</label><%- scaleField('scale_table', p.panel_type === 'table' && p.config.scale != null ? p.config.scale : 1) %></div>
          <div><label>Decimals (optional)</label><input type="number" name="decimals_table" min="0" max="6" placeholder="Default" value="<%= p.panel_type === 'table' && p.config.decimals != null ? p.config.decimals : '' %>"></div>
        </div>
        <div data-fields-for="table" style="grid-column:1/-1;">
          <%- thresholdField('table_thresholds', p.panel_type === 'table' ? p.config.thresholds : []) %>
        </div>

        <div class="panel-section" data-fields-for="gauge">
          <div class="panel-section-title">Range</div>
          <div><label>Style</label>
            <select name="gauge_style" class="gauge-style-select">
              <option value="bar" <%= !(p.panel_type === 'gauge' && p.config.style === 'radial') ? 'selected' : '' %>>Bar</option>
              <option value="radial" <%= p.panel_type === 'gauge' && p.config.style === 'radial' ? 'selected' : '' %>>Round</option>
            </select>
          </div>
          <div data-gauge-style-for="radial"><label>Shape</label>
            <select name="gauge_shape">
              <option value="arc" <%= !(p.panel_type === 'gauge' && p.config.shape === 'circle') ? 'selected' : '' %>>Arc</option>
              <option value="circle" <%= p.panel_type === 'gauge' && p.config.shape === 'circle' ? 'selected' : '' %>>Full circle</option>
            </select>
          </div>
          <div><label>Minimum</label><input type="number" name="gauge_min" value="<%= p.panel_type === 'gauge' ? p.config.min : 0 %>" step="any"></div>
          <div><label>Maximum</label><input type="number" name="gauge_max" value="<%= p.panel_type === 'gauge' ? p.config.max : 100 %>" step="any"></div>
          <div><label>Unit</label><%- unitField('unit_gauge', p.panel_type === 'gauge' ? (p.config.unit || '') : '') %></div>
          <div><label>Value scale</label><%- scaleField('scale_gauge', p.panel_type === 'gauge' && p.config.scale != null ? p.config.scale : 1) %></div>
          <div><label>Decimals (optional)</label><input type="number" name="decimals_gauge" min="0" max="6" placeholder="Default" value="<%= p.panel_type === 'gauge' && p.config.decimals != null ? p.config.decimals : '' %>"></div>
          <div><label>Threshold sections</label><%- toggleSwitch('gauge_sections', p.panel_type === 'gauge' && !!p.config.sections) %></div>
          <div data-gauge-sections-for="on"><label>Gradient sections</label><%- toggleSwitch('gauge_sections_gradient', p.panel_type === 'gauge' && !!p.config.sectionsGradient) %></div>
          <div data-gauge-style-for="radial"><label>Needle</label><%- toggleSwitch('gauge_needle', p.panel_type === 'gauge' && !!p.config.needle) %></div>
          <div data-gauge-style-for="radial"><label>Trend line under value</label><%- toggleSwitch('gauge_sparkline', p.panel_type === 'gauge' && !!p.config.sparkline) %></div>
          <div data-gauge-style-for="radial" data-gauge-sparkline-for="on"><label>Neutral trend line color</label><%- toggleSwitch('gauge_sparkline_neutral', p.panel_type === 'gauge' && p.config.sparklineColor === 'default') %></div>
        </div>
        <div data-fields-for="gauge" style="grid-column:1/-1;">
          <%- thresholdField('gauge_thresholds', p.panel_type === 'gauge' ? p.config.thresholds : []) %>
          <% if (p.panel_type === 'gauge') { %><p class="hint" style="margin:0.4rem 0 0;">Check more than one monitor above to show several gauges side by side, all sharing this same range/unit/thresholds.</p><% } %>
        </div>

        <div class="panel-section" data-fields-for="stat_delta">
          <div class="panel-section-title">Appearance</div>
          <div><label>Unit</label><%- unitField('unit_stat_delta', p.panel_type === 'stat_delta' ? (p.config.unit || '') : '') %></div>
          <div>
            <label>Color the change when</label>
            <select name="direction">
              <option value="neutral" <%= !(p.panel_type === 'stat_delta' && p.config.direction !== 'neutral') ? 'selected' : '' %>>Neutral (no color)</option>
              <option value="up_good" <%= p.panel_type === 'stat_delta' && p.config.direction === 'up_good' ? 'selected' : '' %>>Higher is better</option>
              <option value="down_good" <%= p.panel_type === 'stat_delta' && p.config.direction === 'down_good' ? 'selected' : '' %>>Lower is better</option>
            </select>
          </div>
          <div><label>Value scale</label><%- scaleField('scale_stat_delta', p.panel_type === 'stat_delta' && p.config.scale != null ? p.config.scale : 1) %></div>
          <div><label>Decimals (optional)</label><input type="number" name="decimals_stat_delta" min="0" max="6" placeholder="Default" value="<%= p.panel_type === 'stat_delta' && p.config.decimals != null ? p.config.decimals : '' %>"></div>
        </div>
        <div data-fields-for="stat_delta" style="grid-column:1/-1;">
          <%- thresholdField('stat_delta_thresholds', p.panel_type === 'stat_delta' ? p.config.thresholds : []) %>
        </div>

        <div class="panel-section" data-fields-for="threshold">
          <div class="panel-section-title">Condition</div>
          <div>
            <label>Alert when value is</label>
            <select name="threshold_operator">
              <option value="gt" <%= !(p.panel_type === 'threshold') || p.config.operator === 'gt' ? 'selected' : '' %>>Above</option>
              <option value="gte" <%= p.panel_type === 'threshold' && p.config.operator === 'gte' ? 'selected' : '' %>>Above or equal to</option>
              <option value="lt" <%= p.panel_type === 'threshold' && p.config.operator === 'lt' ? 'selected' : '' %>>Below</option>
              <option value="lte" <%= p.panel_type === 'threshold' && p.config.operator === 'lte' ? 'selected' : '' %>>Below or equal to</option>
            </select>
          </div>
          <div><label>Threshold</label><input type="number" name="threshold_value" value="<%= p.panel_type === 'threshold' ? p.config.value : 0 %>" step="any"></div>
          <div><label>Unit</label><%- unitField('unit_threshold', p.panel_type === 'threshold' ? (p.config.unit || '') : '') %></div>
          <div><label>Value scale</label><%- scaleField('scale_threshold', p.panel_type === 'threshold' && p.config.scale != null ? p.config.scale : 1) %></div>
          <div><label>Decimals (optional)</label><input type="number" name="decimals_threshold" min="0" max="6" placeholder="Default" value="<%= p.panel_type === 'threshold' && p.config.decimals != null ? p.config.decimals : '' %>"></div>
          <p class="hint" style="grid-column:1/-1; margin:0;">The threshold above is compared against the value <em>after</em> scaling.</p>
        </div>
        <div class="panel-section" data-fields-for="threshold">
          <div class="panel-section-title">Labels</div>
          <div><label>When normal</label><input type="text" name="label_ok" value="<%= p.panel_type === 'threshold' ? p.config.labelOk : 'Normal' %>"></div>
          <div><label>When alert</label><input type="text" name="label_alert" value="<%= p.panel_type === 'threshold' ? p.config.labelAlert : 'Alert' %>"></div>
        </div>
        <div class="panel-section" data-fields-for="state_bar">
          <div class="panel-section-title">State bar</div>
          <div><label>Default color (unmapped values)</label><input type="color" class="single-color-input" name="state_bar_default_color" value="<%= p.panel_type === 'state_bar' && p.config.defaultColor ? p.config.defaultColor : '#8a93a6' %>"></div>
        </div>
        <div data-fields-for="state_bar" style="grid-column:1/-1;">
          <%- valueMappingField('state_bar_value_labels', p.panel_type === 'state_bar' ? p.config.valueLabels : []) %>
          <p class="hint" style="margin:0.4rem 0 0;">Check more than one monitor below to stack several state bars in this one panel, one row per monitor.</p>
        </div>

        <div class="panel-section-title" data-fields-for="chart,table,value,gauge,stat_delta,threshold,state_bar" style="grid-column:1/-1;">Monitors</div>
        <div data-fields-for="chart,table,value,gauge,stat_delta,threshold,state_bar" style="grid-column:1/-1;">
          <p class="hint panel-single-monitor-hint" data-fields-for="table,stat_delta,threshold" style="display:none; margin:0 0 0.25rem; font-size:0.7rem;">
            This panel type only uses the first checked monitor.
          </p>
          <input type="text" class="panel-monitor-filter" placeholder="Filter monitors&hellip;" style="margin-bottom:0.25rem; width:100%;">
          <div class="panel-monitor-checklist" style="display:flex; flex-direction:column; max-height:220px; overflow-y:auto; overflow-x:hidden; padding:0.2rem; border:1px solid var(--border); border-radius:6px;">
            <% monitors.forEach(m => { %>
              <label class="panel-monitor-check-row" data-label="<%= m.label.toLowerCase() %>" style="display:flex; align-items:center; gap:0.3rem; font-size:0.75rem; min-width:0; padding:0.05rem 0;">
                <input type="checkbox" name="monitor_ids" value="<%= m.id %>" style="flex-shrink:0;" <%= p.monitors.some(pm => pm.id === m.id) ? 'checked' : '' %>>
                <span style="flex:1; min-width:0; overflow-wrap:anywhere; line-height:1.2;"><%= m.label %></span>
              </label>
            <% }) %>
            <% if (monitors.length === 0) { %>
              <p class="hint" style="margin:0;">No monitors yet.</p>
            <% } %>
          </div>
        </div>
        <%
          // No Save button — every field change auto-saves (see the script near the bottom of
          // this file), so a button implying "nothing's saved until you click this" would just
          // contradict what's actually happening. This status text is the only save affordance.
        %>
        <span class="hint panel-save-status" style="grid-column:1/-1; margin:0;">Saved</span>
      </form>
      <span class="panel-drawer-resize-handle" title="Drag to resize"></span>
      <% } %>

      <% if (isGroupHeader) { %>
        <!-- a group header has no body of its own — it's just the head bar above, acting as a
             full-width divider/collapse toggle for whatever panels follow it. -->
      <% } else if (p.monitors.length === 0) { %>
        <p class="hint">No monitors left in this panel &mdash; they may have been deleted from the Monitor page. Remove this panel or add a new one.</p>
      <% } else if (p.panel_type === 'chart') { %>
        <div class="chart-wrap">
          <div class="chart-canvas-inner">
          <%
            // No panel-wide Decimals/Value scale for chart any more — every series can set its
            // own of both in "Series settings" now, so the panel-wide ones were just a redundant
            // extra step (same reasoning that already dropped them from the Current value panel
            // type once its own per-value equivalents existed). data-decimals still needs ONE
            // shared value here (not per-series) purely for the axis TICK labels, which really are
            // shared across every series on that axis — falls back to the same Settings-page
            // global default the Current value panel type's own per-value Decimals already does.
          %>
          <%
            // config.stepped predates the before/after/middle granularity (see the Edit form's own
            // steppedVal local above for the matching normalization on the pre-fill side) — true
            // (legacy boolean) becomes 'before' here too, so an old saved panel keeps rendering
            // exactly as it did before this option existed instead of silently losing its step.
            var canvasStepped = p.config.stepped === true ? 'before' : (p.config.stepped || '');
            var legendStats = [];
            if (p.config.legendShowMin) legendStats.push('min');
            if (p.config.legendShowMax) legendStats.push('max');
            if (p.config.legendShowAvg) legendStats.push('avg');
            if (p.config.legendShowCurrent) legendStats.push('current');
          %>
          <canvas data-chart-type="<%= p.config.chartType || 'line' %>" data-monitor-ids="<%= p.monitors.map(m => m.id).join(',') %>" data-range="<%= p.displayRange || p.range %>" data-range-until="<%= p.chartUntilMs || '' %>" data-legend="<%= p.config.legendPosition || 'auto' %>" data-legend-align="<%= p.config.legendAlign || 'start' %>" data-legend-stats="<%= legendStats.join(',') %>" data-unit="<%= p.config.unit || '' %>" data-decimals="<%= defaultPanelDecimals %>" data-scale="1" data-fill="<%= p.config.fill ? '1' : '' %>" data-stepped="<%= canvasStepped %>" data-tension="<%= p.config.curveTension != null ? p.config.curveTension : 0.15 %>" data-points="<%= p.config.points ? '1' : '' %>" data-animation="<%= p.config.animation ? '1' : '' %>" data-y-scale-type="<%= p.config.yScaleType || 'linear' %>" data-y-min="<%= p.config.yMin != null ? p.config.yMin : '' %>" data-y-max="<%= p.config.yMax != null ? p.config.yMax : '' %>" data-zoom="<%= p.config.zoom ? '1' : '' %>" data-thresholds="<%= JSON.stringify(p.config.thresholds || []) %>" data-annotations="<%= JSON.stringify(p.config.annotations || []) %>" data-series="<%= JSON.stringify(p.config.series || {}) %>"></canvas>
          </div>
        </div>
      <% } else if (p.panel_type === 'table') { %>
        <div class="panel-table-scroll">
          <table class="panel-table">
            <thead><tr><th>Timestamp</th><th>Value</th></tr></thead>
            <tbody>
              <% p.rows.forEach(r => { %>
                <tr><td><%= formatDateTime(r.recordedAt) %></td><td><span class="truncate" title="<%= r.displayValue %>" <% if (r.thresholdColor) { %>style="color: <%= r.thresholdColor %>; font-weight: 600;"<% } %>><%= r.displayValue %></span></td></tr>
              <% }) %>
              <% if (p.rows.length === 0) { %>
                <tr><td colspan="2" class="empty">No readings in this range yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      <% } else if (p.panel_type === 'gauge') { %>
        <%
          // Shared geometry for every gauge in this panel (shape/sweep/rotation depend only on the
          // panel's own config, not on any one monitor's reading). 'arc' sweeps 210°
          // (Grafana/Home-Assistant-style speedometer: "more than half round, not fully round")
          // with the gap centered at the bottom (6 o'clock); 'circle' sweeps the full 360° (no gap
          // at all, sweep===360 makes the trailing gap-length zero). rotation positions each
          // circle's own natural dash-start point (3 o'clock) at the sweep's low (min) end.
          //
          // Two concentric rings, not one: gaugeR (42) is the MAIN ring — plain track + either a
          // fill-to-current-value arc or a needle, colored by the CURRENT reading's own matched
          // threshold color. gaugeSectionR (48, thin, only drawn when Sections is on) sits just
          // OUTSIDE it showing the FULL threshold ladder as fixed colored bands, always fully
          // visible regardless of the current value — same "value ring colored by its own
          // threshold, thin ring around it showing where the thresholds actually are" split
          // Grafana's own gauge panel uses, rather than the bands replacing the value ring itself
          // (which hid the very thing coloring the value once the fill covered them).
          // gaugeR close to the original 42 (main ring's own stroke-width unchanged at 9) with the
          // thin section ring (stroke-width 3, ~1/3 of the main ring's own) sitting just outside
          // it — main ring's outer edge at 42.5, section ring's inner edge at 44.5, a modest ~2
          // unit gap so they read as two distinct rings without a wide empty gulf between them.
          const gaugeR = 38;
          const gaugeSectionR = 46;
          function circumference(r) { return 2 * Math.PI * r; }
          const gaugeSweep = p.config.shape === 'circle' ? 360 : 210;
          const gaugeRotation = 270 - gaugeSweep / 2;
          function arcLenFor(r) { return circumference(r) * gaugeSweep / 360; }
          const gaugeC = circumference(gaugeR);
          const gaugeArcLen = arcLenFor(gaugeR);

          // Hex-only color blend (named CSS colors / the implicit leading fill's own
          // var(--accent-soft) below just fall back to a hard step at the midpoint instead of a
          // blend — there's no way to resolve a CSS custom property's actual computed color from
          // here to interpolate it) — used to turn the hard edge between two adjacent thresholds
          // into a smooth gradient across several small sub-segments, same "Grafana threshold
          // gradient" look rather than a flat color swapping abruptly at the boundary.
          function hexToRgb(hex) {
            var m = /^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.exec(hex || '');
            if (!m) return null;
            var h = m[1].length === 3 ? m[1].split('').map(function (c) { return c + c; }).join('') : m[1];
            var num = parseInt(h, 16);
            return { r: (num >> 16) & 255, g: (num >> 8) & 255, b: num & 255 };
          }
          function blendColor(colorA, colorB, t) {
            var a = hexToRgb(colorA), b = hexToRgb(colorB);
            if (!a || !b) return t < 0.5 ? colorA : colorB;
            var r = Math.round(a.r + (b.r - a.r) * t);
            var g = Math.round(a.g + (b.g - a.g) * t);
            var bl = Math.round(a.b + (b.b - a.b) * t);
            return 'rgb(' + r + ',' + g + ',' + bl + ')';
          }
          // Threshold ladder -> a sorted list of {from, color} stops spanning [min,max] — shared
          // by both the radial section ring (gaugeSections, arcs) and the Bar style's own section
          // strip (barSectionsGradient, a flat CSS gradient) below, so the two styles' "Threshold
          // sections"/"Gradient sections" toggles mean exactly the same ladder either way. null
          // when Sections is off or there's no ladder to draw one from.
          function thresholdStops() {
            var min = p.config.min;
            if (!p.config.sections || p.config.max <= min || !p.config.thresholds || !p.config.thresholds.length) return null;
            var sorted = p.config.thresholds.slice().sort(function (a, b) { return a.value - b.value; });
            var stops = [];
            // A plain hex (not var(--accent-soft), which blendColor can't resolve/interpolate
            // against) for the "nothing defined yet" zone below the lowest threshold, but only
            // when Gradient is actually on — needed so it can blend smoothly INTO the first real
            // threshold color instead of a hard step there being the one exception to an otherwise
            // fully gradiented ring. Neutral enough to read reasonably on both themes; exact
            // theme-matching isn't possible from here anyway (a CSS custom property's actual
            // resolved value isn't known server-side). Plain bands (Gradient off) keep the
            // theme-aware var(--accent-soft) instead, same as before — there's no blend to need
            // a resolvable color for there.
            if (sorted[0].value > min) stops.push({ from: min, color: p.config.sectionsGradient ? '#8a93a6' : 'var(--accent-soft)' });
            sorted.forEach(function (t) { stops.push({ from: t.value, color: t.color }); });
            return stops;
          }
          const gaugeStops = thresholdStops();

          // Stops -> a list of colored sub-arcs for the thin outer section ring, subdivided into
          // GRADIENT_STEPS tiny segments per transition (blendColor above) rather than one flat-
          // colored band per rung, so it reads as a smooth gradient rather than a hard-edged
          // stripe. The FINAL rung (nothing above it to blend toward) stays one flat segment all
          // the way to max. GRADIENT_STEPS=1 collapses this back to plain hard-edged bands when
          // Gradient itself is off (Sections can be on independently of it).
          function gaugeSections() {
            if (!gaugeStops) return null;
            var min = p.config.min, max = p.config.max, range = max - min;
            var sectionArcLen = arcLenFor(gaugeSectionR);
            var sectionC = circumference(gaugeSectionR);
            var GRADIENT_STEPS = p.config.sectionsGradient ? 16 : 1;
            var bands = [];
            for (var i = 0; i < gaugeStops.length; i++) {
              var from = gaugeStops[i].from;
              var to = i + 1 < gaugeStops.length ? gaugeStops[i + 1].from : max;
              var fromPct = Math.min(100, Math.max(0, ((from - min) / range) * 100));
              var toPct = Math.min(100, Math.max(0, ((to - min) / range) * 100));
              if (toPct <= fromPct) continue;
              var hasNext = i + 1 < gaugeStops.length;
              var steps = hasNext ? GRADIENT_STEPS : 1;
              for (var s = 0; s < steps; s++) {
                var segFromPct = fromPct + (toPct - fromPct) * (s / steps);
                var segToPct = fromPct + (toPct - fromPct) * ((s + 1) / steps);
                var segColor = hasNext && steps > 1 ? blendColor(gaugeStops[i].color, gaugeStops[i + 1].color, (s + 0.5) / steps) : gaugeStops[i].color;
                var bandLen = sectionArcLen * (segToPct - segFromPct) / 100;
                bands.push({ color: segColor, dasharray: bandLen + ' ' + (sectionC - bandLen), rotate: gaugeSweep * (segFromPct / 100) });
              }
            }
            return bands;
          }
          const gaugeBands = gaugeSections();

          // Stops -> a plain CSS linear-gradient() string for the Bar style's own section strip —
          // CSS gradients already interpolate color between explicit stops on their own, so
          // Gradient here just means "omit the hard-stop pairs" rather than needing the manual
          // sub-segment subdivision the SVG arc technique above requires.
          function barSectionsGradient() {
            if (!gaugeStops) return null;
            var min = p.config.min, max = p.config.max, range = max - min;
            var parts = gaugeStops.map(function (s, i) {
              var pct = Math.min(100, Math.max(0, ((s.from - min) / range) * 100));
              if (p.config.sectionsGradient || i === 0) return s.color + ' ' + pct + '%';
              // Hard stop: repeat the previous color right up to this same position first, so the
              // swap happens instantly at pct rather than blending across the whole span before it.
              return gaugeStops[i - 1].color + ' ' + pct + '%, ' + s.color + ' ' + pct + '%';
            });
            return 'linear-gradient(to right, ' + parts.join(', ') + ')';
          }
          const barGradientCss = barSectionsGradient();

          // Needle angle (local, pre-rotation) — the CSS rotate() already applied to the whole
          // <svg> below carries this line to the correct world angle for free, same as the track.
          // Starts at NEEDLE_INNER_R, well clear of true center and the value text sitting there,
          // rather than the pivot the original design had right at (50,50) — that sat exactly
          // where the value text is also centered, so toggling Needle on/off shifted the value
          // text between two different vertical positions to dodge it. No separate pivot dot
          // either any more — just the one line, still reading as "pointing out from the middle"
          // by its own direction even though the visible segment itself starts a bit short of true
          // center. Reaches out to just past the (thin) section ring, same "needle spans most of
          // the dial" look a real speedometer has, rather than stopping short at the main ring's
          // own edge.
          const NEEDLE_INNER_R = 24;
          function needleLine(percent) {
            var localDeg = percent === null ? 0 : gaugeSweep * (percent / 100);
            var rad = localDeg * Math.PI / 180;
            var rOuter = gaugeSectionR - 2;
            return {
              x1: 50 + NEEDLE_INNER_R * Math.cos(rad), y1: 50 + NEEDLE_INNER_R * Math.sin(rad),
              x2: 50 + rOuter * Math.cos(rad), y2: 50 + rOuter * Math.sin(rad),
            };
          }

          // Where the ring's own two ends actually are (percent position within the square
          // .gauge-radial-outer box) — an open arc's min/max labels anchor right there instead of
          // centered below the whole item, which for a 210°-sweep arc left a big gap between the
          // ring's own visible end (well above the box's bottom edge, since the arc doesn't fill
          // the bottom of its own bounding square) and the label. Meaningless for a full circle
          // (sweep 360 — both ends are the same point), which keeps the old centered "min–max"
          // text below instead (see the render loop).
          function endpointPct(localDeg) {
            var worldRad = (localDeg + gaugeRotation) * Math.PI / 180;
            var r = gaugeSectionR + 7;
            return { left: 50 + r * Math.cos(worldRad), top: 50 + r * Math.sin(worldRad) };
          }
          const gaugeMinPoint = endpointPct(0);
          const gaugeMaxPoint = endpointPct(gaugeSweep);

          // A monitor's own recent-history sample (see loadPanelsWithMonitors), already normalized
          // 0-1 — turned into a flat SVG polyline "points" string in a small fixed 100x26 box.
          function sparklinePoints(values) {
            if (!values || values.length < 2) return null;
            var w = 100, h = 26, pad = 2;
            return values.map(function (v, i) {
              var x = (i / (values.length - 1)) * w;
              var y = pad + (1 - v) * (h - pad * 2);
              return x.toFixed(1) + ',' + y.toFixed(1);
            }).join(' ');
          }
        %>
        <% if (p.config.style === 'radial') { %>
          <div class="gauge-radial-wrap" data-live-id="panel-<%= p.id %>-body">
            <% p.gauges.forEach(function (g) { %>
              <%
                var fillLen = g.percent === null ? 0 : gaugeArcLen * (g.percent / 100);
                var needle = needleLine(g.percent);
              %>
              <div class="gauge-radial-item">
                <div class="gauge-radial-outer">
                  <svg class="gauge-radial" viewBox="0 0 100 100" style="transform: rotate(<%= gaugeRotation %>deg);">
                    <% if (gaugeBands) { %>
                      <% gaugeBands.forEach(function (b) { %>
                        <circle class="gauge-radial-section" cx="50" cy="50" r="<%= gaugeSectionR %>" transform="rotate(<%= b.rotate %> 50 50)" style="stroke-dasharray: <%= b.dasharray %>; stroke: <%= b.color %>;"></circle>
                      <% }) %>
                    <% } %>
                    <circle class="gauge-radial-track" cx="50" cy="50" r="<%= gaugeR %>" style="stroke-dasharray: <%= gaugeArcLen %> <%= gaugeC - gaugeArcLen %>;"></circle>
                    <% if (p.config.needle) { %>
                      <line class="gauge-radial-needle" x1="<%= needle.x1 %>" y1="<%= needle.y1 %>" x2="<%= needle.x2 %>" y2="<%= needle.y2 %>"></line>
                    <% } else { %>
                      <circle class="gauge-radial-fill" cx="50" cy="50" r="<%= gaugeR %>"
                        style="stroke-dasharray: <%= fillLen %> <%= gaugeC - fillLen %>; <% if (g.thresholdColor) { %>stroke: <%= g.thresholdColor %>;<% } %>"></circle>
                    <% } %>
                  </svg>
                  <div class="gauge-radial-value" <% if (g.thresholdColor) { %>style="color: <%= g.thresholdColor %>;"<% } %>>
                    <div class="gauge-radial-value-text"><%= g.current ? g.current.displayValue : '-' %><%= p.config.unit ? ' ' + p.config.unit : '' %></div>
                    <%
                      // Always reserves the sparkline's own slot (via visibility, not display/
                      // presence) rather than only rendering it when actually enabled+has data —
                      // a flex column centered with justify-content:center re-centers around
                      // however many children it actually has, so the value text itself shifted
                      // position depending on whether this one extra child was there at all.
                      var sparkPts = p.config.sparkline ? sparklinePoints(g.sparkline) : null;
                    %>
                    <svg class="gauge-radial-sparkline<%= p.config.sparklineColor === 'default' ? ' gauge-radial-sparkline-neutral' : '' %>" viewBox="0 0 100 26" preserveAspectRatio="none" <% if (!sparkPts) { %>style="visibility:hidden;"<% } %>>
                      <polyline points="<%= sparkPts || '0,13 100,13' %>"></polyline>
                    </svg>
                  </div>
                  <% if (p.config.shape !== 'circle') { %>
                    <span class="gauge-radial-min hint" style="left: <%= gaugeMinPoint.left %>%; top: <%= gaugeMinPoint.top %>%;"><%= p.config.min %><%= p.config.unit ? ' ' + p.config.unit : '' %></span>
                    <span class="gauge-radial-max hint" style="left: <%= gaugeMaxPoint.left %>%; top: <%= gaugeMaxPoint.top %>%;"><%= p.config.max %><%= p.config.unit ? ' ' + p.config.unit : '' %></span>
                  <% } %>
                </div>
                <% if (p.gauges.length > 1) { %><div class="gauge-radial-label truncate" title="<%= g.monitor.label %>"><%= g.monitor.label %></div><% } %>
                <% if (p.config.shape === 'circle') { %>
                  <div class="gauge-radial-minmax hint">
                    <span><%= p.config.min %><%= p.config.unit ? ' ' + p.config.unit : '' %></span>
                    <span><%= p.config.max %><%= p.config.unit ? ' ' + p.config.unit : '' %></span>
                  </div>
                <% } %>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="gauge-wrap" data-live-id="panel-<%= p.id %>-body">
            <% p.gauges.forEach(function (g) { %>
              <div class="gauge-bar-item">
                <% if (p.gauges.length > 1) { %><div class="gauge-bar-label truncate" title="<%= g.monitor.label %>"><%= g.monitor.label %></div><% } %>
                <div class="gauge-track"><div class="gauge-fill" style="width: <%= g.percent === null ? 0 : g.percent %>%; <% if (g.thresholdColor) { %>background: <%= g.thresholdColor %>;<% } %>"></div></div>
                <% if (barGradientCss) { %><div class="gauge-bar-sections" style="background: <%= barGradientCss %>;"></div><% } %>
                <div class="gauge-value" <% if (g.thresholdColor) { %>style="color: <%= g.thresholdColor %>;"<% } %>><%= g.current ? g.current.displayValue : '-' %><%= p.config.unit ? ' ' + p.config.unit : '' %></div>
                <div class="hint" style="margin:0;"><%= p.config.min %>&ndash;<%= p.config.max %><%= p.config.unit ? ' ' + p.config.unit : '' %></div>
              </div>
            <% }) %>
          </div>
        <% } %>
      <% } else if (p.panel_type === 'stat_delta') { %>
        <% const RANGE_LABELS = { '1h': '1 hour', '24h': '24 hours', '7d': '7 days', '30d': '30 days', all: 'the start' };
           let deltaClass = 'neutral';
           if (p.delta !== null && p.delta !== 0 && p.config.direction !== 'neutral') {
             const isUp = p.delta > 0;
             const good = (p.config.direction === 'up_good' && isUp) || (p.config.direction === 'down_good' && !isUp);
             deltaClass = good ? 'good' : 'bad';
           }
        %>
        <div class="stat-delta" data-live-id="panel-<%= p.id %>-body">
          <div class="stat-delta-value" <% if (p.thresholdColor) { %>style="color: <%= p.thresholdColor %>;"<% } %>><%= p.current ? p.current.displayValue : '-' %><%= p.config.unit ? ' ' + p.config.unit : '' %></div>
          <% if (p.delta === null) { %>
            <p class="hint" style="margin:0;">No comparison reading yet.</p>
          <% } else { %>
            <div class="stat-delta-change <%= deltaClass %>">
              <%- p.delta > 0 ? '&#9650;' : (p.delta < 0 ? '&#9660;' : '&#8212;') %> <%= p.displayDelta %><%= p.config.unit ? ' ' + p.config.unit : '' %>
            </div>
            <p class="hint" style="margin:0;">vs <%= RANGE_LABELS[p.displayRange || p.range] || p.displayRange || p.range %> ago</p>
          <% } %>
        </div>
      <% } else if (p.panel_type === 'threshold') { %>
        <div class="threshold-wrap" data-live-id="panel-<%= p.id %>-body">
          <div class="gauge-value"><%= p.current ? p.current.displayValue : '-' %><%= p.config.unit ? ' ' + p.config.unit : '' %></div>
          <span class="badge <%= p.isAlert ? 'badge-off' : 'badge-ok' %>"><%= p.isAlert ? p.config.labelAlert : p.config.labelOk %></span>
        </div>
      <% } else if (p.panel_type === 'state_bar') { %>
        <%
          var stateBarTotalMs = p.rangeEndMs - p.rangeStartMs;
          function stateBarPct(ms) { return stateBarTotalMs > 0 ? ((ms - p.rangeStartMs) / stateBarTotalMs) * 100 : 0; }
        %>
        <div class="state-bar-panel" data-live-id="panel-<%= p.id %>-body">
          <% p.bars.forEach(function (bar) { %>
            <div class="state-bar-row">
              <% if (p.bars.length > 1) { %><div class="state-bar-label truncate" title="<%= bar.monitor.label %>"><%= bar.monitor.label %></div><% } %>
              <div class="state-bar-track">
                <% if (bar.segments.length === 0) { %>
                  <div class="state-bar-segment state-bar-segment-nodata" style="left:0; width:100%;" title="No data in this range"></div>
                <% } else { %>
                  <% bar.segments.forEach(function (seg) { %>
                    <%
                      var segLeft = stateBarPct(seg.startMs);
                      var segWidth = Math.max(stateBarPct(seg.endMs) - segLeft, 0.2);
                    %>
                    <div class="state-bar-segment<%= seg.noData ? ' state-bar-segment-nodata' : '' %>" style="left: <%= segLeft %>%; width: <%= segWidth %>%; background: <%= seg.color %>;" title="<%= seg.label %> — <%= formatDateTime(seg.startMs) %> to <%= formatDateTime(seg.endMs) %>">
                      <span class="state-bar-segment-label"><%= seg.label %></span>
                    </div>
                  <% }) %>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
        <div class="gauge-radial-minmax hint" style="margin-top:0.3rem;">
          <span><%= formatDateTime(p.rangeStartMs) %></span>
          <span><%= formatDateTime(p.rangeEndMs) %></span>
        </div>
      <% } else { %>
        <div class="panel-value-list" data-layout="<%= p.config.layout === 'row' ? 'row' : 'stacked' %>" data-live-id="panel-<%= p.id %>-body">
          <% p.monitors.forEach(m => { %>
            <div class="panel-value-row">
              <div class="label">
                <%= m.displayLabel %>
                <% if (m.miniserver_name) { %><span class="hint" style="margin:0;">(<%= m.miniserver_name %>)</span><% } %>
              </div>
              <div class="value" <% if (m.current && m.current.thresholdColor) { %>style="color: <%= m.current.thresholdColor %>;"<% } %>>
                <%= m.current ? m.current.displayValue : '-' %><% if (m.current && !m.current.isLabel && m.effectiveUnit) { %> <%= m.effectiveUnit %><% } %>
                <span class="hint" style="margin:0; display:block; font-size:0.72rem;">
                  <%= m.current ? formatDateTime(m.current.recordedAt) : '' %>
                </span>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
    <% if (!isGroupHeader) { %>
      </div>
    </div>
    <% } else { %>
      <% dashZoneIndex += 1; %>
      <div class="grid-stack" id="dash-grid-zone-<%= dashZoneIndex %>" data-group-id="<%= p.id %>">
    <% } %>
  <% }) %>
  </div>
  <% if (hasOpenGroupUnit) { %></div></div><% } %>
  <% if (panels.length === 0) { %>
    <p class="hint">No panels yet<% if (canEditPanels) { %> &mdash; add one above<% } %>.</p>
  <% } %>
</div>

<script>
  // Upgrades every plain server-rendered <input type="color" class="single-color-input"> (a
  // one-off field like State bar's "Default color", not a repeatable row — those already build
  // their own picker markup entirely client-side, see chart-series-rows/threshold-builder-rows
  // etc.) to the same custom swatch-plus-popover LoxColorPicker.buildPickerHtml() gives every other
  // color field in this app, rather than the browser's own bare rectangular <input type="color">.
  // The hidden value input inherits the original's `name` so form submission needs no other change.
  (function () {
    document.querySelectorAll('input.single-color-input[type="color"]').forEach(function (input) {
      var temp = document.createElement('div');
      temp.innerHTML = LoxColorPicker.buildPickerHtml(input.value, 'single-color-value');
      var wrap = temp.firstElementChild;
      wrap.querySelector('.color-picker-value').name = input.name;
      input.replaceWith(wrap);
    });
  })();
</script>

<script>
  // "Add panel" button toggles the card below it — a plain show/hide rather than a <details>
  // disclosure (every other "Add X" form in the app still uses that), so it can sit as a normal
  // button alongside Add group/Auto order in one row instead of a <summary> line of its own.
  (function () {
    var btn = document.getElementById('dash-add-panel-btn');
    var card = document.getElementById('dash-add-panel-card');
    if (!btn || !card) return;
    btn.addEventListener('click', function () { card.hidden = !card.hidden; });
  })();
</script>

<script>
  (function () {
    var panelTypeSelect = document.getElementById('panel-type-select');
    if (!panelTypeSelect) return; // add-panel form isn't rendered for view-only users

    var rangeField = document.getElementById('panel-range-field');
    var tableHint = document.getElementById('table-monitor-hint');
    var chartFields = document.getElementById('chart-fields');
    var valueLayoutField = document.getElementById('value-layout-field');
    var tableFields = document.getElementById('table-fields');
    var gaugeFields = document.getElementById('gauge-fields');
    var statDeltaFields = document.getElementById('stat-delta-fields');
    var thresholdFields = document.getElementById('threshold-fields');
    var stateBarFields = document.getElementById('state-bar-fields');
    var chartSeriesSettings = document.getElementById('chart-series-settings');
    var valueSeriesSettings = document.getElementById('value-series-settings');
    var chartTypeSelect = document.getElementById('chart-type-select');
    var gaugeStyleSelect = document.getElementById('gauge-style-select');
    var monitorsSection = document.getElementById('monitors-section');
    var SINGLE_MONITOR_TYPES = ['table', 'stat_delta', 'threshold'];
    // group_header isn't a selectable option on this form any more (see #dash-add-panel-btn's own
    // "Add group" button, right next to this one, which creates it directly) — this select's own
    // options never produce that value, so NO_RANGE_TYPES/NO_MONITOR_TYPES have no reason to
    // mention it any more either.
    var NO_RANGE_TYPES = ['value', 'gauge', 'threshold'];

    function syncPanelType() {
      var type = panelTypeSelect.value;
      rangeField.style.display = NO_RANGE_TYPES.indexOf(type) !== -1 ? 'none' : '';
      monitorsSection.style.display = '';
      tableHint.style.display = SINGLE_MONITOR_TYPES.indexOf(type) !== -1 ? '' : 'none';
      chartFields.style.display = type === 'chart' ? '' : 'none';
      valueLayoutField.style.display = type === 'value' ? '' : 'none';
      tableFields.style.display = type === 'table' ? '' : 'none';
      gaugeFields.style.display = type === 'gauge' ? '' : 'none';
      statDeltaFields.style.display = type === 'stat_delta' ? '' : 'none';
      thresholdFields.style.display = type === 'threshold' ? '' : 'none';
      stateBarFields.style.display = type === 'state_bar' ? '' : 'none';
      chartSeriesSettings.style.display = type === 'chart' ? '' : 'none';
      valueSeriesSettings.style.display = type === 'value' ? '' : 'none';
    }
    panelTypeSelect.addEventListener('change', syncPanelType);

    // Sub-toggle within gauge-fields itself — Shape/Sections/Needle only mean anything for the
    // 'radial' style (a Bar has no ring to shape/band/point a needle around). Same independent-
    // of-syncPanelType() shape as syncChartType() just below: #gauge-fields already goes
    // display:none as a whole when panel_type isn't 'gauge', this only worries about its own style.
    var gaugeSectionsInput = gaugeFields.querySelector('input[name="gauge_sections"]');
    var gaugeSparklineInput = gaugeFields.querySelector('input[name="gauge_sparkline"]');
    function syncGaugeStyle() {
      var style = gaugeStyleSelect.value;
      gaugeFields.querySelectorAll('[data-gauge-style-for], [data-gauge-sections-for], [data-gauge-sparkline-for]').forEach(function (el) {
        var visible = true;
        var styleFor = el.getAttribute('data-gauge-style-for');
        if (styleFor) visible = styleFor.split(',').indexOf(style) !== -1;
        // Two more sub-toggles nested within this same group: Gradient sections only means
        // anything once Threshold sections is actually on, and Neutral trend line color only
        // means anything once the trend line itself is showing at all.
        if (visible && el.hasAttribute('data-gauge-sections-for')) visible = gaugeSectionsInput.checked;
        if (visible && el.hasAttribute('data-gauge-sparkline-for')) visible = gaugeSparklineInput.checked;
        el.style.display = visible ? '' : 'none';
      });
    }
    gaugeStyleSelect.addEventListener('change', syncGaugeStyle);
    gaugeSectionsInput.addEventListener('change', syncGaugeStyle);
    gaugeSparklineInput.addEventListener('change', syncGaugeStyle);
    syncGaugeStyle();
    syncPanelType();

    // Sub-toggle within chart-fields itself — line-only sections (Y-axis, zoom, thresholds,
    // annotations, stepped/curve/points/fill) hide when a snapshot chart type is picked. Independent
    // of syncPanelType() above: #chart-fields already goes display:none as a whole when panel_type
    // isn't 'chart', so this only ever needs to worry about the chart_type axis on its own.
    var legendSelect = document.getElementById('legend-position-select');
    function syncChartType() {
      var chartType = chartTypeSelect.value;
      var legendOn = !legendSelect || legendSelect.value !== 'off';
      chartFields.querySelectorAll('[data-chart-type-for]').forEach(function (el) {
        var types = el.getAttribute('data-chart-type-for').split(',');
        var visible = types.indexOf(chartType) !== -1;
        // The min/max/avg/current legend toggles are meaningless with no legend to show them in
        // — data-legend-for="on" hides them the same way data-chart-type-for already hides every
        // other line-only field for a snapshot chart type.
        if (visible && el.hasAttribute('data-legend-for')) visible = legendOn;
        el.style.display = visible ? '' : 'none';
      });
    }
    chartTypeSelect.addEventListener('change', syncChartType);
    if (legendSelect) legendSelect.addEventListener('change', syncChartType);
    syncChartType();

    var filterInput = document.getElementById('monitor-filter');
    filterInput.addEventListener('input', function () {
      var q = filterInput.value.toLowerCase();
      document.querySelectorAll('.monitor-check-row').forEach(function (row) {
        row.style.display = row.dataset.label.indexOf(q) !== -1 ? '' : 'none';
      });
    });
  })();
</script>

<script>
  // Per-panel "Edit panel" popovers (see .panel-settings-form above) — one of these exists per
  // panel on the page, so unlike the single Add-panel form above, fields are toggled by walking
  // up to the closest form rather than by a page-wide element id.
  (function () {
    document.querySelectorAll('.panel-settings-form .panel-type-select').forEach(function (select) {
      var form = select.closest('form');
      // A field can carry data-fields-for, data-chart-type-for, or both (e.g. the Y-axis section —
      // chart-only AND line-only) — both must pass for it to show, so this walks the union of
      // matches once and ANDs the two checks, rather than two independent passes that would each
      // blindly overwrite the other's display verdict.
      var chartTypeSelect = form.querySelector('.chart-type-select');
      var gaugeStyleSelect = form.querySelector('.gauge-style-select');
      var gaugeSectionsInput = form.querySelector('input[name="gauge_sections"]');
      var gaugeSparklineInput = form.querySelector('input[name="gauge_sparkline"]');
      var legendSelect = form.querySelector('.legend-position-select');

      function sync() {
        var type = select.value;
        var chartType = chartTypeSelect ? chartTypeSelect.value : 'line';
        var gaugeStyle = gaugeStyleSelect ? gaugeStyleSelect.value : 'bar';
        var legendOn = !legendSelect || legendSelect.value !== 'off';
        form.querySelectorAll('[data-fields-for], [data-chart-type-for], [data-gauge-style-for], [data-gauge-sections-for], [data-gauge-sparkline-for], [data-legend-for]').forEach(function (el) {
          var visible = true;
          var fieldsFor = el.getAttribute('data-fields-for');
          if (fieldsFor) visible = fieldsFor.split(',').indexOf(type) !== -1;
          var chartTypeFor = el.getAttribute('data-chart-type-for');
          if (visible && chartTypeFor) visible = type === 'chart' && chartTypeFor.split(',').indexOf(chartType) !== -1;
          var gaugeStyleFor = el.getAttribute('data-gauge-style-for');
          if (visible && gaugeStyleFor) visible = type === 'gauge' && gaugeStyleFor.split(',').indexOf(gaugeStyle) !== -1;
          // Same two nested sub-toggles as the Add-panel form's own syncGaugeStyle() above.
          if (visible && el.hasAttribute('data-gauge-sections-for')) visible = type === 'gauge' && !!(gaugeSectionsInput && gaugeSectionsInput.checked);
          if (visible && el.hasAttribute('data-gauge-sparkline-for')) visible = type === 'gauge' && !!(gaugeSparklineInput && gaugeSparklineInput.checked);
          // Min/max/avg/current legend toggles: meaningless with no legend to show them in.
          if (visible && el.hasAttribute('data-legend-for')) visible = legendOn;
          el.style.display = visible ? '' : 'none';
        });
      }
      select.addEventListener('change', sync);
      if (chartTypeSelect) chartTypeSelect.addEventListener('change', sync);
      if (gaugeStyleSelect) gaugeStyleSelect.addEventListener('change', sync);
      if (gaugeSectionsInput) gaugeSectionsInput.addEventListener('change', sync);
      if (gaugeSparklineInput) gaugeSparklineInput.addEventListener('change', sync);
      if (legendSelect) legendSelect.addEventListener('change', sync);
      sync();
    });

    document.querySelectorAll('.panel-monitor-filter').forEach(function (filterInput) {
      var form = filterInput.closest('form');
      filterInput.addEventListener('input', function () {
        var q = filterInput.value.toLowerCase();
        form.querySelectorAll('.panel-monitor-check-row').forEach(function (row) {
          row.style.display = row.dataset.label.indexOf(q) !== -1 ? '' : 'none';
        });
      });
    });
  })();
</script>

<!-- .range-select's own sync behavior now lives in public/range-picker.js, loaded sitewide via
     partials/foot.ejs — shared with Monitor detail/Home/Logs, all of which render the same
     rangeField() markup. -->

<!-- SortableJS (vendor/sortable.min.js) — powers threshold-annotation-builder.js's own row
     drag-to-reorder for the plain threshold/annotation/value-mapping row lists (see that file's
     own top comment); loaded here, right before its one consumer, same convention as
     color-picker.js above. -->
<script src="/vendor/sortable.min.js"></script>
<script src="/threshold-annotation-builder.js"></script>

<%
  // .value-mapping-builder's own JS wiring moved to partials/foot.ejs (shared with the Monitor
  // detail page, once its own chart settings became a second consumer of valueMappingField) —
  // same reasoning as .unit-select/.scale-select above.
%>

<script>
  // Drives every .chart-series-settings (Add-panel's and each panel's own Edit form both have
  // one) — builds one row per currently-checked monitor in that SAME form's monitor checklist
  // (found via the container's own data-checklist-selector, since the two forms use different
  // checklist markup), keeping a hidden JSON textarea (dashboards.js's parseSeriesConfig format)
  // in sync as rows are added, removed (by unchecking that monitor), or edited.
  (function () {
    // Same preset list as the panel-wide unit fields (see UNIT_PRESETS/unitField() above) — kept
    // as its own small copy here rather than sharing that server-side const, since these rows are
    // built entirely client-side (one per checked monitor, added/removed as checkboxes toggle).
    var UNIT_PRESETS = ['°C', '°F', '%', 'W', 'kW', 'kWh', 'V', 'A', 'Hz', 'hPa', 'lux', 'ppm', 'bar', 'm³', 'dB'];

    function buildUnitPicker(currentValue) {
      var wrap = document.createElement('span');
      wrap.className = 'chart-series-row-unit-wrap';
      var isCustom = !!currentValue && UNIT_PRESETS.indexOf(currentValue) === -1;
      var select = document.createElement('select');
      select.className = 'chart-series-row-unit-select';
      var noneOpt = document.createElement('option');
      noneOpt.value = '';
      noneOpt.textContent = '(none)';
      select.appendChild(noneOpt);
      UNIT_PRESETS.forEach(function (u) {
        var opt = document.createElement('option');
        opt.value = u;
        opt.textContent = u;
        if (currentValue === u) opt.selected = true;
        select.appendChild(opt);
      });
      var customOpt = document.createElement('option');
      customOpt.value = '__custom__';
      customOpt.textContent = 'Custom…';
      if (isCustom) customOpt.selected = true;
      select.appendChild(customOpt);

      var input = document.createElement('input');
      input.type = 'text';
      input.className = 'chart-series-row-unit-custom';
      input.placeholder = 'Unit';
      input.value = isCustom ? currentValue : '';
      input.style.display = isCustom ? '' : 'none';

      select.addEventListener('change', function () {
        input.style.display = select.value === '__custom__' ? '' : 'none';
        if (select.value === '__custom__') input.focus();
      });

      wrap.appendChild(select);
      wrap.appendChild(input);
      return wrap;
    }

    // The effective unit value is whichever of select/input currently "owns" it — mirrors
    // .unit-select's own select-or-custom-input convention above, just read directly instead of
    // toggling a shared `name` attribute (these rows submit as one JSON blob, not individual
    // fields, so there's no name-collision to avoid here).
    function unitPickerValue(wrap) {
      var select = wrap.querySelector('.chart-series-row-unit-select');
      var input = wrap.querySelector('.chart-series-row-unit-custom');
      return select.value === '__custom__' ? input.value.trim() : select.value;
    }

    // Same select-or-custom-input shape as buildUnitPicker just above — a bare number input made
    // "×0.001 for Wh → kWh" something you had to already know to type correctly, where a preset
    // list gets you there by picking the unit conversion you actually want.
    var SCALE_PRESETS = [0.001, 0.01, 0.1, 1, 10, 100, 1000];
    function buildScalePicker(currentValue) {
      var wrap = document.createElement('span');
      wrap.className = 'chart-series-row-scale-wrap';
      var value = currentValue == null || currentValue === '' ? 1 : Number(currentValue);
      var isCustom = SCALE_PRESETS.indexOf(value) === -1;
      var select = document.createElement('select');
      select.className = 'chart-series-row-scale-select';
      SCALE_PRESETS.forEach(function (s) {
        var opt = document.createElement('option');
        opt.value = s;
        opt.textContent = s === 1 ? '×1 (none)' : '×' + s;
        if (value === s) opt.selected = true;
        select.appendChild(opt);
      });
      var customOpt = document.createElement('option');
      customOpt.value = '__custom__';
      customOpt.textContent = 'Custom…';
      if (isCustom) customOpt.selected = true;
      select.appendChild(customOpt);

      var input = document.createElement('input');
      input.type = 'number';
      input.step = 'any';
      input.className = 'chart-series-row-scale-custom';
      input.placeholder = 'Scale';
      input.value = isCustom ? value : '';
      input.style.display = isCustom ? '' : 'none';

      select.addEventListener('change', function () {
        input.style.display = select.value === '__custom__' ? '' : 'none';
        if (select.value === '__custom__') input.focus();
      });

      wrap.appendChild(select);
      wrap.appendChild(input);
      return wrap;
    }

    function scalePickerValue(wrap) {
      var select = wrap.querySelector('.chart-series-row-scale-select');
      var input = wrap.querySelector('.chart-series-row-scale-custom');
      var raw = select.value === '__custom__' ? input.value : select.value;
      var n = Number(raw);
      return Number.isFinite(n) && n !== 0 ? n : null;
    }

    function buildRow(monitorId, monitorLabel, override, usedColors, chartType) {
      var row = document.createElement('div');
      row.className = 'chart-series-row';
      row.dataset.monitorId = monitorId;
      row.innerHTML =
        '<span class="chart-series-row-label"></span>' +
        '<input type="text" class="chart-series-row-name" placeholder="Name">' +
        '<span class="chart-series-row-unit-slot"></span>' +
        '<span class="chart-series-row-scale-slot"></span>' +
        '<input type="number" class="chart-series-row-decimals" placeholder="Dec." min="0" max="6" step="1" title="Decimals for this series\' tooltip — blank uses the panel\'s own Decimals setting">' +
        '<select class="chart-series-row-axis" title="Which Y-axis this series is plotted against"><option value="left">Left axis</option><option value="right">Right axis</option></select>' +
        '<select class="chart-series-row-style" title="Line style — blank uses a plain solid line">' +
          '<option value="">Solid</option>' +
          '<option value="solid-thick">Solid (thick)</option>' +
          '<option value="dashed">Dashed</option>' +
          '<option value="dotted">Dotted</option>' +
        '</select>' +
        '<select class="chart-series-row-point-style" title="Point marker shape — only visible when Show points is on">' +
          '<option value="">Circle</option>' +
          '<option value="cross">Cross</option>' +
          '<option value="rect">Square</option>' +
          '<option value="rectRot">Diamond</option>' +
          '<option value="star">Star</option>' +
          '<option value="triangle">Triangle</option>' +
        '</select>' +
        '<input type="checkbox" class="chart-series-row-color-enabled" title="Give this series its own color">' +
        LoxColorPicker.buildPickerHtml((override && override.color) || LoxColorPicker.nextAvailableColor(usedColors), 'chart-series-row-color', 'chart-series-row-color-wrap');
      row.querySelector('.chart-series-row-label').textContent = monitorLabel;
      row.querySelector('.chart-series-row-label').title = monitorLabel;
      row.querySelector('.chart-series-row-name').value = (override && override.name) || '';
      row.querySelector('.chart-series-row-decimals').value = (override && override.decimals != null) ? override.decimals : '';
      row.querySelector('.chart-series-row-axis').value = (override && override.axis === 'right') ? 'right' : 'left';
      row.querySelector('.chart-series-row-style').value = (override && override.style) || '';
      row.querySelector('.chart-series-row-point-style').value = (override && override.pointStyle) || '';

      // Axis/line-style/point-style are meaningless off the 'line' geometry (no time axis to split
      // left/right, no line to dash, no point to shape) — name/unit/scale/decimals/color stay
      // meaningful for every chart type, so only these three hide.
      if (chartType && chartType !== 'line') {
        row.querySelector('.chart-series-row-axis').style.display = 'none';
        row.querySelector('.chart-series-row-style').style.display = 'none';
        row.querySelector('.chart-series-row-point-style').style.display = 'none';
      }

      var unitPicker = buildUnitPicker((override && override.unit) || '');
      row.querySelector('.chart-series-row-unit-slot').replaceWith(unitPicker);
      var scalePicker = buildScalePicker(override && override.scale);
      row.querySelector('.chart-series-row-scale-slot').replaceWith(scalePicker);

      var colorValue = override && override.color;
      var colorEnabled = !!colorValue;
      row.querySelector('.chart-series-row-color-enabled').checked = colorEnabled;
      // .is-disabled dims the swatch rather than hiding it outright — see that class in style.css
      // for why: its circular border stayed the row's only visual hint a color picker lives there
      // at all, so hiding the whole element along with the fill left a blank gap in its place.
      LoxColorPicker.setSwatchDisabled(row.querySelector('.chart-series-row-color-wrap'), !colorEnabled);
      row.querySelector('.chart-series-row-color-enabled').addEventListener('change', function (e) {
        LoxColorPicker.setSwatchDisabled(row.querySelector('.chart-series-row-color-wrap'), !e.target.checked);
      });

      return row;
    }

    document.querySelectorAll('.chart-series-settings').forEach(function (container) {
      var form = container.closest('form');
      var checklist = form.querySelector(container.dataset.checklistSelector);
      if (!checklist) return;
      var chartTypeSelect = form.querySelector('.chart-type-select');
      var hidden = container.querySelector('.chart-series-hidden');
      var rowsEl = container.querySelector('.chart-series-rows');
      var cache = {};
      try { cache = JSON.parse(hidden.value || '{}'); } catch (e) { /* malformed — start empty */ }

      function serialize() {
        var out = {};
        rowsEl.querySelectorAll('.chart-series-row').forEach(function (row) {
          var id = row.dataset.monitorId;
          var name = row.querySelector('.chart-series-row-name').value.trim();
          var unit = unitPickerValue(row.querySelector('.chart-series-row-unit-wrap'));
          var scale = scalePickerValue(row.querySelector('.chart-series-row-scale-wrap'));
          var decimalsRaw = row.querySelector('.chart-series-row-decimals').value.trim();
          var decimals = decimalsRaw === '' ? null : Number(decimalsRaw);
          if (!Number.isFinite(decimals)) decimals = null;
          var axis = row.querySelector('.chart-series-row-axis').value;
          var style = row.querySelector('.chart-series-row-style').value;
          var pointStyle = row.querySelector('.chart-series-row-point-style').value;
          var hasColor = row.querySelector('.chart-series-row-color-enabled').checked;
          var color = hasColor ? row.querySelector('.chart-series-row-color').value : null;
          var entry = { name: name || null, unit: unit || null, scale: scale === 1 ? null : scale, decimals: decimals, axis: axis, color: color, style: style || null, pointStyle: pointStyle || null };
          // Kept in the in-memory cache (not just `out`) even when blank, so unchecking a monitor
          // and re-checking it later in the same session still shows whatever was last entered —
          // only what actually has a real value ends up in the submitted `out`.
          cache[id] = entry;
          if (name || unit || entry.scale != null || decimals != null || axis === 'right' || color || style) out[id] = entry;
        });
        hidden.value = JSON.stringify(out);
      }

      function rebuildRows() {
        var checked = Array.prototype.slice.call(checklist.querySelectorAll('input[type="checkbox"]:checked'));
        rowsEl.innerHTML = '';
        // Accumulated across the loop (not per-row) so each new row's default avoids every color
        // already resolved so far in this same pass — an existing saved override counts as "used"
        // here too, so a freshly-added row can't coincidentally match one already set explicitly.
        var usedColors = [];
        checked.forEach(function (checkbox) {
          var id = checkbox.value;
          var labelEl = checkbox.closest('label');
          // Strips a trailing " (mqtt)"/" (loxone)" source-type suffix (see the Add-panel
          // checklist's own markup above) — the Edit form's compact checklist has no such suffix
          // to begin with, so this simply doesn't match anything there.
          var monitorLabel = labelEl ? labelEl.textContent.trim().replace(/\s*\([a-z_]+\)\s*$/i, '') : id;
          var row = buildRow(id, monitorLabel, cache[id], usedColors, chartTypeSelect ? chartTypeSelect.value : 'line');
          usedColors.push(row.querySelector('.chart-series-row-color').value);
          Array.prototype.forEach.call(row.querySelectorAll('input, select'), function (el) {
            el.addEventListener('input', serialize);
            el.addEventListener('change', serialize);
          });
          rowsEl.appendChild(row);
        });
        serialize();
      }

      checklist.addEventListener('change', function (e) {
        if (e.target.matches('input[type="checkbox"]')) rebuildRows();
      });
      // Switching chart type live re-renders every row so axis/style/point-style show or hide
      // immediately, without waiting for a monitor to be re-checked.
      if (chartTypeSelect) chartTypeSelect.addEventListener('change', rebuildRows);
      rebuildRows();
    });

    // A "Current value" panel's per-monitor rename + unit override — same checked-monitor-driven
    // row builder as .chart-series-settings just above (reusing its buildUnitPicker/unitPickerValue
    // helpers directly, since neither cares which panel type it's called from), minus the
    // chart-only axis/color fields a value panel has no use for.
    function buildValueSeriesRow(monitorId, monitorLabel, override) {
      var row = document.createElement('div');
      row.className = 'chart-series-row value-series-row';
      row.dataset.monitorId = monitorId;
      row.innerHTML =
        '<span class="chart-series-row-label"></span>' +
        '<input type="text" class="chart-series-row-name" placeholder="Name">' +
        '<span class="chart-series-row-unit-slot"></span>' +
        '<span class="chart-series-row-scale-slot"></span>' +
        '<input type="number" class="value-series-row-decimals" placeholder="Dec." min="0" max="6" step="1" title="Decimals — blank uses the panel/global default">';
      row.querySelector('.chart-series-row-label').textContent = monitorLabel;
      row.querySelector('.chart-series-row-label').title = monitorLabel;
      row.querySelector('.chart-series-row-name').value = (override && override.name) || '';
      var unitPicker = buildUnitPicker((override && override.unit) || '');
      row.querySelector('.chart-series-row-unit-slot').replaceWith(unitPicker);
      var scalePicker = buildScalePicker(override && override.scale);
      row.querySelector('.chart-series-row-scale-slot').replaceWith(scalePicker);
      row.querySelector('.value-series-row-decimals').value = (override && override.decimals != null) ? override.decimals : '';
      return row;
    }

    document.querySelectorAll('.value-series-settings').forEach(function (container) {
      var form = container.closest('form');
      var checklist = form.querySelector(container.dataset.checklistSelector);
      if (!checklist) return;
      var hidden = container.querySelector('.value-series-hidden');
      var rowsEl = container.querySelector('.value-series-rows');
      var cache = {};
      try { cache = JSON.parse(hidden.value || '{}'); } catch (e) { /* malformed — start empty */ }

      function serialize() {
        var out = {};
        rowsEl.querySelectorAll('.value-series-row').forEach(function (row) {
          var id = row.dataset.monitorId;
          var name = row.querySelector('.chart-series-row-name').value.trim();
          var unit = unitPickerValue(row.querySelector('.chart-series-row-unit-wrap'));
          var scale = scalePickerValue(row.querySelector('.chart-series-row-scale-wrap'));
          if (scale === 1) scale = null;
          var decimalsRaw = row.querySelector('.value-series-row-decimals').value.trim();
          var decimals = decimalsRaw === '' ? null : Number(decimalsRaw);
          if (!Number.isFinite(decimals)) decimals = null;
          var entry = { name: name || null, unit: unit || null, scale: scale, decimals: decimals };
          cache[id] = entry;
          if (name || unit || entry.scale != null || entry.decimals != null) out[id] = entry;
        });
        hidden.value = JSON.stringify(out);
      }

      function rebuildRows() {
        var checked = Array.prototype.slice.call(checklist.querySelectorAll('input[type="checkbox"]:checked'));
        rowsEl.innerHTML = '';
        checked.forEach(function (checkbox) {
          var id = checkbox.value;
          var labelEl = checkbox.closest('label');
          var monitorLabel = labelEl ? labelEl.textContent.trim().replace(/\s*\([a-z_]+\)\s*$/i, '') : id;
          var row = buildValueSeriesRow(id, monitorLabel, cache[id]);
          Array.prototype.forEach.call(row.querySelectorAll('input, select'), function (el) {
            el.addEventListener('input', serialize);
            el.addEventListener('change', serialize);
          });
          rowsEl.appendChild(row);
        });
        serialize();
      }

      checklist.addEventListener('change', function (e) {
        if (e.target.matches('input[type="checkbox"]')) rebuildRows();
      });
      rebuildRows();
    });
  })();
</script>

<script>
  // The panel edit form now opens as a fixed side drawer (see .dash-panel > .panel-settings-form
  // in style.css) instead of expanding inline, so unlike before it no longer needs the card itself
  // to grow to fit it — this just handles the backdrop (shown behind whichever drawer is open,
  // click or Escape to close) since the shared [data-toggle-row] handler (foot.ejs) only knows how
  // to toggle .open on the form itself, not coordinate a backdrop across all of them.
  (function () {
    var backdrop = document.getElementById('panel-edit-backdrop');
    if (!backdrop) return;

    // The panel currently being edited stays lifted above the backdrop's own blur/dim (see
    // .dash-panel.editing in style.css) instead of getting blurred out along with the rest of the
    // dashboard — so a live-refresh change made while the drawer is open is actually visible
    // without closing it first, which is the whole point of a live-editing drawer. Its natural
    // grid position is often a bad fit for this though — it can land partly behind the drawer
    // itself, or squeezed into a thin sliver at the very edge of the remaining visible area — so
    // it's also re-centered within whatever space is actually left once the drawer's own width is
    // subtracted (the drawer itself always stays put, pinned to the right edge — only the panel
    // moves, into the middle of what's left on the LEFT of it).
    //
    // Deliberately position:fixed + left/top, NOT a transform — .panel-settings-form (the drawer)
    // is `position: fixed` and a DIRECT CHILD of .dash-panel, and a `transform` on ANY ancestor
    // creates a new containing block for a fixed-positioned descendant per the CSS spec. Putting a
    // transform on .dash-panel.editing dragged the drawer along with it (off the right edge, into
    // the middle of the screen) instead of leaving it pinned to the viewport — this shipped once
    // already. Plain `position` on an ancestor carries no such caveat, so switching the PANEL
    // itself to `fixed` (leaving the drawer alone) sidesteps the whole problem.
    function centerEditingPanel(panel) {
      var openForm = document.querySelector('.dash-panel > .panel-settings-form.open');
      var drawerWidth = openForm ? openForm.getBoundingClientRect().width : 0;
      var availableWidth = window.innerWidth - drawerWidth;

      // Always measure the panel at its NATURAL grid size, not whatever fixed size a previous run
      // left on it — otherwise a panel shrunk once (below) could never grow back when the drawer is
      // later dragged narrower to give it more room. Clearing the inline overrides first, then
      // reading, is what gives a stable natural measurement on every recompute.
      panel.style.position = '';
      panel.style.left = '';
      panel.style.top = '';
      panel.style.width = '';
      panel.style.height = '';
      panel.style.margin = '';
      var rect = panel.getBoundingClientRect();

      // Breathing room so the lifted panel never crowds the drawer's edge or the viewport edges.
      var MARGIN = 32;
      var maxW = availableWidth - MARGIN;
      var maxH = window.innerHeight - MARGIN;
      // Too little room left to show anything useful (an extremely narrow window, or a drawer
      // dragged very wide) — leave the panel at its natural grid position rather than shrinking it
      // into an unreadable sliver.
      if (maxW < 200 || maxH < 160) return;

      // Shrink (never enlarge) the panel just enough to fit ENTIRELY in the space left of the
      // drawer, preserving its aspect ratio. A wide chart panel used to overflow that space and get
      // dropped back into normal document flow — which read as the chart sitting half-under the edit
      // drawer instead of centered beside it (a gauge or state bar, being narrower, always fit and
      // so always centered correctly — hence the inconsistency). Narrow panels keep scale === 1 and
      // behave exactly as before.
      var scale = Math.min(1, maxW / rect.width, maxH / rect.height);
      var w = Math.round(rect.width * scale);
      var h = Math.round(rect.height * scale);
      var left = Math.max(0, Math.round((availableWidth - w) / 2));
      var top = Math.max(0, Math.round((window.innerHeight - h) / 2));
      panel.style.position = 'fixed';
      panel.style.left = left + 'px';
      panel.style.top = top + 'px';
      panel.style.width = w + 'px';
      // Height too, not just width — position:fixed pulls the panel out of the CSS grid entirely, so
      // without an explicit height it falls back to auto (shrink-to-content). Every OTHER panel body
      // (chart canvas, table, plain flex value/bar-gauge lists) never depended on the parent having
      // a definite height, so this went unnoticed until the radial gauge's own container-query
      // sizing (.gauge-radial-outer, see style.css) needed one to size itself from — with no definite
      // height to query, it silently resolved to zero and the whole gauge disappeared.
      panel.style.height = h + 'px';
      panel.style.margin = '0';
    }

    function resetEditingPanelPosition(panel) {
      panel.style.position = '';
      panel.style.left = '';
      panel.style.top = '';
      panel.style.width = '';
      panel.style.height = '';
      panel.style.margin = '';
      // Restores whatever draggable value the grid's own reorder script set (see
      // "draggable" further below) — dragging a panel around while its OWN drawer is still open
      // (fixed-positioned, centered mid-screen) has no sensible meaning, so it's turned off for
      // exactly as long as .editing is, same lifetime as the position override right above.
      if (panel.dataset.draggableBase != null) panel.draggable = panel.dataset.draggableBase === 'true';
    }

    function syncBackdrop() {
      var openForm = document.querySelector('.dash-panel > .panel-settings-form.open');
      backdrop.classList.toggle('open', !!openForm);
      document.querySelectorAll('.dash-panel.editing').forEach(function (p) {
        p.classList.remove('editing');
        resetEditingPanelPosition(p);
      });
      if (openForm) {
        var panel = openForm.closest('.dash-panel');
        panel.classList.add('editing');
        if (panel.dataset.draggableBase == null) panel.dataset.draggableBase = String(panel.draggable);
        panel.draggable = false;
        centerEditingPanel(panel);
      }
    }
    function closeAll() {
      document.querySelectorAll('.dash-panel > .panel-settings-form.open').forEach(function (f) { f.classList.remove('open'); });
      document.querySelectorAll('.dash-panel.editing').forEach(function (p) {
        p.classList.remove('editing');
        resetEditingPanelPosition(p);
      });
      backdrop.classList.remove('open');
    }

    // Deferred a tick so this runs after foot.ejs's own [data-toggle-row] click handler has
    // already flipped .open — both are plain document click listeners, and this script runs
    // (and so registers its listener) before that one simply because it appears earlier in the
    // page, which would otherwise see the pre-toggle state.
    document.addEventListener('click', function (e) {
      if (e.target.closest('[data-toggle-row^="panel-edit-"]')) setTimeout(syncBackdrop, 0);
    });
    backdrop.addEventListener('click', closeAll);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeAll(); });
    // Keeps the centering correct as the window resizes or the drawer itself gets dragged wider/
    // narrower (see the drag-to-resize script further below) — both change how much space is
    // actually left to center within.
    window.addEventListener('resize', function () {
      var editing = document.querySelector('.dash-panel.editing');
      if (editing) centerEditingPanel(editing);
    });
    window.recenterEditingPanel = function () {
      var editing = document.querySelector('.dash-panel.editing');
      if (editing) centerEditingPanel(editing);
    };
  })();
</script>

<%
  // Extracted to /panel-drawer-resize.js once the Monitor detail page's own chart-settings drawer
  // became a second consumer of this same drag-to-resize behavior.
%>
<script src="/panel-drawer-resize.js"></script>

<script>
  // Auto-saves every .panel-settings-form on any field change instead of requiring the explicit
  // Save button — the button still works (it's now just an immediate flush of the debounce below)
  // but no longer navigates away, so the drawer stays open and the change is visible right away.
  (function () {
    var pending = new WeakMap(); // form -> setTimeout id, so rapid edits collapse into one save
    var SAVE_DELAY_MS = 700;

    function setStatus(form, text) {
      var status = form.querySelector('.panel-save-status');
      if (status) status.textContent = text;
    }

    // The one panel-type-specific element that follows the settings form in a card — a chart's
    // .chart-wrap, a table's .panel-table-scroll, a gauge's .gauge-wrap, the "no monitors" hint,
    // etc. Found generically, since after a type change it's not the same element it was before.
    // Must also skip .confirm-bar — foot.ejs's data-confirm handling inserts one as a direct
    // child of .dash-panel too (right after .dash-panel-head, for the Delete-panel button), and
    // it's only ever present on the live DOM, never in a freshly-fetched, script-free HTML parse.
    // And .panel-drawer-resize-handle — the drawer-width drag handle sits as its OWN direct child
    // right after .panel-settings-form, not nested inside it, so it was quietly the first match
    // here (silently "fixing" every panel's content at whatever tiny size that handle renders at)
    // until this was added. (No more .dash-panel-resize-handle exclusion needed — GridStack's own
    // resize handles live on .grid-stack-item, a level up from .dash-panel, not as one of its
    // direct children any more.)
    function getContentEl(card) {
      return card.querySelector(':scope > *:not(.widget-drag-handle):not(.dash-panel-head):not(.confirm-bar):not(.panel-settings-form):not(.panel-drawer-resize-handle)');
    }

    function applyPatch(card, freshCard) {
      var title = card.querySelector('.dash-panel-title');
      var freshTitle = freshCard.querySelector('.dash-panel-title');
      if (title && freshTitle) title.textContent = freshTitle.textContent;

      var content = getContentEl(card);
      var freshContent = getContentEl(freshCard);
      if (content && freshContent) {
        // The OLD canvas's own Chart.js instance + its 15s refresh loop (see monitor-chart.js)
        // otherwise just kept running forever in the background after being detached here —
        // every edit left one more of these piled up, each still fetching/rendering into a chart
        // object nothing on screen points at any more. Explicit teardown before the swap, not
        // just after — a background refresh landing between the swap and the new chart existing
        // would have nothing to update anyway, so ordering it first is what actually matters.
        var oldCanvas = content.querySelector('canvas[data-monitor-ids]');
        if (oldCanvas && oldCanvas._loxsuiteCleanup) oldCanvas._loxsuiteCleanup();
        content.replaceWith(freshContent);
        // A chart's <canvas> needs its own refresh loop restarted — the generic content swap
        // above only ever gives it a fresh, un-initialized element.
        var canvas = freshContent.querySelector('canvas[data-monitor-ids]');
        if (canvas && window.initChartCanvas) window.initChartCanvas(canvas);
      }
      window.stampCsrfTokens();
    }
    // Reused by the save-as-default/reset-to-default handler below — "Reset" actually changes a
    // panel's rendered content (new colors etc.), so it needs the same in-place patch this
    // form's own autosave already does, rather than a full page reload that would also close the
    // drawer the user very much still has open.
    window.applyDashPanelPatch = applyPatch;

    function doSave(form) {
      clearTimeout(pending.get(form));
      pending.delete(form);
      var card = form.closest('.dash-panel');
      setStatus(form, 'Saving…');
      // A FormData body would send multipart/form-data, which nothing here parses (the app only
      // wires up express.urlencoded()) — every field would arrive as undefined. URLSearchParams
      // sends the same x-www-form-urlencoded body a normal form submit would.
      var params = new URLSearchParams();
      new FormData(form).forEach(function (value, key) { params.append(key, value); });
      fetch(form.action, { method: 'POST', body: params })
        .then(function (res) {
          if (!res.ok) throw new Error('save failed');
          return res.text();
        })
        .then(function (html) {
          var freshDoc = new DOMParser().parseFromString(html, 'text/html');
          var freshCard = freshDoc.querySelector('.dash-panel[data-id="' + card.dataset.id + '"]');
          if (card && freshCard) applyPatch(card, freshCard);
          setStatus(form, 'Saved');
          setTimeout(function () { setStatus(form, ''); }, 1500);
        })
        .catch(function () { setStatus(form, 'Save failed'); });
    }

    function scheduleSave(form) {
      setStatus(form, 'Editing…');
      clearTimeout(pending.get(form));
      pending.set(form, setTimeout(function () { doSave(form); }, SAVE_DELAY_MS));
    }

    function flushPending(form) {
      if (pending.has(form)) doSave(form);
    }

    document.querySelectorAll('.panel-settings-form').forEach(function (form) {
      form.addEventListener('submit', function (e) { e.preventDefault(); doSave(form); });
      ['input', 'change'].forEach(function (evtName) {
        form.addEventListener(evtName, function (e) {
          if (e.target.classList.contains('panel-monitor-filter')) return; // client-side-only, not a real field
          scheduleSave(form);
        });
      });
    });

    // Row-remove buttons (threshold/value-mapping builders) only ever fire a click, never an
    // input/change on the (now-detached) row itself, so they need their own trigger.
    document.addEventListener('click', function (e) {
      var removeBtn = e.target.closest('.threshold-row-remove, .value-mapping-row-remove');
      var form = removeBtn && removeBtn.closest('.panel-settings-form');
      if (form) { scheduleSave(form); return; }

      // Closing a drawer (backdrop or its own × — both use this same [data-toggle-row] trigger),
      // or opening a different panel's drawer, must not silently drop a still-debounced change.
      if (e.target.closest('#panel-edit-backdrop') || e.target.closest('[data-toggle-row^="panel-edit-"]')) {
        document.querySelectorAll('.panel-settings-form').forEach(flushPending);
      }
    });
  })();
</script>

<script>
  // Save-as-default / reset-to-default (panel-settings-form-head) — plain fetch() rather than a
  // real <form>: these buttons live inside .panel-settings-form-head, itself inside the main
  // "Edit panel" <form>, and HTML can't nest a second <form> in there. An earlier version used a
  // standalone empty <form> elsewhere in the DOM + button[form="..."] to point at it, which
  // technically works per spec, but silently broke getContentEl() above (script starting "Auto-
  // saves every .panel-settings-form") — that scans .dash-panel's direct children for "whatever
  // isn't a known non-content element" to patch in fresh HTML after a save, and the extra sibling
  // <form>s (not in its exclusion list) got mistaken for panel content. fetch() avoids adding any
  // DOM nodes at all. Content-Type: application/json is what lets this skip the CSRF token
  // entirely (see middleware/csrf.js) — neither route reads a request body.
  //
  // Also used to reload the whole page here: that closed the drawer the user was actively in,
  // which isn't expected for either action. Reset now in-place patches this panel's own rendered
  // content via the same applyDashPanelPatch() the form's own autosave uses (Reset genuinely
  // changes what's on screen — new colors etc.); Save doesn't change this panel's own content at
  // all, so it only needs to flip the star's own "just saved" flag, nothing else on the page.
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-panel-default-kind]');
    if (!btn) return;
    var kind = btn.dataset.panelDefaultKind;
    var card = btn.closest('.dash-panel');
    var starBtn = card && card.querySelector('[data-panel-default-kind="save"]');
    btn.disabled = true;
    fetch(btn.dataset.panelDefaultUrl, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' })
      .then(function (res) { return kind === 'reset' ? res.text() : null; })
      .then(function (html) {
        if (kind === 'save') {
          // Just-saved flag — see the comment on these buttons in the template. Doesn't reflect
          // whether a default still exists in the DB, only "was Save the last thing clicked here."
          if (starBtn) { starBtn.classList.add('icon-btn-star-saved'); starBtn.classList.remove('icon-btn-neutral'); }
          return;
        }
        if (starBtn) { starBtn.classList.remove('icon-btn-star-saved'); starBtn.classList.add('icon-btn-neutral'); }
        if (!html || !card) return;
        // Only the panel's rendered CONTENT is patched here (applyDashPanelPatch explicitly skips
        // .panel-settings-form, same as the autosave flow it's shared with) — the still-open Edit
        // form's own fields (color pickers etc.) keep showing whatever was there before Reset was
        // clicked, not the newly-applied default, until the drawer is closed and reopened. Known
        // gap, not silently different from what the form actually shows.
        var freshDoc = new DOMParser().parseFromString(html, 'text/html');
        var freshCard = freshDoc.querySelector('.dash-panel[data-id="' + card.dataset.id + '"]');
        if (freshCard) window.applyDashPanelPatch(card, freshCard);
      })
      .catch(function () {})
      .then(function () { btn.disabled = false; });
  });
</script>

<script>
  // GridStack.js drives the whole panel grid now — one instance per "zone" (see the render loop
  // above), replacing the old hand-rolled pointer-based drag/resize scripts AND the skyline
  // auto-packer in one step. float:false (GridStack's own default, set explicitly here for
  // clarity) means every zone keeps itself gravity-compacted continuously as panels are
  // dragged/resized, not just on an explicit Auto-order click — arguably the actual fix for "Auto
  // order doesn't work great": a one-shot algorithm swapped for a library that keeps things tight
  // all the time. acceptWidgets:true lets a panel be dragged from one zone's instance into
  // another (restoring "move a panel into/out of a group" — the 'added' handler further down is
  // what actually makes that stick server-side, since GridStack itself has no idea "group" means
  // anything; it just sees the item land in a different grid-stack element).
  (function () {
    var canEdit = <%- canEditPanels ? 'true' : 'false' %>;
    var grids = [];
    document.querySelectorAll('.grid-stack').forEach(function (el) {
      grids.push(GridStack.init({
        column: 12,
        cellHeight: 70,
        margin: 8,
        float: false,
        staticGrid: !canEdit,
        acceptWidgets: true,
        dragHandle: '.widget-drag-handle',
        resizable: { handles: 'se, sw' },
        oneColumnSize: 768, // matches this app's own mobile breakpoint elsewhere, see style.css
        // Off for this first, one-time layout pass — GridStack's own .grid-stack-animate class
        // (see gridstack.min.css) puts a transition on every x/y/w/h change it makes, including
        // placing each panel at its OWN saved position for the very first time on page load. With
        // it on, that read as every panel visibly starting somewhere wrong and sliding into its
        // real spot the instant the page opened. Turned back on right below, once this pass is
        // done — real drag/resize interactions from here on still animate normally.
        animate: false,
      }, el));
    });
    grids.forEach(function (grid) { grid.setAnimation(true); });
    // A view-only visitor gets exactly the saved layout with staticGrid (no drag/resize, so
    // nothing here can ever change) — none of the persistence/Auto-order wiring below applies.
    if (!canEdit || grids.length === 0) return;

    // Persists every affected panel's new x/y/w/h in one request whenever a drag or resize
    // completes (GridStack's own 'change' event) — replaces the role the old separate /reorder and
    // /panels/:panelId/resize routes used to serve. gs-id (set to the panel's own id at render
    // time, see the render loop above) is what each changed item's own .id carries through here.
    function persistLayout(items) {
      var updates = (items || [])
        .map(function (item) { return { id: Number(item.id), x: item.x, y: item.y, w: item.w, h: item.h }; })
        .filter(function (u) { return Number.isFinite(u.id); });
      if (!updates.length) return;
      fetch('/dashboards/<%= dashboardId %>/panels/layout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ updates: updates }),
      }).catch(function () { /* best-effort */ });
    }

    grids.forEach(function (grid) {
      grid.on('change', function (event, items) { persistLayout(items); });
      // Fires only for an item that newly landed in THIS grid instance — i.e. a cross-zone drag
      // (a same-zone drag/resize only ever fires 'change' above). GridStack itself doesn't know
      // "zone" means "group" — this is what actually moves the panel server-side, by renumbering
      // its position to fall inside whichever group this grid's own data-group-id names (absent
      // on zone 0's own element, which /panels/:panelId/move-to-zone reads as "ungrouped").
      grid.on('added', function (event, items) {
        persistLayout(items);
        var afterGroupId = grid.el.dataset.groupId || null;
        (items || []).forEach(function (item) {
          if (!Number.isFinite(Number(item.id))) return;
          fetch('/dashboards/<%= dashboardId %>/panels/' + item.id + '/move-to-zone', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ afterGroupId: afterGroupId }),
          }).catch(function () { /* best-effort */ });
        });
      });
    });

    // An empty zone (a group with no panels yet, or the ungrouped zone-0) renders 0px tall, which
    // leaves GridStack no area to drop a cross-zone drag onto — so dragging a panel INTO an
    // otherwise-empty group silently did nothing (the whole "move to another group" complaint).
    // While any panel drag is in progress, give every currently-empty zone a real, clearly-marked
    // drop height; collapse them again the instant the drag ends. GridStack fires 'dragstart'
    // reliably on the SOURCE grid, but 'dragstop' does NOT fire for a cross-grid drop (the item has
    // already left that grid by then), so a capture-phase pointerup/cancel is the dependable
    // "drag is over" signal.
    function setEmptyDropZonesActive(active) {
      grids.forEach(function (grid) {
        var isEmpty = grid.el.querySelectorAll(':scope > .grid-stack-item').length === 0;
        grid.el.classList.toggle('dash-grid-empty-droppable', active && isEmpty);
      });
    }
    grids.forEach(function (grid) {
      grid.on('dragstart', function () { setEmptyDropZonesActive(true); });
    });
    document.addEventListener('pointerup', function () { setEmptyDropZonesActive(false); }, true);
    document.addEventListener('pointercancel', function () { setEmptyDropZonesActive(false); }, true);

    // Migration: a panel saved before GridStack existed has no real x/y yet (see db.js's
    // grid_x/grid_y columns) — the render loop above omits gs-x/gs-y for those (flagging them with
    // data-needs-position instead), so GridStack just auto-placed them in their existing position
    // order as part of the GridStack.init() call right above. Persisted immediately so the NEXT
    // load has a real saved spot instead of re-auto-placing every time (harmless either way, just
    // wasted work skipped).
    var needsInitialSave = [];
    document.querySelectorAll('.grid-stack-item[data-needs-position]').forEach(function (el) {
      var node = el.gridstackNode;
      if (node) needsInitialSave.push({ id: node.id, x: node.x, y: node.y, w: node.w, h: node.h });
    });
    if (needsInitialSave.length) persistLayout(needsInitialSave);

    // "Auto order" — two passes, same idea as the pre-GridStack version this replaces (resize
    // every panel to fit its own content, THEN pack), just driven through GridStack's own API
    // instead of hand-rolled CSS Grid placement. Skipping the resize pass and only calling
    // compact() (an earlier version of this migration did exactly that) leaves every panel at
    // whatever size it happened to already have — compact() only closes gaps BETWEEN panels, it
    // has no idea a panel is bigger or smaller than its actual content, so a short state-bar
    // panel next to a tall one still reads as "lots of wasted space" and a state-bar panel too
    // narrow for its own longest label still visually breaks.
    var ROW_UNIT_PX = 70; // must match GridStack's own cellHeight in the init options above
    var GAP_PX = 8; // must match GridStack's own margin in the init options above
    var MIN_ROW_SPAN = 2, MAX_ROW_SPAN = 200, MIN_COL_SPAN = 2, MAX_COL_SPAN = 12;
    function clamp(v, min, max) { return Math.min(max, Math.max(min, v)); }

    // Every direct child that's actually part of this panel's own body, everything else being
    // chrome (drag handle, header, the edit drawer). Most panel types render exactly ONE such
    // child, but state_bar renders a second, plain trailing sibling after it too (the range
    // start/end timestamp footer, reusing .gauge-radial-minmax's styling) — an easy one to miss if
    // this only ever looked at the FIRST match, which is exactly what silently under-measured it
    // until this was caught by an actual overlap in the rendered panel.
    function getContentEls(card) {
      return Array.prototype.filter.call(card.children, function (el) {
        return !el.classList.contains('widget-drag-handle')
          && !el.classList.contains('dash-panel-head')
          && !el.classList.contains('confirm-bar')
          && !el.classList.contains('panel-settings-form')
          && !el.classList.contains('panel-drawer-resize-handle');
      });
    }

    function getContentEl(card) {
      return getContentEls(card)[0] || null;
    }

    // Sums every body child's own height + vertical margins — not just the first one. The first
    // child is typically a flex:1 element (chart-wrap/panel-table-scroll/state-bar-panel/...,
    // see style.css) that can currently be squeezed smaller than its content actually needs;
    // scrollHeight reports its TRUE natural extent regardless of that squeeze. Any additional
    // sibling after it is a plain, unflexed block whose current rendered height already IS its
    // natural one, so a plain getBoundingClientRect is enough for those — but the margin between
    // siblings still needs adding, since scrollHeight only covers the flexed element's own box.
    function measureBodyHeight(card) {
      var kids = getContentEls(card);
      if (!kids.length) return 20;
      var total = 0;
      kids.forEach(function (el, i) {
        var style = getComputedStyle(el);
        var h = i === 0 ? el.scrollHeight : el.getBoundingClientRect().height;
        total += h + (parseFloat(style.marginTop) || 0) + (parseFloat(style.marginBottom) || 0);
      });
      return total;
    }

    // Width by content shape, not measured — a chart reads better wide (time axis resolution), a
    // table/state-bar's own row labels want more room than a compact gauge/stat/threshold tile
    // needs. Height (see below) is what's actually measured from real content, since "how many
    // rows/values does this panel have" varies per panel far more than "what type is it" does.
    function guessColSpan(card) {
      var content = getContentEl(card);
      if (!content) return 4;
      if (content.classList.contains('chart-wrap')) return 6;
      if (content.classList.contains('panel-table-scroll')) return 5;
      if (content.classList.contains('state-bar-panel')) return 6;
      if (content.classList.contains('panel-value-list')) return 4;
      return 3; // gauge, stat_delta, threshold — compact, roughly square tiles
    }

    // A chart's canvas has no natural "content minimum" the way a table's rows or a state bar's
    // list do — Chart.js just fills whatever box height it's handed and redistributes that space
    // internally between its legend, axis labels, and the actual plot. measureBodyHeight above
    // ends up reading back roughly whatever height the panel already happened to have (a
    // near-tautological measurement, not a real requirement), so a chart that started small — the
    // common case for a freshly added panel — stayed small forever: legend + axes ate a fixed
    // chunk of that little box, leaving the plot itself cramped. Floor charts higher than the
    // generic per-type minimum so the legend and axes always have enough room to not crowd the
    // part of the panel someone's actually looking at.
    function contentMinRowSpan(card) {
      var content = getContentEl(card);
      return content && content.classList.contains('chart-wrap') ? 5 : MIN_ROW_SPAN;
    }

    // The interactive drag-resize floor — deliberately smaller than Auto-order's own target size
    // (which fits ALL of a panel's content). This only has to cover one row/tile's worth of the
    // main content, on the assumption anything beyond that can scroll internally instead (see
    // .state-bar-panel's own overflow-y:auto) — a state bar with 20 monitors would otherwise force
    // a huge floor just to keep every row fully in view. What it MUST always reserve in full,
    // never leaving to a "just resize bigger" assumption, is the header (title + edit/copy/delete
    // buttons) and any trailing footer (state_bar's/circle-gauge's own timestamp or min/max row) —
    // both are plain, non-flexed siblings of the main content, so a panel shorter than all three
    // combined doesn't shrink them, it lets the content bleed straight over them instead.
    function applyMinSizes(grid) {
      var cellW = grid.cellWidth();
      grid.engine.nodes.slice().forEach(function (node) {
        var card = node.el.querySelector('.dash-panel');
        if (!card || card.classList.contains('dash-panel-group-header')) return;
        var kids = getContentEls(card);
        var content = kids[0] || null;
        var headEl = card.querySelector('.dash-panel-head');
        var cardStyle = getComputedStyle(card);
        var paddingV = (parseFloat(cardStyle.paddingTop) || 0) + (parseFloat(cardStyle.paddingBottom) || 0);
        var paddingH = (parseFloat(cardStyle.paddingLeft) || 0) + (parseFloat(cardStyle.paddingRight) || 0);
        var headOuter = 0;
        if (headEl) {
          var headStyle = getComputedStyle(headEl);
          headOuter = headEl.getBoundingClientRect().height + (parseFloat(headStyle.marginBottom) || 0);
        }
        var footerPx = 0;
        for (var i = 1; i < kids.length; i++) {
          var footerStyle = getComputedStyle(kids[i]);
          footerPx += kids[i].getBoundingClientRect().height + (parseFloat(footerStyle.marginTop) || 0) + (parseFloat(footerStyle.marginBottom) || 0);
        }
        var contentItemEl = node.el.querySelector('.grid-stack-item-content');
        var contentInset = contentItemEl ? (parseFloat(getComputedStyle(contentItemEl).top) || 0) : 0;

        var minContentPx = 40; // gauge, stat_delta, threshold — small, roughly square tiles
        if (content) {
          if (content.classList.contains('chart-wrap')) minContentPx = 180; // a chart needs real plot room even at its smallest, not just its legend/axes
          else if (content.classList.contains('panel-table-scroll')) minContentPx = 60; // header row + one data row
          else if (content.classList.contains('state-bar-panel')) {
            var track = content.querySelector('.state-bar-track');
            minContentPx = track ? track.getBoundingClientRect().height + 10 : 40; // one bar row; the rest scrolls
          }
        }
        // +16: a fixed safety margin, not just rounding slop — a footer/head measured a frame or
        // two before web fonts finish swapping in can read a few px shorter than its settled size
        // (seen in practice: the state_bar timestamp footer measured ~16px tall right after load,
        // ~20px once the font had actually loaded). Erring a little tall here only costs a sliver
        // of extra panel height; erring short is the exact overlap bug this whole thing exists to
        // prevent. The rAF-delayed re-run below (after grids.forEach) catches the settled value on
        // the very next frame regardless, this just keeps the FIRST pass from being too optimistic
        // in the meantime.
        var neededHeightPx = paddingV + headOuter + footerPx + minContentPx + contentInset * 2 + 6 + 16;
        var minH = clamp(Math.ceil((neededHeightPx + GAP_PX) / (ROW_UNIT_PX + GAP_PX)), MIN_ROW_SPAN, MAX_ROW_SPAN);

        // Width floor: only state_bar has real text that stops being useful below a certain
        // width (see .state-bar-label's own min-width:15ch) — every other panel type's content
        // reflows/wraps or is already compact, so MIN_COL_SPAN alone is enough for those.
        var minW = MIN_COL_SPAN;
        if (content && content.classList.contains('state-bar-panel')) {
          var label = content.querySelector('.state-bar-label');
          var labelMinPx = label ? (parseFloat(getComputedStyle(label).minWidth) || 0) : 0;
          var rowNeedPx = labelMinPx > 0 ? labelMinPx + 48 /* track floor + column gap */ : 0;
          // The footer's own two timestamp spans (range start/end) sit side by side with
          // justify-content:space-between and no wrap — plain text can't flex-shrink below its own
          // natural width, so a panel narrower than both spans combined doesn't wrap or truncate
          // them, it just runs them into each other. Sum the SPANS' own widths, not the footer
          // element's — that outer div is width:100% (see style.css), so ITS scrollWidth is just
          // whatever the panel's current width already is, not the smaller natural minimum the
          // two spans actually need.
          var footerEl = kids[1];
          var footerNeedPx = 0;
          if (footerEl && footerEl.classList.contains('gauge-radial-minmax')) {
            Array.prototype.forEach.call(footerEl.children, function (span) {
              footerNeedPx += span.getBoundingClientRect().width;
            });
          }
          var neededWidthPx = Math.max(rowNeedPx, footerNeedPx);
          if (neededWidthPx > 0 && cellW > 0) {
            minW = clamp(Math.ceil((paddingH + neededWidthPx + contentInset * 2) / cellW), MIN_COL_SPAN, MAX_COL_SPAN);
          }
        }

        if (node.minH !== minH || node.minW !== minW) grid.update(node.el, { minH: minH, minW: minW });
      });
    }

    function autoOrderZone(grid) {
      var cards = Array.prototype.slice.call(grid.el.querySelectorAll('.dash-panel')).filter(function (c) {
        return !c.classList.contains('dash-panel-group-header');
      });
      if (cards.length === 0) return;

      // Pass 1 (writes only): assign a content-appropriate width and force one reflow, so pass 2's
      // measurements below reflect real wrapping at the new width instead of whatever it was
      // before (reading in a loop instead of once here would thrash layout for a big dashboard).
      cards.forEach(function (card) {
        var item = card.closest('.grid-stack-item');
        grid.update(item, { w: guessColSpan(card) });
      });
      grid.el.getBoundingClientRect();

      // Pass 2: measure each panel's own content element directly (.chart-wrap,
      // .panel-table-scroll, .state-bar-panel, ...), NOT the outer .dash-panel card — a
      // table/value-list/state-bar panel's content has its own overflow-y:auto + min-height:0 (see
      // style.css) specifically so IT can scroll internally instead of forcing the card to grow,
      // which means the card's OWN scrollHeight never reflects that overflow at all. The content
      // element's scrollHeight doesn't have that problem: it always reports its true natural
      // extent regardless of its own current box size. Head height + card padding (both fixed, not
      // content-dependent) are added back on top since neither is part of the content element.
      var sized = cards.map(function (card) {
        var item = card.closest('.grid-stack-item');
        var contentH = measureBodyHeight(card);
        var headEl = card.querySelector('.dash-panel-head');
        var cardStyle = getComputedStyle(card);
        var paddingV = (parseFloat(cardStyle.paddingTop) || 0) + (parseFloat(cardStyle.paddingBottom) || 0);
        var headOuter = 0;
        if (headEl) {
          var headStyle = getComputedStyle(headEl);
          headOuter = headEl.getBoundingClientRect().height + (parseFloat(headStyle.marginBottom) || 0);
        }
        // GridStack's own .grid-stack-item-content is position:absolute; inset:<margin>px (see
        // gridstack.min.css) — that inset eats into the item's OWN height on both the top AND
        // bottom edge, space the pre-GridStack version of this never had to account for (a plain
        // CSS Grid item had no such absolutely-positioned wrapper stealing room from its content).
        // Read from the actual computed style rather than hardcoded, so this stays correct if the
        // margin option above ever changes.
        var contentInset = parseFloat(getComputedStyle(item.querySelector('.grid-stack-item-content')).top) || 0;
        var neededPx = paddingV + headOuter + contentH + contentInset * 2 + 6; // +6: corner resize-handle / border rounding margin
        var h = clamp(Math.ceil((neededPx + GAP_PX) / (ROW_UNIT_PX + GAP_PX)), contentMinRowSpan(card), MAX_ROW_SPAN);
        var w = clamp(item.gridstackNode.w, MIN_COL_SPAN, MAX_COL_SPAN);
        return { item: item, w: w, h: h, area: w * h };
      });

      // First-fit-decreasing: applying the largest panels' real sizes first gives compact()'s own
      // gravity packing the best shot at tucking later, smaller panels into whatever gaps they
      // leave — the standard bin-packing approximation for this kind of layout (exact packing is
      // NP-hard). GridStack updates one at a time (not a single batch call) since compact() itself
      // needs to run against each new size in turn to find the tightest y for the NEXT one.
      sized.sort(function (a, b) { return b.area - a.area; });
      sized.forEach(function (s) { grid.update(s.item, { w: s.w, h: s.h }); });
      grid.compact();
      growToFillZone(grid);
    }

    // Pass 3: the sizes above are each panel's own CONTENT MINIMUM — enough to show its data
    // without clipping or overlap, nothing more. That alone tends to leave a ragged right edge and
    // uneven row bottoms once packed. This pass grows panels (width, then height) to soak up
    // whatever space compact() left unused, one grid cell at a time, stopping the instant growing
    // further would collide with another panel — so it only ever ADDS on top of the content
    // minimum already applied above, never shrinks below it. Height growth is capped at the
    // zone's own tallest current bottom edge (computed once, up front) so a panel alone in a short
    // column doesn't balloon downward forever just because nothing else happens to be below it.
    function growToFillZone(grid) {
      var maxCol = grid.getColumn ? grid.getColumn() : 12;
      var nodes = grid.engine.nodes;
      if (!nodes.length) return;
      var maxBottom = 0;
      nodes.forEach(function (n) { maxBottom = Math.max(maxBottom, n.y + n.h); });
      function overlapsAny(rect, self) {
        return nodes.some(function (o) {
          if (o === self) return false;
          return rect.x < o.x + o.w && rect.x + rect.w > o.x && rect.y < o.y + o.h && rect.y + rect.h > o.y;
        });
      }
      var ordered = nodes.slice().sort(function (a, b) { return a.y - b.y || a.x - b.x; });
      ordered.forEach(function (node) {
        var w = node.w;
        while (node.x + w < maxCol && !overlapsAny({ x: node.x, y: node.y, w: w + 1, h: node.h }, node)) w += 1;
        if (w !== node.w) grid.update(node.el, { w: w });
        var h = node.h;
        while (node.y + h < maxBottom && !overlapsAny({ x: node.x, y: node.y, w: node.w, h: h + 1 }, node)) h += 1;
        if (h !== node.h) grid.update(node.el, { h: h });
      });
    }

    var autoOrderBtn = document.getElementById('dash-auto-order-btn');
    if (autoOrderBtn) {
      autoOrderBtn.addEventListener('click', function () {
        grids.forEach(function (grid) {
          autoOrderZone(grid);
          applyMinSizes(grid);
          persistLayout(grid.save(false));
        });
      });
    }

    // Runs on every load, not just after clicking Auto order — a panel dragged too small in a
    // PAST session is exactly the case this needs to catch, and it has to be enforced before
    // anyone gets a chance to drag anything in THIS one. Re-run once more a couple of frames
    // later: measuring immediately on load can catch layout mid-settle (e.g. a web font still
    // swapping in makes the state_bar footer measure a few px shorter than its real size), which
    // would under-compute minH on this first pass — by the next frame everything's settled, and
    // grid.update() self-heals h upward too if the corrected minH now exceeds it.
    grids.forEach(function (grid) { applyMinSizes(grid); });
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        grids.forEach(function (grid) { applyMinSizes(grid); });
      });
    });
  })();
</script>

<script>
  // Drag-to-reorder WHOLE GROUPS (header + every panel inside it, moving together as one unit) —
  // LoxRowReorder's own hand-rolled pointer-drag (threshold-annotation-builder.js), the SAME
  // mechanism the threshold/annotation/value-mapping row lists use, reused here via its opts.handle
  // so the drag trigger is the group header's OWN grip icon rather than an auto-inserted extra one.
  // A GridStack-based version of this (a second, nested interactive grid) was tried and reverted —
  // see the render loop's own comment above for why. Zone 0 (ungrouped panels) sits outside
  // #dash-groups-sort-list entirely — it's not a group, and always stays first regardless of how
  // the groups below it get reordered.
  (function () {
    var sortList = document.getElementById('dash-groups-sort-list');
    if (!sortList) return;
    var canEdit = <%- canEditPanels ? 'true' : 'false' %>;
    if (!canEdit) return;

    function persistGroupOrder() {
      var order = Array.prototype.slice.call(sortList.querySelectorAll(':scope > .dash-group-unit'))
        .map(function (unit) { return unit.dataset.groupPanelId; });
      fetch('/dashboards/<%= dashboardId %>/panels/reorder-groups', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ groupOrder: order }),
      }).catch(function () { /* best-effort */ });
    }

    Array.prototype.slice.call(sortList.children).forEach(function (unit) {
      var handle = unit.querySelector('.group-drag-handle');
      LoxRowReorder.attachRow(unit, sortList, persistGroupOrder, { handle: handle, dropIndicator: true });
    });
  })();
</script>

<script>
  // group_header collapse/expand — now just shows/hides that whole group's own zone element (a
  // ".grid-stack" div — see the render loop above: every group_header is immediately followed by
  // exactly one such div, holding only that group's own members) rather than toggling a class on
  // every member individually, which is what the old DOM-order-based "everything up to the next
  // group_header" bookkeeping (and the row-height workaround that came with it) used to need.
  // Collapsed state is a personal display preference, not app data — kept in localStorage (same
  // convention as the refresh-interval/panel-drawer-width prefs, see foot.ejs), keyed by dashboard
  // AND panel id so it doesn't collide with another dashboard's own group headers.
  (function () {
    function storageKey(headerCard) {
      return 'dashGroupCollapsed:<%= dashboardId %>:' + headerCard.dataset.id;
    }
    function isCollapsed(headerCard) {
      return localStorage.getItem(storageKey(headerCard)) === '1';
    }
    function applyState(headerCard) {
      var collapsed = isCollapsed(headerCard);
      var toggle = headerCard.querySelector('.group-header-toggle');
      if (toggle) toggle.classList.toggle('is-collapsed', collapsed);
      var zone = headerCard.nextElementSibling;
      if (zone && zone.classList.contains('grid-stack')) zone.classList.toggle('dash-panel-group-collapsed', collapsed);
    }
    document.querySelectorAll('.dash-panel-group-header').forEach(function (headerCard) {
      var toggle = headerCard.querySelector('.group-header-toggle');
      if (toggle) {
        toggle.addEventListener('click', function () {
          localStorage.setItem(storageKey(headerCard), isCollapsed(headerCard) ? '0' : '1');
          applyState(headerCard);
        });
      }
      applyState(headerCard);
    });
  })();
</script>

<script>
  // A segment's label is only worth showing once it actually fits — a truncated ellipsis-cut
  // name reads worse than the color alone on a bar this narrow. Measured in pixels (percentage
  // widths don't tell you that on their own), so this has to run client-side after layout, not
  // be baked in server-side. Re-run on resize and after every live-refresh swap (MutationObserver
  // on the panel body, same pattern as incoming-clients.ejs's filter) rather than hooking
  // window.refreshTables directly, so this doesn't depend on tables.js having already loaded.
  (function () {
    function fitStateBarLabels() {
      document.querySelectorAll('.state-bar-segment').forEach(function (seg) {
        var label = seg.querySelector('.state-bar-segment-label');
        if (!label) return;
        label.classList.remove('is-overflowing');
        if (label.scrollWidth > seg.clientWidth) label.classList.add('is-overflowing');
      });
    }
    fitStateBarLabels();
    window.addEventListener('resize', function () {
      clearTimeout(window.__stateBarFitTimer);
      window.__stateBarFitTimer = setTimeout(fitStateBarLabels, 150);
    });
    document.querySelectorAll('.state-bar-panel').forEach(function (panel) {
      new MutationObserver(fitStateBarLabels).observe(panel, { childList: true, subtree: true });
    });
  })();
</script>

<script src="/vendor/chart.umd.min.js"></script>
<%
  // chartjs-plugin-zoom reads window.Hammer at its OWN script-evaluation time (it's a UMD module
  // whose browser-globals branch does `t.ChartZoom = n(t.Chart, t.Hammer, ...)`) — Hammer.js has
  // to already be loaded before this tag, not just before the plugin is *used*. Without it, the
  // plugin silently skips setting up its Hammer.Manager entirely (the pinch/pan gesture handling),
  // while wheel-zoom keeps working fine since that's wired via a plain native 'wheel' listener,
  // not Hammer — exactly the "zoom works, pan doesn't, no error anywhere" shape this had.
%>
<script src="/vendor/hammer.min.js"></script>
<script src="/vendor/chartjs-plugin-zoom.min.js"></script>
<script src="/monitor-chart.js?v=<%= assetVersion %>" defer></script>
