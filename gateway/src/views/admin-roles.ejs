<%- include('partials/head', { pageTitle: 'Administration', active: 'admin' }) %>

<%- include('partials/tabs-admin', { active: 'roles' }) %>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<p class="hint">
  <%= t('Access Roles control what a logged-in web UI user can see and change — separate from') %>
  <a href="/mqtt-roles"><%= t('MQTT Roles') %></a><%= t(', which govern IoT device pub/sub permissions on the broker, a completely different thing. An') %> <strong><%= t('Administrator') %></strong> <%= t('role sees and edits everything, including this page, regardless of the matrix below.') %>
</p>

<details class="add-panel">
  <summary><%= t('Add role') %></summary>
  <div class="add-panel-body">
    <form method="post" action="/admin/roles">
      <div class="form-grid">
        <div><label><%= t('Role name') %></label><input type="text" name="name" required></div>
        <button type="submit" class="primary"><%- icon('plus') %> <%= t('Add') %></button>
      </div>
    </form>
  </div>
</details>

<% roles.forEach(role => { %>
  <% const isOwnRole = currentUser && currentUser.roleId === role.id; %>
  <details class="add-panel" <%= isOwnRole ? 'open' : '' %>>
    <summary>
      <%= role.name %>
      <% if (role.is_admin) { %><span class="badge badge-ok" style="margin-left:0.5rem;"><%= t('Administrator') %></span><% } %>
      <span class="hint" style="margin:0 0 0 0.5rem;"><%= role.userCount %> <%= t('user') %><%= role.userCount === 1 ? '' : 's' %></span>
      <% if (isOwnRole) { %><span class="hint" style="margin:0 0 0 0.5rem;"><%= t('(your role)') %></span><% } %>
    </summary>
    <div class="add-panel-body">
      <div class="row-actions" style="justify-content:flex-end; margin-bottom:0.9rem;">
        <details class="inline-details" style="display:inline-block;">
          <summary class="btn-edit"><%- icon('edit') %> <%= t('Rename') %></summary>
          <form method="post" action="/admin/roles/<%= role.id %>/rename" class="form-grid" style="margin-top:0.6rem; grid-template-columns:1fr; min-width:12rem; gap:0.6rem;">
            <div><label><%= t('New name') %></label><input type="text" name="name" value="<%= role.name %>" required></div>
            <button type="submit" class="btn-edit"><%- icon('edit') %> <%= t('Save') %></button>
          </form>
        </details>
        <form method="post" action="/admin/roles/<%= role.id %>/delete" data-confirm="<%= t('Delete this role?') %>">
          <button type="submit" class="danger"><%- icon('trash') %> <%= t('Delete') %></button>
        </form>
      </div>

      <form method="post" action="/admin/roles/<%= role.id %>/permissions">
        <label style="display:flex; align-items:center; gap:0.5rem; font-size:0.87rem; margin-bottom:0.9rem;">
          <input type="checkbox" name="is_admin" <%= role.is_admin ? 'checked' : '' %>>
          <%= t('Administrator (full access to everything, including Administration itself)') %>
        </label>

        <div class="table-wrap">
          <table>
            <thead><tr><th><%= t('Page') %></th><th><%= t('View') %></th><th><%= t('Edit') %></th></tr></thead>
            <tbody>
              <% areas.forEach(area => { %>
                <tr>
                  <td><%= t(area.label) %></td>
                  <td><input type="checkbox" name="perm[<%= area.key %>][view]" <%= role.permissions[area.key].view ? 'checked' : '' %>></td>
                  <td><input type="checkbox" name="perm[<%= area.key %>][edit]" <%= role.permissions[area.key].edit ? 'checked' : '' %>></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div style="display:flex; align-items:baseline; justify-content:space-between; margin-top:1.25rem; gap:0.5rem; flex-wrap:wrap;">
          <h2 style="margin:0;"><%= t('Logs') %></h2>
          <button type="button" class="btn-soft" data-uncheck-target="logs-table-<%= role.id %>"><%= t('None — hide all logs') %></button>
        </div>
        <p class="hint">
          <%= t('Each log is its own toggle — a role can be trusted with, say, the System log without also seeing the MQTT broker log.') %> <strong><%= t('Download') %></strong> <%= t('exports the full, unfiltered') %>
          <code>.log</code> <%= t('file and implies View.') %> <strong><%= t('None') %></strong> <%= t('unchecks every box below (still needs') %> <strong><%= t('Save permissions') %></strong> <%= t('to take effect).') %>
        </p>
        <div class="table-wrap" id="logs-table-<%= role.id %>">
          <table>
            <thead><tr><th><%= t('Log') %></th><th><%= t('View') %></th><th><%= t('Download') %></th></tr></thead>
            <tbody>
              <% logAreas.forEach(area => { %>
                <tr>
                  <td><%= t(area.label) %></td>
                  <td><input type="checkbox" name="perm[<%= area.key %>][view]" <%= role.permissions[area.key].view ? 'checked' : '' %>></td>
                  <td><input type="checkbox" name="perm[<%= area.key %>][edit]" <%= role.permissions[area.key].edit ? 'checked' : '' %>></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <button type="submit" class="btn-edit"><%- icon('edit') %> <%= t('Save permissions') %></button>
      </form>
    </div>
  </details>
<% }) %>

<%- include('partials/foot') %>
