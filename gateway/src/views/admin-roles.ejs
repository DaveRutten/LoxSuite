<%- include('partials/head', { pageTitle: 'Administration', active: 'admin' }) %>

<div class="tabs">
  <a href="/admin/general">General</a>
  <a href="/admin/users">Users</a>
  <a class="active" href="/admin/roles">Access Roles</a>
  <a href="/admin/backup">Backups</a>
  <a href="/admin/notifications">Notifications</a>
  <a href="/admin/security">Security</a>
</div>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<p class="hint">
  Access Roles control what a logged-in web UI user can see and change &mdash; separate from
  <a href="/mqtt-roles">MQTT Roles</a>, which govern IoT device pub/sub permissions on the broker, a
  completely different thing. An <strong>Administrator</strong> role sees and edits everything,
  including this page, regardless of the matrix below.
</p>

<details class="add-panel">
  <summary>Add role</summary>
  <div class="add-panel-body">
    <form method="post" action="/admin/roles">
      <div class="form-grid">
        <div><label>Role name</label><input type="text" name="name" required></div>
        <button type="submit" class="primary"><%- icon('plus') %> Add</button>
      </div>
    </form>
  </div>
</details>

<% roles.forEach(role => { %>
  <% const isOwnRole = currentUser && currentUser.roleId === role.id; %>
  <details class="add-panel" <%= isOwnRole ? 'open' : '' %>>
    <summary>
      <%= role.name %>
      <% if (role.is_admin) { %><span class="badge badge-ok" style="margin-left:0.5rem;">Administrator</span><% } %>
      <span class="hint" style="margin:0 0 0 0.5rem;"><%= role.userCount %> user<%= role.userCount === 1 ? '' : 's' %></span>
      <% if (isOwnRole) { %><span class="hint" style="margin:0 0 0 0.5rem;">(your role)</span><% } %>
    </summary>
    <div class="add-panel-body">
      <div class="row-actions" style="justify-content:flex-end; margin-bottom:0.9rem;">
        <details class="inline-details" style="display:inline-block;">
          <summary class="btn-edit"><%- icon('edit') %> Rename</summary>
          <form method="post" action="/admin/roles/<%= role.id %>/rename" class="form-grid" style="margin-top:0.6rem; grid-template-columns:1fr; min-width:12rem; gap:0.6rem;">
            <div><label>New name</label><input type="text" name="name" value="<%= role.name %>" required></div>
            <button type="submit" class="btn-edit"><%- icon('edit') %> Save</button>
          </form>
        </details>
        <form method="post" action="/admin/roles/<%= role.id %>/delete" data-confirm="Delete this role?">
          <button type="submit" class="danger"><%- icon('trash') %> Delete</button>
        </form>
      </div>

      <form method="post" action="/admin/roles/<%= role.id %>/permissions">
        <label style="display:flex; align-items:center; gap:0.5rem; font-size:0.87rem; margin-bottom:0.9rem;">
          <input type="checkbox" name="is_admin" <%= role.is_admin ? 'checked' : '' %>>
          Administrator (full access to everything, including Administration itself)
        </label>

        <div class="table-wrap">
          <table>
            <thead><tr><th>Page</th><th>View</th><th>Edit</th></tr></thead>
            <tbody>
              <% areas.forEach(area => { %>
                <tr>
                  <td><%= area.label %></td>
                  <td><input type="checkbox" name="perm[<%= area.key %>][view]" <%= role.permissions[area.key].view ? 'checked' : '' %>></td>
                  <td><input type="checkbox" name="perm[<%= area.key %>][edit]" <%= role.permissions[area.key].edit ? 'checked' : '' %>></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div style="display:flex; align-items:baseline; justify-content:space-between; margin-top:1.25rem; gap:0.5rem; flex-wrap:wrap;">
          <h2 style="margin:0;">Logs</h2>
          <button type="button" class="btn-soft" data-uncheck-target="logs-table-<%= role.id %>">None &mdash; hide all logs</button>
        </div>
        <p class="hint">
          Each log is its own toggle &mdash; a role can be trusted with, say, the System log without
          also seeing the MQTT broker log. <strong>Download</strong> exports the full, unfiltered
          <code>.log</code> file and implies View. <strong>None</strong> unchecks every box below
          (still needs <strong>Save permissions</strong> to take effect).
        </p>
        <div class="table-wrap" id="logs-table-<%= role.id %>">
          <table>
            <thead><tr><th>Log</th><th>View</th><th>Download</th></tr></thead>
            <tbody>
              <% logAreas.forEach(area => { %>
                <tr>
                  <td><%= area.label %></td>
                  <td><input type="checkbox" name="perm[<%= area.key %>][view]" <%= role.permissions[area.key].view ? 'checked' : '' %>></td>
                  <td><input type="checkbox" name="perm[<%= area.key %>][edit]" <%= role.permissions[area.key].edit ? 'checked' : '' %>></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <button type="submit" class="btn-edit"><%- icon('edit') %> Save permissions</button>
      </form>
    </div>
  </details>
<% }) %>

<%- include('partials/foot') %>
