<%- include('partials/head', { pageTitle: 'Translations', active: 'mqtt-to-loxone' }) %>

<p class="hint">
  Translation table for <code><%= mapping.mqtt_topic %></code> &rarr; <%= mapping.miniserver_name %> / <code><%= mapping.target %></code>.
  If the incoming value has no match here, it is passed through unchanged.
</p>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<% if (canEdit('mqtt_to_loxone')) { %>
<details class="add-panel">
  <summary>Add translation</summary>
  <div class="add-panel-body">
    <form method="post" action="/mappings/mqtt-to-loxone/<%= mapping.id %>/translations">
      <div class="form-grid">
        <div><label>Incoming value (e.g. "False")</label><input type="text" name="match_value" required></div>
        <div><label>Becomes (e.g. "0")</label><input type="text" name="output_value" required></div>
        <button type="submit" class="primary"><%- icon('plus') %> Add</button>
      </div>
    </form>
  </div>
</details>
<% } %>

<div class="filterable-table-card">
  <div class="table-toolbar">
    <div class="columns-menu columns-menu-inline" id="mt-columns-menu">
      <button type="button" class="btn-soft" id="mt-columns-btn"><%- icon('columns') %> Columns</button>
      <div class="columns-menu-panel" id="mt-columns-panel" hidden></div>
    </div>
  </div>
  <div class="table-wrap">
    <div id="mt-tabulator"
      data-delete-base-path="/mappings/mqtt-to-loxone/<%= mapping.id %>/translations"
      data-value-label="Incoming value"
      data-can-edit="<%= canEdit('mqtt_to_loxone') ? '1' : '' %>"></div>
  </div>
</div>
<script type="application/json" id="mt-rows"><%- JSON.stringify(translations) %></script>

<p><a href="/mappings/mqtt-to-loxone">&larr; Back to mappings</a></p>

<link rel="stylesheet" href="/vendor/tabulator.min.css">
<link rel="stylesheet" href="/tabulator-theme.css">
<script src="/vendor/tabulator.min.js"></script>
<script src="/vendor/floating-ui.core.umd.min.js"></script>
<script src="/vendor/floating-ui.dom.umd.min.js"></script>
<script src="/tabulator-table.js"></script>
<script src="/mapping-translations-tabulator.js"></script>

<%- include('partials/foot') %>
