<%- include('partials/head', { pageTitle: 'Translations', active: 'mqtt-to-loxone' }) %>

<p class="hint">
  Translation table for <code><%= mapping.mqtt_topic %></code> &rarr; <%= mapping.miniserver_name %> / <code><%= mapping.target %></code>.
  If the incoming value has no match here, it is passed through unchanged.
</p>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<% if (canEdit('mqtt_to_loxone')) { %>
<details class="add-panel">
  <summary>Add translation</summary>
  <div class="add-panel-body">
    <form method="post" action="/mappings/mqtt-to-loxone/<%= mapping.id %>/translations">
      <div class="form-grid">
        <div><label>Incoming value (e.g. "False")</label><input type="text" name="match_value" required></div>
        <div><label>Becomes (e.g. "0")</label><input type="text" name="output_value" required></div>
        <button type="submit" class="primary"><%- icon('plus') %> Add</button>
      </div>
    </form>
  </div>
</details>
<% } %>

<div class="table-wrap">
  <table>
    <thead>
      <tr><th>Incoming value</th><th>Becomes</th><th>Actions</th></tr>
    </thead>
    <tbody>
      <% translations.forEach(t => { %>
        <tr>
          <td><code><%= t.match_value %></code></td>
          <td><code><%= t.output_value %></code></td>
          <td>
            <% if (canEdit('mqtt_to_loxone')) { %>
            <form class="inline" method="post" action="/mappings/mqtt-to-loxone/<%= mapping.id %>/translations/<%= t.id %>/delete">
              <button type="submit" class="danger"><%- icon('trash') %> Delete</button>
            </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (translations.length === 0) { %>
        <tr><td colspan="3" class="empty">No translations yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<p><a href="/mappings/mqtt-to-loxone">&larr; Back to mappings</a></p>

<%- include('partials/foot') %>
