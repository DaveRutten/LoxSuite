<%- include('partials/head', { pageTitle: module.label, active: '' }) %>

<div class="card" style="max-width:640px;">
  <h2 style="margin-top:0;"><%= t('{module} is switched off', { module: t(module.label) }) %></h2>
  <p><%= t(module.description) %></p>
  <p class="hint"><%= t('Its data is kept; switching the module on brings everything back.') %></p>
  <% if (isAdminUser) { %>
    <a class="btn-edit" href="/admin/modules#mod-<%= module.key %>" style="text-decoration:none;"><%= t('Go to Modules') %></a>
  <% } else { %>
    <p class="hint"><%= t('Ask an administrator to switch it on under Administration > Modules.') %></p>
  <% } %>
</div>

<%- include('partials/foot') %>
