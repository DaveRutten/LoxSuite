<%- include('partials/head', { pageTitle: 'Dashboard', active: 'dashboard', refresh: 5, liveSwap: true, dashboardId: dashboard.id }) %>

<p class="hint">
<%= t('Logged in as') %> <strong><%= username %></strong>
</p>

<% const isCollapsed = (key) => collapsedSections.includes(key); %>

<% if (typeof energy !== 'undefined' && energy) {
     const nfd = (v, d = 1) => (v === null || v === undefined || !Number.isFinite(Number(v)) ? '—' : Number(v).toLocaleString('nl-NL', { minimumFractionDigits: d, maximumFractionDigits: d }));
     const R = (energy.meters && energy.meters.roles) || {}, P = energy.price || {}, H = energy.heatpump, S = energy.solar;
     const hm = (iso) => (iso ? new Date(iso).toLocaleTimeString('nl-NL', { hour: '2-digit', minute: '2-digit', timeZone: displayTimezone || 'UTC' }) : ''); %>
<button type="button" class="section-toggle" data-nav-section="home-energy" aria-expanded="<%= isCollapsed('home-energy') ? 'false' : 'true' %>">
  <h2><%= t('Energy') %></h2><%- icon('chevron') %>
</button>
<div class="section-body" <%= isCollapsed('home-energy') ? 'hidden' : '' %> style="margin-bottom:1.5rem;">
  <div class="stat-grid compact">
    <% if (R.grid) { %><a class="stat-card" href="/energy"><div class="label"><%= t('Grid now') %></div><div class="value" data-live-id="en-grid"><%= nfd(R.grid.power_kw, 2) %> kW</div></a><% } %>
    <% if (R.pv) { %><a class="stat-card" href="/energy"><div class="label"><%= t('Solar now') %></div><div class="value" data-live-id="en-pv"><%= nfd(R.pv.power_kw, 2) %> kW</div></a><% } %>
    <% if (energy.meters && energy.meters.house_kw !== null && energy.meters.house_kw !== undefined) { %><a class="stat-card" href="/energy"><div class="label"><%= t('House now') %></div><div class="value" data-live-id="en-house"><%= nfd(energy.meters.house_kw, 2) %> kW</div></a><% } %>
    <% if (P.now !== null && P.now !== undefined) { %><a class="stat-card" href="/planner"><div class="label"><%= t('Price now') %></div><div class="value" data-live-id="en-price">€ <%= nfd(P.now, 3) %></div><div class="hint" style="margin:0.2rem 0 0;" data-hint-keep data-live-id="en-price-range"><%= t('today') %> € <%= nfd(P.min, 3) %> (<%= hm(P.minAt) %>) – € <%= nfd(P.max, 3) %> (<%= hm(P.maxAt) %>)</div></a><% } %>
    <% if (H && H.state) { %><a class="stat-card" href="/energy-manager/modules/heatpump"><div class="label"><%= t('Heat pump') %></div><div class="value" data-live-id="en-hp"><%= { dhw: t('Tap water'), heating: t('Heating'), idle: t('Idle'), defrost: t('Defrosting'), fault: t('Fault') }[H.state.mode] || H.state.mode %></div><div class="hint" style="margin:0.2rem 0 0;" data-hint-keep data-live-id="en-hp-sub"><%= t('tank') %> <%= nfd(H.state.tankC) %> °C · <%= t('room') %> <%= nfd(H.state.roomC) %> °C<%= H.state.cop ? ' · COP ' + nfd(H.state.cop, 1) : '' %></div></a><% } %>
    <% if (S && S.limit) { %><a class="stat-card" href="/energy-manager/modules/solar"><div class="label"><%= t('Solar panels') %></div><div class="value" data-live-id="en-limit"><%= S.limit.pct %> %</div><div class="hint" style="margin:0.2rem 0 0;" data-hint-keep data-live-id="en-limit-sub"><%= S.limit.limit ? t('limited: exporting costs money') : t('no limit') %></div></a><% } %>
  </div>
</div>
<% } %>

<button type="button" class="section-toggle" data-nav-section="home-status" aria-expanded="<%= isCollapsed('home-status') ? 'false' : 'true' %>">
  <h2><%= t('Status') %></h2><%- icon('chevron') %>
</button>
<div class="section-body" <%= isCollapsed('home-status') ? 'hidden' : '' %> style="margin-bottom:1.5rem;">
  <div class="stat-grid compact">
    <div class="stat-card">
      <div class="label"><%= t('MQTT broker') %></div>
      <div class="value" data-live-id="stat-mqtt-status">
        <span class="badge badge-live <%= mqttConnected ? 'badge-ok' : 'badge-off' %>">
          <%= mqttConnected ? 'Connected' : 'Not connected' %>
        </span>
      </div>
    </div>
    <div class="stat-card">
      <div class="label"><%= t('Active mappings MQTT → Loxone') %></div>
      <div class="value" data-live-id="stat-map-in-count"><%= mqttToLoxoneCount %></div>
    </div>
    <div class="stat-card">
      <div class="label"><%= t('Active mappings Loxone → MQTT') %></div>
      <div class="value" data-live-id="stat-map-out-count"><%= loxoneToMqttCount %></div>
    </div>
  </div>
</div>

<button type="button" class="section-toggle" data-nav-section="home-load" aria-expanded="<%= isCollapsed('home-load') ? 'false' : 'true' %>">
  <h2><%= t('Load') %></h2><%- icon('chevron') %>
</button>
<div class="section-body" <%= isCollapsed('home-load') ? 'hidden' : '' %> style="margin-bottom:1.5rem;">
  <div class="stat-grid compact">
    <div class="stat-card">
      <div class="label"><%= t('Messages / sec (10s average)') %></div>
      <div class="value" data-live-id="stat-msgs-per-sec"><%= stats.messagesPerSecond %></div>
    </div>
    <div class="stat-card">
      <div class="label"><%= t('Total messages since start') %></div>
      <%
        // The title attribute has to live on an element INSIDE this div, not the div itself —
        // the live-refresh swap (foot.ejs's swapFrom) only ever replaces a [data-live-id]
        // element's innerHTML, never its own attributes, so a title placed directly on this div
        // would go stale (stuck at the page's first-load value) on every later refresh.
      %>
      <div class="value" data-live-id="stat-total-msgs"><span title="<%= stats.totalMessages %>"><%= formatCount(stats.totalMessages) %></span></div>
    </div>
    <div class="stat-card">
      <div class="label"><%= t('Unique topics seen') %></div>
      <div class="value" data-live-id="stat-topics-seen"><%= stats.topicsSeen %></div>
    </div>
    <div class="stat-card">
      <div class="label"><%= t('Connected MQTT clients') %></div>
      <div class="value" data-live-id="stat-connected-clients"><%= connectedClientCount %></div>
    </div>
  </div>
</div>

<button type="button" class="section-toggle" data-nav-section="home-miniservers" aria-expanded="<%= isCollapsed('home-miniservers') ? 'false' : 'true' %>">
  <h2><%= t('Miniservers') %></h2><%- icon('chevron') %>
</button>
<div class="section-body" <%= isCollapsed('home-miniservers') ? 'hidden' : '' %> style="margin-bottom:1.5rem;">
  <div class="filterable-table-card">
    <div class="table-toolbar">
      <div class="columns-menu columns-menu-inline" id="home-ms-columns-menu">
        <button type="button" class="btn-soft" id="home-ms-columns-btn"><%- icon('columns') %> <%= t('Columns') %></button>
        <div class="columns-menu-panel" id="home-ms-columns-panel" hidden></div>
      </div>
    </div>
    <div class="table-wrap">
      <div id="home-ms-tabulator"></div>
    </div>
  </div>
  <link rel="stylesheet" href="/vendor/tabulator.min.css">
  <link rel="stylesheet" href="/tabulator-theme.css">
  <script src="/vendor/tabulator.min.js"></script>
  <script src="/vendor/floating-ui.core.umd.min.js"></script>
  <script src="/vendor/floating-ui.dom.umd.min.js"></script>
  <script src="/tabulator-table.js"></script>
  <script src="/dashboard-miniservers-tabulator.js"></script>
</div>

<button type="button" class="section-toggle" data-nav-section="home-panels" aria-expanded="<%= isCollapsed('home-panels') ? 'false' : 'true' %>">
  <h2><%= t('Panels') %></h2><%- icon('chevron') %>
</button>
<div class="section-body" <%= isCollapsed('home-panels') ? 'hidden' : '' %>>
  <p class="hint">
    <%= t('Shared by everyone who logs in — charts, gauges, current values, and more, built from your') %>
    <a href="/monitor"><%= t('monitors') %></a><%= t('. Personal boards live under') %> <a href="/dashboards"><%= t('My Dashboards') %></a>
    <%= t('instead.') %>
  </p>

  <%- include('partials/panel-grid', { dashboardId: dashboard.id, panels: panels, monitors: monitors, canEditPanels: canEdit('dashboard'), defaultPanelDecimals: defaultPanelDecimals, panelTypeDefaultsExist: panelTypeDefaultsExist }) %>
</div>

<%- include('partials/foot') %>
