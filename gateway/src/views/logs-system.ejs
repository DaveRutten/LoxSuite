<%- include('partials/head', { pageTitle: 'Logs', active: 'logs-system', refresh: 5, liveSwap: true }) %>

<p class="hint">
  This gateway's own housekeeping events &mdash; e.g. a disconnected MQTT client getting
  auto-removed from <a href="/incoming/clients">Client Activity</a>. Persisted in SQLite and kept
  for <strong><%= retentionDays %></strong> days, same retention setting as the other two tabs
  &mdash; <% if (canEdit('settings')) { %><a href="/settings">change that in Settings</a><% } else { %>change that in Settings<% } %>.
</p>

<form method="get" action="/logs/system" class="form-grid" style="margin-bottom:1rem; align-items:end;">
  <div>
    <label>From</label>
    <input type="datetime-local" name="from" value="<%= query.from || '' %>">
  </div>
  <div>
    <label>To</label>
    <input type="datetime-local" name="to" value="<%= query.to || '' %>">
  </div>
  <div>
    <label>Contains</label>
    <input type="text" name="q" value="<%= query.q || '' %>" placeholder="Search log text">
  </div>
  <div style="display:flex; gap:0.5rem;">
    <button type="submit" class="btn-soft"><%- icon('filter') %> Apply</button>
    <a href="/logs/system"><button type="button" class="btn-soft">Clear</button></a>
  </div>
</form>

<div class="filterable-table-card">
  <div class="table-toolbar">
    <span class="log-selection-count hint" style="margin:0;"></span>
    <button type="button" class="btn-soft log-copy-selection" disabled><%- icon('copy') %> <span class="btn-label">Copy selection</span></button>
    <% if (canEdit('logs_system')) { %>
    <a href="/logs/system/export.txt"><button type="button" class="btn-soft"><%- icon('copy') %> Export .log</button></a>
    <% } %>
  </div>

  <div class="table-wrap">
  <table>
    <thead>
      <tr><th class="col-select" data-no-controls><input type="checkbox" class="log-select-all" title="Select all"></th><th>Time</th><th>Line</th></tr>
    </thead>
    <tbody>
      <% rows.forEach(r => { %>
        <tr>
          <td class="col-select"><input type="checkbox"></td>
          <td><%= formatDateTime(r.recordedAt) %></td>
          <td class="log-line"><%= r.line %></td>
        </tr>
      <% }) %>
      <% if (rows.length === 0) { %>
        <tr><td colspan="3" class="empty">No system events recorded yet.</td></tr>
      <% } %>
    </tbody>
  </table>
  </div>
</div>

<script src="/log-select.js" defer></script>
<%- include('partials/foot') %>
