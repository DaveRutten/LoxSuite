<%- include('partials/head', { pageTitle: 'Vehicle: ' + v.name, active: 'vehicles' }) %>

<p><a href="/vehicles"><%= t('← All vehicles') %></a></p>
<% if (error) { %><p class="error"><%= error %></p><% } %>
<% if (saved) { %><p class="hint" style="color: var(--success);"><%= t('Saved.') %></p><% } %>

<div class="card">
  <h2 style="margin-top:0;"><%= t('Now') %></h2>
  <div id="veh-status"><p class="hint" style="margin:0;"><%= t('Loading…') %></p></div>
  <div id="veh-map" hidden style="margin-top:0.8rem;"></div>
</div>

<% if (v.source_type !== 'none' && canEdit('monitor')) { %>
<div class="card">
  <details>
    <summary><strong><%= t('Use in Monitor, dashboards & Loxone') %></strong></summary>
    <p class="hint">
      <%= t('LoxSuite publishes this car\'s values as retained MQTT topics (') %><code>loxsuite/vehicles/<%= v.id %>/&hellip;</code><%= t(', on change). Add them as monitors, or map them to Loxone under Mappings.') %>
    </p>
    <div id="veh-monitor-picks"></div>
    <div class="btn-row" style="margin-top:0.6rem;"><button type="button" class="btn-soft" id="veh-monitor-btn"><%- icon('plus') %> <%= t('Add selected to Monitor') %></button></div>
    <div id="veh-monitor-result" class="hint" style="margin-top:0.4rem;"></div>
  </details>
</div>
<% } %>

<% if (canEdit('vehicles')) { %>
<div class="card">
  <form method="post" action="/vehicles/<%= v.id %>/update">
    <%- include('partials/vehicle-fields', { v, fields, presets }) %>
    <div class="btn-row" style="margin-top:0.9rem;">
      <button type="submit" class="btn-edit"><%- icon('edit') %> <%= t('Save') %></button>
    </div>
  </form>
  <form method="post" action="/vehicles/<%= v.id %>/delete" style="margin-top:0.8rem;" onsubmit="return confirm(<%= JSON.stringify(t('Delete this vehicle and its history?')) %>);">
    <button type="submit" class="btn-soft"><%- icon('trash') %> <%= t('Delete') %></button>
  </form>
</div>
<% } %>

<script>
(function () {
  var el = document.getElementById('veh-status');
  var srcLabels = <%- JSON.stringify(sourceLabels) %>;
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function dt(s) { return s ? new Date(s).toLocaleString() : '—'; }
  function yn(b, yes, no) { return b === true ? yes : b === false ? no : 'unknown'; }
  function tile(label, value, sub) {
    return '<div style="flex:1; min-width:140px; border:1px solid var(--border); border-radius:10px; padding:0.6rem 0.8rem;">' +
      '<div class="hint" style="margin:0; font-size:0.72rem; text-transform:uppercase; letter-spacing:0.04em;">' + esc(label) + '</div>' +
      '<div style="font-size:1.3rem; font-weight:700;">' + value + '</div>' + (sub ? '<div class="hint" style="margin:0; font-size:0.75rem;">' + sub + '</div>' : '') + '</div>';
  }
  function render(s) {
    if (s.sourceType === 'none') { el.innerHTML = '<p class="hint" style="margin:0;">No data source: the charging planner estimates the battery level.</p>'; return; }
    if (!s.enabled) { el.innerHTML = '<p class="hint" style="margin:0;">Disabled.</p>'; return; }
    var r = s.reading || {};
    var h = s.health || { status: 'unknown' };
    var badge = h.status === 'ok' ? '<span style="color:var(--success); font-weight:600;" title="working">● <span class="hide-phone">working</span></span>'
      : h.status === 'failing' ? '<span style="color:var(--danger); font-weight:600;">● failing</span> <span class="hint">' + esc(h.detail) + '</span>'
      : '<span class="hint">● ' + esc(h.detail || 'not read yet') + '</span>';
    var html = '<p style="margin:0 0 0.6rem;">' + esc(srcLabels[s.sourceKind || s.sourceType] || s.sourceType) + ': ' + badge + '</p>';
    var soc = r.soc != null ? r.soc + '%' : '—';
    html += '<div style="display:flex; gap:0.7rem; flex-wrap:wrap;">' +
      tile('Battery', soc, r.energy_kwh != null ? r.energy_kwh + ' kWh' + (r.limit_soc != null ? ' · limit ' + r.limit_soc + '%' : '') : (r.limit_soc != null ? 'limit ' + r.limit_soc + '%' : '')) +
      tile('Electric range', r.range_km != null ? (r.range_estimated ? '≈ ' : '') + r.range_km + ' km' : '—', r.total_range_km != null ? 'total incl. fuel ' + r.total_range_km + ' km' : '') +
      tile('Plugged in', yn(r.plugged, 'yes', 'no'), r.charging === true ? 'charging' : r.charging === false ? 'not charging' : '') +
      tile('At home', yn(r.home, 'yes', 'no'), r.distance_m != null ? (r.distance_m < 2000 ? r.distance_m + ' m' : (r.distance_m / 1000).toFixed(1) + ' km') + ' from home' : (r.location ? esc(r.location) : '')) +
      tile('Odometer', r.odometer_km != null ? Math.round(r.odometer_km) + ' km' : '—', '') +
      '</div>';
    if (s.sourceKind === 'skoda') {
      var x = s.extra || {};
      var bits = [];
      if (x.chargeState) bits.push('Charging state: ' + esc(x.chargeState) + (x.chargePowerKw ? ' (' + x.chargePowerKw + ' kW)' : '') + (x.minutesToFull ? ' · ' + x.minutesToFull + ' min to full' : ''));
      if (x.fuelPct != null) bits.push('Fuel: ' + x.fuelPct + '%');
      if (x.climate && x.climate !== 'UNSUPPORTED') bits.push('Climate: ' + esc(x.climate));
      if (s.rateRemaining != null) bits.push('Škoda requests left this hour: ' + s.rateRemaining);
      if (s.keyExpiresAt) {
        var days = Math.round((Date.parse(s.keyExpiresAt) - Date.now()) / 86400000);
        bits.push('<span style="color:' + (days <= 14 ? 'var(--danger)' : 'inherit') + ';">API key valid until ' + esc(new Date(s.keyExpiresAt).toLocaleDateString()) + (days <= 14 ? ' — renew it in the MyŠkoda app' : '') + '</span>');
      }
      if ((x.errors || []).length) bits.push('Car reports: ' + x.errors.map(esc).join('; '));
      if (bits.length) html += '<p class="hint" style="margin:0.6rem 0 0;">' + bits.join(' &middot; ') + '</p>';
    }
    html += '<p class="hint" style="margin:0.6rem 0 0;">Data from the car: ' + esc(dt(s.sourceUpdatedAt)) + ' &middot; last read: ' + esc(dt(s.fetchedAt)) +
      ' &middot; alert after ' + s.staleAfterH + ' h without an update' + (s.staleAfterH === 0 ? ' (off)' : '') + '</p>';
    el.innerHTML = html;
    // where the car is (only redrawn when it moved)
    var pos = r.latitude != null && r.longitude != null ? Number(r.latitude).toFixed(5) + ',' + Number(r.longitude).toFixed(5) : '';
    if (pos !== lastPos) { lastPos = pos; window.lsMiniMap(document.getElementById('veh-map'), pos ? [{ lat: Number(r.latitude), lon: Number(r.longitude), label: '' }] : [], { height: 220 }); }
  }
  var lastPos = null;
  function tick() { fetch('/vehicles/<%= v.id %>/status.json').then(function (r) { return r.json(); }).then(render).catch(function () {}); }
  tick();
  setInterval(tick, 10000);
  var picks = document.getElementById('veh-monitor-picks');
  if (picks) window.lsMonitorPicks(picks, {
    items: <%- JSON.stringify(Object.entries(topics).map(([k, tp]) => ({ key: k, label: t(topicLabels[k]), topic: tp, monitorId: monitored[k] || null }))) %>,
    postUrl: '/vehicles/<%= v.id %>/monitor', button: document.getElementById('veh-monitor-btn'), out: document.getElementById('veh-monitor-result'),
  });
})();
</script>

<%- include('partials/foot') %>
