<%- include('partials/head', { pageTitle: 'Administration', active: 'admin' }) %>

<div class="tabs">
  <a href="/admin/general"><%= t('General') %></a>
  <a class="active" href="/admin/users"><%= t('Users') %></a>
  <a href="/admin/roles"><%= t('Access Roles') %></a>
  <a href="/admin/backup"><%= t('Backups') %></a>
  <a href="/admin/notifications"><%= t('Notifications') %></a>
  <a href="/admin/security"><%= t('Security') %></a>
  <a href="/admin/modules"><%= t('Modules') %></a>
  <a href="/admin/languages"><%= t('Languages') %></a>
  <% if (typeof moduleOn !== 'function' || moduleOn('ai')) { %><a href="/admin/ai"><%= t('AI Assistant') %></a><% } %>
</div>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<p class="hint">
  <%= t('Web UI accounts and their Access Role. This is separate from') %> <a href="/mqtt-users"><%= t('MQTT Users') %></a><%= t(', which governs which IoT devices can connect to the broker, not who can use this web interface.') %>
</p>

<details class="add-panel">
  <summary><%= t('Add local user') %></summary>
  <div class="add-panel-body">
    <form method="post" action="/admin/users">
      <div class="form-grid">
        <div><label><%= t('Username') %></label><input type="text" name="username" required></div>
        <div><label><%= t('Password') %></label><input type="password" name="password" required minlength="8"></div>
        <div><label><%= t('First name (optional)') %></label><input type="text" name="first_name"></div>
        <div><label><%= t('Last name (optional)') %></label><input type="text" name="last_name"></div>
        <div>
          <label><%= t('Access Role') %></label>
          <select name="role_id">
            <% roles.forEach(r => { %><option value="<%= r.id %>"><%= r.name %></option><% }) %>
          </select>
        </div>
        <button type="submit" class="primary"><%- icon('plus') %> <%= t('Add') %></button>
      </div>
    </form>
  </div>
</details>

<div class="table-wrap">
  <table>
    <thead><tr><th></th><th><%= t('Username') %></th><th><%= t('Name') %></th><th><%= t('Signs in via') %></th><th><%= t('Status') %></th><th><%= t('Last login') %></th><th><%= t('Access Role') %></th><th><%= t('Actions') %></th></tr></thead>
    <tbody>
      <% users.forEach(u => { %>
        <% const fullName = [u.first_name, u.last_name].filter(Boolean).join(' ') || u.display_name || ''; %>
        <tr>
          <td>
            <% if (u.avatar_url) { %>
              <img src="/avatar/<%= u.id %>" alt="" class="account-menu-avatar">
            <% } else { %>
              <span class="account-menu-avatar account-menu-avatar-fallback"><%= (fullName || u.username).charAt(0).toUpperCase() %></span>
            <% } %>
          </td>
          <td><%= u.username %></td>
          <td><%= fullName || '-' %></td>
          <td><%= u.auth_provider === 'local' ? 'Password' : 'Pocket ID (SSO)' %></td>
          <td><% if (u.disabled_at) { %><span class="badge badge-off"><%= t('Disabled') %></span><% } else { %><span class="badge badge-ok"><%= t('Active') %></span><% } %></td>
          <td><%= u.last_login_at ? formatDateTime(u.last_login_at) : '-' %></td>
          <td>
            <form class="inline" method="post" action="/admin/users/<%= u.id %>/role" style="display:flex; gap:0.6rem; align-items:center;">
              <select name="role_id">
                <% roles.forEach(r => { %><option value="<%= r.id %>" <%= r.id === u.role_id ? 'selected' : '' %>><%= r.name %></option><% }) %>
              </select>
              <button type="submit" class="btn-edit"><%- icon('edit') %> <%= t('Save') %></button>
            </form>
          </td>
          <td>
            <div class="row-actions">
              <% if (u.auth_provider === 'local') { %>
                <button type="button" class="btn-edit" data-toggle-row="admin-edit-name-<%= u.id %>"><%- icon('edit') %> <%= t('Edit name') %></button>
                <button type="button" class="btn-edit" data-toggle-row="admin-reset-pw-<%= u.id %>"><%- icon('edit') %> <%= t('Reset password') %></button>
              <% } %>
              <% if (u.disabled_at) { %>
                <form class="inline" method="post" action="/admin/users/<%= u.id %>/enable">
                  <button type="submit" class="btn-edit"><%- icon('power') %> <%= t('Enable') %></button>
                </form>
              <% } else { %>
                <form class="inline" method="post" action="/admin/users/<%= u.id %>/disable" data-confirm="<%= t('Disable this user? They will be signed out and unable to log in until re-enabled.') %>">
                  <button type="submit" class="danger"><%- icon('power') %> <%= t('Disable') %></button>
                </form>
              <% } %>
              <form class="inline" method="post" action="/admin/users/<%= u.id %>/delete" data-confirm="<%= t('Delete this user?') %>">
                <button type="submit" class="danger"><%- icon('trash') %> <%= t('Delete') %></button>
              </form>
            </div>
          </td>
        </tr>
        <% if (u.auth_provider === 'local') { %>
        <tr class="expand-row" id="admin-edit-name-<%= u.id %>">
          <td colspan="8">
            <form method="post" action="/admin/users/<%= u.id %>/name" style="display:flex; gap:0.6rem; align-items:center; flex-wrap:wrap;">
              <label style="margin:0; font-size:0.85rem; color:var(--text-muted);"><%= t('First name:') %></label>
              <input type="text" name="first_name" value="<%= u.first_name || '' %>" style="max-width:12rem;">
              <label style="margin:0; font-size:0.85rem; color:var(--text-muted);"><%= t('Last name:') %></label>
              <input type="text" name="last_name" value="<%= u.last_name || '' %>" style="max-width:12rem;">
              <button type="submit" class="btn-edit"><%- icon('edit') %> <%= t('Save') %></button>
            </form>
          </td>
        </tr>
        <tr class="expand-row" id="admin-reset-pw-<%= u.id %>">
          <td colspan="8">
            <form method="post" action="/admin/users/<%= u.id %>/reset-password" style="display:flex; gap:0.6rem; align-items:center; flex-wrap:wrap;">
              <label style="margin:0; font-size:0.85rem; color:var(--text-muted);"><%= t('New password:') %></label>
              <input type="password" name="password" required minlength="8" style="max-width:14rem;">
              <button type="submit" class="btn-edit"><%- icon('edit') %> <%= t('Set password') %></button>
            </form>
          </td>
        </tr>
        <% } %>
      <% }) %>
      <% if (users.length === 0) { %>
        <tr><td colspan="8" class="empty"><%= t('No users found.') %></td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('partials/foot') %>
