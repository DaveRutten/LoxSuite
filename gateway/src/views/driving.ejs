<%- include('partials/head', { pageTitle: 'Driving & costs', active: 'driving' }) %>

<p class="hint">
  <%= t('How the car is driven and what it costs, from its own odometer and battery percentage (Wallbox > Vehicles). The electric consumption is learned from the battery drop per km on stretches where the battery didn\'t run empty; LoxSuite plans with it unless you set a consumption yourself.') %> <span id="dr-meta"></span>
</p>

<% if (cars.length > 1) { %>
<div class="tabs" style="margin-bottom:0.8rem;">
  <% cars.forEach(c => { %><a href="/driving?vehicle=<%= c.id %>" class="tab <%= c.id === vehicleId ? 'active' : '' %>"><%= c.name %></a><% }) %>
</div>
<% } %>

<div id="dr-warn"></div>

<div class="card" data-no-collapse>
  <div id="dr-tiles" class="ls-tiles"><p class="hint" style="margin:0;"><%= t('Loading…') %></p></div>
</div>

<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(460px,100%),1fr)); gap:1rem;">
  <div class="card">
    <h2 style="margin-top:0;"><%= t('Km per month') %></h2>
    <div id="dr-km"></div>
  </div>
  <div class="card">
    <h2 style="margin-top:0;"><%= t('Consumption per month') %></h2>
    <p class="hint" style="margin:0 0 0.4rem;"><%= t('kWh per 100 km on electricity — usually higher in winter (heating, cold battery).') %></p>
    <div id="dr-cons"></div>
  </div>
</div>

<div class="card">
  <h2 style="margin-top:0;"><%= t('Per month') %></h2>
  <div style="overflow-x:auto;"><table id="dr-months"><tbody><tr><td class="hint"><%= t('Loading…') %></td></tr></tbody></table></div>
  <p class="hint" id="dr-cost-note" style="margin:0.5rem 0 0; font-size:0.8rem;"></p>
</div>

<div class="card">
  <h2 style="margin-top:0;"><%= t('Recent trips') %></h2>
  <div style="overflow-x:auto;"><table id="dr-trips"><tbody><tr><td class="hint"><%= t('Loading…') %></td></tr></tbody></table></div>
</div>

<script>
(function () {
  var VID = <%- JSON.stringify(vehicleId) %>;
  function nf(v, d) { return v == null ? '—' : Number(v).toLocaleString(undefined, { minimumFractionDigits: d, maximumFractionDigits: d }); }
  function eur(v, d) { return v == null ? '—' : '€ ' + nf(v, d == null ? 2 : d); }
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function monthLabel(m) { var p = m.split('-'); return new Date(+p[0], +p[1] - 1, 1).toLocaleDateString(undefined, { month: 'short', year: '2-digit' }); }
  function tile(label, value, sub, color) {
    return '<div class="ls-tile"><div class="ls-tile-label">' + label + '</div>' +
      '<div class="ls-tile-value"' + (color ? ' style="color:' + color + ';"' : '') + '>' + value + '</div>' + (sub ? '<div class="ls-tile-sub">' + sub + '</div>' : '') + '</div>';
  }
  var CONF = { high: 'var(--success)', medium: '#d4a017', low: 'var(--danger, #c0392b)', none: 'var(--text-muted)' };

  // km per month: on electricity (the car's color) and on fuel stacked, soft columns with a 2px gap
  function kmChart(months, phev) {
    if (!months.length) return '<p class="hint" style="margin:0;">No driving recorded yet.</p>';
    var C = window.LsChart;
    var W = lsChartW(document.getElementById('dr-km'), 520), H = 170, max = Math.max.apply(null, months.map(function (m) { return (m.elecKm || 0) + (m.fuelKm || 0) + (m.unknownKm || 0); }).concat([10]));
    var bw = (W - 40) / months.length, bwid = Math.min(bw * 0.62, 44), off = (bw - bwid) / 2;
    var s = '<svg viewBox="0 0 ' + W + ' ' + (H + 24) + '" width="100%" style="display:block;">' + C.hline(30, W - 4, 4, 0.06) + C.hline(30, W - 4, 4 + H / 2, 0.06) + C.hline(30, W - 4, H + 4, 0.2);
    months.forEach(function (m, i) {
      var x = 30 + i * bw + off, e = (m.elecKm || 0) / max * H, f = (m.fuelKm || 0) / max * H, u = (m.unknownKm || 0) / max * H;
      var y = H + 4, parts = [];
      if (e > 0.5) parts.push([e, 'var(--en-car)', 0.75, esc(monthLabel(m.month)) + ': ' + nf(m.elecKm, 0) + ' km electric']);
      if (f > 0.5) parts.push([f, 'var(--en-import)', 0.6, nf(m.fuelKm, 0) + ' km on fuel']);
      if (u > 0.5) parts.push([u, 'currentColor', 0.15, nf(m.unknownKm, 0) + ' km (no battery data)']);
      parts.forEach(function (pt, k) {
        var top = k === parts.length - 1, gap = k ? 2 : 0;
        s += C.col(x, y - pt[0] + gap, bwid, Math.max(0.5, pt[0] - gap), { color: pt[1], opacity: pt[2], r: top ? 4 : 0, title: pt[3] });
        y -= pt[0];
      });
      s += '<text x="' + (x + bwid / 2) + '" y="' + (H + 20) + '" text-anchor="middle" font-size="10" fill="currentColor" opacity="0.6">' + esc(monthLabel(m.month)) + '</text>';
    });
    s += '<text x="26" y="12" text-anchor="end" font-size="9" fill="currentColor" opacity="0.55">' + Math.round(max) + '</text></svg>';
    s += '<div class="hint" style="margin:0.3rem 0 0;"><span style="display:inline-block; width:0.7em; height:0.7em; border-radius:2px; background:var(--en-car);"></span> <span>on electricity</span>' + (phev ? ' &nbsp;<span style="display:inline-block; width:0.7em; height:0.7em; border-radius:2px; background:var(--en-import);"></span> on fuel' : '') + '</div>';
    return s;
  }
  // kWh per 100 km per month: a smooth line with a light wash, the value on each point, the average as a hairline
  function consChart(months, avg) {
    var pts = months.filter(function (m) { return m.kwhPer100 != null; });
    if (!pts.length) return '<p class="hint" style="margin:0;">Not enough electric driving per month yet (at least 20 km with battery data).</p>';
    var C = window.LsChart;
    var W = lsChartW(document.getElementById('dr-cons'), 520), H = 150, max = Math.max.apply(null, pts.map(function (m) { return m.kwhPer100; }).concat([avg || 0, 10])) * 1.15;
    var bw = (W - 40) / pts.length;
    var X = function (i) { return 30 + i * bw + bw / 2; }, Y = function (v) { return H + 4 - v / max * H; };
    var s = '<svg viewBox="0 0 ' + W + ' ' + (H + 24) + '" width="100%" style="display:block;">' + C.hline(30, W - 4, H + 4, 0.2);
    if (avg) { var ay = Y(avg); s += '<line x1="30" x2="' + (W - 4) + '" y1="' + ay + '" y2="' + ay + '" stroke="currentColor" stroke-dasharray="2 4" opacity="0.45"/><text x="' + (W - 4) + '" y="' + (ay - 4) + '" text-anchor="end" font-size="9" fill="currentColor" opacity="0.7">avg ' + nf(avg, 1) + '</text>'; }
    var line = pts.map(function (m, i) { return [X(i), Y(m.kwhPer100)]; });
    if (line.length > 1) s += C.wash(line, H + 4, 'var(--en-car)', 0.2) + C.line(line, 'var(--en-car)');
    pts.forEach(function (m, i) {
      s += '<circle cx="' + X(i) + '" cy="' + Y(m.kwhPer100) + '" r="4" style="fill:var(--en-car); stroke:var(--surface, #fff);" stroke-width="2"><title>' + esc(monthLabel(m.month)) + ': ' + nf(m.kwhPer100, 1) + ' kWh/100 km</title></circle>' +
        '<text x="' + X(i) + '" y="' + (Y(m.kwhPer100) - 9) + '" text-anchor="middle" font-size="9.5" font-weight="600" fill="currentColor" opacity="0.8">' + nf(m.kwhPer100, 1) + '</text>' +
        '<text x="' + X(i) + '" y="' + (H + 20) + '" text-anchor="middle" font-size="10" fill="currentColor" opacity="0.6">' + esc(monthLabel(m.month)) + '</text>';
    });
    return s + '</svg>';
  }

  fetch('/driving/data.json' + (VID ? '?vehicle=' + VID : '')).then(function (r) { return r.json(); }).then(function (d) {
    if (d.error) { document.getElementById('dr-tiles').innerHTML = '<p class="hint" style="margin:0;">' + esc(d.error) + '</p>'; return; }
    var v = d.vehicle, phev = v.type === 'phev';
    var warn = [];
    var TR = function (k, a) { var s2 = (window.LS_I18N && window.LS_I18N[k]) || k; return esc(s2).replace('{0}', esc(a || '')); };
    if (!v.hasOdometerField) warn.push(TR('The odometer of {0} is not mapped yet — map it under Vehicles to see trips and km (Homey: often meter_mileage / odometer; the Škoda API gives it by itself).', v.name) + ' <a href="/vehicles">' + TR('Vehicles') + '</a>');
    if (!v.hasSocField) warn.push(TR('The battery % is not mapped yet — without it the consumption and the electric/fuel split can\'t be learned.'));
    if (!v.battery_kwh) warn.push('No <strong>battery size</strong> set for ' + esc(v.name) + ' &mdash; needed to turn battery % into kWh.');
    document.getElementById('dr-warn').innerHTML = warn.map(function (w) { return '<p class="hint" style="border-left:3px solid #d4a017; padding-left:0.6rem;">' + w + '</p>'; }).join('');

    var c = d.consumption, cur = d.months[d.months.length - 1] || null, tot = d.months.reduce(function (a, m) { a.km += m.km || 0; a.e += m.elecKm || 0; a.f += m.fuelKm || 0; return a; }, { km: 0, e: 0, f: 0 });
    var used = v.kwh_per_km ? TR('your own setting: {0} kWh/100 km', nf(v.kwh_per_km * 100, 1)) : (c.kwhPer100 && c.confidence !== 'none' ? TR('used for planning') : TR('not enough data yet — planning uses {0}', nf(d.kwhPerKmUsed * 100, 1)));
    var tiles = [
      tile('Electric consumption', c.kwhPer100 != null ? nf(c.kwhPer100, 1) + ' <small>kWh/100 km</small>' : '—',
        '<span style="color:' + CONF[c.confidence] + ';">' + c.confidence + '</span> · ' + nf(c.km, 0) + ' km · ' + used),
      tile('Driven this month', nf(cur ? cur.km : 0, 0) + ' <small>km</small>', cur ? TR('{0} trips, on average {1} km', cur.trips).replace('{1}', nf(cur.avgTripKm, 0)) : ''),
    ];
    if (phev) tiles.push(tile('On electricity', tot.e + tot.f > 0 ? Math.round(tot.e / (tot.e + tot.f) * 100) + '%' : '—', nf(tot.e, 0) + ' km electric · ' + nf(tot.f, 0) + ' km fuel'));
    tiles.push(tile('Cost per km', eur(d.prices.elecPerKm, 3), 'electric · fuel ' + eur(d.prices.fuelPerKm, 3) + ' (' + eur(d.prices.fuelEurL) + '/l)'));
    tiles.push(tile('Saved by driving electric', eur(d.savedTotal, 0), 'vs. the same km on fuel', d.savedTotal > 0 ? 'var(--success)' : null));
    document.getElementById('dr-tiles').innerHTML = tiles.join('');
    document.getElementById('dr-meta').textContent = phev && d.emptyLevel ? 'The hybrid switches to fuel at about ' + Math.round(d.emptyLevel) + '% (learned).' : '';

    var drawCharts = function () {
      document.getElementById('dr-km').innerHTML = kmChart(d.months.slice(-12), phev);
      document.getElementById('dr-cons').innerHTML = consChart(d.months.slice(-12), c.kwhPer100);
    };
    drawCharts();
    lsOnResize(drawCharts);

    var mh = '<thead><tr><th>Month</th><th>Km</th>' + (phev ? '<th>Electric</th><th>Fuel</th>' : '') + '<th>Trips</th><th>Avg trip</th><th>kWh/100 km</th><th>Charged</th><th>Solar</th><th>€/kWh</th><th>€/km elec.</th><th>€/km fuel</th><th>Saved</th></tr></thead><tbody>';
    if (!d.months.length) mh += '<tr><td colspan="13" class="hint">No driving recorded yet.</td></tr>';
    d.months.slice().reverse().forEach(function (m) {
      mh += '<tr><td><strong>' + esc(monthLabel(m.month)) + '</strong></td><td>' + nf(m.km, 0) + '</td>' +
        (phev ? '<td>' + nf(m.elecKm, 0) + (m.elecShare != null ? ' <span class="hint">(' + m.elecShare + '%)</span>' : '') + '</td><td>' + nf(m.fuelKm, 0) + '</td>' : '') +
        '<td>' + m.trips + '</td><td>' + nf(m.avgTripKm, 0) + ' km</td><td>' + nf(m.kwhPer100, 1) + '</td><td>' + (m.chargedKwh != null ? nf(m.chargedKwh, 0) + ' kWh' : '—') + '</td>' +
        '<td>' + (m.solarShare != null ? m.solarShare + '%' : '—') + '</td><td>' + eur(m.eurPerKwh, 3) + (m.eurPerKwhEstimated && m.eurPerKwh != null ? '*' : '') + '</td><td>' + eur(m.elecEurKm, 3) + '</td><td>' + eur(m.fuelEurKm, 3) + '</td>' +
        '<td style="color:' + (m.saved > 0 ? 'var(--success)' : 'inherit') + ';">' + eur(m.saved, 0) + '</td></tr>';
    });
    document.getElementById('dr-months').innerHTML = mh + '</tbody>';
    document.getElementById('dr-cost-note').innerHTML = 'Charging cost per hour from the Wallbox and grid meters: grid energy at that hour\'s all-in price, solar at its feed-in value (as in Smart charging). ' +
      '* = no meter data for that month, estimated from the average price. Fuel at today\'s price' + (v.fuel_l_per_100km ? ' and ' + nf(v.fuel_l_per_100km, 1) + ' l/100 km' : ', compared with a car using 6.5 l/100 km') + '.';

    var th = '<thead><tr><th>Date</th><th>Duration</th><th>Km</th>' + (phev ? '<th>Electric</th><th>Fuel</th>' : '') + '<th>Battery</th><th>kWh</th><th>kWh/100 km</th></tr></thead><tbody>';
    if (!d.trips.length) th += '<tr><td colspan="8" class="hint">No trips yet &mdash; they appear once the odometer changes between readings.</td></tr>';
    d.trips.forEach(function (t) {
      var dt = new Date(t.start);
      th += '<tr><td>' + dt.toLocaleDateString(undefined, { weekday: 'short', day: 'numeric', month: 'short' }) + ' ' + dt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + '</td>' +
        '<td>' + (t.minutes >= 60 ? Math.floor(t.minutes / 60) + ' h ' + (t.minutes % 60) + ' min' : t.minutes + ' min') + '</td><td><strong>' + nf(t.km, 1) + '</strong></td>' +
        (phev ? (t.unknownKm > 0 ? '<td class="hint" title="no battery data for (part of) this trip">—</td><td class="hint">—</td>' : '<td>' + nf(t.elecKm, 0) + '</td><td>' + nf(t.fuelKm, 0) + '</td>') : '') +
        '<td>' + (t.socFrom != null ? Math.round(t.socFrom) + '% → ' + Math.round(t.socTo) + '%' : '—') + '</td><td>' + nf(t.kwh, 1) + '</td><td>' + nf(t.kwhPer100, 1) + '</td></tr>';
    });
    document.getElementById('dr-trips').innerHTML = th + '</tbody>';
    lsMoreRows(document.getElementById('dr-trips'), 10);
  }).catch(function (e) { document.getElementById('dr-tiles').innerHTML = '<p class="error">' + esc(e.message) + '</p>'; });
})();
</script>

<%- include('partials/foot') %>
