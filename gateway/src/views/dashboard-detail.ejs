<%- include('partials/head', { pageTitle: dashboard.name, active: 'dashboards', refresh: 5, liveSwap: true, dashboardId: dashboard.id, canEditPanels: canEditPanels, topbarRange: true, topbarRangeValue: currentRange, topbarRangeBlankLabel: 'Default range' }) %>

<p class="hint">
  <span>
    <a href="/dashboards">&larr; back to My Dashboards</a>
    <% if (sharedByOwner) { %>
      &mdash; shared with you by <%= sharedByOwner %><%= canEditPanels ? ' (you can edit)' : ' (view only)' %>
    <% } %>
  </span>
</p>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<%- include('partials/panel-grid', { dashboardId: dashboard.id, panels: panels, monitors: monitors, canEditPanels: canEditPanels, defaultPanelDecimals: defaultPanelDecimals, panelTypeDefaultsExist: panelTypeDefaultsExist, isFavorited: isFavorited }) %>

<%- include('partials/foot') %>
