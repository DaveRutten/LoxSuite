<%- include('partials/head', { pageTitle: dashboard.name, active: 'dashboards', refresh: 5, liveSwap: true, dashboardRange: true, dashboardId: dashboard.id }) %>

<p class="hint" style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
  <span>
    <a href="/dashboards">&larr; back to My Dashboards</a>
    <% if (sharedByOwner) { %>
      &mdash; shared with you by <%= sharedByOwner %><%= canEditPanels ? ' (you can edit)' : ' (view only)' %>
    <% } %>
  </span>
  <form method="post" action="/dashboards/<%= dashboard.id %>/<%= isFavorited ? 'unfavorite' : 'favorite' %>" style="margin-left:auto;">
    <input type="hidden" name="redirect_to" value="/dashboards/<%= dashboard.id %>">
    <button type="submit" class="btn-soft favorite-toggle-btn <%= isFavorited ? 'is-favorited' : '' %>" title="<%= isFavorited ? 'Remove from the sidebar (Monitor → Favorite Dashboards)' : 'Add to the sidebar (Monitor → Favorite Dashboards)' %>">
      <%- icon('star') %> <%= isFavorited ? 'In sidebar' : 'Add to sidebar' %>
    </button>
  </form>
</p>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<%- include('partials/panel-grid', { dashboardId: dashboard.id, panels: panels, monitors: monitors, canEditPanels: canEditPanels, defaultPanelDecimals: defaultPanelDecimals, panelTypeDefaultsExist: panelTypeDefaultsExist }) %>

<%- include('partials/foot') %>
