<%- include('partials/head', { pageTitle: load.name, active: 'energymanager' }) %>

<p style="margin:0 0 0.8rem;"><a href="/energy-manager">&larr; <%= t('Energy manager') %></a></p>

<div class="card" data-card-key="now">
  <h2 style="margin-top:0;"><%= t('Now') %></h2>
  <p class="hint" style="margin:-0.5rem 0 0.7rem;"><%= t(kinds[load.kind] ? kinds[load.kind].label : load.kind) %> · <span id="el-updated"></span></p>
  <div id="el-tiles" class="ls-tiles"></div>
  <p class="hint" id="el-weather" style="margin:0.7rem 0 0;"></p>
  <p class="hint" style="margin:0.6rem 0 0;">
    <%= t('Signals:') %>
    <%= [load.meter_uuid ? t('Loxone meter') : null, src.onoff ? t('on/off') : null, src.status ? t('status') : null, src.power ? t('power') : null, src.energy ? t('energy counter') : null, src.temp ? t('temperature') : null, src.startIn ? t('scheduled start') : null, src.ready ? t('ready to start') : null].filter(Boolean).join(' · ') || t('none yet — add them under Consumers') %>
  </p>
</div>

<% if (canEdit('energy_manager')) { %>
<div class="card" id="history" data-card-key="history">
  <h2 style="margin-top:0;"><%= t('History from Loxone') %></h2>
  <p class="hint" style="margin:-0.4rem 0 0.6rem;"><%= t('Reads the kWh per hour from the Miniserver\'s own statistics (its meter block) and learns from it straight away — for an appliance its runs as well. Hours LoxSuite measured itself are kept.') %></p>
  <% if (!load.meter_uuid) { %><p class="hint" style="margin:0;"><%= t('Choose a Loxone meter for this consumer first (Administration → Energy & charging → Energy manager).') %></p><% } else { %>
  <div class="btn-row" style="margin:0; align-items:flex-end;">
    <div><label><%= t('Period') %></label><select id="el-import-days"><option value="7"><%= t('last 7 days') %></option><option value="30" selected><%= t('last 30 days') %></option><option value="90"><%= t('last 3 months') %></option><option value="365"><%= t('last year') %></option></select></div>
    <button type="button" class="btn-soft" id="el-import"><%= t('Read from Loxone') %></button>
  </div>
  <p class="hint" id="el-import-msg" style="margin:0.4rem 0 0;"></p>
  <% } %>
</div>
<% } %>

<div class="card">
  <h2 style="margin-top:0;"><%= t('Last 48 hours') %></h2>
  <div id="el-timeline"></div>
</div>

<div class="card">
  <h2 style="margin-top:0;"><%= t('kWh per hour — last 7 days') %></h2>
  <div id="el-hourly"></div>
</div>

<div class="card">
  <h2 style="margin-top:0;"><%= t('Per status — last 4 weeks') %></h2>
  <div id="el-status"></div>
</div>

<% if (load.kind === 'appliance') { %>
<div class="card">
  <h2 style="margin-top:0;"><%= t('Runs') %></h2>
  <div id="el-runs"></div>
</div>
<% } else { %>
<div class="card">
  <h2 style="margin-top:0;"><%= t('Per day — last 14 days') %></h2>
  <p class="hint"><%= t('"In advised hours" = share of the kWh that fell in hours LoxSuite would have released; "could save" = moving the rest there.') %></p>
  <div id="el-daily"></div>
</div>
<% } %>

<script>
(function () {
  var ID = <%- JSON.stringify(load.id) %>;
  var data = <%- JSON.stringify({ learned, detail }).replace(/</g, '\\u003c') %>;
  var TL = function (k) { return (window.LS_I18N && window.LS_I18N[k]) || k; };
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function nf(v, d) { return v == null ? '—' : Number(v).toLocaleString(undefined, { minimumFractionDigits: d, maximumFractionDigits: d }); }
  function hh(t) { return new Date(t).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }); }
  function dur(min) { return min >= 60 ? Math.floor(min / 60) + ' h ' + String(Math.round(min % 60)).padStart(2, '0') : Math.round(min) + ' min'; }
  var PALETTE = ['#4caf50', '#4a7bd0', '#e67e22', '#9b59b6', '#16a085', '#d4a017', '#e5534b', '#7f8c8d'];
  var colorOf = {};
  function color(key) {
    if (/^(off|uit|0)$/i.test(key)) return '#9aa5b1';
    // not running (done, paused, waiting …): a lighter grey, the running statuses get the colours
    if (/(^|[^a-zà-ÿ])(uitgeschakeld|klaar|gereed|beëindigd|beeindigd|einde|afgelopen|finished|done|ready|pauze|gepauzeerd|paused|uitgesteld|uitgestelde|delayed|wacht|wachten|waiting|stand-?by|idle|offline)($|[^a-zà-ÿ])/i.test(key)) return '#c3cad3';
    if (!colorOf[key]) colorOf[key] = PALETTE[Object.keys(colorOf).length % PALETTE.length];
    return colorOf[key];
  }
  function tile(label, value, sub) {
    return '<div class="ls-tile"><div class="ls-tile-label">' + esc(label) + '</div><div class="ls-tile-value">' + value + '</div>' + (sub ? '<div class="ls-tile-sub">' + sub + '</div>' : '') + '</div>';
  }
  function eur(v, d) { return v == null ? '—' : '€ ' + nf(v, d == null ? 2 : d); }
  function dayLabel(d) { var p = d.split('-'); return new Date(+p[0], +p[1] - 1, +p[2]).toLocaleDateString(undefined, { weekday: 'short', day: 'numeric', month: 'short' }); }

  function render() {
    var d = data.detail, lr = data.learned || {}, now = d.now;
    var state = '—';
    if (now && (now.on != null || now.status != null)) {
      var txt = now.status != null ? (now.label || now.status) : (now.on ? TL('on') : TL('off'));
      state = '<span class="ls-dot" style="background:' + color(now.status != null ? txt : (now.on ? 'on' : 'off')) + ';"></span>' + esc(txt);
    }
    var since = now && now.since ? TL('in this state for {0}').replace('{0}', dur((Date.now() - now.since) / 60000)) : '';
    if (now && now.endAt && now.endAt > Date.now()) since = TL('done at ~{0} (in {1})').replace('{0}', hh(now.endAt)).replace('{1}', dur((now.endAt - Date.now()) / 60000)) + (since ? ' · ' + since : '');
    if (now && now.readyToStart) since = TL('ready to start — LoxSuite picks the best hour') + (since ? ' · ' + since : '');
    if (now && now.startAt && now.startAt > Date.now() - 15 * 60000) since = TL('starts at ~{0} (in {1})').replace('{0}', hh(now.startAt)).replace('{1}', dur(Math.max(0, now.startAt - Date.now()) / 60000)) + (since ? ' · ' + since : '');
    document.getElementById('el-tiles').innerHTML =
      tile(TL('State now'), state, since) +
      tile(TL('Power now'), now && now.kw != null ? nf(now.kw, 2) + ' <small>kW</small>' : '—', now && now.total != null ? TL('counter {0} kWh').replace('{0}', nf(now.total, 1)) : '') +
      tile(TL('Last 24 hours'), nf(d.last24.kwh, 2) + ' <small>kWh</small>', TL('on for {0}').replace('{0}', dur(d.last24.onHours * 60))) +
      tile(TL('Learned'), lr.kwOn != null ? nf(lr.kwOn, 2) + ' <small>kW</small>' : (lr.kwh != null ? TL('{0} kWh per run').replace('{0}', nf(lr.kwh, 2)) : '—'), lr.kwhPerDay != null ? TL('{0} kWh per day').replace('{0}', nf(lr.kwhPerDay, 1)) : (lr.runs ? TL('{0} runs measured').replace('{0}', lr.runs) : ''));
    var wl = [];
    if (lr.weather && lr.weather.model && lr.weather.model.usable) wl.push(TL('Weather: +{0} kWh per degree colder (fits {1}%)').replace('{0}', nf(lr.weather.model.b, 2)).replace('{1}', Math.round(lr.weather.model.r2 * 100)) + (lr.weather.todayC != null ? ' · ' + TL('today {0} °C → ×{1}').replace('{0}', nf(lr.weather.todayC, 1)).replace('{1}', nf(lr.weather.factorToday, 2)) : ''));
    if (lr.cooling && lr.cooling.k) wl.push(TL('Cools down {0} °C per hour per 10 °C difference with outside').replace('{0}', nf(lr.cooling.k * 10, 2)) + (lr.cooling.holdH ? ' → ' + TL('held off at most {0} h').replace('{0}', nf(lr.cooling.holdH, 1)) : ''));
    if (now && now.temp != null) wl.push(TL('temperature now {0} °C').replace('{0}', nf(now.temp, 1)));
    (lr.anomalies || []).forEach(function (x) {
      wl.push('⚠ ' + (x.kind === 'weather'
        ? TL('Uses {0}% more than expected for this weather (last week {1} kWh/day, expected {2}) — worth a look (filter, defrosting, settings).').replace('{0}', Math.round((x.ratio - 1) * 100)).replace('{1}', nf(x.recent, 1)).replace('{2}', nf(x.expected, 1))
        : TL('"{0}" draws {1}% more power than in the weeks before ({2} kW against {3} kW).').replace('{0}', x.status).replace('{1}', Math.round((x.ratio - 1) * 100)).replace('{2}', nf(x.recent, 2)).replace('{3}', nf(x.before, 2))));
    });
    var wel = document.getElementById('el-weather');
    if (wel) { wel.innerHTML = wl.length ? wl.map(esc).join('<br>') : ''; wel.hidden = !wl.length; }
    document.getElementById('el-updated').textContent = now && now.at ? TL('last read {0}').replace('{0}', hh(now.at)) : '';

    // timeline
    var el = document.getElementById('el-timeline');
    var segs = d.timeline || [];
    if (!segs.length) el.innerHTML = '<p class="hint" style="margin:0;">' + esc(TL('No on/off or status changes recorded yet — they appear once an on/off or status signal is chosen.')) + '</p>';
    else {
      var W = lsChartW(el, 900), H = 36, t1 = Date.now(), t0 = t1 - 48 * 3600000;
      var X = function (ms) { return (ms - t0) / (t1 - t0) * W; };
      var svg = '<svg viewBox="0 0 ' + W + ' ' + (H + 18) + '" width="100%" style="display:block;">';
      // a light track, the states as soft rounded blocks with a hairline of air between them
      svg += '<rect x="0" y="6" width="' + W + '" height="' + (H - 12) + '" rx="6" fill="currentColor" opacity="0.04"/>';
      segs.forEach(function (sg) { var x = X(sg.from), w = Math.max(1, X(sg.to) - x - 1); svg += '<rect x="' + (x + 0.5) + '" y="6" width="' + w + '" height="' + (H - 12) + '" rx="' + Math.min(4, w / 2) + '" fill="' + color(sg.key) + '" opacity="0.7"><title>' + esc(sg.key + ' · ' + hh(sg.from) + '–' + hh(sg.to) + ' (' + dur((sg.to - sg.from) / 60000) + ')') + '</title></rect>'; });
      for (var t = Math.ceil(t0 / 3600000) * 3600000; t < t1; t += 3600000) { var dt = new Date(t); if (dt.getHours() % 6 === 0) svg += '<line x1="' + X(t) + '" y1="2" x2="' + X(t) + '" y2="' + H + '" stroke="currentColor" opacity="0.1"/><text x="' + (X(t) + 2) + '" y="' + (H + 13) + '" font-size="10" fill="currentColor" opacity="0.6">' + (dt.getHours() === 0 ? dt.toLocaleDateString([], { weekday: 'short' }) : String(dt.getHours()).padStart(2, '0') + ':00') + '</text>'; }
      var keys = []; segs.forEach(function (sg) { if (keys.indexOf(sg.key) < 0) keys.push(sg.key); });
      el.innerHTML = svg + '</svg><div class="hint" style="margin:0.3rem 0 0;">' + keys.map(function (k) { return '<span style="display:inline-block; width:10px; height:10px; border-radius:2px; background:' + color(k) + '; margin:0 4px 0 10px;"></span>' + esc(k); }).join('') + '</div>';
    }

    // kWh per hour, 7 days
    var hel = document.getElementById('el-hourly');
    var rows = d.hourly || [];
    if (!rows.length) hel.innerHTML = '<p class="hint" style="margin:0;">' + esc(TL('No measurements yet.')) + '</p>';
    else {
      var W2 = lsChartW(hel, 900), H2 = 120, e1 = Math.floor(Date.now() / 3600000) * 3600000 + 3600000, e0 = e1 - 7 * 24 * 3600000;
      var X2 = function (ms) { return (ms - e0) / (e1 - e0) * W2; }, bw = W2 / (7 * 24);
      var max = Math.max.apply(null, rows.map(function (r) { return r.kwh; }).concat([0.1]));
      // per hour as soft columns (a consumer switches on and off: no smoothing over that)
      var C = window.LsChart;
      var s2 = '<svg viewBox="0 0 ' + W2 + ' ' + (H2 + 16) + '" width="100%" style="display:block;">' + C.hline(0, W2, H2 / 2) + C.hline(0, W2, H2, 0.18);
      rows.forEach(function (r) { var ms = Date.parse(r.hour), h = r.kwh / max * H2 * 0.95; s2 += C.col(X2(ms) + 0.25, H2 - h, Math.max(0.8, bw - 0.5), h, { color: 'var(--accent, #5CA83F)', opacity: 0.45, r: Math.min(2, bw / 2), title: esc(new Date(ms).toLocaleString([], { weekday: 'short', hour: '2-digit', minute: '2-digit' }) + ': ' + nf(r.kwh, 2) + ' kWh') }); });
      for (var t2 = Math.ceil(e0 / 86400000) * 86400000; t2 < e1; t2 += 86400000) s2 += '<text x="' + (X2(t2) + 2) + '" y="' + (H2 + 12) + '" font-size="10" fill="currentColor" opacity="0.6">' + new Date(t2).toLocaleDateString([], { weekday: 'short', day: 'numeric' }) + '</text>';
      hel.innerHTML = s2 + '</svg><div class="hint" style="margin:0.3rem 0 0;">' + esc(TL('Highest hour: {0} kWh').replace('{0}', nf(max, 2))) + '</div>';
    }

    // per status
    var sel = document.getElementById('el-status');
    var ps = d.perStatus || [];
    sel.innerHTML = ps.length ? '<div style="overflow-x:auto;"><table><thead><tr><th>' + esc(TL('Status')) + '</th><th>' + esc(TL('Hours')) + '</th><th>' + esc(TL('Per day')) + '</th><th>kWh</th><th>' + esc(TL('Typical power')) + '</th></tr></thead><tbody>' +
      ps.map(function (x) { return '<tr><td><span style="display:inline-block; width:10px; height:10px; border-radius:2px; background:' + color(x.status) + '; margin-right:6px;"></span>' + esc(x.status) + '</td><td>' + nf(x.hours, 1) + '</td><td>' + nf(x.hoursPerDay, 1) + ' h</td><td>' + nf(x.kwh, 1) + (x.measured ? '' : ' <span class="hint">' + esc(TL('(estimated)')) + '</span>') + '</td><td>' + (x.kw > 0.005 ? nf(x.kw, 2) + ' kW' : '—') + '</td></tr>'; }).join('') + '</tbody></table></div>'
      : '<p class="hint" style="margin:0;">' + esc(TL('Nothing learned per status yet.')) + '</p>';

    var rel = document.getElementById('el-runs');
    if (rel) {
      var runs = d.runs || [];
      rel.innerHTML = runs.length ? '<div style="overflow-x:auto;"><table><thead><tr><th>' + esc(TL('Start')) + '</th><th>' + esc(TL('Duration')) + '</th><th>kWh</th><th>' + esc(TL('Cost')) + '</th><th>' + esc(TL('Best start (hindsight)')) + '</th><th>' + esc(TL('Then')) + '</th><th>' + esc(TL('Saving')) + '</th></tr></thead><tbody>' +
        runs.map(function (r) { var sav = r.cost_eur != null && r.best_cost_eur != null ? r.cost_eur - r.best_cost_eur : null; return '<tr><td>' + esc(new Date(r.start_at).toLocaleString([], { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })) + '</td><td>' + dur((Date.parse(r.end_at) - Date.parse(r.start_at)) / 60000) + '</td><td>' + nf(r.kwh, 2) + '</td><td>' + eur(r.cost_eur) + '</td><td>' + (r.best_start ? hh(r.best_start) : '—') + '</td><td>' + eur(r.best_cost_eur) + '</td><td style="color:' + (sav > 0.01 ? 'var(--success)' : 'inherit') + ';">' + eur(sav) + '</td></tr>'; }).join('') + '</tbody></table></div>'
        : '<p class="hint" style="margin:0;">' + esc(TL('No runs measured yet.')) + '</p>';
    }
    var del = document.getElementById('el-daily');
    if (del) {
      var days = d.daily || [];
      del.innerHTML = days.length ? '<div style="overflow-x:auto;"><table><thead><tr><th>' + esc(TL('Day')) + '</th><th>kWh</th><th>' + esc(TL('Cost')) + '</th><th>€/kWh</th><th>' + esc(TL('Solar')) + '</th><th>' + esc(TL('In advised hours')) + '</th><th>' + esc(TL('Could save')) + '</th></tr></thead><tbody>' +
        days.map(function (x) { return '<tr><td>' + esc(dayLabel(x.day)) + '</td><td>' + nf(x.kwh, 1) + '</td><td>' + eur(x.cost) + '</td><td>' + eur(x.eurPerKwh, 3) + '</td><td>' + (x.solarShare == null ? '—' : x.solarShare + '%') + '</td><td>' + (x.advisedShare == null ? '<span class="hint">' + esc(TL('not logged yet')) + '</span>' : x.advisedShare + '%') + '</td><td style="color:' + (x.potential > 0.01 ? 'var(--success)' : 'inherit') + ';">' + eur(x.potential) + '</td></tr>'; }).join('') + '</tbody></table></div>'
        : '<p class="hint" style="margin:0;">' + esc(TL('No measurements yet.')) + '</p>';
    }
  }
  render();
  lsOnResize(render);
  var imp = document.getElementById('el-import');
  if (imp) imp.addEventListener('click', function () {
    var msg = document.getElementById('el-import-msg');
    imp.disabled = true; msg.textContent = TL('Reading…');
    fetch('/energy-manager/loads/' + ID + '/import.json', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ days: Number(document.getElementById('el-import-days').value) }) })
      .then(function (r) { return r.json(); })
      .then(function (r) {
        var x = r.ok && r.report[0];
        msg.textContent = !r.ok ? r.message : !x ? '' : !x.ok ? x.message : TL('{0} hours read, {1} runs found — reload the page for what it learned.').replace('{0}', x.hours).replace('{1}', x.runs || 0);
      })
      .catch(function (e) { msg.textContent = e.message; })
      .finally(function () { imp.disabled = false; });
  });
  setInterval(function () { fetch('/energy-manager/loads/' + ID + '/detail.json').then(function (r) { return r.json(); }).then(function (d) { if (d.detail) { data = d; render(); } }).catch(function () {}); }, 60000);
})();
</script>

<%- include('partials/foot') %>
