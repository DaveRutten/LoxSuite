<%- include('partials/head', { pageTitle: 'Transformations', active: 'transformations' }) %>

<%- include('partials/tabs-mappings', { active: 'transformations' }) %>

<p class="hint">
  All mappings using a translation table, from both directions. Use
  <a href="/mappings/mqtt-to-loxone">MQTT &rarr; Loxone</a> or <a href="/mappings/loxone-to-mqtt">Loxone &rarr; MQTT</a>
  to create a new mapping and pick "Translation table" as its value transform.
</p>

<h2>MQTT &rarr; Loxone</h2>
<div class="filterable-table-card">
  <div class="table-toolbar">
    <div class="columns-menu columns-menu-inline" id="tf-m2l-columns-menu">
      <button type="button" class="btn-soft" id="tf-m2l-columns-btn"><%- icon('columns') %> Columns</button>
      <div class="columns-menu-panel" id="tf-m2l-columns-panel" hidden></div>
    </div>
  </div>
  <div class="table-wrap">
    <div id="tf-m2l-tabulator"></div>
  </div>
</div>

<h2>Loxone &rarr; MQTT</h2>
<div class="filterable-table-card">
  <div class="table-toolbar">
    <div class="columns-menu columns-menu-inline" id="tf-l2m-columns-menu">
      <button type="button" class="btn-soft" id="tf-l2m-columns-btn"><%- icon('columns') %> Columns</button>
      <div class="columns-menu-panel" id="tf-l2m-columns-panel" hidden></div>
    </div>
  </div>
  <div class="table-wrap">
    <div id="tf-l2m-tabulator"></div>
  </div>
</div>

<link rel="stylesheet" href="/vendor/tabulator.min.css">
<link rel="stylesheet" href="/tabulator-theme.css">
<script src="/vendor/tabulator.min.js"></script>
<script src="/vendor/floating-ui.core.umd.min.js"></script>
<script src="/vendor/floating-ui.dom.umd.min.js"></script>
<script src="/tabulator-table.js"></script>
<script src="/transformations-tabulator.js"></script>

<%- include('partials/foot') %>
