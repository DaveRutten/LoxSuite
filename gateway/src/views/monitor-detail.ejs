<%- include('partials/head', { pageTitle: monitor.label, active: 'monitor' }) %>

<% if (hasNumeric && canEdit('monitor')) { %>
<div id="monitor-chart-backdrop" class="panel-edit-backdrop"></div>
<% } %>

<p class="hint">
  <%= monitor.source_type === 'mqtt' ? 'MQTT topic' : monitor.source_type === 'miniserver_diag' ? 'Miniserver diagnostic' : 'Loxone (direct, polled)' %>:
  <% if (monitor.source_type === 'mqtt') { %>
    <code><%= monitor.mqtt_topic %></code>
  <% } else if (monitor.source_type === 'miniserver_diag') { %>
    <%= monitor.miniserver_name || '-' %> &middot; <%= DIAG_FIELD_LABELS[monitor.diag_field] || monitor.diag_field %>
    <span class="hint" style="margin:0;">(reuses the Miniservers page's own check, not polled separately)</span>
  <% } else { %>
    <%= monitor.miniserver_name || '-' %>, every <%= Math.round(monitor.poll_interval_ms / 1000) %>s
  <% } %>
  &mdash; <a href="/monitor">&larr; back to Monitor</a>
</p>

<%
  // This monitor's own unit/scale/decimals/value-labels (see routes/monitor.js's chart-settings
  // handler) — computed here, above any canEdit gate, since the current-value line below shows for
  // every viewer, not just whoever can also edit the chart's own settings. A value-label match (an
  // enum reading like 1 = Active) takes priority over scaling, same precedence the Monitor list
  // page's own Scaled value column and a dashboard 'value' panel both already give theirs.
  var currentOwnSeries = (config.series && config.series[String(monitor.id)]) || {};
  var currentUnit = currentOwnSeries.unit || config.unit || '';
  var currentScale = currentOwnSeries.scale != null ? currentOwnSeries.scale : 1;
  var currentDecimals = currentOwnSeries.decimals != null ? currentOwnSeries.decimals : defaultPanelDecimals;
  var currentValueLabels = currentOwnSeries.valueLabels || [];
  var currentMapping = current ? currentValueLabels.find((vm) => vm.value === String(current.value)) : null;

  // Shared between the chart's own header bar below and the no-chart-yet fallback further down —
  // one computation either renders attached to the chart (the common case) or as a plain line when
  // there's no chart to attach it to.
  var currentMainText = !current ? '—'
    : currentMapping ? currentMapping.label
    : current.numericValue != null ? (Number(current.numericValue) * currentScale).toFixed(currentDecimals) + (currentUnit ? ' ' + currentUnit : '')
    : current.value;
  var currentMainColor = (currentMapping && currentMapping.color) || null;
  var currentSubText = (current ? '(raw: ' + current.value + ') · ' : '') + 'as of ' + (formatDateTime(current ? current.recordedAt : null) || '-');
%>

<div style="display:flex; flex-wrap:wrap; align-items:center; gap:0.75rem; margin-bottom:1.25rem;">
  <form method="get" action="/monitor/<%= monitor.id %>" class="range-picker-form" style="display:flex; align-items:flex-start; gap:0.5rem;">
    <%- rangeField(range, { autoSubmit: true }) %>
    <button type="submit" class="btn-soft range-go-btn">Go</button>
  </form>

  <%
    // margin-left:auto (not justify-content:space-between on the shared parent) so this stays
    // pinned to the right edge of its OWN line even when it wraps onto a second line below .tabs
    // on a narrower viewport — space-between only pushes two items apart when they share a line;
    // a lone wrapped item has nothing to space "between" and space-between left it stuck at the
    // left edge instead.
  %>
  <div class="row-actions" style="margin-left:auto;">
    <% if (hasNumeric && canEdit('monitor')) { %>
    <button type="button" class="icon-btn icon-btn-edit" title="Chart settings" data-toggle-row="monitor-chart-settings"><%- icon('edit') %></button>
    <% } %>
    <a href="/monitor/<%= monitor.id %>/export.csv?range=<%= range %>"><button type="button" class="btn-soft"><%- icon('copy') %> Export CSV</button></a>
    <% if (canEdit('monitor')) { %>
    <form method="post" action="/monitor/<%= monitor.id %>/clear-history" data-confirm="Delete all recorded history for this monitor? The monitor itself (and any dashboard panel using it) stays, just with nothing to show until the next reading comes in.">
      <button type="submit" class="danger" <%= rows.length === 0 ? 'disabled' : '' %>><%- icon('trash') %> Clear history</button>
    </form>
    <% } %>
  </div>
</div>

<div id="monitor-meta" data-monitor-id="<%= monitor.id %>" data-range="<%= range %>" data-group-mode="<%= groupMode %>" hidden></div>

<% if (hasNumeric) { %>
  <% if (truncated) { %>
    <p class="hint">This chart and the list below only cover the most recent <%= rows.length %> readings &mdash; a monitor polled every few seconds can log more than that within "<%= range %>", so the plotted line may start partway through the range instead of at its very left edge. Export CSV for the full history, or pick a shorter range for a complete picture.</p>
  <% } %>
  <% if (canEdit('monitor')) { %>
    <%
      // Same buildConfig('chart', ...) shape a dashboard chart panel's own config already uses
      // (see panel-grid.ejs's Edit-panel Appearance/Y-axis/Interaction sections) — this page is
      // always a single monitor though, so there's no chart-type or per-series settings here:
      // just the one line's own appearance, axis, zoom, thresholds and annotations.
      var legendPos = config.legendPosition || 'auto';
      var steppedVal = config.stepped === true ? 'before' : (config.stepped || '');
      var curveTension = config.curveTension != null ? config.curveTension : 0.15;
      var yScaleType = config.yScaleType || 'linear';
      // This page has no per-series builder (it's always exactly one monitor), so its own Y-axis
      // unit/Value scale/Decimals fields below synthesize the one entry buildConfig's per-series
      // chart_series mechanism expects (see routes/monitor.js's chart-settings handler) — unit lives
      // here (not config.unit, which stays unused for this page) since it's this monitor's own
      // reading, not a shared style like legend/fill/stepped that genuinely applies the same to
      // every monitor — see parseSeriesConfig in routes/dashboards.js.
      var ownSeries = (config.series && config.series[String(monitor.id)]) || {};
      var monitorScale = ownSeries.scale != null ? ownSeries.scale : 1;
      var monitorDecimals = ownSeries.decimals != null ? ownSeries.decimals : '';
    %>
    <form id="monitor-chart-settings" method="post" action="/monitor/<%= monitor.id %>/chart-settings" class="form-grid panel-settings-form">
        <div class="panel-settings-form-head" style="grid-column:1/-1; display:flex; align-items:center; justify-content:space-between; margin-bottom:0.3rem;">
          <strong>Chart settings</strong>
          <div class="row-actions">
            <%
              // Unlike a dashboard panel's own save-as-default (scoped per dashboard+panel_type,
              // see panelTypeDefaults.js), this page has no dashboard to scope by and the user
              // wants one shared style for every monitor — so there's exactly one saved default,
              // not a per-(something) lookup. formaction submits THIS form's own live field values
              // to a different route than the main Save button, same trick a plain <form> already
              // supports natively — no JS/fetch() needed the way the dashboard panel drawer's
              // in-place live-patching does, since this page just does a normal full-page reload
              // on every save already (see the main Save button below).
            %>
            <button type="submit" formaction="/monitor/<%= monitor.id %>/chart-settings/save-as-default" class="icon-btn icon-btn-neutral" title="Save these settings as the shared default for every monitor's chart"><%- icon('star') %></button>
            <button type="button" class="icon-btn icon-btn-neutral hints-toggle-btn" title="Show/hide the help text under each field"><%- icon('lightbulb') %></button>
            <% if (chartDefaultExists) { %>
            <button type="submit" formaction="/monitor/<%= monitor.id %>/chart-settings/reset-to-default" class="icon-btn icon-btn-neutral" title="Apply the shared default chart style to this monitor"><%- icon('refresh') %></button>
            <% } %>
            <button type="button" class="icon-btn icon-btn-danger" data-toggle-row="monitor-chart-settings" title="Close" aria-label="Close"><%- icon('x') %></button>
          </div>
        </div>
        <div class="threshold-builder-details-wrap" style="grid-column:1/-1;">
          <details class="threshold-builder-details" open>
            <summary>Legend</summary>
            <div class="form-grid">
              <div>
                <label>Legend</label>
                <select name="legend_position" id="monitor-legend-position-select">
                  <option value="auto" <%= legendPos === 'auto' ? 'selected' : '' %>>Auto</option>
                  <option value="top" <%= legendPos === 'top' ? 'selected' : '' %>>Top</option>
                  <option value="bottom" <%= legendPos === 'bottom' ? 'selected' : '' %>>Bottom</option>
                  <option value="left" <%= legendPos === 'left' ? 'selected' : '' %>>Left</option>
                  <option value="right" <%= legendPos === 'right' ? 'selected' : '' %>>Right</option>
                  <option value="off" <%= legendPos === 'off' ? 'selected' : '' %>>Off</option>
                </select>
              </div>
              <div data-legend-for="on"><label>Legend alignment</label>
                <select name="legend_align">
                  <option value="start" <%= (config.legendAlign || 'start') === 'start' ? 'selected' : '' %>>Left</option>
                  <option value="center" <%= config.legendAlign === 'center' ? 'selected' : '' %>>Center</option>
                  <option value="end" <%= config.legendAlign === 'end' ? 'selected' : '' %>>Right</option>
                </select>
              </div>
              <div data-legend-for="on"><label>Show min in legend</label><%- toggleSwitch('legend_show_min', !!config.legendShowMin) %></div>
              <div data-legend-for="on"><label>Show max in legend</label><%- toggleSwitch('legend_show_max', !!config.legendShowMax) %></div>
              <div data-legend-for="on"><label>Show average in legend</label><%- toggleSwitch('legend_show_avg', !!config.legendShowAvg) %></div>
              <div data-legend-for="on"><label>Show current value in legend</label><%- toggleSwitch('legend_show_current', !!config.legendShowCurrent) %></div>
            </div>
          </details>
        </div>
        <%
          // Falls back to the old panel-wide config.unit for a monitor whose unit was set before
          // this page moved it into the per-series entry above (config.unit itself is never written
          // again going forward, see routes/monitor.js's chart-settings handler) — without this, a
          // monitor configured on a previous version would appear to have silently lost its unit the
          // moment this page loads, purely because of where it happens to be stored on disk.
          var displayUnit = ownSeries.unit || config.unit || '';
        %>
        <div><label>Y-axis unit (optional)</label><%- unitField('unit_chart', displayUnit) %></div>
        <div><label>Value scale (optional)</label><%- scaleField('monitor_scale', monitorScale) %></div>
        <div><label>Decimals (optional)</label><input type="number" name="monitor_decimals" min="0" max="6" placeholder="Default" value="<%= monitorDecimals %>"></div>
        <div><label>Stepped line</label>
          <select name="stepped_line">
            <option value="" <%= steppedVal === '' ? 'selected' : '' %>>Off</option>
            <option value="before" <%= steppedVal === 'before' ? 'selected' : '' %>>Before</option>
            <option value="after" <%= steppedVal === 'after' ? 'selected' : '' %>>After</option>
            <option value="middle" <%= steppedVal === 'middle' ? 'selected' : '' %>>Middle</option>
          </select>
        </div>
        <div><label>Curve</label>
          <select name="curve_tension">
            <option value="0" <%= curveTension == 0 ? 'selected' : '' %>>Straight</option>
            <option value="0.15" <%= curveTension == 0.15 ? 'selected' : '' %>>Slight curve</option>
            <option value="0.4" <%= curveTension == 0.4 ? 'selected' : '' %>>Smooth</option>
          </select>
        </div>
        <div><label>Show points on line</label><%- toggleSwitch('show_points', !!config.points) %></div>
        <div><label>Fill area under line</label><%- toggleSwitch('fill_area', !!config.fill) %></div>
        <div><label>Animate on load</label><%- toggleSwitch('enable_animation', !!config.animation) %></div>
        <div><label>Y-axis scale</label>
          <select name="y_scale_type">
            <option value="linear" <%= yScaleType === 'linear' ? 'selected' : '' %>>Linear</option>
            <option value="logarithmic" <%= yScaleType === 'logarithmic' ? 'selected' : '' %>>Logarithmic</option>
          </select>
        </div>
        <div><label>Y-axis min (optional)</label><input type="number" name="y_min" step="any" placeholder="Auto" value="<%= config.yMin != null ? config.yMin : '' %>"></div>
        <div><label>Y-axis max (optional)</label><input type="number" name="y_max" step="any" placeholder="Auto" value="<%= config.yMax != null ? config.yMax : '' %>"></div>
        <div><label>Zoom &amp; pan (scroll to zoom, drag to pan)</label><%- toggleSwitch('enable_zoom', !!config.zoom) %></div>
        <div style="grid-column:1/-1;"><%- valueMappingField('monitor_value_labels', ownSeries.valueLabels || []) %></div>
        <div style="grid-column:1/-1;"><%- thresholdField('chart_thresholds', config.thresholds || [], true) %></div>
        <div style="grid-column:1/-1;"><%- annotationField('chart_annotations', config.annotations || []) %></div>
        <%
          // No Save button — every field change auto-saves and live-patches the chart above (see
          // the script near the bottom of this file, same reasoning/behavior as a dashboard panel's
          // own Edit form), so a button implying "nothing's saved until you click this" would just
          // contradict what's actually happening. This status text is the only save affordance.
        %>
        <span class="hint panel-save-status" style="grid-column:1/-1; margin:0;">Saved</span>
    </form>
    <span class="panel-drawer-resize-handle" title="Drag to resize"></span>
  <% } %>
  <%
    var canvasStepped = config.stepped === true ? 'before' : (config.stepped || '');
    var legendStats = [];
    if (config.legendShowMin) legendStats.push('min');
    if (config.legendShowMax) legendStats.push('max');
    if (config.legendShowAvg) legendStats.push('avg');
    if (config.legendShowCurrent) legendStats.push('current');
  %>
  <div class="card chart-wrap" id="monitor-chart-wrap">
    <div class="monitor-current-value-bar">
      <span class="monitor-current-value-label">Current value</span>
      <span class="monitor-current-value-main" <% if (currentMainColor) { %>style="color: <%= currentMainColor %>;"<% } %>><%= currentMainText %></span>
      <span class="hint" style="margin:0;"><%= currentSubText %></span>
    </div>
    <div class="monitor-chart-canvas-wrap">
      <canvas data-monitor-ids="<%= monitor.id %>" data-range="<%= range %>" data-range-until="<%= rangeUntilMs || '' %>" height="90"
        data-legend="<%= config.legendPosition || 'auto' %>" data-legend-align="<%= config.legendAlign || 'start' %>" data-legend-stats="<%= legendStats.join(',') %>" data-unit="<%= config.unit || '' %>" data-decimals="<%= defaultPanelDecimals %>"
        data-fill="<%= config.fill ? '1' : '' %>" data-stepped="<%= canvasStepped %>" data-tension="<%= config.curveTension != null ? config.curveTension : 0.15 %>"
        data-points="<%= config.points ? '1' : '' %>" data-animation="<%= config.animation ? '1' : '' %>" data-y-scale-type="<%= config.yScaleType || 'linear' %>"
        data-y-min="<%= config.yMin != null ? config.yMin : '' %>" data-y-max="<%= config.yMax != null ? config.yMax : '' %>" data-zoom="<%= config.zoom ? '1' : '' %>"
        data-thresholds="<%= JSON.stringify(config.thresholds || []) %>" data-annotations="<%= JSON.stringify(config.annotations || []) %>"
        data-series="<%= JSON.stringify(config.series || {}) %>"></canvas>
    </div>
  </div>
<% } else { %>
  <p class="hint" style="font-size:1rem;">
    Current value: <strong <% if (currentMainColor) { %>style="color: <%= currentMainColor %>;"<% } %>><%= currentMainText %></strong>
    <span class="hint" style="margin:0;"><%= currentSubText %></span>
  </p>
  <p class="hint">This monitor hasn't recorded any numeric values yet, so there's nothing to chart &mdash; the raw values are listed below instead.</p>
  <% if (truncated) { %>
    <p class="hint">Showing the most recent <%= rows.length %> readings in this range. Export CSV for the full history.</p>
  <% } %>
<% } %>

<!-- Deliberately NOT .table-wrap: tables.js enhances every "<table>" nested under that class with
     its own drag-reorder/hide/resize "Columns" toolbar (document.querySelectorAll('.table-wrap
     table')), assuming one table per wrap. This card holds one <table> per day/hour group, which
     made it build a competing toolbar per group instead of one sane one — a plain 2-column
     timestamp/value table doesn't need any of that anyway. -->
<div class="history-groups-wrap" id="monitor-history-groups">
  <% if (rows.length === 0) { %>
    <table>
      <thead><tr><th>Timestamp</th><th>Raw value</th></tr></thead>
      <tbody><tr><td colspan="2" class="empty">No readings in this range yet.</td></tr></tbody>
    </table>
  <% } else { %>
    <% groups.forEach((g, gi) => { %>
      <details class="history-group" data-group-key="<%= g.key %>" <%= gi === 0 ? 'open' : '' %>>
        <summary><%= g.label %> <span class="hint">(<%= g.rows.length %> reading<%= g.rows.length === 1 ? '' : 's' %>)</span></summary>
        <table>
          <thead><tr><th>Timestamp</th><th>Raw value</th></tr></thead>
          <tbody>
            <% g.rows.forEach(r => { %>
              <tr><td><%= formatDateTime(r.recordedAt) %></td><td><span class="truncate" title="<%= r.value %>"><%= r.value %></span></td></tr>
            <% }) %>
          </tbody>
        </table>
      </details>
    <% }) %>
  <% } %>
</div>

<% if (canEdit('monitor')) { %>
  <%
    // Loaded before threshold-annotation-builder.js — that script's own querySelectorAll('.threshold-
    // builder')/('.annotation-builder') IIFEs run immediately at parse time (not deferred) and call
    // LoxColorPicker.buildPickerHtml() synchronously while building each existing row, so both
    // modules have to already exist by the time that tag is reached, not just by the time the page
    // finishes loading. GridStack is new here specifically for LoxRowReorder's own drag-to-reorder
    // (see threshold-annotation-builder.js) — this page has no panel grid of its own to otherwise
    // need it for. Only needed when the settings form (and its threshold/annotation builders)
    // actually rendered above — a view-only visitor gets neither.
  %>
  <link rel="stylesheet" href="/vendor/gridstack.min.css">
  <script src="/vendor/gridstack-all.min.js"></script>
  <script src="/vendor/sortable.min.js"></script>
  <script src="/color-picker.js"></script>
  <script src="/threshold-annotation-builder.js"></script>
  <script src="/panel-drawer-resize.js"></script>
  <script>
    // The min/max/avg/current legend toggles are meaningless with no legend to show them in — this
    // page has no chart-type switcher to piggyback this on (see panel-grid.ejs's own sync(), which
    // folds the same check into its existing data-chart-type-for/data-fields-for machinery), so it
    // gets this tiny standalone version instead.
    (function () {
      var legendSelect = document.getElementById('monitor-legend-position-select');
      var toggles = document.querySelectorAll('[data-legend-for]');
      if (!legendSelect || !toggles.length) return;
      function sync() {
        var visible = legendSelect.value !== 'off';
        toggles.forEach(function (el) { el.style.display = visible ? '' : 'none'; });
      }
      legendSelect.addEventListener('change', sync);
      sync();
    })();
  </script>
  <script>
    // Same fixed-drawer pattern as a dashboard chart panel's own Edit form (see .panel-settings-form
    // in style.css and its backdrop script in panel-grid.ejs) — reuses the same CSS/classes so it
    // looks and behaves identically, INCLUDING that script's own re-centering of the one thing
    // being edited (here: the chart card, #monitor-chart-wrap — there's no multi-panel grid on this
    // page, just the one chart to lift and reposition next to the drawer while everything else
    // behind it stays blurred). The open/close toggle itself is already handled by the generic
    // [data-toggle-row] delegated handler in foot.ejs; this only syncs the backdrop/chart to match
    // and adds click/Escape-to-close.
    (function () {
      var backdrop = document.getElementById('monitor-chart-backdrop');
      var form = document.getElementById('monitor-chart-settings');
      var chartWrap = document.getElementById('monitor-chart-wrap');
      if (!backdrop || !form) return;

      // Adapted from centerEditingPanel() in panel-grid.ejs — that version can afford to just bail
      // out and leave a panel at its natural grid position when it doesn't fit next to the drawer,
      // because a dashboard panel is already one narrow cell in a grid, well short of the full
      // content width. This page has no grid — the chart's natural width is close to the ENTIRE
      // main content column — so "doesn't fit, leave it alone" would leave it exactly as wide as
      // before, still overlapping the drawer. Always clamps width to the available space instead
      // (a real reflow/shrink, not just centering within room that may not exist), and re-measures
      // the natural width from a clean slate every time — reading getBoundingClientRect() while a
      // PREVIOUS call's own inline width is still applied would just measure that stale value back.
      function centerChart() {
        if (!chartWrap) return;
        // Same mobile branch as panel-grid.ejs's own centerEditingPanel() — below the drawer's own
        // mobile breakpoint (style.css) .panel-settings-form is a bottom sheet, not a right-side
        // drawer eating horizontal space, so the fixed-position/shrink math below (built specifically
        // to dodge a right-side drawer) has nothing to act on. Scrolling the chart to the top of the
        // viewport is enough on its own to keep it visible above the sheet.
        if (window.matchMedia('(max-width: 768px)').matches) {
          chartWrap.scrollIntoView({ behavior: 'smooth', block: 'start' });
          return;
        }
        var drawerWidth = form.classList.contains('open') ? form.getBoundingClientRect().width : 0;
        // `left` below is relative to the VIEWPORT (position:fixed), not to .content — has to
        // start past the sidebar's own right edge, or a chart on a wide-enough viewport ends up
        // (mostly) hidden under the sidebar instead of merely close to it. panel-grid.ejs's own
        // centerEditingPanel() doesn't need this: a dashboard panel is already narrow enough
        // (one grid cell) that this never came up there, but this page's chart is close to the
        // full content width, so it actually reaches that boundary.
        var sidebar = document.querySelector('.sidebar');
        var contentLeft = sidebar ? sidebar.getBoundingClientRect().right : 0;
        var availableWidth = window.innerWidth - drawerWidth - contentLeft;

        chartWrap.style.position = '';
        chartWrap.style.left = '';
        chartWrap.style.top = '';
        chartWrap.style.width = '';
        chartWrap.style.margin = '';
        var rect = chartWrap.getBoundingClientRect();

        // Guaranteed breathing room OUTSIDE the highlighted card on both sides — not just whatever
        // slack centering happens to leave, which can be ~0 on a wide viewport where the chart's
        // natural width already nearly fills availableWidth.
        var outerPad = 24;
        var width = Math.max(200, Math.min(rect.width, availableWidth - outerPad * 2));
        var left = contentLeft + Math.max(outerPad, Math.round((availableWidth - width) / 2));
        var top = Math.max(outerPad, Math.round((window.innerHeight - rect.height) / 2));
        chartWrap.style.position = 'fixed';
        chartWrap.style.left = left + 'px';
        chartWrap.style.top = top + 'px';
        chartWrap.style.width = Math.round(width) + 'px';
        chartWrap.style.margin = '0';
      }
      function resetChartPosition() {
        if (!chartWrap) return;
        chartWrap.style.position = '';
        chartWrap.style.left = '';
        chartWrap.style.top = '';
        chartWrap.style.width = '';
        chartWrap.style.margin = '';
      }

      function syncBackdrop() {
        var open = form.classList.contains('open');
        backdrop.classList.toggle('open', open);
        if (chartWrap) {
          chartWrap.classList.toggle('editing', open);
          if (open) centerChart(); else resetChartPosition();
        }
      }
      function closeAll() {
        form.classList.remove('open');
        backdrop.classList.remove('open');
        if (chartWrap) { chartWrap.classList.remove('editing'); resetChartPosition(); }
      }

      document.addEventListener('click', function (e) {
        if (e.target.closest('[data-toggle-row="monitor-chart-settings"]')) setTimeout(syncBackdrop, 0);
      });
      backdrop.addEventListener('click', closeAll);
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeAll(); });
      // The drawer's own drag-to-resize (panel-drawer-resize.js) changes drawerWidth mid-drag, same
      // reason panel-grid.ejs recomputes on resize — both change how much space is left to center in.
      window.addEventListener('resize', function () { if (chartWrap && chartWrap.classList.contains('editing')) centerChart(); });
      window.recenterEditingPanel = function () { if (chartWrap && chartWrap.classList.contains('editing')) centerChart(); };
    })();
  </script>
  <script>
    // Auto-saves on every field change and live-patches the chart canvas above, instead of a Save
    // button that navigates the whole page away and closes the drawer — same behavior/reasoning as
    // a dashboard chart panel's own Edit form (see panel-grid.ejs's own "Auto-saves every
    // .panel-settings-form" script), just scoped to a single canvas instead of a whole panel card:
    // this page has no .dash-panel wrapper or generic "content element" to detect, so it patches
    // the one element it actually has (canvas[data-monitor-ids] inside .chart-wrap) directly rather
    // than reusing that script's more generic (and here, unnecessary) card-patching logic.
    (function () {
      var form = document.getElementById('monitor-chart-settings');
      if (!form) return;
      var SAVE_DELAY_MS = 700;
      var pending = null;

      function setStatus(text) {
        var status = form.querySelector('.panel-save-status');
        if (status) status.textContent = text;
      }

      function doSave(url) {
        clearTimeout(pending);
        pending = null;
        setStatus('Saving…');
        var params = new URLSearchParams();
        new FormData(form).forEach(function (value, key) { params.append(key, value); });
        fetch(url, { method: 'POST', body: params })
          .then(function (res) {
            if (!res.ok) throw new Error('save failed');
            return res.text();
          })
          .then(function (html) {
            var freshDoc = new DOMParser().parseFromString(html, 'text/html');
            var freshCanvas = freshDoc.querySelector('canvas[data-monitor-ids]');
            var oldCanvas = document.querySelector('.chart-wrap canvas[data-monitor-ids]');
            if (oldCanvas && freshCanvas) {
              // The OLD canvas's own Chart.js instance + its refresh loop (see monitor-chart.js)
              // would otherwise just keep running forever in the background after being detached
              // here — every edit would leave one more of these piled up, still fetching/rendering
              // into a chart object nothing on screen points at any more.
              if (oldCanvas._loxsuiteCleanup) oldCanvas._loxsuiteCleanup();
              oldCanvas.replaceWith(freshCanvas);
              if (window.initChartCanvas) window.initChartCanvas(freshCanvas);
            }
            // Unit/scale/decimals/value-labels below live in the SAME saved config as the chart's
            // own appearance (see routes/monitor.js's chart-settings handler) — this bar has no
            // canvas dataset of its own to read those from, so it's re-rendered from the fresh
            // server HTML same as the canvas above, or a color/label edit would otherwise only ever
            // show up after a full page reload instead of right away like everything else here.
            var freshBar = freshDoc.querySelector('.monitor-current-value-bar');
            var oldBar = document.querySelector('.monitor-current-value-bar');
            if (oldBar && freshBar) oldBar.replaceWith(freshBar);
            setStatus('Saved');
            setTimeout(function () { setStatus(''); }, 1500);
          })
          .catch(function () { setStatus('Save failed'); });
      }

      function scheduleSave() {
        setStatus('Editing…');
        clearTimeout(pending);
        pending = setTimeout(function () { doSave(form.action); }, SAVE_DELAY_MS);
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        // save-as-default/reset-to-default are type="submit" buttons with their own formaction
        // (see the drawer header above) — e.submitter is which button actually triggered this,
        // so a plain Enter-to-submit (no formaction) still correctly falls back to the form's own
        // main save action instead of picking one of those by accident.
        var url = (e.submitter && e.submitter.getAttribute('formaction')) || form.action;
        doSave(url);
      });
      ['input', 'change'].forEach(function (evtName) { form.addEventListener(evtName, scheduleSave); });

      // Threshold/annotation row-remove buttons only ever fire a click, never an input/change on
      // the (now-detached) row itself, so they need their own trigger. Closing the drawer (backdrop
      // or its own ×) must not silently drop a still-debounced change either.
      document.addEventListener('click', function (e) {
        if (e.target.closest('#monitor-chart-settings .threshold-row-remove, #monitor-chart-settings .annotation-row-remove')) {
          scheduleSave();
          return;
        }
        if (pending && (e.target.closest('#monitor-chart-backdrop') || e.target.closest('[data-toggle-row="monitor-chart-settings"]'))) {
          doSave(form.action);
        }
      });
    })();
  </script>
<% } %>
<script src="/vendor/chart.umd.min.js"></script>
<%
  // chartjs-plugin-zoom reads window.Hammer at its OWN script-evaluation time (it's a UMD module
  // whose browser-globals branch does `t.ChartZoom = n(t.Chart, t.Hammer, ...)`) — Hammer.js has
  // to already be loaded before this tag, not just before the plugin is *used*. Without it, the
  // plugin silently skips setting up its Hammer.Manager entirely (the pinch/pan gesture handling),
  // while wheel-zoom keeps working fine since that's wired via a plain native 'wheel' listener,
  // not Hammer — exactly the "zoom works, pan doesn't, no error anywhere" shape this had.
%>
<script src="/vendor/hammer.min.js"></script>
<script src="/vendor/chartjs-plugin-zoom.min.js"></script>
<script src="/monitor-chart.js?v=<%= assetVersion %>" defer></script>
<script>
  // "?open=settings" (see notificationLinks.js) — a threshold-ladder notification lands here
  // with this set, so it opens straight into the same Chart settings drawer the "edit" icon
  // button toggles, instead of just landing on the page and leaving you to find and click it.
  // Same trick as Miniservers' own "?open=<id>" (see miniservers.ejs), just triggered via a
  // simulated click on the existing toggle button — it's already wired to foot.ejs's shared
  // delegated [data-toggle-row] handler, so there's no separate open-logic to duplicate here.
  // No-ops if the button doesn't exist at all (no chart to configure, or view-only permission).
  (function () {
    if (new URLSearchParams(location.search).get('open') !== 'settings') return;
    var btn = document.querySelector('[data-toggle-row="monitor-chart-settings"]');
    if (btn) btn.click();
  })();
</script>

<%- include('partials/foot') %>
