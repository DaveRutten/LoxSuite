<%- include('partials/head', { pageTitle: 'MQTT Roles', active: 'mqtt-roles' }) %>

<%- include('partials/tabs-mqtt-broker', { active: 'mqtt-roles' }) %>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<p class="hint">
  <%= t('Roles define what a client is allowed to publish/subscribe to.') %> <code>client</code> <%= t('(full access) and') %>
  <code>admin</code> <%= t('(broker control) are built-in and used by the gateway itself — create a custom role here if you want to scope a device to only its own topics. You can edit their ACLs too, but be careful: removing') %> <code>client</code>'s <code>#</code> <%= t('access breaks every device using it, and removing') %>
  <code>admin</code>'s <code>$CONTROL/dynamic-security/#</code> <%= t('access locks the gateway out of managing users/roles until you fix it via') %> <code>mosquitto_ctrl</code><%= t('. The roles themselves can\'t be deleted.') %>
</p>

<% if (canEdit('mqtt_roles')) { %>
<details class="add-panel">
  <summary><%= t('Add role') %></summary>
  <div class="add-panel-body">
    <form method="post" action="/mqtt-roles">
      <div class="form-grid">
        <div><label><%= t('Role name') %></label><input type="text" name="rolename" required></div>
        <button type="submit" class="primary"><%- icon('plus') %> <%= t('Add') %></button>
      </div>
    </form>
  </div>
</details>
<% } %>

<% roles.forEach(role => { %>
  <details class="add-panel">
    <summary>
      <%= role.rolename %>
      <% if (protectedRoles.includes(role.rolename)) { %><span class="badge badge-neutral" style="margin-left:0.5rem;"><%= t('Built-in') %></span><% } %>
      <span class="hint" style="margin:0 0 0 0.5rem;"><%= (role.acls || []).length %> <%= t('ACL') %><%= (role.acls || []).length === 1 ? '' : 's' %></span>
    </summary>
    <div class="add-panel-body">
    <% if (!protectedRoles.includes(role.rolename) && canEdit('mqtt_roles')) { %>
      <div class="row-actions" style="justify-content:flex-end; margin-bottom:0.9rem;">
        <form method="post" action="/mqtt-roles/<%= role.rolename %>/delete" data-confirm="<%= t('Delete this role?') %>">
          <button type="submit" class="danger"><%- icon('trash') %> <%= t('Delete role') %></button>
        </form>
      </div>
    <% } %>

    <div class="table-wrap">
      <table class="acl-table">
        <thead>
          <tr><th><%= t('ACL type') %></th><th><%= t('Topic filter') %></th><th><%= t('Allow') %></th><th><%= t('Actions') %></th></tr>
        </thead>
        <tbody>
          <% (role.acls || []).forEach((acl, i) => { %>
            <% var editRowId = 'acl-edit-' + role.rolename + '-' + i; %>
            <tr>
              <td><%= acl.acltype %></td>
              <td><code><%= acl.topic %></code></td>
              <td><span class="badge <%= acl.allow ? 'badge-ok' : 'badge-off' %>"><%= acl.allow ? 'Allow' : 'Deny' %></span></td>
              <td>
                <% if (canEdit('mqtt_roles')) { %>
                <div class="row-actions">
                  <button type="button" class="btn-edit" data-toggle-row="<%= editRowId %>"><%- icon('edit') %> <%= t('Edit') %></button>
                  <form class="inline" method="post" action="/mqtt-roles/<%= role.rolename %>/acls/delete">
                    <input type="hidden" name="acltype" value="<%= acl.acltype %>">
                    <input type="hidden" name="topic" value="<%= acl.topic %>">
                    <button type="submit" class="danger"><%- icon('trash') %> <%= t('Remove') %></button>
                  </form>
                </div>
                <% } %>
              </td>
            </tr>
            <% if (canEdit('mqtt_roles')) { %>
            <tr class="expand-row" id="<%= editRowId %>">
              <td colspan="4">
                <form method="post" action="/mqtt-roles/<%= role.rolename %>/acls/edit" class="form-grid" style="gap:0.6rem;">
                  <input type="hidden" name="old_acltype" value="<%= acl.acltype %>">
                  <input type="hidden" name="old_topic" value="<%= acl.topic %>">
                  <div>
                    <label><%= t('ACL type') %></label>
                    <select name="acltype">
                      <% aclTypes.forEach(tt => { %>
                        <option value="<%= tt %>" <%= tt === acl.acltype ? 'selected' : '' %>><%= tt %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div><label><%= t('Topic filter') %></label><input type="text" name="topic" value="<%= acl.topic %>" required></div>
                  <div>
                    <label><%= t('Effect') %></label>
                    <select name="allow">
                      <option value="1" <%= acl.allow ? 'selected' : '' %>><%= t('Allow') %></option>
                      <option value="0" <%= !acl.allow ? 'selected' : '' %>><%= t('Deny') %></option>
                    </select>
                  </div>
                  <button type="submit" class="btn-edit"><%- icon('edit') %> <%= t('Save') %></button>
                </form>
              </td>
            </tr>
            <% } %>
          <% }) %>
          <% if (!role.acls || role.acls.length === 0) { %>
            <tr><td colspan="4" class="empty"><%= t('No ACLs on this role — it currently grants no access.') %></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <% if (canEdit('mqtt_roles')) { %>
    <form method="post" action="/mqtt-roles/<%= role.rolename %>/acls">
      <div class="form-grid">
        <div>
          <label><%= t('ACL type') %></label>
          <select name="acltype">
            <% aclTypes.forEach(tt => { %>
              <option value="<%= tt %>"><%= tt %></option>
            <% }) %>
          </select>
        </div>
        <div><label><%= t('Topic filter') %></label><input type="text" name="topic" placeholder="<%= t('home/livingroom/#') %>" required></div>
        <div>
          <label><%= t('Effect') %></label>
          <select name="allow">
            <option value="1"><%= t('Allow') %></option>
            <option value="0"><%= t('Deny') %></option>
          </select>
        </div>
        <button type="submit" class="primary"><%- icon('plus') %> <%= t('Add ACL') %></button>
      </div>
    </form>
    <% } %>
    </div>
  </details>
<% }) %>

<%- include('partials/foot') %>
