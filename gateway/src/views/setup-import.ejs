<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>Existing data found · LoxSuite setup</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/style.css">
  <script>
    (function () {
      var saved = localStorage.getItem('theme');
      if (saved === 'light' || saved === 'dark') document.documentElement.setAttribute('data-theme', saved);
    })();
  </script>
</head>
<body class="login-page">
  <div class="login-box" style="max-width:42rem;">
    <div class="brand">
      <span class="brand-icon"><%- icon('logo', { size: 18 }) %></span>
      <span>LoxSuite setup</span>
    </div>

    <div class="card">
      <h2>Existing SQLite data found</h2>
      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>
      <p class="hint">
        This install just started up against a database backend other than SQLite, but a real,
        already-used SQLite database is still sitting at <code><%= sqlitePath %></code>. Switching
        backends doesn't move your data on its own — this fresh database only has the default
        Administrator/Viewer roles and the account you just logged in with, none of your actual
        Miniservers, Monitors, dashboards, or history.
      </p>
      <p class="hint">
        You can import that existing data now — it <strong>replaces</strong> everything currently in
        this database with what's in the SQLite file, including the user account you're logged in
        with right now. You'll be signed out once it finishes, to log back in with your real account.
      </p>

      <h3 style="margin-top:1.1rem;">What would be imported</h3>
      <div class="table-wrap" style="max-height:14rem; overflow-y:auto; margin-top:0.5rem;">
        <table>
          <thead><tr><th>Table</th><th style="text-align:right;">Rows</th></tr></thead>
          <tbody>
            <% scan.rowCounts.filter(r => r.count > 0).forEach(r => { %>
              <tr><td><%= r.table %></td><td style="text-align:right;"><%= r.count %></td></tr>
            <% }) %>
            <% if (!scan.rowCounts.some(r => r.count > 0)) { %>
              <tr><td colspan="2" class="hint">No rows in any table — nothing meaningful to import.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <% if (scan.orphanFindings.length > 0) { %>
        <div style="margin-top:1rem; padding:0.6rem 0.9rem; border-radius:var(--radius); background:var(--surface-alt); border:1px solid var(--border);">
          <p class="hint" style="margin:0 0 0.4rem; color:var(--danger);">
            Found rows whose foreign key points at a row that no longer exists (SQLite never
            enforced these) — Postgres/MySQL do, so the import will fail unless these are skipped:
          </p>
          <ul style="margin:0; padding-left:1.1rem; font-size:0.82rem; color:var(--text-muted);">
            <% scan.orphanFindings.forEach(f => { %>
              <li><%= f.table %>.<%= f.column %> &rarr; <%= f.refTable %>.id: <%= f.count %> row(s)</li>
            <% }) %>
          </ul>
          <label style="display:flex; align-items:center; gap:0.4rem; margin-top:0.6rem; font-size:0.85rem;">
            <input type="checkbox" id="prune-orphans-checkbox">
            Skip these rows and import everything else
          </label>
        </div>
      <% } %>

      <div id="import-console" hidden style="margin-top:1rem;">
        <pre id="import-console-output" style="max-height:16rem; overflow-y:auto; margin:0; padding:0.7rem 0.9rem; border-radius:var(--radius); background:var(--surface-alt); border:1px solid var(--border); font-family:'SF Mono', Consolas, monospace; font-size:0.78rem; white-space:pre-wrap;"></pre>
      </div>
      <div id="import-done" hidden style="margin-top:1rem;">
        <p class="hint" style="color:var(--success);">
          Import complete — click below to sign in again with your real account.
        </p>
        <button type="button" id="import-login-btn" class="primary" style="width:100%;">Log out &amp; sign in again</button>
      </div>

      <div id="import-actions" style="display:flex; align-items:center; justify-content:space-between; margin-top:1.25rem;">
        <form method="post" action="/setup/import/dismiss">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn-soft">I don't need this — skip</button>
        </form>
        <button type="button" id="import-start-btn" class="primary" style="width:auto; margin-top:0;">Start import</button>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var startBtn = document.getElementById('import-start-btn');
      var actions = document.getElementById('import-actions');
      var consoleWrap = document.getElementById('import-console');
      var consoleOutput = document.getElementById('import-console-output');
      var doneWrap = document.getElementById('import-done');
      var pruneCheckbox = document.getElementById('prune-orphans-checkbox');
      var loginBtn = document.getElementById('import-login-btn');

      function appendLine(text) {
        consoleOutput.textContent += text + '\n';
        consoleOutput.scrollTop = consoleOutput.scrollHeight;
      }

      startBtn.addEventListener('click', function () {
        startBtn.disabled = true;
        actions.querySelector('button[type="submit"]').disabled = true;
        consoleWrap.hidden = false;

        // Content-Type: application/json exempts this from the CSRF form-token check server-side
        // (see middleware/csrf.js), same convention as every other JS-driven POST in this app.
        fetch('/setup/import/run', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ prune_orphans: !!(pruneCheckbox && pruneCheckbox.checked) }),
        }).then(function (resp) {
          var reader = resp.body.getReader();
          var decoder = new TextDecoder();
          var buffer = '';

          function handleLine(line) {
            if (line === '__DONE__') {
              actions.hidden = true;
              doneWrap.hidden = false;
              return;
            }
            if (line === '__ERROR__') {
              startBtn.disabled = false;
              actions.querySelector('button[type="submit"]').disabled = false;
              return;
            }
            if (line) appendLine(line);
          }

          function read() {
            return reader.read().then(function (result) {
              if (result.done) {
                if (buffer) handleLine(buffer);
                return;
              }
              buffer += decoder.decode(result.value, { stream: true });
              var lines = buffer.split('\n');
              buffer = lines.pop();
              lines.forEach(handleLine);
              return read();
            });
          }
          return read();
        }).catch(function (err) {
          appendLine('Request failed: ' + err.message);
          startBtn.disabled = false;
          actions.querySelector('button[type="submit"]').disabled = false;
        });
      });

      loginBtn.addEventListener('click', function () {
        // Same JSON-exemption reasoning as the /setup/import/run call above.
        fetch('/logout', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' }).then(function () {
          window.location.href = '/login';
        });
      });
    })();
  </script>
</body>
</html>
