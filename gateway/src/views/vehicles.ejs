<%- include('partials/head', { pageTitle: 'Vehicles', active: 'vehicles' }) %>

<% if (error) { %><p class="error"><%= error %></p><% } %>

<p class="hint">
  <%= t('The cars charged at home. Each one can read its live state — battery %, range, plugged in, location — from something that already talks to the car: a Homey Pro or Home Assistant (which have apps for most car brands), or MQTT topics from Node-RED, evcc and similar tools. Without a source the charging planner estimates the battery level.') %>
</p>

<div class="card">
  <% if (!vehicles.length) { %>
    <p class="hint" style="margin:0;"><%= t('No vehicles yet.') %></p>
  <% } else { %>
    <div class="en-tiles" style="margin-bottom:0.8rem;">
      <% vehicles.forEach(x => { const s = x.status; const r = s.reading || {}; const bad = s.health && s.health.status === 'failing';
         const col = !x.enabled ? 'var(--text-muted)' : bad ? 'var(--en-import)' : r.plugged === true ? 'var(--en-export)' : 'var(--en-car)'; %>
      <a class="en-tile" href="/vehicles/<%= x.id %>"><%- enIcon('car', col) %><div class="en-tx">
        <div class="en-l"><%= x.name %> · <%= x.type === 'phev' ? t('Plug-in hybrid') : t('Full electric') %></div>
        <div class="en-v"><%= r.soc != null ? r.soc + '%' : '—' %><% if (r.range_km != null) { %> <small style="font-size:0.8rem; font-weight:500; color:var(--text-muted);"><%= r.range_km %> km</small><% } %></div>
        <div class="en-s"><%= r.plugged === true ? t('plugged in') : r.home === true ? t('home') : r.home === false ? t('away') : '' %><%= !x.enabled ? t('(disabled)') : bad ? ' · ' + t('source failing') : '' %><%= s.sourceUpdatedAt ? ' · ' + formatDateTime(s.sourceUpdatedAt).slice(0, 17) : '' %></div>
      </div></a>
      <% }) %>
    </div>
    <details class="mm-detail"><summary class="mm-sum"><%= t('All details') %></summary>
    <table>
      <thead><tr><th><%= t('Name') %></th><th><%= t('Type') %></th><th><%= t('Battery') %></th><th><%= t('Source') %></th><th><%= t('Now') %></th><th><%= t('Updated') %></th></tr></thead>
      <tbody>
        <% vehicles.forEach(x => { const s = x.status; const r = s.reading || {}; %>
          <tr>
            <td><a href="/vehicles/<%= x.id %>"><%= x.name %></a></td>
            <td><%= x.type === 'phev' ? 'Plug-in hybrid' : 'Full electric' %></td>
            <td><%= x.battery_kwh ? x.battery_kwh + ' kWh' : '—' %></td>
            <td>
              <%= sourceLabels[x.status.sourceKind || x.source_type] || x.source_type %>
              <% if (!x.enabled) { %><span class="hint"> <%= t('(disabled)') %></span>
              <% } else if (s.health && s.health.status === 'failing') { %><span style="color: var(--danger);"> <%= t('· failing') %></span>
              <% } else if (s.health && s.health.status === 'ok') { %><span style="color: var(--success);"> <%= t('· ok') %></span><% } %>
            </td>
            <td>
              <% if (r.soc != null) { %><strong><%= r.soc %>%</strong><% } %>
              <% if (r.range_km != null) { %> &middot; <%= r.range_km %> km<% } %>
              <% if (r.plugged === true) { %> <%= t('· plugged in') %><% } else if (r.home === true) { %> <%= t('· home') %><% } else if (r.home === false) { %> <%= t('· away') %><% } %>
              <% if (r.soc == null && r.plugged == null && r.home == null) { %>&mdash;<% } %>
            </td>
            <td class="hint"><%= s.sourceUpdatedAt ? formatDateTime(s.sourceUpdatedAt) : '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </details>
    <% const pins = vehicles.filter(x => x.enabled && x.status.reading && x.status.reading.latitude != null && x.status.reading.longitude != null).map(x => ({ lat: Number(x.status.reading.latitude), lon: Number(x.status.reading.longitude), label: x.name })); %>
    <% if (pins.length) { %>
      <div id="veh-map" style="margin-top:0.9rem;"></div>
      <script>window.lsMiniMap(document.getElementById('veh-map'), <%- JSON.stringify(pins) %>, { height: 220 });</script>
    <% } %>
  <% } %>
</div>

<% if (canEdit('vehicles')) { %>
<details class="card" <%= vehicles.length ? '' : 'open' %>>
  <summary><strong><%= t('Add vehicle') %></strong></summary>
  <form method="post" action="/vehicles" style="margin-top:0.8rem;">
    <%- include('partials/vehicle-fields', { v, fields, presets }) %>
    <div class="btn-row" style="margin-top:0.9rem;">
      <button type="submit" class="primary"><%- icon('plus') %> <%= t('Add') %></button>
    </div>
  </form>
</details>
<% } %>

<%- include('partials/foot') %>
