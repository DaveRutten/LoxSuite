<%- include('partials/head', { pageTitle: 'Administration', active: 'admin' }) %>

<div class="tabs">
  <a class="active" href="/admin/general"><%= t('General') %></a>
  <a href="/admin/users"><%= t('Users') %></a>
  <a href="/admin/roles"><%= t('Access Roles') %></a>
  <a href="/admin/backup"><%= t('Backups') %></a>
  <a href="/admin/notifications"><%= t('Notifications') %></a>
  <a href="/admin/security"><%= t('Security') %></a>
  <a href="/admin/modules"><%= t('Modules') %></a>
  <a href="/admin/languages"><%= t('Languages') %></a>
  <% if (typeof moduleOn !== 'function' || moduleOn('ai')) { %><a href="/admin/ai"><%= t('AI Assistant') %></a><% } %>
</div>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<%
  // getVersionStatus() (see versionCheck.js) is a plain in-memory read — the GitHub call itself
  // only runs on its own timer (boot + daily) or when this page's own "Check now" button below
  // posts to /admin/check-update, same reasoning as the sidebar's own version display (head.ejs).
  const versionStatus = getVersionStatus();
%>
<div class="card">
  <h2><%= t('LoxSuite version') %></h2>
  <p class="hint">
    <span style="display:block;"><%= t('Installed:') %> <strong style="color:var(--text);">v<%= versionStatus.currentVersion %></strong></span>
    <span style="display:block;">
      <% if (versionStatus.updateAvailable) { %>
        <%= t('Available:') %> <strong style="color:var(--text);">v<%= versionStatus.latestVersion %></strong>
      <% } else if (versionStatus.latestVersion) { %>
        <%
          // Deliberately NOT "Available: vX (up to date)" — that repeats the exact same version
          // string Installed just showed right above it, which reads as if something's wrong
          // (two different-looking labels claiming the same number) rather than as reassurance.
        %>
        <strong style="color:var(--success);"><%= t('Up to date') %></strong>
      <% } else if (versionStatus.lastCheckReached === false) { %>
        <%= t('Available: unknown — could not reach GitHub (offline, timeout, or rate-limited)') %>
      <% } else if (versionStatus.lastCheckReached === true) { %>
        <%= t('Available: unknown — no release tags found on GitHub yet') %>
      <% } else { %>
        <%= t('Available: unknown — not checked yet') %>
      <% } %>
    </span>
    <% if (versionStatus.checkedAt) { %>
      <span style="display:block; margin-top:0.2rem;"><%= t('Last checked:') %> <%= formatDateTime(versionStatus.checkedAt) %><% if (justChecked) { %> <%= t('— just now') %><% } %></span>
    <% } %>
  </p>
  <div class="row-actions" style="justify-content:flex-start;">
    <form method="post" action="/admin/check-update" style="margin:0;">
      <button type="submit" class="btn-test"><%- icon('refresh') %> <%= t('Check for updates now') %></button>
    </form>
    <% if (versionStatus.updateAvailable && versionStatus.changelog) { %>
      <button type="button" class="btn-soft" id="view-changelog-btn"><%- icon('list') %> <%= t('View changelog') %></button>
    <% } %>
    <a class="inline" href="https://github.com/DaveRutten/LoxSuite" target="_blank" rel="noopener"><button type="button" class="btn-soft"><%- icon('link') %> <%= t('GitHub page') %></button></a>
  </div>
</div>

<% if (versionStatus.updateAvailable && versionStatus.changelog) { %>
<dialog id="update-changelog-dialog" class="update-changelog-dialog">
  <h2><%= t('What\'s new in v') %><%= versionStatus.latestVersion %></h2>
  <div class="update-changelog-body"><%- versionStatus.changelogHtml %></div>
  <div style="display:flex; justify-content:flex-end; margin-top:0.9rem;">
    <button type="button" class="btn-soft" id="close-changelog-btn"><%= t('Close') %></button>
  </div>
</dialog>
<script>
  (function () {
    var dialog = document.getElementById('update-changelog-dialog');
    var viewBtn = document.getElementById('view-changelog-btn');
    var closeBtn = document.getElementById('close-changelog-btn');
    if (!dialog) return;
    if (viewBtn) viewBtn.addEventListener('click', function () { dialog.showModal(); });
    if (closeBtn) closeBtn.addEventListener('click', function () { dialog.close(); });
    // Only pops up on its own right after a check that found something new — on a plain page
    // load (e.g. navigating here later that same day) it stays closed until "View changelog" is
    // clicked, since by then this is old news, not something that just happened.
    <% if (justChecked) { %>
    dialog.showModal();
    <% } %>
  })();
</script>
<% } %>

<div class="card">
  <h2><%= t('Database') %></h2>
  <%
    // Postgres and MySQL/MariaDB are both real network servers (Server: host:port/db); only
    // SQLite is a local file (File: path) — everything non-sqlite takes the network-server
    // branch, so this doesn't need a third arm added if/when another backend ever lands.
    const dbBackendLabels = { postgres: 'PostgreSQL', mysql: 'MySQL/MariaDB', sqlite: 'SQLite' };
  %>
  <div style="margin-bottom:0.6rem; padding:0.6rem 0.9rem; border-radius:var(--radius); background:var(--surface-alt); border:1px solid var(--border);">
    <p class="hint" style="margin:0;">
      <span style="display:block;"><%= t('Backend:') %> <strong style="color:var(--text);"><%= dbBackendLabels[dbInfo.backend] || dbInfo.backend %></strong><% if (dbInfo.version) { %> (v<%= dbInfo.version %>)<% } %></span>
      <% if (dbInfo.backend !== 'sqlite') { %>
        <span style="display:block;"><%= t('Server:') %> <strong style="color:var(--text);"><%= dbInfo.host %>:<%= dbInfo.port %>/<%= dbInfo.database %></strong></span>
      <% } else { %>
        <span style="display:block;"><%= t('File:') %> <strong style="color:var(--text);"><%= dbInfo.dbPath %></strong></span>
      <% } %>
    </p>
  </div>
  <p class="hint">
    <%= t('Set via the') %> <code>DB_BACKEND</code>/<code>DATABASE_URL</code> <%= t('(or') %> <code>DB_HOST</code>/<code>DB_NAME</code>/<code>DB_USER</code>/...) environment
    variables — restart required to change, not a setting on this page.
  </p>
  <% if (dbInfo.backend === 'sqlite') { %>
    <p class="hint">
      <%= t('SQLite is fine for most installs, but a large one — many Monitors polled often, a long retention window, a busy Loxone Commands log — writes every one of those to a single local file with no concurrent-writer support of its own; Postgres or MySQL/MariaDB handle that load better and are worth switching to once things start feeling slow (see') %>
      <code>gateway/src/db/transfer.js</code> <%= t('to move your existing data over).') %>
    </p>
  <% } %>
</div>

<div class="card">
  <h2><%= t('Tech report') %></h2>
  <p class="hint">
    <%= t('A single diagnostic snapshot — LoxSuite/DB/Node versions, recent System/MQTT/Loxone Commands log lines, config counts (mappings, monitors, Miniservers, ...), and live MQTT/Miniserver connection status. Usernames are partially masked and passwords/secrets are never included — safe to share when asking for help diagnosing a config mistake or a real bug.') %>
  </p>
  <div class="row-actions" style="justify-content:flex-start;">
    <a class="inline" href="/admin/tech-report"><button type="button" class="btn-soft"><%- icon('list') %> <%= t('View tech report') %></button></a>
    <a class="inline" href="/admin/tech-report/download"><button type="button" class="btn-soft"><%- icon('download') %> <%= t('Download JSON') %></button></a>
  </div>
</div>

<div class="card">
  <h2><%= t('Device templates') %></h2>
  <p class="hint" id="device-templates-hint">
    <%= t('"Common commands"/"Common data" device definitions (Shelly, HeatMeister, ...), loaded from three tiers, each able to override an earlier one\'s same device: this app\'s own built-ins, anything fetched from GitHub below, then your own files in the bind-mounted') %>
    <code>device-templates/user/</code> <%= t('folder — see') %> <a href="/mappings/commands"><%= t('Common Commands') %></a>
    <%= t('for the point-and-click editor instead.') %>
  </p>
  <p class="hint">
    <span style="display:block;"><%= t('Built-in:') %> <strong style="color:var(--text);"><%= templateSources.bundled.reduce((n, f) => n + f.families.length, 0) %> <%= t('device(s)') %></strong></span>
    <span style="display:block;"><%= t('Fetched from GitHub:') %> <strong style="color:var(--text);"><%= templateSources.synced.reduce((n, f) => n + f.families.length, 0) %> <%= t('device(s)') %></strong></span>
    <span style="display:block;"><%= t('Your own (') %><code>device-templates/user/</code>): <strong style="color:var(--text);"><%= templateSources.user.reduce((n, f) => n + f.families.length, 0) %> <%= t('device(s)') %></strong></span>
    <% if (!templateSources.splitLayout) { %>
      <span style="display:block; margin-top:0.2rem;">
        <%= t('Running the old flat') %> <code>device-templates/</code> <%= t('layout still (a bare/local run outside Docker, or a Docker install that hasn\'t restarted since updating to this version yet) — the built-in vs. your-own split above isn\'t active yet; everything above is read from that one folder together.') %>
      </span>
    <% } %>
  </p>
  <% const staleUserFiles = templateSources.user.flatMap((f) => f.families.filter((fam) => fam.possiblyStale).map((fam) => ({ file: f.file, key: fam.key }))); %>
  <% if (staleUserFiles.length > 0) { %>
    <div style="margin-bottom:1rem; padding:0.6rem 0.9rem; border-radius:var(--radius); background:var(--warning-soft); border:1px solid var(--warning);">
      <p class="hint" style="color:var(--warning); margin:0 0 0.4rem;">
        <strong><%= staleUserFiles.length %> <%= t('file(s) in') %> <code>device-templates/user/</code> <%= t('look identical to a current built-in/GitHub-fetched device') %></strong>
        <%= t('— almost certainly a leftover copy from before the built-in/synced split existed, silently shadowing whatever that device\'s built-in definition is updated to next. Safe to delete from') %> <code>user/</code> <%= t('so the built-in (or a GitHub-synced update) takes over again.') %>
      </p>
      <p class="hint" style="margin:0; display:flex; flex-wrap:wrap; gap:0.4rem;">
        <% staleUserFiles.forEach((f) => { %>
          <code style="font-size:0.8rem;"><%= f.file %></code>
        <% }) %>
      </p>
    </div>
  <% } %>
  <% if (templateResult) { %>
    <% if (templateResult.action === 'reload') { %>
      <p class="hint" style="color: var(--success);"><%= t('Reloaded —') %> <%= templateResult.deviceCount %> <%= t('device(s) loaded (') %><%= templateResult.familyCount %> <%= t('with commands,') %> <%= templateResult.dataFamilyCount %> <%= t('with data points).') %></p>
    <% } else if (templateResult.action === 'fetch-github') { %>
      <% if (templateResult.error) { %>
        <p class="hint" style="color: var(--error);"><%= t('Could not fetch from GitHub —') %> <%= templateResult.error %></p>
      <% } else { %>
        <p class="hint" style="color: var(--success);">
          <%= t('Fetched') %> <%= templateResult.written.length %> <%= t('file(s) from GitHub into') %> <code>device-templates/synced/</code><% if (templateResult.failed.length > 0) { %>, <%= templateResult.failed.length %> <%= t('skipped (failed to parse:') %> <%= templateResult.failed.map((f) => f.file).join(', ') %>)<% } %><%= t('. Now') %> <%= templateResult.deviceCount %> <%= t('device(s) loaded total (') %><%= templateResult.familyCount %> <%= t('with commands,') %> <%= templateResult.dataFamilyCount %> <%= t('with data points).') %>
        </p>
      <% } %>
    <% } %>
  <% } %>
  <div class="row-actions" style="justify-content:flex-start;">
    <form method="post" action="/admin/device-templates/fetch-github" style="margin:0;">
      <button type="submit" class="btn-test"><%- icon('link') %> <%= t('Fetch latest built-ins from GitHub') %></button>
    </form>
    <form method="post" action="/admin/device-templates/reload" style="margin:0;">
      <button type="submit" class="btn-soft"><%- icon('refresh') %> <%= t('Reload from disk') %></button>
    </form>
  </div>
</div>

<div class="card">
  <h2><%= t('Setup wizard') %></h2>
  <p class="hint">
    <%= t('The guided first-run setup (admin password, timezone, Miniserver, MQTT broker, SSO, backups, notifications) — safe to run again any time, e.g. to double-check something or walk through it again in this test version.') %>
  </p>
  <a href="/setup"><button type="button" class="btn-soft"><%- icon('refresh') %> <%= t('Run setup wizard again') %></button></a>
</div>

<%- include('partials/foot') %>
