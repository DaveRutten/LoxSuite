<script>
  // Per-template "Send test" — plain fetch() (JSON in, JSON out, see the /templates/:key/test
  // route), not a real form: this whole card already lives inside the "Save templates" form, and
  // a nested <form> would be invalid/unreliable HTML. Updates just this one template's own result
  // line in place instead of a full page reload.
  (function () {
    document.querySelectorAll('.template-test-send').forEach(function (btn) {
      var triggerKey = btn.dataset.trigger;
      var select = btn.parentElement.querySelector('.template-test-channel');
      var resultEl = document.querySelector('.template-test-result[data-trigger="' + triggerKey + '"]');
      btn.addEventListener('click', function () {
        if (!select || !select.value) return;
        var original = btn.innerHTML;
        btn.disabled = true;
        btn.textContent = 'Sending…';
        if (resultEl) { resultEl.textContent = ''; resultEl.style.color = ''; }
        fetch('/admin/notifications/templates/' + encodeURIComponent(triggerKey) + '/test', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ channel_id: select.value }),
        })
          .then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); })
          .then(function (result) {
            btn.disabled = false;
            btn.innerHTML = original;
            if (!resultEl) return;
            if (result.ok && result.data.ok) {
              resultEl.textContent = 'Test message sent.';
              resultEl.style.color = 'var(--success)';
            } else {
              resultEl.textContent = 'Test failed: ' + (result.data.error || 'Unknown error');
              resultEl.style.color = 'var(--danger)';
            }
          })
          .catch(function (err) {
            btn.disabled = false;
            btn.innerHTML = original;
            if (resultEl) { resultEl.textContent = 'Test failed: ' + err.message; resultEl.style.color = 'var(--danger)'; }
          });
      });
    });
  })();
</script>

<script>
  // Shows only the field group matching the currently-selected trigger type — mirrors the same
  // toggle-by-select-value pattern used for the Monitor add form's MQTT/Loxone field groups.
  (function () {
    document.querySelectorAll('.rule-form').forEach(function (form) {
      var select = form.querySelector('.rule-trigger-select');
      if (!select) return;
      function applyVisibility() {
        form.querySelectorAll('.rule-fields').forEach(function (el) {
          el.hidden = el.dataset.for !== select.value;
        });
      }
      select.addEventListener('change', applyVisibility);
      applyVisibility();
    });
  })();
</script>

<script>
  // Builds a real Apprise URL from a friendly per-service field group and writes it into the
  // existing .channel-url-input right before the form submits — the server-side routes
  // (POST .../channels, .../channels/:id/update) are untouched, they only ever see the same plain
  // `url` field they always have. Webhook-based services (Slack/Teams/Discord) work by pasting the
  // full webhook URL the service gives you and extracting Apprise's own token(s) out of it, rather
  // than asking anyone to split a URL into tokens by hand.
  (function () {
    function buildEmailUrl(get) {
      var host = get('host'), user = get('user'), pass = get('pass'), to = get('to');
      if (!host || !user || !pass || !to) return null;
      var scheme = get('ssl') === 'on' ? 'mailtos' : 'mailto';
      var port = get('port') ? ':' + get('port') : '';
      var params = ['to=' + encodeURIComponent(to)];
      if (get('from')) params.push('from=' + encodeURIComponent(get('from')));
      return scheme + '://' + encodeURIComponent(user) + ':' + encodeURIComponent(pass) + '@' + host + port + '/?' + params.join('&');
    }
    function buildTelegramUrl(get) {
      var token = get('token'), chatIds = get('chatIds');
      if (!token || !chatIds) return null;
      var ids = chatIds.split(',').map(function (s) { return s.trim(); }).filter(Boolean).join('/');
      // format=markdown (mdv=v1, the more lenient of Telegram's two Markdown dialects) — LoxSuite's
      // own message text is written expecting this (see renderTelegramBody in notifications.js);
      // sending it as Apprise's default plain text would show the literal *bold*/emoji markup
      // characters instead of actually formatting anything.
      return ids ? ('tgram://' + token + '/' + ids + '?format=markdown&mdv=v1') : null;
    }
    function buildSlackUrl(get) {
      var m = /hooks\.slack\.com\/services\/([^/]+)\/([^/]+)\/([^/?]+)/.exec(get('webhookUrl') || '');
      if (!m) return null;
      var channel = get('channel');
      return 'slack://' + m[1] + '/' + m[2] + '/' + m[3] + (channel ? '/' + encodeURIComponent(channel.replace(/^#/, '')) : '');
    }
    function buildTeamsUrl(get) {
      var m = /webhookb2\/([^@]+)@([^/]+)\/IncomingWebhook\/([^/]+)\/([^/?]+)/.exec(get('webhookUrl') || '');
      return m ? ('msteams://' + m[1] + '/' + m[2] + '/' + m[3] + '/' + m[4] + '/') : null;
    }
    function buildDiscordUrl(get) {
      var m = /discord(?:app)?\.com\/api\/webhooks\/(\d+)\/([^/?]+)/.exec(get('webhookUrl') || '');
      return m ? ('discord://' + m[1] + '/' + m[2]) : null;
    }
    var BUILDERS = { email: buildEmailUrl, telegram: buildTelegramUrl, slack: buildSlackUrl, teams: buildTeamsUrl, discord: buildDiscordUrl };
    var ERRORS = {
      email: 'Fill in SMTP host, username, password and a recipient.',
      telegram: 'Fill in the bot token and at least one chat ID.',
      slack: "Couldn't find a Slack webhook token in that URL — paste the full Incoming Webhook URL.",
      teams: "Couldn't recognize that as a Teams webhook URL — paste the full Incoming Webhook URL, or switch Service to Custom and enter the Apprise URL directly.",
      discord: "Couldn't find a Discord webhook ID/token in that URL — paste the full Webhook URL.",
    };

    document.querySelectorAll('.channel-form').forEach(function (form) {
      var select = form.querySelector('.channel-service-select');
      if (!select) return;
      var urlInput = form.querySelector('.channel-url-input');
      var preview = form.querySelector('.channel-url-preview');

      function fieldsFor(service) { return form.querySelector('.channel-fields[data-service="' + service + '"]'); }
      function get(field) {
        var group = fieldsFor(select.value);
        var el = group && group.querySelector('[data-field="' + field + '"]');
        if (!el) return '';
        return el.type === 'checkbox' ? (el.checked ? 'on' : '') : el.value.trim();
      }

      function updatePreview() {
        if (select.value === 'custom') { preview.textContent = ''; return; }
        var builder = BUILDERS[select.value];
        var built = builder ? builder(get) : null;
        preview.textContent = built ? ('Will save as: ' + built) : '';
      }

      function applyVisibility() {
        // A `required` input doesn't get exempted from constraint validation just because a
        // hidden ANCESTOR (not the input itself) has display:none — confirmed empirically, this
        // silently blocked the whole form's submit with no error and no navigation. Toggling
        // `required` itself, not just visibility, is what actually fixes it.
        urlInput.required = select.value === 'custom';
        form.querySelectorAll('.channel-fields').forEach(function (el) {
          el.hidden = el.dataset.service !== select.value;
        });
        updatePreview();
      }

      select.addEventListener('change', applyVisibility);
      form.addEventListener('input', updatePreview);
      applyVisibility();

      form.addEventListener('submit', function (e) {
        if (select.value === 'custom') return; // urlInput already holds whatever was typed there
        var builder = BUILDERS[select.value];
        var built = builder ? builder(get) : null;
        if (!built) {
          e.preventDefault();
          window.alert(ERRORS[select.value] || 'Fill in the required fields for this service.');
          return;
        }
        urlInput.value = built;
      });
    });
  })();
</script>

