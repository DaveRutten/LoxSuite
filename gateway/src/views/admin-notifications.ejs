<%- include('partials/head', { pageTitle: 'Administration', active: 'admin' }) %>

<div class="tabs">
  <a href="/admin/general">General</a>
  <a href="/admin/users">Users</a>
  <a href="/admin/roles">Access Roles</a>
  <a href="/admin/backup">Backups</a>
  <a class="active" href="/admin/notifications">Notifications</a>
  <a href="/admin/security">Security</a>
</div>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<p class="hint">
  Sends alerts for a Monitor crossing a threshold, a Miniserver or MQTT client going online/offline,
  or a backup failing &mdash; to Teams, Slack, Telegram, Email, or anything else
  <a href="https://github.com/caronc/apprise#supported-notifications" target="_blank" rel="noopener">Apprise</a>
  supports, via a rule per event you care about and the channel(s) it should go to.
</p>

<div class="card">
  <h2>Channels</h2>
  <p class="hint">
    Each channel is a name plus one <a href="https://github.com/caronc/apprise#supported-notifications" target="_blank" rel="noopener">Apprise URL</a>
    &mdash; built by following Apprise's own docs for the service you want (e.g.
    <code>msteams://TokenA/TokenB/TokenC/</code>, <code>slack://TokenA/TokenB/TokenC/Channel</code>,
    <code>tgram://bottoken/ChatID</code>, <code>mailtos://user:pass@smtp.example.com?to=you@example.com</code>).
  </p>

  <details class="add-panel">
    <summary>Add channel</summary>
    <div class="add-panel-body">
      <form method="post" action="/admin/notifications/channels" class="channel-form">
        <div class="form-grid">
          <div><label>Name</label><input type="text" name="name" placeholder="e.g. Family Teams" required></div>
          <div>
            <label>Service</label>
            <select class="channel-service-select">
              <option value="custom">Custom (Apprise URL)</option>
              <option value="email">Email (SMTP)</option>
              <option value="telegram">Telegram</option>
              <option value="slack">Slack</option>
              <option value="teams">Microsoft Teams</option>
              <option value="discord">Discord</option>
            </select>
          </div>
        </div>
        <%- include('partials/channel-service-fields', { url: '' }) %>
        <div style="margin-top:0.9rem;">
          <button type="submit" class="primary"><%- icon('plus') %> Add</button>
        </div>
      </form>
    </div>
  </details>

  <div class="table-wrap">
    <table>
      <thead><tr><th>Name</th><th>URL</th><th>Enabled</th><th>Actions</th></tr></thead>
      <tbody>
        <% channels.forEach(c => { %>
          <tr>
            <td><%= c.name %></td>
            <td><code class="truncate" title="<%= c.url %>"><%= c.url %></code></td>
            <td><span class="badge <%= c.enabled ? 'badge-ok' : 'badge-neutral' %>"><%= c.enabled ? 'Yes' : 'No' %></span></td>
            <td>
              <div class="row-actions">
                <form class="inline" method="post" action="/admin/notifications/channels/<%= c.id %>/test">
                  <button type="submit" class="btn-test"><%- icon('refresh') %> Send test</button>
                </form>
                <button type="button" class="btn-edit" data-toggle-row="channel-edit-<%= c.id %>"><%- icon('edit') %> Edit</button>
                <form class="inline" method="post" action="/admin/notifications/channels/<%= c.id %>/delete" data-confirm="Delete this channel? Any rule using it will just stop sending through it.">
                  <button type="submit" class="danger"><%- icon('trash') %> Delete</button>
                </form>
                <% if (testResult && testResult.channelId === c.id) { %>
                  <span class="hint" style="margin:0; <%= testResult.ok ? 'color: var(--success);' : 'color: var(--danger);' %>">
                    <% if (testResult.ok) { %>Test message sent.<% } else { %>Test failed: <%= testResult.error %><% } %>
                  </span>
                <% } %>
              </div>
            </td>
          </tr>
          <tr class="expand-row" id="channel-edit-<%= c.id %>">
            <td colspan="4">
              <form method="post" action="/admin/notifications/channels/<%= c.id %>/update" class="channel-form">
                <div class="form-grid">
                  <div><label>Name</label><input type="text" name="name" value="<%= c.name %>" required></div>
                  <div>
                    <label>Service</label>
                    <select class="channel-service-select">
                      <option value="custom">Custom (Apprise URL)</option>
                      <option value="email">Email (SMTP)</option>
                      <option value="telegram">Telegram</option>
                      <option value="slack">Slack</option>
                      <option value="teams">Microsoft Teams</option>
                      <option value="discord">Discord</option>
                    </select>
                  </div>
                  <div>
                    <label>Enabled</label>
                    <%- toggleSwitch('enabled', c.enabled) %>
                  </div>
                </div>
                <%- include('partials/channel-service-fields', { url: c.url }) %>
                <div style="margin-top:0.6rem;">
                  <button type="submit" class="btn-edit"><%- icon('edit') %> Save</button>
                </div>
              </form>
            </td>
          </tr>
        <% }) %>
        <% if (channels.length === 0) { %>
          <tr><td colspan="4" class="empty">No channels yet &mdash; add one above.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<div class="card">
  <h2>Rules</h2>

  <details class="add-panel" <%= presetTrigger ? 'open' : '' %>>
    <summary>Add rule</summary>
    <div class="add-panel-body">
      <form method="post" action="/admin/notifications/rules" class="rule-form">
        <div class="form-grid">
          <div><label>Name</label><input type="text" name="name" placeholder="e.g. Freezer too warm" required></div>
          <div>
            <label>Trigger</label>
            <select name="trigger_type" class="rule-trigger-select">
              <% triggerTypes.forEach(t => { %><option value="<%= t.key %>" <%= t.key === presetTrigger ? 'selected' : '' %>><%= t.label %></option><% }) %>
            </select>
          </div>
        </div>

        <div class="form-grid rule-fields" data-for="monitor_threshold" style="margin-top:0.85rem;">
          <div>
            <label>Monitor</label>
            <select name="monitor_id">
              <option value="">Choose a monitor&hellip;</option>
              <% monitors.forEach(m => { %><option value="<%= m.id %>"><%= m.label %></option><% }) %>
            </select>
          </div>
          <div>
            <label>Condition</label>
            <select name="operator">
              <option value="gt">&gt; (greater than)</option>
              <option value="gte">&ge; (at least)</option>
              <option value="lt">&lt; (less than)</option>
              <option value="lte">&le; (at most)</option>
              <option value="eq">= (equals)</option>
            </select>
          </div>
          <div><label>Value</label><input type="number" step="any" name="threshold_value"></div>
        </div>
        <label class="toggle-row rule-fields" data-for="monitor_threshold" style="margin-top:0.5rem;">
          <input type="checkbox" name="notify_on_recover">
          <span><strong>Also notify on recovery</strong><span class="hint">Send a second message once the value is back within range, not just when it first crosses the line.</span></span>
        </label>

        <div class="form-grid rule-fields" data-for="miniserver_status" style="margin-top:0.85rem;">
          <div>
            <label>Miniserver</label>
            <select name="miniserver_id">
              <option value="">Any Miniserver</option>
              <% miniservers.forEach(ms => { %><option value="<%= ms.id %>"><%= ms.name %></option><% }) %>
            </select>
          </div>
        </div>

        <div class="form-grid rule-fields" data-for="firmware_changed" style="margin-top:0.85rem;">
          <div>
            <label>Miniserver</label>
            <select name="firmware_miniserver_id">
              <option value="">Any Miniserver</option>
              <% miniservers.forEach(ms => { %><option value="<%= ms.id %>"><%= ms.name %></option><% }) %>
            </select>
          </div>
        </div>

        <div class="form-grid rule-fields" data-for="gateway_client_firmware_mismatch" style="margin-top:0.85rem;">
          <div>
            <label>Gateway (blank = any Gateway with Clients)</label>
            <select name="gateway_mismatch_miniserver_id">
              <option value="">Any Gateway</option>
              <% miniservers.forEach(ms => { %><option value="<%= ms.id %>"><%= ms.name %></option><% }) %>
            </select>
          </div>
          <div>
            <label>Severity</label>
            <select name="gateway_mismatch_severity">
              <option value="info">Info</option>
              <option value="warning" selected>Warning</option>
              <option value="critical">Critical</option>
            </select>
          </div>
        </div>
        <p class="hint rule-fields" data-for="gateway_client_firmware_mismatch" style="margin-top:0.35rem;">
          Fires when a Gateway Miniserver's own firmware differs from one of its Client
          Miniservers' &mdash; both sides need to be confirmed <strong>Running</strong> (not
          mid-boot/mid-update) for this to fire, so a routine restart on either one doesn't
          misfire it.
        </p>

        <div class="form-grid rule-fields" data-for="mqtt_client_status" style="margin-top:0.85rem;">
          <div><label>MQTT username (blank = any client)</label><input type="text" name="mqtt_username" placeholder="e.g. shelly-livingroom"></div>
        </div>

        <div class="form-grid rule-fields" data-for="battery_weak" style="margin-top:0.85rem;">
          <div>
            <label>Miniserver</label>
            <select name="battery_miniserver_id">
              <option value="">Any Miniserver</option>
              <% miniservers.forEach(ms => { %><option value="<%= ms.id %>"><%= ms.name %></option><% }) %>
            </select>
          </div>
          <div>
            <label>Severity</label>
            <select name="battery_severity">
              <option value="info">Info</option>
              <option value="warning" selected>Warning</option>
              <option value="critical">Critical</option>
            </select>
          </div>
        </div>

        <div class="form-grid rule-fields" data-for="device_firmware_changed" style="margin-top:0.85rem;">
          <div>
            <label>Miniserver</label>
            <select name="device_firmware_miniserver_id">
              <option value="">Any Miniserver</option>
              <% miniservers.forEach(ms => { %><option value="<%= ms.id %>"><%= ms.name %></option><% }) %>
            </select>
          </div>
          <div>
            <label>Severity</label>
            <select name="device_firmware_severity">
              <option value="info" selected>Info</option>
              <option value="warning">Warning</option>
              <option value="critical">Critical</option>
            </select>
          </div>
        </div>

        <div class="form-grid rule-fields" data-for="device_offline" style="margin-top:0.85rem;">
          <div>
            <label>Miniserver</label>
            <select name="device_offline_miniserver_id">
              <option value="">Any Miniserver</option>
              <% miniservers.forEach(ms => { %><option value="<%= ms.id %>"><%= ms.name %></option><% }) %>
            </select>
          </div>
          <div>
            <label>Severity (offline only &mdash; back online is always "Info")</label>
            <select name="device_offline_severity">
              <option value="info">Info</option>
              <option value="warning" selected>Warning</option>
              <option value="critical">Critical</option>
            </select>
          </div>
        </div>

        <div style="margin-top:0.9rem;">
          <label style="display:block; font-size:0.78rem; font-weight:500; margin-bottom:0.4rem; color:var(--text-muted);">Send via</label>
          <% if (channels.length === 0) { %>
            <p class="hint" style="margin:0;">No channels yet &mdash; add one above first.</p>
          <% } %>
          <% channels.forEach(c => { %>
            <label style="display:inline-flex; align-items:center; gap:0.3rem; margin:0 1rem 0.4rem 0; font-size:0.87rem;">
              <input type="checkbox" name="channel_ids" value="<%= c.id %>"> <%= c.name %>
            </label>
          <% }) %>
        </div>

        <div style="margin-top:0.9rem;">
          <button type="submit" class="primary"><%- icon('plus') %> Add rule</button>
        </div>
      </form>
    </div>
  </details>

  <div class="table-wrap">
    <table>
      <thead><tr><th>Name</th><th>Trigger</th><th>Channels</th><th>Enabled</th><th>Actions</th></tr></thead>
      <tbody>
        <% rules.forEach(r => { %>
          <% const triggerLabel = (triggerTypes.find(t => t.key === r.trigger_type) || {}).label || r.trigger_type; %>
          <tr>
            <td><%= r.name %></td>
            <td><%= triggerLabel %></td>
            <td><%= r.channels.map(c => c.name).join(', ') || '-' %></td>
            <td><span class="badge <%= r.enabled ? 'badge-ok' : 'badge-neutral' %>"><%= r.enabled ? 'Yes' : 'No' %></span></td>
            <td>
              <div class="row-actions">
                <button type="button" class="btn-edit" data-toggle-row="rule-edit-<%= r.id %>"><%- icon('edit') %> Edit</button>
                <form class="inline" method="post" action="/admin/notifications/rules/<%= r.id %>/delete" data-confirm="Delete this rule?">
                  <button type="submit" class="danger"><%- icon('trash') %> Delete</button>
                </form>
              </div>
            </td>
          </tr>
          <tr class="expand-row" id="rule-edit-<%= r.id %>">
            <td colspan="5">
              <form method="post" action="/admin/notifications/rules/<%= r.id %>/update" class="rule-form">
                <div class="form-grid">
                  <div><label>Name</label><input type="text" name="name" value="<%= r.name %>" required></div>
                  <div>
                    <label>Trigger</label>
                    <select name="trigger_type" class="rule-trigger-select">
                      <% triggerTypes.forEach(t => { %><option value="<%= t.key %>" <%= t.key === r.trigger_type ? 'selected' : '' %>><%= t.label %></option><% }) %>
                    </select>
                  </div>
                  <div>
                    <label>Enabled</label>
                    <%- toggleSwitch('enabled', r.enabled) %>
                  </div>
                </div>

                <div class="form-grid rule-fields" data-for="monitor_threshold" style="margin-top:0.85rem;">
                  <div>
                    <label>Monitor</label>
                    <select name="monitor_id">
                      <option value="">Choose a monitor&hellip;</option>
                      <% monitors.forEach(m => { %><option value="<%= m.id %>" <%= r.config.monitor_id === m.id ? 'selected' : '' %>><%= m.label %></option><% }) %>
                    </select>
                  </div>
                  <div>
                    <label>Condition</label>
                    <select name="operator">
                      <option value="gt" <%= r.config.operator === 'gt' ? 'selected' : '' %>>&gt; (greater than)</option>
                      <option value="gte" <%= r.config.operator === 'gte' ? 'selected' : '' %>>&ge; (at least)</option>
                      <option value="lt" <%= r.config.operator === 'lt' ? 'selected' : '' %>>&lt; (less than)</option>
                      <option value="lte" <%= r.config.operator === 'lte' ? 'selected' : '' %>>&le; (at most)</option>
                      <option value="eq" <%= r.config.operator === 'eq' ? 'selected' : '' %>>= (equals)</option>
                    </select>
                  </div>
                  <div><label>Value</label><input type="number" step="any" name="threshold_value" value="<%= r.config.value ?? '' %>"></div>
                </div>
                <label class="toggle-row rule-fields" data-for="monitor_threshold" style="margin-top:0.5rem;">
                  <input type="checkbox" name="notify_on_recover" <%= r.config.notify_on_recover ? 'checked' : '' %>>
                  <span><strong>Also notify on recovery</strong></span>
                </label>

                <div class="form-grid rule-fields" data-for="miniserver_status" style="margin-top:0.85rem;">
                  <div>
                    <label>Miniserver</label>
                    <select name="miniserver_id">
                      <option value="">Any Miniserver</option>
                      <% miniservers.forEach(ms => { %><option value="<%= ms.id %>" <%= r.config.miniserver_id === ms.id ? 'selected' : '' %>><%= ms.name %></option><% }) %>
                    </select>
                  </div>
                </div>

                <div class="form-grid rule-fields" data-for="firmware_changed" style="margin-top:0.85rem;">
                  <div>
                    <label>Miniserver</label>
                    <select name="firmware_miniserver_id">
                      <option value="">Any Miniserver</option>
                      <% miniservers.forEach(ms => { %><option value="<%= ms.id %>" <%= r.config.miniserver_id === ms.id ? 'selected' : '' %>><%= ms.name %></option><% }) %>
                    </select>
                  </div>
                </div>

                <div class="form-grid rule-fields" data-for="gateway_client_firmware_mismatch" style="margin-top:0.85rem;">
                  <div>
                    <label>Gateway (blank = any Gateway with Clients)</label>
                    <select name="gateway_mismatch_miniserver_id">
                      <option value="">Any Gateway</option>
                      <% miniservers.forEach(ms => { %><option value="<%= ms.id %>" <%= r.config.miniserver_id === ms.id ? 'selected' : '' %>><%= ms.name %></option><% }) %>
                    </select>
                  </div>
                  <div>
                    <label>Severity</label>
                    <% const gatewayMismatchSeverity = r.config.severity || 'warning'; %>
                    <select name="gateway_mismatch_severity">
                      <option value="info" <%= gatewayMismatchSeverity === 'info' ? 'selected' : '' %>>Info</option>
                      <option value="warning" <%= gatewayMismatchSeverity === 'warning' ? 'selected' : '' %>>Warning</option>
                      <option value="critical" <%= gatewayMismatchSeverity === 'critical' ? 'selected' : '' %>>Critical</option>
                    </select>
                  </div>
                </div>
                <p class="hint rule-fields" data-for="gateway_client_firmware_mismatch" style="margin-top:0.35rem;">
                  Fires when a Gateway Miniserver's own firmware differs from one of its Client
                  Miniservers' &mdash; both sides need to be confirmed <strong>Running</strong>
                  (not mid-boot/mid-update) for this to fire.
                </p>

                <div class="form-grid rule-fields" data-for="mqtt_client_status" style="margin-top:0.85rem;">
                  <div><label>MQTT username (blank = any client)</label><input type="text" name="mqtt_username" value="<%= r.config.username || '' %>"></div>
                </div>

                <div class="form-grid rule-fields" data-for="battery_weak" style="margin-top:0.85rem;">
                  <div>
                    <label>Miniserver</label>
                    <select name="battery_miniserver_id">
                      <option value="">Any Miniserver</option>
                      <% miniservers.forEach(ms => { %><option value="<%= ms.id %>" <%= r.config.miniserver_id === ms.id ? 'selected' : '' %>><%= ms.name %></option><% }) %>
                    </select>
                  </div>
                  <div>
                    <label>Severity</label>
                    <% const batterySeverity = r.config.severity || 'warning'; %>
                    <select name="battery_severity">
                      <option value="info" <%= batterySeverity === 'info' ? 'selected' : '' %>>Info</option>
                      <option value="warning" <%= batterySeverity === 'warning' ? 'selected' : '' %>>Warning</option>
                      <option value="critical" <%= batterySeverity === 'critical' ? 'selected' : '' %>>Critical</option>
                    </select>
                  </div>
                </div>

                <div class="form-grid rule-fields" data-for="device_firmware_changed" style="margin-top:0.85rem;">
                  <div>
                    <label>Miniserver</label>
                    <select name="device_firmware_miniserver_id">
                      <option value="">Any Miniserver</option>
                      <% miniservers.forEach(ms => { %><option value="<%= ms.id %>" <%= r.config.miniserver_id === ms.id ? 'selected' : '' %>><%= ms.name %></option><% }) %>
                    </select>
                  </div>
                  <div>
                    <label>Severity</label>
                    <% const firmwareSeverity = r.config.severity || 'info'; %>
                    <select name="device_firmware_severity">
                      <option value="info" <%= firmwareSeverity === 'info' ? 'selected' : '' %>>Info</option>
                      <option value="warning" <%= firmwareSeverity === 'warning' ? 'selected' : '' %>>Warning</option>
                      <option value="critical" <%= firmwareSeverity === 'critical' ? 'selected' : '' %>>Critical</option>
                    </select>
                  </div>
                </div>

                <div class="form-grid rule-fields" data-for="device_offline" style="margin-top:0.85rem;">
                  <div>
                    <label>Miniserver</label>
                    <select name="device_offline_miniserver_id">
                      <option value="">Any Miniserver</option>
                      <% miniservers.forEach(ms => { %><option value="<%= ms.id %>" <%= r.config.miniserver_id === ms.id ? 'selected' : '' %>><%= ms.name %></option><% }) %>
                    </select>
                  </div>
                  <div>
                    <label>Severity (offline only &mdash; back online is always "Info")</label>
                    <% const offlineSeverity = r.config.severity || 'warning'; %>
                    <select name="device_offline_severity">
                      <option value="info" <%= offlineSeverity === 'info' ? 'selected' : '' %>>Info</option>
                      <option value="warning" <%= offlineSeverity === 'warning' ? 'selected' : '' %>>Warning</option>
                      <option value="critical" <%= offlineSeverity === 'critical' ? 'selected' : '' %>>Critical</option>
                    </select>
                  </div>
                </div>

                <div style="margin-top:0.9rem;">
                  <label style="display:block; font-size:0.78rem; font-weight:500; margin-bottom:0.4rem; color:var(--text-muted);">Send via</label>
                  <% channels.forEach(c => { %>
                    <label style="display:inline-flex; align-items:center; gap:0.3rem; margin:0 1rem 0.4rem 0; font-size:0.87rem;">
                      <input type="checkbox" name="channel_ids" value="<%= c.id %>" <%= r.channelIds.includes(c.id) ? 'checked' : '' %>> <%= c.name %>
                    </label>
                  <% }) %>
                </div>

                <div style="margin-top:0.6rem;">
                  <button type="submit" class="btn-edit"><%- icon('edit') %> Save</button>
                </div>
              </form>
            </td>
          </tr>
        <% }) %>
        <% if (rules.length === 0) { %>
          <tr><td colspan="5" class="empty">No rules yet &mdash; add one above.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<div class="card">
  <h2>Message templates</h2>
  <p class="hint">
    Override the title/body a trigger type sends — otherwise every one keeps its own built-in
    wording. <code>{{title}}</code>/<code>{{message}}</code>/<code>{{severity}}</code> plus each
    trigger's own fields (listed under it below) are available as placeholders in either field. A
    custom body fully replaces the auto-listed fields below the message — reference whichever ones
    you want by name instead. Leave both blank to reset a trigger back to its default.
  </p>
  <form method="post" action="/admin/notifications/templates">
    <% triggerTypes.forEach(t => { %>
      <% var sample = templatePreviewSamples[t.key]; var saved = templates[t.key] || {}; %>
      <details class="add-panel" <%= (saved.title || saved.body) ? 'open' : '' %>>
        <summary><%= t.label %></summary>
        <div class="add-panel-body">
          <div class="form-grid">
            <div style="grid-column:1/-1;">
              <label>Title template</label>
              <input type="text" name="template_title_<%= t.key %>" class="template-title-input" data-trigger="<%= t.key %>"
                placeholder="<%= sample.title %>" value="<%= saved.title || '' %>">
            </div>
            <div style="grid-column:1/-1;">
              <label>Body template</label>
              <textarea name="template_body_<%= t.key %>" class="template-body-input" data-trigger="<%= t.key %>" rows="3"
                placeholder="<%= sample.message %>"><%= saved.body || '' %></textarea>
            </div>
            <p class="hint" style="grid-column:1/-1; margin:0;">
              Available: <code>{{title}}</code> <code>{{message}}</code> <code>{{severity}}</code>
              <% sample.fields.forEach(f => { %><code>{{<%= f.label %>}}</code> <% }) %>
            </p>
            <p class="hint" style="grid-column:1/-1; margin:0;">
              Type <code>{{</code> in either field for an autocomplete menu of the placeholders
              above, or <code>/</code> for a menu of formatting snippets (bold/italic/code) and an
              emoji picker &mdash; both filter as you keep typing, arrow keys + Enter to pick.
            </p>
            <div style="grid-column:1/-1;">
              <div class="hint" style="margin:0 0 0.25rem;">Preview (as sent to Telegram, with example data):</div>
              <div class="template-preview" data-trigger="<%= t.key %>" style="border:1px solid var(--border); border-radius:8px; padding:0.75rem 0.9rem; background:var(--surface-alt); font-size:0.85rem; white-space:pre-wrap; overflow-wrap:anywhere;"></div>
            </div>
            <%
              // Not a real nested <form> — this whole card is already inside the "Save templates"
              // form, and HTML doesn't allow (reliably) nesting one form in another. A plain button
              // + fetch() instead (see the script below), same example data the preview above uses
              // but through the ACTUAL send path (sendTemplateTestMessage -> sendToChannel), sent to
              // whichever channel is picked here rather than every channel this trigger's own rules
              // happen to use.
            %>
            <div style="grid-column:1/-1; display:flex; align-items:center; gap:0.5rem;">
              <select class="template-test-channel" style="max-width:20rem;" <%= channels.length === 0 ? 'disabled' : '' %>>
                <% if (channels.length === 0) { %>
                  <option value="">No channels configured</option>
                <% } else { %>
                  <% channels.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
                <% } %>
              </select>
              <button type="button" class="btn-test template-test-send" data-trigger="<%= t.key %>" <%= channels.length === 0 ? 'disabled' : '' %>><%- icon('link') %> Send test</button>
              <span class="hint template-test-result" data-trigger="<%= t.key %>" style="margin:0;"></span>
            </div>
          </div>
        </div>
      </details>
    <% }) %>
    <div style="margin-top:0.85rem;">
      <button type="submit" class="btn-edit"><%- icon('edit') %> Save templates</button>
    </div>
  </form>
</div>

<!-- Floating UI (vendor/floating-ui.{core,dom}.umd.min.js) — powers attachInlineSuggest's own
     menu positioning below (see its own comment), the same dependency tabulator-table.js already
     uses for the Columns menu and row-actions popovers, loaded here directly since this page has
     no Tabulator table of its own to pull it in via that file. -->
<script src="/vendor/floating-ui.core.umd.min.js"></script>
<script src="/vendor/floating-ui.dom.umd.min.js"></script>
<script>
  // Live preview for the Message templates card above — pure client-side, against the same example
  // data the server embeds (notifications.js's own TEMPLATE_PREVIEW_SAMPLES), so nothing is ever
  // actually sent just to see how a template would look. substituteTemplate mirrors
  // notifications.js's own function of the same name exactly — same placeholder syntax, same
  // "leave the whole {{token}} as-is if it isn't a known one" behavior.
  (function () {
    var SAMPLES = <%- JSON.stringify(templatePreviewSamples) %>;
    var SEVERITY_EMOJI = { critical: '\u{1F534}', warning: '\u{1F7E0}', info: 'ℹ️' };

    function substituteTemplate(text, context) {
      return text.replace(/\{\{\s*([^{}]+?)\s*\}\}/g, function (whole, key) {
        return Object.prototype.hasOwnProperty.call(context, key) ? String(context[key]) : whole;
      });
    }

    function escapeHtml(s) {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    // Telegram's own markdown v1 subset (see ensureTelegramMarkdown's own mdv=v1 choice in
    // notifications.js) — *bold*, _italic_, `code`, [text](url) — rendered here as real HTML so
    // the preview actually shows what a template with its own markdown in it would look like,
    // rather than the raw asterisks/underscores as plain text.
    function renderTelegramMarkdown(text) {
      var html = escapeHtml(text);
      html = html.replace(/`([^`]+)`/g, '<code>$1</code>');
      html = html.replace(/\*([^*\n]+)\*/g, '<strong>$1</strong>');
      html = html.replace(/_([^_\n]+)_/g, '<em>$1</em>');
      html = html.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
      return html;
    }

    function renderPreview(triggerKey) {
      var sample = SAMPLES[triggerKey];
      var previewEl = document.querySelector('.template-preview[data-trigger="' + triggerKey + '"]');
      var titleInput = document.querySelector('.template-title-input[data-trigger="' + triggerKey + '"]');
      var bodyInput = document.querySelector('.template-body-input[data-trigger="' + triggerKey + '"]');
      if (!sample || !previewEl || !titleInput || !bodyInput) return;

      var context = { title: sample.title, message: sample.message, severity: sample.severity };
      sample.fields.forEach(function (f) { context[f.label] = f.value; });

      var titleTemplate = titleInput.value.trim() || sample.title;
      var customBody = bodyInput.value.trim();
      var renderedBody = customBody
        ? substituteTemplate(customBody, context)
        : sample.message + '\n\n' + sample.fields.map(function (f) { return f.label + ': ' + f.value; }).join('\n');

      var emoji = SEVERITY_EMOJI[sample.severity] || SEVERITY_EMOJI.info;
      var renderedTitle = emoji + ' ' + substituteTemplate(titleTemplate, context);
      previewEl.innerHTML = '<strong>' + renderTelegramMarkdown(renderedTitle) + '</strong>\n\n' + renderTelegramMarkdown(renderedBody).replace(/\n/g, '<br>');
    }

    // Shared "type a trigger char, get a filtered floating menu, pick one to insert" — same
    // trigger-plus-fixed-panel shape as buildColumnsMenu/the row-actions popover elsewhere in this
    // app, just anchored to a text caret's approximate position (the field's own bottom-left)
    // instead of a button, since getting an exact pixel-perfect caret position out of a plain
    // <textarea>/<input> needs a full mirror-div measurement this doesn't warrant for a lightweight
    // helper menu. Used below for both "{{" (placeholder autocomplete) and "/" (snippet menu).
    function attachInlineSuggest(el, triggerChar, stopChars, getItems, formatInsert) {
      var menu = document.createElement('div');
      menu.className = 'inline-suggest-menu';
      menu.hidden = true;
      document.body.appendChild(menu);
      var items = [];
      var rowEls = []; // the actual clickable elements for the current render, in the same order as `items` — NOT menu.children directly, since grid mode also inserts non-selectable .inline-suggest-category headers between them
      var activeIndex = 0;
      var matchStart = -1;
      var activeItems = null; // null while browsing the root list; set to a submenu's (e.g. "/" -> Emoji) full item list once entered
      var activeGrid = false; // true once inside a submenu whose category item had grid:true (see EMOJI_ITEMS/SLASH_ITEMS below) — renders emoji-only tiles grouped by item.category instead of the plain text-label rows every other level uses
      var subQueryStart = 0; // length of the trigger-query string at the moment a submenu was entered — only characters typed AFTER that filter the submenu, not whatever was typed to reach it (e.g. "emo" to reach Emoji itself shouldn't count against "fire" typed once inside it)
      var stopAutoUpdate = null; // set while the menu is open — see reposition()'s own comment

      function close() {
        menu.hidden = true;
        matchStart = -1;
        activeItems = null;
        activeGrid = false;
        subQueryStart = 0;
        if (stopAutoUpdate) { stopAutoUpdate(); stopAutoUpdate = null; }
      }

      function setActive(i) {
        activeIndex = i;
        rowEls.forEach(function (rowEl, ci) {
          rowEl.classList.toggle('active', ci === activeIndex);
        });
        var activeEl = rowEls[i];
        if (activeEl) activeEl.scrollIntoView({ block: 'nearest' });
      }

      function matchesQuery(item, query) {
        if (!query) return true;
        var q = query.toLowerCase();
        if (item.label.toLowerCase().indexOf(q) !== -1) return true;
        return !!(item.keywords && item.keywords.toLowerCase().indexOf(q) !== -1);
      }

      function select(i) {
        var item = items[i];
        if (!item || matchStart < 0) return;
        // A category item (e.g. "/" -> Emoji) opens its own sub-list in place instead of
        // inserting anything — matchStart/the trigger text typed so far stay exactly as they are,
        // so picking a LEAF item from the sub-list still replaces from the same original position.
        if (item.items) {
          activeItems = item.items;
          activeGrid = !!item.grid;
          subQueryStart = el.value.slice(matchStart + triggerChar.length, el.selectionStart).length;
          render(activeItems);
          return;
        }
        var value = el.value;
        var caret = el.selectionStart;
        var insertText = formatInsert(item);
        el.value = value.slice(0, matchStart) + insertText + value.slice(caret);
        var newCaret = matchStart + insertText.length;
        el.setSelectionRange(newCaret, newCaret);
        close();
        el.focus();
        el.dispatchEvent(new Event('input'));
      }

      // Groups consecutive same-category items under one heading + a flex-wrapped row of
      // emoji-only tiles (no text label — a phone-style picker, browsed and picked by the emoji
      // itself; item.label only surfaces now as the tile's hover title, for accessibility). Relies
      // on EMOJI_ITEMS already listing same-category items contiguously — a category header is
      // only started when `item.category` actually changes from the previous item, so a filtered
      // subset (search mid-browse) still groups correctly without re-sorting anything.
      function renderGrid(matchedItems) {
        var currentCategory = null;
        var rowWrap = null;
        matchedItems.forEach(function (item, i) {
          if (item.category !== currentCategory) {
            currentCategory = item.category;
            var heading = document.createElement('div');
            heading.className = 'inline-suggest-category';
            heading.textContent = currentCategory || '';
            menu.appendChild(heading);
            rowWrap = document.createElement('div');
            rowWrap.className = 'inline-suggest-emoji-row';
            menu.appendChild(rowWrap);
          }
          var cell = document.createElement('div');
          cell.className = 'inline-suggest-emoji-item';
          cell.textContent = item.insertText;
          cell.title = item.label;
          cell.addEventListener('mousedown', function (e) { e.preventDefault(); select(i); });
          rowWrap.appendChild(cell);
          rowEls.push(cell);
        });
      }

      function renderList(matchedItems) {
        matchedItems.forEach(function (item, i) {
          var row = document.createElement('div');
          row.className = 'inline-suggest-item';
          row.textContent = item.label + (item.items ? ' ›' : '');
          row.addEventListener('mousedown', function (e) { e.preventDefault(); select(i); });
          menu.appendChild(row);
          rowEls.push(row);
        });
      }

      // Floating UI (vendor/floating-ui.{core,dom}.umd.min.js) replaces what used to be a
      // hand-rolled flip-up-if-it-won't-fit-below-but-fits-above + manual scroll/resize-listener
      // reimplementation here — the same fix already applied to every Tabulator popover in this
      // app (see tabulator-table.js's own comment on positionColumnsPanel/openTabulatorRowActionsPopover
      // for the category of bug this closes). 'bottom-start' anchors the menu under the field's own
      // left edge, matching the previous left-aligned-under-the-field placement; flip() swaps to
      // above when there's no room below, shift() nudges it back onto the viewport rather than
      // letting it run off an edge. autoUpdate() (started/stopped in open/close below) is what
      // keeps it visually anchored on scroll (including a nested scrollable ancestor) and resize —
      // position:fixed doesn't track the field on its own.
      function reposition() {
        FloatingUIDOM.computePosition(el, menu, {
          // .inline-suggest-menu is position:fixed (style.css) — strategy must match or
          // computePosition returns document-relative coordinates instead of viewport-relative
          // ones. Those two exactly cancel out on a plain whole-page scroll (the anchor's
          // viewport-relative rect moves up by the scroll delta, but the default 'absolute'
          // strategy adds that same delta back to convert to document coordinates), which is what
          // made the menu appear frozen in place instead of tracking the field while the page
          // itself scrolled — a real bug, not just a discrepancy from Playwright's headless
          // Chromium, found by directly instrumenting reposition() and comparing computed style
          // before/after a scroll rather than trusting a getBoundingClientRect() snapshot alone.
          strategy: 'fixed',
          placement: 'bottom-start',
          middleware: [FloatingUIDOM.offset(4), FloatingUIDOM.flip(), FloatingUIDOM.shift({ padding: 8 })],
        }).then(function (pos) {
          menu.style.left = pos.x + 'px';
          menu.style.top = pos.y + 'px';
          menu.style.bottom = 'auto';
        });
      }

      function render(matchedItems) {
        items = matchedItems;
        // Not a full close() on zero matches — keeps matchStart/activeItems intact so backspacing
        // one character to fix a typo can still recover the list instead of having to retype the
        // trigger character from scratch.
        menu.hidden = items.length === 0;
        if (items.length === 0) return;
        menu.innerHTML = '';
        rowEls = [];
        menu.classList.toggle('inline-suggest-grid', activeGrid);
        if (activeGrid) renderGrid(items); else renderList(items);
        setActive(0);
        menu.hidden = false;
        reposition();
        // Started only once per open (not re-started on every keystroke's re-render) — autoUpdate
        // itself is what keeps tracking the field's position for as long as it runs; close() above
        // is what stops it once the menu actually closes.
        if (!stopAutoUpdate) stopAutoUpdate = FloatingUIDOM.autoUpdate(el, menu, reposition);
      }

      function check() {
        var value = el.value;
        var caret = el.selectionStart;
        var beforeCaret = value.slice(0, caret);
        var idx = beforeCaret.lastIndexOf(triggerChar);
        if (idx === -1) { close(); return; }
        var query = beforeCaret.slice(idx + triggerChar.length);
        // Bails once the trigger's own natural "closed" state is typed. A bare space is also a
        // bail at the ROOT level (this isn't an in-progress snippet/placeholder name any more) —
        // but once inside a submenu (e.g. searching "red heart" in Emoji) a space is a normal part
        // of the search term, not a sign to give up.
        if (/\s/.test(query) && !activeItems) { close(); return; }
        if (!activeItems && stopChars.some(function (c) { return query.indexOf(c) !== -1; })) { close(); return; }
        matchStart = idx;
        if (activeItems) {
          render(activeItems.filter(function (item) { return matchesQuery(item, query.slice(subQueryStart)); }));
        } else {
          render(getItems().filter(function (item) { return matchesQuery(item, query); }));
        }
      }

      el.addEventListener('input', check);
      el.addEventListener('keydown', function (e) {
        if (menu.hidden) return;
        if (e.key === 'ArrowDown') { e.preventDefault(); setActive(Math.min(activeIndex + 1, items.length - 1)); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(Math.max(activeIndex - 1, 0)); }
        else if (e.key === 'Enter' || e.key === 'Tab') { e.preventDefault(); select(activeIndex); }
        else if (e.key === 'Escape') { close(); }
      });
      el.addEventListener('blur', function () { setTimeout(close, 150); }); // lets a mousedown-select land first
      // No manual scroll/resize listeners here any more — FloatingUIDOM.autoUpdate (started in
      // render(), stopped in close()) already re-runs reposition() on scroll (including a nested
      // scrollable ancestor), resize, and the field/menu's own size changes.
    }

    // Telegram doesn't render an actual markdown table, so "table" is left out. The emoji ones
    // show the actual character right in the list (not just a text description of it) so it
    // reads as a real picker — "/" -> "Emoji ›" opens this as its own sub-list (see the `items`
    // property in select() above), same severity/status emoji already used elsewhere in this
    // notification system (see SEVERITY_EMOJI above and TELEGRAM_SEVERITY_EMOJI in notifications.js).
    //
    // A genuinely complete Unicode emoji set runs into the thousands (plus skin-tone/gender
    // variants) — not something to hand-maintain reliably here. This is instead a broad, keyworded
    // set across every common category, made actually findable via attachInlineSuggest's live
    // per-submenu search (keep typing after picking "Emoji" to filter by name or keyword) rather
    // than requiring anyone to scroll a flat list to find one.
    // Each item's `category` groups it under a heading in the grid picker (see renderEmojiGrid)
    // — kept as a plain field rather than nesting arrays-per-category, since matchesQuery/search
    // needs one flat list to filter across every category at once.
