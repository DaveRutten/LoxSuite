<%- include('partials/head', { pageTitle: 'Agenda', active: 'agenda' }) %>

<% if (error) { %><p class="error"><%= error %></p><% } %>
<% if (saved) { %><p class="hint" style="color: var(--success);"><%= t('Saved.') %></p><% } %>

<div class="card">
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.6rem;">
    <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
      <button type="button" class="btn-soft" id="ag-prev">&lsaquo;</button>
      <button type="button" class="btn-soft" id="ag-today"><%= t('Today') %></button>
      <button type="button" class="btn-soft" id="ag-next">&rsaquo;</button>
      <strong id="ag-title" style="margin-left:0.4rem;"></strong>
    </div>
    <div style="display:inline-flex; gap:0.5rem; align-items:center; flex-wrap:wrap;">
    <% if (canEdit('charging')) { %><button type="button" class="btn-soft" id="ag-sync-now" title="<%= t('Fetch the calendars again now') %>"><%- icon('refresh') %> <%= t('Sync') %></button><% } %>
    <div id="ag-views" style="display:inline-flex; border:1px solid var(--border); border-radius:10px; overflow:hidden;">
      <% [['day', t('Day')], ['week', t('Week')], ['month', t('Month')], ['year', t('Year')]].forEach(([k, l]) => { %>
        <button type="button" data-view="<%= k %>" style="border:0; padding:0.4rem 0.85rem; font-weight:600; cursor:pointer;"><%= l %></button>
      <% }) %>
    </div>
    </div>
  </div>
  <div id="ag-legend" class="hint" style="margin:0.6rem 0 0.6rem; font-size:0.8rem;"></div>
  <div style="display:flex; gap:1rem; align-items:flex-start; flex-wrap:wrap;">
    <div id="ag-view" style="flex:1 1 640px; min-width:0; max-width:100%; overflow-x:auto;"></div>
    <div id="ag-detail" style="flex:0 0 300px; max-width:100%;"></div>
  </div>
</div>

<% if (canEdit('charging')) { %>

<div class="card">
  <h2 style="margin-top:0;"><%= t('Trips planned in LoxSuite') %></h2>
  <% if (trips.length) { %>
    <table><thead><tr><th><%= t('Trip') %></th><th><%= t('Leaves') %></th><th><%= t('Back') %></th><th><%= t('Where / how much') %></th><th></th></tr></thead><tbody>
      <% trips.forEach(tt => { %><tr><td><%= tt.title %><%= tt.weekly ? ' (' + t('weekly') + ')' : '' %></td><td><%= formatDateTime(tt.depart_at) %></td><td><%= tt.return_at ? formatDateTime(tt.return_at) : '—' %></td><td><%= tt.location || '' %> <%= tt.own_value || '' %><%= tt.climate_c != null ? ' · 🌡️ ' + tt.climate_c + ' °C' : '' %></td>
        <td><form method="post" action="/agenda/trips/<%= tt.id %>/delete" style="margin:0;"><button type="submit" class="danger"><%- icon('trash') %></button></form></td></tr><% }) %>
    </tbody></table>
  <% } %>
  <details style="margin-top:0.6rem;" <%= trips.length ? '' : 'open' %>>
    <summary><strong><%= t('Plan a trip') %></strong></summary>
    <form method="post" action="/agenda/trips" style="margin-top:0.6rem;" id="ag-trip-form">
      <div class="form-grid">
        <div><label><%= t('Name') %></label><input type="text" name="title" placeholder="<%= t('Visit') %>" required></div>
        <div><label><%= t('Leaves') %></label><input type="datetime-local" id="ag-dep" required><input type="hidden" name="depart_at"></div>
        <div><label><%= t('Back (optional)') %></label><input type="datetime-local" id="ag-ret"><input type="hidden" name="return_at"></div>
      </div>
      <div class="form-grid" style="margin-top:0.7rem;">
        <div><label><%= t('Address (optional)') %></label><input type="text" name="location" placeholder="<%= t('Utrecht') %>"></div>
        <div><label><%= t('Or: how much') %></label><input type="text" name="own_value" placeholder="<%= t('150 km, 30 kWh or full') %>"></div>
        <div><label><%= t('Car') %></label><select name="vehicle_id"><option value=""><%= t('— default —') %></option><% vehicles.forEach(v => { %><option value="<%= v.id %>"><%= v.name %></option><% }) %></select></div>
        <div><label><%= t('Every week') %></label><%- toggleSwitch('weekly', false) %></div>
        <% if (skodaCars) { %><div><label><%= t('Climate at departure') %></label><select name="climate_c"><option value=""><%= t('off') %></option><% for (let c = 16; c <= 26; c++) { %><option value="<%= c %>"><%= c %> °C</option><% } %></select></div><% } %>
      </div>
      <div class="btn-row" style="margin-top:0.7rem;"><button type="submit" class="primary"><%- icon('plus') %> <%= t('Add trip') %></button></div>
    </form>
  </details>
</div>

<p class="hint" data-hint-keep><%= t('Calendars, car markers and climate at departure are set under') %> <a href="/settings/energy#calendars"><%= t('Administration → Energy & charging') %></a>.</p>
<% } %>

<style>
  .ag-need td { padding:0.3rem 0.2rem; vertical-align:top; } .ag-need td:first-child { padding-right:0.6rem; } .ag-need td:last-child { text-align:right; overflow-wrap:anywhere; }
  /* the choices in the detail panel: the text above, the dropdown below it, all as wide as the panel */
  .ag-box { margin:0.6rem 0 0.3rem; padding:0.6rem 0.7rem; border-radius:10px; }
  .ag-field + .ag-field { margin-top:0.55rem; }
  .ag-lbl { display:block; font-weight:600; font-size:0.85rem; margin:0 0 0.25rem; }
  .ag-field select, .ag-field input[type="text"] { display:block; width:100%; max-width:100%; box-sizing:border-box; margin:0; }
  .ag-field .hint { margin:0.25rem 0 0; font-size:0.75rem; overflow-wrap:anywhere; }
</style>
<script src="/agenda-layout.js?v=<%= assetVersion %>"></script>
<script>
(function () {
  var canEdit = <%- JSON.stringify(canEdit('charging')) %>;
  var view = window.matchMedia('(max-width: 768px)').matches ? 'day' : 'week'; // a week doesn't fit a phone
  try { view = localStorage.getItem('agenda-view') || view; } catch (e) { /* storage blocked */ }
  var cursor = new Date();
  var data = null;
  var selected = null;
  // weekday names in the user's language (Mon 5 Oct 2026 is a Monday)
  var DAYN = [0, 1, 2, 3, 4, 5, 6].map(function (i) { return new Date(2026, 9, 5 + i).toLocaleDateString([], { weekday: 'short' }); });
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function nf(v, d) { return v == null ? '—' : Number(v).toLocaleString(undefined, { minimumFractionDigits: d, maximumFractionDigits: d }); }
  function tm(d) { return new Date(d).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }); }
  function startOfDay(d) { var x = new Date(d); x.setHours(0, 0, 0, 0); return x; }
  function addDays(d, n) { var x = new Date(d); x.setDate(x.getDate() + n); return x; }
  function startOfWeek(d) { var x = startOfDay(d); var wd = (x.getDay() + 6) % 7; return addDays(x, -wd); }
  function sameDay(a, b) { return a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate(); }
  function weekNo(d) { var t = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate())); var day = t.getUTCDay() || 7; t.setUTCDate(t.getUTCDate() + 4 - day); var y0 = new Date(Date.UTC(t.getUTCFullYear(), 0, 1)); return Math.ceil(((t - y0) / 86400000 + 1) / 7); }
  var distTried = {};
  var syncNow = document.getElementById('ag-sync-now');
  if (syncNow) syncNow.onclick = function () {
    syncNow.disabled = true;
    post('/agenda/sync.json', {}).then(function (d) {
      var bad = (d.results || []).filter(function (r) { return !r.ok; });
      syncNow.title = bad.length ? bad.map(function (r) { return r.message; }).join(' · ') : '';
      load();
    }).finally(function () { syncNow.disabled = false; });
  };
  function post(url, body) { return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(function (r) { return r.json(); }); }

  function range() {
    if (view === 'day') { var s = startOfDay(cursor); return [s, addDays(s, 1)]; }
    if (view === 'week') { var w = startOfWeek(cursor); return [w, addDays(w, 7)]; }
    if (view === 'month') { var m = new Date(cursor.getFullYear(), cursor.getMonth(), 1); var g = startOfWeek(m); return [g, addDays(g, 42)]; }
    return [new Date(cursor.getFullYear(), 0, 1), new Date(cursor.getFullYear() + 1, 0, 1)];
  }
  function title() {
    var r = range();
    if (view === 'day') return cursor.toLocaleDateString([], { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    if (view === 'week') return r[0].toLocaleDateString([], { day: 'numeric', month: 'short' }) + ' – ' + addDays(r[1], -1).toLocaleDateString([], { day: 'numeric', month: 'short', year: 'numeric' }) + '  · week ' + weekNo(r[0]);
    if (view === 'month') return cursor.toLocaleDateString([], { month: 'long', year: 'numeric' });
    return String(cursor.getFullYear());
  }
  function load() {
    var r = range();
    document.getElementById('ag-title').textContent = title();
    document.querySelectorAll('#ag-views button').forEach(function (b) { var on = b.dataset.view === view; b.style.background = on ? 'var(--accent)' : 'transparent'; b.style.color = on ? '#fff' : 'inherit'; });
    fetch('/agenda/items.json?from=' + r[0].toISOString() + '&to=' + r[1].toISOString()).then(function (x) { return x.json(); }).then(function (d) { data = d; render(); }).catch(function () {});
  }
  function shift(n) {
    if (view === 'day') cursor = addDays(cursor, n);
    else if (view === 'week') cursor = addDays(cursor, 7 * n);
    else if (view === 'month') cursor = new Date(cursor.getFullYear(), cursor.getMonth() + n, 1);
    else cursor = new Date(cursor.getFullYear() + n, 0, 1);
    load();
  }
  document.getElementById('ag-prev').onclick = function () { shift(-1); };
  document.getElementById('ag-next').onclick = function () { shift(1); };
  document.getElementById('ag-today').onclick = function () { cursor = new Date(); load(); };
  document.querySelectorAll('#ag-views button').forEach(function (b) { b.onclick = function () { view = b.dataset.view; try { localStorage.setItem('agenda-view', view); } catch (e) { /* ignore */ } load(); }; });

  document.getElementById('ag-legend').innerHTML = '<span style="margin-right:0.9rem;">🚗 = car needed</span><span style="margin-right:0.9rem;"><span style="display:inline-block; width:10px; height:10px; border:1.5px dashed #9aa4b2; border-radius:2px;"></span> ready by (learned)</span>' +
    '<span style="margin-right:0.9rem;"><span style="display:inline-block; width:10px; height:10px; background:var(--accent); border-radius:2px;"></span> planned charging</span><span><span style="display:inline-block; width:10px; height:10px; background:#9aa4b2; opacity:0.6; border-radius:2px;"></span> charged earlier</span>';

  function itemColor(i) { return i.color || '#3b82c4'; }
  var textOn = AgendaLayout.textOn, lanes = AgendaLayout.lanes;
  // The car marker only once: not again in front of a title that already has one.
  function lastTemp() { try { return Number(localStorage.getItem('ag-climate-last')) || 20; } catch (e) { return 20; } }
  function carMark(i) { return (i.needsCar && !/[\u{1F697}\u{1F699}\u{1F698}]/u.test(i.title || '') ? '🚗 ' : '') + (i.needsCar && i.climateC != null && !i.climateOff ? '🌡️ ' : ''); }
  // month view: the car in a fixed-width slot (empty without a car), so the times line up
  function carSlot(i) { return '<span style="display:inline-block; min-width:1.4em;">' + (i.needsCar ? '🚗' : '') + '</span>'; }
  function titleNoCar(i) { return String(i.title || '').replace(/[\u{1F697}\u{1F698}\u{1F699}]\uFE0F?\s*/gu, '').trim(); }
  function itemsOnDay(day) { var e = addDays(day, 1); return (data.items || []).filter(function (i) { return new Date(i.start) < e && new Date(i.end) > day; }); }

  function render() {
    if (!data) return;
    if (view === 'week' || view === 'day') renderGrid(view === 'week' ? 7 : 1);
    else if (view === 'month') renderMonth();
    else renderYear();
    renderDetail();
  }

  function renderGrid(ndays) {
    var r = range();
    var H0 = 0, H1 = 24, PX = 44;
    var colW = ndays === 7 ? 'minmax(110px,1fr)' : '1fr';
    var html = '<div style="display:grid; grid-template-columns:44px repeat(' + ndays + ',' + colW + '); min-width:' + (ndays === 7 ? 820 : 300) + 'px;">';
    html += '<div style="position:sticky; top:0; z-index:4; background:var(--surface, #fff);"></div>';
    for (var d = 0; d < ndays; d++) {
      var day = addDays(r[0], d);
      var allDay = itemsOnDay(day).filter(function (i) { return i.allDay; });
      html += '<div style="position:sticky; top:0; z-index:4; background:var(--surface, #fff); padding:0 4px 4px; font-size:12px; font-weight:600; border-left:1px solid var(--border); border-bottom:1px solid var(--border);' + (sameDay(day, new Date()) ? ' color:var(--accent);' : '') + '">' + DAYN[(day.getDay() + 6) % 7] + ' ' + day.getDate() +
        allDay.map(function (i) { return '<div data-key="' + esc(key(i)) + '" title="' + esc(i.title) + '" style="margin-top:2px; font-weight:500; font-size:11px; padding:1px 4px; border-radius:4px; cursor:pointer; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; background:color-mix(in srgb, ' + itemColor(i) + ' 18%, transparent);">' + carMark(i) + esc(i.title) + '</div>'; }).join('') + '</div>';
    }
    html += '<div style="position:relative; height:' + ((H1 - H0) * PX) + 'px;">';
    for (var h = H0 + 1; h < H1; h += 1) html += '<div style="position:absolute; right:4px; top:' + ((h - H0) * PX - 6) + 'px; font-size:10px; opacity:0.55;">' + String(h).padStart(2, '0') + ':00</div>';
    html += '</div>';
    for (var c = 0; c < ndays; c++) {
      var day2 = addDays(r[0], c);
      var dayEnd = addDays(day2, 1);
      var col = '<div style="position:relative; height:' + ((H1 - H0) * PX) + 'px; border-left:1px solid var(--border);' + ((day2.getDay() + 6) % 7 >= 5 ? ' background:color-mix(in srgb, currentColor 3%, transparent);' : '') + '">';
      for (var hh = H0 + 1; hh < H1; hh += 1) col += '<div style="position:absolute; left:0; right:0; top:' + ((hh - H0) * PX) + 'px; border-top:1px ' + (hh % 2 ? 'dotted' : 'solid') + ' var(--border);"></div>';
      var y = function (t) { var dd = new Date(t); return Math.max(0, Math.min(H1 - H0, (dd - day2) / 3600000 - H0)) * PX; };
      (data.sessions || []).forEach(function (s) {
        var a = new Date(s.connect_at), b = s.disconnect_at ? new Date(s.disconnect_at) : new Date();
        if (b <= day2 || a >= dayEnd) return;
        col += '<div title="charged ' + nf(s.kwh, 1) + ' kWh" style="position:absolute; left:1px; width:5px; top:' + y(a) + 'px; height:' + Math.max(3, y(b) - y(a)) + 'px; background:#9aa4b2; opacity:0.5; border-radius:2px;"></div>';
      });
      (data.plan || []).forEach(function (s) {
        var a = new Date(s.start), b = new Date(s.end);
        if (b <= day2 || a >= dayEnd) return;
        col += '<div title="planned ' + nf(s.kw, 1) + ' kW" style="position:absolute; right:1px; width:7px; top:' + y(a) + 'px; height:' + Math.max(3, y(b) - y(a)) + 'px; background:' + (s.source === 'pv' ? '#d4a017' : 'var(--accent)') + '; border-radius:2px;"></div>';
      });
      lanes(itemsOnDay(day2).filter(function (i) { return !i.allDay; })).forEach(function (L) {
        var i = L.item, a = new Date(i.start), b = new Date(i.end);
        var col2 = itemColor(i);
        var sel = selected && key(i) === selected;
        var h = Math.max(20, y(b) - y(a) - 2);
        // drop off / pick up: the car is only gone at the start and/or the end (a thick edge there)
        var dp = i.needsCar && i.tripMode && i.tripMode !== 'stay';
        var style = i.needsCar && !dp ? 'background:' + col2 + '; color:' + textOn(col2) + ';' : 'background:color-mix(in srgb, ' + col2 + ' 18%, var(--surface, #fff)); color:var(--text); border-left:3px solid ' + col2 + ';' +
          (dp && i.tripMode !== 'pick' ? ' border-top:5px solid ' + col2 + ';' : '') + (dp && i.tripMode !== 'drop' ? ' border-bottom:5px solid ' + col2 + ';' : '');
        // overlapping: each later one shifted right and on top (like a paper calendar), so every
        // title keeps a readable width instead of thin side-by-side strips
        var shift = L.lanes > 1 ? Math.min(35, 60 / (L.lanes - 1)) : 0;
        var leftPos = 'calc(6px + (100% - 16px) * ' + (shift * L.lane / 100) + ')';
        var width = 'calc((100% - 16px) * ' + ((100 - shift * (L.lanes - 1)) / 100) + ')';
        var one = 'white-space:nowrap; overflow:hidden; text-overflow:ellipsis;';
        var body = h < 34
          ? '<div style="' + one + '"><strong>' + carMark(i) + esc(i.title) + '</strong> <span style="opacity:0.85;">' + tm(a) + '</span></div>'
          : '<div style="' + (h >= 60 ? 'display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;' : one) + '"><strong>' + carMark(i) + esc(i.title) + '</strong></div><div style="' + one + ' opacity:0.85;">' + tm(a) + '–' + tm(b) + (i.location ? ' · ' + esc(i.location) : '') + '</div>' +
            (h >= 50 && i.needsCar && i.needKwh != null ? '<div style="' + one + ' opacity:0.9;">' + nf(i.needKwh, 1) + ' kWh</div>' : '') +
            (h >= 50 && i.askCar && canEdit ? '<div style="margin-top:2px; display:inline-block; border:1px solid ' + col2 + '; border-radius:8px; padding:0 5px; font-size:10px;">🚗 car needed?</div>' : '');
        col += '<div data-key="' + esc(key(i)) + '" title="' + esc(i.title + ' · ' + tm(a) + '–' + tm(b) + (i.location ? ' · ' + i.location : '')) + '" style="position:absolute; left:' + leftPos + '; width:' + width + '; top:' + (y(a) + 1) + 'px; height:' + h + 'px; box-sizing:border-box; border-radius:6px; padding:2px 5px; font-size:11px; line-height:1.3; overflow:hidden; cursor:pointer; z-index:' + (1 + L.lane) + '; ' + (L.lane ? 'box-shadow:0 0 0 1px var(--surface, #fff); ' : '') + style + (sel ? ' box-shadow:0 0 0 2px ' + col2 + ';' : '') + '">' + body + '</div>';
      });
      // learned "ready" moments on top, as a line with a small label that stays readable
      (data.learned || []).forEach(function (l) {
        var a = new Date(l.at);
        if (a < day2 || a >= dayEnd) return;
        col += '<div style="position:absolute; left:0; right:0; top:' + y(a) + 'px; border-top:2px dashed #9aa4b2; z-index:2; pointer-events:none;"><span style="position:absolute; right:10px; top:-9px; font-size:10px; line-height:1; padding:2px 5px; border-radius:6px; background:var(--surface, #fff); color:var(--text); border:1px solid #9aa4b2; white-space:nowrap;">ready ' + tm(a) + '</span></div>';
      });
      if (sameDay(day2, new Date())) col += '<div style="position:absolute; left:0; right:0; top:' + y(new Date()) + 'px; border-top:2px solid #e5534b; z-index:3; pointer-events:none;"></div>';
      html += col + '</div>';
    }
    html += '</div>';
    var el = document.getElementById('ag-view');
    el.style.maxHeight = '72vh'; el.style.overflowY = 'auto';
    el.innerHTML = html;
    el.scrollTop = 7 * PX;
    bindClicks(el);
  }

  function renderMonth() {
    document.getElementById('ag-view').style.maxHeight = ''; document.getElementById('ag-view').style.overflowY = '';
    var r = range();
    var month = cursor.getMonth();
    var html = '<div style="display:grid; grid-template-columns:repeat(7, minmax(90px,1fr)); border-top:1px solid var(--border); border-left:1px solid var(--border); min-width:640px;">';
    DAYN.forEach(function (n) { html += '<div style="padding:4px 6px; font-size:12px; font-weight:600; border-right:1px solid var(--border); border-bottom:1px solid var(--border);">' + n + '</div>'; });
    for (var i = 0; i < 42; i++) {
      var day = addDays(r[0], i);
      var list = itemsOnDay(day);
      var kwh = (data.sessions || []).filter(function (s) { return sameDay(new Date(s.connect_at), day); }).reduce(function (a, s) { return a + (s.kwh || 0); }, 0);
      var cell = '<div style="min-height:92px; padding:4px 5px; border-right:1px solid var(--border); border-bottom:1px solid var(--border); font-size:11px;' + (day.getMonth() !== month ? ' opacity:0.45;' : '') + '">' +
        '<div style="display:flex; justify-content:space-between;"><span style="font-weight:600;' + (sameDay(day, new Date()) ? ' color:var(--accent);' : '') + '">' + day.getDate() + '</span>' + (kwh ? '<span class="hint" style="margin:0;">⚡' + nf(kwh, 1) + '</span>' : '') + '</div>';
      list.slice(0, 3).forEach(function (it) { cell += '<div data-key="' + esc(key(it)) + '" style="margin-top:2px; padding:1px 4px; border-radius:4px; cursor:pointer; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; ' + (it.needsCar ? 'background:' + itemColor(it) + '; color:' + textOn(itemColor(it)) + ';' : 'background:color-mix(in srgb, ' + itemColor(it) + ' 15%, transparent);') + '">' + carSlot(it) + (it.allDay ? '' : tm(it.start) + ' ') + (it.needsCar && it.climateC != null && !it.climateOff ? '🌡️' : '') + esc(titleNoCar(it)) + '</div>'; });
      if (list.length > 3) cell += '<div class="hint" style="margin:2px 0 0;">+' + (list.length - 3) + ' more</div>';
      html += cell + '</div>';
    }
    var el = document.getElementById('ag-view');
    el.innerHTML = html + '</div>';
    bindClicks(el);
  }

  function renderYear() {
    document.getElementById('ag-view').style.maxHeight = ''; document.getElementById('ag-view').style.overflowY = '';
    var year = cursor.getFullYear();
    var kwhByDay = {};
    (data.sessions || []).forEach(function (s) { var k = startOfDay(new Date(s.connect_at)).toDateString(); kwhByDay[k] = (kwhByDay[k] || 0) + (s.kwh || 0); });
    var carDays = {};
    (data.items || []).forEach(function (i) { if (i.needsCar) carDays[startOfDay(new Date(i.start)).toDateString()] = true; });
    var html = '<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(190px,1fr)); gap:1rem;">';
    for (var m = 0; m < 12; m++) {
      var first = new Date(year, m, 1);
      var g = startOfWeek(first);
      var mh = '<div><div style="font-weight:600; font-size:13px; margin-bottom:4px; cursor:pointer;" data-month="' + m + '">' + first.toLocaleDateString([], { month: 'long' }) + '</div><div style="display:grid; grid-template-columns:repeat(7, 1fr); gap:2px;">';
      for (var i = 0; i < 42; i++) {
        var d = addDays(g, i);
        if (d.getMonth() !== m) { mh += '<div></div>'; continue; }
        var k = kwhByDay[d.toDateString()] || 0;
        var a = Math.min(1, k / 20);
        mh += '<div title="' + d.toLocaleDateString() + (k ? ': ' + nf(k, 1) + ' kWh' : '') + '" style="aspect-ratio:1; border-radius:3px; font-size:10px; display:flex; align-items:center; justify-content:center; position:relative; background:' + (k ? 'color-mix(in srgb, var(--accent) ' + Math.round(15 + a * 70) + '%, transparent)' : 'color-mix(in srgb, currentColor 5%, transparent)') + ';' + (sameDay(d, new Date()) ? ' outline:2px solid #e5534b;' : '') + '">' + d.getDate() +
          (carDays[d.toDateString()] ? '<span style="position:absolute; left:50%; bottom:2px; width:4px; height:4px; margin-left:-2px; border-radius:50%; background:#e5534b;"></span>' : '') + '</div>';
      }
      html += mh + '</div></div>';
    }
    var el = document.getElementById('ag-view');
    el.innerHTML = html + '</div><p class="hint" style="margin:0.6rem 0 0;">Colour = kWh charged that day · red dot = car needed</p>';
    el.querySelectorAll('[data-month]').forEach(function (x) { x.onclick = function () { cursor = new Date(year, Number(x.dataset.month), 1); view = 'month'; load(); }; });
  }

  function key(i) { return i.kind + '|' + (i.calendar_id || i.id) + '|' + (i.uid || '') + '|' + i.start; }
  function bindClicks(el) { el.querySelectorAll('[data-key]').forEach(function (x) { x.onclick = function () { selected = x.dataset.key; render(); }; }); }

  function roleName(r) { return r === 'drop' ? 'drop off' : r === 'pick' ? 'pick up' : ''; }
  function modeName(m) { return m === 'both' ? 'drop off and pick up' : m === 'drop' ? 'only drop off' : m === 'pick' ? 'only pick up' : 'the car stays there'; }
  // One drive from home: when, the stops with the distance to each, and what it needs.
  function routeBlock(t) {
    var label = t.stops.length > 1 ? 'Route' : t.stops[0].role === 'drop' ? 'Drop off' : t.stops[0].role === 'pick' ? 'Pick up' : 'There and back';
    // a stop back at where the drive started is marked as such
    var km = function (l) { return l ? (l.approx ? '≈ ' : '') + nf(l.km, 0) + ' km' : '? km'; };
    var path = '<span>home</span>';
    t.stops.forEach(function (st, i) { path += ' → ' + esc(st.title) + (st.role === 'via' ? ' <span>(again)</span>' : '') + ' <span style="opacity:0.7;">(' + km(t.legs[i]) + ')</span>'; });
    path += ' → <span>home</span> <span style="opacity:0.7;">(' + km(t.legs[t.legs.length - 1]) + ')</span>';
    var tight = (t.legs || []).some(function (l) { return l && l.tight; });
    return '<div style="margin-top:0.5rem; padding:0.45rem 0.6rem; border:1px solid var(--border); border-radius:10px;">' +
      '<div style="display:flex; justify-content:space-between; gap:0.5rem;"><strong>' + label + '</strong><span class="hint" style="margin:0;">' + tm(t.leaveAt) + '–' + tm(t.backAt) + '</span></div>' +
      '<div class="hint" style="margin:0.15rem 0 0;">' + path + '</div>' +
      '<div style="margin-top:0.15rem;">' + (t.km != null ? '<span>' + nf(t.km, 0) + ' km incl. ' + nf(t.marginKm, 0) + ' km margin</span> · ' : '') + '<strong>' + (t.kwh != null ? (t.approx ? '≈ ' : '') + nf(t.kwh, 1) + ' kWh' : '—') + '</strong></div>' +
      (tight ? '<div class="hint" style="margin:0.15rem 0 0; color:#b8860b;">Tight: the drive between two appointments takes longer than the time in between.</div>' : '') + '</div>';
  }

  function renderDetail() {
    var el = document.getElementById('ag-detail');
    var it = selected && (data.items || []).find(function (i) { return key(i) === selected; });
    if (!it) {
      // the drives from home coming up: one per appointment, two for drop off and pick up, one for a route
      var up = (data.tours || []).filter(function (t) { return new Date(t.backAt) > new Date(); }).slice(0, 5);
      el.innerHTML = '<div style="border:1px solid var(--border); border-radius:12px; padding:0.9rem 1rem;"><strong>Coming up with the car</strong>' +
        (up.length ? up.map(function (t) { return '<div data-key="' + esc(t.stops[0].key) + '" style="margin-top:0.5rem; cursor:pointer;">' + (/[\u{1F697}\u{1F699}\u{1F698}]/u.test(t.title) ? '' : '🚗 ') + '<strong>' + esc(t.title) + '</strong>' + (t.stops.length === 1 && t.stops[0].role !== 'stay' ? ' <span class="hint" style="margin:0;">' + esc(roleName(t.stops[0].role)) + '</span>' : '') + '<div class="hint" style="margin:0;"><span>' + new Date(t.leaveAt).toLocaleString([], { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) + '–' + tm(t.backAt) + '</span>' + (t.kwh != null ? ' · ' + (t.approx ? '≈ ' : '') + nf(t.kwh, 1) + ' kWh' : '') + '</div></div>'; }).join('') : '<p class="hint" style="margin:0.4rem 0 0;">Nothing in this period. Click an appointment for details.</p>') + '</div>';
      bindClicks(el);
      return;
    }
    var when = it.allDay ? new Date(it.start).toLocaleDateString([], { weekday: 'short', day: 'numeric', month: 'short' }) + ' (all day)' : new Date(it.start).toLocaleString([], { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) + ' – ' + tm(it.end);
    var html = '<div style="border:1px solid var(--border); border-radius:12px; padding:0.9rem 1rem;">' +
      '<div class="hint" style="margin:0; font-size:0.72rem; text-transform:uppercase; letter-spacing:0.04em;">' + esc(it.calendar || (it.kind === 'trip' ? 'LoxSuite trip' : '')) + '</div>' +
      '<div style="font-size:1.1rem; font-weight:700; margin:0.15rem 0;">' + carMark(it) + esc(it.title) + '</div>' +
      '<div class="hint" style="margin:0;">' + when + (it.location ? ' · 📍 ' + esc(it.location) : '') + '</div>' +
      (it.movedFrom ? '<div class="hint" style="margin:0.2rem 0 0;">Moved from ' + new Date(it.movedFrom).toLocaleString([], { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) + ' — what you chose for the series still counts.</div>' : '');
    if (it.kind === 'event' && canEdit) {
      html += '<div class="ag-box" style="margin-top:0.8rem; background:var(--accent-soft, #EAF7E4);"><div class="ag-field"><span class="ag-lbl">Car needed</span>' +
        '<select id="ag-need"><option value="">auto' + (it.carTag ? ' (yes, marker)' : ' (no)') + '</option><option value="1"' + ((it.carSource === 'you' || it.carSource === 'series') && it.needsCar ? ' selected' : '') + '>yes</option><option value="0"' + ((it.carSource === 'you' || it.carSource === 'series') && !it.needsCar ? ' selected' : '') + '>no</option></select></div></div>' +
        (it.recurring ? '<div id="ag-scope" hidden style="margin:0 0 0.4rem; padding:0.5rem 0.7rem; border:1px dashed var(--border); border-radius:10px;"><span class="hint" style="margin:0 0.5rem 0 0;">Repeating appointment — for:</span><button type="button" class="btn-soft" data-scope="day">only this day</button> <button type="button" class="btn-soft" data-scope="series">the whole series</button></div>' : '') +
        (it.carSource === 'series' ? '<p class="hint" style="margin:0 0 0.3rem;">Set for the whole series.</p>' : '') +
        '<div class="hint" style="margin:0 0 0.4rem; font-size:0.75rem;">Stored in LoxSuite only; your calendar isn\'t changed.</div>';
    }
    if (it.kind === 'event' && canEdit && it.needsCar && !it.allDay) {
      var mOpt = function (v, l) { return '<option value="' + v + '"' + ((it.tripModeSource === 'you' || it.tripModeSource === 'series' ? it.tripMode : '') === v ? ' selected' : '') + '>' + l + '</option>'; };
      // the next appointment with the car in full under the dropdown (a long title doesn't fit in it)
      // after an appointment also: back home via where the drive started (e.g. to pick up there)
      var chainSel = function (id, label, on, next, via) {
        var v = Number(on) || 0;
        return '<div class="ag-field"><span class="ag-lbl">' + label + '</span><select id="' + id + '">' +
          '<option value="0"' + (v === 0 ? ' selected' : '') + '>back home</option>' +
          '<option value="1"' + (v === 1 ? ' selected' : '') + (next ? '' : ' disabled') + '>drive on to the next appointment</option>' +
          (via ? '<option value="2"' + (v === 2 ? ' selected' : '') + '>via the first address, then home</option>' : '') + '</select>' +
          '<div class="hint">' + (v === 2 && via ? '<span>Via:</span> ' + esc(via.title) + (via.location ? ' · ' + esc(via.location) : '') : next ? '<span>Next appointment:</span> ' + esc(next.title) + ' · ' + tm(next.at) : 'No appointment with the car after it.') + '</div></div>';
      };
      var m = it.tripMode || 'stay';
      html += '<div class="ag-box" style="background:var(--surface-alt, #f4f6f8);">' +
        '<div class="ag-field"><span class="ag-lbl">How you drive</span><select id="ag-mode">' +
        mOpt('', (it.tripTag ? 'calendar — ' : 'default — ') + modeName(it.tripTag || 'stay')) + mOpt('stay', 'the car stays there') + mOpt('both', 'drop off and pick up') + mOpt('drop', 'only drop off') + mOpt('pick', 'only pick up') + '</select>' +
        '<div class="hint">' + (it.tripModeSource === 'tag' ? 'From the calendar text (#brengen / #halen).' : it.tripModeSource === 'series' || it.chainSource === 'series' ? 'Set for the whole series.' : 'In the calendar text: #brengen, #halen or both.') + '</div></div>' +
        (m === 'both' || m === 'drop' ? chainSel('ag-chain-start', 'After dropping off', it.chainStart, it.nextAfterStart) : '') +
        (m === 'stay' ? chainSel('ag-chain-end', 'Afterwards', it.chainEnd, it.nextAfterEnd, it.viaAfterEnd) : m === 'both' || m === 'pick' ? chainSel('ag-chain-end', 'After picking up', it.chainEnd, it.nextAfterEnd, it.viaAfterEnd) : '') +
        (it.recurring ? '<div id="ag-trip-scope" hidden style="margin:0.4rem 0 0; padding:0.5rem 0.7rem; border:1px dashed var(--border); border-radius:10px;"><span class="hint" style="margin:0 0.5rem 0 0;">Repeating appointment — for:</span><button type="button" class="btn-soft" data-scope="day">only this day</button> <button type="button" class="btn-soft" data-scope="series">the whole series</button></div>' : '') +
        '</div>';
    }
    if (it.needsCar) {
      html += '<table style="font-size:0.85rem; margin-top:0.4rem; width:100%;" class="ag-need">' +
        (it.distanceKm != null ? '<tr><td>Distance (there and back)</td><td style="text-align:right;">' + (it.tripMode === 'both' ? '2 × ' : '') + '2 × ' + nf(it.distanceKm, 0) + ' km</td></tr>' : '') +
        '<tr><td>Basis</td><td style="text-align:right;">' + esc(it.needBasis || '') + '</td></tr>' +
        '<tr><td>Consumption</td><td style="text-align:right;">' + nf(it.kwhPerKm, 2) + ' kWh/km</td></tr>' +
        '<tr><td><strong>Needs</strong></td><td style="text-align:right;"><strong>' + (it.needKwh != null ? nf(it.needKwh, 1) + ' kWh' : '—') + '</strong></td></tr>' +
        (it.travelMin ? '<tr><td>Leave (travel ' + Math.floor(it.travelMin / 60) + ' h ' + String(it.travelMin % 60).padStart(2, '0') + ')</td><td style="text-align:right;">' + tm(it.leaveAt) + '</td></tr>' : '') +
        '<tr><td>Ready by</td><td style="text-align:right;">' + tm(it.readyAt) + '</td></tr></table>';
 // drop off / pick up, or a route past several appointments: each drive from home
      var tours = it.tours || [];
      if (tours.length && ((it.tripMode && it.tripMode !== 'stay') || tours.some(function (t) { return t.stops.length > 1; }))) html += tours.map(routeBlock).join('');
 // more than the battery holds: per drive from home (the car can charge in between)
      var most = tours.length ? Math.max.apply(null, tours.map(function (t) { return t.kwh || 0; })) : it.needKwh;
      if (it.usableKwh && most > it.usableKwh) html += '<p class="hint" style="margin:0.4rem 0 0; color:#b8860b;">More than the battery (' + nf(it.usableKwh, 1) + ' kWh): ' + (it.vehicleType === 'phev' ? 'it leaves full, the rest is fuel.' : 'plan a charging stop.') + '</p>';
      if (it.geoError) html += '<p class="hint" style="margin:0.4rem 0 0; color:var(--danger);">Distance: ' + esc(it.geoError) + '</p>';
      if (it.location && it.distanceKm == null && canEdit) html += '<button type="button" class="btn-soft" id="ag-dist" style="margin-top:0.5rem;">' + (it.geoError ? 'Try again' : 'Look up distance') + '</button>';
    }
    if (it.kind === 'event' && canEdit && it.needsCar) html += '<div class="ag-field" style="margin-top:0.7rem;"><span class="ag-lbl">Own value (optional)</span><input type="text" id="ag-own" value="' + esc(it.own || '') + '" placeholder="150 km, 30 kWh or full"><button type="button" class="btn-soft" id="ag-own-save" style="margin-top:0.35rem;">Save</button></div>';
    if (it.needsCar && (canEdit || it.climateC != null)) {
      var cm = (data.climate || {}).mode || 'log';
      var lead = (data.climate || {}).leadMin || 20;
      var weekly = it.kind === 'trip' && it.weekly;
      var climOn = it.climateC != null && !it.climateOff;
      var opts = '';
      for (var tc = 16; tc <= 26; tc++) opts += '<option value="' + tc + '"' + (Number(it.climateC || lastTemp()) === tc ? ' selected' : '') + '>' + tc + ' °C</option>';
      if (it.climateC != null && (it.climateC % 1 || it.climateC < 16 || it.climateC > 26)) opts += '<option value="' + it.climateC + '" selected>' + nf(it.climateC, 1) + ' °C</option>';
      html += '<div style="margin-top:0.7rem; padding:0.5rem 0.7rem; border-radius:10px; background:var(--surface-alt, #f4f6f8);">' +
        '<div style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem;"><strong>🌡️ Climate at departure</strong>' +
        (canEdit ? '<label class="switch"><input type="checkbox" id="ag-clim-on"' + (climOn ? ' checked' : '') + (it.climateOk ? '' : ' disabled') + '><span class="switch-track"><span class="switch-thumb"></span></span></label>'
          : '<span>' + (climOn ? nf(it.climateC, 1) + ' °C' : 'off') + '</span>') + '</div>';
      if (canEdit && climOn) {
        html += '<div class="ag-field" style="margin-top:0.45rem;"><span class="ag-lbl">' + (weekly ? 'Temperature (every week)' : 'Temperature') + '</span><select id="ag-climate">' + opts + '</select></div>';
      }
      html += '<div class="hint" style="margin:0.25rem 0 0; font-size:0.75rem;">' +
        (!it.climateOk ? 'Needs a car with the Škoda API as data source.'
          : it.climateOff ? 'Switched off for this time; the other weeks keep ' + nf(it.climateC, 1) + ' °C.'
          : !climOn ? (weekly ? 'Off. Switching it on sets it for every week.' : 'Off.')
          : cm === 'off' ? 'Climate at departure is off in the agenda settings.'
          : 'Starts ' + lead + ' min before you leave' + (it.leaveAt ? ' (' + tm(new Date(Date.parse(it.leaveAt) - lead * 60000).toISOString()) + ')' : '') + '.' + (cm === 'log' ? ' Log only: nothing is sent to the car yet (agenda settings).' : '') + (weekly ? ' Switching it off skips this time only.' : '')) +
        '</div>' +
        (canEdit && weekly && it.climateC != null ? '<div style="margin-top:0.25rem; font-size:0.8rem;"><a href="#" id="ag-clim-all">Switch off for every week</a></div>' : '') +
        (it.climateRun && it.climateRun.status !== 'off' ? '<div class="hint" style="margin:0.2rem 0 0; font-size:0.75rem;' + (it.climateRun.status === 'failed' ? ' color:var(--danger);' : '') + '">' + esc(it.climateRun.message || it.climateRun.status) + '</div>' : '') +
        '</div>';
    }
    html += '<p style="margin:0.6rem 0 0;"><a href="#" id="ag-close">Close</a></p></div>';
    el.innerHTML = html;
    var setTemp = function (v) {
      if (it.kind === 'trip') return post('/agenda/trips/' + it.id + '/climate.json', { climate_c: v });
      return post('/agenda/override.json', { calendar_id: it.calendar_id, uid: it.uid, start_at: it.occ || it.start, climate_c: v });
    };
    var skip = function (off) {
      return post('/agenda/climate-skip.json', { kind: it.kind, id: it.id, calendar_id: it.calendar_id, uid: it.uid, start: it.start, leave_at: it.leaveAt, title: it.title, target_c: it.climateC, off: off ? 1 : 0 });
    };
    var climOnEl = document.getElementById('ag-clim-on');
    if (climOnEl) climOnEl.onchange = function () {
      var weeklySet = it.kind === 'trip' && it.weekly && it.climateC != null;
      if (climOnEl.checked) (it.climateOff ? skip(false) : setTemp(lastTemp())).then(load);
      else (weeklySet ? skip(true) : setTemp('')).then(load);
    };
    var clim = document.getElementById('ag-climate');
    if (clim) clim.onchange = function () { try { localStorage.setItem('ag-climate-last', clim.value); } catch (e) {} setTemp(clim.value).then(load); };
    var climAll = document.getElementById('ag-clim-all');
    if (climAll) climAll.onclick = function (e) { e.preventDefault(); (it.climateOff ? skip(false) : Promise.resolve()).then(function () { return setTemp(''); }).then(load); };
    var save = function (patch) {
      post('/agenda/override.json', Object.assign({ calendar_id: it.calendar_id, uid: it.uid, start_at: it.occ || it.start, needs_car: document.getElementById('ag-need') ? document.getElementById('ag-need').value : '', own_value: document.getElementById('ag-own') ? document.getElementById('ag-own').value : it.own }, patch || {})).then(load);
    };
    var need = document.getElementById('ag-need');
    var scope = document.getElementById('ag-scope');
    if (need) need.onchange = function () {
      if (!scope) { save(); return; }
      // a repeating appointment: ask whether this is for this day or the whole series
      scope.hidden = false;
      scope.querySelectorAll('button').forEach(function (b) {
        b.onclick = function () { save(b.dataset.scope === 'series' ? { scope: 'series' } : {}); };
      });
    };
    // how you drive / driving on: for a repeating appointment, this day or the whole series
    var tripScope = document.getElementById('ag-trip-scope');
    var setTrip = function (patch) {
      var go = function (series) { post('/agenda/override.json', Object.assign({ calendar_id: it.calendar_id, uid: it.uid, start_at: it.occ || it.start }, patch, series ? { scope: 'series' } : {})).then(load); };
      if (!tripScope) { go(false); return; }
      tripScope.hidden = false;
      tripScope.querySelectorAll('button').forEach(function (b) { b.onclick = function () { go(b.dataset.scope === 'series'); }; });
    };
    var modeEl = document.getElementById('ag-mode');
    if (modeEl) modeEl.onchange = function () { setTrip({ trip_mode: modeEl.value }); };
    var cs = document.getElementById('ag-chain-start');
    if (cs) cs.onchange = function () { setTrip({ chain_start: cs.value }); };
    var ce = document.getElementById('ag-chain-end');
    if (ce) ce.onchange = function () { setTrip({ chain_end: ce.value }); };
    var own = document.getElementById('ag-own-save');
    if (own) own.onclick = function () { save(); };
    var dist = document.getElementById('ag-dist');
    var lookUp = function (force) { if (!dist) return; dist.disabled = true; dist.textContent = 'Looking up…'; post('/agenda/distance.json', { location: it.location, force: force }).then(load); };
    if (dist) dist.onclick = function () { lookUp(true); };
    // an address without a distance: look it up straight away (once per address on this page)
    if (dist && !it.geoError && !distTried[it.location]) { distTried[it.location] = true; lookUp(false); }
    document.getElementById('ag-close').onclick = function (e) { e.preventDefault(); selected = null; render(); };
  }

  var tf = document.getElementById('ag-trip-form');
  if (tf) tf.addEventListener('submit', function () {
    var dep = document.getElementById('ag-dep').value; var ret = document.getElementById('ag-ret').value;
    tf.depart_at.value = dep ? new Date(dep).toISOString() : '';
    tf.return_at.value = ret ? new Date(ret).toISOString() : '';
  });
  load();
  setInterval(load, 5 * 60 * 1000);
})();
</script>

<%- include('partials/foot') %>
