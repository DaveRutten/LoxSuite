    var path = '<span>home</span>';
    t.stops.forEach(function (st, i) { path += ' → ' + esc(st.title) + (st.role === 'via' ? ' <span>(again)</span>' : '') + ' <span style="opacity:0.7;">(' + km(t.legs[i]) + ')</span>'; });
    path += ' → <span>home</span> <span style="opacity:0.7;">(' + km(t.legs[t.legs.length - 1]) + ')</span>';
    var tight = (t.legs || []).some(function (l) { return l && l.tight; });
    return '<div style="margin-top:0.5rem; padding:0.45rem 0.6rem; border:1px solid var(--border); border-radius:10px;">' +
      '<div style="display:flex; justify-content:space-between; gap:0.5rem;"><strong>' + label + '</strong><span class="hint" style="margin:0;">' + tm(t.leaveAt) + '–' + tm(t.backAt) + '</span></div>' +
      '<div class="hint" style="margin:0.15rem 0 0;">' + path + '</div>' +
      '<div style="margin-top:0.15rem;">' + (t.km != null ? '<span>' + nf(t.km, 0) + ' km incl. ' + nf(t.marginKm, 0) + ' km margin</span> · ' : '') + '<strong>' + (t.kwh != null ? (t.approx ? '≈ ' : '') + nf(t.kwh, 1) + ' kWh' : '—') + '</strong></div>' +
      (tight ? '<div class="hint" style="margin:0.15rem 0 0; color:#b8860b;">Tight: the drive between two appointments takes longer than the time in between.</div>' : '') + '</div>';
  }

  // The "ready by" of one day: what it is based on, and changing it for this day or every week.
  var depScope = {};
  function departureDetail(el, l) {
    var d = new Date(l.date + 'T12:00:00');
    var wdName = d.toLocaleDateString([], { weekday: 'long' });
