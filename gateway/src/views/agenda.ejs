      '<div style="font-size:1.1rem; font-weight:700; margin:0.15rem 0;">' + esc(d.toLocaleDateString([], { weekday: 'long', day: 'numeric', month: 'long' })) + '</div>' +
      '<div class="hint" style="margin:0;"><strong>' + esc(now) + '</strong></div>' +
      '<div class="hint" style="margin:0.15rem 0 0;">' + esc(learnedTxt) + '</div>' +
      (l.off ? '<div class="hint" style="margin:0.15rem 0 0;">' + esc(T('A day off (away, holiday or working from home): the plan doesn\'t count on it unless you set a time for this day.')) + '</div>' : '');
    if (canEdit) {
      html += '<div style="margin-top:0.8rem;"><span class="ag-lbl">' + esc(T('Change for:')) + '</span>' +
        '<div class="segmented" id="ag-dep-sc" style="display:flex; width:100%;"><button type="button" data-sc="day" style="flex:1;"' + (sc === 'day' ? ' class="on"' : '') + '>' + esc(T('only this day')) + '</button><button type="button" data-sc="weekday" style="flex:1;"' + (sc === 'weekday' ? ' class="on"' : '') + '>' + esc(T('on every {0}', wdName)) + '</button></div>' +
        '<div class="hint" style="margin:0.25rem 0 0; font-size:0.75rem;">' + esc(sc === 'day'
          ? T('LoxSuite plans with it that day. Once the day has passed it counts for what it learns (a real departure goes first).')
          : T('Your own time for that weekday, every week (also under Learned). The days you changed separately keep their own.')) + '</div></div>' +
        '<div class="ag-box" style="background:var(--surface-alt, #f4f6f8);"><div class="ag-field"><span class="ag-lbl">' + esc(T('Ready at')) + '</span>' +
        '<div style="display:flex; gap:0.4rem; align-items:center;"><input type="time" id="ag-dep-time" step="300" value="' + esc(sc === 'weekday' && l.weekdayReady && l.weekdayReady !== 'none' ? l.weekdayReady : cur || l.learnedReady || '07:00') + '" style="flex:1; min-width:0;"><button type="button" class="btn-edit" id="ag-dep-save">' + esc(T('Save')) + '</button></div></div>' +
        '<div class="btn-row" style="margin:0.5rem 0 0; flex-wrap:wrap;"><button type="button" class="btn-soft" id="ag-dep-none">' + esc(T('No departure')) + '</button>' +
        (canBack ? '<button type="button" class="btn-soft" id="ag-dep-back">' + esc(sc === 'day' ? T('As usual') : T('Back to learned')) + '</button>' : '') + '</div></div>';
      if (l.hint && !(l.weekdayReady && l.weekdayReady === l.hint.ready)) {
        html += '<div class="hint" style="margin:0.5rem 0 0; padding:0.45rem 0.6rem; border:1px dashed var(--border); border-radius:10px;">' +
          esc(l.hint.ready === 'none' ? T('You said no departure on {0} {1} times lately.', wdName, l.hint.n) : T('You moved {0} to about {1} {2} times lately.', wdName, l.hint.ready, l.hint.n)) +
          ' <a href="#" id="ag-dep-hint">' + esc(T('Use it for every {0}', wdName)) + '</a></div>';
      }
    }
    html += '<p style="margin:0.6rem 0 0;"><a href="#" id="ag-close">' + esc(T('Close')) + '</a></p></div>';
    el.innerHTML = html;
    var send = function (scope, ready) { post('/agenda/departure.json', { date: l.date, scope: scope, ready: ready }).then(load); };
    var q = function (id) { return document.getElementById(id); };
