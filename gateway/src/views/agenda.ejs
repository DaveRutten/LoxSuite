        var c = l.source === 'learned' ? '#9aa4b2' : 'var(--en-battery)', faint = l.none || l.off;
        var txt = l.none ? T('no departure') : T('ready {0}', tm(a));
        var tag = ''; // solid violet = this day, dashed violet = your own every week (the legend says so)
        var sel = selected === 'dep|' + l.date;
        col += '<div data-dep-line="' + esc(l.date) + '" style="position:absolute; left:0; right:0; top:' + y(a) + 'px; border-top:2px ' + (l.source === 'day' && !l.none ? 'solid' : 'dashed') + ' ' + c + '; z-index:6; pointer-events:none;' + (faint ? ' opacity:0.45;' : '') + '">' +
          '<span data-dep="' + esc(l.date) + '" title="' + esc(canEdit ? T('Click to change, drag to move this day') : '') + '" style="position:absolute; right:10px; top:-10px; font-size:10px; line-height:1; padding:3px 6px; border-radius:6px; background:var(--surface, #fff); color:var(--text); border:1px solid ' + c + '; white-space:nowrap; max-width:calc(100% - 16px); overflow:hidden; text-overflow:ellipsis; pointer-events:auto; cursor:' + (canEdit ? 'ns-resize' : 'pointer') + '; touch-action:none;' + (l.none ? ' text-decoration:line-through;' : '') + (sel ? ' box-shadow:0 0 0 2px ' + c + ';' : '') + '"><span>' + txt + '</span>' + tag + (l.off && !l.none ? ' <span>' + esc(T('· day off')) + '</span>' : '') + '</span></div>';
