    q('ag-close').onclick = function (e) { e.preventDefault(); selected = null; render(); };
  }

  function renderDetail() {
    var el = document.getElementById('ag-detail');
    if (selected && selected.indexOf('dep|') === 0) {
      var dl = (data.learned || []).find(function (x) { return 'dep|' + x.date === selected; });
      if (dl) { departureDetail(el, dl); return; }
      selected = null;
    }
    var it = selected && (data.items || []).find(function (i) { return key(i) === selected; });
    if (!it) {
      // the drives from home coming up: one per appointment, two for drop off and pick up, one for a route
      var up = (data.tours || []).filter(function (t) { return new Date(t.backAt) > new Date(); }).slice(0, 5);
      el.innerHTML = '<div style="border:1px solid var(--border); border-radius:12px; padding:0.9rem 1rem;"><strong>Coming up with the car</strong>' +
        (up.length ? up.map(function (t) { return '<div data-key="' + esc(t.stops[0].key) + '" style="margin-top:0.5rem; cursor:pointer;">' + (/[\u{1F697}\u{1F699}\u{1F698}]/u.test(t.title) ? '' : '🚗 ') + '<strong>' + esc(t.title) + '</strong>' + (t.stops.length === 1 && t.stops[0].role !== 'stay' ? ' <span class="hint" style="margin:0;">' + esc(roleName(t.stops[0].role)) + '</span>' : '') + '<div class="hint" style="margin:0;"><span>' + new Date(t.leaveAt).toLocaleString([], { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) + '–' + tm(t.backAt) + '</span>' + (t.kwh != null ? ' · ' + (t.approx ? '≈ ' : '') + nf(t.kwh, 1) + ' kWh' : '') + '</div></div>'; }).join('') : '<p class="hint" style="margin:0.4rem 0 0;">Nothing in this period. Click an appointment for details.</p>') + '</div>';
      bindClicks(el);
      return;
    }
    var when = it.allDay ? new Date(it.start).toLocaleDateString([], { weekday: 'short', day: 'numeric', month: 'short' }) + ' (all day)' : new Date(it.start).toLocaleString([], { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) + ' – ' + tm(it.end);
    var html = '<div style="border:1px solid var(--border); border-radius:12px; padding:0.9rem 1rem;">' +
      '<div class="hint" style="margin:0; font-size:0.72rem; text-transform:uppercase; letter-spacing:0.04em;">' + esc(it.calendar || (it.kind === 'trip' ? 'LoxSuite trip' : '')) + '</div>' +
      '<div style="font-size:1.1rem; font-weight:700; margin:0.15rem 0;">' + carMark(it) + esc(it.title) + '</div>' +
      '<div class="hint" style="margin:0;">' + when + (it.location ? ' · 📍 ' + esc(it.location) : '') + '</div>' +
      (it.movedFrom ? '<div class="hint" style="margin:0.2rem 0 0;">Moved from ' + new Date(it.movedFrom).toLocaleString([], { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) + ' — what you chose for the series still counts.</div>' : '');
    // a repeating appointment: first choose whether what follows is for this day or the whole series
    // (by name); a choice is then saved straight away
    var day = it.day || {}, ser = it.series || {};
    var sc = it.recurring ? (scopeOf[key(it)] || (['needs_car', 'trip_mode', 'chain_start', 'chain_end', 'vehicle_id'].some(function (k) { return day[k] != null; }) ? 'day' : 'series')) : 'day';
    if (it.kind === 'event' && canEdit) {
      if (it.linkedSeries) html += '<div class="hint" style="margin:0.5rem 0 0;"><span>Linked by name to the series</span> “' + esc(it.linkedSeries) + '” <span>— its choices count here.</span></div>';
      if (it.recurring) {
        html += '<div style="margin-top:0.8rem;"><span class="ag-lbl">Repeating appointment — for:</span>' +
          '<div class="segmented" id="ag-sc" style="display:flex; width:100%;"><button type="button" data-sc="day" style="flex:1;"' + (sc === 'day' ? ' class="on"' : '') + '>only this day</button><button type="button" data-sc="series" style="flex:1;"' + (sc === 'series' ? ' class="on"' : '') + '>the whole series</button></div>' +
          '<div class="hint" style="margin:0.25rem 0 0; font-size:0.75rem; overflow-wrap:anywhere;">' + (sc === 'series'
            ? '<span>Every appointment in this calendar called</span> “' + esc(it.seriesTitle || it.title) + '”<span>, also on another day.</span>'
            : '<span>Only this one; what is not chosen here comes from the series.</span>') + '</div></div>';
      }
      html += '<div class="ag-box" style="margin-top:0.6rem; background:var(--surface-alt, #f4f6f8);" title="' + esc(T('Stored in LoxSuite only; your calendar isn\'t changed.')) + '">';
      // what is stored for the chosen scope (null = not chosen there)
      var ownOf = function (k) { return sc === 'series' ? ser[k] : day[k]; };
      var chips = function (id, opts, cur) {
        return '<div class="ag-chips" id="' + id + '">' + opts.filter(Boolean).map(function (o) { return '<button type="button" data-v="' + esc(o[0]) + '"' + (String(cur) === String(o[0]) ? ' class="on"' : '') + ' title="' + esc(o[1]) + '"><span>' + esc(o[1]) + '</span></button>'; }).join('') + '</div>';
      };
      // where the shown choice comes from, and ↺ back when you chose it here
      var srcTag = function (src) { return src === 'tag' ? '<span class="ag-src">' + esc(T('from the calendar')) + '</span>' : src === 'series' && sc === 'day' ? '<span class="ag-src">' + esc(T('from the series')) + '</span>' : ''; };
      var reset = function (k) { return ownOf(k) != null ? '<a href="#" class="ag-reset" data-reset="' + k + '" title="' + esc(sc === 'day' && ser[k] != null ? T('as the series') : T('back to automatic')) + '">↺</a>' : ''; };
      var lbl = function (txt, extra, title) { return '<span class="ag-lbl"' + (title ? ' title="' + esc(title) + '"' : '') + '>' + esc(txt) + (extra || '') + '</span>'; };
      var needCur = sc === 'series' ? (ser.needs_car != null ? Number(ser.needs_car) : (it.carTag ? 1 : 0)) : (it.needsCar ? 1 : 0);
      html += '<div class="ag-row">' + lbl(T('Car needed'), srcTag(it.carSource) + reset('needs_car')) + chips('ag-need', [['1', T('yes')], ['0', T('no')]], needCur) + '</div>';
      // which car, when LoxSuite knows more than one (default: the calendar's car, else the first)
      var cars = data.vehicles || [];
      if (it.needsCar && cars.length > 1) {
        var carCur = sc === 'series' ? (ser.vehicle_id != null ? ser.vehicle_id : it.vehicleSource === 'calendar' ? it.vehicle_id : cars[0].id) : (it.vehicle_id || cars[0].id);
        html += '<div class="ag-row">' + lbl(T('Which car'), (it.vehicleSource === 'calendar' ? '<span class="ag-src">' + esc(T('from the calendar settings')) + '</span>' : srcTag(it.vehicleSource)) + reset('vehicle_id')) +
          chips('ag-car', cars.map(function (v) { return [String(v.id), v.name]; }), String(carCur)) + '</div>';
      }
      if (it.needsCar && !it.allDay) {
        var m = sc === 'series' ? (ser.trip_mode || it.tripTag || 'stay') : (it.tripMode || 'stay');
        html += '<div class="ag-row">' + lbl(T('Trip'), srcTag(it.tripModeSource) + reset('trip_mode'), T('Also set by #brengen / #halen in the calendar text.')) +
          chips('ag-mode', [['stay', T('there and back')], ['drop', T('drop off')], ['pick', T('pick up')], ['both', T('drop off and pick up')]], m) + '</div>';
        var chainVal = function (field) { var o = ownOf(field); return o != null ? Number(o) : sc === 'series' ? 0 : Number(field === 'chain_start' ? (it.chainStart ? 1 : 0) : it.chainEnd) || 0; };
        // after dropping off: only when there is an appointment to drive on to (or it was chosen)
        var nxS = it.nextAfterStart, cs0 = chainVal('chain_start');
        if ((m === 'both' || m === 'drop') && (nxS || cs0)) {
          html += '<div class="ag-row">' + lbl(T('After dropping off'), reset('chain_start')) + chips('ag-cs', [['0', T('back home')], nxS || cs0 === 1 ? ['1', nxS ? T('drive on to {0}', nxS.title) : T('drive on to the next appointment')] : null], cs0) + '</div>';
        }
        // afterwards: home, on to the next appointment, or back home via where the drive started
        var nxE = it.nextAfterEnd, via = it.viaAfterEnd, ce0 = chainVal('chain_end');
        if (m !== 'drop' && (nxE || via || ce0)) {
          html += '<div class="ag-row">' + lbl(m === 'stay' ? T('Afterwards') : T('After picking up'), reset('chain_end')) +
            chips('ag-ce', [['0', T('back home')], nxE || ce0 === 1 ? ['1', nxE ? T('drive on to {0}', nxE.title) : T('drive on to the next appointment')] : null, via || ce0 === 2 ? ['2', via ? T('via {0}, then home', via.title) : T('via the first address, then home')] : null], ce0) + '</div>';
        }
        // route options for this address: one toggle per thing the route takes (or that you avoid), so
        // the row stays short where nothing matters; another kind of road later is just another chip
        var rt = it.route;
        if (rt) {
          var rc = rt.choice || {}, avNow = rt.avoid || [], uses = rt.uses || [];
          var rLbl = { ferry: T('without the ferry'), toll: T('without toll roads'), motorway: T('without motorways') };
          var shown = (data.routeClasses || []).filter(function (c) { return uses.includes(c) || avNow.includes(c) || typeof rc[c] === 'boolean'; });
          if (shown.length) {
            var mine = shown.some(function (c) { return typeof rc[c] === 'boolean'; });
            // still takes it although avoided: there is no other way (unless the route service couldn't be asked — that note shows below)
            var stuck = it.geoError ? [] : shown.filter(function (c) { return avNow.includes(c) && uses.includes(c); });
            html += '<div class="ag-row">' + lbl(T('Route'), '<span class="ag-src">' + esc(T('for this address')) + '</span>' + (mine ? '<a href="#" class="ag-reset" id="ag-route-reset" title="' + esc(T('as the default')) + '">↺</a>' : ''), T('For every appointment at this address.')) +
              '<div class="ag-chips ag-multi" id="ag-route">' + shown.map(function (c) { var on = avNow.includes(c); return '<button type="button" data-c="' + esc(c) + '" aria-pressed="' + on + '"' + (on ? ' class="on"' : '') + '>' + TICK + '<span>' + esc(rLbl[c] || c) + '</span></button>'; }).join('') + '</div>' +
              (stuck.length ? '<div class="hint" style="margin:0.2rem 0 0; font-size:0.75rem;">' + esc(T('Not possible on this route: {0}.', stuck.map(function (c) { return rLbl[c] || c; }).join(', '))) + '</div>' : '') + '</div>';
          }
        }
      }
      html += '</div>';
    }
    if (it.needsCar) {
      html += '<table style="font-size:0.85rem; margin-top:0.4rem; width:100%;" class="ag-need">' +
        '<tr><td>Basis</td><td style="text-align:right;">' + esc(it.needBasis || '') + '</td></tr>' +
        '<tr><td>Consumption</td><td style="text-align:right;">' + nf(it.kwhPerKm, 2) + ' kWh/km</td></tr>' +
        '<tr><td><strong>Needs</strong></td><td style="text-align:right;"><strong>' + (it.needKwh != null ? nf(it.needKwh, 1) + ' kWh' : '—') + '</strong></td></tr>' +
        (it.travelMin ? '<tr><td>' + (it.travelMin < 60 ? 'Leave (' + it.travelMin + ' min drive)' : 'Leave (' + Math.floor(it.travelMin / 60) + ' h ' + String(it.travelMin % 60).padStart(2, '0') + ' drive)') + '</td><td style="text-align:right;">' + tm(it.leaveAt) + '</td></tr>' : '') +
        '<tr><td>Ready by</td><td style="text-align:right;">' + tm(it.readyAt) + '</td></tr></table>';
 // drop off / pick up, or a route past several appointments: each drive from home
      var tours = it.tours || [];
      if (tours.length && ((it.tripMode && it.tripMode !== 'stay') || tours.some(function (t) { return t.stops.length > 1; }))) html += tours.map(routeBlock).join('');
 // more than the battery holds: per drive from home (the car can charge in between)
      var most = tours.length ? Math.max.apply(null, tours.map(function (t) { return t.kwh || 0; })) : it.needKwh;
      if (it.usableKwh && most > it.usableKwh) html += '<p class="hint" style="margin:0.4rem 0 0; color:#b8860b;">More than the battery (' + nf(it.usableKwh, 1) + ' kWh): ' + (it.vehicleType === 'phev' ? 'it leaves full, the rest is fuel.' : 'plan a charging stop.') + '</p>';
      if (it.geoError) html += '<p class="hint" style="margin:0.4rem 0 0; color:' + (it.distanceKm != null ? '#b8860b' : 'var(--danger)') + ';">' + esc(T(it.geoError)) + '</p>';
      if (it.location && it.distanceKm == null && canEdit) html += '<button type="button" class="btn-soft" id="ag-dist" style="margin-top:0.5rem;">' + (it.geoError ? 'Try again' : 'Look up distance') + '</button>';
    }
    if (it.kind === 'event' && canEdit && it.needsCar) html += '<div class="ag-field" style="margin-top:0.7rem;"><span class="ag-lbl">Own value (optional)</span><input type="text" id="ag-own" value="' + esc(it.own || '') + '" placeholder="150 km, 30 kWh or full"><button type="button" class="btn-soft" id="ag-own-save" style="margin-top:0.35rem;">Save</button></div>';
    if (it.needsCar && (canEdit || it.climateC != null)) {
      var cm = (data.climate || {}).mode || 'log';
      var lead = (data.climate || {}).leadMin || 20;
      var weekly = it.kind === 'trip' && it.weekly;
      var climOn = it.climateC != null && !it.climateOff;
      var opts = '';
      for (var tc = 16; tc <= 26; tc++) opts += '<option value="' + tc + '"' + (Number(it.climateC || lastTemp()) === tc ? ' selected' : '') + '>' + tc + ' °C</option>';
      if (it.climateC != null && (it.climateC % 1 || it.climateC < 16 || it.climateC > 26)) opts += '<option value="' + it.climateC + '" selected>' + nf(it.climateC, 1) + ' °C</option>';
      html += '<div style="margin-top:0.7rem; padding:0.5rem 0.7rem; border-radius:10px; background:var(--surface-alt, #f4f6f8);">' +
        '<div style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem;"><strong>🌡️ Climate at departure</strong>' +
        (canEdit ? '<label class="switch"><input type="checkbox" id="ag-clim-on"' + (climOn ? ' checked' : '') + (it.climateOk ? '' : ' disabled') + '><span class="switch-track"><span class="switch-thumb"></span></span></label>'
          : '<span>' + (climOn ? nf(it.climateC, 1) + ' °C' : 'off') + '</span>') + '</div>';
      if (canEdit && climOn) {
        html += '<div class="ag-field" style="margin-top:0.45rem;"><span class="ag-lbl">' + (weekly ? 'Temperature (every week)' : 'Temperature') + '</span><select id="ag-climate">' + opts + '</select></div>';
      }
      html += '<div class="hint" style="margin:0.25rem 0 0; font-size:0.75rem;">' +
        (!it.climateOk ? 'Needs a car with the Škoda API as data source.'
          : it.climateOff ? 'Switched off for this time; the other weeks keep ' + nf(it.climateC, 1) + ' °C.'
          : !climOn ? (weekly ? 'Off. Switching it on sets it for every week.' : 'Off.')
          : cm === 'off' ? 'Climate at departure is off in the agenda settings.'
          : 'Starts ' + lead + ' min before you leave' + (it.leaveAt ? ' (' + tm(new Date(Date.parse(it.leaveAt) - lead * 60000).toISOString()) + ')' : '') + '.' + (cm === 'log' ? ' Log only: nothing is sent to the car yet (agenda settings).' : '') + (weekly ? ' Switching it off skips this time only.' : '')) +
        '</div>' +
        (canEdit && weekly && it.climateC != null ? '<div style="margin-top:0.25rem; font-size:0.8rem;"><a href="#" id="ag-clim-all">Switch off for every week</a></div>' : '') +
        (it.climateRun && it.climateRun.status !== 'off' ? '<div class="hint" style="margin:0.2rem 0 0; font-size:0.75rem;' + (it.climateRun.status === 'failed' ? ' color:var(--danger);' : '') + '">' + esc(it.climateRun.message || it.climateRun.status) + '</div>' : '') +
        '</div>';
    }
    html += '<p style="margin:0.6rem 0 0;"><a href="#" id="ag-close">Close</a></p></div>';
    el.innerHTML = html;
    var setTemp = function (v) {
      if (it.kind === 'trip') return post('/agenda/trips/' + it.id + '/climate.json', { climate_c: v });
      return post('/agenda/override.json', { calendar_id: it.calendar_id, uid: it.uid, start_at: it.occ || it.start, climate_c: v });
    };
    var skip = function (off) {
      return post('/agenda/climate-skip.json', { kind: it.kind, id: it.id, calendar_id: it.calendar_id, uid: it.uid, start: it.start, leave_at: it.leaveAt, title: it.title, target_c: it.climateC, off: off ? 1 : 0 });
    };
    var climOnEl = document.getElementById('ag-clim-on');
    if (climOnEl) climOnEl.onchange = function () {
      var weeklySet = it.kind === 'trip' && it.weekly && it.climateC != null;
      if (climOnEl.checked) (it.climateOff ? skip(false) : setTemp(lastTemp())).then(load);
      else (weeklySet ? skip(true) : setTemp('')).then(load);
    };
    var clim = document.getElementById('ag-climate');
    if (clim) clim.onchange = function () { try { localStorage.setItem('ag-climate-last', clim.value); } catch (e) {} setTemp(clim.value).then(load); };
    var climAll = document.getElementById('ag-clim-all');
    if (climAll) climAll.onclick = function (e) { e.preventDefault(); (it.climateOff ? skip(false) : Promise.resolve()).then(function () { return setTemp(''); }).then(load); };
    // this day or the whole series: shows (and from then on saves) the choices for that scope
    var scEl = document.getElementById('ag-sc');
    if (scEl) scEl.querySelectorAll('button').forEach(function (b) { b.onclick = function () { scopeOf[key(it)] = b.dataset.sc; renderDetail(); }; });
    var asScope = function (patch) {
      if (sc === 'series') scopeOf[key(it)] = 'series';
      return Object.assign({ calendar_id: it.calendar_id, uid: it.uid, start_at: it.occ || it.start }, patch, sc === 'series' ? { scope: 'series' } : {});
    };
    var post2 = function (patch) { return post('/agenda/override.json', asScope(patch)).then(load); };
    var onChips = function (id, fn) { var c = document.getElementById(id); if (c) c.querySelectorAll('button').forEach(function (b) { b.onclick = function () { if (!b.classList.contains('on')) fn(b.dataset.v); }; }); };
    onChips('ag-need', function (v) { post2({ needs_car: v }); });
    onChips('ag-car', function (v) { post2({ vehicle_id: v }); });
    onChips('ag-mode', function (v) { post2({ trip_mode: v }); });
    onChips('ag-cs', function (v) { post2({ chain_start: v }); });
    onChips('ag-ce', function (v) { post2({ chain_end: v }); });
    // ↺: back to the series (one day) or to automatic / the calendar text
    el.querySelectorAll('[data-reset]').forEach(function (a) { a.onclick = function (e) { e.preventDefault(); var p = {}; p[a.dataset.reset] = ''; post2(p); }; });
    // route options, for this address: each chip on or off; ↺ back to the default for all of them
    var rEl = document.getElementById('ag-route');
    if (rEl) rEl.querySelectorAll('button').forEach(function (b) { b.onclick = function () { var p = { location: it.location }; p[b.dataset.c] = !b.classList.contains('on'); b.disabled = true; post('/agenda/route.json', p).then(load); }; });
    var rReset = document.getElementById('ag-route-reset');
    if (rReset) rReset.onclick = function (e) { e.preventDefault(); var p = { location: it.location }; (data.routeClasses || []).forEach(function (c) { p[c] = null; }); post('/agenda/route.json', p).then(load); };
    var own = document.getElementById('ag-own-save');
    if (own) own.onclick = function () { post('/agenda/override.json', { calendar_id: it.calendar_id, uid: it.uid, start_at: it.occ || it.start, own_value: document.getElementById('ag-own').value }).then(load); };
    var dist = document.getElementById('ag-dist');
    var lookUp = function (force) { if (!dist) return; dist.disabled = true; dist.textContent = 'Looking up…'; post('/agenda/distance.json', { location: it.location, force: force }).then(load); };
    if (dist) dist.onclick = function () { lookUp(true); };
    // an address without a distance: look it up straight away (once per address on this page)
    if (dist && !it.geoError && !distTried[it.location]) { distTried[it.location] = true; lookUp(false); }
    document.getElementById('ag-close').onclick = function (e) { e.preventDefault(); selected = null; render(); };
  }

  var tf = document.getElementById('ag-trip-form');
  if (tf) tf.addEventListener('submit', function () {
    var dep = document.getElementById('ag-dep').value; var ret = document.getElementById('ag-ret').value;
    tf.depart_at.value = dep ? new Date(dep).toISOString() : '';
    tf.return_at.value = ret ? new Date(ret).toISOString() : '';
  });
  load();
  setInterval(load, 5 * 60 * 1000);
})();
</script>

