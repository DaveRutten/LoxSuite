    bindDepartures(el, PX);
  }

  // A "ready" label: click = change it below the agenda; drag up or down = move this one day (5 minutes
  // a step) — saved on release.
  function bindDepartures(el, PX) {
    el.querySelectorAll('[data-dep]').forEach(function (h) {
      var date = h.dataset.dep;
      var l = (data.learned || []).find(function (x) { return x.date === date; });
      var line = h.parentNode;
      var startY = null, startTop = 0, moved = 0, base = l ? new Date(l.at) : null;
      h.addEventListener('pointerdown', function (ev) {
        if (!canEdit || !l) return;
        startY = ev.clientY; startTop = parseFloat(line.style.top) || 0; moved = 0;
        h.setPointerCapture(ev.pointerId);
        ev.preventDefault();
      });
      h.addEventListener('pointermove', function (ev) {
        if (startY === null) return;
        var dy = ev.clientY - startY;
        moved = Math.round(dy / PX * 12) * 5; // minutes, 5 at a time
        if (!moved) return;
        line.style.top = (startTop + moved / 60 * PX) + 'px';
        var t = new Date(base.getTime() + moved * 60000);
        h.firstChild.textContent = T('ready {0}', tm(t));
        line.style.borderTopStyle = 'solid';
      });
      var end = function () {
        if (startY === null) return;
        startY = null;
        if (moved) {
          var t = new Date(base.getTime() + moved * 60000);
          selected = 'dep|' + date;
          post('/agenda/departure.json', { date: date, scope: 'day', ready: String(t.getHours()).padStart(2, '0') + ':' + String(t.getMinutes()).padStart(2, '0') }).then(load);
        } else { selected = 'dep|' + date; render(); }
      };
      h.addEventListener('pointerup', end);
      h.addEventListener('pointercancel', function () { startY = null; render(); });
      if (!canEdit) h.addEventListener('click', function () { selected = 'dep|' + date; render(); });
    });
  }

  function renderMonth() {
    document.getElementById('ag-view').style.maxHeight = ''; document.getElementById('ag-view').style.overflowY = '';
    var r = range();
    var month = cursor.getMonth();
    var html = '<div style="display:grid; grid-template-columns:repeat(7, minmax(90px,1fr)); border-top:1px solid var(--border); border-left:1px solid var(--border); min-width:640px;">';
    DAYN.forEach(function (n) { html += '<div style="padding:4px 6px; font-size:12px; font-weight:600; border-right:1px solid var(--border); border-bottom:1px solid var(--border);">' + n + '</div>'; });
    for (var i = 0; i < 42; i++) {
      var day = addDays(r[0], i);
      var list = itemsOnDay(day);
      var kwh = (data.sessions || []).filter(function (s) { return sameDay(new Date(s.connect_at), day); }).reduce(function (a, s) { return a + (s.kwh || 0); }, 0);
      var cell = '<div style="min-height:92px; padding:4px 5px; border-right:1px solid var(--border); border-bottom:1px solid var(--border); font-size:11px;' + (day.getMonth() !== month ? ' opacity:0.45;' : '') + (sameDay(day, new Date()) ? ' background:color-mix(in srgb, var(--accent) 8%, transparent);' : '') + '">' +
        '<div style="display:flex; justify-content:space-between;"><span style="font-weight:600;">' + (sameDay(day, new Date()) ? '<span class="ag-today-num">' + day.getDate() + '</span>' : day.getDate()) + '</span>' + (kwh ? '<span class="hint" style="margin:0;">⚡' + nf(kwh, 1) + '</span>' : '') + '</div>';
      list.slice(0, 3).forEach(function (it) { cell += '<div data-key="' + esc(key(it)) + '" style="margin-top:2px; padding:1px 4px; border-radius:4px; cursor:pointer; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; ' + (it.needsCar ? 'background:' + itemColor(it) + '; color:' + textOn(itemColor(it)) + ';' : 'background:color-mix(in srgb, ' + itemColor(it) + ' 15%, transparent);') + '">' + carSlot(it) + (it.allDay ? '' : tm(it.start) + ' ') + (it.needsCar && it.climateC != null && !it.climateOff ? '🌡️' : '') + esc(titleNoCar(it)) + '</div>'; });
      if (list.length > 3) cell += '<div class="hint" style="margin:2px 0 0;">+' + (list.length - 3) + ' more</div>';
      html += cell + '</div>';
    }
    var el = document.getElementById('ag-view');
    el.innerHTML = html + '</div>';
    bindClicks(el);
  }

  function renderYear() {
    document.getElementById('ag-view').style.maxHeight = ''; document.getElementById('ag-view').style.overflowY = '';
    var year = cursor.getFullYear();
    var kwhByDay = {};
    (data.sessions || []).forEach(function (s) { var k = startOfDay(new Date(s.connect_at)).toDateString(); kwhByDay[k] = (kwhByDay[k] || 0) + (s.kwh || 0); });
    var carDays = {};
    (data.items || []).forEach(function (i) { if (i.needsCar) carDays[startOfDay(new Date(i.start)).toDateString()] = true; });
    var html = '<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(190px,1fr)); gap:1rem;">';
    for (var m = 0; m < 12; m++) {
      var first = new Date(year, m, 1);
      var g = startOfWeek(first);
      var mh = '<div><div style="font-weight:600; font-size:13px; margin-bottom:4px; cursor:pointer;" data-month="' + m + '">' + first.toLocaleDateString([], { month: 'long' }) + '</div><div style="display:grid; grid-template-columns:repeat(7, 1fr); gap:2px;">';
      for (var i = 0; i < 42; i++) {
        var d = addDays(g, i);
        if (d.getMonth() !== m) { mh += '<div></div>'; continue; }
        var k = kwhByDay[d.toDateString()] || 0;
        var a = Math.min(1, k / 20);
        mh += '<div title="' + d.toLocaleDateString() + (k ? ': ' + nf(k, 1) + ' kWh' : '') + '" style="aspect-ratio:1; border-radius:3px; font-size:10px; display:flex; align-items:center; justify-content:center; position:relative; background:' + (k ? 'color-mix(in srgb, var(--accent) ' + Math.round(15 + a * 70) + '%, transparent)' : 'color-mix(in srgb, currentColor 5%, transparent)') + ';' + (sameDay(d, new Date()) ? ' outline:2px solid #e5534b;' : '') + '">' + d.getDate() +
          (carDays[d.toDateString()] ? '<span style="position:absolute; left:50%; bottom:2px; width:4px; height:4px; margin-left:-2px; border-radius:50%; background:#e5534b;"></span>' : '') + '</div>';
      }
      html += mh + '</div></div>';
    }
    var el = document.getElementById('ag-view');
    el.innerHTML = html + '</div><p class="hint" style="margin:0.6rem 0 0;">Colour = kWh charged that day · red dot = car needed</p>';
    el.querySelectorAll('[data-month]').forEach(function (x) { x.onclick = function () { cursor = new Date(year, Number(x.dataset.month), 1); view = 'month'; load(); }; });
  }

  function key(i) { return i.kind + '|' + (i.calendar_id || i.id) + '|' + (i.uid || '') + '|' + i.start; }
  function bindClicks(el) { el.querySelectorAll('[data-key]').forEach(function (x) { x.onclick = function () { selected = x.dataset.key; render(); }; }); }

  function roleName(r) { return r === 'drop' ? 'drop off' : r === 'pick' ? 'pick up' : ''; }
  // One drive from home: when, the stops with the distance to each, and what it needs.
  function routeBlock(t) {
    var label = t.stops.length > 1 ? 'Route' : t.stops[0].role === 'drop' ? 'Drop off' : t.stops[0].role === 'pick' ? 'Pick up' : 'There and back';
    // a stop back at where the drive started is marked as such
