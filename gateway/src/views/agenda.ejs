    var now = l.source === 'day' ? (l.none ? T('this day: no departure (you)') : T('this day: ready {0} (you)', cur)) : l.source === 'own' ? (l.none ? T('every {0}: no departure (you)', wdName) : T('every {0}: ready {1} (you)', wdName, l.weekdayReady)) : T('ready {0} (learned)', cur);
    var canBack = sc === 'day' ? l.source === 'day' : !!l.weekdayReady;
