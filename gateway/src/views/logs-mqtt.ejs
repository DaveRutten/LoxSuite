<%- include('partials/head', { pageTitle: 'Logs', active: 'logs-mqtt', refresh: 5, liveSwap: true }) %>

<div class="tabs">
  <a class="active" href="/logs/mqtt">MQTT broker</a>
  <% if (canView('logs_loxone')) { %><a href="/logs/loxone">Loxone Miniservers</a><% } %>
  <% if (canView('logs_loxone_commands')) { %><a href="/logs/loxone-commands">Loxone commands</a><% } %>
  <% if (canView('logs_system')) { %><a href="/logs/system">System</a><% } %>
</div>

<p class="hint">
  Raw lines from the Mosquitto broker's own log file, newest first, refreshing every 5 seconds.
  Persisted in SQLite and kept for <strong><%= retentionDays %></strong> days &mdash;
  <% if (canEdit('settings')) { %><a href="/settings">change that in Settings</a><% } else { %>change that in Settings<% } %>.
  <strong>Level</strong> is a best-effort guess from each line's wording (Mosquitto doesn't tag
  lines with a severity itself) &mdash; not a guarantee.
</p>

<form method="get" action="/logs/mqtt" class="form-grid" style="margin-bottom:1rem; align-items:end;">
  <div>
    <label>From</label>
    <input type="datetime-local" name="from" value="<%= query.from || '' %>">
  </div>
  <div>
    <label>To</label>
    <input type="datetime-local" name="to" value="<%= query.to || '' %>">
  </div>
  <div>
    <label>Level</label>
    <select name="level">
      <option value="" <%= !query.level ? 'selected' : '' %>>All</option>
      <option value="error" <%= query.level === 'error' ? 'selected' : '' %>>Error</option>
      <option value="warning" <%= query.level === 'warning' ? 'selected' : '' %>>Warning</option>
      <option value="info" <%= query.level === 'info' ? 'selected' : '' %>>Info</option>
    </select>
  </div>
  <div>
    <label>Contains</label>
    <input type="text" name="q" value="<%= query.q || '' %>" placeholder="Search log text">
  </div>
  <div style="display:flex; gap:0.5rem;">
    <button type="submit" class="btn-soft"><%- icon('filter') %> Apply</button>
    <a href="/logs/mqtt"><button type="button" class="btn-soft">Clear</button></a>
  </div>
</form>

<div class="filterable-table-card">
  <div class="table-toolbar">
    <span class="log-selection-count hint" style="margin:0;"></span>
    <button type="button" class="btn-soft log-copy-selection" disabled><%- icon('copy') %> <span class="btn-label">Copy selection</span></button>
    <% if (canEdit('logs_mqtt')) { %>
    <a href="/logs/mqtt/export.txt"><button type="button" class="btn-soft"><%- icon('copy') %> Export .log</button></a>
    <% } %>
  </div>

  <div class="table-wrap">
  <table>
    <thead>
      <tr><th class="col-select" data-no-controls><input type="checkbox" class="log-select-all" title="Select all"></th><th>Time</th><th>Level</th><th>Line</th></tr>
    </thead>
    <tbody>
      <% rows.forEach(r => { %>
        <% const levelBadge = r.level === 'error' ? 'badge-off' : r.level === 'warning' ? 'badge-warning' : 'badge-neutral'; %>
        <tr>
          <td class="col-select"><input type="checkbox"></td>
          <td><%= formatDateTime(r.recordedAt) %></td>
          <td><span class="badge <%= levelBadge %>"><%= r.level %></span></td>
          <td class="log-line <%= r.level !== 'info' ? 'log-line-' + r.level : '' %>"><%= r.line %></td>
        </tr>
      <% }) %>
      <% if (rows.length === 0) { %>
        <tr><td colspan="4" class="empty">No log lines recorded yet.</td></tr>
      <% } %>
    </tbody>
  </table>
  </div>
</div>

<script src="/log-select.js" defer></script>
<%- include('partials/foot') %>
