<%- include('partials/head', { pageTitle: 'MQTT Users', active: 'mqtt-users' }) %>

<%- include('partials/tabs-mqtt-broker', { active: 'mqtt-users' }) %>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>
<% if (testResult) { %>
  <p class="hint" style="<%= testResult.ok ? 'color: var(--success);' : 'color: var(--danger);' %>">
    <% if (testResult.ok) { %>
      <%= t('Connection test for "') %><%= testResult.username %><%= t('" succeeded (') %><%= testResult.ms %> <%= t('ms).') %>
    <% } else { %>
      <%= t('Connection test for "') %><%= testResult.username %><%= t('" failed:') %> <%= testResult.error %>
    <% } %>
  </p>
<% } %>

<p class="hint">
  <%= t('Every device that connects to the broker (e.g. a Shelly) needs its own account here — the broker does not allow anonymous clients.') %> <strong><%= t('Last used') %></strong> <%= t('comes from the broker\'s own log and only covers activity since this gateway last started — a blank means no connection has been seen yet in that window, not necessarily that the account has never connected.') %> <strong><%= t('Permissions') %></strong> <%= t('shows what a user\'s role already grants (read-only here) plus that one user\'s own extra permissions on top of it — for the rare case where one device needs something beyond its role without changing that role for everyone else who has it.') %>
</p>

<% if (canEdit('mqtt_users')) { %>
<details class="add-panel">
  <summary><%= t('Add user') %></summary>
  <div class="add-panel-body">
    <form method="post" action="/mqtt-users">
      <div class="form-grid">
        <div><label><%= t('Username') %></label><input type="text" name="username" required></div>
        <div><label><%= t('Password') %></label><input type="password" name="password" required></div>
        <div>
          <label><%= t('Role') %></label>
          <select name="rolename">
            <% roles.forEach(r => { %>
              <option value="<%= r %>" <%= r === 'client' ? 'selected' : '' %>><%= r %></option>
            <% }) %>
          </select>
        </div>
        <% if (autoScopeDeviceRoles) { %>
        <div>
          <label><%= t('Device topic prefix') %> <span class="hint" style="margin:0;display:inline;"><%= t('(optional)') %></span></label>
          <input type="text" name="device_topic_prefix" placeholder="<%= t('shellies/shellydimmer-Toilet') %>">
          <p class="hint">
            <%= t('Filled in, this creates (or reuses) a role scoped to just') %> <code>&lt;prefix&gt;/#</code>
            <%= t('and assigns that instead of the Role picked above. Left blank, the Role above is used as-is.') %>
          </p>
        </div>
        <% } %>
        <button type="submit" class="primary"><%- icon('plus') %> <%= t('Add') %></button>
      </div>
    </form>
  </div>
</details>
<% } %>

<div class="table-wrap">
  <table>
    <thead>
      <tr><th><%= t('Username') %></th><th><%= t('Roles') %></th><th><%= t('Active connections') %></th><th><%= t('Last used') %></th><th><%= t('Actions') %></th></tr>
    </thead>
    <tbody>
      <% clients.forEach(c => { %>
        <% var ownAcls = (rolesByName[c.personalRoleName] || {}).acls || []; %>
        <% var inheritedAcls = (c.baseRoles || []).flatMap(r => ((rolesByName[r.rolename] || {}).acls || []).map(acl => ({ ...acl, fromRole: r.rolename }))); %>
        <tr>
          <td><%= c.username %></td>
          <td>
            <% if (!protectedUsernames.includes(c.username) && canEdit('mqtt_users')) { %>
              <form id="role-form-<%= c.username %>" method="post" action="/mqtt-users/<%= c.username %>/role" style="display:inline;">
                <input type="hidden" name="previous_roles" value="<%= (c.baseRoles || []).map(r => r.rolename).join(',') %>">
                <select name="rolename">
                  <% roles.forEach(r => { %>
                    <option value="<%= r %>" <%= (c.baseRoles || []).some(cr => cr.rolename === r) ? 'selected' : '' %>><%= r %></option>
                  <% }) %>
                </select>
              </form>
            <% } else { %>
              <%= (c.baseRoles || []).map(r => r.rolename).join(', ') || '-' %>
            <% } %>
          </td>
          <td><%= (c.connections || []).length %></td>
          <td>
            <% if (c.lastSeen && c.lastSeen.status === 'connected') { %>
              <span class="badge badge-live badge-ok"><%= t('Connected now') %></span>
            <% } else if (c.lastSeen) { %>
              <span class="badge badge-neutral"><%= formatDateTime(c.lastSeen.at) %></span>
            <% } else { %>
              <span class="badge badge-neutral"><%= t('Not seen yet') %></span>
            <% } %>
          </td>
          <td>
            <div class="row-actions">
              <% if (!protectedUsernames.includes(c.username)) { %>
                <button type="button" class="btn-edit" data-toggle-row="mqtt-perms-<%= c.username %>"><%- icon('edit') %> <%= t('Permissions') %><% if (ownAcls.length) { %> (<%= ownAcls.length %>)<% } %></button>
              <% } %>
              <% if (!protectedUsernames.includes(c.username) && canEdit('mqtt_users')) { %>
                <button type="submit" form="role-form-<%= c.username %>" class="btn-edit"><%- icon('edit') %> <%= t('Save role') %></button>
                <button type="button" class="btn-edit" data-toggle-row="mqtt-reset-pw-<%= c.username %>"><%- icon('edit') %> <%= t('Reset password') %></button>
                <form class="inline" method="post" action="/mqtt-users/<%= c.username %>/delete" data-confirm="<%= t('Delete this user?') %>">
                  <button type="submit" class="danger"><%- icon('trash') %> <%= t('Delete') %></button>
                </form>
              <% } %>
            </div>
          </td>
        </tr>
        <% if (!protectedUsernames.includes(c.username) && canEdit('mqtt_users')) { %>
        <tr class="expand-row" id="mqtt-reset-pw-<%= c.username %>">
          <td colspan="5">
            <form method="post" action="/mqtt-users/<%= c.username %>/password" style="display:flex; gap:0.6rem; align-items:center; flex-wrap:wrap;">
              <label style="margin:0; font-size:0.85rem; color:var(--text-muted);"><%= t('New password:') %></label>
              <input type="password" name="password" required style="max-width:14rem;">
              <button type="submit" class="btn-edit"><%- icon('edit') %> <%= t('Set password') %></button>
            </form>
          </td>
        </tr>
        <% } %>
        <% if (!protectedUsernames.includes(c.username)) { %>
        <tr class="expand-row" id="mqtt-perms-<%= c.username %>">
          <td colspan="5">
            <p class="hint" style="margin-top:0;">
              <%= t('Inherited from') %> <%= (c.baseRoles || []).map(r => r.rolename).join(', ') || 'its role' %> <%= t('(read-only here — edit on') %>
              <a href="/mqtt-roles"><%= t('MQTT Roles') %></a> <%= t('if this should change for everyone with that role):') %>
            </p>
            <div class="table-wrap">
              <table class="acl-table">
                <thead>
                  <tr><th><%= t('ACL type') %></th><th><%= t('Topic filter') %></th><th><%= t('Allow') %></th><th><%= t('From role') %></th></tr>
                </thead>
                <tbody>
                  <% inheritedAcls.forEach(acl => { %>
                    <tr>
                      <td><%= acl.acltype %></td>
                      <td><code><%= acl.topic %></code></td>
                      <td><span class="badge <%= acl.allow ? 'badge-ok' : 'badge-off' %>"><%= acl.allow ? 'Allow' : 'Deny' %></span></td>
                      <td><%= acl.fromRole %></td>
                    </tr>
                  <% }) %>
                  <% if (inheritedAcls.length === 0) { %>
                    <tr><td colspan="4" class="empty"><%= t('No ACLs inherited — this user\'s role currently grants no access.') %></td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>

            <p class="hint">
              <%= t('This user\'s own extra permissions, on top of the above — only') %> <%= c.username %> <%= t('gets these. A') %> <strong><%= t('Deny') %></strong> <%= t('above always wins over an') %> <strong><%= t('Allow') %></strong> <%= t('added here for the same topic, so this can only grant access the role above stays silent on, never re-open something the role explicitly denies:') %>
            </p>
            <div class="table-wrap">
              <table class="acl-table">
                <thead>
                  <tr><th><%= t('ACL type') %></th><th><%= t('Topic filter') %></th><th><%= t('Allow') %></th><th><%= t('Actions') %></th></tr>
                </thead>
                <tbody>
                  <% ownAcls.forEach((acl, i) => { %>
                    <% var editRowId = 'mqtt-perm-edit-' + c.username + '-' + i; %>
                    <tr>
                      <td><%= acl.acltype %></td>
                      <td><code><%= acl.topic %></code></td>
                      <td><span class="badge <%= acl.allow ? 'badge-ok' : 'badge-off' %>"><%= acl.allow ? 'Allow' : 'Deny' %></span></td>
                      <td>
                        <% if (canEdit('mqtt_users')) { %>
                        <div class="row-actions">
                          <button type="button" class="btn-edit" data-toggle-row="<%= editRowId %>"><%- icon('edit') %> <%= t('Edit') %></button>
                          <form class="inline" method="post" action="/mqtt-users/<%= c.username %>/acls/delete">
                            <input type="hidden" name="acltype" value="<%= acl.acltype %>">
                            <input type="hidden" name="topic" value="<%= acl.topic %>">
                            <button type="submit" class="danger"><%- icon('trash') %> <%= t('Remove') %></button>
                          </form>
                        </div>
                        <% } %>
                      </td>
                    </tr>
                    <% if (canEdit('mqtt_users')) { %>
                    <tr class="expand-row" id="<%= editRowId %>">
                      <td colspan="4">
                        <form method="post" action="/mqtt-users/<%= c.username %>/acls/edit" class="form-grid" style="gap:0.6rem;">
                          <input type="hidden" name="old_acltype" value="<%= acl.acltype %>">
                          <input type="hidden" name="old_topic" value="<%= acl.topic %>">
                          <div>
                            <label><%= t('ACL type') %></label>
                            <select name="acltype">
                              <% aclTypes.forEach(tt => { %>
                                <option value="<%= tt %>" <%= tt === acl.acltype ? 'selected' : '' %>><%= tt %></option>
                              <% }) %>
                            </select>
                          </div>
                          <div><label><%= t('Topic filter') %></label><input type="text" name="topic" value="<%= acl.topic %>" required></div>
                          <div>
                            <label><%= t('Effect') %></label>
                            <select name="allow">
                              <option value="1" <%= acl.allow ? 'selected' : '' %>><%= t('Allow') %></option>
                              <option value="0" <%= !acl.allow ? 'selected' : '' %>><%= t('Deny') %></option>
                            </select>
                          </div>
                          <button type="submit" class="btn-edit"><%- icon('edit') %> <%= t('Save') %></button>
                        </form>
                      </td>
                    </tr>
                    <% } %>
                  <% }) %>
                  <% if (ownAcls.length === 0) { %>
                    <tr><td colspan="4" class="empty"><%= t('No extra permissions yet.') %></td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>

            <% if (canEdit('mqtt_users')) { %>
            <form method="post" action="/mqtt-users/<%= c.username %>/acls">
              <div class="form-grid">
                <div>
                  <label><%= t('ACL type') %></label>
                  <select name="acltype">
                    <% aclTypes.forEach(tt => { %>
                      <option value="<%= tt %>"><%= tt %></option>
                    <% }) %>
                  </select>
                </div>
                <div><label><%= t('Topic filter') %></label><input type="text" name="topic" placeholder="<%= t('shared/broadcast/#') %>" required></div>
                <div>
                  <label><%= t('Effect') %></label>
                  <select name="allow">
                    <option value="1"><%= t('Allow') %></option>
                    <option value="0"><%= t('Deny') %></option>
                  </select>
                </div>
                <button type="submit" class="primary"><%- icon('plus') %> <%= t('Add permission') %></button>
              </div>
            </form>
            <% } %>
          </td>
        </tr>
        <% } %>
      <% }) %>
      <% if (clients.length === 0) { %>
        <tr><td colspan="5" class="empty"><%= t('No devices added yet.') %></td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('partials/foot') %>
