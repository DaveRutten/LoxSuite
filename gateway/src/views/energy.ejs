<%- include('partials/head', { pageTitle: 'Meters', active: 'energy' }) %>

<% if (error) { %><p class="error"><%= error %></p><% } %>
<% if (saved) { %><p class="hint" style="color: var(--success);"><%= t('Saved.') %></p><% } %>

<p class="hint">
  <%= t('The Loxone meters LoxSuite uses for smart charging and learning: the grid connection, the solar panels, the Wallbox and (if you have one) a home battery. Values come live from the Miniserver; every minute they are stored, and per hour they are rolled up into kWh. The house load is calculated: grid + solar − Wallbox − battery.') %>
</p>

<div class="card">
  <h2 style="margin-top:0;"><%= t('Now') %></h2>
  <div id="en-live" class="ls-tiles"><p class="hint" style="margin:0;"><%= t('Loading…') %></p></div>
</div>

<div class="card">
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
    <h2 style="margin:0;"><%= t('Per hour') %></h2>
    <div class="btn-row" style="margin:0;">
      <button type="button" class="btn-soft" id="en-prev">&lsaquo;</button>
      <strong id="en-day" style="min-width:8rem; text-align:center;"></strong>
      <button type="button" class="btn-soft" id="en-next">&rsaquo;</button>
    </div>
  </div>
  <div id="en-chart" style="margin-top:0.6rem;"></div>
  <div id="en-legend" class="hint" style="margin:0.3rem 0 0;"></div>
</div>

<% if (canEdit('energy')) { %>
<div class="card">
  <h2 style="margin-top:0;"><%= t('Meters') %></h2>
  <form method="post" action="/energy/meters">
    <table>
      <thead><tr><th><%= t('Role') %></th><th><%= t('Loxone control') %></th><th><%= t('Counts the other way') %></th><th><%= t('Stored') %></th></tr></thead>
      <tbody>
        <% roles.forEach(r => { const m = byRole[r.key] || {}; const cur = m.miniserver_id && m.control_uuid ? m.miniserver_id + '|' + m.control_uuid : ''; const c = counts[r.key]; %>
          <tr>
            <td><strong><%= r.label %></strong><% if (r.bidirectional) { %><div class="hint" style="margin:0; font-size:0.75rem;"><%= r.importLabel %> / <%= r.exportLabel %></div><% } %></td>
            <td>
              <select name="meter_<%= r.key %>">
                <option value=""><%= t('— none —') %></option>
                <% candidates.forEach(cd => { const val = cd.miniserverId + '|' + cd.uuid; const sel = cur ? cur === val : (!byRole[r.key] && cd.suggest === r.key); %>
                  <option value="<%= val %>" <%= sel ? 'selected' : '' %>><%= cd.name %> (<%= cd.type %><%= cd.bidirectional ? ', bidirectional' : '' %> &middot; <%= cd.miniserverName %>)<%= !byRole[r.key] && cd.suggest === r.key ? ' — suggested' : '' %></option>
                <% }) %>
              </select>
            </td>
            <td><%- toggleSwitch('invert_' + r.key, !!m.invert) %></td>
            <td class="hint"><%= c ? c.n + ' h since ' + formatDateTime(c.first) : '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <p class="hint" style="margin:0.5rem 0 0;">
      <%= t('Positive means: grid = import, solar = production, Wallbox = charging the car, battery = charging. Turn on') %>
      <em><%= t('Counts the other way') %></em> <%= t('for a meter that reports the opposite. Suggestions are based on the control\'s name and type.') %>
      <% if (counts.house) { %><%= t('House:') %> <%= counts.house.n %> <%= t('h stored.') %><% } %>
    </p>
    <div class="btn-row" style="margin-top:0.8rem;"><button type="submit" class="btn-edit"><%- icon('edit') %> <%= t('Save') %></button></div>
  </form>
</div>

<div class="card">
  <h2 style="margin-top:0;"><%= t('History from Loxone') %></h2>
  <p class="hint">
    <%= t('Reads the hourly kWh of the chosen meters from the Miniserver\'s own statistics, so the house profile and the solar correction don\'t start from zero. Hours LoxSuite measured itself are kept. Uses the Miniserver\'s MCP server: authorize it once under Miniservers → edit → AI Assistant.') %>
  </p>
  <div class="btn-row" style="align-items:flex-end;">
    <div><label><%= t('Days back') %></label><input type="number" id="en-import-days" value="90" min="1" max="400" style="width:7rem;"></div>
    <button type="button" class="btn-soft" id="en-import-btn"><%- icon('download') %> <%= t('Import') %></button>
  </div>
  <div id="en-import-result" class="hint" style="margin-top:0.5rem;"></div>
</div>
<% } %>

<% if (canEdit('monitor')) { %>
<div class="card">
  <details>
    <summary><strong><%= t('Use in Monitor, dashboards & Loxone') %></strong></summary>
    <p class="hint"><%= t('Published as retained MQTT topics') %> <code>loxsuite/energy/&lt;role&gt;/power_kw</code> and <code>…/today_kwh</code> <%= t('(also for the house).') %></p>
    <div id="en-monitor-picks" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(230px,1fr)); gap:0.3rem 1rem;">
      <% Object.entries(topics).forEach(([k, t]) => { %>
        <label style="display:flex; gap:0.4rem; align-items:center; font-weight:normal;"><input type="checkbox" value="<%= k %>" <%= ['house_power_kw', 'pv_power_kw', 'grid_power_kw', 'grid_today_kwh', 'grid_today_export_kwh'].includes(k) ? 'checked' : '' %>> <code style="font-size:0.75rem;"><%= t %></code></label>
      <% }) %>
    </div>
    <div class="btn-row" style="margin-top:0.6rem;"><button type="button" class="btn-soft" id="en-monitor-btn"><%- icon('plus') %> <%= t('Add to Monitor') %></button></div>
    <div id="en-monitor-result" class="hint" style="margin-top:0.4rem;"></div>
  </details>
</div>
<% } %>

<script>
(function () {
  var LABELS = { grid: 'Grid', pv: 'Solar', wallbox: 'Wallbox', battery: 'Battery', house: 'House' };
  // the colors of the whole energy part (style.css --en-*); grid import (bought) and export (fed in) the
  // same in the tile and the chart
  var COLORS = { pv: 'var(--en-solar)', house: 'var(--en-house)', wallbox: 'var(--en-car)', grid: 'var(--en-price)', battery: 'var(--en-battery)' };
  var IMPORT_COLOR = 'var(--en-import)', EXPORT_COLOR = 'var(--en-export)';
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function nf(v, d) { return v == null ? '—' : Number(v).toLocaleString(undefined, { minimumFractionDigits: d, maximumFractionDigits: d }); }
  // the value in text color; the series color as a short key next to the label
  function tile(label, value, sub, color, health) {
    var dot = health === 'failing' ? '<span style="color:var(--danger);" title="no data">●</span> ' : health === 'ok' ? '<span style="color:var(--success);">●</span> ' : '';
    var key = color ? '<span style="display:inline-block; width:0.9em; height:3px; border-radius:2px; vertical-align:0.25em; margin-right:0.35em; background:' + color + ';"></span>' : '';
    return '<div class="ls-tile"><div class="ls-tile-label">' + dot + key + esc(label) + '</div>' +
      '<div class="ls-tile-value">' + value + '</div>' + (sub ? '<div class="ls-tile-sub">' + sub + '</div>' : '') + '</div>';
  }
  function renderLive(d) {
    var el = document.getElementById('en-live');
    var roles = d.roles || {};
    var keys = Object.keys(roles);
    if (!keys.length) { el.innerHTML = '<p class="hint" style="margin:0;">No meters chosen yet.</p>'; return; }
    var t = d.today || {};
    var html = '';
    var TL = function (k) { return (window.LS_I18N && window.LS_I18N[k]) || k; };
    ['grid', 'pv', 'wallbox', 'battery'].forEach(function (k) {
      var r = roles[k];
      if (!r) return;
      var sub = '';
      var td = t[k];
      if (k === 'grid') {
        // import (from the grid) and export (to the grid) apart: today, this month
        sub = r.power_kw == null ? '' : '<strong>' + esc(TL(r.power_kw >= 0 ? 'importing now' : 'exporting now')) + '</strong>';
        var line = function (label, g) { return g ? '<div>' + esc(TL(label)) + ' <span style="color:' + IMPORT_COLOR + ';">▲</span> ' + nf(g.import_kwh, 1) + ' · <span style="color:' + EXPORT_COLOR + ';">▼</span> ' + nf(g.export_kwh, 1) + ' kWh</div>' : ''; };
        sub += line('today', td) + line('this month', (d.month || {}).grid);
      } else if (td) sub += (sub ? ' · ' : '') + 'today ' + nf(td.import_kwh, 1) + (td.export_kwh ? ' / ' + nf(td.export_kwh, 1) : '') + ' kWh';
      if (!r.found) sub = 'control not found on the Miniserver';
      html += tile(LABELS[k], nf(r.power_kw, 2) + ' <small>kW</small>', sub, COLORS[k], d.health[k]);
    });
    html += tile('House', nf(d.house_kw, 2) + ' <small>kW</small>', t.house ? 'today ' + nf(t.house.import_kwh, 1) + ' kWh' : 'calculated', COLORS.house);
    el.innerHTML = html;
  }
  function liveTick() { fetch('/energy/live.json').then(function (r) { return r.json(); }).then(renderLive).catch(function () {}); }
  liveTick();
  setInterval(liveTick, 10000);

  // Day chart: solar and house as lines; above zero what came from the grid (import) with the Wallbox in
  // front of it, below zero what went to the grid (export).
  var dayOffset = 0;
  function dayStr(off) { var d = new Date(Date.now() + off * 86400000); return d.toISOString().slice(0, 10); }
  var chartData = null;
  lsOnResize(function () { if (chartData) renderChart(chartData); });
  function renderChart(s) {
    chartData = s;
    var TL = function (k) { return (window.LS_I18N && window.LS_I18N[k]) || k; };
    var el = document.getElementById('en-chart');
    var W = lsChartW(el, 860), H = 170, left = 34, n = s.hours.length || 24, bw = (W - left - 10) / n;
    var all = [];
    Object.keys(s.series).forEach(function (k) { s.series[k].forEach(function (v) { if (v != null) all.push(v); }); });
    var imp = (s.series.grid || []).map(function (v) { return v || 0; });
    var ex = (s.exported.grid || []).map(function (v) { return v || 0; });
    var wb = (s.series.wallbox || []).map(function (v) { return v || 0; });
    var max = Math.max(1, Math.max.apply(null, all.concat([0])));
    var maxEx = Math.max.apply(null, ex.concat([0]));
    var zero = 14 + H * (max / (max + maxEx || 1));
    var scale = (zero - 14) / max;
    var hh = function (i) { return new Date(s.hours[i]).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }); };
    var cx = function (i) { return left + i * bw + bw / 2; };
    var C = window.LsChart;
    var svg = '<svg viewBox="0 0 ' + W + ' ' + (H + 40) + '" width="100%" style="display:block;">';
    var step = max > 6 ? 2 : max > 3 ? 1 : 0.5;
    for (var g = step; g <= max; g += step) {
      var gy = zero - g * scale;
      svg += C.hline(left, W - 5, gy) + '<text x="' + (left - 4) + '" y="' + (gy + 3) + '" text-anchor="end" font-size="9" fill="currentColor" opacity="0.55">' + g + '</text>';
    }
    for (var ge = step; ge <= maxEx; ge += step) {
      var gye = zero + ge * scale;
      svg += C.hline(left, W - 5, gye, 0.05) + '<text x="' + (left - 4) + '" y="' + (gye + 3) + '" text-anchor="end" font-size="9" fill="currentColor" opacity="0.45">−' + ge + '</text>';
    }
    // columns: what came from the grid (soft), the Wallbox's part in front of it, below zero what went to the grid
    var cw = Math.min(28, bw * 0.72), cw2 = Math.min(12, bw * 0.34);
    imp.forEach(function (v, i) { if (v > 0.005) svg += C.col(cx(i) - cw / 2, zero - v * scale, cw, v * scale, { color: IMPORT_COLOR, opacity: 0.32, r: 3 }); });
    wb.forEach(function (v, i) { if (v > 0.005) svg += C.col(cx(i) - cw2 / 2, zero - v * scale, cw2, v * scale, { color: COLORS.wallbox, opacity: 0.85, r: 3 }); });
    ex.forEach(function (v, i) { if (v > 0.005) svg += C.col(cx(i) - cw / 2, zero, cw, v * scale, { color: EXPORT_COLOR, opacity: 0.4, r: 3, down: true }); });
    // solar with a light wash, the house as a calm line
    var pts = function (arr) { var out = []; (arr || []).forEach(function (v, i) { if (v != null) out.push([cx(i), zero - v * scale]); }); return out; };
    var pv = pts(s.series.pv), house = pts(s.series.house);
    if (pv.length > 1) svg += C.wash(pv, zero, COLORS.pv, 0.26) + C.line(pv, COLORS.pv);
    if (house.length > 1) svg += C.line(house, COLORS.house, { opacity: 0.9 });
    svg += C.hline(left, W - 5, zero, 0.25);
    s.hours.forEach(function (h, i) { if (i % 3 === 0) svg += '<text x="' + cx(i) + '" y="' + (H + 36) + '" text-anchor="middle" font-size="10" fill="currentColor" opacity="0.6">' + new Date(h).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + '</text>'; });
    svg += '</svg>';
    el.innerHTML = all.length ? svg : '<p class="hint" style="margin:0;">No hourly data for this day yet.</p>';
    if (all.length) C.hover(el, {
      W: W, top: 8, bottom: H + 22, n: n, x: cx,
      title: function (i) { return hh(i) + '–' + new Date(Date.parse(s.hours[i]) + 3600000).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }); },
      rows: function (i) {
        var kwh = function (v) { return v == null ? '—' : nf(v, 2) + ' kWh'; };
        return [
          s.series.pv ? [TL(LABELS.pv), kwh(s.series.pv[i]), COLORS.pv] : null,
          s.series.house ? [TL(LABELS.house), kwh(s.series.house[i]), COLORS.house] : null,
          s.series.wallbox ? [TL(LABELS.wallbox), kwh(s.series.wallbox[i]), COLORS.wallbox] : null,
          [TL('Import from the grid'), kwh(imp[i]), IMPORT_COLOR],
          [TL('Export to the grid'), kwh(ex[i]), EXPORT_COLOR],
        ];
      },
    });
    var sum = function (a) { return (a || []).reduce(function (x, y) { return x + (y || 0); }, 0); };
    var item = function (color, kind, label, v) { return '<span style="white-space:nowrap;"><span style="display:inline-block; width:' + (kind === 'line' ? '0.9em;height:3px;border-radius:2px;vertical-align:0.25em' : '0.7em;height:0.7em;border-radius:2px;vertical-align:-0.05em') + '; background:' + color + ';"></span> <span>' + esc(label) + '</span> ' + nf(v, 1) + ' kWh</span>'; };
    document.getElementById('en-legend').innerHTML = [
      item(COLORS.pv, 'line', LABELS.pv, sum(s.series.pv)), item(COLORS.house, 'line', LABELS.house, sum(s.series.house)),
      item(COLORS.wallbox, 'box', LABELS.wallbox, sum(s.series.wallbox)),
      item(IMPORT_COLOR, 'box', TL('Import from the grid'), sum(imp)), item(EXPORT_COLOR, 'box', TL('Export to the grid'), sum(ex)),
    ].join(' &nbsp; ') + ' &nbsp;<span style="opacity:0.7;">(' + esc(TL('kWh per hour')) + ')</span>';
  }
  function loadDay() {
    var d = dayStr(dayOffset);
    document.getElementById('en-day').textContent = dayOffset === 0 ? 'Today' : dayOffset === -1 ? 'Yesterday' : new Date(d + 'T12:00:00').toLocaleDateString();
    document.getElementById('en-next').disabled = dayOffset >= 0;
    fetch('/energy/series.json?day=' + d).then(function (r) { return r.json(); }).then(renderChart).catch(function () {});
  }
  document.getElementById('en-prev').addEventListener('click', function () { dayOffset--; loadDay(); });
  document.getElementById('en-next').addEventListener('click', function () { if (dayOffset < 0) { dayOffset++; loadDay(); } });
  loadDay();
  setInterval(function () { if (dayOffset === 0) loadDay(); }, 300000);

  var imp = document.getElementById('en-import-btn');
  if (imp) imp.addEventListener('click', function () {
    var out = document.getElementById('en-import-result');
    imp.disabled = true;
    out.textContent = 'Reading statistics from the Miniserver… (can take a minute)';
    fetch('/energy/import.json', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ days: document.getElementById('en-import-days').value }) })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (!d.report || !d.report.length) { out.textContent = d.message || 'No meters chosen yet.'; return; }
        out.innerHTML = d.report.map(function (x) { return '<strong>' + esc(LABELS[x.role] || x.role) + ':</strong> ' + (x.ok ? x.hours + ' hours imported' : '<span style="color:var(--danger);">' + esc(x.message) + '</span>'); }).join('<br>');
        loadDay();
      })
      .catch(function (e) { out.textContent = e.message; })
      .finally(function () { imp.disabled = false; });
  });
  var monBtn = document.getElementById('en-monitor-btn');
  if (monBtn) monBtn.addEventListener('click', function () {
    var metrics = Array.prototype.slice.call(document.querySelectorAll('#en-monitor-picks input:checked')).map(function (c) { return c.value; });
    var out = document.getElementById('en-monitor-result');
    fetch('/energy/monitor', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ metrics: metrics }) })
      .then(function (r) { return r.json(); })
      .then(function (d) { out.innerHTML = !d.ok ? esc(d.message) : 'Added ' + d.created.length + ' monitor(s)' + (d.skipped.length ? ', ' + d.skipped.length + ' already existed' : '') + '. <a href="/monitor">Open Monitor</a>'; })
      .catch(function (e) { out.textContent = e.message; });
  });
})();
</script>

<%- include('partials/foot') %>
