<%- include('partials/head', { pageTitle: 'Meters', active: 'energy' }) %>

<% if (error) { %><p class="error"><%= error %></p><% } %>
<% if (saved) { %><p class="hint" style="color: var(--success);">Saved.</p><% } %>

<p class="hint">
  The Loxone meters LoxSuite uses for smart charging and learning: the grid connection, the solar panels, the Wallbox and
  (if you have one) a home battery. Values come live from the Miniserver; every minute they are stored, and per hour
  they are rolled up into kWh. The house load is calculated: grid + solar &minus; Wallbox &minus; battery.
</p>

<div class="card">
  <h2 style="margin-top:0;">Now</h2>
  <div id="en-live" style="display:flex; gap:0.7rem; flex-wrap:wrap;"><p class="hint" style="margin:0;">Loading&hellip;</p></div>
</div>

<div class="card">
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
    <h2 style="margin:0;">Per hour</h2>
    <div class="btn-row" style="margin:0;">
      <button type="button" class="btn-soft" id="en-prev">&lsaquo;</button>
      <strong id="en-day" style="min-width:8rem; text-align:center;"></strong>
      <button type="button" class="btn-soft" id="en-next">&rsaquo;</button>
    </div>
  </div>
  <div id="en-chart" style="margin-top:0.6rem;"></div>
  <div id="en-legend" class="hint" style="margin:0.3rem 0 0;"></div>
</div>

<% if (canEdit('energy')) { %>
<div class="card">
  <h2 style="margin-top:0;">Meters</h2>
  <form method="post" action="/energy/meters">
    <table>
      <thead><tr><th>Role</th><th>Loxone control</th><th>Counts the other way</th><th>Stored</th></tr></thead>
      <tbody>
        <% roles.forEach(r => { const m = byRole[r.key] || {}; const cur = m.miniserver_id && m.control_uuid ? m.miniserver_id + '|' + m.control_uuid : ''; const c = counts[r.key]; %>
          <tr>
            <td><strong><%= r.label %></strong><% if (r.bidirectional) { %><div class="hint" style="margin:0; font-size:0.75rem;"><%= r.importLabel %> / <%= r.exportLabel %></div><% } %></td>
            <td>
              <select name="meter_<%= r.key %>">
                <option value="">— none —</option>
                <% candidates.forEach(cd => { const val = cd.miniserverId + '|' + cd.uuid; const sel = cur ? cur === val : (!byRole[r.key] && cd.suggest === r.key); %>
                  <option value="<%= val %>" <%= sel ? 'selected' : '' %>><%= cd.name %> (<%= cd.type %><%= cd.bidirectional ? ', bidirectional' : '' %> &middot; <%= cd.miniserverName %>)<%= !byRole[r.key] && cd.suggest === r.key ? ' — suggested' : '' %></option>
                <% }) %>
              </select>
            </td>
            <td><%- toggleSwitch('invert_' + r.key, !!m.invert) %></td>
            <td class="hint"><%= c ? c.n + ' h since ' + formatDateTime(c.first) : '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <p class="hint" style="margin:0.5rem 0 0;">
      Positive means: grid = import, solar = production, Wallbox = charging the car, battery = charging. Turn on
      <em>Counts the other way</em> for a meter that reports the opposite. Suggestions are based on the control's name and type.
      <% if (counts.house) { %>House: <%= counts.house.n %> h stored.<% } %>
    </p>
    <div class="btn-row" style="margin-top:0.8rem;"><button type="submit" class="btn-edit"><%- icon('edit') %> Save</button></div>
  </form>
</div>

<div class="card">
  <h2 style="margin-top:0;">History from Loxone</h2>
  <p class="hint">
    Reads the hourly kWh of the chosen meters from the Miniserver's own statistics, so the house profile and the solar
    correction don't start from zero. Hours LoxSuite measured itself are kept. Uses the Miniserver's MCP server: authorize it
    once under Miniservers &rarr; edit &rarr; AI Assistant.
  </p>
  <div class="btn-row" style="align-items:flex-end;">
    <div><label>Days back</label><input type="number" id="en-import-days" value="90" min="1" max="400" style="width:7rem;"></div>
    <button type="button" class="btn-soft" id="en-import-btn"><%- icon('download') %> Import</button>
  </div>
  <div id="en-import-result" class="hint" style="margin-top:0.5rem;"></div>
</div>
<% } %>

<% if (canEdit('monitor')) { %>
<div class="card">
  <details>
    <summary><strong>Use in Monitor, dashboards &amp; Loxone</strong></summary>
    <p class="hint">Published as retained MQTT topics <code>loxsuite/energy/&lt;role&gt;/power_kw</code> and <code>…/today_kwh</code> (also for the house).</p>
    <div id="en-monitor-picks" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(230px,1fr)); gap:0.3rem 1rem;">
      <% Object.entries(topics).forEach(([k, t]) => { %>
        <label style="display:flex; gap:0.4rem; align-items:center; font-weight:normal;"><input type="checkbox" value="<%= k %>" <%= ['house_power_kw', 'pv_power_kw', 'grid_power_kw'].includes(k) ? 'checked' : '' %>> <code style="font-size:0.75rem;"><%= t %></code></label>
      <% }) %>
    </div>
    <div class="btn-row" style="margin-top:0.6rem;"><button type="button" class="btn-soft" id="en-monitor-btn"><%- icon('plus') %> Add to Monitor</button></div>
    <div id="en-monitor-result" class="hint" style="margin-top:0.4rem;"></div>
  </details>
</div>
<% } %>

<script>
(function () {
  var LABELS = { grid: 'Grid', pv: 'Solar', wallbox: 'Wallbox', battery: 'Battery', house: 'House' };
  var COLORS = { pv: '#d4a017', house: '#4a7bd0', wallbox: 'var(--accent, #5CA83F)', grid: '#8a94a3', battery: '#9b59b6' };
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function nf(v, d) { return v == null ? '—' : Number(v).toLocaleString(undefined, { minimumFractionDigits: d, maximumFractionDigits: d }); }
  function tile(label, value, sub, color, health) {
    var dot = health === 'failing' ? '<span style="color:var(--danger);" title="no data">●</span> ' : health === 'ok' ? '<span style="color:var(--success);">●</span> ' : '';
    return '<div style="flex:1; min-width:150px; border:1px solid var(--border); border-radius:10px; padding:0.6rem 0.8rem;">' +
      '<div class="hint" style="margin:0; font-size:0.72rem; text-transform:uppercase; letter-spacing:0.04em;">' + dot + esc(label) + '</div>' +
      '<div style="font-size:1.35rem; font-weight:700; color:' + color + ';">' + value + '</div>' + (sub ? '<div class="hint" style="margin:0; font-size:0.75rem;">' + sub + '</div>' : '') + '</div>';
  }
  function renderLive(d) {
    var el = document.getElementById('en-live');
    var roles = d.roles || {};
    var keys = Object.keys(roles);
    if (!keys.length) { el.innerHTML = '<p class="hint" style="margin:0;">No meters chosen yet.</p>'; return; }
    var t = d.today || {};
    var html = '';
    ['grid', 'pv', 'wallbox', 'battery'].forEach(function (k) {
      var r = roles[k];
      if (!r) return;
      var sub = '';
      if (k === 'grid') sub = r.power_kw == null ? '' : (r.power_kw >= 0 ? 'import' : 'export');
      var td = t[k];
      if (td) sub += (sub ? ' · ' : '') + 'today ' + nf(td.import_kwh, 1) + (td.export_kwh ? ' / ' + nf(td.export_kwh, 1) : '') + ' kWh';
      if (!r.found) sub = 'control not found on the Miniserver';
      html += tile(LABELS[k], nf(r.power_kw, 2) + ' <span style="font-size:0.8rem; font-weight:500;">kW</span>', sub, COLORS[k], d.health[k]);
    });
    html += tile('House', nf(d.house_kw, 2) + ' <span style="font-size:0.8rem; font-weight:500;">kW</span>', t.house ? 'today ' + nf(t.house.import_kwh, 1) + ' kWh' : 'calculated', COLORS.house);
    el.innerHTML = html;
  }
  function liveTick() { fetch('/energy/live.json').then(function (r) { return r.json(); }).then(renderLive).catch(function () {}); }
  liveTick();
  setInterval(liveTick, 10000);

  // Day chart: solar and house as lines, Wallbox as bars, grid export below zero.
  var dayOffset = 0;
  function dayStr(off) { var d = new Date(Date.now() + off * 86400000); return d.toISOString().slice(0, 10); }
  var chartData = null;
  lsOnResize(function () { if (chartData) renderChart(chartData); });
  function renderChart(s) {
    chartData = s;
    var W = lsChartW(document.getElementById('en-chart'), 860), H = 170, left = 34, n = s.hours.length || 24, bw = (W - left - 10) / n;
    var all = [];
    Object.keys(s.series).forEach(function (k) { s.series[k].forEach(function (v) { if (v != null) all.push(v); }); });
    var ex = (s.exported.grid || []).map(function (v) { return v || 0; });
    var max = Math.max(1, Math.max.apply(null, all.concat([0])));
    var maxEx = Math.max.apply(null, ex.concat([0]));
    var zero = 14 + H * (max / (max + maxEx || 1));
    var scale = (zero - 14) / max;
    var svg = '<svg viewBox="0 0 ' + W + ' ' + (H + 40) + '" width="100%" style="display:block;">';
    for (var g = 0; g <= max; g += max > 6 ? 2 : max > 3 ? 1 : 0.5) {
      var gy = zero - g * scale;
      svg += '<line x1="' + left + '" y1="' + gy + '" x2="' + (W - 5) + '" y2="' + gy + '" stroke="currentColor" opacity="0.08"/><text x="' + (left - 4) + '" y="' + (gy + 3) + '" text-anchor="end" font-size="9" fill="currentColor" opacity="0.55">' + g + '</text>';
    }
    (s.series.wallbox || []).forEach(function (v, i) { if (!v) return; svg += '<rect x="' + (left + i * bw + bw * 0.2) + '" y="' + (zero - v * scale) + '" width="' + (bw * 0.6) + '" height="' + (v * scale) + '" fill="' + COLORS.wallbox + '" opacity="0.8" rx="2"/>'; });
    ex.forEach(function (v, i) { if (!v) return; svg += '<rect x="' + (left + i * bw + bw * 0.2) + '" y="' + zero + '" width="' + (bw * 0.6) + '" height="' + (v * scale) + '" fill="#8a94a3" opacity="0.5" rx="2"/>'; });
    ['pv', 'house', 'grid'].forEach(function (k) {
      var arr = s.series[k];
      if (!arr) return;
      var pts = [];
      arr.forEach(function (v, i) { if (v != null) pts.push((left + i * bw + bw / 2).toFixed(1) + ',' + (zero - v * scale).toFixed(1)); });
      if (pts.length > 1) svg += '<polyline points="' + pts.join(' ') + '" fill="none" stroke="' + COLORS[k] + '" stroke-width="' + (k === 'grid' ? 1.2 : 2.2) + '"' + (k === 'grid' ? ' stroke-dasharray="4 3"' : '') + '/>';
    });
    svg += '<line x1="' + left + '" y1="' + zero + '" x2="' + (W - 5) + '" y2="' + zero + '" stroke="currentColor" opacity="0.3"/>';
    s.hours.forEach(function (h, i) { if (i % 3 === 0) svg += '<text x="' + (left + i * bw + bw / 2) + '" y="' + (H + 36) + '" text-anchor="middle" font-size="10" fill="currentColor" opacity="0.6">' + new Date(h).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + '</text>'; });
    svg += '</svg>';
    document.getElementById('en-chart').innerHTML = all.length ? svg : '<p class="hint" style="margin:0;">No hourly data for this day yet.</p>';
    var sum = function (a) { return (a || []).reduce(function (x, y) { return x + (y || 0); }, 0); };
    document.getElementById('en-legend').innerHTML = ['pv', 'house', 'wallbox', 'grid'].map(function (k) {
      return '<span style="color:' + COLORS[k] + '; font-weight:700;">' + (k === 'wallbox' ? '■' : k === 'grid' ? '┅' : '━') + '</span> ' + LABELS[k] + ' ' + nf(sum(s.series[k]), 1) + ' kWh';
    }).join(' &nbsp; ') + (maxEx ? ' &nbsp; <span style="opacity:0.6;">■</span> export ' + nf(sum(ex), 1) + ' kWh' : '') + ' &nbsp;(kWh per hour)';
  }
  function loadDay() {
    var d = dayStr(dayOffset);
    document.getElementById('en-day').textContent = dayOffset === 0 ? 'Today' : dayOffset === -1 ? 'Yesterday' : new Date(d + 'T12:00:00').toLocaleDateString();
    document.getElementById('en-next').disabled = dayOffset >= 0;
    fetch('/energy/series.json?day=' + d).then(function (r) { return r.json(); }).then(renderChart).catch(function () {});
  }
  document.getElementById('en-prev').addEventListener('click', function () { dayOffset--; loadDay(); });
  document.getElementById('en-next').addEventListener('click', function () { if (dayOffset < 0) { dayOffset++; loadDay(); } });
  loadDay();
  setInterval(function () { if (dayOffset === 0) loadDay(); }, 300000);

  var imp = document.getElementById('en-import-btn');
  if (imp) imp.addEventListener('click', function () {
    var out = document.getElementById('en-import-result');
    imp.disabled = true;
    out.textContent = 'Reading statistics from the Miniserver… (can take a minute)';
    fetch('/energy/import.json', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ days: document.getElementById('en-import-days').value }) })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (!d.report || !d.report.length) { out.textContent = d.message || 'No meters chosen yet.'; return; }
        out.innerHTML = d.report.map(function (x) { return '<strong>' + esc(LABELS[x.role] || x.role) + ':</strong> ' + (x.ok ? x.hours + ' hours imported' : '<span style="color:var(--danger);">' + esc(x.message) + '</span>'); }).join('<br>');
        loadDay();
      })
      .catch(function (e) { out.textContent = e.message; })
      .finally(function () { imp.disabled = false; });
  });
  var monBtn = document.getElementById('en-monitor-btn');
  if (monBtn) monBtn.addEventListener('click', function () {
    var metrics = Array.prototype.slice.call(document.querySelectorAll('#en-monitor-picks input:checked')).map(function (c) { return c.value; });
    var out = document.getElementById('en-monitor-result');
    fetch('/energy/monitor', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ metrics: metrics }) })
      .then(function (r) { return r.json(); })
      .then(function (d) { out.innerHTML = !d.ok ? esc(d.message) : 'Added ' + d.created.length + ' monitor(s)' + (d.skipped.length ? ', ' + d.skipped.length + ' already existed' : '') + '. <a href="/monitor">Open Monitor</a>'; })
      .catch(function (e) { out.textContent = e.message; });
  });
})();
</script>

<%- include('partials/foot') %>
