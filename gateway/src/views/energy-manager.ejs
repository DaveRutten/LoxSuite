<%- include('partials/head', { pageTitle: 'Energy manager', active: 'energymanager' }) %>

<% if (saved) { %><p class="hint" style="color: var(--success);"><%= t('Saved.') %></p><% } %>
<% if (error) { %><p class="error"><%= error %></p><% } %>

<p class="hint"><%= t('The other big consumers, planned together with the car from the prices, the solar forecast and your house load.') %></p>

<div class="card" data-card-key="now">
  <div>
    <h2 style="margin:0;"><%= t('Now') %></h2>
    <% if (canEdit('energy_manager')) { %><div class="btn-row" style="margin:0;"><button type="button" class="btn-soft" id="em-recalc"><%- icon('refresh') %> <%= t('Recalculate') %></button><button type="button" class="btn-soft" id="em-import"><%= t('Import 30 days from Loxone') %></button></div><% } %>
  </div>
  <p class="hint" id="em-status" style="margin:0.3rem 0 0;"></p>
  <div id="em-now" style="margin-top:0.6rem;"><p class="hint" style="margin:0;"><%= t('Loading…') %></p></div>
</div>

<div class="card" data-card-key="plan">
  <h2 style="margin-top:0;"><%= t('Plan') %> <span class="hint" id="em-plan-range" style="font-weight:400;"></span></h2>
  <div id="em-daytypes" style="margin:-0.3rem 0 0.5rem;"></div>
  <div id="em-plan"></div>
</div>

<div class="card" data-card-key="unknown">
  <h2 style="margin-top:0;"><%= t('Unknown consumers') %></h2>
  <p class="hint"><%= t('What the house uses beyond the known consumers, above its base load, coming back at about the same time. Give it a name so you know what it is — or add it as a consumer.') %></p>
  <div id="em-unknown"></div>
</div>

<div id="em-loads"></div>

<p class="hint" data-hint-keep><%= t('Consumers (their Loxone signals, priority and settings) and the car\'s priority are set under') %> <a href="/settings/energy#energy-manager"><%= t('Administration → Energy & charging') %></a>.</p>

<script>
(function () {
  var CAN = <%- JSON.stringify(canEdit('energy_manager')) %>;
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function nf(v, d) { return v == null ? '—' : Number(v).toLocaleString(undefined, { minimumFractionDigits: d, maximumFractionDigits: d }); }
  function eur(v, d) { return v == null ? '—' : '€ ' + nf(v, d == null ? 2 : d); }
  function hh(t) { return new Date(t).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }); }
  function dayLabel(d) { var p = d.split('-'); return new Date(+p[0], +p[1] - 1, +p[2]).toLocaleDateString(undefined, { weekday: 'short', day: 'numeric', month: 'short' }); }
  function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json(); }); }
  function val(sig) {
    if (sig.value == null) return '—';
    if (sig.unit === '1/0' || sig.unit === 'pulse') return Number(sig.value) ? '<strong style="color:var(--success);">1</strong>' : '0';
    return '<strong>' + esc(sig.value) + '</strong> ' + esc(sig.unit);
  }
  var last = null;
  var TLx = function (k) { return (window.LS_I18N && window.LS_I18N[k]) || k; };
  // on/off and status now, with how long already
  function stateHtml(lv) {
    if (!lv || (lv.on == null && lv.status == null)) return '<span class="hint">—</span>';
    var dot = '<span style="display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:4px; background:' + (lv.on ? 'var(--success, #4caf50)' : '#9aa5b1') + ';"></span>';
    var txt = lv.status != null ? (lv.label || lv.status) : (lv.on ? 'on' : 'off');
    var mins = lv.since ? Math.round((Date.now() - lv.since) / 60000) : null;
    if (lv.startAt && lv.startAt > Date.now() - 15 * 60000) return dot + '<strong>' + esc(txt) + '</strong><div class="hint" style="margin:0; font-size:0.75rem;">' + esc(TLx('starts at ~{0}').replace('{0}', hh(lv.startAt).slice(0, 5))) + '</div>';
    return dot + '<strong>' + esc(txt) + '</strong>' + (mins != null ? '<div class="hint" style="margin:0; font-size:0.75rem;">' + esc((window.LS_I18N && window.LS_I18N['in this state for {0}'] || 'in this state for {0}').replace('{0}', mins >= 60 ? Math.floor(mins / 60) + ' h ' + String(mins % 60).padStart(2, '0') : mins + ' min')) + '</div>' : '');
  }
  // the weather side: kWh against the temperature, and how fast the room / tank cools down
  function weatherHtml(l) {
    var w = l.weather, c = l.cooling, out = [];
    if (w && w.model) {
      if (w.model.usable) out.push(TLx('Weather: +{0} kWh per degree colder (fits {1}%)').replace('{0}', nf(w.model.b, 2)).replace('{1}', Math.round(w.model.r2 * 100)) + (w.todayC != null ? ' · ' + TLx('today {0} °C → ×{1}').replace('{0}', nf(w.todayC, 1)).replace('{1}', nf(w.factorToday, 2)) : ''));
      else if (w.model.days >= 3) out.push(TLx('Weather: no clear link with the temperature yet ({0} days)').replace('{0}', w.model.days));
    }
    if (c && c.k) {
      if (l.kind === 'heatpump') out.push(TLx('Cools down {0} °C per hour per 10 °C difference with outside').replace('{0}', nf(c.k * 10, 2)) + (c.holdH ? ' → ' + TLx('held off at most {0} h').replace('{0}', nf(c.holdH, 1)) : ''));
      else if (c.lossPerHourC != null) out.push(TLx('The tank loses about {0} °C per hour').replace('{0}', nf(c.lossPerHourC, 1)));
    }
    if (l.effective && l.effective.release_share != null && l.weather && l.weather.model && l.weather.model.usable) out.push(TLx('released in {0}% of the hours today').replace('{0}', Math.round(l.effective.release_share * 100)));
    return out.length ? '<p class="hint" style="margin:0 0 0.4rem;">' + out.map(esc).join('<br>') + '</p>' : '';
  }
  function progressHtml(p) {
    if (!p) return '';
    var t = p.overdue ? TLx('taking longer than usual') : TLx('about {0} min to go').replace('{0}', p.remainingMin) + (p.remainingKwh != null ? ', ' + nf(p.remainingKwh, 2) + ' kWh' : '');
    return '<div class="hint" style="margin:0; font-size:0.75rem;">' + esc(t) + ' (' + p.pct + '%)</div>';
  }
  function standbyHtml(l) {
    var lv = l.live, kwOn = l.learned && l.learned.kwOn;
    return lv && lv.on && lv.kw != null && kwOn && lv.kw < 0.15 * kwOn ? ' <span class="badge" title="' + esc(TLx('on, but using much less than when it runs')) + '">' + esc(TLx('standby')) + '</span>' : '';
  }
  function anomaliesHtml(lr) {
    var a = (lr && lr.anomalies) || [];
    return a.map(function (x) {
      var txt = x.kind === 'weather'
        ? TLx('Uses {0}% more than expected for this weather (last week {1} kWh/day, expected {2}) — worth a look (filter, defrosting, settings).').replace('{0}', Math.round((x.ratio - 1) * 100)).replace('{1}', nf(x.recent, 1)).replace('{2}', nf(x.expected, 1))
        : TLx('"{0}" draws {1}% more power than in the weeks before ({2} kW against {3} kW).').replace('{0}', x.status).replace('{1}', Math.round((x.ratio - 1) * 100)).replace('{2}', nf(x.recent, 2)).replace('{3}', nf(x.before, 2));
      return '<p class="hint" style="margin:0 0 0.4rem; color:var(--danger, #e5534b);">⚠ ' + esc(txt) + '</p>';
    }).join('');
  }
  function unknownHtml(d) {
    var el = document.getElementById('em-unknown');
    if (!el) return;
    var list = d.unknown || [];
    if (!list.length) { el.innerHTML = '<p class="hint" style="margin:0;">' + esc(TLx('Nothing recurring found beyond the known consumers (yet).')) + '</p>'; return; }
    el.innerHTML = '<div style="overflow-x:auto;"><table><thead><tr><th>' + esc(TLx('When')) + '</th><th>' + esc(TLx('Name')) + '</th></tr></thead><tbody>' + list.map(function (u) {
      return '<tr><td>' + esc(u.text) + '</td><td>' + (CAN ? '<div style="display:flex; gap:0.3rem;"><input type="text" value="' + esc(u.name || '') + '" placeholder="' + esc(TLx('e.g. oven, dryer')) + '" data-uname="' + esc(u.key) + '" style="max-width:14em;"><button type="button" class="btn-soft" data-usave="' + esc(u.key) + '">' + esc(TLx('Save')) + '</button></div>' : esc(u.name || '—')) + '</td></tr>';
    }).join('') + '</tbody></table></div>';
    Array.prototype.forEach.call(el.querySelectorAll('[data-usave]'), function (b) {
      b.addEventListener('click', function () { var inp = el.querySelector('[data-uname="' + b.dataset.usave + '"]'); post('/energy-manager/unknown.json', { key: b.dataset.usave, name: inp.value }).then(load); });
    });
  }
  function dayTypesHtml(d) {
    var el = document.getElementById('em-daytypes');
    if (!el) return;
    var map = d.dayTypes || {}, keys = Object.keys(map).sort().slice(0, 3);
    var col = { away: '#e67e22', holiday: '#9b59b6', home: '#16a085', weekend: '#7f8c8d', workday: '#4a7bd0' };
    el.innerHTML = keys.map(function (k) { var t = map[k].type, p = k.split('-'); return '<span class="chip" style="color:' + col[t] + ';">' + esc(new Date(+p[0], +p[1] - 1, +p[2]).toLocaleDateString(undefined, { weekday: 'short' })) + ' · ' + esc(TLx(t)) + '</span>'; }).join('') + '<a href="/settings/energy#day-types" class="hint" style="font-size:0.75rem;">' + esc(TLx('days away & holidays')) + '</a>';
  }
  function tile(label, value, sub, color) {
    return '<div class="ls-tile"><div class="ls-tile-label">' + esc(label) + '</div><div class="ls-tile-value"' + (color ? ' style="color:' + color + ';"' : '') + '>' + value + '</div>' + (sub ? '<div class="ls-tile-sub">' + sub + '</div>' : '') + '</div>';
  }
  function sum(list, k) { return list.reduce(function (a, x) { return a + (Number(x[k]) || 0); }, 0); }

  // The plan per hour. Price row: per quarter when the charts show quarters; an hour without a known
  // price (the plan uses the median then) is hatched. Tap (or click) an hour for its details below.
  var emSel = null;
  function planChart(d) {
    var el = document.getElementById('em-plan');
    if (!d.hours.length) { el.innerHTML = '<p class="hint" style="margin:0;">No plan yet (prices or solar forecast missing).</p>'; return; }
    // as far as the prices are known (until midnight, or tomorrow midnight once they are out around
    // 13:00) — beyond that the plan is only a guess with the median; at least 12 hours, at most 36
    var all = d.hours.filter(function (h) { return h.ms >= Math.floor(Date.now() / 3600000) * 3600000; }).slice(0, 36);
    var known = 0;
    all.forEach(function (h, i) { if (!h.estimated) known = i + 1; });
    var hrs = all.slice(0, Math.max(Math.min(12, all.length), known));
    var W = lsChartW(el, 900), left = 150, rowH = 22;
    var rg = document.getElementById('em-plan-range');
    if (rg && hrs.length) {
      var endMs = hrs[hrs.length - 1].ms + 3600000, endD = new Date(endMs);
      var endTxt = endD.getHours() === 0 && endD.getMinutes() === 0 ? new Date(endMs - 1).toLocaleDateString([], { weekday: 'short' }) + ' 24:00' : endD.toLocaleDateString([], { weekday: 'short' }) + ' ' + hh(endMs).slice(0, 5);
      rg.textContent = '· ' + TLx('until {0}').replace('{0}', endTxt) + (known >= hrs.length ? ' — ' + TLx('as far as the prices are known') : '');
    }
    var bw = (W - left - 6) / hrs.length;
    var quarters = d.quarters || [];
    var qOf = function (h) { return quarters.filter(function (q) { var a = Date.parse(q.start); return a >= h.ms && a < h.ms + 3600000; }); };
    var maxP = Math.max.apply(null, hrs.map(function (h) { return h.price || 0; }).concat(quarters.map(function (q) { return q.price || 0; })).concat([0.1]));
    var maxS = Math.max.apply(null, hrs.map(function (h) { return h.surplusKwh || 0; }).concat([1]));
    var rows = [{ label: 'Price', kind: 'price' }, { label: 'Solar surplus (forecast)', kind: 'solar' }, { label: 'Car (Smart charging)', kind: 'car' }];
    d.loads.forEach(function (l) { l.signals.forEach(function (s) { if (s.key === 'pause') return; rows.push({ label: l.name + ' · ' + s.key, load: l, sig: s }); }); });
    var H = rows.length * rowH + 22, s = '<svg viewBox="0 0 ' + W + ' ' + H + '" width="100%" style="display:block;">' +
      '<defs><pattern id="em-noprice" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="6" stroke="currentColor" stroke-width="2" opacity="0.35"/></pattern></defs>';
    rows.forEach(function (r, ri) {
      var y = ri * rowH;
      s += '<text x="0" y="' + (y + 15) + '" font-size="11" fill="currentColor" opacity="0.8">' + esc(r.label) + '</text>';
      hrs.forEach(function (h, i) {
        var x = left + i * bw, fill = null, op = 1, tip = hh(h.ms) + ' ';
        if (r.kind === 'price') {
          if (h.estimated) { s += '<rect x="' + (x + 0.5) + '" y="' + (y + 3) + '" width="' + Math.max(1, bw - 1) + '" height="' + (rowH - 6) + '" rx="2" fill="url(#em-noprice)" stroke="currentColor" stroke-opacity="0.3" stroke-dasharray="2 2"><title>' + esc(hh(h.ms) + ' ' + TLx('no price yet — planned with the median {0}').replace('{0}', '€ ' + nf(h.price, 3))) + '</title></rect>'; return; }
          var qs = qOf(h);
          if (qs.length > 1) {
            var qw = bw / qs.length;
            qs.forEach(function (q, qi) { s += '<rect x="' + (x + 0.5 + qi * qw) + '" y="' + (y + 3) + '" width="' + Math.max(0.5, qw - 0.6) + '" height="' + (rowH - 6) + '" rx="1" style="fill:var(--en-price);" opacity="' + (0.25 + 0.75 * (q.price || 0) / maxP) + '"><title>' + esc(hh(Date.parse(q.start)) + ' € ' + nf(q.price, 3)) + '</title></rect>'; });
            return;
          }
          fill = 'var(--en-price)'; op = 0.25 + 0.75 * (h.price || 0) / maxP; tip += '€ ' + nf(h.price, 3);
        }
        else if (r.kind === 'solar') { if (h.surplusKwh > 0.05) { fill = 'var(--en-solar)'; op = 0.2 + 0.8 * h.surplusKwh / maxS; } tip += nf(h.surplusKwh, 1) + ' kWh'; }
        else if (r.kind === 'car') { var k = d.carKwh[h.ms] || 0; if (k > 0.05) fill = 'var(--en-car)'; tip += nf(k, 1) + ' kWh'; }
        else {
          var p = r.load.plan.find(function (x) { return Date.parse(x.hour) === h.ms; });
          var v = p ? p.values[r.sig.key] : null;
          if (r.sig.unit === '°C') { if (v && Number(v) !== 0 && r.sig.key === 'correction') { fill = Number(v) > 0 ? '#e67e22' : '#3498db'; } else if (r.sig.key === 'setpoint' && v != null && p && p.values.now) fill = '#e67e22'; op = 0.8; }
          else if (Number(v)) fill = '#4caf50';
          tip += (v == null ? '—' : v + ' ' + r.sig.unit) + (p && p.reason ? ' — ' + p.reason : '');
        }
        s += '<rect x="' + (x + 0.5) + '" y="' + (y + 3) + '" width="' + Math.max(1, bw - 1) + '" height="' + (rowH - 6) + '" rx="2" style="fill:' + (fill || 'currentColor') + ';" opacity="' + (fill ? op : 0.06) + '"><title>' + esc(tip) + '</title></rect>';
      });
    });
    hrs.forEach(function (h, i) { if (new Date(h.ms).getHours() % 3 === 0) s += '<text x="' + (left + i * bw) + '" y="' + (H - 6) + '" font-size="10" fill="currentColor" opacity="0.6">' + hh(h.ms).slice(0, 5) + '</text>'; });
    // the chosen hour outlined, and one tap target per hour over all rows
    hrs.forEach(function (h, i) {
      var x = left + i * bw;
      if (emSel === h.ms) s += '<rect x="' + (x + 0.5) + '" y="1" width="' + Math.max(1, bw - 1) + '" height="' + (rows.length * rowH) + '" rx="3" fill="none" stroke="var(--accent)" stroke-width="2"/>';
      s += '<rect data-em-hour="' + h.ms + '" x="' + x + '" y="0" width="' + bw + '" height="' + (rows.length * rowH) + '" fill="transparent" style="cursor:pointer;"/>';
    });
    var hatch = '<span style="display:inline-block; width:0.9em; height:0.8em; vertical-align:-0.05em; background:repeating-linear-gradient(45deg, currentColor 0 1.5px, transparent 1.5px 5px); opacity:0.5;"></span>';
    el.innerHTML = s + '</svg><div class="hint" style="margin:0.3rem 0 0;"><span>Green = would be 1 (release / now / start). Orange = higher setpoint (pre-heat), blue = lower. Hover for the reason.</span> ' + hatch + ' <span>' + esc(TLx('no price yet (planned with the median)')) + '</span> · <span>' + esc(TLx('Tap an hour for the details.')) + '</span></div><div id="em-detail"></div>';
    Array.prototype.forEach.call(el.querySelectorAll('[data-em-hour]'), function (t) {
      t.addEventListener('click', function () { var ms = Number(t.getAttribute('data-em-hour')); emSel = emSel === ms ? null : ms; planChart(d); });
    });
    if (emSel !== null) {
      var h = hrs.find(function (x) { return x.ms === emSel; });
      if (h) document.getElementById('em-detail').innerHTML = hourDetail(d, h, rows, qOf(h)); else emSel = null;
    }
  }

  // Everything about one hour: price (per quarter), solar, car, and per consumer what it does and why.
  function hourDetail(d, h, rows, qs) {
    var day = new Date(h.ms).toLocaleDateString([], { weekday: 'short', day: 'numeric', month: 'short' });
    var tiles = '<div class="ls-tiles" style="margin-top:0.5rem;">' +
      tile(TLx('Price'), h.estimated ? '<span style="opacity:0.6;">€ ' + nf(h.price, 3) + '</span>' : '€ ' + nf(h.price, 3), h.estimated ? esc(TLx('no price yet — median')) : qs.length > 1 ? qs.map(function (q) { return esc(hh(Date.parse(q.start)).slice(0, 5)) + ' € ' + nf(q.price, 3); }).join('<br>') : '') +
      tile(TLx('Solar surplus (forecast)'), nf(h.surplusKwh, 1) + ' kWh') +
      tile(TLx('Car (Smart charging)'), nf(d.carKwh[h.ms] || 0, 1) + ' kWh') + '</div>';
    var list = '';
    rows.forEach(function (r) {
      if (!r.load) return;
      var p = r.load.plan.find(function (x) { return Date.parse(x.hour) === h.ms; });
      var v = p ? p.values[r.sig.key] : null;
      list += '<tr><td>' + esc(r.label) + '</td><td style="white-space:nowrap;">' + (v == null ? '—' : esc(v + ' ' + r.sig.unit)) + '</td><td class="hint">' + esc(p && p.reason ? p.reason : '') + '</td></tr>';
    });
    return '<div class="card" style="margin:0.6rem 0 0; padding:0.7rem 0.9rem;"><div style="display:flex; justify-content:space-between; align-items:center;"><strong>' + esc(day + ' ' + hh(h.ms).slice(0, 5) + '–' + hh(h.ms + 3600000).slice(0, 5)) + '</strong><a href="#" class="hint" id="em-detail-close">' + esc(TLx('Close')) + '</a></div>' + tiles +
      (list ? '<div style="overflow-x:auto;"><table style="width:100%; margin-top:0.5rem;"><tbody>' + list + '</tbody></table></div>' : '') + '</div>';
  }
  document.addEventListener('click', function (e) { if (e.target && e.target.id === 'em-detail-close') { e.preventDefault(); emSel = null; if (last) planChart(last); } });

  // Learned patterns: when it usually runs, how long, how much — and what usually follows what.
  function patternsHtml(l) {
    var h = '<h3 class="subhead">Patterns <span class="hint" style="font-weight:400;">(last 8 weeks, ' + l.patternDays + ' days measured' + (l.usePatterns ? '' : ' &mdash; not used in the plan') + ')</span></h3>';
    var list = (l.patterns || []).concat(l.follows || []);
    if (!list.length) h += '<p class="hint" style="margin:0;">' + (l.patternDays < 7 ? 'Not enough days measured yet (patterns appear after about a week).' : 'No clear pattern yet.') + '</p>';
    else h += '<ul style="margin:0 0 0.4rem; padding-left:1.1rem;">' + list.map(function (p) { return '<li>' + esc(p.text) + (CAN && p.key ? ' <a href="#" class="hint" data-ignore="' + esc(p.key) + '" data-load="' + l.id + '">' + esc(TLx('not right')) + '</a>' : '') + '</li>'; }).join('') + '</ul>';
    if (l.ignoredPatterns && CAN) h += '<p class="hint" style="margin:0 0 0.3rem;">' + esc(TLx('{0} pattern(s) left out by you').replace('{0}', l.ignoredPatterns)) + ' <a href="#" data-restore="' + l.id + '">' + esc(TLx('put back')) + '</a></p>';
    var ex = l.expected || [];
    if (ex.some(function (x) { return x.kwh > 0; })) h += '<div class="hint" style="margin:0.4rem 0 0.2rem; font-size:0.75rem;">Expected use, next 24 h (kWh per hour)</div><div class="em-expected" data-load="' + l.id + '"></div>';
    return h;
  }
  // the expected kWh per hour, drawn at the real width of the card (redrawn on resize)
  function drawExpected() {
    if (!last) return;
    Array.prototype.forEach.call(document.querySelectorAll('.em-expected'), function (el) {
      var l = last.loads.find(function (x) { return String(x.id) === el.dataset.load; });
      var ex = (l && l.expected) || [];
      if (!ex.length) return;
      var W = lsChartW(el, 600), H = 46, bw = W / ex.length, max = Math.max.apply(null, ex.map(function (x) { return x.kwh || 0; }).concat([0.01]));
      var C = window.LsChart, cx = function (i) { return i * bw + bw / 2; };
      var pts = ex.map(function (x, i) { return [cx(i), 3 + H - 3 - (x.kwh || 0) / max * (H - 6)]; });
      var svg = '<svg viewBox="0 0 ' + W + ' ' + (H + 14) + '" width="100%" style="display:block;">' + C.hline(0, W, H, 0.18) + C.wash(pts, H, 'var(--accent, #5CA83F)', 0.24) + C.line(pts, 'var(--accent, #5CA83F)');
      ex.forEach(function (x, i) {
        if (i % 3 === 0) svg += '<text x="' + cx(i) + '" y="' + (H + 11) + '" font-size="10" text-anchor="middle" fill="currentColor" opacity="0.6">' + String(new Date(x.ms).getHours()).padStart(2, '0') + '</text>';
      });
      el.innerHTML = svg + '</svg>';
      C.hover(el, { W: W, top: 2, bottom: H, n: ex.length, x: cx, title: function (i) { return hh(ex[i].ms); }, rows: function (i) { return [[TLx('expected'), nf(ex[i].kwh, 2) + ' kWh', 'var(--accent, #5CA83F)']]; } });
    });
  }
  function render(d) {
    last = d;
    var st = d.status || {};
    var TL = function (k) { return (window.LS_I18N && window.LS_I18N[k]) || k; };
    document.getElementById('em-status').textContent = d.planAt ? TL('plan {0}').replace('{0}', hh(d.planAt)) +
      (st.pvKw != null ? ' · ' + TL('solar now {0} kW (forecast {1} kW)').replace('{0}', nf(st.pvKw, 1)).replace('{1}', st.pvForecastKw != null ? nf(st.pvForecastKw, 1) : '—') : '') +
      (st.exportKw != null ? ' · ' + TL('feeding in now {0} kW').replace('{0}', nf(st.exportKw, 1)) : '') +
      (d.live && d.live.ratio != null && Math.abs(d.live.ratio - 1) > 0.15 ? ' · ' + TL('plan adjusted to the real values') : '') : '';
    if (!d.loads.length) { document.getElementById('em-now').innerHTML = '<p class="hint" style="margin:0;">No consumers yet &mdash; add one below.</p>'; }
    else document.getElementById('em-now').innerHTML = '<div style="overflow-x:auto;"><table><thead><tr><th>Consumer</th><th>State</th><th>Power now</th><th>Would send (virtual input = value)</th><th>Why</th></tr></thead><tbody>' + d.loads.map(function (l) {
      return '<tr><td><a href="/energy-manager/loads/' + l.id + '"><strong>' + esc(l.name) + '</strong></a><div class="hint" style="margin:0; font-size:0.75rem;">' + esc(l.kindLabel) + ' · prio ' + l.priority + '</div></td><td>' + stateHtml(l.live) + '</td><td>' + (l.live && l.live.kw != null ? nf(l.live.kw, 2) + ' kW' : (l.live && l.live.found === false ? '<span class="hint">not found</span>' : '—')) + (l.running ? ' <span class="badge">running</span>' : '') + standbyHtml(l) + progressHtml(l.progress) + '</td><td>' +
        l.signals.map(function (s) { return '<code>' + esc(s.vi) + '</code> = ' + val(s); }).join('<br>') + '</td><td class="hint">' + esc(l.reason || '') + '</td></tr>';
    }).join('') + '</tbody></table></div>';
    planChart(d);
    unknownHtml(d);
    dayTypesHtml(d);
    document.getElementById('em-loads').innerHTML = d.loads.map(function (l) {
      var lr = l.learned || {}, h = '<div class="card" data-card-key="load-' + l.id + '"><h2 style="margin-top:0;">' + esc(l.name) + '</h2><p class="hint" style="margin:-0.5rem 0 0.7rem;">' + esc(l.kindLabel) + ' · prio ' + l.priority + '</p>';
      var tiles = '';
      if (l.kind === 'appliance') {
        var runs = l.runs || [], saved = runs.reduce(function (a, r) { return a + (r.cost_eur != null && r.best_cost_eur != null ? r.cost_eur - r.best_cost_eur : 0); }, 0);
        tiles += tile('Learned', lr.runs ? nf(lr.kwh, 2) + ' <small>' + esc(TLx('kWh per run')) + '</small>' : '—', lr.runs ? TLx('{0} runs, typically {1} h').replace('{0}', lr.runs).replace('{1}', nf(lr.durationH, 1)) : TLx('no runs measured yet'));
        tiles += tile('Runs', String(runs.length), runs.length ? TLx('last one {0}').replace('{0}', esc(new Date(runs[0].start_at).toLocaleString([], { weekday: 'short', hour: '2-digit', minute: '2-digit' }))) : '');
        tiles += tile('Costs of these runs', eur(sum(runs, 'cost_eur')), nf(sum(runs, 'kwh'), 1) + ' kWh');
        tiles += tile('Could have saved', eur(saved), TLx('at the best start in hindsight'), saved > 0.01 ? 'var(--success)' : null);
      } else {
        var wk = (l.daily || []).slice(0, 7), kwh7 = sum(wk, 'kwh'), cost7 = sum(wk, 'cost'), pot = sum(l.daily || [], 'potential');
        var solar7 = kwh7 > 0 ? Math.round(wk.reduce(function (a, x) { return a + (x.solarShare == null ? 0 : x.solarShare * x.kwh); }, 0) / kwh7) : null;
        tiles += tile('Learned', lr.kwhPerDay != null ? nf(lr.kwhPerDay, 1) + ' <small>' + esc(TLx('kWh per day')) + '</small>' : '—', lr.kwPeak != null ? TLx('about {0} kW while running').replace('{0}', nf(lr.kwPeak, 1)) : TLx('no measurements yet'));
        tiles += tile('Last 7 days', nf(kwh7, 1) + ' <small>kWh</small>', eur(cost7) + (kwh7 > 0 ? ' · ' + eur(cost7 / kwh7, 3) + '/kWh' : ''));
        tiles += tile('From own solar', solar7 == null ? '—' : solar7 + '%', TLx('of the last 7 days'), null);
        tiles += tile('Could save', eur(pot), TLx('in 14 days, by running in the advised hours'), pot > 0.01 ? 'var(--success)' : null);
      }
      h += '<div class="ls-tiles">' + tiles + '</div>';
      var notes = weatherHtml(l) + anomaliesHtml(lr);
      if (lr.change && lr.change.changed) notes += '<p class="hint" style="margin:0 0 0.4rem; color:#b8860b;">' + esc(TLx('Use changed: last week {0} kWh/day against {1} before — LoxSuite now learns mostly from the last week.').replace('{0}', nf(lr.change.recent, 1)).replace('{1}', nf(lr.change.before, 1))) + '</p>';
      if (notes) h += '<div style="margin-top:0.7rem;">' + notes + '</div>';
      if (l.kind === 'appliance') {
        if (CAN) h += '<h3 class="subhead">' + esc(TLx('Plan the next run')) + '</h3><div class="btn-row" style="align-items:flex-end;"><div><label>Ready by</label><input type="datetime-local" id="em-ready-' + l.id + '"></div><div><label>Label</label><input type="text" id="em-label-' + l.id + '" placeholder="e.g. 40° wash"></div><button type="button" class="btn-edit" data-req="' + l.id + '">Plan the best start</button></div>';
        if (l.requests.length) h += '<ul style="margin:0.5rem 0;">' + l.requests.map(function (q) { return '<li>' + esc(q.label) + (q.expected ? ': usually ' + hh(q.usualStart) : ': ready by ' + esc(new Date(q.readyBy).toLocaleString())) + ' &rarr; <strong>' + (q.plannedStart ? 'start at ' + hh(q.plannedStart) : 'no start found') + '</strong>' + (q.plannedCost != null ? ' (' + eur(q.plannedCost) + ')' : '') + (CAN && q.id ? ' <a href="#" data-delreq="' + q.id + '">remove</a>' : '') + (q.expected ? ' <span class="badge">expected</span>' : '') + '</li>'; }).join('') + '</ul>';
      }
      h += patternsHtml(l);
      h += '<div class="btn-row" style="margin-top:0.9rem;"><a class="btn-soft" href="/energy-manager/loads/' + l.id + '">' + esc((window.LS_I18N && window.LS_I18N['Details →']) || 'Details →') + '</a></div>';
      return h + '</div>';
    }).join('');
    drawExpected();
    Array.prototype.forEach.call(document.querySelectorAll('[data-req]'), function (b) {
      b.addEventListener('click', function () {
        var id = b.dataset.req, v = document.getElementById('em-ready-' + id).value;
        post('/energy-manager/loads/' + id + '/request.json', { readyBy: v ? new Date(v).toISOString() : '', label: document.getElementById('em-label-' + id).value }).then(function (r) { if (!r.ok) alert(r.message); load(); });
      });
    });
    Array.prototype.forEach.call(document.querySelectorAll('[data-ignore]'), function (a) {
      a.addEventListener('click', function (e) { e.preventDefault(); post('/energy-manager/loads/' + a.dataset.load + '/patterns.json', { ignore: a.dataset.ignore }).then(function () { return post('/energy-manager/recalc.json'); }).then(load); });
    });
    Array.prototype.forEach.call(document.querySelectorAll('[data-restore]'), function (a) {
      a.addEventListener('click', function (e) { e.preventDefault(); post('/energy-manager/loads/' + a.dataset.restore + '/patterns.json', { restore: true }).then(function () { return post('/energy-manager/recalc.json'); }).then(load); });
    });
    Array.prototype.forEach.call(document.querySelectorAll('[data-delreq]'), function (a) {
      a.addEventListener('click', function (e) { e.preventDefault(); post('/energy-manager/requests/' + a.dataset.delreq + '/delete.json').then(load); });
    });
  }
  function load() { return fetch('/energy-manager/data.json').then(function (r) { return r.json(); }).then(render); }
  var rc = document.getElementById('em-recalc');
  if (rc) rc.addEventListener('click', function () { rc.disabled = true; post('/energy-manager/recalc.json').then(load).finally(function () { rc.disabled = false; }); });
  var im = document.getElementById('em-import');
  if (im) im.addEventListener('click', function () { im.disabled = true; im.textContent = 'Importing…'; post('/energy-manager/import.json', { days: 30 }).then(function (r) { im.textContent = r.ok ? r.report.map(function (x) { return x.load + ': ' + (x.ok ? x.hours + ' h' : x.message); }).join(' · ') : r.message; load(); }).finally(function () { im.disabled = false; }); });
  lsOnResize(function () { if (last) { planChart(last); drawExpected(); } });
  load();
  setInterval(load, 60000);
})();
</script>

<%- include('partials/foot') %>
