<%- include('partials/head', { pageTitle: 'Edit Miniserver', active: 'miniservers' }) %>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<% if (canEdit('miniservers')) { %>
<div class="card">
  <form method="post" action="/miniservers/<%= miniserver.id %>/update" id="edit-ms-form">
    <div class="form-grid">
      <div><label>Name</label><input type="text" name="name" value="<%= miniserver.name %>" required></div>
    </div>
    <div class="form-grid" style="margin-top:0.85rem;">
      <div><label>Host / IP</label><input type="text" name="host" value="<%= miniserver.host %>" required></div>
      <div><label>HTTP port</label><input type="number" name="http_port" value="<%= miniserver.http_port %>" required></div>
      <div>
        <label>HTTPS</label>
        <%- toggleSwitch('use_https', miniserver.use_https) %>
        <p class="hint" style="margin:0.3rem 0 0;">Self-signed certificates are allowed.</p>
      </div>
    </div>
    <div class="form-grid" style="margin-top:0.85rem;">
      <div><label>Username</label><input type="text" name="username" value="<%= miniserver.username %>" required></div>
      <div>
        <label>Password</label>
        <input type="password" name="password" placeholder="Leave blank to keep the current password">
      </div>
    </div>

    <h2 style="margin-top:1.5rem;">Features</h2>
    <div class="form-grid">
      <div><label>UDP port (optional)</label><input type="number" name="udp_port" value="<%= miniserver.udp_port || '' %>"></div>
      <div>
        <label>External URL (optional)</label>
        <input type="text" name="external_url" value="<%= miniserver.external_url || '' %>" placeholder="https://myhome.dyndns.org:8080">
      </div>
    </div>
    <p class="hint" style="margin-top:0.5rem;">
      <strong>UDP port</strong> is the port <em>on the Miniserver itself</em> that Loxone listens on
      for Virtual UDP Output commands sent by this gateway (configured in Loxone Config's Virtual
      UDP Output, not here) &mdash; purely outbound from the gateway's side, so nothing needs to
      change in <code>docker-compose.yml</code> for it. <strong>External URL</strong> is tried
      automatically whenever the local Host/IP can't be reached, so this Miniserver stays usable
      both at home and remotely.
    </p>

    <h2 style="margin-top:1.5rem;">Gateway Client setup (optional)</h2>
    <div class="form-grid">
      <div>
        <label>This Miniserver is a Client of another Gateway</label>
        <%- toggleSwitch('is_client', !!miniserver.gateway_client_of, { id: 'edit-ms-is-client' }) %>
      </div>
    </div>
    <div class="form-grid" style="margin-top:0.6rem;" id="edit-ms-gateway-of-wrap" <%= miniserver.gateway_client_of ? '' : 'hidden' %>>
      <div>
        <label>Gateway</label>
        <select name="gateway_client_of">
          <% otherMiniservers.forEach(ms => { %>
            <option value="<%= ms.id %>" <%= miniserver.gateway_client_of === ms.id ? 'selected' : '' %>><%= ms.name %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <p class="hint" style="margin-top:0.5rem;">
      Turn this on when this Miniserver is a
      <a href="https://www.loxone.com/enen/kb/gateway-client/" target="_blank" rel="noopener">Gateway Client</a>
      of another one &mdash; a Client shares its Gateway's own merged Loxone Config project rather
      than running a fully separate one of its own. One practical effect: a shared Audioserver and
      its Stereo Extensions can show up in both Miniservers' own hardware status. The
      <a href="/hardware">Hardware page</a> already drops that duplicate listing automatically
      (matched by Serial/MAC); turning this on just makes the Gateway/Client relationship itself
      explicit, and prefers keeping the Gateway's own copy over the Client's.
    </p>

    <%
      // This lists Miniservers that are CLIENTS OF this one (this one acting as their Gateway) —
      // the mirror image of the "This Miniserver is a Client of another Gateway" toggle above, not
      // the same thing: a Client can't itself be a Gateway managing its own sub-Clients (Loxone's
      // own Gateway Client setup is a single Gateway managing its Clients directly, never a chain),
      // so this only ever makes sense while that toggle is OFF. Tied to the toggle's own live state
      // (see the JS below), not just the page's initial gateway_client_of value, so switching it on
      // mid-edit hides this immediately instead of leaving a client-of-another-gateway Miniserver
      // still offering to manage clients of its own.
    %>
    <div id="edit-ms-clients-section" <%= miniserver.gateway_client_of ? 'hidden' : '' %>>
      <h2 style="margin-top:1.5rem;">Client Miniservers</h2>
      <p class="hint">
        Client Miniservers that share <strong><%= miniserver.name %></strong>'s own merged Loxone
        Config project (see the Gateway Client link above) &mdash; each reuses this Miniserver's own
        Username/Password, since Loxone requires identical credentials across the whole group.
        Removing a row here just unlinks it (it goes back to being a standalone Miniserver, still
        listed on the Miniservers page) rather than deleting it.
      </p>
      <div class="client-rows-header" <%= existingClients.length ? '' : 'hidden' %> id="edit-ms-clients-header">
        <div>Client Name</div><div>Host / IP</div><div>HTTP port</div><div>HTTPS</div><div></div>
      </div>
      <div id="edit-ms-clients-list"></div>
      <button type="button" id="edit-ms-client-row-btn" class="btn-soft"><%- icon('plus') %> Add Client Miniserver</button>
      <input type="hidden" name="clients_json" id="edit-ms-clients-json">
    </div>

    <%
      // Result sits IN this same row as Test/Save (flex:1, filling the leftover space to their
      // left) rather than on its own line below — same "left-aligned, level with the buttons that
      // produced it" placement the row-actions popover's own merged Test result already uses.
    %>
    <div class="btn-row" style="margin-top:0.9rem;">
      <div id="edit-ms-test-result" style="flex:1; min-width:0;"></div>
      <button type="button" id="edit-ms-test-btn" class="btn-test"><%- icon('refresh') %> Test</button>
      <button type="submit" class="btn-edit"><%- icon('edit') %> Save</button>
    </div>
  </form>
</div>
<% } else { %>
  <p class="hint">Your Access Role doesn't have permission to edit Miniservers.</p>
<% } %>

<p><a href="/miniservers">&larr; Back to Miniservers</a></p>

<script>
  (function () {
    var btn = document.getElementById('edit-ms-test-btn');
    var wrap = document.getElementById('edit-ms-test-result');
    if (!btn || !wrap) return;

    // Same feedback style as the Miniservers table's own "Test now" — see that page's inline
    // script for the fuller comment on why each icon/color choice.
    function renderLine(label, result) {
      if (!result) return '';
      var color = result.ok ? 'var(--accent)' : 'var(--danger)';
      var iconSvg = result.ok
        ? '<svg class="icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>'
        : '<svg class="icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>';
      var detail = result.ok ? (result.ms + ' ms') : (result.error || 'failed');
      return '<div style="display:flex; align-items:center; gap:0.4rem; color:' + color + ';">' + iconSvg
        + '<strong style="color:var(--text);">' + label + '</strong><span>' + detail + '</span></div>';
    }

    btn.addEventListener('click', function () {
      // Disabling the button itself (not just swapping the result text below) is the feedback
      // that's actually noticed the instant you click — a local Miniserver often answers in well
      // under a second, so the "Testing…" hint further down could already be replaced by the real
      // result before your eye has even moved there.
      btn.disabled = true;
      wrap.innerHTML = '<p class="hint" style="margin:0;">Testing&hellip;</p>';
      // Tests the currently-SAVED credentials (not whatever's unsaved in the form fields above) —
      // save first if you just changed the host/port/etc. and want to test those new values.
      // Content-Type: application/json exempts this from the CSRF form-token check server-side
      // (see middleware/csrf.js).
      fetch('/miniservers/<%= miniserver.id %>/check', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var html = '<div style="display:flex; gap:1.5rem; flex-wrap:wrap; align-items:center; font-size:0.85rem;">';
          html += renderLine('Local', data.local);
          html += data.external ? renderLine('External', data.external) : '<div class="hint" style="margin:0;">External: not configured</div>';
          html += renderLine('Loxone API', data.api);
          html += renderLine('Logbook reachable', data.logbook);
          html += renderLine('Live data (websocket)', data.live);
          html += '</div>';
          wrap.innerHTML = html;
        })
        .catch(function () {
          wrap.innerHTML = '<p class="hint" style="margin:0; color:var(--danger);">Test failed to run.</p>';
        })
        .then(function () { btn.disabled = false; });
    });
  })();
</script>

<script>
  // Client Miniservers list — same clients_json approach as the Add-Miniserver form (see
  // miniservers.ejs's own copy of this pattern for the fuller comment on why), except rows here
  // can start out already carrying a real Miniserver id (an existing Client, pre-filled from the
  // server) instead of always starting blank.
  (function () {
    var form = document.querySelector('form[action="/miniservers/<%= miniserver.id %>/update"]');
    var clientsHeader = document.getElementById('edit-ms-clients-header');
    var clientsList = document.getElementById('edit-ms-clients-list');
    var addClientRowBtn = document.getElementById('edit-ms-client-row-btn');
    var clientsJsonInput = document.getElementById('edit-ms-clients-json');
    if (!form || !clientsList) return;
    var removeIconSvg = '<svg class="icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>';

    function makeClientRow(client) {
      client = client || {};
      var wrap = document.createElement('div');
      wrap.className = 'edit-ms-client-row';
      if (client.id) wrap.dataset.clientId = client.id;
      wrap.innerHTML =
        '<div class="client-row">' +
          '<input type="text" class="client-name" value="' + (client.name || '').replace(/"/g, '&quot;') + '" placeholder="e.g. Upstairs">' +
          '<input type="text" class="client-host" value="' + (client.host || '').replace(/"/g, '&quot;') + '" placeholder="Host / IP">' +
          '<input type="number" class="client-port" value="' + (client.http_port || 80) + '" placeholder="HTTP port">' +
          '<span><span class="client-https-label">HTTPS</span><label class="switch"><input type="checkbox" class="client-https"' + (client.use_https ? ' checked' : '') + '><span class="switch-track"><span class="switch-thumb"></span></span></label></span>' +
          '<button type="button" class="icon-btn icon-btn-danger remove-client-row-btn" title="Remove this Client">' + removeIconSvg + '</button>' +
        '</div>';
      wrap.querySelector('.remove-client-row-btn').addEventListener('click', function () { wrap.remove(); });
      return wrap;
    }

    <% existingClients.forEach(c => { %>
      clientsList.appendChild(makeClientRow(<%- JSON.stringify(c) %>));
    <% }) %>

    if (addClientRowBtn) {
      addClientRowBtn.addEventListener('click', function () {
        clientsHeader.hidden = false;
        clientsList.appendChild(makeClientRow());
      });
    }

    form.addEventListener('submit', function () {
      var clients = [];
      clientsList.querySelectorAll('.edit-ms-client-row').forEach(function (row) {
        var name = row.querySelector('.client-name').value.trim();
        var host = row.querySelector('.client-host').value.trim();
        if (!name || !host) return; // an empty/half-filled row is just skipped, not an error
        var entry = {
          name: name,
          host: host,
          http_port: Number(row.querySelector('.client-port').value) || 80,
          use_https: row.querySelector('.client-https').checked,
        };
        if (row.dataset.clientId) entry.id = Number(row.dataset.clientId);
        clients.push(entry);
      });
      clientsJsonInput.value = JSON.stringify(clients);
    });
  })();
</script>

<script>
  // "This Miniserver is a Client of another Gateway" toggle — reveals/hides the Gateway picker
  // below it, same progressive-disclosure pattern as the Add-Miniserver form's own "is a Gateway"
  // toggle. The select is disabled (not just hidden) while off, so an unchanged, still-hidden
  // selection can't get submitted by accident — a disabled field is left out of the POST body
  // entirely, which the server already treats the same as "not a Client of anything." The Client
  // Miniservers section further down goes the OPPOSITE way on this same toggle — it lists Clients
  // OF this one (this one as their Gateway), which only makes sense while this one ISN'T itself a
  // Client (a Client can't also be a Gateway managing its own sub-Clients) — was previously tied to
  // the same on/off direction as the Gateway picker, which meant turning "I'm a Client" ON left the
  // "manage my own Clients" section visible right alongside the picker for the Gateway you're a
  // Client of, backwards from what either toggle state actually means.
  (function () {
    var toggle = document.getElementById('edit-ms-is-client');
    var wrap = document.getElementById('edit-ms-gateway-of-wrap');
    var select = wrap ? wrap.querySelector('select[name="gateway_client_of"]') : null;
    var clientsSection = document.getElementById('edit-ms-clients-section');
    if (!toggle || !wrap || !select) return;
    select.disabled = !toggle.checked;
    toggle.addEventListener('change', function () {
      wrap.hidden = !toggle.checked;
      select.disabled = !toggle.checked;
      if (clientsSection) clientsSection.hidden = toggle.checked;
    });
  })();
</script>

<%- include('partials/foot') %>
