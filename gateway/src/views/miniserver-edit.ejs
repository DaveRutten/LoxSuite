<%- include('partials/head', { pageTitle: 'Edit Miniserver', active: 'miniservers' }) %>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>
<% if (saved) { %>
  <p class="hint" style="color: var(--success);"><%= t('Saved.') %></p>
<% } %>
<% if (authorized) { %>
  <p class="hint" style="color: var(--success);"><%= t('Authorized.') %></p>
<% } %>

<% if (canEdit('miniservers')) { %>
<div class="card">
  <form method="post" action="/miniservers/<%= miniserver.id %>/update" id="edit-ms-form">
    <div class="form-grid">
      <div><label><%= t('Name') %></label><input type="text" name="name" value="<%= miniserver.name %>" required></div>
    </div>
    <div class="form-grid" style="margin-top:0.85rem;">
      <div><label><%= t('Host / IP') %></label><input type="text" name="host" value="<%= miniserver.host %>" required></div>
      <div><label><%= t('HTTP port') %></label><input type="number" name="http_port" value="<%= miniserver.http_port %>" required></div>
      <div>
        <label><%= t('HTTPS') %></label>
        <%- toggleSwitch('use_https', miniserver.use_https) %>
        <p class="hint" style="margin:0.3rem 0 0;"><%= t('Self-signed certificates are allowed.') %></p>
      </div>
    </div>
    <div class="form-grid" style="margin-top:0.85rem;">
      <div><label><%= t('Username') %></label><input type="text" name="username" value="<%= miniserver.username %>" required></div>
      <div>
        <label><%= t('Password') %></label>
        <input type="password" name="password" placeholder="<%= t('Leave blank to keep the current password') %>">
      </div>
    </div>

    <h2 style="margin-top:1.5rem;"><%= t('Features') %></h2>
    <div class="form-grid">
      <div><label><%= t('UDP port (optional)') %></label><input type="number" name="udp_port" value="<%= miniserver.udp_port || '' %>"></div>
      <div>
        <label><%= t('External URL (optional)') %></label>
        <input type="text" name="external_url" value="<%= miniserver.external_url || '' %>" placeholder="https://myhome.dyndns.org:8080">
      </div>
    </div>
    <p class="hint" style="margin-top:0.5rem;">
      <strong><%= t('UDP port') %></strong> <%= t('is the port') %> <em><%= t('on the Miniserver itself') %></em> <%= t('that Loxone listens on for Virtual UDP Output commands sent by this gateway (configured in Loxone Config\'s Virtual UDP Output, not here) — purely outbound from the gateway\'s side, so nothing needs to change in') %> <code>docker-compose.yml</code> <%= t('for it.') %> <strong><%= t('External URL') %></strong> <%= t('is tried automatically whenever the local Host/IP can\'t be reached, so this Miniserver stays usable both at home and remotely.') %>
    </p>

    <h2 style="margin-top:1.5rem;"><%= t('Gateway Client setup (optional)') %></h2>
    <div class="form-grid">
      <div>
        <label><%= t('This Miniserver is a Client of another Gateway') %></label>
        <%- toggleSwitch('is_client', !!miniserver.gateway_client_of, { id: 'edit-ms-is-client' }) %>
      </div>
    </div>
    <div class="form-grid" style="margin-top:0.6rem;" id="edit-ms-gateway-of-wrap" <%= miniserver.gateway_client_of ? '' : 'hidden' %>>
      <div>
        <label><%= t('Gateway') %></label>
        <select name="gateway_client_of">
          <% otherMiniservers.forEach(ms => { %>
            <option value="<%= ms.id %>" <%= miniserver.gateway_client_of === ms.id ? 'selected' : '' %>><%= ms.name %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <p class="hint" style="margin-top:0.5rem;">
      <%= t('Turn this on when this Miniserver is a') %>
      <a href="https://www.loxone.com/enen/kb/gateway-client/" target="_blank" rel="noopener"><%= t('Gateway Client') %></a>
      <%= t('of another one — a Client shares its Gateway\'s own merged Loxone Config project rather than running a fully separate one of its own. One practical effect: a shared Audioserver and its Stereo Extensions can show up in both Miniservers\' own hardware status. The') %>
      <a href="/hardware"><%= t('Hardware page') %></a> <%= t('already drops that duplicate listing automatically (matched by Serial/MAC); turning this on just makes the Gateway/Client relationship itself explicit, and prefers keeping the Gateway\'s own copy over the Client\'s.') %>
    </p>

    <h2 style="margin-top:1.5rem;"><%= t('AI Assistant (optional)') %></h2>
    <div class="form-grid">
      <div>
        <label><%= t('Enabled for this Miniserver') %></label>
        <%- toggleSwitch('ai_enabled', miniserver.ai_enabled, { id: 'edit-ms-ai-enabled' }) %>
      </div>
    </div>
    <div class="form-grid" style="margin-top:0.6rem;" id="edit-ms-ai-properties-wrap" <%= miniserver.ai_enabled ? '' : 'hidden' %>>
      <div>
        <label><%= t('Allow the assistant to send commands') %></label>
        <%- toggleSwitch('ai_allow_write_commands', miniserver.ai_allow_write_commands) %>
      </div>
      <div>
        <label><%= t('MCP URL override (optional)') %></label>
        <input type="text" name="mcp_url" value="<%= miniserver.mcp_url || '' %>" placeholder="<%= t('Auto-detected from Host/IP + /mcp') %>">
      </div>
      <div>
        <label><%= t('MCP connection') %></label>
        <%
          // Button comes right after the label — same row as the sibling cells' own toggle/input —
          // with the status line below it, same "control, then a short line about it" order as
          // every other field here. Having the status text ABOVE the button (tried first) pushed
          // the button a line lower than the Allow-commands toggle and MCP URL fields beside it.
        %>
        <a href="/miniservers/<%= miniserver.id %>/mcp/authorize" class="btn-soft">
          <%- icon('refresh') %> <%= miniserver.mcp_access_token ? 'Re-authorize' : 'Authorize' %>
        </a>
        <% if (miniserver.mcp_access_token || miniserver.mcp_refresh_token || miniserver.mcp_oauth_client_id) { %>
          <%
            // Authorize/Re-authorize opportunistically tries to reuse whatever's already stored —
            // a refresh token, or even just a prior Dynamic Client Registration — before falling
            // back to a fresh login. If the Miniserver has invalidated any of that server-side
            // (revoked, rotated away by an overlapping request, or the registration itself expired)
            // that reuse attempt can error out rather than ever reaching the fallback, which looks
            // from here like the button "does nothing" — including a Miniserver that never even
            // finished authorizing (mcp_access_token still null) if it got as far as registering a
            // client before failing. This button skips all of that by wiping every stored credential
            // first, forcing a truly fresh login every time.
          %>
          <a href="/miniservers/<%= miniserver.id %>/mcp/restart-login" class="btn-soft">
            <%- icon('refresh') %> <%= t('Start new login') %>
          </a>
        <% } %>
        <%
          // Deliberately NOT a .hint — .hint is user-declutterable (body.panel-hints-hidden hides
          // every .hint inside #edit-ms-form, see style.css), which would make this status readout
          // disappear right along with it. This is a status, not supplementary help text, so it
          // stays visible regardless of that preference.
        %>
        <p style="margin:0.35rem 0 0; color:var(--text-muted); font-size:0.85rem;">
          <% if (miniserver.mcp_access_token) { %>
            <%= t('Authorized') %><% if (miniserver.mcp_authorized_by) { %> by <strong><%= miniserver.mcp_authorized_by %></strong><% } %>.
          <% } else { %>
            <%= t('Not yet authorized.') %>
          <% } %>
        </p>
      </div>
    </div>
    <p class="hint" style="margin-top:0.5rem;">
      <%= t('Requires the MCP Server plugin enabled in Loxone Config, and the global AI provider turned on under') %> <a href="/admin/ai"><%= t('Administration > AI Assistant') %></a><%= t('. Loxone recommends a separate, minimally-privileged Loxone user account dedicated to the assistant rather than reusing this Miniserver\'s own login above.') %> <strong><%= t('Allow the assistant to send commands') %></strong>
      <%= t('defaults off, independent of whatever Read/Write access that Loxone user itself has — leave it off for a read-only assistant that can only report on the installation.') %>
      <strong><%= t('Save first') %></strong> <%= t('if you just changed anything above — Authorize navigates away from this page without saving unsaved changes, same as Test below.') %>
      <strong><%= t('Authorize over HTTPS') %></strong><%= t(': Loxone\'s cloud rejects the login redirect unless you\'re visiting LoxSuite over HTTPS (or literally at http://localhost) — open this same page at') %> <code>https://&lt;this host&gt;:5583/...</code> <%= t('(self-signed; your browser will show a one-time certificate warning) before clicking Authorize/Re-authorize/Start new login.') %>
    </p>
    <% if (miniserver.mcp_last_error) { %>
      <%
        // Not a .hint either, same reasoning as the "Authorized by" status above — an error is
        // never something the declutter preference should be able to hide.
      %>
      <p style="margin-top:0.5rem; color:var(--danger); font-size:0.85rem;"><%= t('Last MCP connection error:') %> <%= miniserver.mcp_last_error %></p>
    <% } %>

    <%
      // This lists Miniservers that are CLIENTS OF this one (this one acting as their Gateway) —
      // the mirror image of the "This Miniserver is a Client of another Gateway" toggle above, not
      // the same thing: a Client can't itself be a Gateway managing its own sub-Clients (Loxone's
      // own Gateway Client setup is a single Gateway managing its Clients directly, never a chain),
      // so this only ever makes sense while that toggle is OFF. Tied to the toggle's own live state
      // (see the JS below), not just the page's initial gateway_client_of value, so switching it on
      // mid-edit hides this immediately instead of leaving a client-of-another-gateway Miniserver
      // still offering to manage clients of its own.
    %>
    <div id="edit-ms-clients-section" <%= miniserver.gateway_client_of ? 'hidden' : '' %>>
      <h2 style="margin-top:1.5rem;"><%= t('Client Miniservers') %></h2>
      <p class="hint">
        <%= t('Client Miniservers that share') %> <strong><%= miniserver.name %></strong><%= t('\'s own merged Loxone Config project (see the Gateway Client link above) — each reuses this Miniserver\'s own Username/Password, since Loxone requires identical credentials across the whole group. Removing a row here just unlinks it (it goes back to being a standalone Miniserver, still listed on the Miniservers page) rather than deleting it.') %>
      </p>
      <div class="client-rows-header" <%= existingClients.length ? '' : 'hidden' %> id="edit-ms-clients-header">
        <div><%= t('Client Name') %></div><div><%= t('Host / IP') %></div><div><%= t('HTTP port') %></div><div><%= t('HTTPS') %></div><div></div>
      </div>
      <div id="edit-ms-clients-list"></div>
      <button type="button" id="edit-ms-client-row-btn" class="btn-soft"><%- icon('plus') %> <%= t('Add Client Miniserver') %></button>
      <input type="hidden" name="clients_json" id="edit-ms-clients-json">
    </div>

    <%
      // Result sits IN this same row as Test/Save (flex:1, filling the leftover space to their
      // left) rather than on its own line below — same "left-aligned, level with the buttons that
      // produced it" placement the row-actions popover's own merged Test result already uses.
    %>
    <div class="btn-row" style="margin-top:0.9rem;">
      <div id="edit-ms-test-result" style="flex:1; min-width:0;"></div>
      <button type="button" id="edit-ms-test-btn" class="btn-test"><%- icon('refresh') %> <%= t('Test') %></button>
      <button type="submit" class="btn-edit"><%- icon('edit') %> <%= t('Save') %></button>
    </div>
  </form>
</div>

<%
  // The login code step (Multi-Factor Authentication, Loxone Config 17.3 — see loxoneWebSocket.js): shown when
  // the Miniserver asks for the 6-digit code it mailed, on load or after Test. Outside the form above, so Enter
  // in a box never saves the Miniserver.
  var codeStep = liveStatus && liveStatus.status === 'code_required' ? { status: liveStatus.status, error: liveStatus.error, otp: liveStatus.otp, tech: liveStatus.tech } : null;
%>
<div class="card login-code" id="edit-ms-login-code"<%= codeStep ? '' : ' hidden' %>>
  <div class="login-code-in">
    <h2><%= t('Login code') %></h2>
    <p class="login-code-message" id="login-code-message"></p>
    <%# Password managers are kept off these boxes: they offer LoxSuite's own authenticator code, not the Miniserver's. %>
    <div class="login-code-boxes" id="login-code-boxes" hidden>
      <% for (var i = 1; i <= 6; i++) { %><input type="text" inputmode="numeric" maxlength="6" autocomplete="off" data-bwignore data-1p-ignore data-lpignore="true" aria-label="<%= t('Digit {n}', { n: i }) %>"><% } %>
    </div>
    <p class="hint login-code-valid" id="login-code-valid"></p>
    <div class="btn-row">
      <button type="button" class="btn-test" id="login-code-submit" hidden><%- icon('check') %> <%= t('Log in') %></button>
      <button type="button" class="btn-soft" id="login-code-send"><%= t('Send login code') %></button>
    </div>
    <details class="login-code-tech" id="login-code-tech" hidden>
      <summary><%= t('Technical details') %></summary>
      <p class="hint mono" id="login-code-tech-text"></p>
      <p class="hint"><%= t('What the Miniserver answered, without password, code or token.') %></p>
    </details>
  </div>
  <ol class="login-code-how">
    <li><b><%= t('The Miniserver mails a code') %></b><span><%= t('to the e-mail address of the Loxone user {user}. No mail? Look in the spam folder, or send a new code: only the newest code counts.', { user: miniserver.username }) %></span></li>
    <li><b><%= t('You enter it here') %></b><span><%= t('LoxSuite logs in as soon as all six digits are in. A code is valid for 10 minutes.') %></span></li>
    <li><b><%= t('Then no code again') %></b><span><%= t('LoxSuite keeps a login token for this Miniserver, like the Loxone app, and renews it by itself. A new code is only needed when the Miniserver refuses that token, for example after the Loxone user\'s password changed.') %></span></li>
  </ol>
</div>

<script>
  (function () {
    var card = document.getElementById('edit-ms-login-code');
    if (!card) return;
    var msg = document.getElementById('login-code-message');
    var boxesWrap = document.getElementById('login-code-boxes');
    var boxes = Array.prototype.slice.call(boxesWrap.querySelectorAll('input'));
    var valid = document.getElementById('login-code-valid');
    var submitBtn = document.getElementById('login-code-submit');
    var sendBtn = document.getElementById('login-code-send');
    var tech = document.getElementById('login-code-tech');
    var techText = document.getElementById('login-code-tech-text');
    var testResult = document.getElementById('edit-ms-test-result');
    var base = '/miniservers/<%= miniserver.id %>/login-code';
    var resendTimer = null;
    var busy = false;

    function timeOf(iso) { return new Date(iso).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }); }

    // state: the live connection's status ({ status, error, otp, tech }) — from the page, Test, or a code login.
    function render(state) {
      if (!state || state.status !== 'code_required') { card.hidden = true; return; }
      card.hidden = false;
      var otp = state.otp || {};
      var now = Date.now();
      var waiting = !!(otp.sentAt && otp.until && new Date(otp.until).getTime() > now);
      msg.textContent = state.error || '';
      boxesWrap.hidden = !waiting;
      submitBtn.hidden = !waiting;
      if (waiting) valid.textContent = 'This code is valid until ' + timeOf(otp.until) + '.';
      else valid.textContent = otp.sentAt ? 'The code from the last mail has expired. Send a new code.' : '';
      sendBtn.textContent = otp.sentAt ? 'Send a new code' : 'Send login code';
      // Not before the Miniserver allows a new mail (resendIn).
      clearTimeout(resendTimer);
      resendTimer = null;
      var wait = otp.resendAt ? new Date(otp.resendAt).getTime() - now : 0;
      sendBtn.disabled = wait > 0;
      if (wait > 0) resendTimer = setTimeout(function () { resendTimer = null; sendBtn.disabled = busy; }, wait);
      tech.hidden = !state.tech;
      techText.textContent = state.tech || '';
      boxes.forEach(function (b) { b.value = ''; });
      if (waiting) boxes[0].focus();
    }

    function post(url, body) {
      busy = true;
      submitBtn.disabled = true;
      sendBtn.disabled = true;
      msg.textContent = body ? 'Checking the code…' : 'Asking the Miniserver for a new code…';
      // Content-Type: application/json exempts this from the CSRF form-token check (see middleware/csrf.js).
      return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) })
        .then(function (r) { return r.json(); })
        .then(function (state) {
          busy = false;
          if (state.status === 'open' && testResult) {
            // Not a .hint: those hide with the page's hints switched off (#edit-ms-form .hint).
            testResult.innerHTML = '<div style="font-size:0.85rem; color:var(--success);">Logged in. The live connection is open and needs no code again until the Miniserver refuses its login token.</div>';
          }
          render(state.status ? state : { status: 'code_required', error: state.error });
        })
        .catch(function () { busy = false; msg.textContent = 'The request failed to run. Try again.'; })
        .then(function () { submitBtn.disabled = false; if (!resendTimer) sendBtn.disabled = false; });
    }

    function code() { return boxes.map(function (b) { return b.value; }).join(''); }
    function submit() {
      if (busy || code().length !== boxes.length) return;
      post(base, { code: code() });
    }

    boxes.forEach(function (box, i) {
      box.addEventListener('input', function () {
        // Typed or pasted: digits only, spread over the boxes from here on; all six in logs in.
        var digits = box.value.replace(/\D/g, '');
        box.value = '';
        for (var j = 0; j < digits.length && i + j < boxes.length; j++) boxes[i + j].value = digits[j];
        if (digits.length) boxes[Math.min(i + digits.length, boxes.length - 1)].focus();
        if (code().length === boxes.length) submit();
      });
      box.addEventListener('keydown', function (e) {
        if (e.key === 'Backspace' && !box.value && i > 0) { boxes[i - 1].value = ''; boxes[i - 1].focus(); e.preventDefault(); }
        if (e.key === 'Enter') { e.preventDefault(); submit(); }
      });
    });
    submitBtn.addEventListener('click', submit);
    sendBtn.addEventListener('click', function () { if (!busy) post(base + '/send', null); });

    window.lsLoginCodeStep = render;
    render(<%- JSON.stringify(codeStep).replace(/</g, '\\u003c') %>);
  })();
</script>
<% } else { %>
  <p class="hint"><%= t('Your Access Role doesn\'t have permission to edit Miniservers.') %></p>
<% } %>

<p><a href="/miniservers"><%= t('← Back to Miniservers') %></a></p>

<script>
  (function () {
    var btn = document.getElementById('edit-ms-test-btn');
    var wrap = document.getElementById('edit-ms-test-result');
    if (!btn || !wrap) return;

    // Same feedback style as the Miniservers table's own "Test now" — see that page's inline
    // script for the fuller comment on why each icon/color choice.
    function renderLine(label, result) {
      if (!result) return '';
      var color = result.ok ? 'var(--accent)' : 'var(--danger)';
      var iconSvg = result.ok
        ? '<svg class="icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>'
        : '<svg class="icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>';
      var detail = result.ok ? (result.ms + ' ms') : (result.error || 'failed');
      return '<div style="display:flex; align-items:center; gap:0.4rem; color:' + color + ';">' + iconSvg
        + '<strong style="color:var(--text);">' + label + '</strong><span>' + detail + '</span></div>';
    }

    btn.addEventListener('click', function () {
      // Disabling the button itself (not just swapping the result text below) is the feedback
      // that's actually noticed the instant you click — a local Miniserver often answers in well
      // under a second, so the "Testing…" hint further down could already be replaced by the real
      // result before your eye has even moved there.
      btn.disabled = true;
      wrap.innerHTML = '<p class="hint" style="margin:0;">Testing&hellip;</p>';
      // Tests the currently-SAVED credentials (not whatever's unsaved in the form fields above) —
      // save first if you just changed the host/port/etc. and want to test those new values.
      // Content-Type: application/json exempts this from the CSRF form-token check server-side
      // (see middleware/csrf.js).
      fetch('/miniservers/<%= miniserver.id %>/check', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var html = '<div style="display:flex; gap:1.5rem; flex-wrap:wrap; align-items:center; font-size:0.85rem;">';
          html += renderLine('Local', data.local);
          html += data.external ? renderLine('External', data.external) : '<div class="hint" style="margin:0;">External: not configured</div>';
          html += renderLine('Loxone API', data.api);
          html += renderLine('Logbook reachable', data.logbook);
          html += renderLine('Live data (websocket)', data.live);
          // Only present at all when this Miniserver has AI Assistant enabled — see routes/
          // miniservers.js's own POST /:id/check, which sends null otherwise.
          html += data.mcp ? renderLine('AI Assistant (MCP)', data.mcp) : '';
          html += '</div>';
          wrap.innerHTML = html;
          // The Miniserver asks for its login code: the step below the form takes it from here.
          if (data.live && window.lsLoginCodeStep) window.lsLoginCodeStep(data.live);
        })
        .catch(function () {
          wrap.innerHTML = '<p class="hint" style="margin:0; color:var(--danger);">Test failed to run.</p>';
        })
        .then(function () { btn.disabled = false; });
    });
  })();
</script>

<script>
  // Client Miniservers list — same clients_json approach as the Add-Miniserver form (see
  // miniservers.ejs's own copy of this pattern for the fuller comment on why), except rows here
  // can start out already carrying a real Miniserver id (an existing Client, pre-filled from the
  // server) instead of always starting blank.
  (function () {
    var form = document.querySelector('form[action="/miniservers/<%= miniserver.id %>/update"]');
    var clientsHeader = document.getElementById('edit-ms-clients-header');
    var clientsList = document.getElementById('edit-ms-clients-list');
    var addClientRowBtn = document.getElementById('edit-ms-client-row-btn');
    var clientsJsonInput = document.getElementById('edit-ms-clients-json');
    if (!form || !clientsList) return;
    var removeIconSvg = '<svg class="icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>';

    function makeClientRow(client) {
      client = client || {};
      var wrap = document.createElement('div');
      wrap.className = 'edit-ms-client-row';
      if (client.id) wrap.dataset.clientId = client.id;
      wrap.innerHTML =
        '<div class="client-row">' +
          '<input type="text" class="client-name" value="' + (client.name || '').replace(/"/g, '&quot;') + '" placeholder="e.g. Upstairs">' +
          '<input type="text" class="client-host" value="' + (client.host || '').replace(/"/g, '&quot;') + '" placeholder="Host / IP">' +
          '<input type="number" class="client-port" value="' + (client.http_port || 80) + '" placeholder="HTTP port">' +
          '<span><span class="client-https-label">HTTPS</span><label class="switch"><input type="checkbox" class="client-https"' + (client.use_https ? ' checked' : '') + '><span class="switch-track"><span class="switch-thumb"></span></span></label></span>' +
          '<button type="button" class="icon-btn icon-btn-danger remove-client-row-btn" title="Remove this Client">' + removeIconSvg + '</button>' +
        '</div>';
      wrap.querySelector('.remove-client-row-btn').addEventListener('click', function () { wrap.remove(); });
      return wrap;
    }

    <% existingClients.forEach(c => { %>
      clientsList.appendChild(makeClientRow(<%- JSON.stringify(c) %>));
    <% }) %>

    if (addClientRowBtn) {
      addClientRowBtn.addEventListener('click', function () {
        clientsHeader.hidden = false;
        clientsList.appendChild(makeClientRow());
      });
    }

    form.addEventListener('submit', function () {
      var clients = [];
      clientsList.querySelectorAll('.edit-ms-client-row').forEach(function (row) {
        var name = row.querySelector('.client-name').value.trim();
        var host = row.querySelector('.client-host').value.trim();
        if (!name || !host) return; // an empty/half-filled row is just skipped, not an error
        var entry = {
          name: name,
          host: host,
          http_port: Number(row.querySelector('.client-port').value) || 80,
          use_https: row.querySelector('.client-https').checked,
        };
        if (row.dataset.clientId) entry.id = Number(row.dataset.clientId);
        clients.push(entry);
      });
      clientsJsonInput.value = JSON.stringify(clients);
    });
  })();
</script>

<script>
  // "This Miniserver is a Client of another Gateway" toggle — reveals/hides the Gateway picker
  // below it, same progressive-disclosure pattern as the Add-Miniserver form's own "is a Gateway"
  // toggle. The select is disabled (not just hidden) while off, so an unchanged, still-hidden
  // selection can't get submitted by accident — a disabled field is left out of the POST body
  // entirely, which the server already treats the same as "not a Client of anything." The Client
  // Miniservers section further down goes the OPPOSITE way on this same toggle — it lists Clients
  // OF this one (this one as their Gateway), which only makes sense while this one ISN'T itself a
  // Client (a Client can't also be a Gateway managing its own sub-Clients) — was previously tied to
  // the same on/off direction as the Gateway picker, which meant turning "I'm a Client" ON left the
  // "manage my own Clients" section visible right alongside the picker for the Gateway you're a
  // Client of, backwards from what either toggle state actually means.
  (function () {
    var toggle = document.getElementById('edit-ms-is-client');
    var wrap = document.getElementById('edit-ms-gateway-of-wrap');
    var select = wrap ? wrap.querySelector('select[name="gateway_client_of"]') : null;
    var clientsSection = document.getElementById('edit-ms-clients-section');
    if (!toggle || !wrap || !select) return;
    select.disabled = !toggle.checked;
    toggle.addEventListener('change', function () {
      wrap.hidden = !toggle.checked;
      select.disabled = !toggle.checked;
      if (clientsSection) clientsSection.hidden = toggle.checked;
    });
  })();
</script>

<script>
  (function () {
    var toggle = document.getElementById('edit-ms-ai-enabled');
    var wrap = document.getElementById('edit-ms-ai-properties-wrap');
    if (!toggle || !wrap) return;
    toggle.addEventListener('change', function () {
      wrap.hidden = !toggle.checked;
    });
  })();
</script>

