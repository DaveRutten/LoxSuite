<%- include('partials/head', { pageTitle: 'OCPP', active: 'ocpp' }) %>

<% if (error) { %><p class="error"><%= error %></p><% } %>

<p class="hint">
  <%= t('Reports a Loxone Wallbox to an OCPP 1.6 backend (for example Laadloon) as a charge point, using the live Wallbox data LoxSuite already receives from the Miniserver. Meant for setups where Loxone\'s own OCPP Server Connector can\'t be used, such as a Wallbox on a Gen 1 Client Miniserver. Start in') %> <strong><%= t('Dry run') %></strong><%= t(': it logs what it would send without connecting to the backend. Each bridge page also has a') %> <strong><%= t('quarterly export') %></strong> <%= t('(Excel/CSV) of all charging sessions.') %>
</p>

<div class="card">
  <% if (!bridges.length) { %>
    <p class="hint" style="margin:0;"><%= t('No OCPP bridges yet.') %></p>
  <% } else { %>
    <table>
      <thead><tr><th><%= t('Name') %></th><th><%= t('Miniserver') %></th><th><%= t('Backend') %></th><th><%= t('Mode') %></th><th><%= t('Status') %></th><th><%= t('Last session') %></th></tr></thead>
      <tbody>
        <% bridges.forEach(b => { const s = b.status; %>
          <tr>
            <td><a href="/ocpp/<%= b.id %>"><%= b.name %></a></td>
            <td><%= b.miniserver_name %></td>
            <td><code><%= b.server_url %>/<%= b.charge_point_id %></code></td>
            <td><%= b.mode === 'live' ? 'Live' : 'Dry run' %></td>
            <td>
              <% if (!b.enabled) { %><%= t('Disabled') %>
              <% } else if (!s) { %><%= t('Starting…') %>
              <% } else if (s.mode === 'live' && !s.connected) { %><span style="color: var(--danger);"><%= t('Not connected') %></span>
              <% } else if (!s.wallboxReady) { %><%= t('Waiting for Wallbox data') %>
              <% } else { %><span style="color: var(--success);"><%= s.connectorStatus %><%= s.mode === 'live' ? '' : ' (dry run)' %></span><% } %>
            </td>
            <td>
              <% if (b.lastSession) { %>
                <strong><%= b.lastSession.kwh.toFixed(3) %> <%= t('kWh') %></strong>
                <span class="hint"> &middot; <%= formatDateTime(b.lastSession.stoppedAt) %><%= b.lastSession.mode === 'dry' ? ' (dry run)' : '' %></span>
              <% } else { %>&mdash;<% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<% if (canEdit('ocpp')) { %>
<details class="card" <%= bridges.length ? '' : 'open' %>>
  <summary><strong><%= t('Add OCPP bridge') %></strong></summary>
  <form method="post" action="/ocpp" style="margin-top:0.8rem;">
    <%- include('partials/ocpp-bridge-fields', { b: { mode: 'dry', enabled: 1, server_url: 'wss://ocpp.laadloon.nl', id_tag: 'LOXSUITE01', meter_interval_s: 60, stop_delay_s: 90 }, wallboxes, isNew: true }) %>
    <div class="btn-row" style="margin-top:0.9rem;">
      <button type="submit" class="primary"><%- icon('plus') %> <%= t('Add') %></button>
    </div>
  </form>
</details>
<% } %>

<%- include('partials/foot') %>
