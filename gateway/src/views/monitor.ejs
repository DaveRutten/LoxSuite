<%- include('partials/head', { pageTitle: 'Monitor', active: 'monitor' }) %>

<p class="hint">
  Track an MQTT topic or a value read directly from a Loxone Miniserver over time. History is stored
  in SQLite (so it survives a gateway restart) and kept for <strong><%= retentionDays %></strong> days
  before being purged automatically &mdash;
  <% if (canEdit('settings')) { %><a href="/settings">change that in Settings</a><% } else { %>change that in Settings<% } %>.
  Open a monitor for a chart, a raw-values table, and a CSV export.
</p>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<% if (canEdit('monitor')) { %>
<details class="add-panel">
  <summary>Add monitor</summary>
  <div class="add-panel-body">
    <form method="post" action="/monitor" id="add-monitor-form">
      <div class="form-grid">
        <div>
          <label>Source</label>
          <select name="source_type" id="source-type-select">
            <option value="mqtt">MQTT topic</option>
            <option value="loxone">Loxone (direct, polled)</option>
          </select>
        </div>
        <div><label>Label (optional)</label><input type="text" name="label" placeholder="Leave blank to auto-generate one"></div>
      </div>

      <div class="form-grid" id="mqtt-fields" style="margin-top:0.85rem;">
        <div>
          <label>MQTT topic</label>
          <input type="text" name="topic" list="known-topics" placeholder="shellies/.../energy">
          <datalist id="known-topics">
            <% knownTopics.forEach(t => { %><option value="<%= t %>"></option><% }) %>
          </datalist>
        </div>
      </div>

      <div class="form-grid" id="loxone-fields" style="margin-top:0.85rem; display:none;">
        <div>
          <label>Miniserver</label>
          <select id="loxone-miniserver-select">
            <option value="">Select a Miniserver&hellip;</option>
            <% miniservers.forEach(ms => { %><option value="<%= ms.id %>"><%= ms.name %></option><% }) %>
          </select>
          <input type="hidden" name="miniserver_id" id="loxone-miniserver-id">
        </div>
        <div>
          <label>Filter states</label>
          <input type="text" id="loxone-state-filter" placeholder="Type to filter, e.g. living room" disabled>
        </div>
        <div>
          <label>State</label>
          <select name="loxone_uuid" id="loxone-state-select" disabled>
            <option value="">Pick a Miniserver first&hellip;</option>
          </select>
        </div>
        <div>
          <label>Poll interval</label>
          <select name="poll_interval_ms">
            <option value="5000">5 seconds</option>
            <option value="10000" selected>10 seconds</option>
            <option value="30000">30 seconds</option>
            <option value="60000">1 minute</option>
            <option value="300000">5 minutes</option>
          </select>
        </div>
      </div>

      <div style="margin-top:0.9rem;">
        <button type="submit" class="primary"><%- icon('plus') %> Add</button>
        <span class="hint" id="loxone-fetch-status" style="margin:0 0 0 0.6rem; display:inline;"></span>
      </div>
    </form>
  </div>
</details>
<% } %>

<div class="filterable-table-card">
  <% if (canEdit('monitor')) { %>
  <% var disabledCount = monitors.filter(m => !m.enabled).length; var enabledCount = monitors.length - disabledCount; %>
  <div class="table-toolbar">
    <form method="post" action="/monitor/enable-all" style="margin:0;">
      <button type="submit" class="btn-edit" <%= disabledCount === 0 ? 'disabled' : '' %>><%- icon('power') %> Enable all (<%= disabledCount %>)</button>
    </form>
    <form method="post" action="/monitor/disable-all" style="margin:0;">
      <button type="submit" class="btn-edit" <%= enabledCount === 0 ? 'disabled' : '' %>><%- icon('power') %> Disable all (<%= enabledCount %>)</button>
    </form>
    <form method="post" action="/monitor/clear-unused" data-confirm="Delete every monitor not used on any dashboard (<%= unusedCount %> right now), along with its history? Monitors still on a dashboard are never touched." style="margin:0;">
      <button type="submit" class="danger" <%= unusedCount === 0 ? 'disabled' : '' %>><%- icon('trash') %> Clear unused (<%= unusedCount %>)</button>
    </form>
    <form method="post" action="/monitor/clear-all" data-confirm="Delete ALL <%= monitors.length %> monitors and their history, including ones still on a dashboard? Those panels will be left with nothing to show. This can't be undone." style="margin:0;">
      <button type="submit" class="danger" <%= monitors.length === 0 ? 'disabled' : '' %>><%- icon('trash') %> Clear all (<%= monitors.length %>)</button>
    </form>
  </div>
  <% } %>

  <div class="table-wrap">
  <table>
    <thead>
      <tr><th>Status</th><th>Label</th><th>Source</th><th>Dashboard</th><th>Current value</th><th>Last updated</th><th>Actions</th></tr>
    </thead>
    <tbody>
      <% monitors.forEach(m => { %>
        <tr>
          <td><span class="badge badge-live <%= m.enabled ? 'badge-ok' : 'badge-neutral' %>"><%= m.enabled ? 'Active' : 'Off' %></span></td>
          <td><a href="/monitor/<%= m.id %>"><%= m.label %></a></td>
          <td>
            <% if (m.source_type === 'mqtt') { %>
              MQTT &middot; <code><%= m.mqtt_topic %></code>
            <% } else { %>
              Loxone &middot; <%= m.miniserver_name || '-' %> <span class="hint" style="margin:0;">(every <%= Math.round(m.poll_interval_ms / 1000) %>s)</span>
            <% } %>
          </td>
          <td>
            <% if (m.dashboardNames) { %>
              <% m.dashboardNames.split(',').forEach(name => { %>
                <span class="badge badge-neutral" style="margin:0 0.2rem 0.2rem 0;"><%= name %></span>
              <% }) %>
            <% } else { %>
              <span class="badge badge-neutral">Unused</span>
            <% } %>
          </td>
          <td><% if (m.current) { %><span class="truncate" title="<%= m.current.value %>"><%= m.current.value %></span><% } else { %>-<% } %></td>
          <td><%= m.current ? formatDateTime(m.current.recordedAt) : '-' %></td>
          <td>
            <div class="row-actions">
              <a class="inline" href="/monitor/<%= m.id %>"><button type="button"><%- icon('list') %> View</button></a>
              <% if (canEdit('monitor')) { %>
              <button type="button" class="btn-edit" data-toggle-row="monitor-edit-<%= m.id %>"><%- icon('edit') %> Edit</button>
              <form class="inline" method="post" action="/monitor/<%= m.id %>/toggle">
                <button type="submit" class="btn-edit"><%- icon('power') %> <%= m.enabled ? 'Disable' : 'Enable' %></button>
              </form>
              <form class="inline" method="post" action="/monitor/<%= m.id %>/delete" data-confirm="Delete this monitor and all of its history?">
                <button type="submit" class="danger"><%- icon('trash') %> Delete</button>
              </form>
              <% } %>
            </div>
          </td>
        </tr>
        <% if (canEdit('monitor')) { %>
        <tr class="expand-row" id="monitor-edit-<%= m.id %>">
          <td colspan="7">
            <form method="post" action="/monitor/<%= m.id %>/update" class="form-grid" style="max-width:28rem;">
              <div><label>Label</label><input type="text" name="label" value="<%= m.label %>" required></div>
              <% if (m.source_type === 'loxone') { %>
              <div>
                <label>Poll interval</label>
                <select name="poll_interval_ms">
                  <option value="5000" <%= m.poll_interval_ms === 5000 ? 'selected' : '' %>>5 seconds</option>
                  <option value="10000" <%= m.poll_interval_ms === 10000 ? 'selected' : '' %>>10 seconds</option>
                  <option value="30000" <%= m.poll_interval_ms === 30000 ? 'selected' : '' %>>30 seconds</option>
                  <option value="60000" <%= m.poll_interval_ms === 60000 ? 'selected' : '' %>>1 minute</option>
                  <option value="300000" <%= m.poll_interval_ms === 300000 ? 'selected' : '' %>>5 minutes</option>
                </select>
              </div>
              <% } else { %>
              <div><label>MQTT topic</label><input type="text" value="<%= m.mqtt_topic %>" disabled title="The topic itself can't be changed — delete and re-add to track a different topic."></div>
              <% } %>
              <button type="submit" class="btn-edit"><%- icon('edit') %> Save</button>
            </form>
          </td>
        </tr>
        <% } %>
      <% }) %>
      <% if (monitors.length === 0) { %>
        <tr><td colspan="7" class="empty">No monitors yet &mdash; add one above, or use the "Monitor" shortcut on a topic in <a href="/incoming/messages">Live Traffic</a>.</td></tr>
      <% } %>
    </tbody>
  </table>
  </div>
</div>

<script>
  (function () {
    var sourceSelect = document.getElementById('source-type-select');
    var mqttFields = document.getElementById('mqtt-fields');
    var loxoneFields = document.getElementById('loxone-fields');
    var miniserverSelect = document.getElementById('loxone-miniserver-select');
    var miniserverIdInput = document.getElementById('loxone-miniserver-id');
    var stateSelect = document.getElementById('loxone-state-select');
    var stateFilter = document.getElementById('loxone-state-filter');
    var fetchStatus = document.getElementById('loxone-fetch-status');
    var allStates = [];

    sourceSelect.addEventListener('change', function () {
      var isLoxone = sourceSelect.value === 'loxone';
      mqttFields.style.display = isLoxone ? 'none' : '';
      loxoneFields.style.display = isLoxone ? '' : 'none';
    });

    function renderStates(states) {
      stateSelect.innerHTML = '';
      if (states.length === 0) {
        var opt = document.createElement('option');
        opt.textContent = 'No matching states';
        stateSelect.appendChild(opt);
        return;
      }
      states.forEach(function (s) {
        var opt = document.createElement('option');
        opt.value = s.uuid;
        opt.textContent = s.label;
        stateSelect.appendChild(opt);
      });
    }

    stateFilter.addEventListener('input', function () {
      var q = stateFilter.value.toLowerCase();
      renderStates(allStates.filter(function (s) { return s.label.toLowerCase().indexOf(q) !== -1; }));
    });

    miniserverSelect.addEventListener('change', function () {
      var id = miniserverSelect.value;
      miniserverIdInput.value = id;
      allStates = [];
      stateFilter.value = '';
      if (!id) {
        stateSelect.disabled = true;
        stateFilter.disabled = true;
        stateSelect.innerHTML = '<option value="">Pick a Miniserver first&hellip;</option>';
        return;
      }
      stateSelect.disabled = true;
      stateFilter.disabled = true;
      stateSelect.innerHTML = '<option value="">Loading&hellip;</option>';
      fetchStatus.textContent = 'Fetching structure from the Miniserver&hellip;';
      fetch('/monitor/loxone-structure/' + id)
        .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, data: data }; }); })
        .then(function (res) {
          if (!res.ok) throw new Error(res.data.error || 'Failed to fetch structure');
          allStates = res.data.states;
          renderStates(allStates);
          stateSelect.disabled = false;
          stateFilter.disabled = false;
          fetchStatus.textContent = allStates.length + ' states found.';
        })
        .catch(function (err) {
          stateSelect.innerHTML = '<option value="">-</option>';
          fetchStatus.textContent = err.message;
        });
    });
  })();
</script>

<%- include('partials/foot') %>
