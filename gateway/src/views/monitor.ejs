<%- include('partials/head', { pageTitle: 'Monitor', active: 'monitor' }) %>

<p class="hint">
  <%= t('Track an MQTT topic or a value read directly from a Loxone Miniserver over time. History is stored in SQLite (so it survives a gateway restart) and kept for') %> <strong><%= retentionDays %></strong> <%= t('days before being purged automatically —') %>
  <% if (canEdit('settings')) { %><a href="/settings"><%= t('change that in Settings') %></a><% } else { %><%= t('change that in Settings') %><% } %><%= t('. Open a monitor for a chart, a raw-values table, and a CSV export.') %>
</p>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<% if (canEdit('monitor')) { %>
<details class="add-panel" <%= prefillTopic ? 'open' : '' %>>
  <summary><%= t('Add monitor') %></summary>
  <div class="add-panel-body">
    <form method="post" action="/monitor" id="add-monitor-form">
      <div class="form-grid">
        <div>
          <label><%= t('Source') %></label>
          <select name="source_type" id="source-type-select">
            <option value="mqtt"><%= t('MQTT topic') %></option>
            <option value="loxone"><%= t('Loxone (direct, polled)') %></option>
            <option value="miniserver_diag"><%= t('Miniserver diagnostic') %></option>
          </select>
        </div>
        <div><label><%= t('Label (optional)') %></label><input type="text" name="label" placeholder="<%= t('Leave blank to auto-generate one') %>"></div>
      </div>

      <div class="form-grid" id="mqtt-fields" style="margin-top:0.85rem;">
        <div>
          <label><%= t('MQTT topic') %></label>
          <input type="text" name="topic" list="known-topics" placeholder="<%= t('shellies/.../energy') %>" value="<%= prefillTopic %>">
          <datalist id="known-topics">
            <% knownTopics.forEach(tt => { %><option value="<%= tt %>"></option><% }) %>
          </datalist>
        </div>
      </div>

      <div class="form-grid" id="loxone-fields" style="margin-top:0.85rem; display:none;">
        <div>
          <label><%= t('Miniserver') %></label>
          <select id="loxone-miniserver-select">
            <option value=""><%= t('Select a Miniserver…') %></option>
            <% miniservers.forEach(ms => { %><option value="<%= ms.id %>"><%= ms.name %></option><% }) %>
          </select>
          <input type="hidden" name="miniserver_id" id="loxone-miniserver-id">
        </div>
        <div>
          <label><%= t('Filter states') %></label>
          <input type="text" id="loxone-state-filter" placeholder="<%= t('Type to filter, e.g. living room') %>" disabled>
        </div>
        <div>
          <label><%= t('State') %></label>
          <select name="loxone_uuid" id="loxone-state-select" disabled>
            <option value=""><%= t('Pick a Miniserver first…') %></option>
          </select>
        </div>
        <div>
          <label><%= t('Poll interval') %></label>
          <select name="poll_interval_ms">
            <option value="5000"><%= t('5 seconds') %></option>
            <option value="10000" selected><%= t('10 seconds') %></option>
            <option value="30000"><%= t('30 seconds') %></option>
            <option value="60000"><%= t('1 minute') %></option>
            <option value="300000"><%= t('5 minutes') %></option>
          </select>
        </div>
      </div>

      <div class="form-grid" id="miniserver-diag-fields" style="margin-top:0.85rem; display:none;">
        <div>
          <label><%= t('Miniserver') %></label>
          <select name="miniserver_id" id="diag-miniserver-select" disabled>
            <option value=""><%= t('Select a Miniserver…') %></option>
            <% miniservers.forEach(ms => { %><option value="<%= ms.id %>"><%= ms.name %></option><% }) %>
          </select>
        </div>
        <div>
          <label><%= t('Field') %></label>
          <select name="diag_field">
            <option value="cpu_load"><%= t('CPU load') %></option>
            <option value="heap_value_kb"><%= t('Heap value') %></option>
            <option value="heap_total_kb"><%= t('Heap total') %></option>
            <option value="num_tasks"><%= t('Task count') %></option>
          </select>
        </div>
      </div>
      <p class="hint" id="miniserver-diag-hint" style="margin-top:0.5rem; display:none;">
        <%= t('Not polled independently — reuses whatever the') %>
        <a href="/miniservers"><%= t('Miniservers') %></a> <%= t('page\'s own background check already reads on its own interval (Settings, default 60s), so adding one of these never adds extra load on the Miniserver. "Heap value" is deliberately not labeled free/used: Loxone doesn\'t document which of the two numbers it returns is which.') %>
      </p>

      <div style="margin-top:0.9rem;">
        <button type="submit" class="primary"><%- icon('plus') %> <%= t('Add') %></button>
        <span class="hint" id="loxone-fetch-status" style="margin:0 0 0 0.6rem; display:inline;"></span>
      </div>
    </form>
  </div>
</details>
<% } %>

<div class="filterable-table-card">
  <% var disabledCount = monitors.filter(m => !m.enabled).length; var enabledCount = monitors.length - disabledCount; %>
  <div class="table-toolbar">
    <div class="search-combo">
      <select id="monitor-filter-field">
        <option value="0"><%= t('Status') %></option>
        <option value="1" selected><%= t('Label') %></option>
        <option value="2"><%= t('Source') %></option>
        <option value="3"><%= t('Dashboard') %></option>
        <option value="4"><%= t('Notification') %></option>
        <option value="5"><%= t('Raw value') %></option>
        <option value="7"><%= t('Last updated') %></option>
        <option value="8"><%= t('Room') %></option>
        <option value="9"><%= t('Category') %></option>
      </select>
      <div class="clearable-input-wrap">
        <input type="text" id="monitor-filter-query" placeholder="<%= t('Filter…') %>">
        <button type="button" id="monitor-filter-clear" class="icon-btn clearable-input-clear" title="<%= t('Clear filter') %>" aria-label="<%= t('Clear filter') %>" hidden>&times;</button>
      </div>
    </div>
    <% if (canEdit('monitor')) { %>
    <form method="post" action="/monitor/enable-all" style="margin:0;">
      <button type="submit" class="btn-edit" <%= disabledCount === 0 ? 'disabled' : '' %>><%- icon('power') %> <%= t('Enable all (') %><%= disabledCount %>)</button>
    </form>
    <form method="post" action="/monitor/disable-all" style="margin:0;">
      <button type="submit" class="btn-edit" <%= enabledCount === 0 ? 'disabled' : '' %>><%- icon('power') %> <%= t('Disable all (') %><%= enabledCount %>)</button>
    </form>
    <form method="post" action="/monitor/clear-unused" data-confirm="Delete every monitor not used on any dashboard (<%= unusedCount %> right now), along with its history? Monitors still on a dashboard are never touched." style="margin:0;">
      <button type="submit" class="danger" <%= unusedCount === 0 ? 'disabled' : '' %>><%- icon('trash') %> <%= t('Clear unused (') %><%= unusedCount %>)</button>
    </form>
    <form method="post" action="/monitor/clear-all" data-confirm="Delete ALL <%= monitors.length %> monitors and their history, including ones still on a dashboard? Those panels will be left with nothing to show. This can't be undone." style="margin:0;">
      <button type="submit" class="danger" <%= monitors.length === 0 ? 'disabled' : '' %>><%- icon('trash') %> <%= t('Clear all (') %><%= monitors.length %>)</button>
    </form>
    <% } %>
  </div>

  <div class="table-wrap">
  <table>
    <thead>
      <tr><th><%= t('Status') %></th><th><%= t('Label') %></th><th><%= t('Source') %></th><th><%= t('Dashboard') %></th><th><%= t('Notification') %></th><th><%= t('Raw value') %></th><th><%= t('Scaled value') %></th><th><%= t('Last updated') %></th><th data-default-hidden><%= t('Room') %></th><th data-default-hidden><%= t('Category') %></th><th><%= t('Actions') %></th></tr>
    </thead>
    <tbody>
      <% monitors.forEach(m => { %>
        <tr data-monitor-id="<%= m.id %>">
          <td><span class="badge badge-live <%= m.enabled ? 'badge-ok' : 'badge-neutral' %>"><%= m.enabled ? 'Active' : 'Off' %></span></td>
          <td><a href="/monitor/<%= m.id %>"><%= m.label %></a></td>
          <td>
            <% if (m.source_type === 'mqtt') { %>
              <%= t('MQTT ·') %> <code><%= m.mqtt_topic %></code>
            <% } else if (m.source_type === 'miniserver_diag') { %>
              <%= t('Diagnostic ·') %> <%= m.miniserver_name || '-' %> <span class="hint" style="margin:0;"><%= t('(reuses the Miniservers page\'s own check, not polled separately)') %></span>
            <% } else { %>
              <%= t('Loxone ·') %> <%= m.miniserver_name || '-' %> <span class="hint" style="margin:0;"><%= t('(every') %> <%= Math.round(m.poll_interval_ms / 1000) %>s)</span>
            <% } %>
          </td>
          <td>
            <% if (m.dashboardPairs) { %>
              <% m.dashboardPairs.split(',').forEach(pair => { %>
                <% var sep = pair.indexOf(':'); var dashId = pair.slice(0, sep); var dashName = pair.slice(sep + 1); %>
                <a href="/dashboards/<%= dashId %>" style="margin:0 0.2rem 0.2rem 0; display:inline-block;">
                  <span class="badge badge-neutral"><%= dashName %></span>
                </a>
              <% }) %>
            <% } else { %>
              <span class="badge badge-neutral"><%= t('None') %></span>
            <% } %>
          </td>
          <td>
            <% if (m.hasNotifyThreshold) { %>
              <span class="badge badge-warning" title="<%= t('At least one threshold rung on this monitor\'s own chart is flagged Notify — crossing into it logs an event to the Notification Center.') %>"><%= t('Notify') %></span>
            <% } else { %>
              <span class="badge badge-neutral"><%= t('None') %></span>
            <% } %>
          </td>
          <td><% if (m.current) { %><span class="truncate" title="<%= m.current.value %>"><%= m.current.value %></span><% } else { %>-<% } %></td>
          <td>
            <%
              // Only this monitor's own chart config, never a shared default — see routes/monitor.js's
              // chart-settings handler for why unit/scale/decimals all live per-monitor here (the
              // legacy config.unit fallback covers a monitor whose unit was set before it moved there).
              var mConfig = {}; try { mConfig = JSON.parse(m.config || '{}'); } catch (e) { /* malformed — no scaling */ }
              var mSeries = (mConfig.series && mConfig.series[String(m.id)]) || {};
              var mUnit = mSeries.unit || mConfig.unit || '';
              var mScale = mSeries.scale != null ? mSeries.scale : 1;
              var mDecimals = mSeries.decimals != null ? mSeries.decimals : defaultPanelDecimals;
              var mValueLabels = mSeries.valueLabels || [];
              // A reading is sometimes a Loxone/MQTT enum (1 = Active, 50 = Resetting), not a
              // continuous quantity a scale/decimals pair can meaningfully round — checked first,
              // against the RAW value, same precedence the dashboard's own 'value' panel type gives
              // its identical mapping (see loadPanelsWithMonitors in routes/dashboards.js).
              var mMapping = m.current ? mValueLabels.find((vm) => vm.value === String(m.current.value)) : null;
              var hasScaling = !!(mValueLabels.length || mSeries.unit || mConfig.unit || (mSeries.scale != null) || (mSeries.decimals != null));
            %>
            <% if (mMapping) { %>
              <%= mMapping.label %>
            <% } else if (hasScaling && m.current && m.current.numericValue != null) { %>
              <%= (Number(m.current.numericValue) * mScale).toFixed(mDecimals) %><%= mUnit ? ' ' + mUnit : '' %>
            <% } else { %>-<% } %>
          </td>
          <td><%= m.current ? formatDateTime(m.current.recordedAt) : '-' %></td>
          <td><%= m.room || '-' %></td>
          <td><%= m.category || '-' %></td>
          <td>
            <div class="row-actions">
              <a class="inline" href="/monitor/<%= m.id %>"><button type="button" class="btn-soft"><%- icon('list') %> <%= t('View') %></button></a>
              <% if (canEdit('monitor')) { %>
              <button type="button" class="btn-edit" data-toggle-row="monitor-edit-<%= m.id %>"><%- icon('edit') %> <%= t('Edit') %></button>
              <form class="inline" method="post" action="/monitor/<%= m.id %>/toggle">
                <button type="submit" class="btn-edit"><%- icon('power') %> <%= m.enabled ? 'Disable' : 'Enable' %></button>
              </form>
              <form class="inline" method="post" action="/monitor/<%= m.id %>/delete" data-confirm="<%= t('Delete this monitor and all of its history?') %>" data-ajax-delete>
                <button type="submit" class="danger"><%- icon('trash') %> <%= t('Delete') %></button>
              </form>
              <% } %>
            </div>
          </td>
        </tr>
        <% if (canEdit('monitor')) { %>
        <tr class="expand-row" id="monitor-edit-<%= m.id %>">
          <td colspan="10">
            <form method="post" action="/monitor/<%= m.id %>/update" class="form-grid" style="max-width:28rem;">
              <div><label><%= t('Label') %></label><input type="text" name="label" value="<%= m.label %>" required></div>
              <% if (m.source_type === 'loxone') { %>
              <div>
                <label><%= t('Poll interval') %></label>
                <select name="poll_interval_ms">
                  <option value="5000" <%= m.poll_interval_ms === 5000 ? 'selected' : '' %>><%= t('5 seconds') %></option>
                  <option value="10000" <%= m.poll_interval_ms === 10000 ? 'selected' : '' %>><%= t('10 seconds') %></option>
                  <option value="30000" <%= m.poll_interval_ms === 30000 ? 'selected' : '' %>><%= t('30 seconds') %></option>
                  <option value="60000" <%= m.poll_interval_ms === 60000 ? 'selected' : '' %>><%= t('1 minute') %></option>
                  <option value="300000" <%= m.poll_interval_ms === 300000 ? 'selected' : '' %>><%= t('5 minutes') %></option>
                </select>
              </div>
              <% } else if (m.source_type === 'miniserver_diag') { %>
              <div><label><%= t('Field') %></label><input type="text" value="<%= m.miniserver_name %> &middot; <%= DIAG_FIELD_LABELS[m.diag_field] || m.diag_field %>" disabled title="<%= t('The Miniserver/field can\'t be changed — delete and re-add to track a different one.') %>"></div>
              <% } else { %>
              <div><label><%= t('MQTT topic') %></label><input type="text" value="<%= m.mqtt_topic %>" disabled title="<%= t('The topic itself can\'t be changed — delete and re-add to track a different topic.') %>"></div>
              <% } %>
              <button type="submit" class="btn-edit"><%- icon('edit') %> <%= t('Save') %></button>
            </form>
          </td>
        </tr>
        <% } %>
      <% }) %>
      <% if (monitors.length === 0) { %>
        <tr><td colspan="8" class="empty"><%= t('No monitors yet — add one above, or use the "Monitor" shortcut on a topic in') %> <a href="/incoming/messages"><%= t('Live Traffic') %></a>.</td></tr>
      <% } %>
    </tbody>
  </table>
  </div>
</div>

<script>
  (function () {
    var sourceSelect = document.getElementById('source-type-select');
    var mqttFields = document.getElementById('mqtt-fields');
    var loxoneFields = document.getElementById('loxone-fields');
    var diagFields = document.getElementById('miniserver-diag-fields');
    var diagHint = document.getElementById('miniserver-diag-hint');
    var miniserverSelect = document.getElementById('loxone-miniserver-select');
    var miniserverIdInput = document.getElementById('loxone-miniserver-id');
    var stateSelect = document.getElementById('loxone-state-select');
    var stateFilter = document.getElementById('loxone-state-filter');
    var fetchStatus = document.getElementById('loxone-fetch-status');
    var diagMiniserverSelect = document.getElementById('diag-miniserver-select');
    var allStates = [];

    sourceSelect.addEventListener('change', function () {
      var value = sourceSelect.value;
      mqttFields.style.display = value === 'mqtt' ? '' : 'none';
      loxoneFields.style.display = value === 'loxone' ? '' : 'none';
      diagFields.style.display = value === 'miniserver_diag' ? '' : 'none';
      diagHint.style.display = value === 'miniserver_diag' ? '' : 'none';
      // Both sections have their own miniserver_id field (this one, and diag-miniserver-select
      // below) — a disabled field is never included in a form submission, which is what keeps the
      // inactive one's value out of the POST instead of both landing in req.body.miniserver_id as
      // an array (which is what "Too many parameter values were provided" from the INSERT further
      // down actually was).
      miniserverIdInput.disabled = value !== 'loxone';
      diagMiniserverSelect.disabled = value !== 'miniserver_diag';
    });

    function renderStates(states) {
      stateSelect.innerHTML = '';
      if (states.length === 0) {
        var opt = document.createElement('option');
        opt.textContent = 'No matching states';
        stateSelect.appendChild(opt);
        return;
      }
      states.forEach(function (s) {
        var opt = document.createElement('option');
        opt.value = s.uuid;
        opt.textContent = s.label;
        stateSelect.appendChild(opt);
      });
    }

    stateFilter.addEventListener('input', function () {
      var q = stateFilter.value.toLowerCase();
      renderStates(allStates.filter(function (s) { return s.label.toLowerCase().indexOf(q) !== -1; }));
    });

    miniserverSelect.addEventListener('change', function () {
      var id = miniserverSelect.value;
      miniserverIdInput.value = id;
      allStates = [];
      stateFilter.value = '';
      if (!id) {
        stateSelect.disabled = true;
        stateFilter.disabled = true;
        stateSelect.innerHTML = '<option value="">Pick a Miniserver first&hellip;</option>';
        return;
      }
      stateSelect.disabled = true;
      stateFilter.disabled = true;
      stateSelect.innerHTML = '<option value="">Loading&hellip;</option>';
      fetchStatus.textContent = 'Fetching structure from the Miniserver&hellip;';
      fetch('/monitor/loxone-structure/' + id)
        .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, data: data }; }); })
        .then(function (res) {
          if (!res.ok) throw new Error(res.data.error || 'Failed to fetch structure');
          allStates = res.data.states;
          renderStates(allStates);
          stateSelect.disabled = false;
          stateFilter.disabled = false;
          fetchStatus.textContent = allStates.length + ' states found.';
        })
        .catch(function (err) {
          stateSelect.innerHTML = '<option value="">-</option>';
          fetchStatus.textContent = err.message;
        });
    });
  })();
</script>

<script>
  // Removes a just-deleted monitor's row the instant Delete is confirmed, rather than waiting for
  // the full page reload a plain form submit would otherwise force — routes/monitor.js's own
  // :id/delete responds quickly and keeps purging that monitor's (possibly very large) history in
  // the background, so the row disappearing here is the ONLY signal the user gets that anything
  // happened; nothing about this ever reloads the page for them to see it removed the old way.
  // The event itself (and the actual fetch) come from foot.ejs's generic data-ajax-delete handling
  // — this listener only knows how to turn "that form" into "this row", which is this page's own
  // business, not foot.ejs's.
  document.addEventListener('lox:ajax-delete', function (e) {
    var form = e.detail.form;
    var idMatch = form.action.match(/\/(\d+)\/delete$/);
    if (!idMatch) return;
    // Not form.closest('tr') — a Delete button with 2+ siblings (View/Edit/Enable/Delete) has
    // already been relocated into a body-level .row-actions-popover by tables.js's
    // collapseRowActions() by the time this fires, so the form is no longer a descendant of its
    // own row at all. And not the monitor-edit-<id> expand-row either — collapseRowActions()
    // itself already merges THAT row's own content into the popover and removes the original
    // element from the DOM outright (see its own [data-toggle-row] handling), so by the time this
    // runs it no longer exists to anchor from (confirmed live: getElementById came back null).
    // data-monitor-id on the main <tr> (see the row loop below) is the one identifier that's
    // neither moved nor removed by any of that.
    var mainRow = document.querySelector('tr[data-monitor-id="' + idMatch[1] + '"]');
    var expandRow = document.getElementById('monitor-edit-' + idMatch[1]);
    if (mainRow) mainRow.remove();
    if (expandRow) expandRow.remove();
    var popover = form.closest('.row-actions-popover');
    if (popover) popover.remove();
  });
</script>

<script>
  // Same pattern as Incoming Clients/Messages' own filter — column-index based, no live-refresh on
  // this page to re-apply after (unlike those), so no MutationObserver needed here.
  (function () {
    var fieldSelect = document.getElementById('monitor-filter-field');
    var queryInput = document.getElementById('monitor-filter-query');
    var clearBtn = document.getElementById('monitor-filter-clear');
    var tbody = document.querySelector('.table-wrap tbody');
    if (!fieldSelect || !tbody) return;

    function applyFilter() {
      var colIndex = Number(fieldSelect.value);
      var q = queryInput.value.trim().toLowerCase();
      if (clearBtn) clearBtn.hidden = !q;
      tbody.querySelectorAll('tr').forEach(function (row) {
        if (!q) { row.style.display = ''; return; }
        var cell = row.children[colIndex];
        var text = cell ? cell.textContent.toLowerCase() : '';
        row.style.display = text.indexOf(q) !== -1 ? '' : 'none';
      });
    }

    fieldSelect.addEventListener('change', applyFilter);
    queryInput.addEventListener('input', applyFilter);
    if (clearBtn) {
      clearBtn.addEventListener('click', function () {
        queryInput.value = '';
        applyFilter();
        queryInput.focus();
      });
    }
    queryInput.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape' || !queryInput.value) return;
      e.stopPropagation();
      queryInput.value = '';
      applyFilter();
    });
  })();
</script>

<%- include('partials/foot') %>
