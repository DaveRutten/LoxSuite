<%- include('partials/head', { pageTitle: 'Profile', active: 'profile' }) %>

<div class="card">
  <div style="display:flex; align-items:center; gap:1.1rem; margin-bottom:1.25rem;">
    <% if (profile.avatar_url) { %>
      <img src="/avatar/<%= profile.id %>" alt="" style="width:64px; height:64px; border-radius:50%; object-fit:cover; flex-shrink:0;">
    <% } else { %>
      <div style="width:64px; height:64px; border-radius:50%; flex-shrink:0; display:flex; align-items:center; justify-content:center; background:var(--accent-soft); color:var(--accent); font-size:1.5rem; font-weight:600;">
        <%= (profile.display_name || profile.username).charAt(0).toUpperCase() %>
      </div>
    <% } %>
    <div>
      <div style="font-size:1.2rem; font-weight:600;"><%= profile.display_name || profile.username %></div>
      <div class="hint" style="margin:0;"><%= profile.username %><%= profile.email ? ' · ' + profile.email : '' %></div>
    </div>
  </div>

  <div class="stat-grid" style="margin-bottom:0;">
    <div class="stat-card">
      <div class="label"><%= t('Access Role') %></div>
      <div class="value"><%= currentUser.roleName || '-' %></div>
    </div>
    <div class="stat-card">
      <div class="label"><%= t('Signed in via') %></div>
      <div class="value"><%= profile.auth_provider === 'local' ? 'Username / password' : 'Pocket ID (SSO)' %></div>
    </div>
  </div>
</div>

<div class="tabs">
  <a href="/profile?tab=account" class="<%= tab === 'account' ? 'active' : '' %>"><%= t('Account') %></a>
  <a href="/profile?tab=notifications" class="<%= tab === 'notifications' ? 'active' : '' %>"><%= t('Notifications') %></a>
</div>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>
<% if (saved) { %>
  <p class="hint" style="color: var(--success);"><%= t('Saved.') %></p>
<% } %>

<% if (tab === 'account') { %>
  <% if (typeof languages !== 'undefined' && languages.length > 1) { %>
    <div class="card">
      <h2><%= t('Language') %></h2>
      <form method="post" action="/profile/language" class="btn-row" style="align-items:flex-end; gap:0.6rem;">
        <div>
          <label><%= t('Language of LoxSuite') %></label>
          <select name="language" data-no-i18n>
            <% const defName = (languages.find(l => l.code === defaultLanguage) || {}).name || defaultLanguage; %>
            <option value="" <%= !myLanguage ? 'selected' : '' %>><%= t('Installation default ({language})', { language: defName }) %></option>
            <% languages.forEach(l => { %><option value="<%= l.code %>" <%= myLanguage === l.code ? 'selected' : '' %>><%= l.name %></option><% }) %>
          </select>
        </div>
        <button type="submit" class="btn-edit"><%- icon('edit') %> <%= t('Save') %></button>
      </form>
      <p class="hint" style="margin:0.5rem 0 0;"><%= t('Not everything is translated yet; untranslated texts are shown in English.') %><% if (canView('translations')) { %> <a href="/translations"><%= t('Help translate') %></a><% } %></p>
    </div>
  <% } %>
  <% if (profile.auth_provider === 'local') { %>
    <div class="card">
      <h2><%= t('Name & email') %></h2>
      <form method="post" action="/profile/details">
        <div class="form-grid">
          <div><label><%= t('Display name') %></label><input type="text" name="display_name" value="<%= profile.display_name || '' %>" placeholder="<%= profile.username %>"></div>
          <div><label><%= t('Email') %></label><input type="email" name="email" value="<%= profile.email || '' %>"></div>
        </div>
        <div style="display:flex; justify-content:flex-end; margin-top:0.9rem;">
          <button type="submit" class="btn-edit"><%- icon('edit') %> <%= t('Save') %></button>
        </div>
      </form>
    </div>

    <div class="card">
      <h2><%= t('Change password') %></h2>
      <form method="post" action="/profile/password">
        <div class="form-grid">
          <div><label><%= t('Current password') %></label><input type="password" name="current_password" required></div>
          <div><label><%= t('New password') %></label><input type="password" name="new_password" required minlength="8"></div>
          <div><label><%= t('Confirm new password') %></label><input type="password" name="confirm_password" required minlength="8"></div>
        </div>
        <div style="display:flex; justify-content:flex-end; margin-top:0.9rem;">
          <button type="submit" class="btn-edit"><%- icon('edit') %> <%= t('Change password') %></button>
        </div>
      </form>
    </div>
  <% } else { %>
    <p class="hint"><%= t('Your name, email, avatar, and password are all managed by Pocket ID, not this gateway — they\'re refreshed here automatically every time you sign in.') %></p>
  <% } %>
<% } else { %>
  <div class="card">
    <h2><%= t('My channel') %></h2>
    <p class="hint">
      <%= t('Where notifications you subscribe to below get sent — your own') %>
      <a href="https://github.com/caronc/apprise#supported-notifications" target="_blank" rel="noopener"><%= t('Apprise URL') %></a><%= t(', e.g. a personal Pushover/Telegram/ntfy target, separate from any channel an administrator has set up on the') %> <% if (currentUser.isAdmin) { %><a href="/admin/notifications"><%= t('Notifications admin page') %></a><% } else { %><%= t('Notifications admin page') %><% } %>.
    </p>
    <form method="post" action="/profile/notifications/channel">
      <div class="form-grid">
        <div style="grid-column:1/-1;"><label><%= t('Apprise URL') %></label><input type="text" name="notify_url" value="<%= profile.notify_url || '' %>" placeholder="<%= t('tgram://bottoken/ChatID') %>"></div>
      </div>
      <div class="row-actions" style="justify-content:flex-end; margin-top:0.9rem;">
        <button type="submit" class="btn-edit"><%- icon('edit') %> <%= t('Save') %></button>
      </div>
    </form>
    <% if (profile.notify_url) { %>
      <form method="post" action="/profile/notifications/channel/test" style="margin-top:0.6rem;">
        <div class="row-actions" style="justify-content:flex-end;">
          <button type="submit" class="btn-test"><%- icon('refresh') %> <%= t('Send test') %></button>
        </div>
      </form>
      <% if (testResult) { %>
        <div class="hint" style="margin:0.4rem 0 0; text-align:right; <%= testResult.ok ? 'color: var(--success);' : 'color: var(--danger);' %>">
          <% if (testResult.ok) { %><%= t('Test message sent.') %><% } else { %><%= t('Test failed:') %> <%= testResult.error %><% } %>
        </div>
      <% } %>
    <% } %>
  </div>

  <div class="card">
    <h2><%= t('Push to my devices') %></h2>
    <p class="hint"><%= t('Notifications you subscribe to can also go to the LoxSuite app on your phone or computer (as push). Choose per subscription below where it goes: your channel, push, or both. Devices are added on the App & push page.') %></p>
    <form method="post" action="/profile/notifications/push" style="display:flex; align-items:center; gap:0.8rem; flex-wrap:wrap;">
      <label class="toggle-row" style="margin:0;"><input type="checkbox" name="push_on" value="1" <%= profile.push_on ? 'checked' : '' %>> <span><strong><%= t('Also send as push') %></strong></span></label>
      <button type="submit" class="btn-edit"><%- icon('edit') %> <%= t('Save') %></button>
      <a href="/app" class="hint" style="margin:0;"><%= t('App & push') %></a>
    </form>
  </div>

  <div class="card">
    <h2><%= t('My rules') %></h2>
    <p class="hint">
      <%= t('Your own trigger conditions, entirely independent of what an administrator has set up — no admin involvement needed. Always delivered to') %> <strong><%= t('My channel') %></strong> <%= t('above; there\'s no separate on/off switch to miss the way an admin-wide rule below has, since nobody else could already have subscribed one of these for you.') %>
    </p>

    <details class="add-panel">
      <summary><%= t('Add rule') %></summary>
      <div class="add-panel-body">
        <form method="post" action="/profile/notifications/rules" class="rule-form">
          <div class="form-grid">
            <div><label><%= t('Name') %></label><input type="text" name="name" placeholder="<%= t('e.g. Freezer too warm') %>" required></div>
            <div>
              <label><%= t('Trigger') %></label>
              <select name="trigger_type" class="rule-trigger-select">
                <% triggerTypes.filter(tt => !tt.off).forEach(tt => { %><option value="<%= tt.key %>"><%= tt.label %></option><% }) %>
              </select>
            </div>
          </div>

          <div class="form-grid rule-fields" data-for="monitor_threshold" style="margin-top:0.85rem;">
            <div>
              <label><%= t('Monitor') %></label>
              <select name="monitor_id">
                <option value=""><%= t('Choose a monitor…') %></option>
                <% monitors.forEach(m => { %><option value="<%= m.id %>"><%= m.label %></option><% }) %>
              </select>
              <% if (monitors.length === 0) { %><p class="hint" style="margin:0.3rem 0 0;"><%= t('No monitors visible to your Access Role.') %></p><% } %>
            </div>
            <div>
              <label><%= t('Condition') %></label>
              <select name="operator">
                <option value="gt"><%= t('> (greater than)') %></option>
                <option value="gte"><%= t('≥ (at least)') %></option>
                <option value="lt"><%= t('< (less than)') %></option>
                <option value="lte"><%= t('≤ (at most)') %></option>
                <option value="eq"><%= t('= (equals)') %></option>
              </select>
            </div>
            <div><label><%= t('Value') %></label><input type="number" step="any" name="threshold_value"></div>
          </div>
          <label class="toggle-row rule-fields" data-for="monitor_threshold" style="margin-top:0.5rem;">
            <input type="checkbox" name="notify_on_recover">
            <span><strong><%= t('Also notify on recovery') %></strong><span class="hint"><%= t('Send a second message once the value is back within range, not just when it first crosses the line.') %></span></span>
          </label>

          <div class="form-grid rule-fields" data-for="miniserver_status" style="margin-top:0.85rem;">
            <div>
              <label><%= t('Miniserver') %></label>
              <select name="miniserver_id">
                <option value=""><%= t('Any Miniserver') %></option>
                <% miniservers.forEach(ms => { %><option value="<%= ms.id %>"><%= ms.name %></option><% }) %>
              </select>
            </div>
          </div>

          <div class="form-grid rule-fields" data-for="firmware_changed" style="margin-top:0.85rem;">
            <div>
              <label><%= t('Miniserver') %></label>
              <select name="firmware_miniserver_id">
                <option value=""><%= t('Any Miniserver') %></option>
                <% miniservers.forEach(ms => { %><option value="<%= ms.id %>"><%= ms.name %></option><% }) %>
              </select>
            </div>
          </div>

          <div class="form-grid rule-fields" data-for="mqtt_client_status" style="margin-top:0.85rem;">
            <div><label><%= t('MQTT username (blank = any client)') %></label><input type="text" name="mqtt_username" placeholder="<%= t('e.g. shelly-livingroom') %>"></div>
          </div>

          <div style="margin-top:0.9rem;">
            <button type="submit" class="primary"><%- icon('plus') %> <%= t('Add rule') %></button>
          </div>
        </form>
      </div>
    </details>

    <% if (myRules.length > 0) { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th><%= t('Name') %></th><th><%= t('Trigger') %></th><th><%= t('Enabled') %></th><th><%= t('Actions') %></th></tr></thead>
          <tbody>
            <% myRules.forEach(r => { %>
              <tr>
                <td><%= r.name %></td>
                <td><%= r.triggerLabel %></td>
                <td><span class="badge <%= r.enabled ? 'badge-ok' : 'badge-neutral' %>"><%= r.enabled ? 'Yes' : 'No' %></span></td>
                <td>
                  <div class="row-actions">
                    <button type="button" class="btn-edit" data-toggle-row="my-rule-edit-<%= r.id %>"><%- icon('edit') %> <%= t('Edit') %></button>
                    <form class="inline" method="post" action="/profile/notifications/rules/<%= r.id %>/delete" data-confirm="<%= t('Delete this rule?') %>">
                      <button type="submit" class="danger"><%- icon('trash') %> <%= t('Delete') %></button>
                    </form>
                  </div>
                </td>
              </tr>
              <tr class="expand-row" id="my-rule-edit-<%= r.id %>">
                <td colspan="4">
                  <form method="post" action="/profile/notifications/rules/<%= r.id %>/update" class="rule-form">
                    <div class="form-grid">
                      <div><label><%= t('Name') %></label><input type="text" name="name" value="<%= r.name %>" required></div>
                      <div>
                        <label><%= t('Trigger') %></label>
                        <select name="trigger_type" class="rule-trigger-select">
                          <% triggerTypes.filter(tt => !tt.off || tt.key === r.trigger_type).forEach(tt => { %><option value="<%= tt.key %>" <%= tt.key === r.trigger_type ? 'selected' : '' %>><%= tt.label %></option><% }) %>
                        </select>
                      </div>
                      <div>
                        <label><%= t('Enabled') %></label>
                        <%- toggleSwitch('enabled', r.enabled) %>
                      </div>
                    </div>

                    <div class="form-grid rule-fields" data-for="monitor_threshold" style="margin-top:0.85rem;">
                      <div>
                        <label><%= t('Monitor') %></label>
                        <select name="monitor_id">
                          <option value=""><%= t('Choose a monitor…') %></option>
                          <% monitors.forEach(m => { %><option value="<%= m.id %>" <%= r.config.monitor_id === m.id ? 'selected' : '' %>><%= m.label %></option><% }) %>
                        </select>
                      </div>
                      <div>
                        <label><%= t('Condition') %></label>
                        <select name="operator">
                          <option value="gt" <%= r.config.operator === 'gt' ? 'selected' : '' %>><%= t('> (greater than)') %></option>
                          <option value="gte" <%= r.config.operator === 'gte' ? 'selected' : '' %>><%= t('≥ (at least)') %></option>
                          <option value="lt" <%= r.config.operator === 'lt' ? 'selected' : '' %>><%= t('< (less than)') %></option>
                          <option value="lte" <%= r.config.operator === 'lte' ? 'selected' : '' %>><%= t('≤ (at most)') %></option>
                          <option value="eq" <%= r.config.operator === 'eq' ? 'selected' : '' %>><%= t('= (equals)') %></option>
                        </select>
                      </div>
                      <div><label><%= t('Value') %></label><input type="number" step="any" name="threshold_value" value="<%= r.config.value ?? '' %>"></div>
                    </div>
                    <label class="toggle-row rule-fields" data-for="monitor_threshold" style="margin-top:0.5rem;">
                      <input type="checkbox" name="notify_on_recover" <%= r.config.notify_on_recover ? 'checked' : '' %>>
                      <span><strong><%= t('Also notify on recovery') %></strong></span>
                    </label>

                    <div class="form-grid rule-fields" data-for="miniserver_status" style="margin-top:0.85rem;">
                      <div>
                        <label><%= t('Miniserver') %></label>
                        <select name="miniserver_id">
                          <option value=""><%= t('Any Miniserver') %></option>
                          <% miniservers.forEach(ms => { %><option value="<%= ms.id %>" <%= r.config.miniserver_id === ms.id ? 'selected' : '' %>><%= ms.name %></option><% }) %>
                        </select>
                      </div>
                    </div>

                    <div class="form-grid rule-fields" data-for="firmware_changed" style="margin-top:0.85rem;">
                      <div>
                        <label><%= t('Miniserver') %></label>
                        <select name="firmware_miniserver_id">
                          <option value=""><%= t('Any Miniserver') %></option>
                          <% miniservers.forEach(ms => { %><option value="<%= ms.id %>" <%= r.config.miniserver_id === ms.id ? 'selected' : '' %>><%= ms.name %></option><% }) %>
                        </select>
                      </div>
                    </div>

                    <div class="form-grid rule-fields" data-for="mqtt_client_status" style="margin-top:0.85rem;">
                      <div><label><%= t('MQTT username (blank = any client)') %></label><input type="text" name="mqtt_username" value="<%= r.config.username || '' %>"></div>
                    </div>

                    <div style="margin-top:0.6rem;">
                      <button type="submit" class="btn-edit"><%- icon('edit') %> <%= t('Save') %></button>
                    </div>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <div class="card">
    <h2><%= t('Subscriptions') %></h2>
    <p class="hint"><%= t('Get pinged on your own channel above whenever one of these admin-configured alerts fires — on top of whatever channel(s) an administrator already sends it to.') %> <%= t('Per alert you choose: channel, push, or both.') %></p>
    <% if (notifyRules.length === 0) { %>
      <p class="hint"><%= t('No admin-wide notification rules exist yet') %><% if (currentUser.isAdmin) { %> &mdash; <a href="/admin/notifications"><%= t('create one') %></a> <%= t('first') %><% } %><%= t(', then come back here to subscribe. (Your own rules above don\'t need this step.)') %></p>
    <% } else { %>
      <form method="post" action="/profile/notifications/subscriptions">
        <div style="display:flex; flex-direction:column; gap:0.75rem;">
          <% notifyRules.forEach(rule => { %>
            <label class="toggle-row">
              <input type="checkbox" name="rule_ids" value="<%= rule.id %>" <%= rule.subscribed ? 'checked' : '' %>>
              <span>
                <strong><%= rule.name %></strong>
                <span class="hint" style="margin:0; display:block;"><%= rule.triggerLabel %></span>
              </span>
              <select name="via_<%= rule.id %>" style="margin-left:auto; width:auto;" title="<%= t('Where it goes') %>" onclick="event.stopPropagation();">
                <% [['both', 'Channel and push'], ['channel', 'Only my channel'], ['push', 'Only push']].forEach(([v, lbl]) => { %><option value="<%= v %>" <%= rule.via === v ? 'selected' : '' %>><%= t(lbl) %></option><% }) %>
              </select>
            </label>
          <% }) %>
        </div>
        <div class="row-actions" style="justify-content:flex-end; margin-top:1rem;">
          <button type="submit" class="btn-edit"><%- icon('edit') %> <%= t('Save') %></button>
        </div>
      </form>
    <% } %>
  </div>
<% } %>

<script>
  // Shows only the field group matching the currently-selected trigger type — same pattern as the
  // admin Notifications page's own rule form (admin-notifications.ejs), duplicated rather than
  // shared since the two live on entirely separate pages.
  (function () {
    document.querySelectorAll('.rule-form').forEach(function (form) {
      var select = form.querySelector('.rule-trigger-select');
      if (!select) return;
      function applyVisibility() {
        form.querySelectorAll('.rule-fields').forEach(function (el) {
          el.hidden = el.dataset.for !== select.value;
        });
      }
      select.addEventListener('change', applyVisibility);
      applyVisibility();
    });
  })();
</script>

<%- include('partials/foot') %>
