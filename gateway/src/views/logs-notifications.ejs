<%- include('partials/head', { pageTitle: 'Logs', active: 'logs-notifications', refresh: 5, liveSwap: true, topbarRange: true, topbarRangeAction: '/logs/notifications', topbarRangeValue: range, topbarRangeExtra: { q: query.q, severity: query.severity } }) %>

<p class="hint">
  Every notification fired by a rule (<a href="/admin/notifications">Notifications settings</a>) or
  a monitor's own threshold ladder marked "Notify" &mdash; one entry per event, independent of how
  many channels it was sent to or whether delivery succeeded. Persisted in SQLite and kept for
  <strong><%= retentionDays %></strong> days &mdash;
  <% if (canEdit('settings')) { %><a href="/settings">change that in Settings</a><% } else { %>change that in Settings<% } %>.
</p>

<form method="get" action="/logs/notifications" class="form-grid" style="margin-bottom:1rem; align-items:end;">
  <%
    // Range itself now lives in the topbar (next to auto-refresh, see partials/head.ejs) as its
    // own separate auto-submitting mini-form — carried forward here as a hidden field so
    // submitting THIS form (Severity) doesn't silently drop whatever range was active. Severity
    // auto-submits on its own change (data-auto-submit-form, see public/auto-submit-select.js) —
    // no separate Apply button, and no Contains field either: the table's own "Filter…" search
    // bar right below already covers that, client-side, with no page reload needed.
  %>
  <input type="hidden" name="range" value="<%= range %>">
  <div>
    <label>Severity</label>
    <select name="severity" data-auto-submit-form>
      <option value="">Any</option>
      <option value="info" <%= query.severity === 'info' ? 'selected' : '' %>>Info</option>
      <option value="warning" <%= query.severity === 'warning' ? 'selected' : '' %>>Warning</option>
      <option value="critical" <%= query.severity === 'critical' ? 'selected' : '' %>>Critical</option>
    </select>
  </div>
</form>

<div class="filterable-table-card">
  <div class="table-toolbar">
    <div class="search-combo log-search-combo">
      <select class="log-search-field">
        <option value="time">Time</option>
        <option value="severity">Severity</option>
        <option value="title">Title</option>
        <option value="message" selected>Message</option>
        <option value="source">Source</option>
      </select>
      <div class="clearable-input-wrap">
        <input type="text" class="log-search-query" placeholder="Filter…">
        <button type="button" class="icon-btn clearable-input-clear log-search-clear" title="Clear filter" aria-label="Clear filter" hidden>&times;</button>
      </div>
    </div>
    <span class="log-selection-count hint" style="margin:0;"></span>
    <button type="button" class="btn-soft log-copy-selection" disabled><%- icon('copy') %> <span class="btn-label">Copy selection</span></button>
    <% if (canEdit('logs_notifications')) { %>
    <a href="/logs/notifications/export.txt"><button type="button" class="btn-soft"><%- icon('copy') %> Export .log</button></a>
    <% } %>
  </div>

  <div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th class="col-select" data-no-controls><input type="checkbox" class="log-select-all" title="Select all"></th>
        <th data-filter-key="time">Time</th><th data-filter-key="severity">Severity</th><th data-filter-key="title">Title</th><th data-filter-key="message">Message</th><th data-filter-key="source">Source</th>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach(r => { %>
        <% var sourceLink = notificationSourceLink(r.eventType, r.sourceId, canView); %>
        <tr>
          <td class="col-select"><input type="checkbox"></td>
          <td><%= formatDateTime(r.createdAt) %></td>
          <td><span class="badge <%= r.severity === 'critical' ? 'badge-off' : r.severity === 'warning' ? 'badge-warning' : 'badge-ok' %>"><%= r.severity %></span></td>
          <td><%= r.title %></td>
          <td class="log-line"><%= r.message %></td>
          <td><% if (sourceLink) { %><a href="<%= sourceLink %>"><%= r.sourceLabel %></a><% } else { %><%= r.sourceLabel || '' %><% } %></td>
        </tr>
      <% }) %>
      <% if (rows.length === 0) { %>
        <tr><td colspan="6" class="empty">No notifications recorded yet.</td></tr>
      <% } %>
    </tbody>
  </table>
  </div>
</div>

<script src="/log-select.js" defer></script>
<%- include('partials/foot') %>
