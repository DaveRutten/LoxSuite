<%- include('partials/head', { pageTitle: 'Logs', active: 'logs-notifications', refresh: 5, liveSwap: true, topbarRange: true, topbarRangeAction: '/logs/notifications', topbarRangeValue: range, topbarRangeExtra: { q: query.q, severity: query.severity, category: query.category } }) %>

<p class="hint">
  <%= t('Every notification fired by a rule (') %><a href="/admin/notifications"><%= t('Notifications settings') %></a><%= t(') or a monitor\'s own threshold ladder marked "Notify" — one entry per event, independent of how many channels it was sent to or whether delivery succeeded. Persisted in SQLite and kept for') %>
  <strong><%= retentionDays %></strong> <%= t('days —') %>
  <% if (canEdit('settings')) { %><a href="/settings"><%= t('change that in Settings') %></a><% } else { %><%= t('change that in Settings') %><% } %>.
</p>

<form method="get" action="/logs/notifications" class="form-grid" style="margin-bottom:1rem; align-items:end;">
  <%
    // Range itself now lives in the topbar (next to auto-refresh, see partials/head.ejs) as its
    // own separate auto-submitting mini-form — carried forward here as a hidden field so
    // submitting THIS form (Severity) doesn't silently drop whatever range was active. Severity
    // auto-submits on its own change (data-auto-submit-form, see public/auto-submit-select.js) —
    // no separate Apply button, and no Contains field either: the table's own "Filter…" search
    // bar right below already covers that, client-side, with no page reload needed.
  %>
  <input type="hidden" name="range" value="<%= range %>">
  <div>
    <label><%= t('Severity') %></label>
    <select name="severity" data-auto-submit-form>
      <option value=""><%= t('Any') %></option>
      <option value="info" <%= query.severity === 'info' ? 'selected' : '' %>><%= t('Info') %></option>
      <option value="warning" <%= query.severity === 'warning' ? 'selected' : '' %>><%= t('Warning') %></option>
      <option value="critical" <%= query.severity === 'critical' ? 'selected' : '' %>><%= t('Critical') %></option>
    </select>
  </div>
  <div>
    <label><%= t('Category') %></label>
    <select name="category" data-auto-submit-form>
      <option value=""><%= t('Any') %></option>
      <% categories.forEach(c => { %>
        <option value="<%= c.key %>" <%= query.category === c.key ? 'selected' : '' %>><%= c.label %></option>
      <% }) %>
    </select>
  </div>
</form>

<div class="filterable-table-card">
  <div class="table-toolbar">
    <div class="search-combo log-search-combo">
      <select class="log-search-field">
        <option value="time"><%= t('Time') %></option>
        <option value="severity"><%= t('Severity') %></option>
        <option value="category"><%= t('Category') %></option>
        <option value="title"><%= t('Title') %></option>
        <option value="message" selected><%= t('Message') %></option>
        <option value="source"><%= t('Source') %></option>
      </select>
      <div class="clearable-input-wrap">
        <input type="text" class="log-search-query" placeholder="<%= t('Filter…') %>">
        <button type="button" class="icon-btn clearable-input-clear log-search-clear" title="<%= t('Clear filter') %>" aria-label="<%= t('Clear filter') %>" hidden>&times;</button>
      </div>
    </div>
    <span class="log-selection-count hint" style="margin:0;"></span>
    <button type="button" class="btn-soft log-copy-selection" disabled><%- icon('copy') %> <span class="btn-label"><%= t('Copy selection') %></span></button>
    <% if (canEdit('logs_notifications')) { %>
    <a href="/logs/notifications/export.txt"><button type="button" class="btn-soft"><%- icon('copy') %> <%= t('Export .log') %></button></a>
    <% } %>
  </div>

  <div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th class="col-select" data-no-controls><input type="checkbox" class="log-select-all" title="<%= t('Select all') %>"></th>
        <th data-filter-key="time"><%= t('Time') %></th><th data-filter-key="severity"><%= t('Severity') %></th><th data-filter-key="category"><%= t('Category') %></th><th data-filter-key="title"><%= t('Title') %></th><th data-filter-key="message"><%= t('Message') %></th><th data-filter-key="source"><%= t('Source') %></th>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach(r => { %>
        <% var sourceLink = notificationSourceLink(r.eventType, r.sourceId, canView, r.sourceRef); %>
        <tr>
          <td class="col-select"><input type="checkbox"></td>
          <td><%= formatDateTime(r.createdAt) %></td>
          <td><span class="badge <%= r.severity === 'critical' ? 'badge-off' : r.severity === 'warning' ? 'badge-warning' : 'badge-ok' %>"><%= r.severity %></span></td>
          <td><%= categoryLabel(r.eventType) %></td>
          <td><%= r.title %></td>
          <td class="log-line"><%= r.message %></td>
          <td><% if (sourceLink) { %><a href="<%= sourceLink %>"><%= r.sourceLabel %></a><% } else { %><%= r.sourceLabel || '' %><% } %></td>
        </tr>
      <% }) %>
      <% if (rows.length === 0) { %>
        <tr><td colspan="7" class="empty"><%= t('No notifications recorded yet.') %></td></tr>
      <% } %>
    </tbody>
  </table>
  </div>
</div>

<script src="/log-select.js" defer></script>
<%- include('partials/foot') %>
