<%- include('partials/head', { pageTitle: 'Live Data', active: 'live-data', refresh: 60, liveSwap: true }) %>

<p class="hint">
  Every control the selected Miniserver's structure file knows about, grouped by room and then by
  category &mdash; the same grouping Loxone Config itself uses, so this works for any project, not
  just this one's specific setup. Rooms, categories, and values are all only fetched once you
  actually expand them &mdash; a structure file can list hundreds of controls, so reading all of
  them up front just to open this page would mean hundreds of requests to the Miniserver, and
  thousands of rows of HTML, before you've looked at any of it. Open values refresh automatically
  every few seconds.
</p>

<% if (liveStatus) { %>
  <p class="hint" id="live-status-hint" style="margin-bottom:1.25rem;">
    <strong>Live connection:</strong>
    <span class="badge badge-live <%= liveStatus.status === 'open' ? 'badge-ok' : liveStatus.status === 'connecting' ? 'badge-neutral' : 'badge-off' %>">
      <%= liveStatus.status === 'open' ? 'Connected' : liveStatus.status === 'connecting' ? 'Connecting…' : 'Not connected' %>
    </span>
    <span id="live-status-detail">
      <% if (liveStatus.status === 'open') { %>&mdash; <%= liveStatus.valueCount %> values live<% } %>
      <% if (liveStatus.error) { %>&mdash; <%= liveStatus.error %><% } %>
    </span>
  </p>
<% } %>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>


<%
  // Live Data needs an actual live connection to the Miniserver — one that's currently offline
  // has nothing to switch to here, so it's left out of the choice entirely rather than offered as
  // a selectable option that just won't work. Still included if it's the one CURRENTLY selected
  // (e.g. it just went offline after this page loaded) so the dropdown doesn't silently lose track
  // of what's actually being shown.
  const onlineMiniservers = miniservers.filter((ms) => ms.status === 'online' || ms.id === miniserverId);
%>
<% if (miniserverId && onlineMiniservers.length > 1) { %>
<form method="get" action="/live-data" class="form-grid" style="max-width:20rem; margin-bottom:1.25rem;">
  <div>
    <label>Miniserver</label>
    <select name="miniserver_id" onchange="this.form.submit()">
      <% onlineMiniservers.forEach(ms => { %>
        <option value="<%= ms.id %>" <%= ms.id === miniserverId ? 'selected' : '' %>><%= ms.name %></option>
      <% }) %>
    </select>
  </div>
</form>
<% } %>

<% if (miniservers.length === 0) { %>
  <p class="hint">No Miniservers added yet &mdash; add one on the <a href="/miniservers">Miniservers</a> page first.</p>
<% } else if (!error && rooms.length === 0) { %>
  <p class="empty">This Miniserver's structure file has no controls with a readable state.</p>
<% } %>

<% if (miniserverId) { %>
<%
  // padding-right matches .add-panel summary's own 1.4rem (not .table-toolbar's usual 1.1rem) so
  // Refresh here lines up with Suggest dashboard on every room row directly below it — those are
  // .add-panel cards, not .table-wrap ones, so this toolbar's normal right edge (calibrated for a
  // table's own cells) sits 0.3rem further right than the room rows it's stacked on top of here.
%>
<div class="table-toolbar" style="margin-bottom:1.25rem; border-radius:var(--radius); border:1px solid var(--border); padding-right:1.4rem;">
  <% if (rooms.length > 0) { %>
  <div class="search-combo" style="max-width:100%;">
    <select id="live-data-filter-field">
      <option value="room">Room</option>
      <option value="control">Control / state (in opened rooms)</option>
    </select>
    <div class="clearable-input-wrap">
      <input type="text" id="live-data-filter-query" placeholder="Filter…">
      <button type="button" id="live-data-filter-clear" class="icon-btn clearable-input-clear" title="Clear filter" aria-label="Clear filter" hidden>&times;</button>
    </div>
  </div>
  <% } %>
  <a href="/live-data?miniserver_id=<%= miniserverId %>&refresh=1"><button type="button" class="btn-soft" title="Re-read this Miniserver's structure file — picks up rooms/controls added in Loxone Config since the gateway last read it"><%- icon('refresh') %> Refresh</button></a>
</div>
<% } %>

<div id="live-data-rooms">
<% rooms.forEach(room => { %>
  <details class="add-panel live-data-room" data-room-uuid="<%= room.roomUuid %>" data-miniserver-id="<%= miniserverId %>">
    <summary>
      <%= room.name %>
      <span class="hint live-data-room-summary-count" style="margin:0;">(<%= room.categoryCount %> categor<%= room.categoryCount === 1 ? 'y' : 'ies' %>, <%= room.controlCount %> control<%= room.controlCount === 1 ? '' : 's' %>)</span>
      <%
        // Rides in the same right-aligned slot as Suggest dashboard just below (see
        // .live-data-inline-bulk in style.css) rather than its own standalone full-width bar —
        // shows/hides identically on EVERY room's own copy since selection is tracked globally
        // (checkboxes can span rooms), all wired to the same document-level state in the script
        // near the bottom of this file.
      %>
      <span class="live-data-inline-bulk hint">
        <span class="live-data-bulk-count"></span>
        <button type="button" class="primary live-data-bulk-widget" title="Add every selected control as a dashboard widget"><%- icon('plus') %> Widget selected</button>
        <button type="button" class="primary live-data-bulk-monitor" title="Monitor every selected control"><%- icon('plus') %> Monitor selected</button>
        <button type="button" class="btn-soft live-data-bulk-clear">Clear selection</button>
      </span>
      <% if (suggestionsEnabled) { %>
        <button type="button" class="btn-soft suggest-dashboard-btn" title="Generate a starter dashboard for this room">Suggest dashboard</button>
      <% } %>
    </summary>
    <div class="add-panel-body live-data-room-body">
      <p class="hint" style="margin:0;">Loading&hellip;</p>
    </div>
  </details>
  <% if (suggestionsEnabled) { %>
    <!-- Deliberately a sibling of <details>, not a child — a native <details> hides every child
         except <summary> whenever it's closed, which would silently swallow this preview (toggled
         via our own `hidden` attribute) any time the room itself isn't expanded. -->
    <div class="suggest-preview" hidden></div>
  <% } %>
<% }) %>
</div>

<script>
  (function () {
    // Every state uuid on this Miniserver already tracked by a monitor (routes/liveData.js) — a
    // Set for O(1) lookups per row, since buildMonitorForm below runs once per state, potentially
    // hundreds of times on a room with a lot of controls. On window, not just this IIFE's own
    // local scope — the "Checkbox selection + bulk +Monitor/+Widget" script further down this
    // file is a SEPARATE top-level IIFE and needs this same Set too (confirmed live: referencing
    // the un-hoisted local from there threw "monitoredUuids is not defined" on every checkbox
    // check, silently aborting that whole change handler — including the updateBar() call after
    // it, which is why the bulk bar then never appeared at all instead of just missing its warning
    // styling).
    var monitoredUuids = new Set(<%- JSON.stringify(monitoredUuids || []) %>);
    window.monitoredUuids = monitoredUuids;
    // Every state uuid whose monitor already has at least one dashboard panel pinned to it — same
    // "show what's already true about this row" idea, just for the Widget side (routes/liveData.js).
    var widgetedUuids = new Set(<%- JSON.stringify(widgetedUuids || []) %>);
    window.widgetedUuids = widgetedUuids;

    function el(tag, attrs, children) {
      var node = document.createElement(tag);
      Object.keys(attrs || {}).forEach(function (k) {
        if (k === 'text') node.textContent = attrs[k];
        else node.setAttribute(k, attrs[k]);
      });
      (children || []).forEach(function (c) { if (c) node.appendChild(c); });
      return node;
    }

    // Every state row gets its own tiny action forms, built here rather than server-side — there
    // just isn't a server-rendered row until a category is actually opened. window.
    // stampCsrfTokens() (partials/foot.ejs) only stamps forms present at page load, so it has to
    // be re-run after inserting these or the CSRF check would reject the submit. Mirrors the pair
    // of buttons Live Messages has for an MQTT topic (incoming-messages.ejs): "Monitor" just
    // starts tracking history, "Widget" also pins a Current-value panel onto the Home dashboard —
    // same green (primary), since both create something new.
    function buildMonitorForm(miniserverId, uuid, label) {
      var form = el('form', { method: 'post', action: '/monitor', class: 'inline' });
      form.appendChild(el('input', { type: 'hidden', name: 'source_type', value: 'loxone' }));
      form.appendChild(el('input', { type: 'hidden', name: 'miniserver_id', value: miniserverId }));
      form.appendChild(el('input', { type: 'hidden', name: 'loxone_uuid', value: uuid }));
      form.appendChild(el('input', { type: 'hidden', name: 'label', value: label }));
      // Greyed out (not just left clickable and rejected server-side, see routes/monitor.js's own
      // existence check) once this exact value already has a monitor — the same value can't be
      // usefully tracked twice, it would just be two identical monitors independently polling and
      // logging the same reading.
      var alreadyMonitored = monitoredUuids.has(uuid);
      var btn = el('button', {
        type: 'submit',
        class: 'primary',
        title: alreadyMonitored ? 'Already being monitored' : 'Start recording this state\'s history on the Monitor page',
      });
      if (alreadyMonitored) btn.disabled = true;
      btn.innerHTML = alreadyMonitored ? '✓ Monitored' : '+ Monitor';
      form.appendChild(btn);
      return form;
    }

    function buildWidgetForm(miniserverId, uuid, label) {
      var form = el('form', { method: 'post', action: '/dashboards/quick-add-loxone', class: 'inline' });
      form.appendChild(el('input', { type: 'hidden', name: 'miniserver_id', value: miniserverId }));
      form.appendChild(el('input', { type: 'hidden', name: 'loxone_uuid', value: uuid }));
      form.appendChild(el('input', { type: 'hidden', name: 'label', value: label }));
      // Same "only once" treatment as +Monitor above — pinning the same value on the Dashboard a
      // second time would just leave two identical panels sitting side by side; routes/dashboards.js's
      // quick-add-loxone now rejects it server-side too.
      var alreadyWidgeted = widgetedUuids.has(uuid);
      var btn = el('button', {
        type: 'submit',
        class: 'primary',
        title: alreadyWidgeted ? 'Already pinned on the Dashboard' : 'Pin this value on the Dashboard — gets an auto-generated name',
      });
      if (alreadyWidgeted) btn.disabled = true;
      btn.innerHTML = alreadyWidgeted ? '✓ On Dashboard' : '+ Widget';
      form.appendChild(btn);
      return form;
    }

    // The Status column's own cell contents — 0-2 small badges, same purple .badge-purple class
    // used for the Miniservers page's Gateway/Client tags: this is a categorical "this already
    // exists elsewhere" flag, not a good/bad status verdict, so it deliberately doesn't borrow
    // .badge-ok's green (already meaning "online"/"enabled" elsewhere). A plain function (not built
    // once per row and cached) since bulkAdd below also calls this again, after a successful add,
    // to refresh a row's cell in place without a full page reload. Exposed on window so the
    // separate "bulk select" IIFE further down this file can call it too (see monitoredUuids above
    // for why a plain local var/function isn't visible there).
    function buildStatusBadges(uuid) {
      var badges = [];
      if (window.monitoredUuids.has(uuid)) badges.push(el('span', { class: 'badge badge-purple', text: 'Monitored' }));
      if (window.widgetedUuids.has(uuid)) badges.push(el('span', { class: 'badge badge-purple', text: 'Widget' }));
      return badges;
    }
    window.buildStatusBadges = buildStatusBadges;

    // Compact, single-line JSON rendering — {k: v, k: v} / [a, b, c] rather than an indented
    // multi-line dump. A short array like [778] or [1, 2, 778] has no business taking three lines,
    // and even a bigger one (moodList's array of mood objects) reads as one wrapped paragraph
    // instead of a block that dwarfs every other row in the same table. Caps recursion depth so a
    // deeply-nested value degrades to "…" instead of growing unbounded.
    function compactStringify(value, depth) {
      if (depth > 3) return typeof value === 'object' && value !== null ? '…' : String(value);
      if (Array.isArray(value)) {
        if (value.length === 0) return '[]';
        return '[' + value.map(function (v) { return compactStringify(v, depth + 1); }).join(', ') + ']';
      }
      if (value && typeof value === 'object') {
        var keys = Object.keys(value);
        if (keys.length === 0) return '{}';
        return '{' + keys.map(function (k) { return k + ': ' + compactStringify(value[k], depth + 1); }).join(', ') + '}';
      }
      return typeof value === 'string' ? JSON.stringify(value) : String(value);
    }

    // Loxone often reports a "state" as a JSON-encoded string (mood lists, circuit name maps,
    // daylight config, ...) rather than a plain number/text — shown raw, that's an unreadable
    // blob. Anything that actually parses as JSON is reformatted compactly instead; anything that
    // doesn't (plain numbers, "on"/"off", free text) is shown exactly as before.
    function renderValueCell(cell, v) {
      cell.innerHTML = '';
      if (v === null || v === undefined) {
        cell.appendChild(document.createTextNode('(unreadable)'));
        return;
      }
      var trimmed = typeof v === 'string' ? v.trim() : '';
      var looksLikeJson = trimmed.length > 1 && (trimmed[0] === '{' || trimmed[0] === '[');
      if (looksLikeJson) {
        try {
          var parsed = JSON.parse(trimmed);
          cell.appendChild(el('code', { text: compactStringify(parsed, 0), style: 'white-space:pre-wrap; word-break:break-word; font-size:0.82em;' }));
          return;
        } catch (e) { /* not actually valid JSON — fall through to plain text */ }
      }
      cell.appendChild(document.createTextNode(String(v)));
    }

    function buildCategory(miniserverId, cat) {
      var details = el('details', { class: 'live-data-category' });
      var uuids = [];
      cat.controls.forEach(function (c) { c.states.forEach(function (s) { uuids.push(s.uuid); }); });
      details.dataset.uuids = uuids.join(',');
      details.dataset.miniserverId = miniserverId;

      var summary = el('summary');
      summary.appendChild(document.createTextNode(cat.name + ' '));
      if (cat.type) summary.appendChild(el('span', { class: 'badge badge-neutral', text: cat.type }));
      summary.appendChild(el('span', { class: 'hint', style: 'margin:0;', text: ' (' + cat.controls.length + ' control' + (cat.controls.length === 1 ? '' : 's') + ')' }));
      details.appendChild(summary);

      var wrap = el('div', { class: 'table-wrap' });
      var table = el('table', { class: 'live-data-table' });
      // Every category builds its own independent <table> — without a shared, fixed set of column
      // widths, each one's Control/State/Value/Actions columns end up sized by that table's own
      // content, so two categories next to each other visually don't line up at all. A <colgroup>
      // with fixed percentages keeps every category's table the same shape regardless of content.
      table.appendChild(el('colgroup', {}, [
        el('col', { style: 'width:4%;' }),
        el('col', { style: 'width:18%;' }),
        el('col', { style: 'width:12%;' }),
        el('col', { style: 'width:34%;' }),
        el('col', { style: 'width:12%;' }),
        el('col', { style: 'width:20%;' }),
      ]));
      var thead = el('thead');
      thead.appendChild(el('tr', {}, [
        el('th', {}, [el('input', { type: 'checkbox', class: 'live-data-select-all', title: 'Select every row in this category' })]),
        el('th', { text: 'Control' }), el('th', { text: 'State' }), el('th', { text: 'Value' }), el('th', { text: 'Status' }), el('th', { text: 'Actions' }),
      ]));
      table.appendChild(thead);
      var tbody = el('tbody', { class: 'live-data-body' });

      cat.controls.forEach(function (control) {
        control.states.forEach(function (s) {
          var row = el('tr');
          var label = [control.name, s.stateName].filter(Boolean).join(' / ');
          var checkbox = el('input', {
            type: 'checkbox', class: 'live-data-row-select',
            'data-miniserver-id': miniserverId, 'data-uuid': s.uuid, 'data-label': label,
          });
          row.appendChild(el('td', {}, [checkbox]));
          row.appendChild(el('td', {}, [document.createTextNode(control.name + ' '), el('span', { class: 'hint', style: 'margin:0;', text: '(' + control.type + ')' })]));
          row.appendChild(el('td', { text: s.stateName }));
          row.appendChild(el('td', { 'data-value-for': s.uuid, class: 'hint' }, [document.createTextNode('…')]));
          row.appendChild(el('td', { 'data-status-for': s.uuid }, buildStatusBadges(s.uuid)));
          var actions = el('div', { class: 'row-actions' }, [
            buildWidgetForm(miniserverId, s.uuid, label),
            buildMonitorForm(miniserverId, s.uuid, label),
          ]);
          row.appendChild(el('td', {}, [actions]));
          tbody.appendChild(row);
        });
      });
      table.appendChild(tbody);
      wrap.appendChild(table);
      details.appendChild(wrap);

      function fetchValues() {
        if (!uuids.length) return;
        fetch('/live-data/values?miniserver_id=' + encodeURIComponent(miniserverId) + '&uuids=' + encodeURIComponent(uuids.join(',')))
          .then(function (r) { return r.json(); })
          .then(function (values) {
            Object.keys(values).forEach(function (uuid) {
              var cell = tbody.querySelector('[data-value-for="' + uuid + '"]');
              if (!cell) return;
              renderValueCell(cell, values[uuid]);
              cell.classList.remove('hint');
            });
          })
          .catch(function () { /* best-effort — cells just keep showing whatever they last had */ });
      }

      var loaded = false;
      details.addEventListener('toggle', function () {
        if (!details.open || loaded) return;
        loaded = true;
        fetchValues();
      });
      // Exposed so the page-wide refresh loop below can re-poll only categories that are both
      // open and have actually loaded once already — no point refreshing collapsed ones, and a
      // still-loading one will get its values from the toggle handler above instead.
      details.refreshLiveValues = function () { if (details.open && loaded) fetchValues(); };

      return details;
    }

    var RANGE_PRESETS = [['1h', 'Last hour'], ['24h', 'Last 24 hours'], ['7d', 'Last 7 days'], ['30d', 'Last 30 days'], ['all', 'All']];
    var POLL_INTERVALS = [[5000, '5 seconds'], [10000, '10 seconds'], [30000, '30 seconds'], [60000, '1 minute'], [300000, '5 minutes']];
    // Same 6 types and labels as the regular "Add panel" form (partials/panel-grid.ejs) — a
    // bucket's own panelType (dashboardSuggestions.js's BUCKET_BY_KEY) is only the starting
    // point, overridable per bucket before creating the dashboard.
    var PANEL_TYPE_LABELS = [
      ['chart', 'Chart'], ['table', 'Table'], ['value', 'Current value'],
      ['gauge', 'Gauge'], ['stat_delta', 'Stat with change'], ['threshold', 'Threshold indicator'],
    ];

    // "Suggest dashboard" — the button lives inside <summary>, so a click on it has to be stopped
    // from also toggling the room open/closed (the browser's default behaviour for any click
    // inside a <summary>). The preview itself is a plain sibling <div>, shown/hidden by us, so it
    // works whether the room's own detail panel is expanded or not.
    function buildSuggestPreview(preview, miniserverId, roomUuid) {
      preview.innerHTML = '<p class="hint" style="margin:0;">Loading suggestions&hellip;</p>';
      preview.hidden = false;
      fetch('/live-data/suggest?miniserver_id=' + encodeURIComponent(miniserverId) + '&room_uuid=' + encodeURIComponent(roomUuid))
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.error) { preview.innerHTML = '<p class="error">' + data.error + '</p>'; return; }
          if (!data.buckets || data.buckets.length === 0) {
            preview.innerHTML = '<p class="hint" style="margin:0;">Nothing in this room matches a known suggestion type (lighting, climate, shading, energy).</p>';
            return;
          }
          preview.innerHTML = '';

          var settingsRow = el('div', { class: 'suggest-settings-grid' });
          var nameInput = el('input', { type: 'text', value: data.roomName });
          settingsRow.appendChild(el('div', {}, [el('label', { text: 'Dashboard name' }), nameInput]));

          var rangeSelect = el('select', {}, RANGE_PRESETS.map(function (r) {
            return el('option', { value: r[0], text: r[1] });
          }));
          rangeSelect.value = '24h';
          settingsRow.appendChild(el('div', {}, [el('label', { text: 'Default range' }), rangeSelect]));

          var pollSelect = el('select', {}, POLL_INTERVALS.map(function (p) {
            return el('option', { value: String(p[0]), text: p[1] });
          }));
          pollSelect.value = '10000';
          settingsRow.appendChild(el('div', {}, [el('label', { text: 'Refresh interval' }), pollSelect]));
          preview.appendChild(settingsRow);

          var list = el('div', { class: 'suggest-bucket-list' });
          // key -> { box, addPicker } for every bucket actually shown on this page — populated as
          // each bucket is built below, then used by every row's own panel-select (added further
          // down) to move a row into a DIFFERENT bucket's box on demand. Declared before the loop
          // since a row built for bucket A needs to already be able to target bucket B, built
          // later in the same pass.
          var boxes = {};
          var allBuckets = data.buckets.map(function (b) { return { key: b.key, label: b.label }; });

          // Moves (or, for a freshly-built row, first-time places) row into bucketKey's box, right
          // before that box's own "+ Add" picker so the picker always stays the last thing in it.
          function moveRow(row, bucketKey) {
            var target = boxes[bucketKey];
            if (!target) return;
            target.box.insertBefore(row, target.addPicker);
          }

          data.buckets.forEach(function (bucket) {
            var bucketBox = el('div', { class: 'suggest-bucket' });
            var typeSelect = el('select', { class: 'suggest-panel-type-select', 'data-bucket-key': bucket.key, title: 'Panel type' }, PANEL_TYPE_LABELS.map(function (t) {
              return el('option', { value: t[0], text: t[1] });
            }));
            typeSelect.value = bucket.panelType;
            bucketBox.appendChild(el('div', { class: 'suggest-bucket-title' }, [
              document.createTextNode(bucket.label + ' '),
              typeSelect,
            ]));

            var rowCounter = 0;
            // addPicker has to already be a real child of bucketBox before addRow() below can
            // insertBefore() against it as a reference node — built and attached first, empty/
            // hidden, then populated by refreshAddOptions() once the initial rows exist.
            var addPicker = el('div', { class: 'suggest-add-row', hidden: true });
            var addSelect = el('select', {});
            var addBtn = el('button', { type: 'button', class: 'btn-soft' });
            addBtn.innerHTML = '+ Add';
            addPicker.appendChild(addSelect);
            addPicker.appendChild(addBtn);
            bucketBox.appendChild(addPicker);
            boxes[bucket.key] = { box: bucketBox, addPicker: addPicker };

            // One row per control by default (its own PRIMARY_STATE pick, e.g. Climate's
            // tempActual) — a control with more than one state worth watching (Climate's
            // tempTarget alongside tempActual) still only gets that one row here, switchable via
            // its own dropdown to any ONE of its states. addRow()/the "+ Add" picker below is what
            // lets a second row for the SAME control's other state get added alongside it, so both
            // can be pinned as separate panel items instead of it being either/or.
            function addRow(item, initialUuid) {
              var rowId = 'suggest-' + roomUuid + '-' + bucket.key + '-' + (rowCounter++);
              var row = el('div', { class: 'suggest-item-row' });
              var checkbox = el('input', { type: 'checkbox', id: rowId, checked: 'checked' });
              row.appendChild(checkbox);
              row.appendChild(el('label', { for: rowId, text: item.controlName }));
              var stateSelect = el('select', { 'data-bucket-key': bucket.key }, item.availableStates.map(function (s) {
                return el('option', { value: s.uuid, text: s.stateName });
              }));
              stateSelect.value = initialUuid;
              row.appendChild(stateSelect);

              // Which panel this item ends up in — defaults to the bucket it was auto-suggested
              // into (or added under), but every bucket currently on the page is offered, so a
              // wrongly-guessed item (or one you'd just rather see elsewhere) can be moved without
              // starting over. Only offers buckets already shown here, not the full fixed list —
              // an empty bucket type (e.g. no Media items in this room) never got built at all.
              var panelSelect = el('select', { title: 'Panel', 'aria-label': 'Panel' }, allBuckets.map(function (b) {
                return el('option', { value: b.key, text: b.label });
              }));
              panelSelect.value = bucket.key;
              panelSelect.addEventListener('change', function () {
                stateSelect.dataset.bucketKey = panelSelect.value;
                moveRow(row, panelSelect.value);
              });
              row.appendChild(panelSelect);

              checkbox.addEventListener('change', function () {
                stateSelect.disabled = !checkbox.checked;
                panelSelect.disabled = !checkbox.checked;
              });
              stateSelect.addEventListener('change', refreshAddOptions);
              moveRow(row, bucket.key);
              return row;
            }

            // Every state of every control already represented in this bucket, minus whichever
            // ones already have their own row anywhere on the page (not just this bucket — a row
            // moved elsewhere via its panel-select still "uses up" that state, same as if it'd
            // never left) — e.g. once Climate's tempActual row exists, this offers tempTarget (same
            // control) until that's added too, then the picker just hides itself.
            function refreshAddOptions() {
              addSelect.innerHTML = '';
              var existingUuids = Array.from(list.querySelectorAll('.suggest-item-row select[data-bucket-key]')).map(function (s) { return s.value; });
              bucket.items.forEach(function (item) {
                item.availableStates.forEach(function (s) {
                  if (existingUuids.indexOf(s.uuid) !== -1) return;
                  var opt = el('option', { value: s.uuid, text: item.controlName + ' / ' + s.stateName });
                  opt.dataset.item = JSON.stringify(item);
                  addSelect.appendChild(opt);
                });
              });
              addPicker.hidden = addSelect.options.length === 0;
            }

            addBtn.addEventListener('click', function () {
              var opt = addSelect.selectedOptions[0];
              if (!opt) return;
              addRow(JSON.parse(opt.dataset.item), opt.value);
              refreshAddOptions();
            });

            bucket.items.forEach(function (item) { addRow(item, item.uuid); });
            refreshAddOptions();
            list.appendChild(bucketBox);
          });
          preview.appendChild(list);

          var createBtn = el('button', { type: 'button', class: 'primary', style: 'margin-top:0.6rem;' });
          createBtn.innerHTML = '+ Create dashboard';
          var status = el('span', { class: 'hint', style: 'margin-left:0.6rem;' });
          createBtn.addEventListener('click', function () {
            var items = [];
            list.querySelectorAll('.suggest-item-row').forEach(function (row) {
              var checkbox = row.querySelector('input[type="checkbox"]');
              var stateSelect = row.querySelector('select');
              if (checkbox.checked) items.push({ uuid: stateSelect.value, bucketKey: stateSelect.dataset.bucketKey });
            });
            if (items.length === 0) { status.textContent = 'Pick at least one.'; return; }
            var panelTypes = {};
            list.querySelectorAll('.suggest-panel-type-select').forEach(function (select) {
              panelTypes[select.dataset.bucketKey] = select.value;
            });
            createBtn.disabled = true;
            status.textContent = 'Creating…';
            fetch('/live-data/suggest', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                miniserver_id: miniserverId,
                room_uuid: roomUuid,
                dashboard_name: nameInput.value,
                range: rangeSelect.value,
                poll_interval_ms: pollSelect.value,
                items: items,
                panel_types: panelTypes,
              }),
            })
              .then(function (r) { return r.json(); })
              .then(function (result) {
                if (result.error) { status.textContent = result.error; createBtn.disabled = false; return; }
                preview.innerHTML = '';
                preview.appendChild(el('p', { class: 'hint', style: 'margin:0;', text: 'Dashboard created. ' }));
                var link = el('a', { href: '/dashboards/' + result.dashboardId, text: 'Open it →' });
                preview.appendChild(link);
              })
              .catch(function () { status.textContent = 'Something went wrong.'; createBtn.disabled = false; });
          });
          preview.appendChild(createBtn);
          preview.appendChild(status);
        })
        .catch(function () { preview.innerHTML = '<p class="error">Could not load suggestions.</p>'; });
    }

    document.querySelectorAll('.suggest-dashboard-btn').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var roomDetails = btn.closest('.live-data-room');
        var preview = roomDetails.nextElementSibling;
        if (!preview.hidden) { preview.hidden = true; return; }
        buildSuggestPreview(preview, roomDetails.dataset.miniserverId, roomDetails.dataset.roomUuid);
      });
    });

    document.querySelectorAll('.live-data-room').forEach(function (roomDetails) {
      var loaded = false;
      roomDetails.addEventListener('toggle', function () {
        if (!roomDetails.open || loaded) return;
        loaded = true;
        var body = roomDetails.querySelector('.live-data-room-body');
        var miniserverId = roomDetails.dataset.miniserverId;
        fetch('/live-data/room?miniserver_id=' + encodeURIComponent(miniserverId) + '&room_uuid=' + encodeURIComponent(roomDetails.dataset.roomUuid))
          .then(function (r) { return r.json(); })
          .then(function (room) {
            body.innerHTML = '';
            (room.categories || []).forEach(function (cat) {
              body.appendChild(buildCategory(miniserverId, cat));
            });
            if (!room.categories || room.categories.length === 0) {
              body.appendChild(el('p', { class: 'hint', style: 'margin:0;', text: 'No categories with a readable state in this room.' }));
            }
            // Only now that every category (and its "+ Monitor" forms) is actually attached to
            // the document can stampCsrfTokens() find them via its own document-wide query —
            // calling it any earlier (e.g. inside buildCategory, on a still-detached element)
            // silently stamps nothing, and the resulting forms fail CSRF on submit.
            if (window.stampCsrfTokens) window.stampCsrfTokens();
          })
          .catch(function () {
            body.innerHTML = '';
            body.appendChild(el('p', { class: 'error', text: 'Could not load this room.' }));
          });
      });
    });

    // Values now come from the Miniserver's own live websocket push feed (see loxoneWebSocket.js)
    // instead of a one-off fetch per category expand, so refreshing an already-open category is
    // just re-reading our own in-memory cache — cheap enough to do every few seconds.
    setInterval(function () {
      document.querySelectorAll('.live-data-category[open]').forEach(function (details) {
        if (details.refreshLiveValues) details.refreshLiveValues();
      });
    }, 3000);

    <% if (liveStatus) { %>
    (function () {
      var badge = document.querySelector('#live-status-hint .badge');
      var detail = document.getElementById('live-status-detail');
      function poll() {
        fetch('/live-data/status?miniserver_id=<%= miniserverId %>')
          .then(function (r) { return r.json(); })
          .then(function (s) {
            badge.className = 'badge ' + (s.status === 'open' ? 'badge-ok' : s.status === 'connecting' ? 'badge-neutral' : 'badge-off');
            badge.textContent = s.status === 'open' ? 'Connected' : s.status === 'connecting' ? 'Connecting…' : 'Not connected';
            detail.textContent = s.status === 'open' ? ('— ' + s.valueCount + ' values live') : (s.error ? '— ' + s.error : '');
          })
          .catch(function () { /* leave the last known status showing */ });
      }
      setInterval(poll, 5000);
    })();
    <% } %>
  })();
</script>
<script>
  // Rooms and their categories are only fetched once expanded (see the big IIFE above), so
  // "Control / state" filtering auto-expands every room the moment a query is typed (below) purely
  // to have something to check a match against — a room whose fetch is still in flight (or that
  // failed) stays visible rather than guessing, but that's a brief transitional state now, not a
  // "you have to click it yourself to find out" one. "Room" filtering needs none of this since
  // every room's name is already in the initial page render.
  (function () {
    var fieldSelect = document.getElementById('live-data-filter-field');
    var queryInput = document.getElementById('live-data-filter-query');
    var clearBtn = document.getElementById('live-data-filter-clear');
    if (!fieldSelect) return;

    // Whether the PREVIOUS call actually filtered anything — lets an empty query skip straight
    // back out (the common case: this also runs on every DOM mutation anywhere on the page, see
    // the MutationObserver below, including every 3-second live-value refresh tick) while still
    // guaranteeing the one reset pass that clearing a real filter needs actually runs, exactly
    // once, instead of being skipped forever the way an unconditional early-return would.
    var hadFilter = false;

    function applyFilter() {
      var mode = fieldSelect.value;
      var q = queryInput.value.trim().toLowerCase();
      if (clearBtn) clearBtn.hidden = !q;

      // Auto-expand every not-yet-loaded room the instant a Control/state search is actually
      // typed — without this, the filter below can only ever act on whatever's ALREADY been
      // manually expanded (see its own comment further down), so a genuinely non-matching room
      // would just sit there until you happened to click it open yourself to find that out.
      // Setting .open here fires the same native `toggle` event a manual click does, so it reuses
      // that room's existing lazy-load fetch as-is — no second loading path to keep in sync — and
      // the MutationObserver below already re-runs this whole function once that fetch's content
      // actually lands, so a non-matching room disappears the moment that becomes known.
      if (mode === 'control' && q) {
        document.querySelectorAll('.live-data-room:not([open])').forEach(function (roomDetails) {
          roomDetails.open = true;
        });
      }

      if (!q) {
        if (!hadFilter) return;
        hadFilter = false;
        document.querySelectorAll('.live-data-room').forEach(function (roomDetails) {
          roomDetails.style.display = '';
          var preview = roomDetails.nextElementSibling;
          if (preview && preview.classList.contains('suggest-preview')) preview.style.display = '';
          roomDetails.querySelectorAll('.live-data-category').forEach(function (cat) {
            cat.style.display = '';
            cat.querySelectorAll('.live-data-body tr').forEach(function (row) { row.style.display = ''; });
          });
        });
        return;
      }
      hadFilter = true;

      document.querySelectorAll('.live-data-room').forEach(function (roomDetails) {
        var preview = roomDetails.nextElementSibling;
        var hasPreview = preview && preview.classList.contains('suggest-preview');

        if (mode === 'room') {
          var roomName = roomDetails.querySelector('summary').textContent.toLowerCase();
          var show = roomName.indexOf(q) !== -1;
          roomDetails.style.display = show ? '' : 'none';
          if (hasPreview) preview.style.display = show ? '' : 'none';
          return;
        }

        // mode === 'control': any already-loaded category's individual rows get filtered, and a
        // category with zero matching rows collapses out of view entirely. The room itself then
        // follows suit — hidden once every one of its loaded categories came up empty — EXCEPT
        // when the room hasn't been expanded at all yet (zero categories loaded, so there's
        // nothing to check a match against) or still has an unloaded category of its own (rows.
        // length === 0 counts as "unknown", not "no match", for the same reason) — either way,
        // hiding it would be a guess this filter can't actually back up, so it stays visible.
        var categories = roomDetails.querySelectorAll('.live-data-category');
        var anyCategoryVisible = false;
        categories.forEach(function (cat) {
          var rows = cat.querySelectorAll('.live-data-body tr');
          var anyMatch = false;
          rows.forEach(function (row) {
            var text = row.textContent.toLowerCase();
            var match = text.indexOf(q) !== -1;
            if (match) anyMatch = true;
            row.style.display = match ? '' : 'none';
          });
          var showCategory = rows.length === 0 || anyMatch;
          cat.style.display = showCategory ? '' : 'none';
          if (showCategory) anyCategoryVisible = true;
        });
        var showRoom = categories.length === 0 || anyCategoryVisible;
        roomDetails.style.display = showRoom ? '' : 'none';
        if (hasPreview) preview.style.display = showRoom ? '' : 'none';
      });
    }

    // Debounced on typing only (not the field-select change, and not the MutationObserver below) —
    // applyFilter walks every room/category/row in the whole page (hundreds of controls on a real
    // structure), so running it on every single keystroke made fast typing visibly lag behind. A
    // short pause after the last keystroke is imperceptible but lets several keystrokes in a row
    // share one filter pass instead of one each.
    var debounceTimer = null;
    queryInput.addEventListener('input', function () {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(applyFilter, 250);
    });
    fieldSelect.addEventListener('change', applyFilter);
    // Re-applies once a room/category finishes lazily loading, so an already-typed filter keeps
    // working on content that didn't exist yet when it was first typed.
    new MutationObserver(applyFilter).observe(document.body, { childList: true, subtree: true });

    if (clearBtn) {
      clearBtn.addEventListener('click', function () {
        queryInput.value = '';
        applyFilter();
        queryInput.focus();
      });
    }
    // Escape clears rather than also bubbling up to close some other overlay (e.g. the account
    // menu) that happens to also listen for it — an active filter is the more specific, more
    // likely-intended thing to dismiss first while focus is actually in this field.
    queryInput.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape' || !queryInput.value) return;
      e.stopPropagation();
      queryInput.value = '';
      applyFilter();
    });
  })();
</script>

<script>
  // Checkbox selection + bulk +Monitor/+Widget across every room/category on the page — event
  // delegation throughout (not per-row listeners at creation time) since rows are built lazily as
  // rooms/categories are expanded, well after this script has already run once.
  (function () {
    // One .live-data-inline-bulk copy per room (see its own comment in the markup above) rather
    // than a single global bar — all driven from the SAME selection state below, so every copy
    // shows/hides and updates its count in lockstep regardless of which room's checkboxes changed.
    var clusters = Array.prototype.slice.call(document.querySelectorAll('.live-data-inline-bulk'));
    if (!clusters.length) return;
    updateBar(); // sets the correct initial disabled state (nothing selected yet) now that the bar itself is always visible rather than starting hidden

    function selectedCheckboxes() {
      return Array.prototype.slice.call(document.querySelectorAll('.live-data-row-select:checked'));
    }

    function updateBar() {
      // Per-room, not one global count for every copy — each cluster lives inside ONE room's own
      // <summary> (see the markup above), and its own bar should only appear once THAT room has a
      // selection, not whenever ANYTHING anywhere on the page does (the earlier version's single
      // shared `n` made every OTHER room's bar pop up right along with it, which read as random).
      // Monitor selected additionally goes disabled the moment ANY ONE of THIS room's selected
      // controls already has a monitor — not just once every one of them does. Letting the click
      // through for a selection that's only PARTLY already-monitored would still get rejected for
      // that subset (routes/monitor.js), just less predictably than blocking it up front the same
      // way a single already-monitored row's own +Monitor button is blocked.
      clusters.forEach(function (cluster) {
        var room = cluster.closest('.live-data-room');
        var boxes = room ? Array.prototype.slice.call(room.querySelectorAll('.live-data-row-select:checked')) : [];
        var n = boxes.length;
        var anyMonitored = n > 0 && boxes.some(function (cb) { return window.monitoredUuids.has(cb.dataset.uuid); });
        var anyWidgeted = n > 0 && boxes.some(function (cb) { return window.widgetedUuids.has(cb.dataset.uuid); });
        cluster.hidden = n === 0;
        cluster.querySelector('.live-data-bulk-count').textContent = n + ' selected';
        var widgetBtn = cluster.querySelector('.live-data-bulk-widget');
        var monitorBtn = cluster.querySelector('.live-data-bulk-monitor');
        widgetBtn.disabled = n === 0 || anyWidgeted;
        widgetBtn.title = anyWidgeted ? 'Deselect the control(s) already pinned on the Dashboard first' : 'Pin every selected control on the Dashboard';
        monitorBtn.disabled = n === 0 || anyMonitored;
        monitorBtn.title = anyMonitored ? 'Deselect the already-monitored control(s) first' : 'Monitor every selected control';
      });
    }

    document.addEventListener('change', function (e) {
      if (e.target.classList.contains('live-data-select-all')) {
        var tbody = e.target.closest('table').querySelector('.live-data-body');
        tbody.querySelectorAll('.live-data-row-select').forEach(function (cb) { cb.checked = e.target.checked; });
        updateBar();
        return;
      }
      if (e.target.classList.contains('live-data-row-select')) {
        // Keep that category's own "select all" box in sync — checked only once every one of its
        // rows is, indeterminate for a partial selection, same tri-state convention as any other
        // bulk-select-all checkbox.
        var table = e.target.closest('table');
        var selectAll = table.querySelector('.live-data-select-all');
        var boxes = Array.prototype.slice.call(table.querySelectorAll('.live-data-row-select'));
        var checkedCount = boxes.filter(function (cb) { return cb.checked; }).length;
        selectAll.checked = checkedCount === boxes.length;
        selectAll.indeterminate = checkedCount > 0 && checkedCount < boxes.length;
        updateBar();
      }
    });

    function clearSelection() {
      selectedCheckboxes().forEach(function (cb) { cb.checked = false; });
      document.querySelectorAll('.live-data-select-all').forEach(function (cb) { cb.checked = false; cb.indeterminate = false; });
      updateBar();
    }

    // JSON body — csrf.js exempts application/json requests from the CSRF check entirely (see
    // partials/foot.ejs's own stampCsrfTokens comment), so these need no token of their own, and
    // the existing /monitor and /dashboards/quick-add-loxone routes read req.body identically
    // either way (express.json() populates it the same shape express.urlencoded() would).
    // `siblingClass` re-labels every OTHER room's copy of the same button too, not just the one
    // actually clicked, so all of them read "Adding N…" together instead of just the one under
    // whichever room summary happened to be clicked.
    // Refreshes ONE row's Status badges + its own +Monitor button in place — called after a
    // successful add (single OR bulk) so the row reflects reality immediately, without needing a
    // full page reload the way the classic (non-JS) form submit underneath still gets it for free.
    function refreshRowState(uuid) {
      var cell = document.querySelector('td[data-status-for="' + uuid + '"]');
      if (cell) { cell.innerHTML = ''; window.buildStatusBadges(uuid).forEach(function (b) { cell.appendChild(b); }); }
      var monForm = document.querySelector('form[action="/monitor"] input[name="loxone_uuid"][value="' + uuid + '"]');
      if (monForm && window.monitoredUuids.has(uuid)) {
        var btn = monForm.closest('form').querySelector('button');
        btn.disabled = true;
        btn.title = 'Already being monitored';
        btn.innerHTML = '✓ Monitored';
      }
      var widgetForm = document.querySelector('form[action="/dashboards/quick-add-loxone"] input[name="loxone_uuid"][value="' + uuid + '"]');
      if (widgetForm && window.widgetedUuids.has(uuid)) {
        var wbtn = widgetForm.closest('form').querySelector('button');
        wbtn.disabled = true;
        wbtn.title = 'Already pinned on the Dashboard';
        wbtn.innerHTML = '✓ On Dashboard';
      }
    }

    function bulkAdd(url, buildBody, siblingClass, label, targetSet, dupLabel) {
      var boxes = selectedCheckboxes();
      if (boxes.length === 0) return;
      var buttons = Array.prototype.slice.call(document.querySelectorAll('.' + siblingClass));
      buttons.forEach(function (b) { b.disabled = true; b.textContent = 'Adding ' + boxes.length + '…'; });
      Promise.allSettled(boxes.map(function (cb) {
        return fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(buildBody(cb)),
        }).then(function (r) {
          if (r.ok) return { ok: true };
          // routes/monitor.js's own duplicate rejection answers JSON with isDuplicate — checked
          // here (rather than just counting every non-ok response as one flat "failed") so a
          // bulk "Monitor selected" that included some already-monitored controls tells the user
          // WHY those didn't get added instead of reading as an unexplained partial failure. Any
          // other error shape (network failure, a route that doesn't send this field) falls back
          // to plain "failed" — the total count is still right either way.
          return r.json().then(
            function (body) { return { ok: false, isDuplicate: !!body.isDuplicate }; },
            function () { return { ok: false, isDuplicate: false }; }
          );
        });
      })).then(function (results) {
        var outcomes = results.map(function (r) { return r.status === 'fulfilled' ? r.value : { ok: false, isDuplicate: false }; });
        var duplicates = outcomes.filter(function (o) { return !o.ok && o.isDuplicate; }).length;
        var otherFailed = outcomes.filter(function (o) { return !o.ok && !o.isDuplicate; }).length;
        var added = boxes.length - duplicates - otherFailed;
        // Every successfully-added box's uuid joins the relevant Set right away — Monitor and
        // Widget hit two DIFFERENT sets (see the two call sites below), so which one to update is
        // passed in rather than guessed from the url.
        outcomes.forEach(function (o, i) {
          if (!o.ok) return;
          var uuid = boxes[i].dataset.uuid;
          targetSet.add(uuid);
          refreshRowState(uuid);
        });
        buttons.forEach(function (b) { b.disabled = false; b.textContent = label; });
        clearSelection();
        var parts = [];
        if (added) parts.push(added + (added === 1 ? ' item added' : ' items added'));
        if (duplicates) parts.push(duplicates + ' ' + dupLabel + ', skipped');
        if (otherFailed) parts.push(otherFailed + (otherFailed === 1 ? ' failed' : ' failed'));
        window.alert(parts.join(', ') + '.');
      });
    }

    // Buttons live inside <summary>, so a click needs stopping from also toggling that room open
    // or closed — same reasoning/pattern as .suggest-dashboard-btn's own click handler above.
    document.querySelectorAll('.live-data-bulk-clear').forEach(function (btn) {
      btn.addEventListener('click', function (e) { e.preventDefault(); e.stopPropagation(); clearSelection(); });
    });
    document.querySelectorAll('.live-data-bulk-monitor').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        bulkAdd('/monitor', function (cb) {
          return { source_type: 'loxone', miniserver_id: cb.dataset.miniserverId, loxone_uuid: cb.dataset.uuid, label: cb.dataset.label };
        }, 'live-data-bulk-monitor', btn.textContent, window.monitoredUuids, 'already monitored');
      });
    });
    document.querySelectorAll('.live-data-bulk-widget').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        bulkAdd('/dashboards/quick-add-loxone', function (cb) {
          return { miniserver_id: cb.dataset.miniserverId, loxone_uuid: cb.dataset.uuid, label: cb.dataset.label };
        }, 'live-data-bulk-widget', btn.textContent, window.widgetedUuids, 'already on the Dashboard');
      });
    });
  })();
</script>

<script>
  // Background structure refresh — driven by the shared auto-refresh timer (partials/head.ejs's
  // refresh:60/liveSwap:true above gives this page the same topbar interval/pause control every
  // other auto-refreshing page has; partials/foot.ejs's own tick() calls window.refreshTables()
  // after each one). liveSwap's generic swapFrom() only touches [data-live-id] elements and
  // .table-wrap/.panel-table tbodies — none of which this page's server-rendered HTML contains
  // (every category table here is built client-side after a room is opened, see the big IIFE
  // above), so it's a safe no-op here and this function is the only thing that actually runs.
  //
  // Deliberately narrow: only refreshes each EXISTING room's own category/control count text —
  // never touches which rooms/categories are open or what's already loaded inside them, so nothing
  // collapses or flickers. A genuinely new/removed room (Loxone Config rarely changes this) falls
  // back to one plain reload rather than duplicating this file's own <details>-building markup a
  // second time in JS just to insert/remove one client-side without a refresh.
  window.refreshTables = function () {
    var anyRoom = document.querySelector('.live-data-room');
    if (!anyRoom) return;
    var miniserverId = anyRoom.dataset.miniserverId;
    fetch('/live-data/rooms?miniserver_id=' + encodeURIComponent(miniserverId))
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.rooms) return;
        var existingRooms = document.querySelectorAll('.live-data-room');
        if (data.rooms.length !== existingRooms.length) { location.reload(); return; }
        data.rooms.some(function (room) {
          var details = document.querySelector('.live-data-room[data-room-uuid="' + room.roomUuid + '"]');
          if (!details) { location.reload(); return true; }
          var countSpan = details.querySelector('.live-data-room-summary-count');
          if (countSpan) {
            countSpan.textContent = '(' + room.categoryCount + ' categor' + (room.categoryCount === 1 ? 'y' : 'ies') + ', ' + room.controlCount + ' control' + (room.controlCount === 1 ? '' : 's') + ')';
          }
          return false;
        });
      })
      .catch(function () { /* best-effort — counts just stay as they were until the next tick */ });
  };
</script>

<%- include('partials/foot') %>
