<%- include('partials/head', { pageTitle: only === 'solar' ? 'Solar panels' : 'Heat pump', active: 'energymanager' }) %>
<%
  const hpS = heatpump || {}; const soS = solar || {};
  const nf = (v, d = 1) => (v === null || v === undefined || !Number.isFinite(Number(v)) ? '—' : Number(v).toLocaleString('nl-NL', { minimumFractionDigits: d, maximumFractionDigits: d }));
  // a duration in minutes, readable: 45 min · 3,5 uur · 189 dagen
  const dur = (min) => { const m = Number(min) || 0; return m < 120 ? nf(m, 0) + ' min' : m < 2880 ? nf(m / 60, m < 600 ? 1 : 0) + ' ' + t('hours') : nf(m / 1440, 0) + ' ' + t('days'); };
  const hhmm = (ms) => { const d = new Date(ms); return d.toLocaleTimeString('nl-NL', { hour: '2-digit', minute: '2-digit', timeZone: displayTimezone || 'UTC' }); };
  const day = (ms) => new Date(ms).toLocaleString('nl-NL', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: displayTimezone || 'UTC' });
  const modeText = { dhw: t('Tap water'), heating: t('Heating'), idle: t('Idle'), defrost: t('Defrosting'), fault: t('Fault'), legionella: t('Legionella'), free: t('Heating / Loxone itself') };
%>
<style>
  .mm-kpis { display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:0.6rem; margin:0.6rem 0; }
  .mm-kpi { background:var(--surface-alt); border-radius:var(--radius); padding:0.5rem 0.7rem; }
  .mm-kpi b { display:block; font-size:1.2rem; } .mm-kpi span { font-size:0.78rem; color:var(--text-muted); }
  .mm-strip { display:grid; grid-template-columns:repeat(24,1fr); gap:2px; align-items:end; height:110px; margin-top:0.4rem; }
  .mm-hr { position:relative; display:flex; flex-direction:column; justify-content:flex-end; height:100%; }
  .mm-hr .bar { border-radius:3px 3px 0 0; background:var(--border); min-height:2px; } .mm-hr.dhw .bar { background:#3b82f6; } .mm-hr.sun .bar { background:#f2b632; }
  .mm-hr .ice { position:absolute; top:12px; left:0; right:0; text-align:center; color:#3b82f6; font-size:0.7rem; }
  .mm-hr .lbl { font-size:0.65rem; color:var(--text-muted); text-align:center; margin-top:2px; } .mm-hr .drop { position:absolute; top:0; left:0; right:0; text-align:center; color:var(--danger); font-size:0.7rem; }
  .mm-k-room { background:var(--accent); height:3px !important; } .mm-k-roomf { border-top:2px dashed #f59e0b; background:none !important; height:0 !important; } .mm-k-tank { border-top:2px dashed #3b82f6; background:none !important; height:0 !important; }
  .mm-sub { border-top:1px solid var(--border); margin-top:1rem; padding-top:0.8rem; } .mm-sub h3 { margin:0 0 0.3rem; font-size:1rem; }
  .mm-table td, .mm-table th { white-space:normal; vertical-align:top; } .mm-table select, .mm-table input { width:100%; font-size:0.85rem; }
  .mm-warn { background:var(--warning-soft); color:var(--warning); border-radius:8px; padding:0.4rem 0.6rem; font-size:0.83rem; margin-top:0.5rem; }
  .mm-log { font-size:0.8rem; } .mm-log td { white-space:normal; }
  .mm-head { display:flex; flex-wrap:wrap; gap:0.6rem 0.9rem; align-items:flex-end; }
  .mm-head .mm-f { display:flex; flex-direction:column; gap:0.3rem; min-width:150px; }
  .mm-head .mm-f > label { margin:0; font-size:0.85rem; color:var(--text-muted); }
  .mm-head .mm-grow { flex:1 1 220px; }
  .mm-head select { width:100%; }
  .mm-actions { display:flex; gap:0.5rem; flex-wrap:wrap; }
  .mm-actions .btn-soft { white-space:nowrap; }
  .mm-switch { height:2.4rem; display:flex; align-items:center; }
  .mm-toggle { display:flex; gap:0.6rem; align-items:center; margin:0.3rem 0; } .mm-toggle > label:last-child { margin:0; font-weight:normal; cursor:pointer; }
  .mm-toggle .switch { flex:none; }
  .mm-settings > summary { font-size:1rem; }
  .mm-status { margin:0.5rem 0 0; font-size:0.85rem; color:var(--text-muted); }
  .mm-sub.mm-off .mm-ifon { display:none; }
  .mm-sub.mm-off > :not(h3):not(.mm-master):not([data-keep]) { display:none; }
  .mm-detail { margin-top:0.5rem; } .mm-detail > summary { cursor:pointer; margin:0; }
  .mm-wizard { background:color-mix(in srgb, var(--accent) 7%, transparent); border:1px solid color-mix(in srgb, var(--accent) 35%, transparent); border-radius:10px; padding:0.8rem 1rem; }
  .mm-wq { margin-top:0.6rem; } .mm-seg { display:flex; gap:1rem; flex-wrap:wrap; margin-top:0.25rem; } .mm-seg label { display:flex; gap:0.35rem; align-items:center; cursor:pointer; }
  .mm-legend { display:flex; flex-wrap:wrap; gap:0.2rem 0.9rem; font-size:0.78rem; color:var(--text-muted); margin-top:0.35rem; } .mm-legend > span { white-space:nowrap; margin:0 !important; }
  .mm-sum { font-size:0.85rem; color:var(--text-muted); }
  .mm-log .num { text-align:right; font-variant-numeric:tabular-nums; white-space:nowrap; }
  .mm-sugs { display:grid; gap:0.4rem; } .mm-sug-head { cursor:pointer; } .mm-sug-head strong { font-size:1rem; }
  .mm-sug { display:flex; gap:0.6rem; align-items:baseline; padding:0.5rem 0.7rem; border-radius:8px; border-left:3px solid var(--accent); background:color-mix(in srgb, var(--accent) 6%, transparent); font-size:0.9rem; }
  .mm-sug-k { font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:0.03em; min-width:6.5rem; color:var(--text-muted); }
  .mm-sug-comfort { border-left-color:#e67e22; background:color-mix(in srgb, #e67e22 7%, transparent); }
  .mm-sug-energy { border-left-color:var(--en-solar); background:color-mix(in srgb, var(--en-solar) 7%, transparent); }
  .mm-steps { margin:0.4rem 0 0.2rem 1.2rem; padding:0; font-size:0.88rem; } .mm-steps li { margin:0.15rem 0; }
  .mm-autosave { margin:0.8rem 0 0; }
  .mm-toast { position:fixed; right:1.2rem; bottom:1.2rem; z-index:1000; padding:0.55rem 0.9rem; border-radius:10px; background:var(--card-bg, #fff); border:1px solid var(--border); box-shadow:0 6px 24px rgba(0,0,0,0.15); font-size:0.9rem; }
  .mm-toast-bad { border-color:var(--danger); color:var(--danger); }
</style>

<% if (saved) { %><p class="hint" style="color: var(--success);"><%= t('Saved.') %></p><% } %>
<p class="hint"><a href="/energy-manager"><%= t('← Energy manager') %></a> · <%= only === 'solar' ? t('The solar inverter, found in Loxone; limited when exporting costs money under your contract.') : t('The heat pump, found in Loxone like the Home Connect appliances. LoxSuite decides, Loxone carries it out and keeps the safety limits.') %></p>

<% function moduleHead(kind, st) { const cfg = st.cfg || {}; %>
  <div class="mm-head">
    <div class="mm-f"><label for="<%= kind %>-enabled"><%= t('Active') %></label><div class="mm-switch"><%- toggleSwitch('enabled', cfg.enabled, { id: kind + '-enabled' }) %></div></div>
    <div class="mm-f"><label><%= t('Mode') %></label><select data-f="mode"><option value="shadow" <%= cfg.mode !== 'live' ? 'selected' : '' %>><%= t('Shadow (show only)') %></option><option value="live" <%= cfg.mode === 'live' ? 'selected' : '' %>><%= t('Live (send to Loxone)') %></option></select></div>
    <div class="mm-f mm-grow"><label><%= t('Device in Loxone') %></label><select data-f="device">
      <% (st.found || []).filter((c) => !c.error).forEach((c) => { %><option value="<%= c.miniserver.id %>|<%= c.uuid %>" <%= st.chosen && st.chosen.uuid === c.uuid ? 'selected' : '' %>><%= c.name %><%= c.room ? ' · ' + c.room : '' %> (<%= c.miniserver.name %>)<%= c.ok ? '' : ' — ' + t('incomplete') %></option><% }) %>
      <option value="" <%= !st.chosen ? 'selected' : '' %>><%= t('None found — choose per role below') %></option>
    </select></div>
    <div class="mm-actions"><button type="button" class="btn-soft" data-rediscover="<%= kind %>"><%= t('Search again') %></button><button type="button" class="btn-soft" data-history="<%= kind %>" title="<%= t('Read history from Loxone') %>"><%= t('Read history') %></button></div>
  </div>
  <p class="mm-status" data-history-msg="<%= kind %>" hidden></p>
<% } %>
<% function heartbeatBox(kind, st) { const cfgH = st.cfg || {}; %>
  <div class="mm-sub" data-heartbeat><h3 class="en-h3"><%- enIcon('shield', 'var(--success)', { plain: true }) %><%= t('Safety net (heartbeat)') %></h3>
    <div class="form-grid" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr));">
      <div><label><%= t('Virtual input in Loxone') %></label><input type="text" data-f="heartbeat_vi" value="<%= cfgH.heartbeat_vi || '' %>" placeholder="<%= kind === 'solar' ? 'LoxSuite_Heartbeat_PV' : 'LoxSuite_Heartbeat_WP' %>"></div>
    </div>
    <details class="mm-detail"><summary class="mm-sum"><%= t('How to set it up in Loxone') %></summary>
      <ol class="mm-steps">
        <li><%= t('Create a virtual input with this name (digital).') %></li>
        <li><%= t('Connect it to a Monoflop of 300 s with "retrigger" on: its output is "LoxSuite alive".') %></li>
        <li><%= t('Only let LoxSuite\'s values through while that output is on; otherwise your own logic and setpoints apply.') %></li>
      </ol>
      <p class="mm-sum" style="margin:0.2rem 0 0;"><%= t('In live mode LoxSuite switches it on and off every minute. If LoxSuite stops, hangs or loses the network, the monoflop drops after 5 minutes and Loxone takes over by itself. Empty: no heartbeat.') %></p>
    </details>
    <p class="mm-sum" style="margin:0.5rem 0 0;"><%= t('Messages (legionella overdue, tank too cold, a fault, defrosting that does not end, a long limit, the heartbeat failing):') %> <a href="/admin/notifications?trigger_type=energy_device"><%= t('notification rule "Energy manager"') %></a></p>
  </div>
<% } %>
<% function moduleStatus(kind, st) { %>
  <p class="mm-status" data-hint-keep>
    <% if (st.check && st.check.ok) { %><span class="badge badge-ok"><%= t('complete') %></span><% } else { %><span class="badge badge-off"><%= t('incomplete') %></span> <%= t('missing:') %> <%= ((st.check && st.check.missing) || []).concat((st.check && st.check.notWritable) || []).join(', ') %><% } %>
    <% const nConf = (st.roles || []).filter((x) => x.conflict).length; if (nConf) { %> <span class="badge badge-warning"><%= t('{n} outputs also driven by Loxone', { n: nConf }) %></span><% } %>  <% if (st.chosen) { %> <%= t('Found in the Loxone structure: {n} roles recognised.', { n: st.chosen.score }) %><% if (st.chosen.known) { %> <%= t('Recognised as {name} ({p}% of the names).', { name: st.chosen.known.label, p: Math.round(st.chosen.known.share * 100) }) %><% } %><% } else { %> <%= t('Nothing found in Loxone yet: an output only shows up when it is visible in the Loxone app. Or import the template below.') %><% } %>
    <% const HB = st.heartbeat || {}; if (st.cfg && st.cfg.mode === 'live' && st.cfg.heartbeat_vi) { %> <span class="badge <%= HB.error ? 'badge-warning' : HB.okAt ? 'badge-ok' : 'badge-off' %>" title="<%= HB.error ? HB.error : '' %>">♥ <%= HB.error ? t('heartbeat fails') : HB.okAt ? t('heartbeat') + ' ' + hhmm(HB.okAt) : t('heartbeat: not sent yet') %></span><% } %>
  </p>
<% } %>

<% function rolesTable(kind, st) { %>
  <details class="mm-sub" <%= st.check && st.check.ok ? '' : 'open' %>><summary style="cursor:pointer;"><strong class="en-h3"><%- enIcon('link', 'var(--text-muted)', { plain: true }) %><%= t('Link with Loxone') %></strong> <span class="hint" style="margin:0;">— <%= t('per role: where it is read, how it is sent') %></span></summary>
  <div style="overflow-x:auto;"><table class="mm-table" data-roles="<%= kind %>"><thead><tr><th><%= t('Role') %></th><th><%= t('Read from') %></th><th><%= t('Send via') %></th></tr></thead><tbody>
  <% (st.roles || []).forEach((r) => { const cur = (st.cfg.links || {})[r.role] || {}; %>
    <tr data-role="<%= r.role %>">
      <td><strong><%= t(r.label) %></strong><% if (r.need) { %> <span class="badge badge-purple"><%= t('needed') %></span><% } %><% if (r.unit) { %> <span class="hint" style="margin:0;"><%= r.unit %></span><% } %>
        <% const val = st.values ? st.values[r.role] : undefined; if (val !== undefined) { %><div class="hint" style="margin:0.1rem 0 0;"><%= t('now:') %> <%= (st.values[r.role + 'Text'] || val) %></div><% } %></td>
      <td><select data-read data-default="<%= r.read && !r.read.own ? r.read.uuid : '' %>" data-had="<%= r.read || r.readOff ? '1' : '' %>">
          <% if (r.read) { %><option value="<%= r.read.uuid %>|<%= r.read.name %>" selected><%= r.read.name %></option><% } %>
          <% if (r.readOff && r.readFound) { %><option value="<%= r.readFound.uuid %>|<%= r.readFound.name %>"><%= r.readFound.name %></option><% } %>
          <% if (r.read || r.readOff) { %><option value="__none" <%= r.readOff ? 'selected' : '' %>><%= t('— do not read —') %></option><% } else { %><option value="" selected><%= (r.suggest || []).length ? t('— choose: {n} found by name —', { n: r.suggest.length }) : t('— not found —') %></option><% } %>
          <% if ((r.suggest || []).length) { %><optgroup label="<%= t('Found by name in your project') %>"><% r.suggest.forEach((o) => { %><option value="sg|<%= o.uuid %>|<%= o.control %>|<%= o.ms === undefined || o.ms === null ? '' : o.ms %>|<%= o.name %>"><%= o.name %><%= o.room ? ' · ' + o.room : '' %><%= o.msName ? ' (' + o.msName + ')' : '' %></option><% }) %></optgroup><% } %>
          <option value="__pick"><%= t('Other Loxone object / virtual output…') %></option>
        </select>
        <input type="text" data-read-pick list="mm-objects" placeholder="<%= t('search a Loxone object…') %>" style="display:none; margin-top:0.25rem;">
        <% if (!r.read && r.known) { %><div class="hint" style="margin:0.15rem 0 0;"><%= t('or add it in Loxone as a Modbus sensor (register {reg})', { reg: r.known.reg }) %></div><% } %></td>
      <td><% if (!r.canWrite) { %><span class="hint" style="margin:0;">—</span><% } else { const w = r.write || {}; %>
        <select data-write data-default="<%= cur.write ? '' : (w.via || '') %>">
          <% if (w.via === 'direct') { %><option value="direct|<%= w.uuid %>|<%= w.name %>" selected><%= t('Direct:') %> <%= w.name %></option><% } %>
          <option value="vi" <%= w.via === 'vi' ? 'selected' : '' %>><%= t('Virtual input') %></option>
          <option value="off" <%= w.via === 'off' || !w.via ? 'selected' : '' %>><%= t('Off (read only)') %></option>
          <option value="__pick"><%= t('Other Loxone object (direct)…') %></option>
        </select>
        <input type="text" data-vi value="<%= w.vi || r.vi %>" style="<%= w.via === 'vi' ? '' : 'display:none;' %> margin-top:0.25rem;">
        <input type="text" data-write-pick list="mm-actions" placeholder="<%= t('search a Loxone control…') %>" style="display:none; margin-top:0.25rem;">
        <% if (r.conflict) { %><div class="mm-warn" style="margin-top:0.3rem;"><%= t('Also driven by Loxone: set back to {now} at {t} (LoxSuite sent {sent}). Link it through a virtual input, or take it out of the Loxone logic.', { now: r.conflict.now, t: hhmm(r.conflict.seenAt), sent: r.conflict.sent }) %></div><% } %>
      <% } %></td>
    </tr>
  <% }) %>
  </tbody></table></div>
  <p class="hint" style="margin:0.4rem 0 0;"><%= t('Direct: LoxSuite sends to the Loxone object itself. Virtual input: LoxSuite sets it and your Loxone logic has the last word. Off: only read.') %></p>
  <p class="hint" style="margin:0.3rem 0 0;"><%= t('Not recognised because of another display name in Loxone ("Name shown")? LoxSuite only sees that name: choose "Other Loxone object" at the role and search it by that name — objects of every Miniserver (Gateway and Client) are listed.') %></p>
  </details>
<% } %>

<% function sentLog(st) { %>
  <details class="mm-sub"><summary style="cursor:pointer;"><strong><%= st.cfg && st.cfg.mode === 'live' ? t('Sent to Loxone') : t('Would send (shadow mode)') %></strong> <span class="hint" style="margin:0;">— <%= (st.writes && st.writes.length) ? t('{n} now', { n: st.writes.length }) : t('nothing now') %><%= st.sent && st.sent.length ? ' · ' + t('{n} in the log', { n: st.sent.length }) : '' %></span></summary>
  <% if (st.writes && st.writes.length) { %><p class="hint" style="margin:0 0 0.3rem;"><%= t('Now:') %> <% st.writes.forEach((w, i) => { const sh = (st.roles || []).find((x) => x.role === w.role); %><%= i ? ', ' : '' %><code><%= w.vi || (sh && sh.write && sh.write.name) || w.role %></code> = <%= w.value %><% }) %></p><% } else { %><p class="hint" style="margin:0 0 0.3rem;"><%= t('Nothing to send now.') %></p><% } %>
  <% if (st.sent && st.sent.length) { %><table class="mm-log"><thead><tr><th><%= t('Time') %></th><th><%= t('To') %></th><th><%= t('Value') %></th><th><%= t('Why') %></th></tr></thead><tbody>
    <% st.sent.slice().reverse().forEach((s) => { %><tr><td><%= hhmm(Date.parse(s.at)) %></td><td><code><%= s.name || s.target %></code><%= s.direct ? '' : ' (VI)' %><%= s.live ? '' : ' · ' + t('shadow') %><%= s.error ? ' · ' + s.error : '' %></td><td><%= s.value %></td><td><%= tr(s.why) %></td></tr><% }) %>
  </tbody></table><% } %>
  </details>
<% } %>

<% function importBox(kind) { %>
  <details class="mm-sub"><summary style="cursor:pointer;" class="hint"><%= t('Not found? Backup: import a Loxone template (.LxAddon / .xml)') %></summary>
    <div class="btn-row" style="margin-top:0.4rem; align-items:center;"><input type="file" accept=".LxAddon,.lxaddon,.xml" data-import-file="<%= kind %>"><button type="button" class="btn-soft" data-import="<%= kind %>"><%= t('Import') %></button></div>
    <p class="hint" data-import-msg="<%= kind %>" style="margin:0.3rem 0 0;"><%= t('An imported type adds the meaning of the values. Add the device in Loxone as well: then it is found here by itself.') %></p>
  </details>
<% } %>

<% if (only === 'heatpump') { %>
<div class="card" data-module="heatpump">
  <h2 class="en-h" style="margin-top:0;"><%- enIcon('heat', '#e67e22') %><%= t('Heat pump') %></h2>
  <% if (hpS.error) { %><p class="error"><%= hpS.error %></p><% } else { %>
  <% moduleStatus('heatpump', hpS) %>
  <% const FE = hpS.cfg.features || {}; const hasRole = (re) => (hpS.roles || []).some((r) => re.test(r.role) && (r.read || r.write));
     const fStep = FE.power_steps !== null && FE.power_steps !== undefined ? FE.power_steps : hasRole(/^powerStep$|^powerLimit/);
     const fNtc = FE.ntc !== null && FE.ntc !== undefined ? FE.ntc : hasRole(/^ntc/); %>
  <% if (!hpS.cfg.setup_done) { %>
  <div class="mm-sub mm-wizard" data-wizard>
    <h3 class="en-h3"><%- enIcon('gear', 'var(--accent)', { plain: true }) %><%= t('Set up your heat pump') %></h3>
    <p class="hint" style="margin:0 0 0.5rem;"><%= t('Not every heat pump can do the same. Three questions, so LoxSuite only shows and steers what yours has. You can change it later under Settings.') %></p>
    <div class="mm-wq"><b>1. <%= t('What kind of heat pump?') %></b>
      <div class="mm-seg"><% [['air', t('Air / water')], ['water', t('Water / water')], ['ground', t('Ground / water')]].forEach(([k, lbl]) => { %><label><input type="radio" name="wz_source" value="<%= k %>" <%= (hpS.cfg.source || 'air') === k ? 'checked' : '' %>> <%= lbl %></label><% }) %></div>
      <p class="hint" style="margin:0.2rem 0 0;"><%= t('Air / water: defrosting and the weather (temperature and humidity) matter a lot; water / ground: hardly.') %></p></div>
    <div class="mm-wq"><b>2. <%= t('Can Loxone limit its power (power steps via relays, or a percentage)?') %></b>
      <div class="mm-seg"><label><input type="radio" name="wz_steps" value="yes" <%= fStep ? 'checked' : '' %>> <%= t('Yes') %></label><label><input type="radio" name="wz_steps" value="no" <%= fStep ? '' : 'checked' %>> <%= t('No') %></label></div>
      <p class="hint" style="margin:0.2rem 0 0;"><%= t('For example two relays on the power-limit inputs of the unit. LoxSuite then learns which step gives the longest, calmest runs.') %></p></div>
    <div class="mm-wq"><b>3. <%= t('Does your Loxone logic show it a fake outdoor temperature (NTC)?') %></b>
      <div class="mm-seg"><label><input type="radio" name="wz_ntc" value="yes" <%= fNtc ? 'checked' : '' %>> <%= t('Yes') %></label><label><input type="radio" name="wz_ntc" value="no" <%= fNtc ? '' : 'checked' %>> <%= t('No') %></label></div>
      <p class="hint" style="margin:0.2rem 0 0;"><%= t('A resistor instead of the outdoor sensor, e.g. "Fake 14 graden": the heat pump then runs calmer with a lower flow temperature and a higher COP.') %></p></div>
    <div class="btn-row" style="margin-top:0.6rem;"><button type="button" class="primary" data-wizard-done><%= t('Done') %></button></div>
  </div>
  <% } %>
  <% const st = hpS.state || {}; const v = hpS.values || {}; %>
  <div class="mm-kpis">
    <div class="mm-kpi"><span class="en-kl"><%- enIcon('tank', '#3b82f6', { plain: true, size: 13 }) %><%= t('Tank') %></span><b><%= nf(st.tankC) %> °C</b><span><%= t('target') %> <%= nf(v.dhwSetpoint, 0) %> °C<%= v.dhwDrop !== undefined ? ' · ' + t('hysteresis') + ' ' + nf(v.dhwDrop, 0) + ' °C' : '' %></span></div>
    <div class="mm-kpi"><span class="en-kl"><%- enIcon('heat', '#e67e22', { plain: true, size: 13 }) %><%= t('Doing now') %></span><b><%= modeText[st.mode] || st.mode || '—' %></b><span><%= v.compressorHz !== undefined ? nf(v.compressorHz, 0) + ' Hz' : '' %><%= st.outdoorC !== null && st.outdoorC !== undefined ? ' · ' + t('outside') + ' ' + nf(st.outdoorC) + ' °C' : '' %></span></div>
    <div class="mm-kpi"><span class="en-kl"><%- enIcon('gauge', 'var(--en-export)', { plain: true, size: 13 }) %><%= t('COP now') %></span><b><%= nf(st.cop, 2) %></b><span><%= nf(st.thermalKw) %> kW <%= t('heat') %> / <%= nf(v.electricPower) %> kW</span></div>
    <div class="mm-kpi"><span class="en-kl"><%- enIcon('bolt', 'var(--en-import)', { plain: true, size: 13 }) %><%= t('Booster') %></span><b><%= st.boost ? t('on') : t('off') %></b><span><%= tr(st.boostWhy || '') %></span></div>
    <div class="mm-kpi"><span class="en-kl"><%- enIcon('chart', 'var(--en-price)', { plain: true, size: 13 }) %><%= t('Plan this hour') %></span><b><%= modeText[hpS.mode] || hpS.mode %></b><span><%= tr(hpS.reason || '') %></span></div>
  </div>

  <% const SG = hpS.suggestions || []; const SGN = hpS.cfg.step_names || {}, SGT = hpS.cfg.ntc_names || {};
     const sgSet = (x) => [Number.isFinite(x && x.flowC) ? t('flow {c} °C', { c: nf(x.flowC, 1) }) : null,
       fStep && x && Number.isFinite(x.step) ? (SGN[String(x.step)] || (x.step > 2 ? x.step + '%' : x.step === 0 ? t('full power') : t('step {n}', { n: x.step }))) : null,
       fNtc && x && Number.isFinite(x.ntc) ? (SGT[String(x.ntc)] || (x.ntc > 2 ? t('outdoor sensor fixed at {c} °C', { c: nf(x.ntc, 0) }) : x.ntc === 0 ? t('real outdoor temperature') : t('outdoor sensor fixed ({n})', { n: x.ntc }))) : null].filter(Boolean).join(' · '); %>
  <details class="mm-sub" data-suggestions open><summary class="mm-sug-head"><strong class="en-h3"><%- enIcon('bulb', 'var(--accent)', { plain: true }) %><%= t('Suggestions') %></strong> <span class="mm-sum"><%= SG.length ? '· ' + SG.length + ' — ' + [...new Set(SG.map((g) => ({ comfort: t('Comfort'), energy: t('Energy'), efficiency: t('Efficiency') }[g.kind])))].join(', ').toLowerCase() : '· ' + t('nothing to improve') %></span></summary>
    <% if (SG.length) { %><div class="mm-sugs" style="margin-top:0.4rem;"><% SG.forEach((g) => { %><div class="mm-sug mm-sug-<%= g.kind %>"><span class="mm-sug-k"><%= { comfort: t('Comfort'), energy: t('Energy'), efficiency: t('Efficiency') }[g.kind] %></span><span><%= t(g.text, Object.fromEntries(Object.entries(g.params || {}).map(([k, v]) => [k, k === 'setting' ? sgSet(v) : v && typeof v === 'object' && 'min' in v ? dur(v.min) : typeof v === 'number' ? nf(v, Number.isInteger(v) ? 0 : (k === 'cop' || k === 's' ? 2 : 1)) : tr(String(v))]))) %></span></div><% }) %></div>
    <% } else { %><p class="mm-sum" style="margin:0.3rem 0 0;"><%= t('Nothing to improve right now — it runs as well as it has learned.') %></p><% } %>
  </details>

  <div class="mm-sub"><h3 class="en-h3"><%- enIcon('chart', 'var(--en-price)', { plain: true }) %><%= hpS.cooling ? t('Plan: cooling and tap water, next 24 hours') : t('Plan: heating and tap water, next 24 hours') %></h3>
    <p class="hint" style="margin:0;">
      <% if ((hpS.plan || []).some((h) => h.estimated)) { %> <%= t('No prices yet: estimated.') %><% } %>
    </p>
    <%
      // drawn in the browser, in the same style as the Energy manager plan (LsChart: lanes, labels above
      // the data, point at it for that hour)
      const chData = { plan: (hpS.plan || []).slice(0, 24).map((h) => ({ ms: h.ms, does: h.does, roomTargetC: h.roomTargetC, roomC: h.roomC, predC: h.predC, outdoorC: h.outdoorC, rh: h.rh, price: h.price, estimated: !!h.estimated, cop: h.cop, defrost: h.defrost, drop: h.drop, reason: tr(h.reason || '') })),
        onAt: (hpS.roomForecast || {}).onAt || null, reachAt: (hpS.roomForecast || {}).reachAt || null, runs: (hpS.roomForecast || {}).runs || [], cooling: !!hpS.cooling,
        L: { does: t('What it does'), room: t('Room (°C)'), tank: t('Tank (°C)'), out: t('Outside (°C)'), outRh: t('Outside (°C) and humidity (%)'), rh: t('humidity'), price: t('Price (€/kWh)'), now: t('now'), on: t('on'), reach: t('at temperature'), target: t('room target'), roomF: t('room expected'), heating: hpS.cooling ? t('cooling') : t('heating'), cop: 'COP', defrost: t('expected defrosting'), drop: t('usual draw'),
          solar: hpS.cooling ? t('Cooling on solar') : t('Storing solar in the house'), dhw: t('Tap water'), legionella: t('Legionella'), preheat: t('Pre-heating'), comfort: t('Comfort'), cool: t('Cooling'), setback: t('Set back'), free: t('Heating / Loxone itself') } };
    %>
    <div id="mm-hp-plan" style="margin-top:0.4rem;"></div>
    <script type="application/json" id="mm-hp-plan-data"><%- JSON.stringify(chData).replace(/</g, '\\u003c') %></script>
    <div class="mm-legend"><% [['var(--en-solar)', hpS.cooling ? t('cooling on solar') : t('warmer on solar')], ['#3b82f6', t('tap water')], ['var(--en-import)', t('legionella')], ['#e67e22', t('pre-heating')], [hpS.cooling ? '#06b6d4' : 'var(--accent)', hpS.cooling ? t('cooling') : t('comfort')], ['var(--en-house)', t('set back')]].forEach(([c, l]) => { %><span style="white-space:nowrap; margin-right:0.8rem;"><i class="ls-key ls-key-col" style="background:<%= c %>;"></i> <%= l %></span><% }) %><span style="white-space:nowrap; margin-right:0.8rem;"><i class="ls-key ls-key-dash" style="border-top-color:var(--accent);"></i> <%= t('room target') %></span><span style="white-space:nowrap; margin-right:0.8rem;"><i class="ls-key" style="background:#e67e22;"></i> <%= t('room expected') %></span><span style="white-space:nowrap; margin-right:0.8rem;"><i class="ls-key ls-key-col" style="background:#e67e22;"></i> <%= hpS.cooling ? t('cooling') : t('heating') %></span><span style="white-space:nowrap; margin-right:0.8rem;"><i class="ls-key" style="background:#3b82f6;"></i> <%= t('tank') %></span><span style="white-space:nowrap; margin-right:0.8rem;"><i class="ls-key ls-key-dash" style="border-top-color:#06b6d4;"></i> <%= t('humidity') %></span><span><i class="ls-key ls-key-band" style="background:var(--danger); opacity:0.35;"></i> <%= t('usual draw') %></span><span style="white-space:nowrap; color:#3b82f6;">❄ <%= t('expected defrosting') %></span></div>
    <p class="hint" style="margin:0.3rem 0 0;"><%= t('The plan compares the cost per kWh of heat: the price divided by the COP expected in that hour\'s weather.') %></p>
  </div>

  <% const RP = hpS.report || []; const RN = RP[RP.length - 1]; const RY = RP.slice(-12); const sumY = (k) => RY.reduce((a, m) => a + (m[k] || 0), 0); %>
  <div class="mm-sub" data-report><h3 class="en-h3"><%- enIcon('euro', 'var(--en-export)', { plain: true }) %><%= t('What it brought') %></h3>
    <% if (RN) { %><div class="mm-kpis">
      <div class="mm-kpi"><span><%= t('Saved this month') %></span><b><%= RN.pricedShare > 0 ? '€ ' + nf(RN.savedEur, 2) : '—' %></b><span><%= t('against the same kWh at the day\'s average price') %></span></div>
      <div class="mm-kpi"><span><%= t('Heat pump this month') %></span><b><%= nf(RN.elecKwh, 0) %> kWh</b><span><%= RN.pricedShare > 0 ? '€ ' + nf(RN.costEur, 2) + ' · ' : '' %>SCOP <%= nf(RN.scop, 2) %></span></div>
      <div class="mm-kpi"><span><%= t('Last 12 months') %></span><b><%= sumY('pricedShare') > 0 ? '€ ' + nf(sumY('savedEur'), 2) : '—' %></b><span><%= nf(sumY('elecKwh'), 0) %> kWh · <%= t('{n} months', { n: RY.length }) %></span></div>
    </div>
    <details class="mm-detail"><summary class="mm-sum"><%= t('Per month') %></summary><div style="overflow-x:auto;"><table class="mm-log"><thead><tr><th><%= t('Month') %></th><th class="num"><%= t('Power') %></th><th class="num"><%= t('Heat') %></th><th class="num">SCOP</th><th class="num"><%= t('Costs') %></th><th class="num"><%= t('At day average') %></th><th class="num"><%= t('Saved') %></th></tr></thead><tbody>
      <% RP.slice().reverse().forEach((m) => { %><tr><td><%= new Date(m.month + '-15').toLocaleDateString('nl-NL', { month: 'long', year: 'numeric' }) %></td><td class="num"><%= nf(m.elecKwh, 0) %> kWh</td><td class="num"><%= nf(m.heatKwh, 0) %> kWh</td><td class="num"><%= nf(m.scop, 2) %></td><td class="num"><%= m.pricedShare > 0 ? '€ ' + nf(m.costEur, 2) : '—' %></td><td class="num"><%= m.pricedShare > 0 ? '€ ' + nf(m.flatEur, 2) : '—' %></td><td class="num"><%= m.pricedShare > 0 ? '€ ' + nf(m.savedEur, 2) : '—' %></td></tr><% }) %>
    </tbody></table></div><p class="mm-sum" style="margin:0.3rem 0 0;"><%= t('Saved: what the same power would have cost at the average price of each day, minus what it cost at the hours it really ran. Builds up from now on.') %></p></details>
    <% } else { %><p class="mm-sum" style="margin:0;"><%= t('Builds up from now on: power, heat, SCOP and costs per month.') %></p><% } %>
  </div>

  <div class="mm-sub" data-tapwater><h3 class="en-h3"><%- enIcon('drop', '#3b82f6', { plain: true }) %><%= t('Tap water') %></h3>
    <% const LR = hpS.learned || {}; const nextDhw = (hpS.plan || []).find((h) => h.does === 'dhw' || h.does === 'legionella'); const LMT = hpS.cfg.limits || {}; %>
    <div class="mm-kpis">
      <div class="mm-kpi"><span><%= t('Tank now') %></span><b><%= nf(st.tankC) %> °C</b><span><%= t('target') %> <%= nf(LMT.targetC, 0) %> °C · <%= t('never below') %> <%= nf(LMT.comfortMinC, 0) %> °C</span></div>
      <div class="mm-kpi"><span><%= t('Next heating of the tank') %></span><b><%= nextDhw ? hhmm(nextDhw.ms) : '—' %></b><span><%= nextDhw ? tr(nextDhw.reason || '') : t('not needed in the coming 24 hours') %></span></div>
      <div class="mm-kpi"><span><%= t('Usual draws') %></span><b style="font-size:1rem;"><%= (LR.patterns || []).length ? LR.patterns.map((p) => String(p.from).padStart(2, '0') + ':00').join(' · ') : '—' %></b><span><%= LR.fromPipe ? t('learned from the hot-water pipe') : t('learned from the tank temperature') %> · <%= t('{n} days', { n: nf(LR.days || 0, 0) }) %></span></div>
    </div>
    <details class="mm-detail"><summary class="mm-sum"><%= t('How it learns') %></summary>
      <p class="mm-sum" style="margin:0.3rem 0;"><%= LR.fromPipe ? t('Every jump of the hot-water pipe temperature is a draw.') : t('A tank that cools faster than it does on its own means hot water was drawn.') %>
        <% if (LR.threshold && LR.threshold.learned) { %><%= t('Standby loss of your tank: {c} °C/h; a draw is faster than {d} °C/h.', { c: nf(LR.threshold.baselineCph, 2), d: nf(LR.threshold.cph, 1) }) %><% } %>
        <%= t('{n} samples', { n: nf(LR.samples || 0, 0) }) %>.</p>
      <% if ((LR.patterns || []).length) { %><table class="mm-log"><thead><tr><th><%= t('Usually at') %></th><th><%= t('Tank drops') %></th></tr></thead><tbody><% LR.patterns.forEach((p) => { %><tr><td><%= String(p.from).padStart(2, '0') %>:00</td><td>−<%= nf(p.kwh, 1) %> °C</td></tr><% }) %></tbody></table><% } %>
      <% if ((LR.draws || []).length) { %><table class="mm-log" style="margin-top:0.4rem;"><thead><tr><th><%= t('Last draws') %></th><th><%= t('Duration') %></th><th><%= t('Tank drops') %></th></tr></thead><tbody><% LR.draws.slice().reverse().slice(0, 10).forEach((d) => { %><tr><td><%= day(d.startMs) %></td><td><%= dur(Math.max(1, Math.round((d.endMs - d.startMs) / 60000))) %></td><td>−<%= nf(d.dropC, 1) %> °C</td></tr><% }) %></tbody></table><% } %>
    </details>
  </div>

  <div class="mm-sub" data-room><h3 class="en-h3"><%- enIcon('thermo', '#e67e22', { plain: true }) %><%= t('Room temperature') %></h3>
    <% const RC = hpS.cfg.room || {}; const rp = hpS.room; %>
    <div class="mm-toggle mm-master"><label class="switch"><input type="checkbox" id="mm-r-enabled" data-r="enabled" <%= RC.enabled ? 'checked' : '' %>><span class="switch-track"><span class="switch-thumb"></span></span></label><label for="mm-r-enabled"><%= t('Plan the room temperature (pre-heat in time for comfort)') %></label></div>
    <div class="form-grid" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); margin-top:0.4rem;">
      <div><label><%= t('Room controller in Loxone') %></label><select data-r="controller"><option value=""><%= t('— none (own times below) —') %></option><% (hpS.controllers || []).forEach((c) => { %><option value="<%= c.value %>" <%= RC.controller === c.value || RC.controller === c.uuid ? 'selected' : '' %>><%= c.name %><%= c.room ? ' · ' + c.room : '' %> (<%= c.msName %>)</option><% }) %></select><p class="hint" style="margin:0.2rem 0 0;"><%= t('Its actual and target temperature (and humidity) are read; the comfort times are learned from its target.') %></p></div>
      <div><label><%= t('Comfort times') %></label><select data-r="schedule" name="hp_room_schedule"><option value="loxone" <%= RC.schedule !== 'own' ? 'selected' : '' %>><%= t('Learned from the Loxone room controller') %></option><option value="own" <%= RC.schedule === 'own' ? 'selected' : '' %>><%= t('Own times below') %></option></select></div>
    </div>
    <% const SC = rp && rp.schedule; if (SC && SC.all) { const WD = [t('Mon'), t('Tue'), t('Wed'), t('Thu'), t('Fri'), t('Sat'), t('Sun')]; %>
    <p class="mm-status" data-hint-keep><%= t('Learned from Loxone:') %> <%= nf(SC.comfortC) %> °C <% [0,1,2,3,4,5,6].forEach((wd) => { const d = SC.days[wd]; if (d) { %> · <%= WD[wd] %> <%= d.from %>–<%= d.until || '…' %><% } }) %>, <%= t('otherwise') %> <%= nf(SC.setbackC) %> °C<%= rp.fromLoxone ? '' : ' (' + t('not used: own times') + ')' %></p>
    <% } %>
    <div class="form-grid" style="grid-template-columns:repeat(auto-fit,minmax(130px,1fr)); margin-top:0.4rem;" data-show-if="hp_room_schedule=own">
      <div><label><%= t('Comfort (°C)') %></label><input type="text" data-r="comfort_c" value="<%= RC.comfort_c %>"></div>
      <div><label><%= t('Comfort from') %></label><input type="text" data-r="comfort_from" value="<%= RC.comfort_from %>"></div>
      <div><label><%= t('Comfort until') %></label><input type="text" data-r="comfort_until" value="<%= RC.comfort_until %>"></div>
      <div><label><%= t('Set back to (°C)') %></label><input type="text" data-r="setback_c" value="<%= RC.setback_c %>"></div>
    </div>
    <div class="form-grid" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); margin-top:0.4rem;">
      <div><label><%= hpS.cooling ? t('Cool extra on solar (°C)') : t('Warmer on solar (°C)') %></label><input type="text" data-r="solar_boost_c" value="<%= RC.solar_boost_c ?? 0.5 %>"><p class="mm-sum" style="margin:0.2rem 0 0;"><%= t('the house as a battery; 0 = off') %></p></div>
      <div><label><%= t('From a solar surplus of (kWh per hour)') %></label><input type="text" data-r="solar_min_kwh" value="<%= RC.solar_min_kwh ?? 1 %>"></div>
    </div>
    <% if (rp) { %><div class="mm-kpis">
      <div class="mm-kpi"><span><%= t('Room now') %></span><b><%= nf(st.roomC) %> °C</b><span><%= t('setpoint now') %> <%= nf(rp.setpointNow) %> °C · <%= tr(rp.why) %></span></div>
      <div class="mm-kpi"><span><%= t('Warms up') %></span><b><%= nf(rp.rate.rate, 2) %> °C/h</b><span><%= rp.rate.learned ? t('learned at this outdoor temperature') : t('start value, still learning') %></span></div>
      <% const RF2 = hpS.roomForecast; %><div class="mm-kpi"><span><%= t('Expected') %></span><b style="font-size:1rem;"><%= RF2 && RF2.onAt ? t('on at {t}', { t: hhmm(RF2.onAt) }) : t('no heating needed') %></b><span><%= RF2 && RF2.reachAt ? t('at temperature at {t}', { t: hhmm(RF2.reachAt) }) : '' %><%= RF2 && RF2.cooling ? ' · ' + (RF2.cooling.learned ? t('cools down learned') : t('cools down: start value')) : '' %></span></div>
      <div class="mm-kpi"><span><%= t('Next comfort') %></span><b><%= day(rp.comfortAt) %></b><span><%= rp.preheat ? t('start pre-heating at {t} ({h} h before)', { t: hhmm(rp.preheat.startMs), h: nf(rp.preheat.hours, 1) }) : t('already warm enough') %></span></div>
    </div><% } %>
    <p class="hint" style="margin:0.3rem 0 0;"><%= t('Tap water is planned right before or after pre-heating the room, never in between.') %></p>
  </div>

  <div class="mm-sub" data-tuning><h3 class="en-h3"><%- enIcon('tune', 'var(--accent)', { plain: true }) %><%= t('Fine-tuning for long, calm runs') %></h3>
    <% const TU = hpS.tuning || {}; const TC = hpS.cfg.tuning || {}; const SN2 = hpS.cfg.step_names || {}, NN2 = hpS.cfg.ntc_names || {}; const stepTxt = (v) => (v === null || v === undefined ? null : SN2[String(v)] || (v > 2 ? v + '%' : v === 0 ? t('full power') : t('step {n}', { n: v })));
    const ntcTxt = (v) => (v === null || v === undefined ? null : NN2[String(v)] || (v > 2 ? t('outdoor sensor fixed at {c} °C', { c: nf(v, 0) }) : v === 0 ? t('real outdoor temperature') : t('outdoor sensor fixed ({n})', { n: v })));
    const setTxt = (x) => x ? [Number.isFinite(x.flowC) ? t('flow {c} °C', { c: nf(x.flowC, 1) }) : null, fStep ? stepTxt(x.step) : null, fNtc ? ntcTxt(x.ntc) : null].filter((y) => y !== null && y !== undefined).join(' · ') : '—'; %>
    <div class="form-grid mm-master" style="grid-template-columns:repeat(auto-fit,minmax(160px,1fr));">
      <div><label><%= t('Fine-tuning') %></label><select data-tu="mode" data-master><option value="off" <%= TC.mode === 'off' ? 'selected' : '' %>><%= t('Off') %></option><option value="advise" <%= !TC.mode || TC.mode === 'advise' ? 'selected' : '' %>><%= t('Advise only') %></option><option value="live" <%= TC.mode === 'live' ? 'selected' : '' %>><%= t('Steer (with the module live)') %></option></select></div>
      <div class="mm-ifon"><label><%= t('Flow at least (°C)') %></label><input type="text" data-tu="flow_min" value="<%= TC.flow_min %>"></div>
      <div class="mm-ifon"><label><%= t('Flow at most (°C)') %></label><input type="text" data-tu="flow_max" value="<%= TC.flow_max %>"></div>
    </div>
    <div class="mm-kpis">
      <div class="mm-kpi"><span><%= t('Now') %></span><b style="font-size:1rem;"><%= setTxt(TU.current) %></b><span><%= t('{d} of runs to learn from', { d: dur(TU.runs || 0) }) %></span></div>
      <div class="mm-kpi"><span><%= t('Stops') %></span><b style="font-size:1rem;"><%= TU.overshoot && TU.overshoot.overshootC ? t('run {c} °C longer', { c: nf(TU.overshoot.overshootC, 1) }) : t('long enough') %></b><span><%= TU.overshoot && TU.overshoot.medianOffMin !== undefined ? t('usually {m} min still before it starts again', { m: TU.overshoot.medianOffMin }) : t('too few runs to say') %></span></div>
      <div class="mm-kpi"><span><%= t('Advice for this weather') %></span><b style="font-size:1rem;"><%= TU.advice ? setTxt(TU.advice.setting) : '—' %></b><span><%= TU.advice ? tr(TU.advice.why) : '' %></span></div>
    </div>
    <% if ((TU.model || []).length) { %><details class="mm-detail"><summary class="mm-sum"><%= t('Per setting: runs, defrosts and COP') %></summary><div style="overflow-x:auto;"><table class="mm-log"><thead><tr><th><%= t('Flow') %></th><% if (fStep) { %><th><%= t('Power step') %></th><% } %><% if (fNtc) { %><th><%= t('Outdoor sensor') %></th><% } %><th class="num"><%= t('Runs') %></th><th class="num"><%= t('Run length') %></th><th class="num"><%= t('Defrosts / h') %></th><th class="num">COP</th></tr></thead><tbody>
      <% TU.model.forEach((r) => { const x = r.setting || {}; %><tr><td class="num"><%= Number.isFinite(x.flowC) ? nf(x.flowC, 1) + ' °C' : '—' %></td><% if (fStep) { %><td><%= stepTxt(x.step) || '—' %></td><% } %><% if (fNtc) { %><td><%= ntcTxt(x.ntc) || '—' %></td><% } %><td class="num"><%= nf(r.runs, 0) %></td><td class="num"><%= dur(r.runMin) %></td><td class="num"><%= nf(r.defrostPerH, 1) %></td><td class="num"><%= nf(r.cop, 2) %></td></tr><% }) %>
    </tbody></table></div></details><% } %>
    <p class="hint" style="margin:0.3rem 0 0;"><%= t('Per weather it learns which flow temperature, power step and outdoor-sensor setting give the longest runs with the least power per kWh of heat and the fewest defrosts. With a lot of defrosting it tries a calmer setting — never while the room is behind.') %></p>
  </div>

  <div class="mm-sub"><h3 class="en-h3"><%- enIcon('snow', '#06b6d4', { plain: true }) %><%= t('Weather and defrosting') %></h3>
    <% const W = hpS.weather || {}; const bins = Object.values((W.model && W.model.bins) || {}).sort((a, b) => a.t - b.t || a.band.localeCompare(b.band)); const SC2 = W.scop || {}; const seenH = bins.reduce((a, b) => a + (b.hours || 0), 0); %>
    <div class="mm-kpis">
      <div class="mm-kpi"><span><%= t('This hour') %></span><b>COP ~<%= W.now ? nf(W.now.cop, 1) : '—' %></b><span><%= W.now && W.now.outdoorC !== null && W.now.outdoorC !== undefined ? nf(W.now.outdoorC) + ' °C' : '' %><%= W.now && W.now.rh ? ' · ' + nf(W.now.rh, 0) + '% ' + t('humidity') : '' %><%= W.now && W.now.defrost > 0.02 ? ' · ' + t('defrosting ~{p}% of the time', { p: Math.round(W.now.defrost * 100) }) : '' %></span></div>
      <div class="mm-kpi"><span>SCOP <%= t('(measured)') %></span><b><%= SC2.scop ? nf(SC2.scop, 2) : '—' %></b><span><%= SC2.days ? t('{h} kWh heat / {e} kWh power over {n} days', { h: nf(SC2.heatKwh, 0), e: nf(SC2.elecKwh, 0), n: SC2.days }) : t('builds up from today, a full year for a real SCOP') %></span></div>
      <div class="mm-kpi"><span><%= t('Learned') %></span><b><%= nf(seenH, 0) %> <%= t('hours') %></b><span><%= W.now && W.now.learned ? t('this weather: learned') : t('this weather: start curve, still learning') %></span></div>
    </div>
    <% if (bins.length) { %><details class="mm-detail"><summary class="mm-sum"><%= t('Per weather: defrosting and COP') %></summary><div style="overflow-x:auto;"><table class="mm-log"><thead><tr><th><%= t('Outside') %></th><th><%= t('Humidity') %></th><th><%= t('Hours seen') %></th><th><%= t('Defrosting') %></th><th>COP</th></tr></thead><tbody>
      <% bins.forEach((b) => { %><tr><td><%= b.t %> … <%= b.t + 2 %> °C</td><td><%= { dry: t('below 80%'), humid: t('80–90%'), wet: t('90% and more') }[b.band] %></td><td><%= nf(b.hours, 0) %></td><td><%= Math.round(b.defrost * 100) %>%</td><td><%= nf(b.cop, 1) %></td></tr><% }) %>
    </tbody></table></div></details><% } else { %><p class="hint" style="margin:0;"><%= t('Nothing learned yet: needs the outdoor temperature, and for defrosting the defrost state of the unit.') %></p><% } %>
  </div>

  <% if (fStep || fNtc) { %>
  <div class="mm-sub"><h3 class="en-h3"><%- enIcon('bolt', 'var(--en-solar)', { plain: true }) %><%= fStep && fNtc ? t('Power steps and outdoor sensor (NTC)') : fStep ? t('Power steps') : t('Outdoor sensor (NTC)') %></h3>
    <% const steps = (W.steps || []); const SN = hpS.cfg.step_names || {}, NN = hpS.cfg.ntc_names || {};
       const stTxt = (v) => SN[String(v)] || (v > 2 ? v + '%' : v === 0 ? t('full power') : t('step {n}', { n: v }));
       const ntTxt = (v) => NN[String(v)] || (v > 2 ? t('outdoor sensor fixed at {c} °C', { c: nf(v, 0) }) : v === 0 ? t('real outdoor temperature') : t('outdoor sensor fixed ({n})', { n: v }));
       const tNow = W.now && Number.isFinite(W.now.outdoorC) ? Math.floor(W.now.outdoorC / 2) * 2 : null;
       const here = steps.filter((r) => r.t === tNow && r.cop).sort((a, b) => b.cop - a.cop); const best = here[0]; %>
    <div class="mm-kpis">
      <div class="mm-kpi"><span><%= t('Best at this outdoor temperature') %></span><b style="font-size:1rem;"><%= best ? [fStep ? stTxt(best.step) : null, fNtc ? ntTxt(best.ntc) : null].filter(Boolean).join(' · ') : '—' %></b><span><%= best ? 'COP ' + nf(best.cop, 2) + ' · ' + nf(best.hours, 0) + ' ' + t('hours seen') : t('not seen at this temperature yet') %></span></div>
      <div class="mm-kpi"><span><%= t('Settings seen') %></span><b><%= nf(new Set(steps.map((r) => r.step + '|' + r.ntc)).size, 0) %></b><span><%= t('over {n} outdoor temperatures', { n: new Set(steps.map((r) => r.t)).size }) %></span></div>
    </div>
    <% if (steps.length) { %><details class="mm-detail"><summary class="mm-sum"><%= t('Per outdoor temperature: power, heat and COP') %></summary>
    <div style="overflow-x:auto;"><table class="mm-log"><thead><tr><th><%= t('Outside') %></th><% if (fStep) { %><th><%= t('Power step') %></th><% } %><% if (fNtc) { %><th>NTC</th><% } %><th><%= t('Hours seen') %></th><th><%= t('Power') %></th><th><%= t('Heat') %></th><th>COP</th></tr></thead><tbody>
      <% steps.forEach((r) => { %><tr><td><%= r.t %> … <%= r.t + 2 %> °C</td><% if (fStep) { %><td><%= stTxt(r.step) %></td><% } %><% if (fNtc) { %><td><%= ntTxt(r.ntc) %></td><% } %><td><%= nf(r.hours, 0) %></td><td><%= nf(r.elecKw, 2) %> kW</td><td><%= nf(r.heatKw, 2) %> kW</td><td><%= nf(r.cop, 2) %></td></tr><% }) %>
    </tbody></table></div></details><% } %>
    <% const seenStep = [...new Set([...(W.steps || []).map((r) => r.step), ...((hpS.tuning || {}).model || []).map((r) => r.setting.step), (hpS.tuning || {}).current ? hpS.tuning.current.step : null, ...Object.keys(hpS.cfg.step_names || {}).map(Number)].filter(Number.isFinite))].sort((a, b) => a - b);
       const seenNtc = [...new Set([...(W.steps || []).map((r) => r.ntc), ...((hpS.tuning || {}).model || []).map((r) => r.setting.ntc), (hpS.tuning || {}).current ? hpS.tuning.current.ntc : null, ...Object.keys(hpS.cfg.ntc_names || {}).map(Number)].filter(Number.isFinite))].sort((a, b) => a - b); %>
    <details class="mm-detail"><summary class="mm-sum"><%= t('Names of the steps') %></summary>
      <div class="form-grid" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); margin-top:0.4rem;">
        <% (fStep ? seenStep : []).forEach((v) => { %><div><label><%= t('Power: value {v}', { v }) %></label><input type="text" data-sn="<%= v %>" value="<%= (hpS.cfg.step_names || {})[String(v)] || '' %>" placeholder="<%= v > 2 ? v + '%' : v === 0 ? t('full power') : t('step {n}', { n: v }) %>"></div><% }) %>
        <% (fNtc ? seenNtc : []).forEach((v) => { %><div><label><%= t('Outdoor sensor: value {v}', { v }) %></label><input type="text" data-nn="<%= v %>" value="<%= (hpS.cfg.ntc_names || {})[String(v)] || '' %>" placeholder="<%= v > 2 ? t('outdoor sensor fixed at {c} °C', { c: v }) : v === 0 ? t('real outdoor temperature') : t('outdoor sensor fixed ({n})', { n: v }) %>"></div><% }) %>
      </div>
      <p class="mm-sum" style="margin:0.3rem 0 0;"><%= t('Every value your Loxone logic has shown (a step, a percentage, an outdoor temperature the heat pump is shown) — give it a name, e.g. "Fake 14 graden". Empty: the description shown greyed.') %></p>
    </details>
  </div>
  <% } %>

  <details class="mm-sub mm-settings"><summary style="cursor:pointer;"><strong class="en-h3"><%- enIcon('gear', 'var(--text-muted)', { plain: true }) %><%= t('Settings') %></strong> <span class="hint" style="margin:0;">— <%= t('device, link with Loxone, limits, legionella') %></span></summary>
  <% moduleHead('heatpump', hpS) %>
  <div class="form-grid" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); margin-top:0.5rem;">
    <div><label><%= t('What it has') %></label><p class="hint" style="margin:0.2rem 0 0;"><%= [fStep ? t('power steps') : null, fNtc ? t('fake outdoor sensor (NTC)') : null].filter(Boolean).join(' · ') || t('no power steps, no NTC') %> — <a href="#" data-wizard-again><%= t('set up again') %></a></p></div>
    <div><label><%= t('Kind of heat pump') %></label><select data-f="source"><% [['air', 'Air / water'], ['water', 'Water / water'], ['ground', 'Ground / water']].forEach(([k, lbl]) => { %><option value="<%= k %>" <%= (hpS.cfg.source || 'air') === k ? 'selected' : '' %>><%= t(lbl) %></option><% }) %></select><p class="hint" style="margin:0.2rem 0 0;"><%= t('Air / water: the outdoor air matters — colder means a lower COP, and around freezing in humid air it has to defrost.') %></p></div>
  </div>
  <% if ((hpS.roles || []).some((r) => r.role === 'heatMeterFlowRate' && r.read)) { %><div class="form-grid" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); margin-top:0.4rem;"><div><label><%= t('Heat meter flow in') %></label><select data-f="heat_meter_flow_unit"><% ['auto', 'l/min', 'l/h', 'm3/h'].forEach((u) => { %><option value="<%= u %>" <%= (hpS.cfg.heat_meter_flow_unit || 'auto') === u ? 'selected' : '' %>><%= u === 'auto' ? t('automatic (below 100: l/min)') : u === 'm3/h' ? 'm³/h' : u %></option><% }) %></select><p class="hint" style="margin:0.2rem 0 0;"><%= t('What the value really is — Loxone\'s label can say l/h while a correction (3600 → 60) makes it l/min.') %></p></div></div><% } %>
  <% heartbeatBox('heatpump', hpS) %>
  <div class="mm-sub" data-limits><h3 class="en-h3"><%- enIcon('tank', '#3b82f6', { plain: true }) %><%= t('Tap-water limits') %></h3>
    <% const L = hpS.cfg.limits || {}; %>
    <div class="form-grid" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr));">
      <div><label><%= t('Comfort minimum (°C)') %></label><input type="text" data-l="comfortMinC" value="<%= L.comfortMinC %>"><p class="hint" style="margin:0.2rem 0 0;"><%= t('never colder at the tap') %></p></div>
      <div><label><%= t('Normal target (°C)') %></label><input type="text" data-l="targetC" value="<%= L.targetC %>"><p class="hint" style="margin:0.2rem 0 0;"><%= t('heating in an ordinary hour') %></p></div>
      <div><label><%= t('Buffer on solar / cheap (°C)') %></label><input type="text" data-l="bufferMaxC" value="<%= L.bufferMaxC %>"><p class="hint" style="margin:0.2rem 0 0;"><%= t('hotter when power is free') %></p></div>
      <div><label><%= t('Heat pump reaches by itself (°C)') %></label><input type="text" data-l="hpMaxC" value="<%= L.hpMaxC %>"><p class="hint" style="margin:0.2rem 0 0;"><%= t('above it the booster helps') %></p></div>
      <div><label><%= t('Absolute maximum (°C)') %></label><input type="text" data-l="absoluteMaxC" value="<%= L.absoluteMaxC %>"><p class="hint" style="margin:0.2rem 0 0;"><%= t('except legionella') %></p></div>
    </div>
    <div class="mm-toggle"><label class="switch"><input type="checkbox" id="mm-l-boosterForBuffer" data-l="boosterForBuffer" <%= L.boosterForBuffer ? 'checked' : '' %>><span class="switch-track"><span class="switch-thumb"></span></span></label><label for="mm-l-boosterForBuffer"><%= t('Use the booster for the buffer on solar surplus') %></label></div>
    <% (hpS.warnings || []).forEach((w) => { %><div class="mm-warn"><%= tr(w) %></div><% }) %>
  </div>

  <div class="mm-sub" data-legionella><h3 class="en-h3"><%- enIcon('bug', 'var(--en-import)', { plain: true }) %><%= t('Legionella') %></h3>
    <% const G = hpS.cfg.legionella || {}; const lp = hpS.legionella; %>
    <div class="mm-toggle mm-master"><label class="switch"><input type="checkbox" id="mm-g-enabled" data-g="enabled" <%= G.enabled ? 'checked' : '' %>><span class="switch-track"><span class="switch-thumb"></span></span></label><label for="mm-g-enabled"><%= t('Plan the legionella cycle') %></label></div>
    <div class="form-grid" style="grid-template-columns:repeat(auto-fit,minmax(130px,1fr)); margin-top:0.4rem;">
      <div><label><%= t('Every (days)') %></label><input type="text" data-g="interval_days" value="<%= G.interval_days %>"></div>
      <div><label><%= t('Temperature (°C)') %></label><input type="text" data-g="temp_c" value="<%= G.temp_c %>"></div>
      <div><label><%= t('Hold (min)') %></label><input type="text" data-g="hold_min" value="<%= G.hold_min %>"></div>
      <div><label><%= t('From (hour)') %></label><input type="text" data-g="from_hour" value="<%= G.from_hour %>"></div>
      <div><label><%= t('Until (hour)') %></label><input type="text" data-g="to_hour" value="<%= G.to_hour %>"></div>
      <div><label><%= t('Duration (h)') %></label><input type="text" data-g="duration_h" value="<%= G.duration_h %>"></div>
    </div>
    <% if (lp) { %><div class="mm-kpis">
      <div class="mm-kpi"><span><%= t('Last done (measured)') %></span><b><%= lp.lastDoneMs ? day(lp.lastDoneMs) : t('not seen yet') %></b><span><%= t('tank ≥ {c} °C for {m} min', { c: G.temp_c, m: G.hold_min }) %></span></div>
      <div class="mm-kpi"><span><%= t('Due') %></span><b><%= lp.overdue ? t('now') : day(lp.due) %></b><span><%= t('every {n} days', { n: G.interval_days }) %></span></div>
      <div class="mm-kpi"><span><%= t('Planned') %></span><b><%= lp.block ? day(lp.block.startMs) : '—' %></b><span><%= tr(lp.reason) %><%= lp.block ? ' · € ' + nf(lp.block.cost, 2) : '' %></span></div>
    </div><% } %>
    <div class="mm-toggle"><label class="switch"><input type="checkbox" id="mm-g-unit_backup" data-g="unit_backup" <%= G.unit_backup ? 'checked' : '' %>><span class="switch-track"><span class="switch-thumb"></span></span></label><label for="mm-g-unit_backup"><%= t('Keep the heat pump\'s own legionella program as a safety net (set it to a longer interval in the unit)') %></label></div>
  </div>

  <% rolesTable('heatpump', hpS) %>
  <% sentLog(hpS) %>
  <% importBox('heatpump') %>
  <p class="mm-sum mm-autosave" data-save-msg="heatpump"><%= t('Changes are saved right away.') %></p>
  </details>
  <% } %>
</div>
<% } %>

<% if (only === 'solar') { %>
<div class="card" data-module="solar">
  <h2 class="en-h" style="margin-top:0;"><%- enIcon('panel', 'var(--en-solar)') %><%= t('Solar panels') %></h2>
  <% if (soS.error) { %><p class="error"><%= soS.error %></p><% } else { %>
  <% moduleStatus('solar', soS) %>
  <div class="mm-kpis">
    <div class="mm-kpi"><span class="en-kl"><%- enIcon('sun', 'var(--en-solar)', { plain: true, size: 13 }) %><%= t('Solar now') %></span><b><%= nf(soS.pvKw, 2) %> kW</b><span><%= { meter: t('from the PV meter'), ac: t('inverter AC output'), dc: t('inverter DC output') }[soS.pvSource] || t('not linked') %> · <%= t('house') %> <%= nf(soS.houseKw, 2) %> kW</span></div>
    <div class="mm-kpi"><span class="en-kl"><%- enIcon('euro', 'var(--en-export)', { plain: true, size: 13 }) %><%= t('Exporting yields now') %></span><b><%= soS.value === null || soS.value === undefined ? '—' : (soS.value < 0 ? '−€ ' : '€ ') + nf(Math.abs(soS.value), 3) %></b><span><%= t('worth') %> € <%= nf(soS.worth, 3) %> − <%= t('feed-in costs') %> € <%= nf(soS.contract && soS.contract.costEur, 3) %></span></div>
    <div class="mm-kpi"><span class="en-kl"><%- enIcon('panel', 'var(--en-solar)', { plain: true, size: 13 }) %><%= t('Limit') %></span><b><%= soS.limit ? soS.limit.pct : '—' %> %</b><span><%= soS.limit ? tr(soS.limit.why) : '' %></span></div>
  </div>
  <% const C = soS.contract || {}; %>
  <p class="hint" style="margin:0.2rem 0 0;"><%= t('Your contract:') %> <strong><%= C.rule === 'saldering' ? t('net metering (until the end of 2026): exporting is worth the price of that moment') : C.rule === 'fixed' ? t('fixed feed-in tariff € {v}/kWh', { v: nf(C.feedInEur, 3) }) : t('market price of that moment') %></strong><%= C.dynamic ? ' · ' + t('dynamic prices') : ' · ' + t('fixed prices') %> · <%= t('feed-in costs') %> € <%= nf(C.costEur, 3) %>/kWh<%= C.estimated ? ' · ' + t('No prices yet: estimated.') : '' %> — <a href="/settings/energy#charging"><%= t('change in the Smart charging settings') %></a></p>
  <% const A = soS.ahead || []; if (A.length) { %>
  <div class="mm-sub"><h3 class="en-h3"><%- enIcon('panel', 'var(--en-solar)', { plain: true }) %><%= t('Limiting in the coming hours') %></h3>
    <div id="mm-so-plan" style="margin-top:0.4rem;"></div>
    <script type="application/json" id="mm-so-plan-data"><%- JSON.stringify({ hours: A.slice(0, 24).map((h) => ({ ms: h.ms, value: h.value, surplusKwh: h.surplusKwh, limit: !!h.limit, pct: h.pct !== undefined ? h.pct : (h.limit && h.limit.pct !== undefined ? h.limit.pct : null) })), L: { sun: t('Solar surplus (forecast)'), value: t('Exporting yields (€/kWh)'), limit: t('Limited'), now: t('now'), yes: t('yes'), no: t('no') } }).replace(/</g, '\\u003c') %></script>
    <div class="mm-legend"><span style="white-space:nowrap; margin-right:0.8rem;"><i class="ls-key" style="background:var(--en-solar);"></i> <%= t('Solar surplus (forecast)') %></span><span style="white-space:nowrap; margin-right:0.8rem;"><i class="ls-key ls-key-col" style="background:var(--en-export);"></i> <%= t('exporting (worth something)') %></span><span style="white-space:nowrap;"><i class="ls-key ls-key-col" style="background:var(--en-import);"></i> <%= t('limited: exporting costs money') %></span></div>
    <% if (!A.some((h) => h.limit)) { %><p class="hint" style="margin:0.3rem 0 0;"><%= C.rule === 'saldering' ? t('With net metering and these prices everything is exported: no limit expected.') : t('No limit expected in the coming hours.') %></p><% } %>
  </div><% } %>
  <details class="mm-sub mm-settings"><summary style="cursor:pointer;"><strong class="en-h3"><%- enIcon('gear', 'var(--text-muted)', { plain: true }) %><%= t('Settings') %></strong> <span class="hint" style="margin:0;">— <%= t('device, link with Loxone, inverter') %></span></summary>
  <% moduleHead('solar', soS) %>
  <div class="form-grid" style="grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); margin-top:0.5rem;">
    <div><label><%= t('Inverter power (kW)') %></label><input type="text" data-f="inverter_kw" value="<%= soS.cfg.inverter_kw %>"></div>
    <div><label><%= t('Step (%)') %></label><input type="text" data-f="step_pct" value="<%= soS.cfg.step_pct %>"></div>
  </div>
  <div class="mm-toggle"><label class="switch"><input type="checkbox" id="mm-f-grid_invert" data-f="grid_invert" <%= soS.cfg.grid_invert ? 'checked' : '' %>><span class="switch-track"><span class="switch-thumb"></span></span></label><label for="mm-f-grid_invert"><%= t('Grid meter counts export as positive (invert)') %></label></div>
  <% heartbeatBox('solar', soS) %>
  <% rolesTable('solar', soS) %>
  <% sentLog(soS) %>
  <% importBox('solar') %>
  <p class="mm-sum mm-autosave" data-save-msg="solar"><%= t('Changes are saved right away.') %></p>
  </details>
  <% } %>
</div>
<% } %>

<datalist id="mm-objects"></datalist>
<datalist id="mm-actions"></datalist>

<script>
(function () {
  // the suggestions: open or folded to one line, remembered per browser
  var d = document.querySelector('details[data-suggestions]');
  if (!d) return;
  try { if (localStorage.getItem('ls-hp-suggestions') === 'closed') d.open = false; } catch (e) { /* no storage */ }
  d.addEventListener('toggle', function () { try { localStorage.setItem('ls-hp-suggestions', d.open ? 'open' : 'closed'); } catch (e) { /* no storage */ } });
})();
</script>
<script>
(function () {
  // a section switched off (its "on" switch, or fine-tuning "Off") shows only that switch, not all its options
  // only its own switch: the Settings tile holds sections with switches of their own
  var own = function (sec, sel) { return Array.prototype.filter.call(sec.querySelectorAll(sel), function (e) { return e.closest('.mm-sub') === sec; })[0] || null; };
  function sync(sec) {
    var m = own(sec, '.mm-master input[type="checkbox"]'), sel = own(sec, 'select[data-master]');
    var off = m ? !m.checked : sel ? sel.value === 'off' : false;
    sec.classList.toggle('mm-off', off);
  }
  Array.prototype.forEach.call(document.querySelectorAll('.mm-sub'), function (sec) {
    if (!own(sec, '.mm-master, select[data-master]')) return;
    sync(sec);
    sec.addEventListener('change', function (e) { if (e.target.closest('.mm-sub') === sec) sync(sec); });
  });
})();
</script>
<script>
(function () {
  // the heat pump plan, as lanes over one time axis like the Energy manager plan
  var dataEl = document.getElementById('mm-hp-plan-data'), el = document.getElementById('mm-hp-plan');
  if (!window.LsChart) return;
  var d = dataEl ? JSON.parse(dataEl.textContent) : null, L = d ? d.L : {}, H1 = 3600000;
  var esc = function (x) { return String(x == null ? '' : x).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
  var fin = function (v) { return v !== null && v !== undefined && isFinite(v); };
  var nf = function (v, k) { return fin(v) ? Number(v).toLocaleString('nl-NL', { minimumFractionDigits: k == null ? 1 : k, maximumFractionDigits: k == null ? 1 : k }) : '—'; };
  var hh = function (ms) { return new Date(ms).toLocaleTimeString('nl-NL', { hour: '2-digit', minute: '2-digit' }); };
  var COL = { solar: 'var(--en-solar)', dhw: '#3b82f6', legionella: 'var(--en-import)', preheat: '#e67e22', comfort: d && d.cooling ? '#06b6d4' : 'var(--accent)', cool: '#06b6d4', setback: 'var(--en-house)' };
  function draw() {
    if (!el || !d) return;
    var hrs = d.plan;
    if (!hrs.length) { el.innerHTML = ''; return; }
    var C = window.LsChart, f1 = function (v) { return (Math.round(v * 10) / 10).toString(); };
    var W = lsChartW(el, 900), left = 42, right = 30, PW = W - left - right;
    var t0 = hrs[0].ms, t1 = hrs[hrs.length - 1].ms + H1;
    var X = function (ms) { return left + (Math.min(t1, Math.max(t0, ms)) - t0) / (t1 - t0) * PW; };
    var mid = function (h) { return X(h.ms + H1 / 2); };
    var heatMin = function (h) { var m = 0; (d.runs || []).forEach(function (r) { var a = Math.max(h.ms, r.onAt), b = Math.min(h.ms + H1, r.offAt || t1); if (b > a) m += (b - a) / 60000; }); return Math.round(m); };
    var lanes = [{ k: 'does', label: L.does, h: 16 }, { k: 'room', label: L.room, h: 44 }, { k: 'tank', label: L.tank, h: 34 }, { k: 'out', label: hrs.some(function (h) { return fin(h.rh); }) ? L.outRh : L.out, h: 36 }, { k: 'price', label: L.price, h: 40 }];
    if (!hrs.some(function (h) { return fin(h.roomTargetC) || fin(h.roomC); })) lanes.splice(1, 1);
    var cy = 24, by = {};
    lanes.forEach(function (ln) { ln.labelY = cy + 10; ln.y = cy + 14; cy = ln.y + ln.h + 9; by[ln.k] = ln; });
    var bottom = cy - 9, H = bottom + 24;
    var tick = function (y, txt) { return '<text x="' + (left - 5) + '" y="' + f1(y + 3) + '" text-anchor="end" font-size="9" fill="currentColor" opacity="0.55">' + txt + '</text>'; };
    var scale = function (ln, vals, pad) { var f = vals.filter(fin); var lo = Math.min.apply(null, f) - pad, hi = Math.max.apply(null, f) + pad; if (!f.length) { lo = 0; hi = 1; } if (hi - lo < 1) { hi += 0.5; lo -= 0.5; } return { lo: lo, hi: hi, y: function (v) { return ln.y + ln.h - 2 - (v - lo) / (hi - lo) * (ln.h - 4); } }; };
