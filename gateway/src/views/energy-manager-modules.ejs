      b.room = {}; card.querySelectorAll('[data-r]').forEach(function (el) { b.room[el.getAttribute('data-r')] = el.type === 'checkbox' ? el.checked : el.value; });
      b.tuning = {}; card.querySelectorAll('[data-tu]').forEach(function (el) { b.tuning[el.getAttribute('data-tu')] = el.value; });
      b.step_names = {}; card.querySelectorAll('[data-sn]').forEach(function (el) { b.step_names[el.getAttribute('data-sn')] = el.value; });
      b.ntc_names = {}; card.querySelectorAll('[data-nn]').forEach(function (el) { b.ntc_names[el.getAttribute('data-nn')] = el.value; });
    }
    return b;
  }

  // the setup wizard: what this heat pump has
  var wz = document.querySelector('[data-wizard-done]');
  function wizardPost(body) {
    return fetch('/energy-manager/modules/heatpump.json', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(function (r) { return r.json(); });
  }
  if (wz) wz.addEventListener('click', function () {
    var val = function (n) { var e = document.querySelector('input[name="' + n + '"]:checked'); return e ? e.value : null; };
    wz.disabled = true;
    wizardPost({ source: val('wz_source'), features: { power_steps: val('wz_steps'), ntc: val('wz_ntc') }, setup_done: true }).then(function () { location.reload(); });
  });
  var again = document.querySelector('[data-wizard-again]');
  if (again) again.addEventListener('click', function (e) { e.preventDefault(); wizardPost({ setup_done: false }).then(function () { location.href = '/energy-manager/modules/heatpump'; }); });
  // every change is saved right away (text fields when you leave them); a different device reloads the page
  var toast = document.createElement('div'); toast.className = 'mm-toast'; toast.hidden = true; document.body.appendChild(toast);
  var toastTimer = null;
  function showToast(text, bad) { toast.textContent = text; toast.classList.toggle('mm-toast-bad', !!bad); toast.hidden = false; clearTimeout(toastTimer); toastTimer = setTimeout(function () { toast.hidden = true; }, bad ? 6000 : 1800); }
  var LS = <%- JSON.stringify({ saving: t('Saving…'), saved: t('Saved ✓'), failed: t('Not saved:') }) %>;
  document.querySelectorAll('[data-module]').forEach(function (card) {
    var kind = card.getAttribute('data-module'), timer = null, reload = false;
    var msg = card.querySelector('[data-save-msg]');
    function save() {
      showToast(LS.saving);
      fetch('/energy-manager/modules/' + kind + '.json', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF }, body: JSON.stringify(collect(card, kind)) })
        .then(function (r) { return r.json(); })
        .then(function (j) {
          if (!j.ok) { showToast(LS.failed + ' ' + (j.message || ''), true); return; }
          showToast(LS.saved + ((j.warnings || []).length ? ' — ' + j.warnings.join(' ') : ''), (j.warnings || []).length > 0);
          if (msg) msg.textContent = LS.saved + ' ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
          if (reload) location.href = '/energy-manager/modules/' + kind + '?saved=1';
        })
        .catch(function (e) { showToast(LS.failed + ' ' + e.message, true); });
    }
    card.addEventListener('change', function (e) {
      var el = e.target;
      if (!el.matches || el.type === 'file' || el.closest('[data-wizard]') || el.closest('[data-no-autosave]')) return;
      // "other object…" chosen: wait until one is picked, else the link would be dropped
      if (el.matches('select[data-read], select[data-write]') && el.value === '__pick') return;
      // a half-typed search is no object yet
      if (el.matches('[data-read-pick]') && !find(el.value, 'state')) return;
      if (el.matches('[data-write-pick]') && !find(el.value, 'action')) return;
      if (el.matches('[data-f="device"]')) reload = true;
      clearTimeout(timer); timer = setTimeout(save, 400);
    });
  });
  document.querySelectorAll('[data-save]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var kind = btn.getAttribute('data-save'), card = btn.closest('[data-module]');
      fetch('/energy-manager/modules/' + kind + '.json', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(collect(card, kind)) })
        .then(function (r) { return r.json(); }).then(function (j) { if (j.ok) location.href = '/energy-manager/modules/' + kind + '?saved=1'; else card.querySelector('[data-save-msg]').textContent = j.message || 'Error'; });
    });
  });
  document.querySelectorAll('[data-rediscover]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var kind = btn.getAttribute('data-rediscover'), msg = document.querySelector('[data-history-msg="' + kind + '"]');
      btn.disabled = true; msg.hidden = false; msg.textContent = L.searching;
      fetch('/energy-manager/modules/' + kind + '/discover.json?refresh=1').then(function (r) { return r.json(); }).then(function (j) {
        var ok = (j.found || []).filter(function (c) { return !c.error; });
        msg.textContent = L.found.replace('{n}', ok.length).replace('{ms}', (j.structures || []).map(function (x) { return x.name + ' (' + x.controls + ')'; }).join(', '));
        setTimeout(function () { location.reload(); }, 1800);
      });
    });
  });
  var L = <%- JSON.stringify({ searching: t('Reading the Loxone structure of every Miniserver again…'), found: t('{n} found; structure read from: {ms}.'), busy: t('Reading the statistics of the linked objects…'), done: t('Read {n} days: {roles}. Without statistics in Loxone: {without}.'), none: t('none') }) %>;
  document.querySelectorAll('[data-history]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var kind = btn.getAttribute('data-history'), msg = document.querySelector('[data-history-msg="' + kind + '"]');
      msg.hidden = false; msg.textContent = L.busy; btn.disabled = true;
      fetch('/energy-manager/modules/' + kind + '/history.json', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ days: 14 }) })
        .then(function (r) { return r.json(); }).then(function (j) {
          btn.disabled = false;
          if (!j.ok) { msg.textContent = j.message || 'Error'; return; }
          var roles = Object.keys(j.roles || {}); msg.textContent = L.done.replace('{n}', '14').replace('{roles}', roles.length ? roles.join(', ') : L.none).replace('{without}', (j.without || []).length ? j.without.join(', ') : L.none);
          setTimeout(function () { location.reload(); }, 2500);
        });
    });
  });
  document.querySelectorAll('[data-import]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var kind = btn.getAttribute('data-import'), f = document.querySelector('[data-import-file="' + kind + '"]').files[0], msg = document.querySelector('[data-import-msg="' + kind + '"]');
      if (!f) return;
      var fd = new FormData(); fd.append('_csrf', CSRF); fd.append('file', f);
      fetch('/energy-manager/modules/' + kind + '/import.json', { method: 'POST', body: fd }).then(function (r) { return r.json(); }).then(function (j) {
        msg.textContent = j.ok ? (j.label + ' — ' + j.recognised + ' / ' + j.registers + (j.check.ok ? ' ✓' : ' · ' + j.check.missing.concat(j.check.notWritable).join(', '))) : (j.message || 'Error');
      });
    });
  });
})();
</script>

<%- include('partials/foot') %>
