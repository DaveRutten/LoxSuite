<%- include('partials/head', { pageTitle: 'Translations', active: 'loxone-to-mqtt' }) %>

<p class="hint">
  <%= t('Translation table for Loxone →') %> <code><%= mapping.mqtt_topic %></code><% if (mapping.miniserver_name) { %> (<%= mapping.miniserver_name %>)<% } %><%= t('. If the value Loxone sends has no match here, it is passed through unchanged.') %>
</p>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<% if (canEdit('loxone_to_mqtt')) { %>
<details class="add-panel">
  <summary><%= t('Add translation') %></summary>
  <div class="add-panel-body">
    <form method="post" action="/mappings/loxone-to-mqtt/<%= mapping.id %>/translations">
      <div class="form-grid">
        <div><label><%= t('Value from Loxone (e.g. "1")') %></label><input type="text" name="match_value" required></div>
        <div><label><%= t('Becomes (e.g. "on")') %></label><input type="text" name="output_value" required></div>
        <button type="submit" class="primary"><%- icon('plus') %> <%= t('Add') %></button>
      </div>
    </form>
  </div>
</details>
<% } %>

<div class="filterable-table-card">
  <div class="table-toolbar">
    <div class="columns-menu columns-menu-inline" id="mt-columns-menu">
      <button type="button" class="btn-soft" id="mt-columns-btn"><%- icon('columns') %> <%= t('Columns') %></button>
      <div class="columns-menu-panel" id="mt-columns-panel" hidden></div>
    </div>
  </div>
  <div class="table-wrap">
    <div id="mt-tabulator"
      data-delete-base-path="/mappings/loxone-to-mqtt/<%= mapping.id %>/translations"
      data-value-label="Value from Loxone"
      data-can-edit="<%= canEdit('loxone_to_mqtt') ? '1' : '' %>"></div>
  </div>
</div>
<script type="application/json" id="mt-rows"><%- JSON.stringify(translations) %></script>

<p><a href="/mappings/loxone-to-mqtt"><%= t('← Back to mappings') %></a></p>

<link rel="stylesheet" href="/vendor/tabulator.min.css">
<link rel="stylesheet" href="/tabulator-theme.css">
<script src="/vendor/tabulator.min.js"></script>
<script src="/vendor/floating-ui.core.umd.min.js"></script>
<script src="/vendor/floating-ui.dom.umd.min.js"></script>
<script src="/tabulator-table.js"></script>
<script src="/mapping-translations-tabulator.js"></script>

<%- include('partials/foot') %>
