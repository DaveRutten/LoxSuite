<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>Setup · LoxSuite</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/style.css">
  <script>
    (function () {
      var saved = localStorage.getItem('theme');
      if (saved === 'light' || saved === 'dark') document.documentElement.setAttribute('data-theme', saved);
    })();
  </script>
</head>
<body class="login-page">
  <div class="login-box" style="max-width:60rem;">
    <div class="brand">
      <span class="brand-icon"><%- icon('logo', { size: 18 }) %></span>
      <span>LoxSuite setup</span>
    </div>

    <%
      // A step only gets a checkmark once it's actually been submitted (Skip or a real save) — see
      // markVisited in routes/setup.js — not just because its current state happens to be valid.
      // "done" has no submit step of its own to track, so it never shows one.
      var STEP_LABELS = { mqtt: 'MQTT', sso: 'SSO' };
      function stepLabel(s) {
        return STEP_LABELS[s] || (s.charAt(0).toUpperCase() + s.slice(1));
      }
      function skipForm(stepName, nextStep, label, btnClass) {
        return '<form method="post" action="/setup/skip-step" style="display:inline;">'
          + '<input type="hidden" name="_csrf" value="' + csrfToken + '">'
          + '<input type="hidden" name="step" value="' + stepName + '">'
          + '<input type="hidden" name="next" value="' + nextStep + '">'
          + '<button type="submit" class="' + (btnClass || 'btn-soft') + '"' + (btnClass === 'primary' ? ' style="width:auto; margin-top:0;"' : '') + '>' + (label || 'Skip') + '</button>'
          + '</form>';
      }
    %>
    <div style="display:flex; align-items:center; justify-content:center; gap:1.1rem; flex-wrap:wrap; margin-bottom:1.25rem; font-size:0.82rem;">
      <% steps.forEach(function (s, i) { %>
        <a href="/setup?step=<%= s %>" style="text-decoration:none; white-space:nowrap; display:inline-flex; align-items:center; gap:0.3rem; color:<%= s === step ? 'var(--accent)' : 'var(--text-muted)' %>; font-weight:<%= s === step ? '600' : '400' %>;">
          <% if (visitedSteps.includes(s)) { %><span style="color:var(--success); display:inline-flex;"><%- icon('check', { size: 11 }) %></span><% } %>
          <span><%= i + 1 %>. <%= stepLabel(s) %></span>
        </a>
      <% }) %>
    </div>

    <div class="card">
      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>

      <% if (step === 'welcome') { %>
        <h2>Welcome</h2>
        <p class="hint">
          A quick guided setup — admin password, timezone, Miniserver, MQTT broker, SSO, backups,
          and notifications. Everything here is also reachable individually later (Profile,
          Settings, Miniservers, Administration), and this wizard itself stays reachable any time
          from Administration &rarr; General &rarr; "Run setup wizard again", so nothing here is a
          one-shot, locked-in decision.
        </p>
        <div style="display:flex; align-items:center; justify-content:space-between; margin-top:1.25rem;">
          <form method="post" action="/setup/skip">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn-soft">Skip setup entirely</button>
          </form>
          <%- skipForm('welcome', 'password', 'Get started', 'primary') %>
        </div>
      <% } %>

      <% if (step === 'password') { %>
        <h2>Admin password</h2>
        <p class="hint">
          You're currently signed in with whatever <code>ADMIN_PASSWORD</code> was set in
          <code>.env</code> at first boot — change it to something only you know, or leave both
          fields blank to keep it as-is.
        </p>
        <form method="post" action="/setup/password" id="password-form" class="form-grid">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div><label>New password</label><input type="password" name="new_password" minlength="8" placeholder="Leave blank to keep the current one"></div>
          <div><label>Confirm new password</label><input type="password" name="confirm_password" minlength="8"></div>
        </form>
        <div style="display:flex; align-items:center; justify-content:space-between; margin-top:1.25rem;">
          <%- skipForm('password', 'timezone') %>
          <button type="submit" form="password-form" class="primary" style="width:auto; margin-top:0;">Continue</button>
        </div>
      <% } %>

      <% if (step === 'timezone') { %>
        <h2>Timezone</h2>
        <p class="hint">
          Every date and time shown anywhere in LoxSuite is rendered in this timezone. Defaults to
          <code>UTC</code>, which is always correct but rarely what you actually want to see.
        </p>
        <form method="post" action="/setup/timezone" id="timezone-form" class="form-grid">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div>
            <label>Timezone</label>
            <select name="display_timezone">
              <% timezones.forEach(tz => { %>
                <option value="<%= tz %>" <%= tz === gatewaySettings.display_timezone ? 'selected' : '' %>><%= tz %></option>
              <% }) %>
            </select>
          </div>
        </form>
        <div style="display:flex; align-items:center; justify-content:space-between; margin-top:1.25rem;">
          <%- skipForm('timezone', 'miniserver') %>
          <button type="submit" form="timezone-form" class="primary" style="width:auto; margin-top:0;">Continue</button>
        </div>
      <% } %>

      <% if (step === 'miniserver') { %>
        <h2>Add your first Miniserver</h2>
        <% if (miniserverCount > 0) { %>
          <p class="hint">You already have <%= miniserverCount %> Miniserver<%= miniserverCount === 1 ? '' : 's' %> configured — nothing more needed here.</p>
        <% } else { %>
        <p class="hint">Leave every field blank to skip this and add one later from the Miniservers page.</p>
        <form method="post" action="/setup/miniserver" id="miniserver-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-grid">
            <div><label>Name</label><input type="text" name="name"></div>
            <div><label>Host / IP</label><input type="text" name="host"></div>
            <div><label>HTTP port</label><input type="number" name="http_port" value="80"></div>
            <div>
              <label>HTTPS</label>
              <select name="use_https">
                <option value="">No</option>
                <option value="1">Yes (self-signed certificate allowed)</option>
              </select>
            </div>
            <div><label>Username</label><input type="text" name="username"></div>
            <div><label>Password</label><input type="password" name="password"></div>
          </div>

          <h3 style="margin-top:1.25rem;">Features (optional)</h3>
          <div class="form-grid">
            <div><label>UDP port (optional)</label><input type="number" name="udp_port"></div>
            <div>
              <label>External URL (optional)</label>
              <input type="text" name="external_url" placeholder="https://myhome.dyndns.org:8080">
            </div>
          </div>
          <p class="hint" style="margin-top:0.5rem;">
            <strong>UDP port</strong> is the port <em>on the Miniserver itself</em> that Loxone
            listens on for Virtual UDP Output commands sent by this gateway (configured in Loxone
            Config's Virtual UDP Output, not here). <strong>External URL</strong> is used as a
            fallback whenever the local Host/IP can't be reached &mdash; Monitor polling, Common
            commands, log fetching and testing all try it automatically if the local address fails.
          </p>

          <h3 style="margin-top:1.25rem;">Gateway Client setup (optional)</h3>
          <div class="form-grid">
            <div>
              <label>This Miniserver is a Gateway</label>
              <%- toggleSwitch('is_gateway', false, { id: 'ms-is-gateway' }) %>
            </div>
          </div>
          <p class="hint" style="margin-top:0.5rem;">
            Turn this on if this Miniserver is a
            <a href="https://www.loxone.com/enen/kb/gateway-client/" target="_blank" rel="noopener">Gateway</a>
            managing one or more Client Miniservers that share its merged Loxone Config project.
            Each Client below is added as its own Miniserver too, reusing this Gateway's own
            Username/Password (Loxone requires identical credentials across the whole group) —
            just give each one its own Name and Host/IP.
          </p>
          <div id="ms-clients-header" class="client-rows-header" hidden>
            <div>Client Name</div><div>Host / IP</div><div>HTTP port</div><div>HTTPS</div><div></div>
          </div>
          <div id="ms-clients-list"></div>
          <button type="button" id="ms-client-row-btn" class="btn-soft" hidden><%- icon('plus') %> Add Client Miniserver</button>
          <input type="hidden" name="clients_json" id="ms-clients-json">
        </form>
        <% } %>
        <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.75rem; margin-top:1.25rem;">
          <%- skipForm('miniserver', 'mqtt') %>
          <div style="display:flex; align-items:center; gap:0.5rem;">
            <% if (miniserverCount === 0) { %>
              <button type="button" id="ms-test-btn" class="btn-test"><%- icon('refresh') %> Test</button>
            <% } %>
            <% if (miniserverCount > 0) { %>
              <%- skipForm('miniserver', 'mqtt', 'Continue', 'primary') %>
            <% } else { %>
              <button type="submit" form="miniserver-form" class="primary" style="width:auto; margin-top:0;">Add &amp; continue</button>
            <% } %>
          </div>
        </div>
        <div id="ms-test-result" style="margin-top:0.6rem;"></div>
        <script>
          // Same Test-button feedback style, and the same clients_json/Gateway-toggle pattern, as
          // the regular Add Miniserver form (routes/miniservers.js's own miniservers.ejs) — see
          // that file's own comments for the fuller reasoning. Reuses that same generic
          // /miniservers/test endpoint (not a wizard-specific one) since testing connectivity
          // to a Miniserver doesn't need anything wizard-specific.
          (function () {
            var form = document.getElementById('miniserver-form');
            var testBtn = document.getElementById('ms-test-btn');
            var testResult = document.getElementById('ms-test-result');
            if (!form) return;

            function renderLine(label, result) {
              if (!result) return '';
              var color = result.ok ? 'var(--accent)' : 'var(--danger)';
              var detail = result.ok ? (result.ms + ' ms') : (result.error || 'failed');
              return '<div style="display:flex; align-items:center; gap:0.4rem; color:' + color + ';">'
                + '<strong style="color:var(--text);">' + label + ':</strong><span>' + detail + '</span></div>';
            }

            function runTest(host, http_port, username, password, use_https, resultEl) {
              if (!host || !username || !password) {
                resultEl.innerHTML = '<p class="hint" style="margin:0; color:var(--danger);">Fill in Host, Username and Password first.</p>';
                return;
              }
              resultEl.innerHTML = '<p class="hint" style="margin:0;">Testing&hellip;</p>';
              fetch('/miniservers/test', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ host: host, http_port: http_port, username: username, password: password, use_https: use_https }) })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                  if (data.error) {
                    resultEl.innerHTML = '<p class="hint" style="margin:0; color:var(--danger);">' + data.error + '</p>';
                    return;
                  }
                  var html = '<div style="display:flex; gap:1.5rem; flex-wrap:wrap; align-items:center;">';
                  html += renderLine('Local', data.local);
                  html += renderLine('Loxone API', data.api);
                  html += renderLine('Logbook reachable', data.logbook);
                  html += '</div>';
                  resultEl.innerHTML = html;
                })
                .catch(function () {
                  resultEl.innerHTML = '<p class="hint" style="margin:0; color:var(--danger);">Test failed to run.</p>';
                });
            }

            // Gateway Client setup — one or more Client Miniservers added inline, same
            // clients_json handling as the regular Add Miniserver form.
            var isGatewayToggle = document.getElementById('ms-is-gateway');
            var clientsHeader = document.getElementById('ms-clients-header');
            var clientsList = document.getElementById('ms-clients-list');
            var addClientRowBtn = document.getElementById('ms-client-row-btn');
            var clientsJsonInput = document.getElementById('ms-clients-json');
            var removeIconSvg = '<svg class="icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>';

            function makeClientRow() {
              var wrap = document.createElement('div');
              wrap.className = 'ms-client-row-wiz';
              wrap.innerHTML =
                '<div class="client-row">' +
                  '<input type="text" class="client-name" placeholder="e.g. Upstairs">' +
                  '<input type="text" class="client-host">' +
                  '<input type="number" class="client-port" value="80">' +
                  '<label class="switch"><input type="checkbox" class="client-https"><span class="switch-track"><span class="switch-thumb"></span></span></label>' +
                  '<button type="button" class="icon-btn icon-btn-danger remove-client-row-btn" title="Remove this Client">' + removeIconSvg + '</button>' +
                '</div>' +
                '<div class="ms-client-test-result" style="margin:0.3rem 0 0.5rem;"></div>';
              wrap.querySelector('.remove-client-row-btn').addEventListener('click', function () { wrap.remove(); });
              return wrap;
            }

            if (isGatewayToggle && clientsList && addClientRowBtn) {
              isGatewayToggle.addEventListener('change', function () {
                addClientRowBtn.hidden = !isGatewayToggle.checked;
                clientsHeader.hidden = !isGatewayToggle.checked;
                if (isGatewayToggle.checked && !clientsList.children.length) clientsList.appendChild(makeClientRow());
                if (!isGatewayToggle.checked) clientsList.innerHTML = '';
              });
              addClientRowBtn.addEventListener('click', function () { clientsList.appendChild(makeClientRow()); });
            }

            if (testBtn) {
              testBtn.addEventListener('click', function () {
                var data = new FormData(form);
                runTest(data.get('host'), data.get('http_port'), data.get('username'), data.get('password'), data.get('use_https'), testResult);
                if (isGatewayToggle && isGatewayToggle.checked) {
                  var username = data.get('username');
                  var password = data.get('password');
                  clientsList.querySelectorAll('.ms-client-row-wiz').forEach(function (row) {
                    var host = row.querySelector('.client-host').value;
                    var port = row.querySelector('.client-port').value;
                    var https = row.querySelector('.client-https').checked;
                    runTest(host, port, username, password, https, row.querySelector('.ms-client-test-result'));
                  });
                }
              });
            }

            form.addEventListener('submit', function () {
              if (!isGatewayToggle || !isGatewayToggle.checked) { clientsJsonInput.value = ''; return; }
              var clients = [];
              clientsList.querySelectorAll('.ms-client-row-wiz').forEach(function (row) {
                var name = row.querySelector('.client-name').value.trim();
                var host = row.querySelector('.client-host').value.trim();
                if (!name || !host) return;
                clients.push({
                  name: name,
                  host: host,
                  http_port: Number(row.querySelector('.client-port').value) || 80,
                  use_https: row.querySelector('.client-https').checked,
                });
              });
              clientsJsonInput.value = JSON.stringify(clients);
            });
          })();
        </script>
      <% } %>

      <% if (step === 'mqtt') { %>
        <h2>MQTT Broker</h2>
        <p class="hint">
          The bundled Mosquitto broker runs inside this same container — these are the connection
          details the gateway itself uses, already filled in and working. You can also point this
          at a different/external broker instead; the gateway then stops using the bundled process
          for this connection.
        </p>
        <form method="post" action="/setup/mqtt" id="mqtt-form" class="form-grid">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div><label>Host</label><input type="text" name="host" value="<%= mqttSettings.host %>" required></div>
          <div><label>Port</label><input type="number" name="port" value="<%= mqttSettings.port %>" required></div>
          <div>
            <label>TLS</label>
            <%- toggleSwitch('use_tls', mqttSettings.use_tls) %>
          </div>
          <div><label>Username</label><input type="text" name="username" value="<%= mqttSettings.username || '' %>"></div>
          <div><label>Password</label><input type="password" name="password" value="<%= mqttSettings.password || '' %>"></div>
        </form>
        <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.75rem; margin-top:1.25rem;">
          <%- skipForm('mqtt', 'sso') %>
          <div style="display:flex; align-items:center; gap:0.5rem;">
            <button type="button" id="mqtt-test-btn" class="btn-test"><%- icon('refresh') %> Test</button>
            <button type="submit" form="mqtt-form" class="primary" style="width:auto; margin-top:0;">Save &amp; continue</button>
          </div>
        </div>
        <div id="mqtt-test-result" style="margin-top:0.6rem;"></div>
        <script>
          (function () {
            var form = document.getElementById('mqtt-form');
            var testBtn = document.getElementById('mqtt-test-btn');
            var testResult = document.getElementById('mqtt-test-result');
            if (form && testBtn) {
              testBtn.addEventListener('click', function () {
                var data = new FormData(form);
                var payload = {
                  host: data.get('host'),
                  port: data.get('port'),
                  username: data.get('username'),
                  password: data.get('password'),
                  use_tls: data.get('use_tls'),
                };
                if (!payload.host || !payload.port) {
                  testResult.innerHTML = '<p class="hint" style="margin:0; color:var(--danger);">Fill in host and port first.</p>';
                  return;
                }
                testResult.innerHTML = '<p class="hint" style="margin:0;">Testing&hellip;</p>';
                // Content-Type: application/json exempts this from the CSRF form-token check
                // server-side (see middleware/csrf.js), same as the other wizard Test buttons.
                fetch('/setup/mqtt/test', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) })
                  .then(function (r) { return r.json(); })
                  .then(function (data) {
                    if (data.error) {
                      testResult.innerHTML = '<p class="hint" style="margin:0; color:var(--danger);">' + data.error + '</p>';
                      return;
                    }
                    testResult.innerHTML = data.ok
                      ? '<p class="hint" style="margin:0; color:var(--success);">Connected (' + data.ms + ' ms).</p>'
                      : '<p class="hint" style="margin:0; color:var(--danger);">Failed: ' + (data.error || 'could not connect') + '</p>';
                  })
                  .catch(function () {
                    testResult.innerHTML = '<p class="hint" style="margin:0; color:var(--danger);">Test failed to run.</p>';
                  });
              });
            }
          })();
        </script>
      <% } %>

      <% if (step === 'sso') { %>
        <h2>Single Sign-On</h2>
        <p class="hint">
          Optional &mdash; lets people log in with a self-hosted
          <a href="https://pocket-id.org" target="_blank" rel="noopener">Pocket ID</a> instance,
          alongside the username/password login you already have. Leave Enabled off to skip this
          and set it up later from Administration.
        </p>
        <form method="post" action="/setup/sso" id="sso-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-grid">
            <div>
              <label>Enabled</label>
              <%- toggleSwitch('enabled', sso.enabled, { id: 'sso-enabled-toggle' }) %>
            </div>
          </div>
          <div id="sso-properties" class="form-grid" style="margin-top:0.85rem; <%= sso.enabled ? '' : 'display:none;' %>">
            <div>
              <label>Issuer URL</label>
              <input type="text" name="issuer_url" value="<%= sso.issuer_url || '' %>" placeholder="https://pocket-id.example.com">
            </div>
            <div>
              <label>Client ID</label>
              <input type="text" name="client_id" value="<%= sso.client_id || '' %>">
            </div>
            <div>
              <label>Client secret</label>
              <input type="password" name="client_secret" placeholder="<%= sso.client_secret ? 'Leave blank to keep the current secret' : '' %>">
            </div>
            <div>
              <label>Default Access Role for new SSO users</label>
              <select name="default_role_id">
                <option value="">-</option>
                <% roles.forEach(r => { %>
                  <option value="<%= r.id %>" <%= r.id === sso.default_role_id ? 'selected' : '' %>><%= r.name %></option>
                <% }) %>
              </select>
            </div>
          </div>
        </form>
        <script>
          (function () {
            var toggle = document.getElementById('sso-enabled-toggle');
            var properties = document.getElementById('sso-properties');
            if (toggle && properties) {
              toggle.addEventListener('change', function () {
                properties.style.display = toggle.checked ? '' : 'none';
              });
            }
          })();
        </script>
        <div style="display:flex; align-items:center; justify-content:space-between; margin-top:1.25rem;">
          <%- skipForm('sso', 'backup') %>
          <button type="submit" form="sso-form" class="primary" style="width:auto; margin-top:0;">Save &amp; continue</button>
        </div>
      <% } %>

      <% if (step === 'backup') { %>
        <h2>Backups</h2>
        <p class="hint">
          Optional &mdash; backs up the gateway's own database on a schedule, and/or additionally
          copies every backup offsite via <a href="https://rclone.org" target="_blank" rel="noopener">rclone</a>.
          Leave both Enabled toggles off to skip this and set it up later from Administration.
        </p>
        <form method="post" action="/setup/backup" id="backup-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <h3>Local schedule</h3>
          <div class="form-grid">
            <div>
              <label>Enabled</label>
              <%- toggleSwitch('enabled', backupSettings.enabled, { id: 'backup-enabled-toggle' }) %>
            </div>
          </div>
          <div id="backup-properties" class="form-grid" style="margin-top:0.85rem; <%= backupSettings.enabled ? '' : 'display:none;' %>">
            <div>
              <label>Cron expression</label>
              <input type="text" name="schedule_cron" value="<%= backupSettings.schedule_cron %>" placeholder="0 3 * * *">
            </div>
            <div>
              <label>Keep last</label>
              <input type="number" name="retention_count" min="1" value="<%= backupSettings.retention_count %>">
            </div>
          </div>
          <p id="backup-cron-hint" class="hint" style="margin-top:0.5rem; <%= backupSettings.enabled ? '' : 'display:none;' %>">
            Standard 5-field cron (minute hour day month weekday). <code>0 3 * * *</code> = every day at 03:00.
          </p>

          <h3 style="margin-top:1.25rem;">Offsite copy (rclone)</h3>
          <div class="form-grid">
            <div>
              <label>Enabled</label>
              <%- toggleSwitch('rclone_enabled', backupSettings.rclone_enabled, { id: 'rclone-enabled-toggle' }) %>
            </div>
          </div>
          <div id="rclone-properties" style="<%= backupSettings.rclone_enabled ? '' : 'display:none;' %>">
            <div class="form-grid" style="margin-top:0.85rem;">
              <div>
                <label>Remote</label>
                <input type="text" name="rclone_remote" value="<%= backupSettings.rclone_remote || '' %>" placeholder="myremote:loxsuite-backups">
              </div>
            </div>
            <div style="margin-top:0.85rem;">
              <label style="display:block; font-size:0.78rem; font-weight:500; margin-bottom:0.3rem; color:var(--text-muted);">rclone.conf contents</label>
              <textarea name="rclone_config" rows="5" placeholder="[myremote]&#10;type = s3&#10;..." style="width:100%; font-family:'SF Mono', Consolas, monospace; font-size:0.82rem; padding:0.5rem 0.6rem; border:1px solid var(--border); border-radius:7px; background:var(--surface); color:var(--text);"><%= backupSettings.rclone_config || '' %></textarea>
              <p class="hint" style="margin-top:0.35rem;">
                Generated by running <code>rclone config</code> anywhere convenient and pasting the
                result here. Test the connection any time from Administration &rarr; Backups once saved.
              </p>
            </div>
          </div>
        </form>
        <script>
          (function () {
            var backupToggle = document.getElementById('backup-enabled-toggle');
            var backupProperties = document.getElementById('backup-properties');
            var backupCronHint = document.getElementById('backup-cron-hint');
            if (backupToggle) {
              backupToggle.addEventListener('change', function () {
                backupProperties.style.display = backupToggle.checked ? '' : 'none';
                backupCronHint.style.display = backupToggle.checked ? '' : 'none';
              });
            }
            var rcloneToggle = document.getElementById('rclone-enabled-toggle');
            var rcloneProperties = document.getElementById('rclone-properties');
            if (rcloneToggle) {
              rcloneToggle.addEventListener('change', function () {
                rcloneProperties.style.display = rcloneToggle.checked ? '' : 'none';
              });
            }
          })();
        </script>
        <div style="display:flex; align-items:center; justify-content:space-between; margin-top:1.25rem;">
          <%- skipForm('backup', 'notifications') %>
          <button type="submit" form="backup-form" class="primary" style="width:auto; margin-top:0;">Save &amp; continue</button>
        </div>
      <% } %>

      <% if (step === 'notifications') { %>
        <h2>Notifications</h2>
        <p class="hint">
          Optional &mdash; add a channel to send alerts to (Teams, Slack, Telegram, Email, or
          anything else <a href="https://github.com/caronc/apprise#supported-notifications" target="_blank" rel="noopener">Apprise</a>
          supports). Leave both fields blank to skip this. Alert rules (which Monitor, which
          threshold, ...) are set up afterwards from Administration &rarr; Notifications, once you
          have Monitors and Miniservers to point them at.
        </p>
        <% if (channelCount > 0) { %>
          <p class="hint">You already have <%= channelCount %> channel<%= channelCount === 1 ? '' : 's' %> configured.</p>
        <% } %>
        <form method="post" action="/setup/notifications" id="notifications-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-grid">
            <div><label>Name</label><input type="text" name="name" placeholder="e.g. Family Teams"></div>
            <div><label>Apprise URL</label><input type="text" name="url" placeholder="msteams://TokenA/TokenB/TokenC/"></div>
          </div>
        </form>
        <script>
          (function () {
            var form = document.getElementById('notifications-form');
            var testBtn = document.getElementById('notif-test-btn');
            var testResult = document.getElementById('notif-test-result');
            if (form && testBtn) {
              testBtn.addEventListener('click', function () {
                var data = new FormData(form);
                var url = data.get('url');
                if (!url) {
                  testResult.innerHTML = '<p class="hint" style="margin:0; color:var(--danger);">Fill in an Apprise URL first.</p>';
                  return;
                }
                testResult.innerHTML = '<p class="hint" style="margin:0;">Testing&hellip;</p>';
                // Content-Type: application/json exempts this from the CSRF form-token check
                // server-side (see middleware/csrf.js), same as the Miniserver step's own Test button.
                fetch('/setup/notifications/test', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: data.get('name'), url: url }) })
                  .then(function (r) { return r.json(); })
                  .then(function (data) {
                    if (data.error || data.ok === false) {
                      testResult.innerHTML = '<p class="hint" style="margin:0; color:var(--danger);">' + (data.error || 'Test failed.') + '</p>';
                      return;
                    }
                    testResult.innerHTML = '<p class="hint" style="margin:0; color:var(--success);">Test message sent.</p>';
                  })
                  .catch(function () {
                    testResult.innerHTML = '<p class="hint" style="margin:0; color:var(--danger);">Test failed to run.</p>';
                  });
              });
            }
          })();
        </script>
        <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.75rem; margin-top:1.25rem;">
          <%- skipForm('notifications', 'done') %>
          <div style="display:flex; align-items:center; gap:0.5rem;">
            <button type="button" id="notif-test-btn" class="btn-test"><%- icon('refresh') %> Test</button>
            <button type="submit" form="notifications-form" class="primary" style="width:auto; margin-top:0;">Add &amp; continue</button>
          </div>
        </div>
        <div id="notif-test-result" style="margin-top:0.6rem;"></div>
      <% } %>

      <% if (step === 'done') { %>
        <h2>All set</h2>
        <p class="hint">
          You can fine-tune everything you just set up, and dig into Notification rules (which
          Monitor, which threshold, ...), any time from Administration. Run this wizard again any
          time from Administration &rarr; General.
        </p>
        <form method="post" action="/setup/finish">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="primary" style="width:100%;"><%- icon('check') %> Go to Dashboard</button>
        </form>
      <% } %>
    </div>
  </div>
</body>
</html>
