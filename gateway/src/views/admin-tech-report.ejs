<%- include('partials/head', { pageTitle: 'Tech report', active: 'admin' }) %>

<div class="tabs">
  <a href="/admin/general"><%= t('General') %></a>
  <a href="/admin/users"><%= t('Users') %></a>
  <a href="/admin/roles"><%= t('Access Roles') %></a>
  <a href="/admin/backup"><%= t('Backups') %></a>
  <a href="/admin/notifications"><%= t('Notifications') %></a>
  <a href="/admin/security"><%= t('Security') %></a>
  <a href="/admin/modules"><%= t('Modules') %></a>
  <a href="/admin/languages"><%= t('Languages') %></a>
  <% if (typeof moduleOn !== 'function' || moduleOn('ai')) { %><a href="/admin/ai"><%= t('AI Assistant') %></a><% } %>
</div>

<p class="hint">
  <%= t('Generated fresh just now —') %> <%= formatDateTime(report.generatedAt) %><%= t('. Usernames in every structured field (Miniservers, connected devices, MQTT log lines) are partially masked (first + last character only), and no passwords, tokens, or other secrets are ever included. One exception: a System-log audit line (e.g.') %> <em><%= t('"admin" created user "newuser".') %></em><%= t(') is free text and can still name a real username in its own sentence — skim the Recent logs section below before sharing if that matters to you.') %>
</p>

<div class="row-actions" style="justify-content:flex-start; margin-bottom:1rem;">
  <a class="inline" href="/admin/tech-report/download"><button type="button" class="btn-soft"><%- icon('download') %> <%= t('Download JSON') %></button></a>
  <a class="inline" href="/admin/tech-report"><button type="button" class="btn-soft"><%- icon('refresh') %> <%= t('Regenerate') %></button></a>
</div>

<div class="card">
  <h2><%= t('System') %></h2>
  <p class="hint">
    <span style="display:block;"><%= t('LoxSuite version:') %> <strong style="color:var(--text);">v<%= report.system.loxsuiteVersion %></strong><% if (report.system.updateAvailable) { %> (v<%= report.system.latestKnownVersion %> <%= t('available)') %><% } %></span>
    <span style="display:block;"><%= t('Database:') %> <strong style="color:var(--text);"><%= report.system.dbBackend %></strong><% if (report.system.dbVersion) { %> (v<%= report.system.dbVersion %>)<% } %> — <%= report.system.dbLocation %></span>
    <span style="display:block;"><%= t('Node.js:') %> <strong style="color:var(--text);"><%= report.system.nodeVersion %></strong></span>
    <span style="display:block;"><%= t('Platform:') %> <strong style="color:var(--text);"><%= report.system.platform %></strong> (<%= report.system.hostname %>)</span>
    <span style="display:block;"><%= t('Gateway process uptime:') %> <strong style="color:var(--text);"><%= formatDuration(report.system.processUptimeSeconds) %></strong></span>
  </p>
</div>

<div class="card">
  <h2><%= t('Config overview') %></h2>
  <p class="hint">
    <span style="display:block;"><%= t('Miniservers:') %> <strong style="color:var(--text);"><%= report.config.counts.miniservers %></strong></span>
    <span style="display:block;"><%= t('Loxone → MQTT mappings:') %> <strong style="color:var(--text);"><%= report.config.counts.loxoneToMqttMappings %></strong></span>
    <span style="display:block;"><%= t('MQTT → Loxone mappings:') %> <strong style="color:var(--text);"><%= report.config.counts.mqttToLoxoneMappings %></strong></span>
    <span style="display:block;"><%= t('Monitors:') %> <strong style="color:var(--text);"><%= report.config.counts.monitors %></strong></span>
    <span style="display:block;"><%= t('Dashboards:') %> <strong style="color:var(--text);"><%= report.config.counts.dashboards %></strong> (<%= report.config.counts.dashboardPanels %> <%= t('panels)') %></span>
    <span style="display:block;"><%= t('Users:') %> <strong style="color:var(--text);"><%= report.config.counts.users %></strong> <%= t('across') %> <%= report.config.counts.accessRoles %> <%= t('Access Roles') %></span>
    <span style="display:block;"><%= t('Notification rules:') %> <strong style="color:var(--text);"><%= report.config.counts.notificationRules %></strong></span>
  </p>

  <% if (report.config.miniservers.length) { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th><%= t('Name') %></th><th><%= t('Host') %></th><th><%= t('User') %></th><th><%= t('Configured status') %></th><th><%= t('Live connection') %></th><th><%= t('Firmware') %></th><th><%= t('Device health') %></th></tr>
        </thead>
        <tbody>
          <% report.config.miniservers.forEach(ms => { %>
            <tr>
              <td><%= ms.name %><% if (ms.isGatewayClient) { %> <span class="hint" style="margin:0;"><%= t('(Client)') %></span><% } %></td>
              <td><%= ms.host %>:<%= ms.httpPort %><% if (ms.udpPort) { %> / udp <%= ms.udpPort %><% } %></td>
              <td><%= ms.username %></td>
              <td><%= ms.configuredStatus %><% if (ms.lastError) { %><br><span class="hint" style="margin:0;"><%= ms.lastError %></span><% } %></td>
              <td><%= ms.liveConnection.status %><% if (ms.liveConnection.error) { %><br><span class="hint" style="margin:0;"><%= ms.liveConnection.error %></span><% } %></td>
              <td><%= ms.firmwareVersion || '-' %></td>
              <td>
                <% if (ms.plcState || ms.cpuLoad != null || ms.heapStatus || ms.numTasks != null) { %>
                  <span style="display:block;"><%= t('PLC:') %> <%= ms.plcState != null ? plcStateLabel(ms.plcState) : '-' %></span>
                  <span class="hint" style="margin:0;"><%= t('CPU') %> <%= ms.cpuLoad != null ? ms.cpuLoad + '%' : '-' %><%= t(', heap') %> <%= ms.heapStatus != null ? formatHeapStatus(ms.heapStatus) : '-' %><% if (ms.numTasks != null) { %>, <%= ms.numTasks %> <%= t('tasks') %><% } %></span>
                <% } else { %>-<% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

  <% if (report.config.notificationRules.length) { %>
    <p class="hint" style="margin-top:1rem;"><%= t('Notification rules — the count above only says how many exist, not which ones or whether they\'re actually switched on:') %></p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th><%= t('Name') %></th><th><%= t('Trigger') %></th><th><%= t('Enabled') %></th><th><%= t('Channels') %></th></tr>
        </thead>
        <tbody>
          <% report.config.notificationRules.forEach(r => { %>
            <tr>
              <td><%= r.name %></td>
              <td><%= r.triggerType %></td>
              <td><span class="badge <%= r.enabled ? 'badge-ok' : 'badge-off' %>"><%= r.enabled ? 'Yes' : 'No' %></span></td>
              <td>
                <% if (r.channelNames.length) { %><%= r.channelNames.join(', ') %>
                <% } else if (r.deliversNowhere) { %><span class="badge badge-warning" title="<%= t('Enabled but no channel selected — alerts show in the Notification Center but are never sent.') %>"><%= t('No channel') %></span>
                <% } else { %>-<% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<div class="card">
  <h2><%= t('Backup status') %></h2>
  <p class="hint">
    <span style="display:block;"><%= t('Scheduled backups:') %> <strong style="color:var(--text);"><%= report.backup.enabled ? 'Enabled' : 'Disabled' %></strong><% if (report.backup.enabled && report.backup.scheduleCron) { %> (<%= report.backup.scheduleCron %><%= t(', keep') %> <%= report.backup.retentionCount %>)<% } %></span>
    <span style="display:block;"><%= t('Last run:') %> <strong style="color:var(--text);"><%= report.backup.lastRunAt ? formatDateTime(report.backup.lastRunAt) : 'never' %></strong><% if (report.backup.lastStatus) { %> — <%= report.backup.lastStatus %><% } %><% if (report.backup.lastError) { %><br><span class="hint" style="margin:0;"><%= report.backup.lastError %></span><% } %></span>
    <span style="display:block;"><%= t('Stored backups:') %> <strong style="color:var(--text);"><%= report.backup.backupCount %></strong><% if (report.backup.mostRecentBackup) { %> <%= t('— most recent') %> <%= formatDateTime(report.backup.mostRecentBackup.createdAt) %><% } %></span>
    <% if (report.backup.backupDirError) { %>
      <span style="display:block; color:var(--danger, #d33);"><%= t('Backup directory error:') %> <%= report.backup.backupDirError %></span>
    <% } %>
    <% if (report.backup.rcloneEnabled) { %>
      <span style="display:block;"><%= t('Rclone remote:') %> <strong style="color:var(--text);"><%= report.backup.rcloneRemote || '-' %></strong><% if (report.backup.rcloneLastRunAt) { %> <%= t('— last run') %> <%= formatDateTime(report.backup.rcloneLastRunAt) %> (<%= report.backup.rcloneLastStatus %>)<% } %></span>
      <% if (report.backup.rcloneLastError) { %>
        <span style="display:block; color:var(--danger, #d33);"><%= t('Rclone error:') %> <%= report.backup.rcloneLastError %></span>
      <% } %>
    <% } %>
  </p>
</div>

<div class="card">
  <h2><%= t('Database sequence health') %></h2>
  <% if (!report.sequenceHealth.applicable) { %>
    <p class="hint"><%= t('Not applicable — SQLite has no separate id-sequence to fall out of sync.') %></p>
  <% } else if (!report.sequenceHealth.issues.length) { %>
    <p class="hint"><%= t('All id-generators agree with their table\'s data. No action needed.') %></p>
  <% } else { %>
    <p class="hint" style="color:var(--danger, #d33);"><%= t('One or more tables have an id-generator that has fallen behind — the next insert into that table risks a primary-key collision.') %></p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th><%= t('Table') %></th><th><%= t('Highest row id') %></th><th><%= t('Next generated id') %></th></tr>
        </thead>
        <tbody>
          <% report.sequenceHealth.issues.forEach(i => { %>
            <tr><td><%= i.table %></td><td><%= i.maxId %></td><td><%= i.nextGeneratedId %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<div class="card">
  <h2><%= t('Feature flags') %></h2>
  <p class="hint">
    <span style="display:block;"><%= t('Database backend:') %> <strong style="color:var(--text);"><%= report.featureFlags.dbBackend %></strong></span>
    <span style="display:block;"><%= t('AI assistant:') %> <strong style="color:var(--text);"><%= report.featureFlags.aiAssistantEnabled ? 'Enabled' : 'Disabled' %></strong><% if (report.featureFlags.aiAssistantEnabled) { %> (<%= report.featureFlags.aiProvider %> / <%= report.featureFlags.aiModel %><% if (report.featureFlags.aiEffort) { %><%= t(', effort') %> <%= report.featureFlags.aiEffort %><% } %>)<% } %></span>
    <span style="display:block;"><%= t('SSO:') %> <strong style="color:var(--text);"><%= report.featureFlags.ssoEnabled ? 'Enabled' : 'Disabled' %></strong><% if (report.featureFlags.ssoEnabled && report.featureFlags.localLoginDisabled) { %> <%= t('(local login disabled)') %><% } %></span>
    <span style="display:block;"><%= t('TRUST_PROXY configured:') %> <strong style="color:var(--text);"><%= report.featureFlags.trustProxyConfigured ? 'Yes' : 'No' %></strong></span>
  </p>
</div>

<div class="card">
  <h2><%= t('Live status') %></h2>
  <p class="hint">
    <span style="display:block;"><%= t('MQTT broker connection:') %> <strong style="color:var(--text);"><%= report.live.mqtt.connected ? 'Connected' : 'Disconnected' %></strong><% if (report.live.mqtt.host) { %> (<%= report.live.mqtt.host %>:<%= report.live.mqtt.port %>)<% } %></span>
    <span style="display:block;"><%= t('Throughput (as seen by LoxSuite):') %> <strong style="color:var(--text);"><%= report.live.mqtt.messagesPerSecond %> <%= t('msg/s') %></strong>, <%= formatCount(report.live.mqtt.totalMessages) %> <%= t('total,') %> <%= formatCount(report.live.mqtt.topicsSeen) %> <%= t('topics seen') %></span>
    <span style="display:block;"><%= t('Connected devices:') %> <strong style="color:var(--text);"><%= report.live.connectedDeviceCount %></strong> of <%= report.live.devices.length %> <%= t('known') %></span>
  </p>

  <% if (report.live.broker.version) { %>
    <p class="hint">
      <span style="display:block;"><%= t('Broker (') %><%= report.live.broker.version %><%= t('), up') %> <strong style="color:var(--text);"><%= report.live.broker.uptimeSeconds != null ? formatDuration(report.live.broker.uptimeSeconds) : '-' %></strong> —
        <strong style="color:var(--text);"><%= report.live.broker.clientsConnected != null ? report.live.broker.clientsConnected : '-' %></strong> <%= t('clients connected') %>
        <% if (report.live.broker.clientsTotal != null) { %>(<%= report.live.broker.clientsTotal %> <%= t('registered') %><% if (report.live.broker.clientsMaximum != null) { %>, <%= report.live.broker.clientsMaximum %> <%= t('ever at once') %><% } %>)<% } %>
      </span>
      <span style="display:block;"><%= t('Broker throughput (its own count, not just what LoxSuite saw):') %>
        <strong style="color:var(--text);"><%= report.live.broker.messagesReceived != null ? formatCount(report.live.broker.messagesReceived) : '-' %></strong> <%= t('received /') %>
        <strong style="color:var(--text);"><%= report.live.broker.messagesSent != null ? formatCount(report.live.broker.messagesSent) : '-' %></strong> <%= t('sent') %>
        <% if (report.live.broker.bytesReceived != null && report.live.broker.bytesSent != null) { %>(<%= formatBytes(report.live.broker.bytesReceived) %> <%= t('in /') %> <%= formatBytes(report.live.broker.bytesSent) %> <%= t('out)') %><% } %>
      </span>
      <span style="display:block;"><%= report.live.broker.retainedMessageCount != null ? report.live.broker.retainedMessageCount : '-' %> <%= t('retained messages held,') %> <%= report.live.broker.subscriptionsCount != null ? report.live.broker.subscriptionsCount : '-' %> <%= t('active subscriptions') %></span>
    </p>
  <% } else { %>
    <p class="hint"><%= t('Broker stats ($SYS/broker/#) not received yet — the broker publishes these every ~10s after the gateway (re)connects.') %></p>
  <% } %>

  <% if (report.live.devices.length) { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th><%= t('Device') %></th><th><%= t('User') %></th><th><%= t('Status') %></th><th><%= t('Since') %></th></tr>
        </thead>
        <tbody>
          <% report.live.devices.forEach(d => { %>
            <tr>
              <td><%= d.device %></td>
              <td><%= d.username || '-' %></td>
              <td><%= d.status %></td>
              <td><%= formatDateTime(d.status === 'connected' ? d.connectedAt : d.disconnectedAt) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<div class="card">
  <h2><%= t('Recent logs') %> <span class="hint" style="margin:0;"><%= t('(System / MQTT / Loxone Commands, most recent') %> <%= report.recentLogs.length %>)</span></h2>
  <div class="table-wrap" style="max-height:24rem; overflow-y:auto;">
    <table>
      <thead>
        <tr><th><%= t('Time') %></th><th><%= t('Source') %></th><th><%= t('Line') %></th></tr>
      </thead>
      <tbody>
        <% report.recentLogs.forEach(l => { %>
          <tr>
            <td class="truncate"><%= formatDateTime(l.recorded_at) %></td>
            <td><%= l.source %><% if (l.source_label) { %> <span class="hint" style="margin:0;">(<%= l.source_label %>)</span><% } %></td>
            <td class="truncate" title="<%= l.line %>"><%= l.line %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/foot') %>
