<%- include('partials/head', { pageTitle: 'Tech report', active: 'admin' }) %>

<div class="tabs">
  <a href="/admin/general">General</a>
  <a href="/admin/users">Users</a>
  <a href="/admin/roles">Access Roles</a>
  <a href="/admin/backup">Backups</a>
  <a href="/admin/notifications">Notifications</a>
  <a href="/admin/security">Security</a>
  <a href="/admin/ai">AI Assistant</a>
</div>

<p class="hint">
  Generated fresh just now — <%= formatDateTime(report.generatedAt) %>. Usernames in every
  structured field (Miniservers, connected devices, MQTT log lines) are partially masked (first +
  last character only), and no passwords, tokens, or other secrets are ever included. One
  exception: a System-log audit line (e.g. <em>"admin" created user "newuser".</em>) is free text
  and can still name a real username in its own sentence — skim the Recent logs section below
  before sharing if that matters to you.
</p>

<div class="row-actions" style="justify-content:flex-start; margin-bottom:1rem;">
  <a class="inline" href="/admin/tech-report/download"><button type="button" class="btn-soft"><%- icon('download') %> Download JSON</button></a>
  <a class="inline" href="/admin/tech-report"><button type="button" class="btn-soft"><%- icon('refresh') %> Regenerate</button></a>
</div>

<div class="card">
  <h2>System</h2>
  <p class="hint">
    <span style="display:block;">LoxSuite version: <strong style="color:var(--text);">v<%= report.system.loxsuiteVersion %></strong><% if (report.system.updateAvailable) { %> (v<%= report.system.latestKnownVersion %> available)<% } %></span>
    <span style="display:block;">Database: <strong style="color:var(--text);"><%= report.system.dbBackend %></strong><% if (report.system.dbVersion) { %> (v<%= report.system.dbVersion %>)<% } %> — <%= report.system.dbLocation %></span>
    <span style="display:block;">Node.js: <strong style="color:var(--text);"><%= report.system.nodeVersion %></strong></span>
    <span style="display:block;">Platform: <strong style="color:var(--text);"><%= report.system.platform %></strong> (<%= report.system.hostname %>)</span>
    <span style="display:block;">Gateway process uptime: <strong style="color:var(--text);"><%= formatDuration(report.system.processUptimeSeconds) %></strong></span>
  </p>
</div>

<div class="card">
  <h2>Config overview</h2>
  <p class="hint">
    <span style="display:block;">Miniservers: <strong style="color:var(--text);"><%= report.config.counts.miniservers %></strong></span>
    <span style="display:block;">Loxone &rarr; MQTT mappings: <strong style="color:var(--text);"><%= report.config.counts.loxoneToMqttMappings %></strong></span>
    <span style="display:block;">MQTT &rarr; Loxone mappings: <strong style="color:var(--text);"><%= report.config.counts.mqttToLoxoneMappings %></strong></span>
    <span style="display:block;">Monitors: <strong style="color:var(--text);"><%= report.config.counts.monitors %></strong></span>
    <span style="display:block;">Dashboards: <strong style="color:var(--text);"><%= report.config.counts.dashboards %></strong> (<%= report.config.counts.dashboardPanels %> panels)</span>
    <span style="display:block;">Users: <strong style="color:var(--text);"><%= report.config.counts.users %></strong> across <%= report.config.counts.accessRoles %> Access Roles</span>
    <span style="display:block;">Notification rules: <strong style="color:var(--text);"><%= report.config.counts.notificationRules %></strong></span>
  </p>

  <% if (report.config.miniservers.length) { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Name</th><th>Host</th><th>User</th><th>Configured status</th><th>Live connection</th><th>Firmware</th><th>Device health</th></tr>
        </thead>
        <tbody>
          <% report.config.miniservers.forEach(ms => { %>
            <tr>
              <td><%= ms.name %><% if (ms.isGatewayClient) { %> <span class="hint" style="margin:0;">(Client)</span><% } %></td>
              <td><%= ms.host %>:<%= ms.httpPort %><% if (ms.udpPort) { %> / udp <%= ms.udpPort %><% } %></td>
              <td><%= ms.username %></td>
              <td><%= ms.configuredStatus %><% if (ms.lastError) { %><br><span class="hint" style="margin:0;"><%= ms.lastError %></span><% } %></td>
              <td><%= ms.liveConnection.status %><% if (ms.liveConnection.error) { %><br><span class="hint" style="margin:0;"><%= ms.liveConnection.error %></span><% } %></td>
              <td><%= ms.firmwareVersion || '-' %></td>
              <td>
                <% if (ms.plcState || ms.cpuLoad != null || ms.heapStatus || ms.numTasks != null) { %>
                  <span style="display:block;">PLC: <%= ms.plcState != null ? plcStateLabel(ms.plcState) : '-' %></span>
                  <span class="hint" style="margin:0;">CPU <%= ms.cpuLoad != null ? ms.cpuLoad + '%' : '-' %>, heap <%= ms.heapStatus != null ? formatHeapStatus(ms.heapStatus) : '-' %><% if (ms.numTasks != null) { %>, <%= ms.numTasks %> tasks<% } %></span>
                <% } else { %>-<% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<div class="card">
  <h2>Backup status</h2>
  <p class="hint">
    <span style="display:block;">Scheduled backups: <strong style="color:var(--text);"><%= report.backup.enabled ? 'Enabled' : 'Disabled' %></strong><% if (report.backup.enabled && report.backup.scheduleCron) { %> (<%= report.backup.scheduleCron %>, keep <%= report.backup.retentionCount %>)<% } %></span>
    <span style="display:block;">Last run: <strong style="color:var(--text);"><%= report.backup.lastRunAt ? formatDateTime(report.backup.lastRunAt) : 'never' %></strong><% if (report.backup.lastStatus) { %> — <%= report.backup.lastStatus %><% } %><% if (report.backup.lastError) { %><br><span class="hint" style="margin:0;"><%= report.backup.lastError %></span><% } %></span>
    <span style="display:block;">Stored backups: <strong style="color:var(--text);"><%= report.backup.backupCount %></strong><% if (report.backup.mostRecentBackup) { %> — most recent <%= formatDateTime(report.backup.mostRecentBackup.createdAt) %><% } %></span>
    <% if (report.backup.backupDirError) { %>
      <span style="display:block; color:var(--danger, #d33);">Backup directory error: <%= report.backup.backupDirError %></span>
    <% } %>
    <% if (report.backup.rcloneEnabled) { %>
      <span style="display:block;">Rclone remote: <strong style="color:var(--text);"><%= report.backup.rcloneRemote || '-' %></strong><% if (report.backup.rcloneLastRunAt) { %> — last run <%= formatDateTime(report.backup.rcloneLastRunAt) %> (<%= report.backup.rcloneLastStatus %>)<% } %></span>
      <% if (report.backup.rcloneLastError) { %>
        <span style="display:block; color:var(--danger, #d33);">Rclone error: <%= report.backup.rcloneLastError %></span>
      <% } %>
    <% } %>
  </p>
</div>

<div class="card">
  <h2>Database sequence health</h2>
  <% if (!report.sequenceHealth.applicable) { %>
    <p class="hint">Not applicable — SQLite has no separate id-sequence to fall out of sync.</p>
  <% } else if (!report.sequenceHealth.issues.length) { %>
    <p class="hint">All id-generators agree with their table's data. No action needed.</p>
  <% } else { %>
    <p class="hint" style="color:var(--danger, #d33);">One or more tables have an id-generator that has fallen behind — the next insert into that table risks a primary-key collision.</p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Table</th><th>Highest row id</th><th>Next generated id</th></tr>
        </thead>
        <tbody>
          <% report.sequenceHealth.issues.forEach(i => { %>
            <tr><td><%= i.table %></td><td><%= i.maxId %></td><td><%= i.nextGeneratedId %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<div class="card">
  <h2>Feature flags</h2>
  <p class="hint">
    <span style="display:block;">Database backend: <strong style="color:var(--text);"><%= report.featureFlags.dbBackend %></strong></span>
    <span style="display:block;">AI assistant: <strong style="color:var(--text);"><%= report.featureFlags.aiAssistantEnabled ? 'Enabled' : 'Disabled' %></strong><% if (report.featureFlags.aiAssistantEnabled) { %> (<%= report.featureFlags.aiProvider %> / <%= report.featureFlags.aiModel %><% if (report.featureFlags.aiEffort) { %>, effort <%= report.featureFlags.aiEffort %><% } %>)<% } %></span>
    <span style="display:block;">SSO: <strong style="color:var(--text);"><%= report.featureFlags.ssoEnabled ? 'Enabled' : 'Disabled' %></strong><% if (report.featureFlags.ssoEnabled && report.featureFlags.localLoginDisabled) { %> (local login disabled)<% } %></span>
    <span style="display:block;">TRUST_PROXY configured: <strong style="color:var(--text);"><%= report.featureFlags.trustProxyConfigured ? 'Yes' : 'No' %></strong></span>
  </p>
</div>

<div class="card">
  <h2>Live status</h2>
  <p class="hint">
    <span style="display:block;">MQTT broker connection: <strong style="color:var(--text);"><%= report.live.mqtt.connected ? 'Connected' : 'Disconnected' %></strong><% if (report.live.mqtt.host) { %> (<%= report.live.mqtt.host %>:<%= report.live.mqtt.port %>)<% } %></span>
    <span style="display:block;">Throughput: <strong style="color:var(--text);"><%= report.live.mqtt.messagesPerSecond %> msg/s</strong>, <%= formatCount(report.live.mqtt.totalMessages) %> total, <%= formatCount(report.live.mqtt.topicsSeen) %> topics seen</span>
    <span style="display:block;">Connected devices: <strong style="color:var(--text);"><%= report.live.connectedDeviceCount %></strong> of <%= report.live.devices.length %> known</span>
  </p>

  <% if (report.live.devices.length) { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Device</th><th>User</th><th>Status</th><th>Since</th></tr>
        </thead>
        <tbody>
          <% report.live.devices.forEach(d => { %>
            <tr>
              <td><%= d.device %></td>
              <td><%= d.username || '-' %></td>
              <td><%= d.status %></td>
              <td><%= formatDateTime(d.status === 'connected' ? d.connectedAt : d.disconnectedAt) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<div class="card">
  <h2>Recent logs <span class="hint" style="margin:0;">(System / MQTT / Loxone Commands, most recent <%= report.recentLogs.length %>)</span></h2>
  <div class="table-wrap" style="max-height:24rem; overflow-y:auto;">
    <table>
      <thead>
        <tr><th>Time</th><th>Source</th><th>Line</th></tr>
      </thead>
      <tbody>
        <% report.recentLogs.forEach(l => { %>
          <tr>
            <td class="truncate"><%= formatDateTime(l.recorded_at) %></td>
            <td><%= l.source %><% if (l.source_label) { %> <span class="hint" style="margin:0;">(<%= l.source_label %>)</span><% } %></td>
            <td class="truncate" title="<%= l.line %>"><%= l.line %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/foot') %>
