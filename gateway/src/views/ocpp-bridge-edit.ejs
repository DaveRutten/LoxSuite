<%- include('partials/head', { pageTitle: 'OCPP bridge: ' + bridge.name, active: 'ocpp' }) %>

<p><a href="/ocpp">&larr; All OCPP bridges</a></p>
<% if (error) { %><p class="error"><%= error %></p><% } %>
<% if (saved) { %><p class="hint" style="color: var(--success);">Saved.</p><% } %>

<div class="card">
  <h2 style="margin-top:0;">Status</h2>
  <div id="ocpp-status"><p class="hint" style="margin:0;"><%= bridge.enabled ? 'Loading…' : 'Disabled.' %></p></div>
  <% if (canEdit('ocpp')) { %>
  <div class="btn-row" style="margin-top:0.8rem;">
    <button type="button" id="ocpp-test-btn" class="btn-test"><%- icon('refresh') %> Test connection</button>
  </div>
  <div id="ocpp-test-result" style="margin-top:0.6rem;"></div>
  <p class="hint" style="margin:0.4rem 0 0;">Tests the <em>saved</em> settings: opens a short connection to the backend (no OCPP messages, nothing is registered) and checks the Wallbox's live data. If this bridge is already connected live, that connection is reported instead.</p>
  <% } %>
</div>

<div class="card">
  <h2 style="margin-top:0;">Charging statistics <span class="hint" style="font-weight:normal; font-size:0.8rem;">(MID meter, kWh)</span></h2>
  <div id="ocpp-stats"><p class="hint" style="margin:0;">Loading&hellip;</p></div>
  <p class="hint" style="margin:0.6rem 0 0;">
    Today / week / month / year come straight from the Wallbox's own counters in Loxone; quarters and the monthly chart
    are built from the charging sessions (this bridge's own, else the Wallbox's session log on the Miniserver, which
    reaches back about 100 sessions &mdash; older months show as "no data").
  </p>
  <% if (canEdit('monitor')) { %>
  <details style="margin-top:0.8rem;">
    <summary><strong>Use in Monitor &amp; dashboards</strong></summary>
    <p class="hint">
      LoxSuite publishes these values as retained MQTT topics (<code>loxsuite/ocpp/<%= bridge.id %>/&hellip;</code>, on change,
      checked every minute). Add them as monitors to chart them over time or put them on a dashboard.
    </p>
    <div id="ocpp-monitor-picks" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:0.3rem 1rem;"></div>
    <div class="btn-row" style="margin-top:0.6rem;">
      <button type="button" class="btn-soft" id="ocpp-monitor-btn"><%- icon('plus') %> Add to Monitor</button>
    </div>
    <div id="ocpp-monitor-result" class="hint" style="margin-top:0.4rem;"></div>
  </details>
  <% } %>
</div>

<div class="card" id="finance">
  <h2 style="margin-top:0;">Costs &amp; reimbursement</h2>
  <p class="hint">
    What the charged kWh cost you and what you get back for them, per session, month, quarter and year. Only sessions
    that are reported (cars set to "report" under Vehicles) count. The reimbursement stays empty until you add a tariff.
  </p>
  <% const curTariff = tariffs.find(t => t.valid_from <= new Date().toISOString().slice(0, 10)); %>
  <div class="form-grid" style="margin-bottom:0.6rem;">
    <div><label>Reimbursement now</label><div><strong><%= curTariff ? '€ ' + Number(curTariff.eur_per_kwh).toLocaleString('nl-NL', { minimumFractionDigits: 2, maximumFractionDigits: 4 }) + ' / kWh' : 'not set' %></strong><% if (curTariff) { %> <span class="hint">(<%= finance.tariff_vat === 'excl' ? 'excl.' : 'incl.' %> VAT, since <%= curTariff.valid_from %>)</span><% } %></div></div>
    <div><label>Cost</label><div><strong><%= finance.cost_mode === 'fixed' ? (finance.fixed_eur_kwh !== null ? '€ ' + Number(finance.fixed_eur_kwh).toLocaleString('nl-NL', { minimumFractionDigits: 2, maximumFractionDigits: 4 }) + ' / kWh (fixed)' : 'fixed, no rate yet') : 'real hourly price + solar' %></strong></div></div>
  </div>
  <% if (canEdit('ocpp')) { %>
  <details <%= !financeSaved ? 'open' : '' %>>
    <summary><strong>Settings</strong></summary>
    <form method="post" action="/ocpp/<%= bridge.id %>/finance" style="margin-top:0.6rem;">
      <div class="form-grid">
        <div><label>Cost per kWh</label><select name="cost_mode"><option value="hourly" <%= finance.cost_mode !== 'fixed' ? 'selected' : '' %>>Real hourly price + solar share (Energy)</option><option value="fixed" <%= finance.cost_mode === 'fixed' ? 'selected' : '' %>>Fixed rate</option></select></div>
        <div><label>Fixed rate (€/kWh)</label><input type="text" name="fixed_eur_kwh" value="<%= finance.fixed_eur_kwh ?? '' %>" placeholder="e.g. 0,28"></div>
        <div><label>Value of solar kWh</label><select name="solar_value"><% [['saldering','The price of that hour (net metering)'],['fixed','A fixed feed-in value'],['free','Free (€ 0)']].forEach(([v,t]) => { %><option value="<%= v %>" <%= finance.solar_value === v ? 'selected' : '' %>><%= t %></option><% }) %></select></div>
        <div><label>Feed-in value (€/kWh)</label><input type="text" name="solar_eur_kwh" value="<%= finance.solar_eur_kwh ?? '' %>"></div>
        <div><label>Tariff is entered</label><select name="tariff_vat"><option value="incl" <%= finance.tariff_vat !== 'excl' ? 'selected' : '' %>>incl. VAT</option><option value="excl" <%= finance.tariff_vat === 'excl' ? 'selected' : '' %>>excl. VAT</option></select></div>
        <div><label>Show amounts</label><select name="show_vat"><option value="incl" <%= finance.show_vat !== 'excl' ? 'selected' : '' %>>incl. VAT</option><option value="excl" <%= finance.show_vat === 'excl' ? 'selected' : '' %>>excl. VAT</option></select></div>
        <div><label>VAT (%)</label><input type="text" name="vat_pct" value="<%= finance.vat_pct %>"></div>
      </div>
      <div class="btn-row" style="margin-top:0.6rem;"><button type="submit" class="btn-edit">Save</button></div>
    </form>
  </details>
  <% } %>
  <h3 style="margin:1rem 0 0.4rem; font-size:1rem;">Reimbursement tariffs</h3>
  <% if (!tariffs.length) { %><p class="hint" style="margin:0;">No tariff yet &mdash; add the rate you get per kWh (and a new row when it changes, e.g. per 1 January).</p><% } else { %>
  <table class="table"><thead><tr><th>From</th><th>€ / kWh</th><th>Note</th><th></th></tr></thead><tbody>
    <% tariffs.forEach(t => { %><tr><td><%= t.valid_from %></td><td>€ <%= Number(t.eur_per_kwh).toLocaleString('nl-NL', { minimumFractionDigits: 2, maximumFractionDigits: 4 }) %></td><td><%= t.note || '' %></td>
      <td><% if (canEdit('ocpp')) { %><form method="post" action="/ocpp/<%= bridge.id %>/tariffs/<%= t.id %>/delete" style="margin:0;" onsubmit="return confirm('Delete this tariff?');"><button type="submit" class="btn-soft"><%- icon('trash') %></button></form><% } %></td></tr><% }) %>
  </tbody></table><% } %>
  <% if (canEdit('ocpp')) { %>
  <form method="post" action="/ocpp/<%= bridge.id %>/tariffs" class="btn-row" style="align-items:flex-end; gap:0.6rem; margin-top:0.6rem;">
    <div><label>From</label><input type="date" name="valid_from" value="<%= new Date().toISOString().slice(0, 10) %>"></div>
    <div><label>€ / kWh</label><input type="text" name="eur_per_kwh" placeholder="e.g. 0,23" style="width:7rem;"></div>
    <div><label>Note</label><input type="text" name="note" placeholder="optional"></div>
    <button type="submit" class="btn-soft"><%- icon('plus') %> Add tariff</button>
  </form>
  <% } %>
</div>

<div class="card">
  <h2 style="margin-top:0;">Quarterly export</h2>
  <p class="hint">
    All charging sessions of a quarter with the MID meter reading at start and end, in the layout Laadloon accepts
    for manual uploads. Sessions recorded by this bridge (dry run or live) use the readings taken at plug-in/unplug;
    older sessions come from the Wallbox's session log on the Miniserver, with readings derived from the current meter
    total (marked "afgeleid").
  </p>
  <form method="get" action="/ocpp/<%= bridge.id %>/export" class="btn-row" style="align-items:flex-end; gap:0.6rem;">
    <div>
      <label>Quarter</label>
      <select name="quarter"><% quarters.forEach(q => { %><option value="<%= q %>"><%= q %></option><% }) %></select>
    </div>
    <div>
      <label>Format</label>
      <select name="format"><option value="xlsx">Excel (.xlsx)</option><option value="csv">CSV</option></select>
    </div>
    <div>
      <label>Content</label>
      <select name="finance"><option value="0">Sessions (Laadloon layout)</option><option value="1">With cost, reimbursement &amp; balance</option></select>
    </div>
    <button type="submit" class="btn-soft"><%- icon('download') %> Download</button>
  </form>
</div>

<% if (canEdit('ocpp')) { %>
<div class="card">
  <form method="post" action="/ocpp/<%= bridge.id %>/update">
    <%- include('partials/ocpp-bridge-fields', { b: bridge, wallboxes, isNew: false }) %>
    <div class="btn-row" style="margin-top:0.9rem;">
      <button type="submit" class="btn-edit"><%- icon('edit') %> Save</button>
    </div>
  </form>
  <form method="post" action="/ocpp/<%= bridge.id %>/delete" style="margin-top:0.8rem;"
        onsubmit="return confirm('Delete this OCPP bridge and its session history?');">
    <button type="submit" class="btn-soft"><%- icon('trash') %> Delete</button>
  </form>
</div>
<% } %>

<div class="card">
  <h2 style="margin-top:0;">Sessions</h2>
  <div id="ocpp-sessions"></div>
</div>

<div class="card">
  <h2 style="margin-top:0;">Log</h2>
  <p class="hint">Last 300 events since LoxSuite started. Passwords are never logged.</p>
  <pre id="ocpp-log" style="max-height:28rem; overflow:auto; font-size:0.75rem; white-space:pre-wrap;"></pre>
</div>

<script>
(function () {
  var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
  var kwh = function (wh) { return wh == null ? '' : (wh / 1000).toFixed(3); };
  // Show times in LoxSuite's display time zone (Settings), not UTC or the browser's own zone. The
  // OCPP messages themselves keep their UTC timestamps, as the protocol requires.
  var TZ = <%- JSON.stringify(typeof displayTimezone !== 'undefined' && displayTimezone ? displayTimezone : null) %>;
  var fmtOpts = { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23' };
  var timeOpts = { hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23' };
  var withTz = function (o) { var c = Object.assign({}, o); if (TZ) c.timeZone = TZ; return c; };
  var dt = function (iso) { try { return new Intl.DateTimeFormat('sv-SE', withTz(fmtOpts)).format(new Date(iso)); } catch (e) { return iso; } };
  var tm = function (iso) { try { return new Intl.DateTimeFormat('sv-SE', withTz(timeOpts)).format(new Date(iso)); } catch (e) { return iso.slice(11, 19); } };
  function render(data) {
    var s = data.status;
    var st = document.getElementById('ocpp-status');
    if (!s) {
      st.innerHTML = '<p class="hint" style="margin:0;"><%= bridge.enabled ? "Starting…" : "Disabled." %></p>';
    } else {
      var rows = [
        ['Mode', s.mode === 'live' ? 'Live' : 'Dry run (nothing is sent)'],
        ['Backend', s.mode === 'live' ? (s.connected ? (s.booted ? 'Connected, accepted' : 'Connected') : 'Not connected') : '—'],
        ['Wallbox', s.wallboxReady ? ('car ' + (Number(s.values.connected) === 1 ? 'plugged in' : 'not plugged in') + (Number(s.values.active) === 1 ? ', charging ' + Number(s.values.actual || 0).toFixed(2) + ' kW' : '') + ', meter ' + Number(s.values.total || 0).toFixed(3) + ' kWh') : 'waiting for live data'],
        ['Connector status', s.connectorStatus || '—'],
        ['Session', s.transaction ? ('since ' + dt(s.transaction.startedAt) + (s.transaction.pendingStart ? ', waiting for an ID tag from Loxone' : ', ID tag ' + (s.transaction.idTag || '—') + ', transaction ' + (s.transaction.transactionId == null ? 'pending' : s.transaction.transactionId)) + (s.stopPending ? ' (stopping…)' : '')) : (s.stopPending ? 'stopping…' : 'none')],
        ['ID tag mode', s.idTagMode === 'auto' ? 'Automatic (from Loxone)' : 'Fixed'],
        ['Queued messages', s.queueLength],
      ];
      if (s.lastError) rows.push(['Last error', '<span style="color: var(--danger);">' + esc(s.lastError) + '</span>']);
      st.innerHTML = '<table>' + rows.map(function (r) { return '<tr><th style="text-align:left; padding-right:1rem;">' + r[0] + '</th><td>' + (r[0] === 'Last error' ? r[1] : esc(r[1])) + '</td></tr>'; }).join('') + '</table>';
    }
    var ses = data.sessions || [];
    document.getElementById('ocpp-sessions').innerHTML = ses.length
      ? '<table><thead><tr><th>Start</th><th>Stop</th><th>Meter start</th><th>Meter stop</th><th>kWh</th><th>ID tag</th><th>Transaction</th><th>Mode</th></tr></thead><tbody>' +
        ses.map(function (x) {
          return '<tr><td>' + esc(dt(x.started_at)) + '</td><td>' + esc(x.stopped_at ? dt(x.stopped_at) : 'running') +
            '</td><td>' + kwh(x.meter_start_wh) + '</td><td>' + kwh(x.meter_stop_wh) + '</td><td>' + (x.meter_stop_wh == null ? '' : ((x.meter_stop_wh - x.meter_start_wh) / 1000).toFixed(3)) +
            '</td><td>' + esc(x.id_tag ? x.id_tag + ' (' + x.id_tag_source + ')' : '') + '</td><td>' + esc(x.transaction_id == null ? '' : x.transaction_id) + '</td><td>' + esc(x.mode) + '</td></tr>';
        }).join('') + '</tbody></table>'
      : '<p class="hint" style="margin:0;">No sessions recorded yet.</p>';
    document.getElementById('ocpp-log').textContent = (data.log || []).slice().reverse().map(function (l) {
      var rest = Object.assign({}, l); delete rest.ts; delete rest.kind;
      return tm(l.ts) + '  ' + l.kind + (Object.keys(rest).length ? '  ' + JSON.stringify(rest) : '');
    }).join('\n');
  }
  var testBtn = document.getElementById('ocpp-test-btn');
  if (testBtn) testBtn.addEventListener('click', function () {
    var out = document.getElementById('ocpp-test-result');
    testBtn.disabled = true;
    out.innerHTML = '<p class="hint" style="margin:0;">Testing&hellip;</p>';
    fetch('/ocpp/<%= bridge.id %>/test', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        var line = function (label, x) {
          return '<div><strong>' + label + ':</strong> <span style="color: var(--' + (x && x.ok ? 'success' : 'danger') + ');">' + (x && x.ok ? '&#10003; ' : '&#10007; ') + esc(x ? x.message : 'no answer') + '</span>' + (x && x.ms ? ' <span class="hint">(' + x.ms + ' ms)</span>' : '') + '</div>';
        };
        out.innerHTML = line('Backend', d.backend) + line('Wallbox', d.wallbox);
      })
      .catch(function (e) { out.innerHTML = '<p class="error" style="margin:0;">' + esc(e.message) + '</p>'; })
      .finally(function () { testBtn.disabled = false; });
  });
  var nf = function (v, d) { return v == null ? '—' : Number(v).toLocaleString('nl-NL', { minimumFractionDigits: d, maximumFractionDigits: d }); };
  var statsData = null;
  lsOnResize(function () { if (statsData) renderStats(statsData); });
  function renderStats(d) {
    statsData = d;
    var el = document.getElementById('ocpp-stats');
    if (!d || d.error || !d.stats) { el.innerHTML = '<p class="hint" style="margin:0;">' + esc(d && d.error ? d.error : 'No data yet.') + '</p>'; return; }
    var st = d.stats;
    var tile = function (label, v, sub) {
      return '<div style="border:1px solid var(--border, #e3e6ea); border-radius:10px; padding:0.8rem 0.9rem; background:var(--surface-2, rgba(0,0,0,0.02));">' +
        '<div class="hint" style="margin:0; font-size:0.75rem; text-transform:uppercase; letter-spacing:0.04em;">' + label + '</div>' +
        '<div style="font-size:1.6rem; font-weight:700; margin-top:0.2rem;">' + nf(v, 2) + ' <span style="font-size:0.85rem; font-weight:500;">kWh</span></div>' +
        '<div class="hint" style="margin:0.15rem 0 0; font-size:0.75rem;">' + (sub || '&nbsp;') + '</div></div>';
    };
    var qSub = function (q) { return esc(q.name.replace(/(\d{4})Q(\d)/, 'Q$2 $1')) + (q.incomplete ? ' · incomplete' : ''); };
    var exportLink = '/ocpp/<%= bridge.id %>/export?quarter=' + encodeURIComponent(st.prevQuarter.name) + '&format=xlsx';
    var html = '<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:0.75rem;">' +
      tile('Today', st.today) + tile('This week', st.week) + tile('This month', st.month) +
      tile('This quarter', st.quarter.kwh, qSub(st.quarter)) +
      tile('Previous quarter', st.prevQuarter.kwh, qSub(st.prevQuarter) + ' · <a href="' + exportLink + '">export</a>') +
      tile('This year', st.year) + '</div>';
    if (st.finance) {
      var f = st.finance;
      var eur = function (v) { return v == null ? '—' : '€ ' + nf(v, 2); };
      var ftile = function (label, o) {
        var sal = o.saldo;
        return '<div style="border:1px solid var(--border, #e3e6ea); border-radius:10px; padding:0.8rem 0.9rem; background:var(--surface-2, rgba(0,0,0,0.02));">' +
          '<div class="hint" style="margin:0; font-size:0.75rem; text-transform:uppercase; letter-spacing:0.04em;">' + label + '</div>' +
          '<div style="font-size:1.4rem; font-weight:700; margin-top:0.2rem; color:' + (sal == null ? 'inherit' : sal >= 0 ? 'var(--ok, #2e7d32)' : 'var(--danger, #c62828)') + ';">' + (sal == null ? eur(o.cost) : (sal >= 0 ? '+' : '') + eur(sal)) + '</div>' +
          '<div class="hint" style="margin:0.15rem 0 0; font-size:0.75rem;">' + (sal == null ? 'cost' : 'balance') + ' · cost ' + eur(o.cost) + (o.reimbursement != null ? ' · back ' + eur(o.reimbursement) : '') + (o.eurPerKwh != null ? ' · ' + eur(o.eurPerKwh) + '/kWh' : '') + '</div></div>';
      };
      html += '<div class="hint" style="margin:1rem 0 0.3rem; font-size:0.8rem;">Costs &amp; reimbursement' + (f.showVat === 'excl' ? ' (excl. VAT)' : '') + (f.hasTariff ? '' : ' &mdash; no reimbursement tariff yet, <a href="#finance">add one</a>') + '</div>' +
        '<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:0.75rem;">' +
        ftile('This month', f.month) + ftile('This quarter', f.quarter) + ftile('This year', f.year) + '</div>';
    }
    var ms = (st.months || []).slice();
    while (ms.length > 6 && ms[0].incomplete && !ms[0].kwh) ms.shift(); // hide empty months before the session log starts
    var max = Math.max.apply(null, ms.map(function (m) { return m.incomplete && !m.kwh ? 0 : m.kwh; }).concat([1]));
    var width = lsChartW(el, 600), H = 120, slot = (width - 20) / Math.max(1, ms.length), w = Math.max(14, Math.min(70, slot - 14));
    var svgH = st.finance ? 182 : 165;
    var svg = '<svg viewBox="0 0 ' + width + ' ' + svgH + '" width="100%" style="display:block;">';
    ms.forEach(function (m, i) {
      var x = 10 + i * slot + (slot - w) / 2;
      if (m.incomplete && !m.kwh) {
        svg += '<text x="' + (x + w / 2) + '" y="134" text-anchor="middle" font-size="10" fill="currentColor" opacity="0.45">no data</text>';
      } else {
        var h = Math.max(2, Math.round((m.kwh / max) * H));
        svg += '<rect x="' + x + '" y="' + (140 - h) + '" width="' + w + '" height="' + h + '" rx="4" fill="var(--accent, #4caf50)" opacity="' + (m.incomplete ? '0.45' : '0.85') + '"><title>' + esc(m.key) + ': ' + nf(m.kwh, 1) + ' kWh, ' + m.sessions + ' sessions</title></rect>' +
          '<text x="' + (x + w / 2) + '" y="' + (134 - h) + '" text-anchor="middle" font-size="10" fill="currentColor">' + nf(m.kwh, 1) + '</text>';
      }
      svg += '<text x="' + (x + w / 2) + '" y="158" text-anchor="middle" font-size="11" fill="currentColor" opacity="0.7">' + esc(m.label) + '</text>';
      if (st.finance && (m.saldo != null || m.cost != null)) {
        var sv = m.saldo != null ? m.saldo : -m.cost;
        svg += '<text x="' + (x + w / 2) + '" y="176" text-anchor="middle" font-size="10" fill="' + (sv >= 0 ? 'var(--ok, #2e7d32)' : 'var(--danger, #c62828)') + '"><title>' + (m.saldo != null ? 'balance' : 'cost') + '</title>' + (sv >= 0 ? '+' : '−') + '€' + nf(Math.abs(sv), 0) + '</text>';
      }
    });
    svg += '<line x1="5" y1="140" x2="' + (width - 5) + '" y2="140" stroke="currentColor" opacity="0.2"/></svg>';
    html += '<div style="margin-top:1rem;"><div class="hint" style="margin:0 0 0.3rem; font-size:0.8rem;">Per month</div>' + svg + '</div>';
    if (st.lastSession) html += '<p class="hint" style="margin:0.3rem 0 0;">Last session: <strong>' + nf(st.lastSession.kwh, 3) + ' kWh</strong>, ended ' + esc(dt(st.lastSession.stoppedAt)) + '.</p>';
    el.innerHTML = html;
    var picks = document.getElementById('ocpp-monitor-picks');
    if (picks && !picks.dataset.done && d.labels) {
      picks.innerHTML = Object.keys(d.labels).map(function (k) {
        return '<label style="display:flex; gap:0.4rem; align-items:center; font-weight:normal;"><input type="checkbox" value="' + k + '"' + (['today_kwh', 'month_kwh', 'quarter_kwh', 'year_kwh', 'power_kw'].indexOf(k) !== -1 ? ' checked' : '') + '> ' + esc(d.labels[k]) + '</label>';
      }).join('');
      picks.dataset.done = '1';
    }
  }
  function statsTick() {
    fetch('/ocpp/<%= bridge.id %>/stats.json').then(function (r) { return r.json(); }).then(renderStats).catch(function () {});
  }
  statsTick();
  setInterval(statsTick, 60000);
  var monBtn = document.getElementById('ocpp-monitor-btn');
  if (monBtn) monBtn.addEventListener('click', function () {
    var metrics = Array.prototype.slice.call(document.querySelectorAll('#ocpp-monitor-picks input:checked')).map(function (c) { return c.value; });
    var out = document.getElementById('ocpp-monitor-result');
    monBtn.disabled = true;
    fetch('/ocpp/<%= bridge.id %>/monitor', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ metrics: metrics }) })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        out.innerHTML = !d.ok ? esc(d.message) : ('Added ' + d.created.length + ' monitor(s)' + (d.skipped.length ? ', ' + d.skipped.length + ' already existed' : '') + '. <a href="/monitor">Open Monitor</a>');
      })
      .catch(function (e) { out.textContent = e.message; })
      .finally(function () { monBtn.disabled = false; });
  });
  function tick() {
    fetch('/ocpp/<%= bridge.id %>/status.json').then(function (r) { return r.json(); }).then(render).catch(function () {});
  }
  tick();
  setInterval(tick, 5000);
})();
</script>

<%- include('partials/foot') %>
