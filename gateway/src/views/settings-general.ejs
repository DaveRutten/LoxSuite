<%- include('partials/head', { pageTitle: 'Settings', active: 'settings' }) %>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>
<% if (saved) { %>
  <p class="hint" style="color: var(--success);">Saved.</p>
<% } %>

<% if (canEdit('settings')) { %>
<form method="post" action="/settings" id="settings-form">
  <div class="card">
    <h2>Display</h2>
    <div class="settings-field">
      <label>Timezone</label>
      <select name="display_timezone">
        <% timezones.forEach(tz => { %>
          <option value="<%= tz %>" <%= tz === gatewaySettings.display_timezone ? 'selected' : '' %>><%= tz %></option>
        <% }) %>
      </select>
      <p class="hint">
        Every date and time shown anywhere in LoxSuite is rendered in this timezone — an IANA name
        like <code>Europe/Amsterdam</code> (not a fixed offset, so daylight saving is handled
        automatically). Defaults to <code>UTC</code>, which is always correct but rarely what you
        actually want to see.
      </p>
    </div>
  </div>

  <div class="card">
    <h2>Data retention</h2>
    <p class="hint">How long history is kept before being purged automatically.</p>

    <div class="settings-field-list">
      <div class="settings-field">
        <label>Logs (days)</label>
        <input type="number" name="log_retention_days" min="1" value="<%= gatewaySettings.log_retention_days %>">
        <p class="hint">
          Raw log lines on the <a href="/logs">Logs</a> page (MQTT broker log, Loxone log, and the
          System log) older than this are deleted automatically, once a day.
        </p>
      </div>
      <div class="settings-field">
        <label>Monitor history (days)</label>
        <input type="number" name="monitor_retention_days" min="1" value="<%= gatewaySettings.monitor_retention_days %>">
        <p class="hint">
          Recorded readings on the <a href="/monitor">Monitor</a> page older than this are deleted
          automatically — keeps the database from growing forever on monitors polled frequently.
        </p>
      </div>
      <div class="settings-field">
        <label>Notification history (days)</label>
        <input type="number" name="notification_retention_days" min="1" value="<%= gatewaySettings.notification_retention_days %>">
        <p class="hint">
          Entries on the <a href="/logs/notifications">Notifications</a> log older than this are
          deleted automatically. Kept longer than raw logs by default — these are curated events,
          not high-volume protocol lines.
        </p>
      </div>
      <div class="settings-field">
        <label>Client Activity, after disconnect (hours)</label>
        <input type="number" name="client_retention_hours" min="1" value="<%= gatewaySettings.client_retention_hours %>">
        <p class="hint">
          How long a disconnected MQTT client stays listed on
          <a href="/incoming/clients">Client Activity</a> before being dropped from the list — each
          removal is logged on the <a href="/logs/system">System</a> log. Clients that are still
          actually connected are never affected by this.
        </p>
      </div>
    </div>
  </div>

  <div class="card">
    <h2>Miniservers</h2>
    <div class="settings-field-list">
      <div class="settings-field">
        <label>Check interval (seconds)</label>
        <input type="number" name="healthcheck_interval_seconds" min="10" value="<%= gatewaySettings.healthcheck_interval_seconds %>">
        <p class="hint">
          How often every <a href="/miniservers">Miniserver</a> is re-checked for reachability,
          firmware version, and diagnostics (CPU/heap/PLC state/etc). Takes effect on the very next
          check, no restart needed. 10 seconds minimum — going much lower adds constant load on
          every configured Miniserver for little benefit.
        </p>
      </div>
    </div>
  </div>

  <div class="card">
    <h2>Loxone Live Data</h2>
    <div class="settings-field">
      <label>Hidden state names</label>
      <div style="display:flex; gap:0.4rem; align-items:center; max-width:48rem; margin-bottom:0.5rem;">
        <input type="text" id="live-data-hidden-state-add" list="live-data-state-name-options" placeholder="Search a state name…" style="flex:1;">
        <button type="button" class="btn-soft" id="live-data-hidden-state-add-btn">Add</button>
      </div>
      <datalist id="live-data-state-name-options"></datalist>
      <textarea name="live_data_hidden_states" id="live-data-hidden-states-textarea" rows="4" style="font-family:monospace;" placeholder="jLocked"><%= (JSON.parse(gatewaySettings.live_data_hidden_states || '[]')).join('\n') %></textarea>
      <p class="hint">
        One state name per line, exact match (case-insensitive) &mdash; e.g. <code>jLocked</code>.
        Hides that state from every control that has it, on both
        <a href="/live-data">Live Data</a> and Monitor's "pick a state" list. Useful for a state
        that's repeated across dozens of otherwise-unrelated controls and reads as noise rather
        than something you'd actually want to look at. The field above suggests real state names
        seen across your configured Miniservers &mdash; type to search, then Add.
      </p>
    </div>
  </div>

  <div class="card">
    <h2>Dashboards</h2>
    <div class="settings-field">
      <label>Default decimals for "Current value" panels</label>
      <input type="number" name="default_panel_decimals" min="0" max="6" value="<%= gatewaySettings.default_panel_decimals %>">
      <p class="hint">
        Used whenever a "Current value" panel doesn't set its own — override it per panel from
        that panel's own Edit settings.
      </p>
    </div>
  </div>

  <div class="card">
    <h2>Features</h2>
    <label class="toggle-row">
      <input type="checkbox" name="dashboard_suggestions_enabled" <%= gatewaySettings.dashboard_suggestions_enabled ? 'checked' : '' %>>
      <span>
        <strong>Offer "Suggest dashboard" on <a href="/live-data">Live Data</a></strong>
        <span class="hint">
          Lets you generate a starter personal dashboard for a room (lighting, climate, shading,
          energy) straight from its structure, instead of adding monitors and panels one at a time.
        </span>
      </span>
    </label>
  </div>

  <div class="card">
    <h2>Table preferences</h2>
    <div class="settings-field">
      <label>Rows per page</label>
      <input type="number" name="table_page_size" value="<%= tablePageSize %>" min="5" max="500">
      <p class="hint">
        Applies to every table with more rows than this, across the whole app. Your own
        preference, not shared with other users — saved per-account even though every other
        field on this page is a shared, gateway-wide setting.
      </p>
    </div>
  </div>

  <div>
    <button type="submit" class="btn-edit"><%- icon('edit') %> Save</button>
  </div>
</form>
<% } %>

<script>
  (function () {
    var input = document.getElementById('live-data-hidden-state-add');
    var addBtn = document.getElementById('live-data-hidden-state-add-btn');
    var datalist = document.getElementById('live-data-state-name-options');
    var textarea = document.getElementById('live-data-hidden-states-textarea');
    if (!input || !textarea) return;

    fetch('/settings/live-data-state-names')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        (data.names || []).forEach(function (name) {
          var opt = document.createElement('option');
          opt.value = name;
          datalist.appendChild(opt);
        });
      })
      .catch(function () { /* best-effort — the field still works as plain free text without it */ });

    function addName() {
      var name = input.value.trim();
      if (!name) return;
      var existing = textarea.value.split('\n').map(function (s) { return s.trim(); }).filter(Boolean);
      if (existing.some(function (s) { return s.toLowerCase() === name.toLowerCase(); })) { input.value = ''; return; }
      existing.push(name);
      textarea.value = existing.join('\n');
      input.value = '';
      input.focus();
    }
    addBtn.addEventListener('click', addName);
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); addName(); }
    });
  })();
</script>

<%- include('partials/foot') %>
