<%- include('partials/head', { pageTitle: 'MQTT', active: 'incoming-schedules' }) %>

<p class="hint">
  <%= t('Sends one already-known MQTT command — picked from the') %>
  <a href="/mappings/commands"><%= t('Common Commands') %></a> <%= t('catalog — on a repeating schedule, e.g. a nightly reboot for a Shelly. Entirely opt-in per device; nothing here runs unless you add it below. Times are evaluated in this gateway\'s configured display timezone (') %><strong><%= timezone %></strong> <%= t('— change that in') %> <a href="/settings"><%= t('Settings') %></a>).
</p>

<% if (error) { %><p class="error"><%= error %></p><% } %>

<% if (deviceUnconfirmed) { %>
  <p class="hint" style="color: var(--warning);">
    <strong>&quot;<%= presetDevice %><%= t('" is a guess, not a confirmed match') %></strong> <%= t('— Client Activity couldn\'t match this device to a real MQTT topic prefix (there\'s no protocol-level way to ask the broker "who published this topic"), so both the Device field and the Device type below fell back to a guess (the raw MQTT client ID, and a name-based guess at its type). If the device was ever renamed in its own web UI, its real topic prefix can be completely different from its client ID. Check') %> <a href="/incoming/messages"><%= t('Live Traffic') %></a> <%= t('for the topic it actually publishes under, and correct both fields below if they\'re wrong — the command is built from whatever\'s actually in them, not from this guess.') %>
  </p>
<% } %>

<% if (canEdit('incoming')) { %>
<details class="add-panel" <%= presetDevice ? 'open' : '' %>>
  <summary><%= t('Add schedule') %></summary>
  <div class="add-panel-body">
    <form method="post" action="/incoming/schedules" class="form-grid" id="schedule-add-form">
      <div>
        <label for="schedule-device-input"><%= t('Device') %></label>
        <input type="text" name="device_key" id="schedule-device-input" list="schedule-known-devices" placeholder="<%= t('shellyplug-s-02086E') %>" value="<%= presetDevice %>" required>
        <datalist id="schedule-known-devices">
          <% allDevices.forEach(d => { %><option value="<%= d %>"></option><% }) %>
        </datalist>
      </div>
      <div>
        <label for="schedule-family-select"><%= t('Device type') %></label>
        <select name="family_key" id="schedule-family-select" required>
          <% catalog.forEach(f => { %>
            <option value="<%= f.key %>" <%= f.key === presetFamilyKey ? 'selected' : '' %>><%= f.label %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label for="schedule-command-select"><%= t('Command') %></label>
        <div style="display:flex; gap:0.4rem; align-items:center;">
          <select name="command_value" id="schedule-command-select" required style="flex:1;"></select>
          <button type="button" class="btn-soft" id="schedule-test-btn" title="<%= t('Send this exact command once, right now — before saving it as a recurring schedule') %>"><%= t('Test') %></button>
        </div>
        <span class="hint" id="schedule-no-command-hint" style="display:none; margin:0.3rem 0 0;">
          <%= t('This device type has no schedulable command yet — device-level commands only for now (not one that needs a channel), added via the') %> <a href="/mappings/commands"><%= t('Common Commands') %></a>
          <%= t('catalog.') %>
        </span>
        <span class="hint" id="schedule-test-result" style="display:none; margin:0.3rem 0 0;"></span>
      </div>
      <div>
        <label for="schedule-interval-select"><%= t('Repeat') %></label>
        <select name="interval_type" id="schedule-interval-select">
          <option value="daily"><%= t('Daily') %></option>
          <option value="every_n_days"><%= t('Every N days') %></option>
          <option value="weekly"><%= t('Weekly, on specific days') %></option>
        </select>
      </div>
      <div id="schedule-interval-days-field" style="display:none;">
        <label for="schedule-interval-days-input"><%= t('Every how many days') %></label>
        <input type="number" name="interval_days" id="schedule-interval-days-input" min="1" value="2">
      </div>
      <div id="schedule-weekdays-field" style="display:none; grid-column:1/-1;">
        <label><%= t('Days of week') %></label>
        <div style="display:flex; gap:0.9rem; flex-wrap:wrap;">
          <% ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].forEach((d, i) => { %>
            <label style="display:flex; align-items:center; gap:0.3rem; font-size:0.85rem; font-weight:400;">
              <input type="checkbox" name="weekdays" value="<%= i %>"> <%= d %>
            </label>
          <% }) %>
        </div>
      </div>
      <div>
        <label for="schedule-time-input"><%= t('Time of day') %></label>
        <input type="time" name="time_of_day" id="schedule-time-input" value="01:00" required>
      </div>
      <div>
        <button type="submit" class="primary" id="schedule-add-submit"><%- icon('plus') %> <%= t('Add schedule') %></button>
      </div>
    </form>
  </div>
</details>
<% } %>

<div class="filterable-table-card" style="margin-top:1.5rem;">
  <div class="table-wrap">
  <table>
    <thead>
      <tr><th><%= t('Device') %></th><th><%= t('Command') %></th><th><%= t('Repeat') %></th><th><%= t('Next run') %></th><th><%= t('Last run') %></th><th><%= t('Enabled') %></th><th><%= t('Actions') %></th></tr>
    </thead>
    <tbody>
      <% const WEEKDAY_LABELS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']; %>
      <% schedules.forEach(s => { %>
        <tr>
          <td><%= s.device_key %></td>
          <td><code class="truncate" title="<%= s.mqtt_topic %>"><%= s.command_label %></code></td>
          <td>
            <% if (s.interval_type === 'daily') { %>
              <%= t('Daily at') %> <%= s.time_of_day %>
            <% } else if (s.interval_type === 'every_n_days') { %>
              <%= t('Every') %> <%= s.interval_days %> day<%= s.interval_days === 1 ? '' : 's' %> at <%= s.time_of_day %>
            <% } else { %>
              <%= t('Weekly (') %><%= (s.weekdays || '').split(',').filter(Boolean).map(d => WEEKDAY_LABELS[Number(d)]).join(', ') %><%= t(') at') %> <%= s.time_of_day %>
            <% } %>
          </td>
          <td><%= s.nextRun ? formatDateTime(s.nextRun.toISOString()) : '-' %></td>
          <td>
            <% if (s.last_run_at) { %>
              <span class="badge <%= s.last_status === 'ok' ? 'badge-ok' : 'badge-off' %>"><%= formatDateTime(s.last_run_at) %></span>
              <% if (s.last_status !== 'ok' && s.last_error) { %><div class="hint" style="margin:0.25rem 0 0;"><%= s.last_error %></div><% } %>
            <% } else { %><%= t('Never') %><% } %>
          </td>
          <td>
            <% if (canEdit('incoming')) { %>
            <form method="post" action="/incoming/schedules/<%= s.id %>/toggle" class="schedule-toggle-form">
              <%- toggleSwitch('enabled', !!s.enabled) %>
            </form>
            <% } else { %><%= s.enabled ? 'Yes' : 'No' %><% } %>
          </td>
          <td>
            <% if (canEdit('incoming')) { %>
            <div class="row-actions">
              <button type="button" class="btn-edit" data-toggle-row="schedule-edit-<%= s.id %>"><%- icon('edit') %> <%= t('Edit') %></button>
              <form method="post" action="/incoming/schedules/<%= s.id %>/run-now">
                <button type="submit" class="btn-soft" title="<%= t('Send this command right now, to test it') %>"><%- icon('power') %> <%= t('Run now') %></button>
              </form>
              <form method="post" action="/incoming/schedules/<%= s.id %>/delete" data-confirm="<%= t('Delete this schedule?') %>">
                <button type="submit" class="icon-btn icon-btn-danger" title="<%= t('Delete') %>"><%- icon('trash') %></button>
              </form>
            </div>
            <% } %>
          </td>
        </tr>
        <% if (canEdit('incoming')) { %>
        <tr class="expand-row" id="schedule-edit-<%= s.id %>">
          <td colspan="7">
            <form method="post" action="/incoming/schedules/<%= s.id %>/update" class="form-grid schedule-edit-form">
              <div>
                <label><%= t('Repeat') %></label>
                <select name="interval_type" class="schedule-edit-interval-select">
                  <option value="daily" <%= s.interval_type === 'daily' ? 'selected' : '' %>><%= t('Daily') %></option>
                  <option value="every_n_days" <%= s.interval_type === 'every_n_days' ? 'selected' : '' %>><%= t('Every N days') %></option>
                  <option value="weekly" <%= s.interval_type === 'weekly' ? 'selected' : '' %>><%= t('Weekly, on specific days') %></option>
                </select>
              </div>
              <div class="schedule-edit-days-field" style="<%= s.interval_type === 'every_n_days' ? '' : 'display:none;' %>">
                <label><%= t('Every how many days') %></label>
                <input type="number" name="interval_days" min="1" value="<%= s.interval_days || 2 %>">
              </div>
              <div class="schedule-edit-weekdays-field" style="grid-column:1/-1; <%= s.interval_type === 'weekly' ? '' : 'display:none;' %>">
                <label><%= t('Days of week') %></label>
                <div style="display:flex; gap:0.9rem; flex-wrap:wrap;">
                  <% var savedWeekdays = (s.weekdays || '').split(',').filter(Boolean); %>
                  <% ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].forEach((d, i) => { %>
                    <label style="display:flex; align-items:center; gap:0.3rem; font-size:0.85rem; font-weight:400;">
                      <input type="checkbox" name="weekdays" value="<%= i %>" <%= savedWeekdays.includes(String(i)) ? 'checked' : '' %>> <%= d %>
                    </label>
                  <% }) %>
                </div>
              </div>
              <div>
                <label><%= t('Time of day') %></label>
                <input type="time" name="time_of_day" value="<%= s.time_of_day %>" required>
              </div>
              <div>
                <button type="submit" class="primary"><%- icon('check') %> <%= t('Save') %></button>
              </div>
            </form>
          </td>
        </tr>
        <% } %>
      <% }) %>
      <% if (schedules.length === 0) { %>
        <tr><td colspan="7" class="empty"><%= t('No scheduled commands yet.') %></td></tr>
      <% } %>
    </tbody>
  </table>
  </div>
</div>

<script>
  (function () {
    // A schedule fires one FIXED thing on a timer, unlike "Suggest commands"' own pick-one-when-
    // you-click-it buttons — "Relay switch" with its on/off/toggle actions has to become three
    // distinct choices here, not one dropdown plus a second "which action" dropdown. Device-level
    // commands only (topicTemplate with no {channel} of its own, e.g. a Shelly's "Reboot") — a
    // per-channel one (relay/roller/...) would need a channel picker this UI doesn't have yet.
    var catalog = <%- JSON.stringify(catalog) %>;
    var deviceFamily = <%- JSON.stringify(deviceFamily) %>;

    var deviceInput = document.getElementById('schedule-device-input');
    var familySelect = document.getElementById('schedule-family-select');
    var commandSelect = document.getElementById('schedule-command-select');
    var noCommandHint = document.getElementById('schedule-no-command-hint');
    var addSubmit = document.getElementById('schedule-add-submit');
    var testBtn = document.getElementById('schedule-test-btn');
    var testResult = document.getElementById('schedule-test-result');
    if (!deviceInput || !familySelect || !commandSelect) return;

    function commandOptionsFor(familyKey) {
      var family = catalog.find(function (f) { return f.key === familyKey; });
      if (!family || !family.commands) return [];
      return family.commands
        .filter(function (c) { return c.topicTemplate.indexOf('{channel}') === -1; })
        .reduce(function (opts, c) {
          c.actions.forEach(function (action, i) {
            opts.push({ value: c.key + '::' + i, label: c.actions.length > 1 ? (c.label + ': ' + action) : c.label });
          });
          return opts;
        }, []);
    }

    function rebuildCommandSelect() {
      var opts = commandOptionsFor(familySelect.value);
      commandSelect.innerHTML = '';
      opts.forEach(function (o) {
        var el = document.createElement('option');
        el.value = o.value;
        el.textContent = o.label;
        commandSelect.appendChild(el);
      });
      var hasOptions = opts.length > 0;
      commandSelect.disabled = !hasOptions;
      if (noCommandHint) noCommandHint.style.display = hasOptions ? 'none' : '';
      if (addSubmit) addSubmit.disabled = !hasOptions;
      if (testBtn) testBtn.disabled = !hasOptions;
      if (testResult) testResult.style.display = 'none';
    }

    deviceInput.addEventListener('input', function () {
      var known = deviceFamily[deviceInput.value];
      if (known) { familySelect.value = known; rebuildCommandSelect(); }
    });
    familySelect.addEventListener('change', rebuildCommandSelect);
    rebuildCommandSelect();

    if (testBtn) {
      testBtn.addEventListener('click', function () {
        testResult.style.display = '';
        testResult.style.color = '';
        testResult.textContent = 'Sending…';
        testBtn.disabled = true;
        fetch('/incoming/schedules/test-send', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            device_key: deviceInput.value,
            family_key: familySelect.value,
            command_value: commandSelect.value,
          }),
        })
          .then(function (r) { return r.json().then(function (body) { return { ok: r.ok, body: body }; }); })
          .then(function (result) {
            testBtn.disabled = false;
            if (result.ok && result.body.ok) {
              testResult.style.color = 'var(--success)';
              testResult.textContent = 'Sent "' + result.body.payload + '" to ' + result.body.topic + '.';
            } else {
              testResult.style.color = 'var(--danger)';
              testResult.textContent = (result.body && result.body.error) || 'Failed to send.';
            }
          })
          .catch(function () {
            testBtn.disabled = false;
            testResult.style.color = 'var(--danger)';
            testResult.textContent = 'Failed to send — check the gateway is reachable.';
          });
      });
    }

    var intervalSelect = document.getElementById('schedule-interval-select');
    var daysField = document.getElementById('schedule-interval-days-field');
    var weekdaysField = document.getElementById('schedule-weekdays-field');
    function syncIntervalFields() {
      daysField.style.display = intervalSelect.value === 'every_n_days' ? '' : 'none';
      weekdaysField.style.display = intervalSelect.value === 'weekly' ? '' : 'none';
    }
    intervalSelect.addEventListener('change', syncIntervalFields);
    syncIntervalFields();

    // One edit form per schedule row (see the expand-row markup above) — delegated on the
    // document since collapseRowActions() (tables.js) can insert the Edit toggle button into a
    // freshly-created popover after this script has already run, same reasoning as every other
    // delegated listener already in this app.
    document.addEventListener('change', function (e) {
      if (!e.target.matches('.schedule-edit-interval-select')) return;
      var form = e.target.closest('.schedule-edit-form');
      form.querySelector('.schedule-edit-days-field').style.display = e.target.value === 'every_n_days' ? '' : 'none';
      form.querySelector('.schedule-edit-weekdays-field').style.display = e.target.value === 'weekly' ? '' : 'none';
    });

    // The switch itself has no Save button of its own (see toggleSwitch's own doc comment) —
    // every OTHER page using it lives inside a bigger settings form with one shared Save button,
    // but this one's whole form IS just the switch, so a plain change listener submitting it
    // immediately is the equivalent of that page's own Save click, not a new pattern.
    document.querySelectorAll('.schedule-toggle-form input[type="checkbox"]').forEach(function (cb) {
      cb.addEventListener('change', function () {
        var form = cb.closest('form');
        if (form) (form.requestSubmit ? form.requestSubmit() : form.submit());
      });
    });
  })();
</script>

<%- include('partials/foot') %>
