<%- include('partials/head', { pageTitle: 'Settings', active: 'broker-settings' }) %>

<%- include('partials/tabs-mqtt-broker', { active: 'broker-settings' }) %>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>
<% if (saved) { %>
  <p class="hint" style="color: var(--success);">Saved.</p>
<% } %>

<div class="card">
  <h2>MQTT Broker</h2>
  <p class="hint">
    The bundled Mosquitto broker runs inside this same container and listens internally on
    <code>127.0.0.1:1883</code>. You can also point this at a different/external broker &mdash;
    the gateway will then stop using the bundled Mosquitto process for this connection.
  </p>
  <% if (canEdit('settings')) { %>
  <form method="post" action="/settings/broker">
    <div class="form-grid">
      <div>
        <label>Host</label>
        <input type="text" name="host" value="<%= settings.host %>" required>
      </div>
      <div>
        <label>Port</label>
        <input type="number" name="port" value="<%= settings.port %>" required>
      </div>
      <div>
        <label>TLS</label>
        <select name="use_tls">
          <option value="" <%= !settings.use_tls ? 'selected' : '' %>>No</option>
          <option value="1" <%= settings.use_tls ? 'selected' : '' %>>Yes</option>
        </select>
      </div>
    </div>
    <div class="form-grid" style="margin-top:0.85rem;">
      <div>
        <label>Username</label>
        <input type="text" name="username" value="<%= settings.username || '' %>">
      </div>
      <div>
        <label>Password</label>
        <input type="password" name="password" value="<%= settings.password || '' %>">
      </div>
    </div>

    <h2 style="margin-top:1.5rem;">Features</h2>
    <div class="settings-field">
      <label>Loxone &rarr; MQTT auto-create</label>
      <select name="auto_create_enabled" style="max-width:10rem;">
        <option value="" <%= !gatewaySettings.auto_create_loxone_mappings ? 'selected' : '' %>>Off</option>
        <option value="1" <%= gatewaySettings.auto_create_loxone_mappings ? 'selected' : '' %>>On</option>
      </select>
      <p class="hint">
        Off by default: an unrecognised token/topic sent from Loxone (HTTP or UDP) is rejected (404
        or a log warning). On, the gateway creates a new passthrough mapping on the fly instead —
        useful if you'd rather send topics directly from Loxone without pre-registering each one
        here first, but a typo in Loxone Config will then silently create a stray mapping instead
        of failing loudly.
      </p>
    </div>

    <div style="margin-top:0.9rem;">
      <button type="submit" class="btn-edit"><%- icon('edit') %> Save &amp; reconnect</button>
    </div>
  </form>
  <% } %>
</div>

<%- include('partials/foot') %>
