<%- include('partials/head', { pageTitle: 'Mappings', active: 'mqtt-to-loxone' }) %>

<%- include('partials/tabs-mappings', { active: 'mqtt-to-loxone' }) %>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<% if (miniservers.length === 0) { %>
  <p class="hint">Add a <a href="/miniservers">Miniserver</a> first.</p>
<% } else { %>
  <% if (canEdit('mqtt_to_loxone')) { %>
  <details class="add-panel" <%= prefillTopic ? 'open' : '' %>>
    <summary>Add mapping</summary>
    <div class="add-panel-body">
      <form method="post" action="/mappings/mqtt-to-loxone">
        <div class="form-grid">
          <div>
            <label>MQTT topic</label>
            <input type="text" name="mqtt_topic" placeholder="home/livingroom/light" value="<%= prefillTopic %>" required>
          </div>
          <div>
            <label>Miniserver</label>
            <select name="miniserver_id" id="miniserver-select" required>
              <% miniservers.forEach(ms => { %>
                <option value="<%= ms.id %>"><%= ms.name %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <label>Transport</label>
            <select name="transport">
              <option value="http">HTTP (Virtual Input)</option>
              <option value="udp">UDP (Virtual Input)</option>
            </select>
          </div>
          <div>
            <label>Virtual input name <span class="hint" style="margin:0;display:inline;">(UDP: documentation only, not sent)</span></label>
            <input type="text" name="target" list="target-suggestions" placeholder="LivingRoomLight" required>
            <datalist id="target-suggestions">
              <% targetSuggestions.forEach(t => { %><option value="<%= t %>"><% }) %>
            </datalist>
          </div>
          <div>
            <label>Value transform</label>
            <select name="value_transform">
              <option value="passthrough">Pass through unchanged</option>
              <option value="bool_on_off">on/off &rarr; 1/0</option>
              <option value="json_path">JSON path</option>
              <option value="translation_table">Translation table (manage after adding)</option>
            </select>
          </div>
          <div>
            <label>Transform argument (e.g. JSON path "data.temp")</label>
            <input type="text" name="transform_arg">
          </div>
          <div>
            <label>Min. interval between updates (ms, 0 = off)</label>
            <input type="number" name="min_interval_ms" value="0" min="0">
          </div>
          <button type="submit" class="primary"><%- icon('plus') %> Add</button>
        </div>
      </form>
    </div>
  </details>
  <% } %>
<% } %>

<div class="filterable-table-card">
  <div class="table-toolbar">
    <div class="search-single">
      <input type="text" id="m2l-search" placeholder="Filter&hellip;">
      <button type="button" id="m2l-search-clear" class="icon-btn clearable-input-clear" title="Clear filter" aria-label="Clear filter" hidden>&times;</button>
    </div>
    <% if (canEdit('mqtt_to_loxone')) { %>
    <% var disabledCount = mappings.filter(m => !m.enabled).length; var enabledCount = mappings.length - disabledCount; %>
    <form method="post" action="/mappings/mqtt-to-loxone/enable-all" style="margin:0;">
      <button type="submit" class="btn-edit" <%= disabledCount === 0 ? 'disabled' : '' %>><%- icon('power') %> Enable all (<%= disabledCount %>)</button>
    </form>
    <form method="post" action="/mappings/mqtt-to-loxone/disable-all" style="margin:0;">
      <button type="submit" class="btn-edit" <%= enabledCount === 0 ? 'disabled' : '' %>><%- icon('power') %> Disable all (<%= enabledCount %>)</button>
    </form>
    <% } %>
    <div class="columns-menu columns-menu-inline" id="m2l-columns-menu">
      <button type="button" class="btn-soft" id="m2l-columns-btn"><%- icon('columns') %> Columns</button>
      <div class="columns-menu-panel" id="m2l-columns-panel" hidden></div>
    </div>
  </div>

  <div class="table-wrap">
    <div id="m2l-tabulator"></div>
  </div>
</div>

<link rel="stylesheet" href="/vendor/tabulator.min.css">
<link rel="stylesheet" href="/tabulator-theme.css">
<script src="/vendor/tabulator.min.js"></script>
<script src="/vendor/floating-ui.core.umd.min.js"></script>
<script src="/vendor/floating-ui.dom.umd.min.js"></script>
<script src="/tabulator-table.js"></script>
<script src="/mappings-mqtt-to-loxone-tabulator.js"></script>

<%- include('partials/foot') %>
