<%- include('partials/head', { pageTitle: 'Administration', active: 'admin' }) %>

<div class="tabs">
  <a href="/admin/general">General</a>
  <a href="/admin/users">Users</a>
  <a href="/admin/roles">Access Roles</a>
  <a href="/admin/backup">Backups</a>
  <a href="/admin/notifications">Notifications</a>
  <a class="active" href="/admin/security">Security</a>
  <a href="/admin/modules">Modules</a>
  <% if (typeof moduleOn !== 'function' || moduleOn('ai')) { %><a href="/admin/ai">AI Assistant</a><% } %>
</div>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>
<% if (saved) { %>
  <p class="hint" style="color: var(--success);">Saved.</p>
<% } %>

<div class="card">
  <h2>Login rate limit</h2>
  <p class="hint">Limits how fast one IP address can try passwords on the login page.</p>

  <form method="post" action="/admin/security" id="login-rate-limit-form" class="form-grid">
    <div>
      <label>Max login attempts</label>
      <input type="number" name="login_rate_limit_max" min="1" value="<%= gatewaySettings.login_rate_limit_max %>" style="max-width:8rem;">
    </div>
    <div>
      <label>Time window (minutes)</label>
      <input type="number" name="login_rate_limit_window_minutes" min="1" value="<%= gatewaySettings.login_rate_limit_window_minutes %>" style="max-width:8rem;">
    </div>
  </form>
  <p class="hint" style="margin-top:0.6rem;">
    E.g. 10 attempts / 15 minutes means an 11th attempt from the same IP within 15 minutes of its
    first is refused, with a "Too many login attempts" message, until the window rolls over.
    Applies to local username/password login only — SSO isn't affected (Pocket ID rate-limits
    itself).
  </p>

  <div style="margin-top:0.9rem;">
    <button type="submit" form="login-rate-limit-form" class="btn-edit"><%- icon('edit') %> Save</button>
  </div>
</div>

<% if (proxyTrustMisconfigured) { %>
  <p class="error">
    This request arrived carrying a forwarded-by-proxy header, but the app isn't told to trust it
    (<code>TRUST_PROXY</code> isn't set — see .env.example). That means every visitor, including
    real external ones, currently looks like they're on the local network to this app — silently
    defeating "Require SSO from outside the local network" below (and the local-login rate limit's
    own per-IP tracking above). Set <code>TRUST_PROXY</code> to match your reverse proxy/tunnel
    setup and restart the gateway.
  </p>
<% } %>

<div class="card">
  <h2>Geo-blocking</h2>
  <p class="hint">
    Block visitors from specific countries, or allow only specific ones &mdash; looked up from
    their IP against a local <a href="https://dev.maxmind.com/geoip/geolite2-free-geolocation-data" target="_blank" rel="noopener">MaxMind GeoLite2</a>
    database, with no per-request call to a third party. Applies to the whole app on every request
    (not just the login form), the same way "Require SSO from outside the local network" above
    does &mdash; a request from your own local network is always exempt, so you can't lock yourself
    out from home and a Loxone Miniserver's own callback (always LAN-local in a normal setup) is
    never affected.
  </p>

  <form method="post" action="/admin/security/geo-block" id="geo-block-form">
    <div class="form-grid">
      <div>
        <label>Mode</label>
        <select name="mode" id="geo-block-mode">
          <option value="off" <%= geoBlock.mode === 'off' ? 'selected' : '' %>>Off</option>
          <option value="blocklist" <%= geoBlock.mode === 'blocklist' ? 'selected' : '' %>>Block these countries</option>
          <option value="allowlist" <%= geoBlock.mode === 'allowlist' ? 'selected' : '' %>>Allow only these countries</option>
        </select>
      </div>
    </div>

    <div id="geo-block-properties" style="margin-top:0.85rem; <%= geoBlock.mode === 'off' ? 'display:none;' : '' %>">
      <h3>MaxMind account</h3>
      <p class="hint">
        GeoLite2 is free but requires a free <a href="https://www.maxmind.com/en/geolite2/signup" target="_blank" rel="noopener">MaxMind account</a>
        to download &mdash; its license doesn't allow bundling the database file itself, so LoxSuite
        fetches it directly with your own credentials (Account ID + a generated license key, from
        your MaxMind account's "Manage License Keys" page) and refreshes it automatically about
        once a day.
      </p>
      <div class="form-grid">
        <div>
          <label>Account ID</label>
          <input type="text" name="maxmind_account_id" value="<%= geoBlock.maxmindAccountId %>">
        </div>
        <div>
          <label>License key</label>
          <input type="password" name="maxmind_license_key" placeholder="<%= geoBlock.maxmindLicenseKey ? 'Leave blank to keep the current key' : '' %>">
        </div>
      </div>
      <div style="margin-top:0.6rem; display:flex; align-items:center; gap:0.6rem; flex-wrap:wrap;">
        <button type="button" class="btn-soft" id="geo-block-update-now"><%- icon('refresh') %> Update database now</button>
        <span class="hint" id="geo-block-db-status">
          <% if (geoBlock.dbUpdatedAt) { %>
            Last updated <%= formatDateTime(geoBlock.dbUpdatedAt) %><% if (geoBlock.dbStatus === 'error') { %> &mdash; <span style="color:var(--danger);">most recent refresh attempt failed: <%= geoBlock.dbError %></span><% } %>
          <% } else if (geoBlock.dbStatus === 'error') { %>
            <span style="color:var(--danger);">Never downloaded &mdash; last attempt failed: <%= geoBlock.dbError %></span>
          <% } else { %>
            Never downloaded yet.
          <% } %>
        </span>
      </div>

      <h3 style="margin-top:1.2rem;">Countries</h3>
      <p class="hint" id="geo-block-list-hint">
        <% if (geoBlock.mode === 'blocklist') { %>Requests from a checked country are refused; every other country is allowed.
        <% } else { %>Only requests from a checked country are allowed; every other country is refused.<% } %>
      </p>
      <input type="text" id="geo-block-country-filter" placeholder="Filter countries…" style="max-width:20rem; margin-bottom:0.5rem;">
      <div style="max-height:16rem; overflow-y:auto; border:1px solid var(--border); border-radius:var(--radius); padding:0.5rem 0.75rem;">
        <% countries.forEach(c => { %>
          <label class="geo-block-country-row" data-country-name="<%= c.name.toLowerCase() %>" style="display:flex; align-items:center; gap:0.5rem; padding:0.2rem 0;">
            <input type="checkbox" name="countries" value="<%= c.code %>" <%= geoBlock.countries.includes(c.code) ? 'checked' : '' %>>
            <span><%= c.flag %></span><span><%= c.name %></span>
          </label>
        <% }) %>
      </div>
    </div>

    <div style="margin-top:0.9rem;">
      <button type="submit" class="btn-edit"><%- icon('edit') %> Save</button>
    </div>
  </form>
  <script>
    (function () {
      var modeSelect = document.getElementById('geo-block-mode');
      var properties = document.getElementById('geo-block-properties');
      var listHint = document.getElementById('geo-block-list-hint');
      modeSelect.addEventListener('change', function () {
        properties.style.display = modeSelect.value === 'off' ? 'none' : '';
        listHint.textContent = modeSelect.value === 'blocklist'
          ? 'Requests from a checked country are refused; every other country is allowed.'
          : 'Only requests from a checked country are allowed; every other country is refused.';
      });

      var filterInput = document.getElementById('geo-block-country-filter');
      filterInput.addEventListener('input', function () {
        var q = filterInput.value.trim().toLowerCase();
        document.querySelectorAll('.geo-block-country-row').forEach(function (row) {
          row.style.display = !q || row.dataset.countryName.indexOf(q) !== -1 ? '' : 'none';
        });
      });

      var updateBtn = document.getElementById('geo-block-update-now');
      var statusEl = document.getElementById('geo-block-db-status');
      updateBtn.addEventListener('click', function () {
        updateBtn.disabled = true;
        var original = statusEl.textContent;
        statusEl.textContent = 'Downloading…';
        fetch('/admin/security/geo-block/update-now', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            statusEl.textContent = data.ok
              ? 'Updated just now.'
              : 'Update failed: ' + data.error;
            statusEl.style.color = data.ok ? '' : 'var(--danger)';
          })
          .catch(function () { statusEl.textContent = original; })
          .finally(function () { updateBtn.disabled = false; });
      });
    })();
  </script>
</div>

<div class="card">
  <h2>Single Sign-On</h2>
  <p class="hint">
    Lets people log in with a self-hosted <a href="https://pocket-id.org" target="_blank" rel="noopener">Pocket ID</a>
    instance, alongside (not instead of) the existing username/password login. The first time someone
    signs in via Pocket ID, an account is created for them automatically with the default Access Role
    below &mdash; pick something with limited permissions unless you want every SSO user to start out
    as an administrator.
  </p>

  <form method="post" action="/admin/sso">
    <div class="form-grid">
      <div>
        <label>Enabled</label>
        <%- toggleSwitch('enabled', sso.enabled, { id: 'sso-enabled-toggle' }) %>
      </div>
    </div>

    <%
      // Everything below only matters once SSO is actually turned on — kept hidden until then
      // (toggled client-side by #sso-enabled-toggle's own change handler, see the script below)
      // instead of showing a pile of fields for a feature that's off. Wrapped in its own
      // .form-grid (rather than continuing the one above) since the Enabled field needs to stay
      // visible/reachable even while everything after it is hidden.
    %>
    <div id="sso-properties" class="form-grid" style="margin-top:0.85rem; <%= sso.enabled ? '' : 'display:none;' %>">
      <div>
        <label>Button label</label>
        <input type="text" name="button_label" value="<%= sso.button_label %>">
      </div>
      <div>
        <label>Issuer URL</label>
        <input type="text" name="issuer_url" value="<%= sso.issuer_url || '' %>" placeholder="https://pocket-id.example.com">
      </div>
      <div>
        <label>Client ID</label>
        <input type="text" name="client_id" value="<%= sso.client_id || '' %>">
      </div>
      <div>
        <label>Client secret</label>
        <input type="password" name="client_secret" placeholder="<%= sso.client_secret ? 'Leave blank to keep the current secret' : '' %>">
      </div>
      <div>
        <label>Default Access Role for new SSO users</label>
        <select name="default_role_id">
          <option value="">-</option>
          <% roles.forEach(r => { %>
            <option value="<%= r.id %>" <%= r.id === sso.default_role_id ? 'selected' : '' %>><%= r.name %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div id="sso-fallback" style="<%= sso.enabled ? '' : 'display:none;' %>">
      <h3 style="margin-top:1.5rem;">Local login fallback</h3>
      <label class="toggle-row">
        <input type="checkbox" name="local_login_disabled" <%= sso.local_login_disabled ? 'checked' : '' %>>
        <span>
          <strong>Require SSO from outside the local network</strong>
          <span class="hint">
            When on, the username/password login form is hidden for anyone NOT connecting from a
            private/local-network address — they must sign in with SSO instead. Local-network
            requests can still always use local login as a break-glass fallback, so you're never
            locked out if Pocket ID itself becomes unreachable. <strong>Behind a reverse proxy or
            tunnel</strong> (Cloudflare Tunnel, Nginx Proxy Manager, Traefik...): every request
            looks like it's coming from that proxy's own local address unless it's told to trust
            the proxy's forwarded headers — set <code>TRUST_PROXY</code> (see .env.example) or this
            stays permanently "on" for every visitor, local or not.
          </span>
        </span>
      </label>
    </div>

    <div id="sso-save-row" style="margin-top:0.9rem; <%= sso.enabled ? '' : 'display:none;' %>">
      <button type="submit" class="btn-edit"><%- icon('edit') %> Save</button>
    </div>
  </form>
  <script>
    (function () {
      var toggle = document.getElementById('sso-enabled-toggle');
      var properties = document.getElementById('sso-properties');
      var fallback = document.getElementById('sso-fallback');
      var saveRow = document.getElementById('sso-save-row');
      toggle.addEventListener('change', function () {
        properties.style.display = toggle.checked ? '' : 'none';
        fallback.style.display = toggle.checked ? '' : 'none';
        saveRow.style.display = toggle.checked ? '' : 'none';
        // Turning it off has nothing left to fill in — save that state right away instead of
        // making it disappear along with the very button that would have persisted it. Turning it
        // ON only reveals the fields (no auto-submit) so there's a chance to fill them in first.
        if (!toggle.checked) toggle.closest('form').submit();
      });
    })();
  </script>

  <p class="hint" style="margin-top:1rem;">
    In Pocket ID's client settings, register <code><%= baseUrl %>/auth/sso/callback</code> as the
    <strong>Callback URL</strong>. If you also want LoxSuite to show up as a launchable app on the
    Pocket ID home screen, set <code><%= baseUrl %>/</code> as the <strong>Client Launch URL</strong>
    (the "User URL") &mdash; that's the address a signed-in user lands on.
  </p>
</div>

<%- include('partials/foot') %>
