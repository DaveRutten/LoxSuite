<%- include('partials/head', { pageTitle: 'Mappings', active: 'loxone-to-mqtt' }) %>

<%- include('partials/tabs-mappings', { active: 'loxone-to-mqtt' }) %>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<p class="hint">
  <strong>HTTP</strong>: paste the callback URL into the Virtual Output HTTP command in Loxone Config.<br>
  <strong>UDP</strong>: send <code>&lt;token&gt;=\v</code> to the gateway on the listed UDP port from a Virtual UDP Output.
  Loxone replaces <code>\v</code> with the actual value on every call. The mapping's own MQTT topic also works in place
  of the token (e.g. <code>&lt;mqtt_topic&gt;=on</code>), so you don't have to copy the generated token if you'd rather
  type the topic you already know.<br>
  <strong>Test</strong>: publish a value on a mapping's row to check the device reacts, without needing Loxone at all
  &mdash; any value transform (e.g. a translation table) is applied exactly as it would be for a real call.
</p>

<% if (canEdit('loxone_to_mqtt')) { %>
<details class="add-panel" <%= (prefillTopic || prefillTransport || prefillMiniserverId) ? 'open' : '' %>>
  <summary>Add mapping</summary>
  <div class="add-panel-body">
    <form method="post" action="/mappings/loxone-to-mqtt">
      <div class="form-grid">
        <div>
          <label>MQTT topic</label>
          <input type="text" name="mqtt_topic" id="mqtt-topic-input" value="<%= prefillTopic %>" placeholder="home/livingroom/temperature" required>
          <span class="hint" style="margin:0.3rem 0 0;">Not sure about the topic for a Shelly or similar device? Use the <a href="/mappings/commands">Common commands</a> builder.</span>
        </div>
        <div>
          <label>Miniserver (informational)</label>
          <select name="miniserver_id">
            <option value="">-</option>
            <% miniservers.forEach(ms => { %>
              <option value="<%= ms.id %>" <%= prefillMiniserverId === ms.id ? 'selected' : '' %>><%= ms.name %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label>Transport</label>
          <select name="transport">
            <option value="http" <%= prefillTransport === 'http' ? 'selected' : '' %>>HTTP (Virtual Output)</option>
            <option value="udp" <%= prefillTransport === 'udp' ? 'selected' : '' %>>UDP (Virtual Output)</option>
          </select>
        </div>
        <div>
          <label>QoS</label>
          <select name="qos">
            <option value="0">0</option>
            <option value="1">1</option>
            <option value="2">2</option>
          </select>
        </div>
        <div>
          <label>Retain</label>
          <%- toggleSwitch('retain', false) %>
        </div>
        <div>
          <label>Value transform</label>
          <select name="value_transform" id="add-value-transform-select">
            <option value="passthrough">Pass through unchanged</option>
            <option value="translation_table">Translation table (manage after adding)</option>
            <option value="shelly_rgbw">Shelly RGBW/White (color/N/set JSON)</option>
          </select>
        </div>
        <div id="add-shelly-rgbw-mode-field" style="display:none;">
          <label>Shelly RGBW mode</label>
          <select name="transform_arg">
            <option value="rgb">RGB (from Loxone's RGB output, "H,S,V")</option>
            <option value="rgb-percent">RGB (Loxone's Analog input RGB, "R+G*1000+B*1000000")</option>
            <option value="white">White (0-100%)</option>
            <option value="tunablew">Tunable white (from Loxone Lumitech, "brightness,kelvin")</option>
          </select>
        </div>
        <button type="submit" class="primary"><%- icon('plus') %> Add</button>
      </div>
    </form>
  </div>
</details>
<% } %>

<div class="filterable-table-card">
  <div class="table-toolbar">
    <% if (canEdit('loxone_to_mqtt')) { %>
    <% var disabledCount = mappings.filter(m => !m.enabled).length; var enabledCount = mappings.length - disabledCount; %>
    <form method="post" action="/mappings/loxone-to-mqtt/enable-all" style="margin:0;">
      <button type="submit" class="btn-edit" <%= disabledCount === 0 ? 'disabled' : '' %>><%- icon('power') %> Enable all (<%= disabledCount %>)</button>
    </form>
    <form method="post" action="/mappings/loxone-to-mqtt/disable-all" style="margin:0;">
      <button type="submit" class="btn-edit" <%= enabledCount === 0 ? 'disabled' : '' %>><%- icon('power') %> Disable all (<%= enabledCount %>)</button>
    </form>
    <% } %>
    <div class="columns-menu columns-menu-inline" id="l2m-columns-menu">
      <button type="button" class="btn-soft" id="l2m-columns-btn"><%- icon('columns') %> Columns</button>
      <div class="columns-menu-panel" id="l2m-columns-panel" hidden></div>
    </div>
  </div>

  <div class="table-wrap">
    <div id="l2m-tabulator"></div>
  </div>
</div>

<dialog id="l2m-test-dialog" class="update-changelog-dialog">
  <h2 id="l2m-test-dialog-title">Test</h2>
  <p class="hint" style="margin-top:0;">
    Publishes a value on this mapping to check the device reacts, without needing Loxone at all —
    any value transform (e.g. a translation table) is applied exactly as it would be for a real call.
  </p>
  <div style="display:flex; gap:0.6rem; align-items:center; flex-wrap:wrap;">
    <label style="margin:0; font-size:0.78rem;">Value to send:</label>
    <div id="l2m-test-value-wrap"></div>
    <button type="button" id="l2m-test-send-btn" class="btn-test" style="margin-left:auto;"><%- icon('link') %> Send</button>
  </div>
  <span class="hint" id="l2m-test-result" style="display:block; margin-top:0.6rem;"></span>
  <div style="display:flex; justify-content:flex-end; margin-top:0.9rem;">
    <button type="button" class="btn-soft" id="l2m-test-dialog-close">Close</button>
  </div>
</dialog>

<link rel="stylesheet" href="/vendor/tabulator.min.css">
<link rel="stylesheet" href="/tabulator-theme.css">
<script src="/vendor/tabulator.min.js"></script>
<script src="/vendor/floating-ui.core.umd.min.js"></script>
<script src="/vendor/floating-ui.dom.umd.min.js"></script>
<script src="/tabulator-table.js"></script>
<script src="/mappings-loxone-to-mqtt-tabulator.js"></script>

<script>
  (function () {
    var select = document.getElementById('add-value-transform-select');
    var modeField = document.getElementById('add-shelly-rgbw-mode-field');
    if (!select || !modeField) return;
    select.addEventListener('change', function () {
      modeField.style.display = select.value === 'shelly_rgbw' ? '' : 'none';
    });
  })();
</script>
<script>
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.copy-btn');
    if (!btn) return;
    var label = btn.querySelector('.btn-label');
    window.copyToClipboard(btn.getAttribute('data-copy')).then(function () {
      var original = label.textContent;
      label.textContent = 'Copied!';
      setTimeout(function () { label.textContent = original; }, 1500);
    });
  });
</script>
<%- include('partials/foot') %>
