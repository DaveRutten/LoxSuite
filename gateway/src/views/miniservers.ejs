<%- include('partials/head', { pageTitle: 'Miniservers', active: 'miniservers' }) %>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<% if (canEdit('miniservers')) { %>
<details class="add-panel">
  <summary>Add Miniserver</summary>
  <div class="add-panel-body">
    <form method="post" action="/miniservers" id="add-ms-form">
      <div class="form-grid">
        <div><label>Name</label><input type="text" name="name" required></div>
      </div>
      <div class="form-grid" style="margin-top:0.85rem;">
        <div><label>Host / IP</label><input type="text" name="host" required></div>
        <div><label>HTTP port</label><input type="number" name="http_port" value="80" required></div>
        <div>
          <label>HTTPS</label>
          <%- toggleSwitch('use_https', false) %>
          <p class="hint" style="margin:0.3rem 0 0;">Self-signed certificates are allowed.</p>
        </div>
      </div>
      <div class="form-grid" style="margin-top:0.85rem;">
        <div><label>Username</label><input type="text" name="username" required></div>
        <div><label>Password</label><input type="password" name="password" required></div>
      </div>

      <h2 style="margin-top:1.5rem;">Features</h2>
      <div class="form-grid">
        <div><label>UDP port (optional)</label><input type="number" name="udp_port"></div>
        <div>
          <label>External URL (optional)</label>
          <input type="text" name="external_url" placeholder="https://myhome.dyndns.org:8080">
        </div>
      </div>
      <p class="hint" style="margin-top:0.5rem;">
        <strong>UDP port</strong> is the port <em>on the Miniserver itself</em> that Loxone listens
        on for Virtual UDP Output commands sent by this gateway (configured in Loxone Config's
        Virtual UDP Output, not here) &mdash; purely outbound from the gateway's side, so nothing
        needs to change in <code>docker-compose.yml</code> for it. That file's own
        <code>11885/udp</code> mapping is a separate, single, global port this gateway listens on
        for the opposite direction (Loxone &rarr; gateway), configured once for every Miniserver at
        once (see the Loxone &rarr; MQTT mappings page), not per Miniserver here.
        <strong>External URL</strong> is used as a fallback whenever the local Host/IP can't be
        reached (e.g. from outside the home network) &mdash; Monitor polling, Common commands, log
        fetching and "Test"/"Test now" all try it automatically if the local address fails.
      </p>

      <div style="margin-top:0.9rem; display:flex; align-items:center; gap:0.5rem;">
        <button type="button" id="add-ms-test-btn" class="btn-test"><%- icon('refresh') %> Test</button>
        <button type="submit" class="primary"><%- icon('plus') %> Add</button>
      </div>
      <div id="add-ms-test-result" style="margin-top:0.6rem;"></div>
    </form>
  </div>
</details>
<% } %>

<%
  // jdev/sps/state's own fully-documented 0-8 values (see healthcheck.js's fetchPlcState) —
  // label + badge color per state, 5 (running) the only "everything's fine" green, 7 (error) the
  // only red, everything else a neutral in-between/transitional state.
  const PLC_STATE_LABELS = {
    '0': ['No status', 'badge-neutral'],
    '1': ['Booting', 'badge-neutral'],
    '2': ['Program loaded', 'badge-neutral'],
    '3': ['Started', 'badge-neutral'],
    '4': ['Loxone Link started', 'badge-neutral'],
    '5': ['Running', 'badge-ok'],
    '6': ['Change in progress', 'badge-neutral'],
    '7': ['Error', 'badge-off'],
    '8': ['Update occurring', 'badge-neutral'],
  };
%>
<div class="table-wrap">
  <table class="table-compact">
    <thead>
      <tr><th data-no-controls></th><th>Status</th><th>Name</th><th>Host</th><th>HTTP port</th><th>HTTPS</th><th data-default-hidden>UDP port</th><th data-default-hidden>External URL</th><th>User</th><th>Last checked</th><th>Actions</th></tr>
    </thead>
    <tbody>
      <% miniservers.forEach(ms => { %>
        <tr>
          <td>
            <button type="button" class="icon-btn icon-btn-neutral" data-toggle-row="ms-diag-<%= ms.id %>" title="Show diagnostics"><%- icon('chevron') %></button>
          </td>
          <td data-ms-status-id="<%= ms.id %>">
            <% const badgeClass = ms.status === 'online' ? 'badge-ok' : ms.status === 'offline' ? 'badge-off' : 'badge-neutral'; %>
            <% const badgeText = ms.status === 'online' ? 'Online' : ms.status === 'offline' ? 'Offline' : 'Unknown'; %>
            <span class="badge badge-live <%= badgeClass %>"><%= badgeText %></span>
          </td>
          <td><span class="truncate" style="max-width:150px;" title="<%= ms.name %>"><%= ms.name %></span></td>
          <td><%= ms.host %></td>
          <td><%= ms.http_port %></td>
          <td><%= ms.use_https ? 'yes' : 'no' %></td>
          <td><%= ms.udp_port || '-' %></td>
          <td><% if (ms.external_url) { %><span class="truncate" style="max-width:180px;" title="<%= ms.external_url %>"><%= ms.external_url %></span><% } else { %>-<% } %></td>
          <td><%= ms.username %></td>
          <td><%= ms.last_checked_at ? formatDateTime(ms.last_checked_at) : '-' %></td>
          <td>
            <% if (canEdit('miniservers')) { %>
            <div class="row-actions">
              <%
                // A plain (non-button) child of .row-actions — tables.js's collapseRowActions()
                // moves EVERY child into its auto-generated kebab expand-row indiscriminately, not
                // just buttons, so this rides along with Edit/Test/Delete into that same row and
                // ends up on the left of them for free (flex:1 eats the row's leftover width,
                // pushing the actual buttons to the right — same effect .row-actions-expanded's
                // justify-content:flex-end would give them on its own).
              %>
              <div class="ms-test-result" data-ms-result-for="<%= ms.id %>" style="flex:1; min-width:10rem;">
                <p class="hint" style="margin:0;">Click "Test now" to check connectivity.</p>
              </div>
              <a class="inline" href="/miniservers/<%= ms.id %>/edit"><button type="button" class="btn-edit"><%- icon('edit') %> Edit</button></a>
              <button type="button" class="btn-test ms-test-btn" data-ms-id="<%= ms.id %>"><%- icon('refresh') %> Test now</button>
              <form class="inline" method="post" action="/miniservers/<%= ms.id %>/delete" data-confirm="Delete this Miniserver?">
                <button type="submit" class="danger"><%- icon('trash') %> Delete</button>
              </form>
            </div>
            <% } %>
          </td>
        </tr>
        <tr class="expand-row" id="ms-diag-<%= ms.id %>">
          <td colspan="11">
            <%
              // Everything here comes from the healthcheck cycle (healthcheck.js's
              // checkMiniserver/fetchSystemStats/fetchPlcState/fetchFirmwareVersion), not fetched
              // fresh on expand — nothing here needs an extra round trip just because the panel
              // was just opened. /jdev/sys/cpu|heap|numtasks|state|.. are real, working commands
              // verified directly against a live Miniserver, but undocumented by Loxone — shown as
              // their raw values rather than a guessed interpretation wherever the meaning isn't
              // certain (see format.js's formatHeapStatus), except PLC/Miniserver state, which
              // Loxone does fully document (see PLC_STATE_LABELS above).
              const plc = PLC_STATE_LABELS[ms.plc_state];
              // Every action below either talks to this Miniserver directly (Check/Update) or
              // pins its last-known reading elsewhere (Add to Dashboard/Monitor) — neither is
              // useful, and the update ones are actively risky to fire blind, while it's not
              // confirmed reachable. Visible either way (not hidden) so it's clear the feature
              // exists, just not right now.
              const msOffline = ms.status !== 'online';
            %>
            <div class="ms-diagnostics-card">
              <div class="ms-diagnostics" data-ms-diagnostics-id="<%= ms.id %>">
                <div>
                  <span class="hint" style="margin:0;">Miniserver state</span>
                  <div>
                    <% if (plc) { %>
                      <span class="badge <%= plc[1] %>" title="Miniserver's own PLC run state (jdev/sps/state), code <%= ms.plc_state %>."><%= plc[0] %></span>
                    <% } else { %>
                      -
                    <% } %>
                  </div>
                </div>
                <div>
                  <span class="hint" style="margin:0;">Firmware</span>
                  <div data-ms-firmware-id="<%= ms.id %>"><%= ms.firmware_version || '-' %></div>
                </div>
                <div>
                  <span class="hint" style="margin:0;">Generation</span>
                  <div data-ms-generation-id="<%= ms.id %>" <% if (ms.miniserver_type !== null && ms.miniserver_type !== undefined) { %>title="Reported by this Miniserver itself (msInfo.miniserverType)."<% } %>><%= miniserverGenerationLabel(ms.miniserver_type) || '-' %></div>
                </div>
                <div>
                  <span class="hint" style="margin:0;">CPU load</span>
                  <div><%= ms.cpu_load || '-' %></div>
                </div>
                <div>
                  <span class="hint" style="margin:0;">Heap</span>
                  <div title="<%= ms.heap_status || '' %>"><%= formatHeapStatus(ms.heap_status) || '-' %></div>
                </div>
                <div>
                  <span class="hint" style="margin:0;">Tasks</span>
                  <div><%= ms.num_tasks || '-' %></div>
                </div>
                <div>
                  <span class="hint" style="margin:0;">Firmware date</span>
                  <div><%= ms.firmware_date || '-' %></div>
                </div>
                <div>
                  <span class="hint" style="margin:0;">Update channel</span>
                  <div data-ms-update-level-id="<%= ms.id %>"><%= ms.update_level || '-' %></div>
                </div>
              </div>
              <% if (canEdit('miniservers') || canEdit('dashboard') || canEdit('monitor')) { %>
              <%
                // Update starts disabled — Loxone doesn't expose a plain yes/no "update available"
                // flag over HTTP (confirmed against a real Miniserver, several different ways),
                // so there's no real signal to gate it on. Requiring "Check for update" to be run
                // at least once first, THEN enabling it, is the most honest stand-in available:
                // not a true availability gate, just "you looked at the current state before
                // triggering a real update" — see the JS below and the hint text underneath.
              %>
              <%
                // NOT .row-actions — tables.js's collapseRowActions() scans every `td .row-actions`
                // with more than one child and sweeps it into its own auto-generated "..." kebab
                // menu, which is exactly the effect that class name has here too (this div also
                // sits inside a <td>, with several buttons). .ms-update-actions gets the same plain
                // flex/gap layout without tripping that scan.
              %>
              <div class="ms-update-actions">
                <% if (canEdit('miniservers')) { %>
                <button type="button" class="btn-test ms-check-update-btn" data-ms-id="<%= ms.id %>" <%= msOffline ? 'disabled' : '' %> title="<%= msOffline ? 'Unavailable while this Miniserver is offline' : '' %>"><%- icon('refresh') %> Check for update</button>
                <button type="button" class="btn-edit ms-update-firmware-btn" data-ms-id="<%= ms.id %>" data-ms-name="<%= ms.name %>" disabled title="<%= msOffline ? 'Unavailable while this Miniserver is offline' : 'Run "Check for update" first — Loxone doesn\'t expose a plain update-available flag over HTTP, so this only unlocks once you\'ve looked at the current release channel yourself' %>"><%- icon('upload') %> Update to latest release</button>
                <% } %>
                <% if (canEdit('dashboard')) { %>
                <form class="inline" method="post" action="/dashboards/quick-add-diag">
                  <input type="hidden" name="miniserver_id" value="<%= ms.id %>">
                  <button type="submit" class="primary" <%= msOffline ? 'disabled' : '' %> title="<%= msOffline ? 'Unavailable while this Miniserver is offline' : 'Pin CPU load, Heap value and Task count on the Dashboard, each as its own widget' %>"><%- icon('plus') %> Add to Dashboard</button>
                </form>
                <% } %>
                <% if (canEdit('monitor')) { %>
                <form class="inline" method="post" action="/monitor/quick-add-diag">
                  <input type="hidden" name="miniserver_id" value="<%= ms.id %>">
                  <button type="submit" class="primary" <%= msOffline ? 'disabled' : '' %> title="<%= msOffline ? 'Unavailable while this Miniserver is offline' : 'Start recording CPU load, Heap value and Task count on the Monitor page, without pinning them to the Dashboard' %>"><%- icon('plus') %> Add to Monitor</button>
                </form>
                <% } %>
              </div>
              <div class="ms-update-result" data-ms-update-result-for="<%= ms.id %>"></div>
              <% if (canEdit('miniservers')) { %>
              <p class="hint" style="margin-top:0.4rem; margin-bottom:0;">
                "Check for update" reads this Miniserver's own release channel (Loxone doesn't
                expose a plain yes/no "update available" flag over HTTP, so this is a best-effort
                read, not a guarantee — it's also what unlocks the button below). "Update to latest
                release" sends the actual update command — a <strong>real firmware update and
                reboot</strong> on this Miniserver right now, every device it controls briefly
                stops responding while it restarts.
              </p>
              <% } %>
              <% } %>
            </div>
          </td>
        </tr>
      <% }) %>
      <% if (miniservers.length === 0) { %>
        <tr><td colspan="11" class="empty">No miniservers added yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<script>
  (function () {
    // Renders one row of the breakdown as an icon (check/cross) + label + timing/error, matching
    // the checkmark/cross feedback style the rest of the check* group asked for here.
    function renderLine(label, result) {
      if (!result) return '';
      var color = result.ok ? 'var(--accent)' : 'var(--danger)';
      var iconSvg = result.ok
        ? '<svg class="icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>'
        : '<svg class="icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>';
      var detail = result.ok ? (result.ms + ' ms') : (result.error || 'failed');
      return '<div style="display:flex; align-items:center; gap:0.4rem; color:' + color + ';">' + iconSvg
        + '<strong style="color:var(--text);">' + label + '</strong><span>' + detail + '</span></div>';
    }

    function runTest(msId) {
      var wrap = document.querySelector('.ms-test-result[data-ms-result-for="' + msId + '"]');
      wrap.innerHTML = '<p class="hint" style="margin:0;">Testing&hellip;</p>';

      // Content-Type: application/json (even with an empty body) is what exempts this from the
      // CSRF form-token check server-side — see middleware/csrf.js.
      fetch('/miniservers/' + msId + '/check', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var html = '<div style="display:flex; gap:1.5rem; flex-wrap:wrap; align-items:center;">';
          html += renderLine('Local', data.local);
          html += data.external ? renderLine('External', data.external) : '<div class="hint" style="margin:0;">External: not configured</div>';
          html += renderLine('Loxone API', data.api);
          html += renderLine('Logbook reachable', data.logbook);
          html += renderLine('Live data (websocket)', data.live);
          html += '</div>';
          wrap.innerHTML = html;

          var statusCell = document.querySelector('[data-ms-status-id="' + msId + '"]');
          if (statusCell) {
            var badgeClass = data.status === 'online' ? 'badge-ok' : data.status === 'offline' ? 'badge-off' : 'badge-neutral';
            var badgeText = data.status === 'online' ? 'Online' : data.status === 'offline' ? 'Offline' : 'Unknown';
            statusCell.innerHTML = '<span class="badge badge-live ' + badgeClass + '">' + badgeText + '</span>';
          }
          var firmwareCell = document.querySelector('[data-ms-firmware-id="' + msId + '"]');
          if (firmwareCell) firmwareCell.textContent = data.firmwareVersion || '-';
          var generationCell = document.querySelector('[data-ms-generation-id="' + msId + '"]');
          if (generationCell) generationCell.textContent = data.generationLabel || '-';
          var deviceMonitorCell = document.querySelector('[data-ms-device-monitor-id="' + msId + '"]');
          if (deviceMonitorCell) {
            if (data.deviceMonitorStatus === null || data.deviceMonitorStatus === undefined) {
              deviceMonitorCell.textContent = '-';
            } else if (data.deviceMonitorStatus === '0') {
              deviceMonitorCell.innerHTML = '<span class="badge badge-ok" title="Miniserver\'s own self-reported health status (deviceMonitor) is 0 — no issue reported.">OK</span>';
            } else {
              deviceMonitorCell.innerHTML = '<span class="badge badge-off" title="Miniserver\'s own self-reported health status (deviceMonitor) — code meaning undocumented, check Loxone Config\'s own status messages for details.">Code ' + data.deviceMonitorStatus + '</span>';
            }
          }
        })
        .catch(function () {
          wrap.innerHTML = '<p class="hint" style="margin:0; color:var(--danger);">Test failed to run.</p>';
        });
    }

    // "Test now" now lives inside the same already-open row-actions expand-row as Edit/Delete
    // (see the template above) rather than toggling its own separate row, so there's no
    // open/closing state to gate on any more — every click just (re-)runs the test.
    document.querySelectorAll('.ms-test-btn').forEach(function (btn) {
      btn.addEventListener('click', function () { runTest(btn.dataset.msId); });
    });

    // Tests whatever's currently typed into the Add-Miniserver form itself, before it's been
    // saved — same renderLine feedback style as the per-row "Test now" above, just against
    // POST /miniservers/test (no id yet, no live-connection leg — see that route's own comment).
    var addForm = document.getElementById('add-ms-form');
    var addTestBtn = document.getElementById('add-ms-test-btn');
    var addTestResult = document.getElementById('add-ms-test-result');
    if (addForm && addTestBtn) {
      addTestBtn.addEventListener('click', function () {
        var data = new FormData(addForm);
        var payload = {
          host: data.get('host'),
          http_port: data.get('http_port'),
          username: data.get('username'),
          password: data.get('password'),
          use_https: data.get('use_https'),
          external_url: data.get('external_url'),
        };
        if (!payload.host || !payload.username || !payload.password) {
          addTestResult.innerHTML = '<p class="hint" style="margin:0; color:var(--danger);">Fill in Host, Username and Password first.</p>';
          return;
        }
        addTestResult.innerHTML = '<p class="hint" style="margin:0;">Testing&hellip;</p>';
        // Content-Type: application/json exempts this from the CSRF form-token check server-side
        // (see middleware/csrf.js), same as the per-row test above.
        fetch('/miniservers/test', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (data.error) {
              addTestResult.innerHTML = '<p class="hint" style="margin:0; color:var(--danger);">' + data.error + '</p>';
              return;
            }
            var html = '<div style="display:flex; gap:1.5rem; flex-wrap:wrap; align-items:center;">';
            html += renderLine('Local', data.local);
            html += data.external ? renderLine('External', data.external) : '<div class="hint" style="margin:0;">External: not configured</div>';
            html += renderLine('Loxone API', data.api);
            html += renderLine('Logbook reachable', data.logbook);
            html += '</div>';
            addTestResult.innerHTML = html;
          })
          .catch(function () {
            addTestResult.innerHTML = '<p class="hint" style="margin:0; color:var(--danger);">Test failed to run.</p>';
          });
      });
    }
  })();
</script>

<script>
  // Check for update / Update to latest release (diagnostics expand-row). Plain fetch() with
  // Content-Type: application/json, same CSRF-exempt pattern used elsewhere in this app (see
  // middleware/csrf.js) — neither route reads a request body.
  document.addEventListener('click', function (e) {
    var checkBtn = e.target.closest('.ms-check-update-btn');
    if (checkBtn) {
      var msId = checkBtn.dataset.msId;
      var resultEl = document.querySelector('[data-ms-update-result-for="' + msId + '"]');
      var updateBtnForCheck = document.querySelector('.ms-update-firmware-btn[data-ms-id="' + msId + '"]');
      checkBtn.disabled = true;
      resultEl.textContent = 'Checking…';
      fetch('/miniservers/' + msId + '/check-update', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.error) { resultEl.textContent = data.error; return; }
          var levelEl = document.querySelector('[data-ms-update-level-id="' + msId + '"]');
          if (levelEl && data.updateLevel) levelEl.textContent = data.updateLevel;
          resultEl.textContent = 'Release channel: ' + (data.updateLevel || 'unknown') + '. Loxone doesn\'t expose a plain "update available" flag over HTTP — open Loxone Config to see if a new release is actually offered.';
          // Unlocks the Update button — see the comment on it in the template for why this is a
          // "you looked before triggering" gate, not a real availability check.
          if (updateBtnForCheck) { updateBtnForCheck.disabled = false; updateBtnForCheck.title = 'Trigger a real firmware update on this Miniserver now'; }
        })
        .catch(function () { resultEl.textContent = 'Check failed.'; })
        .then(function () { checkBtn.disabled = false; });
      return;
    }

    var updateBtn = e.target.closest('.ms-update-firmware-btn');
    if (!updateBtn) return;
    var confirmed = window.confirm(
      'This will trigger a REAL firmware update and reboot on "' + updateBtn.dataset.msName + '" right now.\n\n' +
      "Loxone doesn't expose whether a newer release actually exists over HTTP — this may reinstall the version you're already running. Check Loxone Config directly first if you want to be sure.\n\n" +
      'Every device it controls (lighting, heating, gates, alarms, everything) will briefly stop responding while it restarts. This cannot be undone once started.\n\n' +
      'Continue?'
    );
    if (!confirmed) return;
    var msId2 = updateBtn.dataset.msId;
    var resultEl2 = document.querySelector('[data-ms-update-result-for="' + msId2 + '"]');
    updateBtn.disabled = true;
    resultEl2.textContent = 'Triggering update…';
    fetch('/miniservers/' + msId2 + '/update-firmware', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        resultEl2.textContent = data.note || (data.triggered ? 'Update triggered. The Miniserver may now reboot.' : 'Something went wrong.');
      })
      .catch(function () { resultEl2.textContent = 'Update triggered — connection ended (expected if the Miniserver is now rebooting).'; });
      // Deliberately left disabled after a real trigger — re-enabling would invite a second,
      // separate update command on a Miniserver that may currently be mid-reboot.
  });
</script>

<%- include('partials/foot') %>
