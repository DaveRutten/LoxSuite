<%- include('partials/head', { pageTitle: 'Miniservers', active: 'miniservers' }) %>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<% if (canEdit('miniservers')) { %>
<details class="add-panel">
  <summary>Add Miniserver</summary>
  <div class="add-panel-body">
    <form method="post" action="/miniservers" id="add-ms-form">
      <div class="form-grid">
        <div><label>Name</label><input type="text" name="name" required></div>
      </div>
      <div class="form-grid" style="margin-top:0.85rem;">
        <div><label>Host / IP</label><input type="text" name="host" required></div>
        <div><label>HTTP port</label><input type="number" name="http_port" value="80" required></div>
        <div>
          <label>HTTPS</label>
          <%- toggleSwitch('use_https', false) %>
          <p class="hint" style="margin:0.3rem 0 0;">Self-signed certificates are allowed.</p>
        </div>
      </div>
      <div class="form-grid" style="margin-top:0.85rem;">
        <div><label>Username</label><input type="text" name="username" required></div>
        <div><label>Password</label><input type="password" name="password" required></div>
      </div>

      <h2 style="margin-top:1.5rem;">Features</h2>
      <div class="form-grid">
        <div><label>UDP port (optional)</label><input type="number" name="udp_port"></div>
        <div>
          <label>External URL (optional)</label>
          <input type="text" name="external_url" placeholder="https://myhome.dyndns.org:8080">
        </div>
      </div>
      <p class="hint" style="margin-top:0.5rem;">
        <strong>UDP port</strong> is the port <em>on the Miniserver itself</em> that Loxone listens
        on for Virtual UDP Output commands sent by this gateway (configured in Loxone Config's
        Virtual UDP Output, not here) &mdash; purely outbound from the gateway's side, so nothing
        needs to change in <code>docker-compose.yml</code> for it. That file's own
        <code>11885/udp</code> mapping is a separate, single, global port this gateway listens on
        for the opposite direction (Loxone &rarr; gateway), configured once for every Miniserver at
        once (see the Loxone &rarr; MQTT mappings page), not per Miniserver here.
        <strong>External URL</strong> is used as a fallback whenever the local Host/IP can't be
        reached (e.g. from outside the home network) &mdash; Monitor polling, Common commands, log
        fetching and "Test" all try it automatically if the local address fails.
      </p>

      <h2 style="margin-top:1.5rem;">Gateway Client setup (optional)</h2>
      <div class="form-grid">
        <div>
          <label>This Miniserver is a Gateway</label>
          <%- toggleSwitch('is_gateway', false, { id: 'add-ms-is-gateway' }) %>
        </div>
      </div>
      <p class="hint" style="margin-top:0.5rem;">
        Turn this on if this Miniserver is a
        <a href="https://www.loxone.com/enen/kb/gateway-client/" target="_blank" rel="noopener">Gateway</a>
        managing one or more Client Miniservers that share its merged Loxone Config project. Each
        Client below is added as its own Miniserver here too (everything in LoxSuite &mdash;
        Monitor, Mappings, Hardware, ...&mdash; still talks to it directly over its own Host/IP) but
        reuses this Gateway's Username/Password, since Loxone requires identical credentials across
        the whole group &mdash; just give each one its own Name and Host/IP.
      </p>
      <div id="add-ms-clients-header" class="client-rows-header" hidden>
        <div>Client Name</div><div>Host / IP</div><div>HTTP port</div><div>HTTPS</div><div></div>
      </div>
      <div id="add-ms-clients-list"></div>
      <button type="button" id="add-ms-client-row-btn" class="btn-soft" hidden><%- icon('plus') %> Add Client Miniserver</button>

      <div class="btn-row" style="margin-top:0.9rem;">
        <button type="button" id="add-ms-test-btn" class="btn-test"><%- icon('refresh') %> Test</button>
        <button type="submit" class="primary"><%- icon('plus') %> Add</button>
      </div>
      <input type="hidden" name="clients_json" id="add-ms-clients-json">
      <div id="add-ms-test-result" style="margin-top:0.6rem;"></div>
    </form>
  </div>
</details>
<% } %>

<%
  // PILOT: this table is backed by Tabulator (vendor/tabulator.min.js) instead of the plain
  // <table> + tables.js every other table in this app still uses — see routes/miniservers.js's
  // own /data.json for why that means a real JSON endpoint feeds it rather than server-rendered
  // <tr>s. Column resize/reorder/show-hide/fit-to-width are Tabulator's own built-in behavior;
  // the "Columns" button below reuses the exact same .columns-menu/.columns-menu-panel CSS every
  // other table's own Columns button already uses, just driven by Tabulator's column API instead
  // of tables.js. Row drag-reorder (the old .ms-drag-handle/POST /miniservers/reorder) is NOT
  // reimplemented in this pilot — deliberately out of scope for now, see the chat for why.
%>
<div class="filterable-table-card">
  <div class="table-toolbar">
    <button type="button" class="btn-soft" id="ms-collapse-all-btn" hidden></button>
    <div class="columns-menu columns-menu-inline" id="ms-columns-menu">
      <button type="button" class="btn-soft" id="ms-columns-btn"><%- icon('columns') %> Columns</button>
      <div class="columns-menu-panel" id="ms-columns-panel" hidden></div>
    </div>
  </div>
  <div class="table-wrap">
    <div id="ms-tabulator"></div>
  </div>
</div>

<dialog id="ms-diag-dialog" class="update-changelog-dialog ms-diag-dialog-wide">
  <h2 id="ms-diag-dialog-title">Diagnostics</h2>
  <div class="ms-diagnostics-card" style="border-width:1px;">
    <div class="ms-diagnostics" id="ms-diag-dialog-stats"></div>
  </div>
  <div class="ms-update-actions" id="ms-diag-dialog-actions"></div>
  <div class="ms-update-result" id="ms-diag-dialog-result" style="margin-top:0.6rem;"></div>
  <p class="hint" id="ms-diag-dialog-hint" style="margin-top:0.6rem; margin-bottom:0;"></p>
  <div style="display:flex; justify-content:flex-end; margin-top:0.9rem;">
    <button type="button" class="btn-soft" id="ms-diag-dialog-close">Close</button>
  </div>
</dialog>

<link rel="stylesheet" href="/vendor/tabulator.min.css">
<link rel="stylesheet" href="/tabulator-theme.css">
<script src="/vendor/tabulator.min.js"></script>
<script src="/vendor/floating-ui.core.umd.min.js"></script>
<script src="/vendor/floating-ui.dom.umd.min.js"></script>
<script src="/tabulator-table.js"></script>
<script src="/miniservers-tabulator.js"></script>

<script>
  (function () {
    // Renders one row of the breakdown as an icon (check/cross) + label + timing/error, matching
    // the checkmark/cross feedback style the rest of the check* group asked for here.
    function renderLine(label, result) {
      if (!result) return '';
      var color = result.ok ? 'var(--accent)' : 'var(--danger)';
      var iconSvg = result.ok
        ? '<svg class="icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>'
        : '<svg class="icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>';
      var detail = result.ok ? (result.ms + ' ms') : (result.error || 'failed');
      return '<div style="display:flex; align-items:center; gap:0.4rem; color:' + color + ';">' + iconSvg
        + '<strong style="color:var(--text);">' + label + '</strong><span>' + detail + '</span></div>';
    }

    // Per-row "Test now" (with its own live status/firmware/generation/device-monitor cell
    // updates) used to live here, inside the row-actions popover — removed in favor of the
    // Miniserver's own Edit page, which already has a complete Test of its own. Those cells now
    // only refresh via the page's normal auto-refresh (backed by the background healthcheck
    // poller), same as everywhere else on this page.

    // Tests whatever's currently typed into the Add-Miniserver form itself, before it's been
    // saved — same renderLine feedback style as the per-row "Test now" above, just against
    // POST /miniservers/test (no id yet, no live-connection leg — see that route's own comment).
    var addForm = document.getElementById('add-ms-form');
    var addTestBtn = document.getElementById('add-ms-test-btn');
    var addTestResult = document.getElementById('add-ms-test-result');

    function runAddFormTest(host, http_port, username, password, use_https, external_url, resultEl) {
      var payload = { host: host, http_port: http_port, username: username, password: password, use_https: use_https, external_url: external_url };
      if (!payload.host || !payload.username || !payload.password) {
        resultEl.innerHTML = '<p class="hint" style="margin:0; color:var(--danger);">Fill in Host, Username and Password first.</p>';
        return;
      }
      resultEl.innerHTML = '<p class="hint" style="margin:0;">Testing&hellip;</p>';
      // Content-Type: application/json exempts this from the CSRF form-token check server-side
      // (see middleware/csrf.js), same as the per-row test above.
      fetch('/miniservers/test', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.error) {
            resultEl.innerHTML = '<p class="hint" style="margin:0; color:var(--danger);">' + data.error + '</p>';
            return;
          }
          var html = '<div style="display:flex; gap:1.5rem; flex-wrap:wrap; align-items:center;">';
          html += renderLine('Local', data.local);
          html += data.external ? renderLine('External', data.external) : '<div class="hint" style="margin:0;">External: not configured</div>';
          html += renderLine('Loxone API', data.api);
          html += renderLine('Logbook reachable', data.logbook);
          html += '</div>';
          resultEl.innerHTML = html;
        })
        .catch(function () {
          resultEl.innerHTML = '<p class="hint" style="margin:0; color:var(--danger);">Test failed to run.</p>';
        });
    }

    // Gateway Client setup — one or more Client Miniservers, added inline right alongside the
    // Gateway itself (see routes/miniservers.js's own handling of clients_json). Built and
    // collected purely client-side (no name="..." attributes on the row's own inputs) since a
    // dynamically-added row's field COUNT varies — one hidden JSON field, serialized right before
    // submit, is far simpler than juggling array-indexed form field names that both grow and
    // shrink as rows are added/removed.
    var isGatewayToggle = document.getElementById('add-ms-is-gateway');
    var clientsHeader = document.getElementById('add-ms-clients-header');
    var clientsList = document.getElementById('add-ms-clients-list');
    var addClientRowBtn = document.getElementById('add-ms-client-row-btn');
    var clientsJsonInput = document.getElementById('add-ms-clients-json');
    var removeIconSvg = '<svg class="icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>';

    function makeClientRow() {
      var wrap = document.createElement('div');
      wrap.className = 'add-ms-client-row';
      wrap.innerHTML =
        '<div class="client-row">' +
          '<input type="text" class="client-name" placeholder="e.g. Upstairs">' +
          '<input type="text" class="client-host" placeholder="Host / IP">' +
          '<input type="number" class="client-port" value="80" placeholder="HTTP port">' +
          '<span><span class="client-https-label">HTTPS</span><label class="switch"><input type="checkbox" class="client-https"><span class="switch-track"><span class="switch-thumb"></span></span></label></span>' +
          '<button type="button" class="icon-btn icon-btn-danger remove-client-row-btn" title="Remove this Client">' + removeIconSvg + '</button>' +
        '</div>' +
        '<div class="add-ms-client-test-result" style="margin:0.3rem 0 0.5rem;"></div>';
      wrap.querySelector('.remove-client-row-btn').addEventListener('click', function () { wrap.remove(); });
      return wrap;
    }

    if (isGatewayToggle && clientsList && addClientRowBtn) {
      isGatewayToggle.addEventListener('change', function () {
        addClientRowBtn.hidden = !isGatewayToggle.checked;
        clientsHeader.hidden = !isGatewayToggle.checked;
        if (isGatewayToggle.checked && !clientsList.children.length) clientsList.appendChild(makeClientRow());
        if (!isGatewayToggle.checked) clientsList.innerHTML = '';
      });
      addClientRowBtn.addEventListener('click', function () { clientsList.appendChild(makeClientRow()); });
    }

    if (addForm && addTestBtn) {
      addTestBtn.addEventListener('click', function () {
        var data = new FormData(addForm);
        runAddFormTest(data.get('host'), data.get('http_port'), data.get('username'), data.get('password'), data.get('use_https'), data.get('external_url'), addTestResult);
        if (isGatewayToggle && isGatewayToggle.checked) {
          // Every Client shares the Gateway's own credentials (Loxone requires this — see the
          // hint text above) — only Host/IP/port/HTTPS come from the client's own row.
          var username = data.get('username');
          var password = data.get('password');
          clientsList.querySelectorAll('.add-ms-client-row').forEach(function (row) {
            var host = row.querySelector('.client-host').value;
            var port = row.querySelector('.client-port').value;
            var https = row.querySelector('.client-https').checked;
            var resultEl = row.querySelector('.add-ms-client-test-result');
            runAddFormTest(host, port, username, password, https, '', resultEl);
          });
        }
      });
    }

    if (addForm && clientsJsonInput) {
      addForm.addEventListener('submit', function () {
        if (!isGatewayToggle || !isGatewayToggle.checked) { clientsJsonInput.value = ''; return; }
        var clients = [];
        clientsList.querySelectorAll('.add-ms-client-row').forEach(function (row) {
          var name = row.querySelector('.client-name').value.trim();
          var host = row.querySelector('.client-host').value.trim();
          if (!name || !host) return; // an empty/half-filled row is just skipped, not an error
          clients.push({
            name: name,
            host: host,
            http_port: Number(row.querySelector('.client-port').value) || 80,
            use_https: row.querySelector('.client-https').checked,
          });
        });
        clientsJsonInput.value = JSON.stringify(clients);
      });
    }
  })();
</script>

<script>
  // Check for update / Update to latest release (diagnostics expand-row). Plain fetch() with
  // Content-Type: application/json, same CSRF-exempt pattern used elsewhere in this app (see
  // middleware/csrf.js) — neither route reads a request body.
  document.addEventListener('click', function (e) {
    var checkBtn = e.target.closest('.ms-check-update-btn');
    if (checkBtn) {
      var msId = checkBtn.dataset.msId;
      var resultEl = document.querySelector('[data-ms-update-result-for="' + msId + '"]');
      var updateBtnForCheck = document.querySelector('.ms-update-firmware-btn[data-ms-id="' + msId + '"]');
      checkBtn.disabled = true;
      resultEl.textContent = 'Checking…';
      fetch('/miniservers/' + msId + '/check-update', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.error) { resultEl.textContent = data.error; return; }
          // Two elements now share this attribute — the main table's own (default-hidden) Update
          // channel column, and the diagnostics panel's copy — both get the same fresh value.
          document.querySelectorAll('[data-ms-update-level-id="' + msId + '"]').forEach(function (el) {
            if (data.updateLevel) el.textContent = data.updateLevel;
          });
          resultEl.textContent = 'Release channel: ' + (data.updateLevel || 'unknown') + '. Loxone doesn\'t expose a plain "update available" flag over HTTP — open Loxone Config to see if a new release is actually offered.';
          // Unlocks the Update button — see the comment on it in the template for why this is a
          // "you looked before triggering" gate, not a real availability check.
          if (updateBtnForCheck) { updateBtnForCheck.disabled = false; updateBtnForCheck.title = 'Trigger a real firmware update on this Miniserver now'; }
        })
        .catch(function () { resultEl.textContent = 'Check failed.'; })
        .then(function () { checkBtn.disabled = false; });
      return;
    }

    var updateBtn = e.target.closest('.ms-update-firmware-btn');
    if (!updateBtn) return;
    var confirmed = window.confirm(
      'This will trigger a REAL firmware update and reboot on "' + updateBtn.dataset.msName + '" right now.\n\n' +
      "Loxone doesn't expose whether a newer release actually exists over HTTP — this may reinstall the version you're already running. Check Loxone Config directly first if you want to be sure.\n\n" +
      'Every device it controls (lighting, heating, gates, alarms, everything) will briefly stop responding while it restarts. This cannot be undone once started.\n\n' +
      'Continue?'
    );
    if (!confirmed) return;
    var msId2 = updateBtn.dataset.msId;
    var resultEl2 = document.querySelector('[data-ms-update-result-for="' + msId2 + '"]');
    updateBtn.disabled = true;
    resultEl2.textContent = 'Triggering update…';
    fetch('/miniservers/' + msId2 + '/update-firmware', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        resultEl2.textContent = data.note || (data.triggered ? 'Update triggered. The Miniserver may now reboot.' : 'Something went wrong.');
      })
      .catch(function () { resultEl2.textContent = 'Update triggered — connection ended (expected if the Miniserver is now rebooting).'; });
      // Deliberately left disabled after a real trigger — re-enabling would invite a second,
      // separate update command on a Miniserver that may currently be mid-reboot.
  });
</script>

<script>
  // ?open=<miniserver id> — used by Logs > Notifications' own source link (a miniserver_status/
  // firmware_changed event) to land here with that exact row's diagnostics panel already expanded,
  // instead of just dropping you on the page to go find it yourself. Plain class-toggle + scroll,
  // not a synthetic click on the [data-toggle-row] button — same end state (see foot.ejs's own
  // delegated toggle handler), just doesn't depend on that script having already run first.
  (function () {
    var id = new URLSearchParams(location.search).get('open');
    if (!id) return;
    var row = document.getElementById('ms-diag-' + id);
    if (!row) return;
    row.classList.add('open');
    row.scrollIntoView({ block: 'center' });
  })();
</script>

<script>
  // Drag-and-drop row reordering — persists via POST /miniservers/reorder (JSON body, so it's
  // exempt from the CSRF token check, see middleware/csrf.js) the instant a drag ends, updating
  // every OTHER page that lists Miniservers too, since they all now query by this same sort_order
  // column (see db.js). Native HTML5 drag-and-drop, not a library. Dragging only starts from the
  // .ms-drag-handle cell (a mousedown flag consumed by dragstart) so grabbing Edit/Test/Delete
  // elsewhere in the row doesn't accidentally start a drag.
  (function () {
    var tbody = document.getElementById('miniservers-tbody');
    if (!tbody) return;

    var dragging = null; // the summary <tr> currently being dragged
    var armed = false; // true only right after mousedown on a .ms-drag-handle

    tbody.querySelectorAll('.ms-drag-handle').forEach(function (handle) {
      handle.closest('tr').setAttribute('draggable', 'true');
      handle.addEventListener('mousedown', function () { armed = true; });
    });

    // Only the single row being dragged moves during the live preview — its own trailing content
    // (diagnostics row, and — for a Gateway — its whole Client group) is deliberately NOT carried
    // along on every dragover firing any more. That was tried first and reverted: a real
    // multi-step drag fires dragover many times as the cursor crosses other rows, each one
    // re-grouping "whatever's nearby" from the DOM's CURRENT (possibly already slightly-off)
    // state — occasionally guessing wrong and leaving a row's own diagnostics permanently detached
    // from it, exactly the "the detail panel opens where the Miniserver used to be" bug this
    // replaced. Reconciling everyone's trailing content in one clean, deterministic pass on drop
    // (see dragend below) instead avoids that whole class of incremental drift entirely — a brief
    // mid-drag visual gap for an open detail panel is a fair trade for it never actually detaching.
    function isMainRow(row) {
      return row.hasAttribute('data-ms-id') && !row.classList.contains('ms-client-row');
    }

    tbody.addEventListener('dragstart', function (e) {
      var row = e.target.closest('tr[data-ms-id]');
      if (!row || !armed || !isMainRow(row)) { e.preventDefault(); return; }
      dragging = row;
      e.dataTransfer.effectAllowed = 'move';
      row.style.opacity = '0.4';
    });

    tbody.addEventListener('dragover', function (e) {
      if (!dragging) return;
      e.preventDefault();
      // Only ever targets another top-level row — a Client row is display:none whenever its own
      // Gateway's group is collapsed, and even when shown, dropping "onto" one wouldn't have a
      // stable meaning of its own (see dragend's rebuild, which always re-attaches every Client
      // group to its own Gateway regardless of where either landed).
      var target = e.target.closest('tr[data-ms-id]');
      while (target && !isMainRow(target)) target = target.previousElementSibling;
      if (!target || target === dragging) return;
      var rect = target.getBoundingClientRect();
      var before = (e.clientY - rect.top) < rect.height / 2;
      tbody.insertBefore(dragging, before ? target : target.nextElementSibling);
    });

    tbody.addEventListener('drop', function (e) { e.preventDefault(); });

    tbody.addEventListener('dragend', function () {
      armed = false;
      if (!dragging) return;
      dragging.style.opacity = '';
      dragging = null;

      // One clean, deterministic rebuild: walk the top-level rows in whatever order the drag left
      // them in, then re-append each one's own diagnostics row and its whole Client group (each
      // Client's own main row + ITS diagnostics row) right after it, in that same relative order
      // they were already in. appendChild moves an EXISTING node rather than cloning it, so
      // rebuilding the entire tbody this way is just as safe as moving one row at a time — it's
      // just guaranteed correct at the end regardless of anything that happened mid-drag.
      var mainRows = Array.prototype.filter.call(tbody.children, isMainRow);
      mainRows.forEach(function (row) {
        tbody.appendChild(row);
        var diag = document.getElementById('ms-diag-' + row.dataset.msId);
        if (diag) tbody.appendChild(diag);
        tbody.querySelectorAll('tr[data-ms-id][data-gateway-id="' + row.dataset.msId + '"]').forEach(function (clientRow) {
          tbody.appendChild(clientRow);
          var clientDiag = document.getElementById('ms-diag-' + clientRow.dataset.msId);
          if (clientDiag) tbody.appendChild(clientDiag);
        });
      });

      var ids = mainRows.map(function (row) { return Number(row.dataset.msId); });
      fetch('/miniservers/reorder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids: ids }),
      }).catch(function () {});
    });
  })();
</script>

<%- include('partials/foot') %>
