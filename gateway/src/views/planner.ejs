<%- include('partials/head', { pageTitle: 'Smart charging', active: 'planner' }) %>

<% if (error) { %><p class="error"><%= error %></p><% } %>
<% if (saved) { %><p class="hint" style="color: var(--success);"><%= t('Saved.') %></p><% } %>


<div class="card">
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.6rem;">
    <h2 style="margin:0;"><%= t('Smart charging') %></h2>
    <span class="hint" style="margin:0;" id="pl-updated"></span>
  </div>
  <div style="display:flex; gap:0.8rem; flex-wrap:wrap; align-items:center; margin-top:0.8rem;">
    <div id="pl-modes" style="display:inline-flex; border:1px solid var(--border); border-radius:10px; overflow:hidden;">
      <% [['off', 'Off'], ['now', 'Now'], ['pv', 'Solar'], ['minpv', 'Min + Solar'], ['plan', 'Smart plan']].forEach(([k, l]) => { %>
        <button type="button" data-mode="<%= k %>" style="border:0; padding:0.55rem 1rem; font-weight:600; cursor:pointer; background:<%= cfg.mode === k ? 'var(--accent)' : 'transparent' %>; color:<%= cfg.mode === k ? '#fff' : 'inherit' %>;"><%= l %></button>
      <% }) %>
    </div>
    <div class="btn-row" style="margin:0;" id="pl-session">
      <button type="button" class="btn-soft" data-ov="now"><%= t('Charge now') %></button>
      <button type="button" class="btn-soft" data-ov="off"><%= t('Pause') %></button>
      <button type="button" class="btn-soft" data-ov=""><%= t('Back to mode') %></button>
    </div>
  </div>
  <p class="hint" style="margin:0.5rem 0 0;">
    <strong><%= t('Now') %></strong><%= t(': full power.') %> <strong><%= t('Solar') %></strong><%= t(': only with solar surplus.') %> <strong><%= t('Min + Solar') %></strong><%= t(': minimum power plus surplus.') %>
    <strong><%= t('Smart plan') %></strong><%= t(': ready on time in the cheapest way — solar first, then the cheapest hours. The session buttons only apply until the car is unplugged.') %>
  </p>

  <div id="pl-tiles" style="display:flex; gap:0.7rem; flex-wrap:wrap; margin-top:1rem;"></div>
  <div id="pl-target" style="margin-top:1rem;"></div>
  <div id="pl-plan" style="margin-top:0.8rem;"></div>
  <div style="margin-top:0.8rem;">
    <div class="hint" style="margin:0 0 0.2rem; font-size:0.8rem;"><%= t('Price per interval (all-in) —') %> <span style="color:var(--accent); font-weight:700;">■</span> <%= t('planned') %> &nbsp;<span style="color:#d4a017; font-weight:700;">━</span> <%= t('expected solar surplus (kW)') %> &nbsp;<span style="color:#e5534b; font-weight:700;">┆</span> <%= t('ready by') %> &nbsp;<span style="color:#d4a017; font-weight:700;">■</span> <%= t('solar part') %> &nbsp;<span style="color:#3b82f6; font-weight:700;">┆</span> <%= t('expected home') %> &nbsp;<span style="color:var(--accent); font-weight:700;">⬚</span> <%= t('if it came home now') %></div>
    <div id="pl-chart"></div>
  </div>
</div>

<p class="hint" data-hint-keep><%= t('Charging, the output to Loxone (advise or live) and reminders are set under') %> <a href="/settings/energy#charging"><%= t('Administration → Energy & charging') %></a>.</p>

<script>
(function () {
  var canEdit = <%- JSON.stringify(canEdit('charging')) %>;
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function nf(v, d) { return v == null ? '—' : Number(v).toLocaleString(undefined, { minimumFractionDigits: d, maximumFractionDigits: d }); }
  function eur(v, d) { return v == null ? '—' : '€ ' + nf(v, d == null ? 2 : d); }
  function tm(s) { return s ? new Date(s).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '—'; }
  function dtm(s) { if (!s) return '—'; var d = new Date(s); var today = new Date(); var day = d.toDateString() === today.toDateString() ? '' : d.toLocaleDateString([], { weekday: 'short' }) + ' '; return day + tm(s); }
  function post(url, body) { return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) }).then(function (r) { return r.json(); }); }
  function tile(label, value, sub, color) {
    return '<div style="flex:1; min-width:140px; border:1px solid var(--border); border-radius:10px; padding:0.6rem 0.8rem;">' +
      '<div class="hint" style="margin:0; font-size:0.72rem; text-transform:uppercase; letter-spacing:0.04em;">' + esc(label) + '</div>' +
      '<div style="font-size:1.3rem; font-weight:700;' + (color ? ' color:' + color + ';' : '') + '">' + value + '</div>' + (sub ? '<div class="hint" style="margin:0; font-size:0.75rem;">' + sub + '</div>' : '') + '</div>';
  }
  // Adjacent intervals with the same source shown as one block.
  function mergeSlots(slots) {
    var out = [];
    slots.forEach(function (x) {
      var last = out[out.length - 1];
      if (last && last.end === x.start && last.source === x.source) { last.end = x.end; last.kwh += x.kwh; last.pvKwh += x.pvKwh || 0; return; }
      else out.push({ start: x.start, end: x.end, kwh: x.kwh, source: x.source, pvKwh: 0 });
      out[out.length - 1].pvKwh += x.pvKwh || 0;
    });
    return out;
  }
  // A whole sentence with {0}, {1} … translated as one (window.LS_I18N), then filled in.
  function T(key) {
    var args = arguments;
    var tr = (window.LS_I18N && window.LS_I18N[key]) || key;
    return tr.replace(/\{(\d+)\}/g, function (all, n) { var v = args[Number(n) + 1]; return v === undefined ? all : v; });
  }
  function slotText(x) {
    var pv = x.pvKwh || 0, grid = Math.max(0, x.kwh - pv);
    var mix = pv > 0.05 && grid > 0.05 ? ' (' + nf(pv, 1) + ' ☀️ + ' + nf(grid, 1) + ' ⚡)' : pv > 0.05 ? ' ☀️' : ' ⚡';
    return dtm(x.start) + '–' + tm(x.end) + ' ' + nf(x.kwh, 1) + ' kWh' + mix;
  }
  var MODE_LABEL = { off: 'Off', now: 'Now', pv: 'Solar', minpv: 'Min + Solar', plan: 'Smart plan' };

  function render(d) {
    var s = d.status || {};
    var p = d.plan;
    document.getElementById('pl-updated').textContent = s.at ? 'Updated ' + tm(s.at) : (s.error || '');
    document.querySelectorAll('#pl-modes button').forEach(function (b) { var on = b.dataset.mode === d.cfg.mode; b.style.background = on ? 'var(--accent)' : 'transparent'; b.style.color = on ? '#fff' : 'inherit'; });
    document.querySelectorAll('#pl-session button').forEach(function (b) { b.style.outline = (b.dataset.ov || '') === (d.override || '') && d.override ? '2px solid var(--accent)' : ''; });
    var wb = s.wallbox || {};
    var t = '';
    t += tile('Car', s.connected ? 'connected' : 'not connected', s.connected ? (p && p.target && p.target.vehicle ? esc(p.target.vehicle.name) + ' · ' : '') + nf(wb.sessionKwh, 1) + ' kWh this session' : '', s.connected ? 'var(--accent)' : '');
    t += tile('Charging', nf(wb.kw, 2) + ' <span style="font-size:0.8rem; font-weight:500;">kW</span>', 'setpoint ' + nf(s.setpointKw, 2) + ' kW' + (d.override ? ' · ' + esc(MODE_LABEL[d.override]) + ' for this session' : ''));
    t += tile('Solar surplus', nf(s.surplusKw, 2) + ' <span style="font-size:0.8rem; font-weight:500;">kW</span>', 'export + what the car uses', '#d4a017');
    if (p && p.fuelBreakEven) t += tile('Fuel break-even', eur(p.fuelBreakEven, 3) + '<span style="font-size:0.8rem; font-weight:500;">/kWh</span>', 'above this, fuel is cheaper');
    document.getElementById('pl-tiles').innerHTML = t + '<div class="hint" style="flex-basis:100%; margin:0.2rem 0 0;">' + esc(s.reason || '') + (s.outputResult && s.outputResult.error ? ' <span style="color:var(--danger);">Output: ' + esc(s.outputResult.error) + '</span>' : '') + (s.done ? ' <strong>Car is full.</strong>' : '') + '</div>';

    var tg = p && p.target ? p.target : null;
    var th = '';
    if (tg) {
      th = '<div class="form-grid" style="align-items:end;">' +
        (p.split
          ? '<div><div class="hint" style="margin:0; font-size:0.75rem; text-transform:uppercase;">Needs before leaving</div><div style="font-size:1.15rem; font-weight:700;">' + nf(p.split.mustKwh, 1) + ' kWh</div><div class="hint" style="margin:0; font-size:0.75rem;">' + esc(T('trip {0} kWh + reserve {1} kWh; room in the battery {2} kWh, the rest after it is back ({3})', nf(p.split.tripKwh, 1), nf(p.split.reserveKwh, 1), nf(p.split.mustKwh + p.split.restKwh, 1), dtm(p.split.backAt))) + '</div></div>'
          : '<div><div class="hint" style="margin:0; font-size:0.75rem; text-transform:uppercase;">' + esc(T(/^car reports/.test(tg.needSource || '') ? 'Room in the battery' : 'To charge (estimate)')) + '</div><div style="font-size:1.15rem; font-weight:700;">' + nf(p.needKwh, 1) + ' kWh</div><div class="hint" style="margin:0; font-size:0.75rem;">' + esc(tg.needSource) + '</div></div>') +
        '<div><div class="hint" style="margin:0; font-size:0.75rem; text-transform:uppercase;">Ready by</div><div style="font-size:1.15rem; font-weight:700;">' + dtm(p.readyAt) + '</div><div class="hint" style="margin:0; font-size:0.75rem;">' + esc(tg.readySource || 'no departure known — within 24 h') + '</div></div>' +
        (p.arrival ? '<div><div class="hint" style="margin:0; font-size:0.75rem; text-transform:uppercase;">Expected home</div><div style="font-size:1.15rem; font-weight:700; color:#3b82f6;">' + dtm(p.arrival.at) + '</div><div class="hint" style="margin:0; font-size:0.75rem;">' + esc(p.arrival.label) + '</div></div>' : '') +
        (canEdit ? '<div><label>' + esc(T(s.connected ? 'Ready by (this session)' : 'Ready by (when it is back, one time)')) + '</label><input type="datetime-local" id="pl-ready">' +
          '<input type="text" id="pl-ready-own" placeholder="' + esc(T('how far: 120 km, 30 kWh or full')) + '" style="margin-top:0.3rem;" value="' + esc(d.readyOverrideOwn || '') + '">' +
          '<div class="btn-row" style="margin-top:0.3rem;"><button type="button" class="btn-soft" id="pl-ready-btn">' + esc(T('Set')) + '</button>' +
          (d.readyOverride ? '<button type="button" class="btn-soft" id="pl-ready-clear">' + esc(T('Clear')) + '</button>' : '') + '</div>' +
          (d.readyOverride ? '<div class="hint" style="margin:0.2rem 0 0; font-size:0.75rem;">' + esc(T('Set by you: {0}', dtm(new Date(d.readyOverride).toISOString()) + (d.readyOverrideOwn ? ' · ' + d.readyOverrideOwn : ''))) + '</div>' : '') +
          '</div>' : '') +
        '</div>';
    }
    // don't wipe what is being typed in the "ready by" fields on the 30 s refresh
    var tgEl = document.getElementById('pl-target');
    var keep = { at: (document.getElementById('pl-ready') || {}).value, own: (document.getElementById('pl-ready-own') || {}).value };
    var typing = tgEl.contains(document.activeElement) && /INPUT/.test(document.activeElement.tagName);
    if (!typing) {
      tgEl.innerHTML = th;
      if (keep.at && document.getElementById('pl-ready')) document.getElementById('pl-ready').value = keep.at;
      if (keep.own && document.getElementById('pl-ready-own')) document.getElementById('pl-ready-own').value = keep.own;
      var rb = document.getElementById('pl-ready-btn');
      if (rb) rb.addEventListener('click', function () { var v = document.getElementById('pl-ready').value; post('/planner/ready.json', { at: v ? new Date(v).toISOString() : null, own: document.getElementById('pl-ready-own').value }).then(load); });
      var rc = document.getElementById('pl-ready-clear');
      if (rc) rc.addEventListener('click', function () { post('/planner/ready.json', { at: null }).then(load); });
    }

    var ph = '';
    if (p) {
      if (p.slots.length) {
        var first = p.slots[0];
        var last = p.slots[p.slots.length - 1];
        var pvK = p.pvKwh || 0, gridK = Math.max(0, p.kwh - pvK);
        ph = '<div style="padding:0.8rem 1rem; border-radius:10px; background:color-mix(in srgb, var(--accent) 10%, transparent); border:1px solid color-mix(in srgb, var(--accent) 35%, transparent);">' +
          (p.arrival ? '<div class="hint" style="margin:0 0 0.25rem;">' + esc(T('The car is out: this is the plan from when it is expected home ({0}).', dtm(p.arrival.at))) + '</div>' : '') +
          (p.priceGapFrom ? '<div class="hint" style="margin:0 0 0.25rem; color:var(--warning, #d4a017);">' + esc(T('No electricity prices known from {0} — LoxSuite fetches them again every 30 minutes; until then those hours are left out of the plan.', dtm(p.priceGapFrom))) + '</div>' : '') +
          '<strong>' + esc(T('Plan:')) + '</strong> ' + esc(T('{0} – {1}', dtm(first.start), dtm(last.end))) + ' &rarr; <strong>' + nf(p.kwh, 1) + ' kWh</strong>' +
          ' (' + (pvK > 0.05 ? esc(T('{0} kWh solar, {1} kWh grid', nf(pvK, 1), nf(gridK, 1))) : esc(T('all from the grid'))) + ')' +
          ' · ' + esc(T('average')) + ' <strong>' + eur(p.avgPrice, 3) + '</strong>/kWh · ' + esc(T('costs about')) + ' <strong>' + eur(p.cost) + '</strong>' +
          (p.compare && p.compare.saving > 0.05 ? '<span class="hint" style="margin:0;"> ' + esc(T('(charging straight away: {0} average — saves {1})', eur(p.compare.avgPrice, 3), eur(p.compare.saving))) + '</span>' : '') +
          (p.split
            ? '<div class="hint" style="margin:0.3rem 0 0;">' + esc(T('Before leaving:')) + ' ' + (p.split.mustSlots.length ? mergeSlots(p.split.mustSlots).map(slotText).join(' · ') : esc(T('nothing to charge'))) + '</div>' +
              '<div class="hint" style="margin:0.15rem 0 0;">' + esc(T('After it is back:')) + ' ' + (p.split.restSlots.length ? mergeSlots(p.split.restSlots).map(slotText).join(' · ') : esc(T('no hour below the price cap'))) +
                (p.split.later || []).map(function (l) { return ' · ' + esc(T('{0} kWh of it for {1} (ready {2})', nf(l.kwh, 1), l.title, dtm(l.readyAt))); }).join('') + '</div>'
            : '<div class="hint" style="margin:0.3rem 0 0;">' + mergeSlots(p.slots).map(slotText).join(' · ') + '</div>') +
          (p.ifNow ? '<div class="hint" style="margin:0.45rem 0 0; padding-top:0.4rem; border-top:1px dashed var(--border);">' + esc(T('If it came home now (or another car were plugged in):')) + ' ' +
            (p.ifNow.slots.length ? mergeSlots(p.ifNow.slots).map(slotText).join(' · ') + ' · ' + eur(p.ifNow.cost) : esc(T('nothing to charge'))) + '</div>' : '') +
          '</div>';
      } else {
        ph = '<p class="hint" style="margin:0;">' + (p.needKwh > 0 ? 'Nothing planned.' : 'Nothing to charge.') + '</p>';
      }
      if (p.notes && p.notes.length) ph += '<p class="hint" style="margin:0.4rem 0 0; color:#b8860b;">' + p.notes.map(esc).join(' ') + '</p>';
    }
    document.getElementById('pl-plan').innerHTML = ph;
    renderChart(p);
  }

  var chartPlan = null;
  lsOnResize(function () { if (chartPlan) renderChart(chartPlan); });
  function renderChart(p) {
    chartPlan = p;
    var el = document.getElementById('pl-chart');
    if (!p || !p.slotsAll || !p.slotsAll.length) { el.innerHTML = '<p class="hint" style="margin:0;">No prices yet.</p>'; return; }
    var slots = p.slotsAll.slice(0, 160);
    var W = lsChartW(el, 900), H = 160, left = 40, n = slots.length, bw = (W - left - 8) / n;
    var maxP = Math.max(0.1, Math.max.apply(null, slots.map(function (s) { return s.price || 0; })));
    var maxPv = Math.max(1, Math.max.apply(null, slots.map(function (s) { return s.pvKw || 0; })));
    var planned = {};
    p.slots.forEach(function (x) { planned[x.start] = true; });
    var t0 = Date.parse(slots[0].start), t1 = Date.parse(slots[n - 1].end);
    var X = function (ms) { return left + (ms - t0) / (t1 - t0) * (W - left - 8); };
    var svg = '<svg viewBox="0 0 ' + W + ' ' + (H + 34) + '" width="100%" style="display:block;">';
    [0.25, 0.5, 0.75, 1].forEach(function (f) { var v = maxP * f; var y = 10 + H - f * H; svg += '<line x1="' + left + '" y1="' + y + '" x2="' + (W - 5) + '" y2="' + y + '" stroke="currentColor" opacity="0.08"/><text x="' + (left - 4) + '" y="' + (y + 3) + '" text-anchor="end" font-size="9" fill="currentColor" opacity="0.55">€' + v.toFixed(2) + '</text>'; });
    slots.forEach(function (s, i) {
      var x = X(Date.parse(s.start));
      var w = Math.max(1, X(Date.parse(s.end)) - x - 1);
      if (s.price == null) { svg += '<rect x="' + x + '" y="' + (10 + H - 4) + '" width="' + w + '" height="4" fill="currentColor" opacity="0.1"/>'; return; }
      var h = s.price / maxP * H;
      var isPlan = !!planned[s.start] || p.slots.some(function (q) { return Date.parse(q.start) < Date.parse(s.end) && Date.parse(q.end) > Date.parse(s.start); });
      svg += '<rect x="' + x + '" y="' + (10 + H - h) + '" width="' + w + '" height="' + h + '" rx="1.5" fill="' + (isPlan ? 'var(--accent)' : '#c9d0d8') + '" opacity="' + (isPlan ? 0.95 : 0.75) + '"><title>' + tm(s.start) + ' € ' + s.price.toFixed(3) + '</title></rect>';
      // solar part of a planned interval: the lower part of the bar in yellow
      var ps = isPlan ? p.slots.filter(function (q) { return Date.parse(q.start) < Date.parse(s.end) && Date.parse(q.end) > Date.parse(s.start); }) : [];
      var pk = ps.reduce(function (a, q) { return a + (q.pvKwh || 0); }, 0), tk = ps.reduce(function (a, q) { return a + q.kwh; }, 0);
      if (pk > 0.05 && tk > 0) { var sh = h * Math.min(1, pk / tk); svg += '<rect x="' + x + '" y="' + (10 + H - sh) + '" width="' + w + '" height="' + sh + '" fill="#d4a017" opacity="0.9"><title>☀️ ' + nf(pk, 1) + ' / ' + nf(tk, 1) + ' kWh</title></rect>'; }
      // what it would do if the car came home now: outlined
      if (p.ifNow && !isPlan && p.ifNow.slots.some(function (q) { return Date.parse(q.start) < Date.parse(s.end) && Date.parse(q.end) > Date.parse(s.start); })) svg += '<rect x="' + (x + 0.75) + '" y="' + (10 + H - h + 0.75) + '" width="' + Math.max(0, w - 1.5) + '" height="' + Math.max(0, h - 1.5) + '" rx="1.5" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-dasharray="3 2"/>';
    });
    var pts = slots.map(function (s) { return X((Date.parse(s.start) + Date.parse(s.end)) / 2).toFixed(1) + ',' + (10 + H - (s.pvKw || 0) / maxPv * H * 0.9).toFixed(1); });
    svg += '<polyline points="' + pts.join(' ') + '" fill="none" stroke="#d4a017" stroke-width="2" opacity="0.9"/>';
    if (p.arrival) {
      var ax = X(Date.parse(p.arrival.at)), nx0 = left;
      if (ax > left && ax < W) svg += '<rect x="' + nx0 + '" y="10" width="' + Math.max(0, ax - nx0) + '" height="' + H + '" fill="#3b82f6" opacity="0.06"/><line x1="' + ax + '" y1="4" x2="' + ax + '" y2="' + (10 + H) + '" stroke="#3b82f6" stroke-width="2" stroke-dasharray="4 3"/><text x="' + (ax + 3) + '" y="9" font-size="10" fill="#3b82f6">' + esc(T('home ~{0}', tm(p.arrival.at))) + '</text>';
    }
    if (p.split) {
      var bx = X(Date.parse(p.split.backAt));
      if (bx > left && bx < W) svg += '<line x1="' + bx + '" y1="4" x2="' + bx + '" y2="' + (10 + H) + '" stroke="#3b82f6" stroke-width="2" stroke-dasharray="4 3"/><text x="' + (bx + 3) + '" y="9" font-size="10" fill="#3b82f6">' + esc(T('back ~{0}', tm(p.split.backAt))) + '</text>';
    }
    if (p.readyAt) { var rx = X(Date.parse(p.readyAt)); if (rx > left && rx < W) svg += '<line x1="' + rx + '" y1="4" x2="' + rx + '" y2="' + (10 + H) + '" stroke="#e5534b" stroke-width="2" stroke-dasharray="4 3"/><text x="' + (rx > W - 90 ? rx - 3 : rx + 3) + '" y="9" font-size="10" text-anchor="' + (rx > W - 90 ? 'end' : 'start') + '" fill="#e5534b">' + esc(T('ready {0}', tm(p.readyAt))) + '</text>'; }
    var lastLabel = -1;
    slots.forEach(function (s) { var ms = Date.parse(s.start); var d = new Date(ms); if (d.getMinutes() === 0 && d.getHours() % 3 === 0 && ms !== lastLabel) { lastLabel = ms; svg += '<text x="' + X(ms) + '" y="' + (H + 26) + '" font-size="10" fill="currentColor" opacity="0.6">' + (d.getHours() === 0 ? d.toLocaleDateString([], { weekday: 'short' }) : String(d.getHours()).padStart(2, '0')) + '</text>'; } });
    svg += '</svg>';
    el.innerHTML = svg;
  }

  function load() { fetch('/planner/status.json').then(function (r) { return r.json(); }).then(render).catch(function () {}); }
  load();
  setInterval(load, 30000);

  if (canEdit) {
    document.querySelectorAll('#pl-modes button').forEach(function (b) { b.addEventListener('click', function () { post('/planner/mode.json', { mode: b.dataset.mode }).then(load); }); });
    document.querySelectorAll('#pl-session button').forEach(function (b) { b.addEventListener('click', function () { post('/planner/override.json', { mode: b.dataset.ov || null }).then(load); }); });
    document.querySelectorAll('[data-recalc]').forEach(function (b) {
      b.addEventListener('click', function () {
        var body = {}; body[b.dataset.recalc] = true; b.disabled = true;
        post('/planner/recalc.json', body).then(function (d) { var r = d[b.dataset.recalc]; b.textContent = r && r.ok ? 'Done' : 'Failed: ' + (r && r.message || ''); load(); }).finally(function () { b.disabled = false; });
      });
    });
  } else {
    document.querySelectorAll('#pl-modes button, #pl-session button').forEach(function (b) { b.disabled = true; });
  }
})();
</script>

<%- include('partials/foot') %>
