    for (var ds = dd.getTime(); ds < t1;) {
      var dn = new Date(ds); dn.setDate(dn.getDate() + 1);
      var xa = X(Math.max(ds, t0)), xb = X(Math.min(dn.getTime(), t1));
      if (xb - xa > 34) svg += '<text x="' + f1((xa + xb) / 2) + '" y="' + (bottom + 32) + '" text-anchor="middle" font-size="10.5" font-weight="600" fill="currentColor" opacity="0.72">' + esc(new Date(ds).toLocaleDateString([], xb - xa > 110 ? { weekday: 'long', day: 'numeric', month: 'short' } : { weekday: 'short', day: 'numeric' })) + '</text>';
      ds = dn.getTime();
    }

    // ---- the chosen interval: a soft wash over all panels; a crosshair that follows the pointer
    var si = plSel === null ? -1 : slots.findIndex(function (s) { return Date.parse(s.start) === plSel; });
    if (si >= 0) { var sx = X(Date.parse(slots[si].start)), sw = X(Date.parse(slots[si].end)) - sx; svg += vband(sx, Math.max(2, sw), 'rx="3" style="fill:var(--pl-car);" opacity="0.1" pointer-events="none"'); }
    svg += '<g id="pl-xh" opacity="0" pointer-events="none">' + vline(0, 'stroke:currentColor;', 1) + '</g>' +
      '<rect id="pl-hit" x="' + left + '" y="0" width="' + PW + '" height="' + bottom + '" fill="transparent" style="cursor:pointer;"/></svg>' +
      '<div id="pl-tip" class="pl-tip" hidden></div>';
    el.innerHTML = svg;

    var hit = document.getElementById('pl-hit'), xh = document.getElementById('pl-xh'), tip = document.getElementById('pl-tip'), svgEl = el.querySelector('svg');
    var indexAt = function (ev) {
      var r = svgEl.getBoundingClientRect(), x = (ev.clientX - r.left) * W / r.width;
      for (var i = 0; i < n; i++) if (x < X(Date.parse(slots[i].end))) return i;
      return n - 1;
    };
    hit.addEventListener('pointermove', function (ev) {
      var i = indexAt(ev), s = slots[i], a = Date.parse(s.start), b = Date.parse(s.end), cx = X((a + b) / 2);
      xh.setAttribute('transform', 'translate(' + f1(cx) + ',0)'); xh.setAttribute('opacity', '0.45');
      var pl = plannedIn(p, a, b), lv = batteryAt(p.battery, b), rows = [];
      rows.push([dtm(s.start) + '–' + tm(s.end), '']);
      rows.push([T('Price'), s.price != null ? eur(s.price, 3) : T('no price (yet)')]);
      if (pl.kwh > 0.05) rows.push([T('Planned'), nf(pl.kwh, 1) + ' kWh']);
      if (lv != null) rows.push([T('Battery level'), nf(lv, 0) + '%']);
      rows.push([T('solar surplus'), nf(s.pvKw || 0, 1) + ' kW']);
      if (gridKw[i] != null) rows.push([T('import from the grid'), nf(gridKw[i], 1) + ' kW']);
      tip.textContent = '';
      rows.forEach(function (rw, k) {
        var div = document.createElement('div');
        if (!k) { div.className = 'pl-tip-h'; div.textContent = rw[0]; } else { var v = document.createElement('strong'); v.textContent = rw[1]; var l = document.createElement('span'); l.textContent = rw[0]; div.appendChild(v); div.appendChild(l); }
        tip.appendChild(div);
      });
      var r = svgEl.getBoundingClientRect(), px = ev.clientX - r.left;
      tip.hidden = false;
      tip.style.left = (px + 14 + tip.offsetWidth > r.width ? px - tip.offsetWidth - 14 : px + 14) + 'px';
      tip.style.top = Math.max(0, ev.clientY - r.top - 20) + 'px';
    });
    hit.addEventListener('pointerleave', function () { xh.setAttribute('opacity', '0'); tip.hidden = true; });
    hit.addEventListener('click', function (ev) { var ms = Date.parse(slots[indexAt(ev)].start); plSel = plSel === ms ? null : ms; renderChart(chartPlan); });
    var det = document.getElementById('pl-detail');
    if (si < 0) { plSel = null; det.innerHTML = ''; return; }
    det.innerHTML = slotDetail(p, slots[si], gridKw[si]);
    var cl = document.getElementById('pl-detail-close');
    if (cl) cl.addEventListener('click', function (e) { e.preventDefault(); plSel = null; renderChart(chartPlan); });
  }

  function load() { fetch('/planner/status.json').then(function (r) { return r.json(); }).then(render).catch(function () {}); }
  load();
  setInterval(load, 30000);

  if (canEdit) {
    var rb = document.getElementById('pl-ready-btn');
    if (rb) rb.addEventListener('click', function () { var v = document.getElementById('pl-ready').value; post('/planner/ready.json', { at: v ? new Date(v).toISOString() : null, own: document.getElementById('pl-ready-own').value }).then(load); });
    var rcl = document.getElementById('pl-ready-clear');
    if (rcl) rcl.addEventListener('click', function () { post('/planner/ready.json', { at: null }).then(function () { document.getElementById('pl-ready').value = ''; document.getElementById('pl-ready-own').value = ''; load(); }); });
    var rbox = document.getElementById('pl-ready-box');
    if (rbox) rbox.querySelector('summary').addEventListener('click', function () { rbox.dataset.touched = '1'; });
    document.querySelectorAll('#pl-modes button').forEach(function (b) { b.addEventListener('click', function () { post('/planner/mode.json', { mode: b.dataset.mode }).then(load); }); });
    document.querySelectorAll('#pl-session button').forEach(function (b) { b.addEventListener('click', function () { post('/planner/override.json', { mode: b.dataset.ov || null }).then(load); }); });
    document.querySelectorAll('[data-recalc]').forEach(function (b) {
      b.addEventListener('click', function () {
        var body = {}; body[b.dataset.recalc] = true; b.disabled = true;
        post('/planner/recalc.json', body).then(function (d) { var r = d[b.dataset.recalc]; b.textContent = r && r.ok ? 'Done' : 'Failed: ' + (r && r.message || ''); load(); }).finally(function () { b.disabled = false; });
      });
    });
  } else {
    document.querySelectorAll('#pl-modes button, #pl-session button').forEach(function (b) { b.disabled = true; });
  }
})();
</script>

