<%- include('partials/head', { pageTitle: 'Smart charging', active: 'planner' }) %>

<% if (error) { %><p class="error"><%= error %></p><% } %>
<% if (saved) { %><p class="hint" style="color: var(--success);"><%= t('Saved.') %></p><% } %>


<div class="card" data-card-key="now">
  <div>
    <h2 style="margin:0;"><%= t('Now') %></h2>
    <span class="card-head-sub" id="pl-updated"></span>
  </div>
  <div class="toolbar" style="margin-top:0.8rem;">
    <div id="pl-modes" class="segmented" role="group" aria-label="<%= t('Mode') %>">
      <% [['off', 'Off'], ['now', 'Now'], ['pv', 'Solar'], ['minpv', 'Min + Solar'], ['plan', 'Smart plan']].forEach(([k, l]) => { %>
        <button type="button" data-mode="<%= k %>" class="<%= cfg.mode === k ? 'on' : '' %>"><%= t(l) %></button>
      <% }) %>
    </div>
    <div class="btn-row" id="pl-session">
      <button type="button" class="btn-soft" data-ov="now"><%= t('Charge now') %></button>
      <button type="button" class="btn-soft" data-ov="off"><%= t('Pause') %></button>
      <button type="button" class="btn-soft" data-ov=""><%= t('Back to mode') %></button>
    </div>
  </div>
  <p class="hint" style="margin:0.5rem 0 0;">
    <strong><%= t('Now') %></strong><%= t(': full power.') %> <strong><%= t('Solar') %></strong><%= t(': only with solar surplus.') %> <strong><%= t('Min + Solar') %></strong><%= t(': minimum power plus surplus.') %>
    <strong><%= t('Smart plan') %></strong><%= t(': ready on time in the cheapest way — solar first, then the cheapest hours. The session buttons only apply until the car is unplugged.') %>
  </p>
  <div id="pl-tiles" class="ls-tiles" style="margin-top:1rem;"></div>
  <p class="hint" id="pl-reason" style="margin:0.6rem 0 0;"></p>
</div>

<div class="card" data-card-key="plan">
  <h2 style="margin-top:0;"><%= t('Plan') %></h2>
  <div id="pl-target" class="ls-tiles"></div>
  <% if (canEdit('charging')) { %>
  <details class="ls-more" id="pl-ready-box">
    <summary><span id="pl-ready-label"><%= t('Ready by (when it is back, one time)') %></span> <span id="pl-ready-set" class="hint" style="margin:0;"></span></summary>
    <div class="form-grid" style="margin-top:0.5rem; align-items:end;">
      <div><label><%= t('Ready by') %></label><input type="datetime-local" id="pl-ready"></div>
      <div><label><%= t('How far') %></label><input type="text" id="pl-ready-own" placeholder="<%= t('how far: 120 km, 30 kWh or full') %>"></div>
      <div class="btn-row"><button type="button" class="btn-edit" id="pl-ready-btn"><%- icon('edit') %> <%= t('Set') %></button><button type="button" class="btn-soft" id="pl-ready-clear" hidden><%= t('Clear') %></button></div>
    </div>
  </details>
  <% } %>
  <div id="pl-plan" style="margin-top:1rem;"></div>
  <div style="margin-top:1rem;">
    <div class="hint" style="margin:0 0 0.3rem; font-size:0.8rem;"><span style="font-weight:700;">│</span> <%= t('now') %> &nbsp;<span style="color:var(--en-battery); font-weight:700;">│</span> <%= t('ready by') %> &nbsp;<span style="font-weight:700; opacity:0.6;">│</span> <%= t('expected home') %> &nbsp;<span style="color:var(--en-car); font-weight:700;">⬚</span> <%= t('if it came home now') %> &nbsp;<span style="display:inline-block; width:0.9em; height:0.8em; vertical-align:-0.05em; background:repeating-linear-gradient(45deg, currentColor 0 1.5px, transparent 1.5px 5px); opacity:0.45;"></span> <%= t('no price (yet)') %> · <%= t('Point at or tap an hour for the details.') %></div>
    <div id="pl-chart"></div>
    <div id="pl-detail"></div>
  </div>
</div>

<style>
  /* the colors of the whole energy part (style.css --en-*): price, solar, import, the battery, ready by */
  #pl-chart { position:relative; --pl-price:var(--en-price); --pl-solar:var(--en-solar); --pl-import:var(--en-import); --pl-battery:var(--en-battery); --pl-ready:var(--en-battery); --pl-car:var(--en-car); }
  .pl-tip { position:absolute; z-index:5; pointer-events:none; min-width:150px; padding:0.45rem 0.6rem; border:1px solid var(--border); border-radius:10px; background:var(--surface, #fff); box-shadow:0 6px 18px rgba(0,0,0,0.12); font-size:0.78rem; line-height:1.35; }
  .pl-tip > div { display:flex; justify-content:space-between; gap:0.8rem; }
  .pl-tip > div strong { order:2; font-variant-numeric:tabular-nums; }
  .pl-tip > div span { opacity:0.7; }
  .pl-tip .pl-tip-h { font-weight:600; margin-bottom:0.15rem; }
</style>

<p class="hint" data-hint-keep><%= t('Charging, the output to Loxone (advise or live) and reminders are set under') %> <a href="/settings/energy#charging"><%= t('Administration → Energy & charging') %></a>.</p>

<script>
(function () {
  var canEdit = <%- JSON.stringify(canEdit('charging')) %>;
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function nf(v, d) { return v == null ? '—' : Number(v).toLocaleString(undefined, { minimumFractionDigits: d, maximumFractionDigits: d }); }
  // a negative amount (a negative price: you are paid to use power) as −€ 0,05
  function eur(v, d) {
    if (v == null) return '—';
    var dd = d == null ? 2 : d, n = Number(v);
    if (Math.abs(n) < 0.5 * Math.pow(10, -dd)) n = 0;
    return (n < 0 ? '−€\u00a0' : '€\u00a0') + nf(Math.abs(n), dd);
  }
  function tm(s) { return s ? new Date(s).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '—'; }
  function dtm(s) { if (!s) return '—'; var d = new Date(s); var today = new Date(); var day = d.toDateString() === today.toDateString() ? '' : d.toLocaleDateString([], { weekday: 'short' }) + ' '; return day + tm(s); }
  function post(url, body) { return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) }).then(function (r) { return r.json(); }); }
  function tile(label, value, sub, color) {
    return '<div class="ls-tile"><div class="ls-tile-label">' + esc(label) + '</div>' +
      '<div class="ls-tile-value"' + (color ? ' style="color:' + color + ';"' : '') + '>' + value + '</div>' + (sub ? '<div class="ls-tile-sub">' + sub + '</div>' : '') + '</div>';
  }
  // Adjacent intervals with the same source shown as one block.
  function mergeSlots(slots) {
    var out = [];
    slots.forEach(function (x) {
      var last = out[out.length - 1];
      if (last && last.end === x.start && last.source === x.source) { last.end = x.end; last.kwh += x.kwh; last.pvKwh += x.pvKwh || 0; return; }
      else out.push({ start: x.start, end: x.end, kwh: x.kwh, source: x.source, pvKwh: 0 });
      out[out.length - 1].pvKwh += x.pvKwh || 0;
    });
    return out;
  }
  // A whole sentence with {0}, {1} … translated as one (window.LS_I18N), then filled in.
  function T(key) {
    var args = arguments;
    var tr = (window.LS_I18N && window.LS_I18N[key]) || key;
    return tr.replace(/\{(\d+)\}/g, function (all, n) { var v = args[Number(n) + 1]; return v === undefined ? all : v; });
  }
  function slotText(x) {
    var pv = x.pvKwh || 0, grid = Math.max(0, x.kwh - pv);
    var mix = pv > 0.05 && grid > 0.05 ? ' (' + nf(pv, 1) + ' ☀️ + ' + nf(grid, 1) + ' ⚡)' : pv > 0.05 ? ' ☀️' : ' ⚡';
    return dtm(x.start) + '–' + tm(x.end) + ' ' + nf(x.kwh, 1) + ' kWh' + mix;
  }
  // "car reports 64% · about 52 km more today … · trip needs 22.7 kWh": each "· …" part in its own text
  // node, so each is translated on its own (the whole line has no translation of its own)
  function parts(text) { var p = String(text || '').split(' · '); return esc(p[0]) + p.slice(1).map(function (x) { return ' <span>' + esc('· ' + x) + '</span>'; }).join(''); }
  // The newest session — the one going on, or the last one: in the morning, what happened at night.
  function lastSessionTile(ls) {
    if (!ls) return '';
    var lines = [];
    lines.push(ls.connected ? T('plugged in since {0}', dtm(ls.pluggedAt)) : T('plugged in {0}, unplugged {1}', dtm(ls.pluggedAt), dtm(ls.unpluggedAt)));
    var spans = (ls.spans || []).map(function (x) { return tm(x.from) + '–' + (x.to ? tm(x.to) : T('now')); });
    if (spans.length) lines.push(T(ls.chargingNow && spans.length === 1 ? 'charging at {0}' : 'charged at {0}', spans.join(', ')) + (ls.peakKw ? ' · ' + T('up to {0} kW', nf(ls.peakKw, 1)) : ''));
    else if (!(ls.kwh > 0.05)) lines.push(T('nothing charged (yet)'));
    if (ls.cost != null) lines.push(T('costs {0} · average {1}/kWh', eur(ls.cost), eur(ls.eurPerKwh, 3)) + (ls.solarShare > 0 ? ' · ' + T('{0}% solar', ls.solarShare) : ''));
    if (ls.socFrom != null && ls.socTo != null) lines.push(T('battery {0}% → {1}%', Math.round(ls.socFrom), Math.round(ls.socTo)));
    var link = ls.key ? '<div><a href="/planner/log?session=' + encodeURIComponent(ls.key) + '">' + esc(T('Charge log →')) + '</a></div>' : '';
    return '<div class="ls-tile ls-tile-wide"><div class="ls-tile-label">' + esc(T(ls.connected ? 'This session' : 'Last session')) + (ls.car ? ' · ' + esc(ls.car) : '') + '</div>' +
      '<div class="ls-tile-value"' + (ls.chargingNow ? ' style="color:var(--accent);"' : '') + '>' + nf(ls.kwh, 1) + ' <small>kWh</small></div>' +
      '<div class="ls-tile-sub">' + lines.map(function (x) { return '<div>' + esc(x) + '</div>'; }).join('') + link + '</div></div>';
  }
  var MODE_LABEL = { off: 'Off', now: 'Now', pv: 'Solar', minpv: 'Min + Solar', plan: 'Smart plan' };
  var readyFilled = false;

  function render(d) {
    var s = d.status || {};
    var p = d.plan;
    document.getElementById('pl-updated').textContent = s.at ? 'Updated ' + tm(s.at) : (s.error || '');
    document.querySelectorAll('#pl-modes button').forEach(function (b) { b.classList.toggle('on', b.dataset.mode === d.cfg.mode); });
    document.querySelectorAll('#pl-session button').forEach(function (b) { b.style.outline = (b.dataset.ov || '') === (d.override || '') && d.override ? '2px solid var(--accent)' : ''; });
    var wb = s.wallbox || {};
    var t = '';
    t += tile('Car', s.connected ? 'connected' : 'not connected', s.connected ? (p && p.target && p.target.vehicle ? esc(p.target.vehicle.name) + ' · ' : '') + nf(wb.sessionKwh, 1) + ' kWh this session' : '', s.connected ? 'var(--accent)' : '');
    t += tile('Charging', nf(wb.kw, 2) + ' <small>kW</small>', 'setpoint ' + nf(s.setpointKw, 2) + ' kW' + (d.override ? ' · ' + esc(MODE_LABEL[d.override]) + ' for this session' : ''));
    t += tile('Solar surplus', nf(s.surplusKw, 2) + ' <small>kW</small>', 'export + what the car uses');
    if (p && p.fuelBreakEven) t += tile('Fuel break-even', eur(p.fuelBreakEven, 3) + '<small>/kWh</small>', 'above this, fuel is cheaper');
    t += lastSessionTile(d.lastSession);
    document.getElementById('pl-tiles').innerHTML = t;
    document.getElementById('pl-reason').innerHTML = esc(s.reason || '') + (s.outputResult && s.outputResult.error ? ' <span style="color:var(--danger);">Output: ' + esc(s.outputResult.error) + '</span>' : '') + (s.done ? ' <strong>Car is full.</strong>' : '');

    var tg = p && p.target ? p.target : null;
    var th = '';
    if (tg) {
      th = (p.split
          ? tile('Needs before leaving', nf(p.split.mustKwh, 1) + ' <small>kWh</small>', esc(T('trip {0} kWh + reserve {1} kWh; after it is back ({2}) {3} kWh more to be full again', nf(p.split.tripKwh, 1), nf(p.split.reserveKwh, 1), dtm(p.split.backAt), nf(p.split.restKwh, 1))))
          : tile(T(/^car reports/.test(tg.needSource || '') ? 'Room in the battery' : 'To charge (estimate)'), nf(p.needKwh, 1) + ' <small>kWh</small>', parts(tg.needSource))) +
        tile('Ready by', dtm(p.readyAt), esc(tg.readySource || 'no departure known — within 24 h')) +
        (p.arrival ? tile('Expected home', dtm(p.arrival.at), esc(p.arrival.label)) : '');
    }
    document.getElementById('pl-target').innerHTML = th;
    // the one-time "ready by" (the fields themselves are not redrawn, so typing is never lost)
    var box = document.getElementById('pl-ready-box');
    if (box) {
      document.getElementById('pl-ready-label').textContent = T(s.connected ? 'Ready by (this session)' : 'Ready by (when it is back, one time)');
      document.getElementById('pl-ready-set').textContent = d.readyOverride ? '· ' + T('Set by you: {0}', dtm(new Date(d.readyOverride).toISOString()) + (d.readyOverrideOwn ? ' · ' + d.readyOverrideOwn : '')) : '';
      document.getElementById('pl-ready-clear').hidden = !d.readyOverride;
      var own = document.getElementById('pl-ready-own');
      if (!readyFilled && own && document.activeElement !== own) { own.value = d.readyOverrideOwn || ''; readyFilled = true; }
      if (d.readyOverride && !box.dataset.touched) box.open = true;
    }

    var ph = '';
    if (p) {
      if (p.slots.length) {
        var first = p.slots[0];
        var last = p.slots[p.slots.length - 1];
        var pvK = p.pvKwh || 0, gridK = Math.max(0, p.kwh - pvK);
        ph = '<div style="padding:0.8rem 1rem; border-radius:10px; background:color-mix(in srgb, var(--accent) 10%, transparent); border:1px solid color-mix(in srgb, var(--accent) 35%, transparent);">' +
          (p.arrival ? '<div class="hint" style="margin:0 0 0.25rem;">' + esc(T('The car is out: this is the plan from when it is expected home ({0}).', dtm(p.arrival.at))) + '</div>' : '') +
          (p.priceGapFrom ? '<div class="hint" style="margin:0 0 0.25rem; color:var(--warning, #d4a017);">' + esc(T('No electricity prices known from {0} — LoxSuite fetches them again every 30 minutes; until then those hours are left out of the plan.', dtm(p.priceGapFrom))) + '</div>' : '') +
          '<strong>' + esc(T('Plan:')) + '</strong> ' + esc(T('{0} – {1}', dtm(first.start), dtm(last.end))) + ' &rarr; <strong>' + nf(p.kwh, 1) + ' kWh</strong>' +
          ' (' + (pvK > 0.05 ? esc(T('{0} kWh solar, {1} kWh grid', nf(pvK, 1), nf(gridK, 1))) : esc(T('all from the grid'))) + ')' +
          ' · ' + esc(T('average')) + ' <strong>' + eur(p.avgPrice, 3) + '</strong>/kWh · ' + esc(T('costs about')) + ' <strong>' + eur(p.cost) + '</strong>' +
          (p.compare && p.compare.saving > 0.05 ? '<span class="hint" style="margin:0;"> ' + esc(T('(charging straight away: {0} average — saves {1})', eur(p.compare.avgPrice, 3), eur(p.compare.saving))) + '</span>' : '') +
          (p.split
            ? (function () {
                var before = (p.split.mustSlots || []).concat(p.split.preSlots || []).sort(function (a, b) { return a.start < b.start ? -1 : 1; });
                return '<div class="hint" style="margin:0.3rem 0 0;">' + esc(T('Before leaving:')) + ' ' + (before.length ? mergeSlots(before).map(slotText).join(' · ') : esc(T('nothing to charge'))) + '</div>' +
                  '<div class="hint" style="margin:0.15rem 0 0;">' + esc(T('After it is back:')) + ' ' + (p.split.restSlots.length ? mergeSlots(p.split.restSlots).map(slotText).join(' · ') : esc(T('nothing more to charge'))) +
                    (p.split.later || []).map(function (l) { return ' · ' + esc(T('{0} kWh of it for {1} (ready {2})', nf(l.kwh, 1), l.title, dtm(l.readyAt))); }).join('') +
                    (p.split.restBy ? ' · ' + esc(T('full again by {0}', dtm(p.split.restBy))) : '') + '</div>';
              })()
            : '<div class="hint" style="margin:0.3rem 0 0;">' + mergeSlots(p.slots).map(slotText).join(' · ') + '</div>') +
          (p.buffer ? '<div class="hint" style="margin:0.3rem 0 0;">' + esc(T('Ready for the unexpected: {0} kWh ({1} km) by {2}', nf(p.buffer.kwh, 1), p.buffer.km, dtm(p.buffer.by))) + '</div>' : '') +
          (p.ifNow ? '<div class="hint" style="margin:0.45rem 0 0; padding-top:0.4rem; border-top:1px dashed var(--border);">' + esc(T('If it came home now (or another car were plugged in):')) + ' ' +
            (p.ifNow.slots.length ? mergeSlots(p.ifNow.slots).map(slotText).join(' · ') + ' · ' + eur(p.ifNow.cost) : esc(T('nothing to charge'))) + '</div>' : '') +
          '</div>';
      } else {
        ph = '<p class="hint" style="margin:0;">' + (p.needKwh > 0 ? 'Nothing planned.' : 'Nothing to charge.') + '</p>';
      }
      if (p.notes && p.notes.length) ph += '<p class="hint" style="margin:0.4rem 0 0; color:#b8860b;">' + p.notes.map(esc).join(' ') + '</p>';
    }
    document.getElementById('pl-plan').innerHTML = ph;
    renderChart(p);
  }

  // Hourly slots split into their quarter-hour prices for the chart (Administration → Energy &
  // charging → "Show prices in the charts per quarter"); the plan itself keeps its own intervals.
  function withQuarters(slots, quarters) {
    if (!quarters || !quarters.length) return slots;
    var out = [];
    slots.forEach(function (s) {
      var a = Date.parse(s.start), b = Date.parse(s.end);
      var sub = quarters.filter(function (q) { return Date.parse(q.start) >= a && Date.parse(q.end) <= b; });
      if (sub.length < 2) { out.push(s); return; }
      sub.forEach(function (q) { out.push(Object.assign({}, s, { start: q.start, end: q.end, price: q.price })); });
    });
    return out;
  }
  var chartPlan = null;
  var plSel = null; // start (ms) of the interval tapped for its details
  lsOnResize(function () { if (chartPlan) renderChart(chartPlan); });
  // Pure: the expected battery level (%) at an instant from the line's points, or null.
  function batteryAt(bat, ms) {
    var pts = bat && bat.points;
    if (!pts || !pts.length || ms < pts[0].at) return null;
    for (var i = 1; i < pts.length; i++) {
      if (ms <= pts[i].at) { var a = pts[i - 1], b = pts[i]; return b.at === a.at ? b.pct : a.pct + (b.pct - a.pct) * (ms - a.at) / (b.at - a.at); }
    }
    return pts[pts.length - 1].pct;
  }
  // Everything about one interval of the chart: price (per quarter), what is planned, solar, house,
  // import from the grid, what it costs and the battery after it.
  function slotDetail(p, s, gridKw) {
    var a = Date.parse(s.start), b = Date.parse(s.end);
    var kwh = 0, pv = 0, kw = 0;
    p.slots.forEach(function (q) {
      var qa = Date.parse(q.start), qb = Date.parse(q.end), ov = Math.min(b, qb) - Math.max(a, qa);
      if (ov <= 0 || qb <= qa) return;
      kwh += (q.kwh || 0) * ov / (qb - qa); pv += (q.pvKwh || 0) * ov / (qb - qa); kw = Math.max(kw, q.kw || 0);
    });
    var grid = Math.max(0, kwh - pv);
    var qs = (p.quarterPrices || []).filter(function (q) { return Date.parse(q.start) >= a && Date.parse(q.end) <= b; });
    var level = batteryAt(p.battery, b);
    var day = new Date(a).toLocaleDateString([], { weekday: 'short', day: 'numeric', month: 'short' });
    var tiles = '<div class="ls-tiles" style="margin-top:0.5rem; grid-template-columns:repeat(auto-fill, minmax(min(132px, 100%), 1fr));">' +
      tile(T('Price'), s.price != null ? eur(s.price, 3) + '<small style="font-size:0.6em; opacity:0.7;"> /kWh</small>' : '—', s.price == null ? esc(T('no price (yet)')) : (s.price < 0 ? esc(T('negative: you are paid to use power')) + (qs.length > 1 ? '<br>' : '') : '') + (qs.length > 1 ? qs.map(function (q) { return esc(tm(q.start)) + ' ' + eur(q.price, 3); }).join('<br>') : '')) +
      tile(T('Planned'), kwh > 0.05 ? nf(kwh, 1) + ' kWh' : esc(T('nothing planned')), kwh > 0.05 ? esc(T('{0} kW', nf(kw, 1))) + (pv > 0.05 ? ' · ☀️ ' + nf(pv, 1) + ' kWh' : '') : '') +
      tile(T('Solar surplus (forecast)'), nf(s.pvKw || 0, 1) + ' kW', esc(T('this hour: solar {0} kWh, house {1} kWh', nf(s.pvKwh || 0, 1), nf(s.houseKwh || 0, 1))) +
        // what a kWh of own solar counts as in the plan (Settings → Smart charging: value of exported solar)
        (s.pvKw > 0.05 && s.solarValue != null ? '<br>' + esc(T(s.solarRule === 'fixed' ? 'own solar counts as {0} per kWh (feed-in tariff)' : s.solarRule === 'market' ? 'own solar counts as {0} per kWh (market price)' : 'own solar counts as {0} per kWh (net metering)', eur(s.solarValue, 3))) : '')) +
      tile(T('Import from the grid (expected)'), gridKw != null ? nf(gridKw, 1) + ' kW' : '—') +
      tile(T('Costs'), kwh > 0.05 && s.price != null ? eur(grid * s.price) : '—', kwh > 0.05 ? esc(T('{0} kWh from the grid', nf(grid, 1))) : '') +
      tile(T('Battery level'), level != null ? (p.battery.estimated ? '≈ ' : '') + nf(level, 0) + '%' : '—', level != null ? esc(T('at {0}', tm(s.end))) : '') +
      '</div>';
    return '<div class="card" style="margin:0.6rem 0 0; padding:0.7rem 0.9rem;"><div style="display:flex; justify-content:space-between; align-items:center; gap:0.5rem;"><strong>' + esc(day + ' ' + tm(s.start) + '–' + tm(s.end)) + '</strong><a href="#" class="hint" id="pl-detail-close" style="margin:0;">' + esc(T('Close')) + '</a></div>' + tiles + '</div>';
  }
  // Pure: a smooth path through [[x, y], …] that never overshoots (monotone cubic, Fritsch–Carlson): the
  // curve stays between neighbouring values, so the battery never shows above 100% or below empty.
  function smoothPath(pts) {
    var n = pts.length;
    var f = function (v) { return v.toFixed(1); };
    if (!n) return '';
    if (n < 3) return 'M' + pts.map(function (q) { return f(q[0]) + ',' + f(q[1]); }).join('L');
    var dx = [], m = [], t = [];
    for (var i = 0; i < n - 1; i++) { dx[i] = pts[i + 1][0] - pts[i][0]; m[i] = dx[i] ? (pts[i + 1][1] - pts[i][1]) / dx[i] : 0; }
    t[0] = m[0]; t[n - 1] = m[n - 2];
