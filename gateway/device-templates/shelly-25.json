{
  "key": "shelly-25",
  "label": "Shelly 2.5 (relay or roller)",
  "topicPrefixPattern": "^shellies/(shellyswitch25-[^/]+)/",
  "commands": [
    {
      "key": "relay",
      "label": "Relay switch",
      "topicTemplate": "shellies/{device}/relay/{channel}/command",
      "actions": [
        "on",
        "off",
        "toggle"
      ]
    },
    {
      "key": "roller",
      "label": "Roller shutter",
      "topicTemplate": "shellies/{device}/roller/{channel}/command",
      "actions": [
        "open",
        "close",
        "stop"
      ]
    },
    {
      "key": "reboot",
      "label": "Reboot",
      "topicTemplate": "shellies/{device}/command",
      "actions": [
        "reboot"
      ]
    }
  ],
  "dataPoints": [
    {
      "key": "relay-state",
      "label": "Relay state (on/off/overpower)",
      "topicTemplate": "shellies/{device}/relay/{channel}",
      "channel": true
    },
    {
      "key": "relay-power",
      "label": "Relay power (W)",
      "topicTemplate": "shellies/{device}/relay/{channel}/power",
      "channel": true
    },
    {
      "key": "relay-energy",
      "label": "Relay energy (running total, ×10 = Wh)",
      "topicTemplate": "shellies/{device}/relay/{channel}/energy",
      "channel": true
    },
    {
      "key": "roller-state",
      "label": "Roller state (open/close/stop)",
      "topicTemplate": "shellies/{device}/roller/{channel}",
      "channel": true
    },
    {
      "key": "roller-position",
      "label": "Roller position (0-100)",
      "topicTemplate": "shellies/{device}/roller/{channel}/pos",
      "channel": true
    },
    {
      "key": "temperature",
      "label": "Device temperature (°C)",
      "topicTemplate": "shellies/{device}/temperature",
      "channel": false
    }
  ]
}
