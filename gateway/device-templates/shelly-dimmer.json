{
  "key": "shelly-dimmer",
  "label": "Shelly Dimmer / Dimmer 2",
  "topicPrefixPattern": "^shellies/(shellydimmer2?-[^/]+)/",
  "commands": [
    {
      "key": "light",
      "label": "Light (dimmer)",
      "topicTemplate": "shellies/{device}/light/{channel}/command",
      "actions": [
        "on",
        "off",
        "toggle"
      ]
    },
    {
      "key": "light-set",
      "label": "Light brightness (0-100)",
      "topicTemplate": "shellies/{device}/light/{channel}/set",
      "actions": [
        "0",
        "25",
        "50",
        "75",
        "100"
      ]
    }
  ],
  "dataPoints": [
    {
      "key": "light-power",
      "label": "Light/dimmer power (W)",
      "topicTemplate": "shellies/{device}/light/{channel}/power",
      "channel": true
    },
    {
      "key": "light-energy",
      "label": "Light/dimmer energy (running total, ×10 = Wh)",
      "topicTemplate": "shellies/{device}/light/{channel}/energy",
      "channel": true
    },
    {
      "key": "temperature",
      "label": "Device temperature (°C)",
      "topicTemplate": "shellies/{device}/temperature",
      "channel": false
    }
  ]
}
