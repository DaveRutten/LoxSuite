      "topicTemplate": "heatbooster/{device}/rssi",
      "channel": false
    },
    {
      "key": "firmware",
      "label": "Firmware version",
      "topicTemplate": "heatbooster/{device}/firmware",
      "channel": false
    },
    {
      "key": "runtime",
      "label": "Runtime (seconds)",
      "topicTemplate": "heatbooster/{device}/runtime",
      "channel": false
