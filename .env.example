# MQTT credentials the gateway uses to connect to the mosquitto broker.
# Created automatically on first boot — see MQTT_ADMIN_* below.
MQTT_USERNAME=gateway
MQTT_PASSWORD=change-me

# Break-glass MQTT admin account (Mosquitto dynamic-security), used only once on
# first boot to bootstrap the "client" role and the MQTT_USERNAME account above.
# Keep this password somewhere safe — you'll need it for manual mosquitto_ctrl access.
MQTT_ADMIN_USERNAME=admin
MQTT_ADMIN_PASSWORD=change-me-admin

# Random long string used to sign session cookies.
SESSION_SECRET=change-me-too

# Web UI admin account, created on first boot if the users table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
