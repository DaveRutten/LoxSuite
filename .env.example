# MQTT credentials the gateway uses to connect to the mosquitto broker.
# Created automatically on first boot — see MQTT_ADMIN_* below.
MQTT_USERNAME=gateway
MQTT_PASSWORD=change-me

# Break-glass MQTT admin account (Mosquitto dynamic-security), used only once on
# first boot to bootstrap the "client" role and the MQTT_USERNAME account above.
# Keep this password somewhere safe — you'll need it for manual mosquitto_ctrl access.
MQTT_ADMIN_USERNAME=admin
MQTT_ADMIN_PASSWORD=change-me-admin

# Random long string used to sign session cookies.
SESSION_SECRET=change-me-too

# Web UI admin account, created on first boot if the users table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- Database (optional) -----------------------------------------------------
# SQLite is the zero-config default — nothing below is needed to use it. Uncomment these to point
# LoxSuite at an external PostgreSQL server instead (restart required to change; this is read once
# at boot, not a live Settings-page toggle). MySQL/MariaDB support is planned but not available yet.
#
# DB_BACKEND=postgres
#
# Either a single connection URL...
# DATABASE_URL=postgres://user:password@host:5432/loxsuite
# ...or the discrete vars below (used only if DATABASE_URL isn't set — avoids URL-encoding traps
# for a password with its own "@"/":"/"/" characters, and pairs better with Docker secrets):
# DB_HOST=postgres-host
# DB_PORT=5432
# DB_NAME=loxsuite
# DB_USER=loxsuite
# DB_PASSWORD=change-me
#
# DB_SSL=false                 # or "require" (TLS, no cert check) / "verify-full"
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=10000  # how long to wait between connection retries at boot
# DB_CONNECT_RETRIES=30        # how many times to retry before giving up
#
# Moving an existing SQLite install's data to Postgres: see gateway/src/db/transfer.js, e.g.
#   docker compose exec loxsuite node src/db/transfer.js --from-sqlite /data/gateway.db --to "$DATABASE_URL"
